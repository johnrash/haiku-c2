--- a/Lib/ctypes/util.py	2026-11-07 13:09:28.908569421 -0500
+++ b/Lib/ctypes/util.py	2026-11-07 13:09:28.917842601 -0500
@@ -395,7 +395,11 @@
         def find_library(name):
             if name in ('c', 'm'):
                 return find_library('root')
-            for directory in os.environ['LIBRARY_PATH'].split(os.pathsep):
+            # LIBRARY_PATH is not set everywhere (in an ssh session, say)
+            libraryPath = os.environ.get('LIBRARY_PATH',
