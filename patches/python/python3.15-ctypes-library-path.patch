+                ':/boot/system/non-packaged/lib:/boot/system/lib')
+            for directory in libraryPath.split(os.pathsep):
                 if directory.startswith("%A/"):
                     directory = directory.replace('%A',
                         os.path.dirname(os.path.abspath(sys.argv[0] or os.getcwd())))
