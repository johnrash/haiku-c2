+/* Common CEA/DMT sizes the encoder can drive */
+static bool meson_vpu_standard_size(const struct display_timing *t)
+{
+	static const u16 sizes[][2] = {
+		{ 640, 480 }, { 720, 480 }, { 720, 576 }, { 800, 600 },
+		{ 1024, 768 }, { 1280, 720 }, { 1280, 800 }, { 1280, 1024 },
+		{ 1360, 768 }, { 1366, 768 }, { 1440, 900 }, { 1600, 900 },
+		{ 1680, 1050 }, { 1920, 1080 }, { 1920, 1200 },
+	};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(sizes); i++) {
+		if (t->hactive.typ == sizes[i][0] && t->vactive.typ == sizes[i][1])
+			return true;
+	}
+	return false;
+}
+
+/*
+ * Right after power-up some sinks (USB HDMI capture dongles) do not answer
+ * EDID reads yet, or answer with a half-initialised EDID that decodes to a
+ * nonsense mode (seen: 1100x1100 at 195 MHz). Accept a mode only when two
+ * reads 500 ms apart agree and it has a standard size; retry for up to 10 s.
+ */
+static int meson_vpu_read_stable_timing(struct udevice *disp,
+					struct display_timing *timing)
+{
+	struct display_timing prev;
+	bool have_prev = false;
+	int tries, ret = -ENODEV;
+
+	for (tries = 0; tries < 20; tries++) {
+		if (tries)
+			mdelay(500);
+		ret = display_read_timing(disp, timing);
+		if (ret || !meson_vpu_standard_size(timing)) {
+			have_prev = false;
+			continue;
+		}
+		if (have_prev && prev.hactive.typ == timing->hactive.typ
+		    && prev.vactive.typ == timing->vactive.typ
+		    && prev.pixelclock.typ == timing->pixelclock.typ) {
+			printf("HDMI: %dx%d, %d Hz pixel clock, after %d EDID reads\n",
+			       timing->hactive.typ, timing->vactive.typ,
+			       timing->pixelclock.typ, tries + 1);
+			return 0;
+		}
+		prev = *timing;
+		have_prev = true;
+	}
+	return ret ? ret : -EINVAL;
+}
+
