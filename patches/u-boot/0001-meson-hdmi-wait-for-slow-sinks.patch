diff --git a/drivers/video/meson/meson_dw_hdmi.c b/drivers/video/meson/meson_dw_hdmi.c
index 1631dc38..7ee69361 100644
--- a/drivers/video/meson/meson_dw_hdmi.c
+++ b/drivers/video/meson/meson_dw_hdmi.c
@@ -363,14 +363,24 @@ static int meson_dw_hdmi_wait_hpd(struct dw_hdmi *hdmi)
 {
 	int i;
 
-	/* Poll 1 second for HPD signal */
-	for (i = 0; i < 10; ++i) {
-		if (dw_hdmi_top_read(hdmi, HDMITX_TOP_STAT0))
+	/*
+	 * Poll up to 20 seconds for the HPD signal. Some sinks (USB HDMI
+	 * capture dongles) take about 10 s after the source powers up before
+	 * they assert hot-plug; with the stock 1 s U-Boot falls back to CVBS.
+	 */
+	for (i = 0; i < 200; ++i) {
+		if (dw_hdmi_top_read(hdmi, HDMITX_TOP_STAT0)) {
+			if (i >= 10)
+				printf("HDMI: hot-plug after %d ms\n", i * 100);
 			return 0;
+		}
 
+		if (i == 10)
+			printf("HDMI: waiting for hot-plug...\n");
 		mdelay(100);
 	}
 
+	printf("HDMI: no hot-plug, no HDMI output\n");
 	return -ETIMEDOUT;
 }
 
