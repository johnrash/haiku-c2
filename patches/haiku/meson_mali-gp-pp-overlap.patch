+/*!	Whether the task with \a sequence and every one before it are done:
+	neither pipe has one at or before it still queued or running. With
+	fQueueLock held.
+*/
+bool
+MesonMali::_Done(uint64 sequence) const
+{
+	for (int32 pipe = 0; pipe < 2; pipe++) {
+		const mali_task* oldest = fRunning[pipe] != NULL
+			? fRunning[pipe] : fQueueHead[pipe];
+		if (oldest != NULL && oldest->sequence <= sequence)
+			return false;
+	}
+	return true;
+}
