@@ -217,13 +217,23 @@
 }
 
 
+// A font from Haiku's family, style and size. QFontDatabase::font() asked
+// QGuiApplication::font() for defaults, which in Qt 6.12 holds its lock while
+// it calls this theme: a deadlock when QApplication started.
+static QFont haikuFont(const char *family, const char *style, float size)
+{
+	QFont font(QString::fromUtf8(family));
+	font.setStyleName(QString::fromUtf8(style));
+	if (size > 0)
+		font.setPointSizeF(size);
+	return font;
+}
