#!/bin/bash
# Compiler for Haiku makefile-engine builds on this host (put this directory
# first in PATH, with CC=cc CXX=c++): the arm64 cross gcc with
# the sysroot, the Cortex-A53 errata flags and Haiku's headers. Paths under
# /boot/system/develop (an app's SYSTEM_INCLUDE_PATHS) are mapped to the
# build tree. Links get deps/prefix/lib (static OpenSSL & co.) and libgcc_s,
# except -nostdlib ones (kernel add-ons).
compiler=$HAIKU_TOOLS/aarch64-unknown-haiku-gcc
[ "$(basename "$0")" = c++ ] && compiler=$HAIKU_TOOLS/aarch64-unknown-haiku-g++
link=1
args=()
for a in "$@"; do
	case "$a" in
		-c|-E|-S|-M|-MM|-dumpversion|-dumpmachine) link=0 ;;
		-nostdlib) nostdlib=1 ;;	# a kernel add-on: no libgcc_s
	esac
	a=${a//\/boot\/system\/develop\/headers/$HAIKU_SRC/headers}
	a=${a//\/boot\/system\/develop\/lib/$HAIKU_SYSROOT/boot/system/develop/lib}
	args+=("$a")
done
extra=()
[ $link = 1 ] && [ -z "$nostdlib" ] && extra=(-L"$HAIKU_PREFIX/lib" $HAIKU_CXX_LIBS)
exec "$compiler" --sysroot="$HAIKU_SYSROOT" $HAIKU_ERRATA_FLAGS \
	$HAIKU_CXX_INCLUDES "${args[@]}" "${extra[@]}"
