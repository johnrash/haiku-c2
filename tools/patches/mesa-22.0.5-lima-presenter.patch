+/*!	The frame into fBitmap, made anew for another size or colour space. */
+void
+LimaRenderer::_CopyFrame(const uint8* source, uint32 stride, uint32 width,
+	uint32 height, color_space colorSpace, uint32 bytesPerPixel)
+{
+	BAutolock lock(fBitmapLocker);
+	if (fBitmap == NULL || fBitmap->ColorSpace() != colorSpace
+		|| fBitmap->Bounds().IntegerWidth() + 1 != (int32)width
+		|| fBitmap->Bounds().IntegerHeight() + 1 != (int32)height) {
+		delete fBitmap;
+		fBitmap = new(std::nothrow) BBitmap(
+			BRect(0, 0, width - 1, height - 1), colorSpace);
+		if (fBitmap != NULL && fBitmap->InitCheck() != B_OK) {
+			delete fBitmap;
+			fBitmap = NULL;
+		}
+	}
+	if (fBitmap == NULL)
+		return;
+	uint8* target = (uint8*)fBitmap->Bits();
+	int32 targetStride = fBitmap->BytesPerRow();
+	size_t rowBytes = width * bytesPerPixel;
+	for (uint32 y = 0; y < height; y++)
+		memcpy(target + y * targetStride, source + y * stride, rowBytes);
+}
+
+
+/*static*/ status_t
+LimaRenderer::_PresenterEntry(void* data)
+{
+	((LimaRenderer*)data)->_PresenterThread();
+	return B_OK;
+}
+
+
+/*!	Each frame handed over: waits until the GPU wrote it (its buffer's
+	jobs), reads it back and shows it. The kernel driver invalidated the
+	CPU's lines of the buffer after the jobs.
+*/
+void
+LimaRenderer::_PresenterThread()
+{
+	while (acquire_sem(fFrameSem) == B_OK) {
+		if (fQuitting)
+			break;
+		struct pipe_resource* resource = fPending;
+		fPending = NULL;
+		if (resource == NULL) {
+			release_sem(fIdleSem);
+			continue;
+		}
+		lima_bo_wait(lima_resource(resource)->bo, LIMA_GEM_WAIT_READ,
+			10000000000ULL);
+		_CopyFrame(fPendingSource, fPendingStride, fPendingWidth,
+			fPendingHeight, fPendingColorSpace, fPendingBytesPerPixel);
+		pipe_resource_reference(&resource, NULL);
+		release_sem(fIdleSem);
+
+		// Only this thread changes fBitmap while the GL thread presents
+		// through it (see Present())
+		if (fBitmap != NULL)
+			_Show(fBitmap, 100000);
+	}
+}
