 GLRendererRoster *GLRendererRoster::fInstance = NULL;
 
+
+// Higher priority first (an add-on may export "int32 gl_renderer_priority";
+// without it, 0), then by name. A stable sort keeps the user folders before
+// the system ones for add-ons of the same name.
+static bool
+compare_renderers(const renderer_item& a, const renderer_item& b)
+{
+	if (a.priority != b.priority)
+		return a.priority > b.priority;
+	return strcmp(a.ref.name != NULL ? a.ref.name : "",
+		b.ref.name != NULL ? b.ref.name : "") < 0;
+}
