+#ifndef LIMARENDERER_H
+#define LIMARENDERER_H
+
+
+#include <kernel/image.h>
+#include <Locker.h>
+
+#include "GLRenderer.h"
+#include "GalliumContext.h"
+
+
+struct pipe_context;
+struct pipe_resource;
+
+
+/*!	"Lima Pipe": Mesa's lima driver on the Mali-450 (meson_mali). It works
+	as Software Pipe does, but the GPU renders into buffers of its own: each
+	frame presented is read back into a BBitmap, which is shown as Software
+	Pipe shows its own (docs/m43-mesa-lima-haiku.md §3.3, §3.4).
+*/
+class LimaRenderer : public BGLRenderer, public HGLWinsysContext {
+public:
+								LimaRenderer(BGLView *view,
+									ulong bgl_options);
+	virtual						~LimaRenderer();
+
+			status_t			InitCheck() const;
+
+			void				LockGL();
+			void				UnlockGL();
+
+			void				Display(BBitmap* bitmap, BRect* updateRect);
+
+			void				SwapBuffers(bool vsync = false);
+			void				Draw(BRect updateRect);
+			status_t			CopyPixelsOut(BPoint source, BBitmap *dest);
+			status_t			CopyPixelsIn(BBitmap *source, BPoint dest);
+			void				FrameResized(float width, float height);
+
+			void				EnableDirectMode(bool enabled);
+			void				DirectConnected(direct_buffer_info *info);
+
+			// the screen's flush_frontbuffer: a new frame from the GL
+			// thread, through its context; the last one again otherwise
+			void				Present(struct pipe_context* context,
+									struct pipe_resource* resource);
+			void				ShowLastFrame();
+
+private:
+			GalliumContext*		fContextObj;
+			context_id			fContextID;
+
+			bool				fDirectModeEnabled;
+			direct_buffer_info*	fInfo;
+			BLocker				fInfoLocker;
+			ulong				fOptions;
+			GLuint				fWidth;
+			GLuint				fHeight;
+			color_space			fColorSpace;
+
+			BBitmap*			fBitmap;
+				// the last frame; made and filled by the GL thread
+			BLocker				fBitmapLocker;
+				// against the window thread, which shows it again
+};
+
+#endif	// LIMARENDERER_H
