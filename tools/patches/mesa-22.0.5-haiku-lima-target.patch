+ * Distributed under the terms of the MIT License.
+ *
+ * Based on haiku-softpipe/SoftwareRenderer.cpp,
+ * Copyright 2006-2012, Haiku, Inc. All rights reserved.
+ * Authors: Jérôme Duval, Philippe Houdoin, Artur Wyszynski,
+ * Alexander von Gluck IV.
+ */
+
+
+#include "LimaRenderer.h"
+
+#include <Autolock.h>
+#include <Bitmap.h>
+#include <interface/DirectWindowPrivate.h>
+#include <interface/ColorConversion.h>
+#include <GraphicsDefs.h>
+#include <Screen.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <new>
+
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "util/debug.h"
+
+extern "C" {
+#include "lima/drm/lima_drm_public.h"
+}
+
+
+#ifdef DEBUG
+#	define TRACE(x...) printf("LimaRenderer: " x)
+#	define CALLED() TRACE("CALLED: %s\n", __PRETTY_FUNCTION__)
+#else
+#	define TRACE(x...)
+#	define CALLED()
+#endif
+#define ERROR(x...)	printf("LimaRenderer: " x)
+
+
+// meson_mali (haiku/headers/private/drivers/meson_mali.h); LIMA_DEVICE
+// names another one
+static const char* kDevice = "/dev/misc/mali/0";
+
+
+// GLRendererRoster tries this add-on before Software Pipe (which has none,
+// so 0); without the device it declines, and Software Pipe takes over.
+extern "C" {
+_EXPORT int32 gl_renderer_priority = 10;
+}
+
+
+static struct pipe_resource* (*sLimaResourceCreate)(struct pipe_screen*,
+	const struct pipe_resource*);
+
+
+/*!	The colour buffers the frontend makes are display targets: those are
+	made linear, so that the CPU reads them back as they are (lima tiles
+	everything else, and reading a tiled buffer means detiling a copy).
+*/
+static struct pipe_resource*
+haiku_lima_resource_create(struct pipe_screen* screen,
+	const struct pipe_resource* templat)
+{
+	if ((templat->bind & PIPE_BIND_DISPLAY_TARGET) == 0)
+		return sLimaResourceCreate(screen, templat);
+
+	struct pipe_resource linear = *templat;
+	linear.bind |= PIPE_BIND_LINEAR;
+	return sLimaResourceCreate(screen, &linear);
+}
+
+
+/*!	The screen's flush_frontbuffer. \a drawable is the HGLWinsysContext the
+	renderer gave GalliumContext::CreateContext(). With a context (the
+	frontend and SwapBuffers(), in the GL thread) a new frame is read back
+	and shown; without one, the last frame is shown again.
+*/
+static void
+haiku_lima_flush_frontbuffer(struct pipe_screen* screen,
+	struct pipe_context* context, struct pipe_resource* resource,
+	unsigned level, unsigned layer, void* drawable, struct pipe_box* box)
+{
+	if (drawable == NULL)
+		return;
+	LimaRenderer* renderer
+		= static_cast<LimaRenderer*>((HGLWinsysContext*)drawable);
+	if (context != NULL)
+		renderer->Present(context, resource);
+	else
+		renderer->ShowLastFrame();
+}
+
+
+extern "C" struct pipe_screen*
+hgl_target_create_screen(void)
+{
+	const char* path = getenv("LIMA_DEVICE");
+	if (path == NULL || path[0] == '\0')
+		path = kDevice;
+	int fd = open(path, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		ERROR("%s: %s: %s\n", __func__, path, strerror(errno));
+		return NULL;
+	}
+
+	// lima keeps a duplicate of its own
+	struct pipe_screen* screen = lima_drm_screen_create(fd);
+	close(fd);
+	if (screen == NULL) {
+		ERROR("%s: no lima screen on %s\n", __func__, path);
+		return NULL;
+	}
+
+	if (screen->resource_create != haiku_lima_resource_create) {
+		sLimaResourceCreate = screen->resource_create;
+		screen->resource_create = haiku_lima_resource_create;
+	}
+	screen->flush_frontbuffer = haiku_lima_flush_frontbuffer;
+	return screen;
+}
+
+
+extern "C" _EXPORT BGLRenderer*
+instantiate_gl_renderer(BGLView *view, ulong opts)
+{
+	// Mesa's switch to software rendering: Software Pipe takes over
+	if (env_var_as_boolean("LIBGL_ALWAYS_SOFTWARE", false))
+		return NULL;
+
+	LimaRenderer* renderer = new(std::nothrow) LimaRenderer(view, opts);
+	if (renderer != NULL && renderer->InitCheck() != B_OK) {
+		delete renderer;
+		renderer = NULL;
+	}
+	return renderer;
+}
+
+
+struct RasBuffer
+{
+	int32 width, height, stride;
+	int32 orgX, orgY;
+	uint8 *colors;
+	color_space pixel_format;
+	int32 pixel_size;
+
+	RasBuffer(int32 width, int32 height, int32 stride, int32 orgX, int32 orgY, void *colors):
+		width(width), height(height), stride(stride), orgX(orgX), orgY(orgY), colors((uint8*)colors)
+	{}
+
+	RasBuffer(BBitmap *bmp)
+	{
+		width  = bmp->Bounds().IntegerWidth()  + 1;
+		height = bmp->Bounds().IntegerHeight() + 1;
+		stride = bmp->BytesPerRow();
+		orgX   = 0;
+		orgY   = 0;
+		pixel_format = bmp->ColorSpace();
+		pixel_size = stride / width;
+		colors = (uint8*)bmp->Bits();
+	}
+
+	RasBuffer(direct_buffer_info *info)
+	{
+		width  = 0x7fffffff;
+		height = 0x7fffffff;
+		stride = info->bytes_per_row;
+		orgX   = 0;
+		orgY   = 0;
+		pixel_format = info->pixel_format;
+		pixel_size = info->bits_per_pixel / 8;
+		colors = (uint8*)info->bits;
+	}
+
+	void ClipSize(int32 x, int32 y, int32 w, int32 h)
+	{
+		if (x < 0) {w += x; x = 0;}
+		if (y < 0) {h += y; y = 0;}
+		if (x + w > width) {w = width  - x;}
+		if (y + h > height) {h = height - y;}
+		if ((w > 0) && (h > 0)) {
+			colors += (y * stride) + (x * pixel_size);
+			width  = w;
+			height = h;
+		} else {
+			width = 0; height = 0; colors = NULL;
+		}
+		if (x + orgX > 0) {orgX += x;} else {orgX = 0;}
+		if (y + orgY > 0) {orgY += y;} else {orgY = 0;}
+	}
+
+	void ClipRect(int32 l, int32 t, int32 r, int32 b)
+	{
+		ClipSize(l, t, r - l, b - t);
+	}
+
+	void Shift(int32 dx, int32 dy)
+	{
+		orgX += dx;
+		orgY += dy;
+	}
+
+	void Blit(RasBuffer src)
+	{
+		RasBuffer dst = *this;
+		int32 x, y;
+		x = src.orgX - orgX;
+		y = src.orgY - orgY;
+		dst.ClipSize(x, y, src.width, src.height);
+		src.ClipSize(-x, -y, width, height);
+		for (; dst.height > 0; dst.height--) {
+			if (src.pixel_format == dst.pixel_format) {
+				memcpy(dst.colors, src.colors, src.width * src.pixel_size);
+			} else {
+				BPrivate::ConvertBits(src.colors, dst.colors, src.stride, dst.stride,
+					src.stride, dst.stride, src.pixel_format, dst.pixel_format, src.width, 1);
+			}
+			dst.colors += dst.stride;
+			src.colors += src.stride;
+		}
+	}
+};
+
+
+LimaRenderer::LimaRenderer(BGLView *view, ulong options)
+	:
+	BGLRenderer(view, options),
+	fContextObj(NULL),
+	fContextID(-1),
+	fDirectModeEnabled(false),
+	fInfo(NULL),
+	fInfoLocker("info locker"),
+	fOptions(options),
+	fWidth(0),
+	fHeight(0),
+	fColorSpace(B_NO_COLOR_SPACE),
+	fBitmap(NULL),
+	fBitmapLocker("lima frame locker")
+{
+	CALLED();
+
+	// no screen (no device): InitCheck() fails
+	fContextObj = new GalliumContext(options);
+	if (fContextObj->InitCheck() != B_OK)
+		return;
+
+	BRect b = view->Bounds();
+	fColorSpace = BScreen(view->Window()).ColorSpace();
+
+	fWidth = (GLint)b.IntegerWidth();
+	fHeight = (GLint)b.IntegerHeight();
+
+	fContextID = fContextObj->CreateContext(this);
+	if (fContextID < 0) {
+		ERROR("%s: There was an error creating the context!\n", __func__);
+		return;
+	}
+
+	if (!fContextObj->GetCurrentContext())
+		LockGL();
+}
+
+
+LimaRenderer::~LimaRenderer()
+{
+	CALLED();
+
+	delete fContextObj;
+	delete fBitmap;
+	free(fInfo);
+}
+
+
+status_t
+LimaRenderer::InitCheck() const
+{
+	if (fContextObj == NULL || fContextObj->InitCheck() != B_OK)
+		return B_NO_INIT;
+	return fContextID >= 0 ? B_OK : B_ERROR;
+}
+
+
+void
+LimaRenderer::LockGL()
+{
+//	CALLED();
+	BGLRenderer::LockGL();
+
+	color_space cs = BScreen(GLView()->Window()).ColorSpace();
+
+	{
+		BAutolock lock(fInfoLocker);
+		if (fDirectModeEnabled && fInfo != NULL) {
+			fWidth = fInfo->window_bounds.right - fInfo->window_bounds.left;
+			fHeight = fInfo->window_bounds.bottom - fInfo->window_bounds.top;
+		}
+
+		fContextObj->Validate(fWidth, fHeight);
+		fColorSpace = cs;
+	}
+
+	// do not hold fInfoLocker here to avoid deadlock
+	fContextObj->SetCurrentContext(true, fContextID);
+}
+
+
+void
+LimaRenderer::UnlockGL()
+{
+//	CALLED();
+	if ((fOptions & BGL_DOUBLE) == 0) {
+		SwapBuffers();
+	}
+	fContextObj->SetCurrentContext(false, fContextID);
+	BGLRenderer::UnlockGL();
+}
+
+
+void
+LimaRenderer::Display(BBitmap *bitmap, BRect *updateRect)
+{
+//	CALLED();
+
+	if (!fDirectModeEnabled) {
+		// TODO: avoid timeout
+		if (GLView()->LockLooperWithTimeout(1000) == B_OK) {
+			GLView()->DrawBitmap(bitmap, B_ORIGIN);
+			GLView()->UnlockLooper();
+		}
+	} else {
+		BAutolock lock(fInfoLocker);
+		if (fInfo != NULL) {
+			RasBuffer srcBuf(bitmap);
+			RasBuffer dstBuf(fInfo);
+			for (uint32 i = 0; i < fInfo->clip_list_count; i++) {
+				clipping_rect *clip = &fInfo->clip_list[i];
+				RasBuffer dstClip = dstBuf;
+				dstClip.ClipRect(clip->left, clip->top, clip->right + 1, clip->bottom + 1);
+				dstClip.Shift(-fInfo->window_bounds.left, -fInfo->window_bounds.top);
+				dstClip.Blit(srcBuf);
+			}
+		}
+	}
+}
+
+
+/*!	Reads the frame in \a resource back into fBitmap and shows it. In the
+	GL thread, with the GL context locked: texture_map() flushes the jobs
+	that draw into the buffer and waits for them; a linear buffer is mapped
+	as it is.
+*/
+void
+LimaRenderer::Present(struct pipe_context* context,
+	struct pipe_resource* resource)
+{
+	color_space colorSpace;
+	uint32 bytesPerPixel;
+	switch (resource->format) {
+		// B_RGB32 has the byte order of BGRA8888 and BGRX8888, B_RGB16
+		// that of B5G6R5 (BGL_INDEX)
+		case PIPE_FORMAT_B8G8R8A8_UNORM:
+		case PIPE_FORMAT_B8G8R8X8_UNORM:
+			colorSpace = B_RGB32;
+			bytesPerPixel = 4;
+			break;
+		case PIPE_FORMAT_B5G6R5_UNORM:
+			colorSpace = B_RGB16;
+			bytesPerPixel = 2;
+			break;
+		default:
+			ERROR("%s: can't show format %d\n", __func__, resource->format);
+			return;
+	}
+	uint32 width = resource->width0;
+	uint32 height = resource->height0;
+
+	struct pipe_box box;
+	memset(&box, 0, sizeof(box));
+	box.width = width;
+	box.height = height;
+	box.depth = 1;
+	struct pipe_transfer* transfer;
+	const uint8* source = (const uint8*)context->texture_map(context,
+		resource, 0, PIPE_MAP_READ, &box, &transfer);
+	if (source == NULL) {
+		ERROR("%s: can't read the frame back\n", __func__);
+		return;
+	}
+
+	{
+		BAutolock lock(fBitmapLocker);
+		if (fBitmap == NULL || fBitmap->ColorSpace() != colorSpace
+			|| fBitmap->Bounds().IntegerWidth() + 1 != (int32)width
+			|| fBitmap->Bounds().IntegerHeight() + 1 != (int32)height) {
+			delete fBitmap;
+			fBitmap = new(std::nothrow) BBitmap(
+				BRect(0, 0, width - 1, height - 1), colorSpace);
+			if (fBitmap != NULL && fBitmap->InitCheck() != B_OK) {
+				delete fBitmap;
+				fBitmap = NULL;
+			}
+		}
+		if (fBitmap != NULL) {
+			uint8* target = (uint8*)fBitmap->Bits();
+			int32 targetStride = fBitmap->BytesPerRow();
+			size_t rowBytes = width * bytesPerPixel;
+			for (uint32 y = 0; y < height; y++) {
+				memcpy(target + y * targetStride,
+					source + y * transfer->stride, rowBytes);
+			}
+		}
+	}
+	context->texture_unmap(context, transfer);
+
+	// Only this thread changes fBitmap; not holding fBitmapLocker here
+	// keeps Display() (which locks the window) clear of a window thread
+	// waiting for it in ShowLastFrame().
+	if (fBitmap != NULL)
+		Display(fBitmap, NULL);
+}
+
+
+/*!	Shows the last frame again, without touching the GPU (the window
+	thread, when the view needs redrawing).
+*/
+void
+LimaRenderer::ShowLastFrame()
+{
+	BAutolock lock(fBitmapLocker);
+	if (fBitmap != NULL)
+		Display(fBitmap, NULL);
+}
+
+
+void
+LimaRenderer::SwapBuffers(bool vsync)
+{
+	BScreen screen(GLView()->Window());
+	fContextObj->SwapBuffers(fContextID);
+	fContextObj->Validate(fWidth, fHeight);
+	if (vsync)
+		screen.WaitForRetrace();
+}
+
+
+void
+LimaRenderer::Draw(BRect updateRect)
+{
+//	CALLED();
+	ShowLastFrame();
+}
+
+
+status_t
+LimaRenderer::CopyPixelsOut(BPoint location, BBitmap *bitmap)
+{
+	CALLED();
+
+	// TODO: implement
+	return B_ERROR;
+}
+
+
+status_t
+LimaRenderer::CopyPixelsIn(BBitmap *bitmap, BPoint location)
+{
+	CALLED();
+
+	// TODO: implement
+	return B_ERROR;
+}
+
+
+void
+LimaRenderer::EnableDirectMode(bool enabled)
+{
+	fDirectModeEnabled = enabled;
+}
+
+
+void
+LimaRenderer::DirectConnected(direct_buffer_info *info)
+{
+//	CALLED();
+	BAutolock lock(fInfoLocker);
+	if (info) {
+		if (!fInfo) {
+			fInfo = (direct_buffer_info *)calloc(1,
+				DIRECT_BUFFER_INFO_AREA_SIZE);
+		}
+		memcpy(fInfo, info, DIRECT_BUFFER_INFO_AREA_SIZE);
+	} else if (fInfo) {
+		free(fInfo);
+		fInfo = NULL;
+	}
+}
+
+
+void
+LimaRenderer::FrameResized(float width, float height)
+{
+	TRACE("%s: %f x %f\n", __func__, width, height);
+
+	BAutolock lock(fInfoLocker);
+	fWidth = (GLuint)width;
+	fHeight = (GLuint)height;
+}
