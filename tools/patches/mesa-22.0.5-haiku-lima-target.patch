+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+/*
+ * The first hardware test of Mesa's lima driver on Haiku's meson_mali
+ * (docs/m43-mesa-lima-haiku.md §4, stage 1): a 64x64 linear render target
+ * is cleared red, then green, and read back and checked pixel by pixel
+ * after each; then rounds of clearing a 1920x1080 one and reading it back
+ * are timed.
+ *
+ * Usage: limatest [rounds]	(100 by default)
+ * Exit status 0 only if every pixel matched; 1 if one didn't; 2 if the
+ * test couldn't run. LIMA_DEVICE names another device than
+ * /dev/misc/mali/0. With LIMA_HAIKU_NOOP=1 (the libdrm stand-in's no-op
+ * back end) everything runs, but reads back zeros.
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <xf86drm.h>
+#include "drm-uapi/lima_drm.h"
+
+#include "pipe/p_context.h"
+#include "pipe/p_defines.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+#include "util/u_inlines.h"
+
+#include "lima/drm/lima_drm_public.h"
+
+
+#define DEVICE "/dev/misc/mali/0"
+
+/* as a little-endian uint32: 0xAARRGGBB */
+#define FORMAT PIPE_FORMAT_B8G8R8A8_UNORM
+
+struct target {
+   struct pipe_resource *resource;
+   struct pipe_surface *surface;
+   unsigned width;
+   unsigned height;
+};
+
+
+static double
+now_ms(void)
+{
+   struct timespec time;
+   clock_gettime(CLOCK_MONOTONIC, &time);
+   return time.tv_sec * 1000.0 + time.tv_nsec / 1000000.0;
+}
+
+
+static bool
+target_create(struct pipe_screen *screen, struct pipe_context *context,
+              unsigned width, unsigned height, struct target *target)
+{
+   struct pipe_resource templat;
+   memset(&templat, 0, sizeof(templat));
+   templat.target = PIPE_TEXTURE_2D;
+   templat.format = FORMAT;
+   templat.width0 = width;
+   templat.height0 = height;
+   templat.depth0 = 1;
+   templat.array_size = 1;
+   templat.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_LINEAR;
+   target->resource = screen->resource_create(screen, &templat);
+   if (target->resource == NULL) {
+      fprintf(stderr, "limatest: no %ux%u render target\n", width, height);
+      return false;
+   }
+
+   struct pipe_surface surface;
+   memset(&surface, 0, sizeof(surface));
+   surface.format = FORMAT;
+   target->surface = context->create_surface(context, target->resource,
+                                             &surface);
+   if (target->surface == NULL) {
+      fprintf(stderr, "limatest: no %ux%u surface\n", width, height);
+      pipe_resource_reference(&target->resource, NULL);
+      return false;
+   }
+
+   struct pipe_framebuffer_state framebuffer;
+   memset(&framebuffer, 0, sizeof(framebuffer));
+   framebuffer.width = width;
+   framebuffer.height = height;
+   framebuffer.nr_cbufs = 1;
+   framebuffer.cbufs[0] = target->surface;
+   context->set_framebuffer_state(context, &framebuffer);
+
+   target->width = width;
+   target->height = height;
+   return true;
+}
+
+
+static void
+target_destroy(struct pipe_context *context, struct target *target)
+{
+   struct pipe_framebuffer_state framebuffer;
+   memset(&framebuffer, 0, sizeof(framebuffer));
+   context->set_framebuffer_state(context, &framebuffer);
+   pipe_surface_reference(&target->surface, NULL);
+   pipe_resource_reference(&target->resource, NULL);
+}
+
+
+static void
+clear(struct pipe_context *context, uint32_t color)
+{
+   union pipe_color_union value;
+   value.f[0] = ((color >> 16) & 0xff) / 255.0f;
+   value.f[1] = ((color >> 8) & 0xff) / 255.0f;
+   value.f[2] = (color & 0xff) / 255.0f;
+   value.f[3] = (color >> 24) / 255.0f;
+   context->clear(context, PIPE_CLEAR_COLOR0, NULL, &value, 0.0, 0);
+}
+
+
+static void *
+map(struct pipe_context *context, struct target *target,
+    struct pipe_transfer **transfer)
+{
+   struct pipe_box box;
+   memset(&box, 0, sizeof(box));
+   box.width = target->width;
+   box.height = target->height;
+   box.depth = 1;
+   return context->texture_map(context, target->resource, 0, PIPE_MAP_READ,
+                               &box, transfer);
+}
+
+
+/* The pixels that aren't \a expected; the first is reported. */
+static unsigned
+check(const uint8_t *pixels, unsigned stride, unsigned width,
+      unsigned height, uint32_t expected, const char *what)
+{
+   unsigned wrong = 0;
+   for (unsigned y = 0; y < height; y++) {
+      for (unsigned x = 0; x < width; x++) {
+         uint32_t pixel;
+         memcpy(&pixel, pixels + y * stride + x * 4, 4);
+         if (pixel == expected)
+            continue;
+         if (wrong == 0) {
+            printf("%s: pixel (%u, %u) is %08x, not %08x\n", what, x, y,
+                   pixel, expected);
+         }
+         wrong++;
+      }
+   }
+   return wrong;
+}
+
+
+int
+main(int argc, char **argv)
+{
+   static const uint32_t colors[2] = { 0xffff0000, 0xff00ff00 };
+   static const char *names[2] = { "red", "green" };
+
+   int rounds = argc > 1 ? atoi(argv[1]) : 100;
+   if (rounds < 1)
+      rounds = 1;
+   if (getenv("LIMA_HAIKU_NOOP") != NULL)
+      printf("LIMA_HAIKU_NOOP: no GPU, the pixels read back are zeros\n");
+
+   const char *path = getenv("LIMA_DEVICE");
+   if (path == NULL || path[0] == '\0')
+      path = DEVICE;
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0) {
+      fprintf(stderr, "limatest: %s: %s\n", path, strerror(errno));
+      return 2;
+   }
+
+   /* what the driver says, through the libdrm stand-in alone */
+   struct drm_lima_get_param param;
+   memset(&param, 0, sizeof(param));
+   param.param = DRM_LIMA_PARAM_GPU_ID;
+   if (drmIoctl(fd, DRM_IOCTL_LIMA_GET_PARAM, &param) != 0) {
+      fprintf(stderr, "limatest: GET_PARAM GPU_ID: %s\n", strerror(errno));
+      return 2;
+   }
+   printf("GPU_ID %llu%s\n", (unsigned long long)param.value,
+          param.value == DRM_LIMA_PARAM_GPU_ID_MALI450 ? " (Mali-450)" : "");
+   memset(&param, 0, sizeof(param));
+   param.param = DRM_LIMA_PARAM_NUM_PP;
+   if (drmIoctl(fd, DRM_IOCTL_LIMA_GET_PARAM, &param) != 0) {
+      fprintf(stderr, "limatest: GET_PARAM NUM_PP: %s\n", strerror(errno));
+      return 2;
+   }
+   printf("NUM_PP %llu\n", (unsigned long long)param.value);
+
+   struct pipe_screen *screen = lima_drm_screen_create(fd);
+   close(fd);
+      /* the screen has a duplicate of its own */
+   if (screen == NULL) {
+      fprintf(stderr, "limatest: no lima screen on %s\n", path);
+      return 2;
+   }
+   printf("screen: %s, vendor %s\n", screen->get_name(screen),
+          screen->get_vendor(screen));
+
+   struct pipe_context *context = screen->context_create(screen, NULL, 0);
+   if (context == NULL) {
+      fprintf(stderr, "limatest: no context\n");
+      screen->destroy(screen);
+      return 2;
+   }
+
+   bool passed = true;
+   int status = 0;
+   struct target target;
+   struct pipe_transfer *transfer;
+
+   /* 64x64: red, then green, each checked */
+   if (!target_create(screen, context, 64, 64, &target)) {
+      status = 2;
+      goto out;
+   }
+   for (int i = 0; i < 2; i++) {
+      clear(context, colors[i]);
+      struct pipe_fence_handle *fence = NULL;
+      context->flush(context, &fence, 0);
+      if (fence != NULL) {
+         if (!screen->fence_finish(screen, context, fence,
+                                   PIPE_TIMEOUT_INFINITE)) {
+            printf("64x64 %s: the fence wait failed\n", names[i]);
+         }
+         screen->fence_reference(screen, &fence, NULL);
+      } else
+         printf("64x64 %s: no fence\n", names[i]);
+
+      const uint8_t *pixels = map(context, &target, &transfer);
+      if (pixels == NULL) {
+         fprintf(stderr, "limatest: can't map the 64x64 target\n");
+         target_destroy(context, &target);
+         status = 2;
+         goto out;
+      }
+      char what[32];
+      snprintf(what, sizeof(what), "64x64 %s", names[i]);
+      unsigned wrong = check(pixels, transfer->stride, 64, 64, colors[i],
+                             what);
+      context->texture_unmap(context, transfer);
+      printf("%s: %u of %u pixels wrong\n", what, wrong, 64 * 64);
+      if (wrong != 0)
+         passed = false;
+   }
+   target_destroy(context, &target);
+
+   /* 1920x1080: clear, flush, wait and copy out, as a presented frame is */
+   const unsigned width = 1920, height = 1080;
+   if (!target_create(screen, context, width, height, &target)) {
+      status = 2;
+      goto out;
+   }
+   uint8_t *copy = malloc(width * height * 4);
+   if (copy == NULL) {
+      target_destroy(context, &target);
+      status = 2;
+      goto out;
+   }
+   double waited = 0, copied = 0;
+   double start = now_ms();
+   for (int round = 0; round < rounds; round++) {
+      clear(context, colors[round & 1]);
+      context->flush(context, NULL, 0);
+
+      double mapStart = now_ms();
+      const uint8_t *pixels = map(context, &target, &transfer);
+      double copyStart = now_ms();
+      if (pixels == NULL) {
+         fprintf(stderr, "limatest: can't map the %ux%u target\n", width,
+                 height);
+         free(copy);
+         target_destroy(context, &target);
+         status = 2;
+         goto out;
+      }
+      for (unsigned y = 0; y < height; y++) {
+         memcpy(copy + y * width * 4, pixels + y * transfer->stride,
+                width * 4);
+      }
+      context->texture_unmap(context, transfer);
+      waited += copyStart - mapStart;
+      copied += now_ms() - copyStart;
+   }
+   double total = now_ms() - start;
+   unsigned wrong = check(copy, width * 4, width, height,
+                          colors[(rounds - 1) & 1], "1920x1080");
+   printf("1920x1080: %u of %u pixels of the last frame wrong\n", wrong,
+          width * height);
+   if (wrong != 0)
+      passed = false;
+   printf("1920x1080: %d rounds, %.2f ms per clear and read back "
+          "(%.2f ms waiting in texture_map, %.2f ms copying: %.0f MB/s)\n",
+          rounds, total / rounds, waited / rounds, copied / rounds,
+          copied > 0 ? (double)width * height * 4 * rounds / 1000.0
+             / copied : 0.0);
+   free(copy);
+   target_destroy(context, &target);
+
+out:
+   context->destroy(context);
+   screen->destroy(screen);
+   if (status == 0 && !passed)
+      status = 1;
+   printf("limatest: %s\n", status == 0 ? "passed"
+          : status == 1 ? "FAILED" : "couldn't run");
+   return status;
+}
