From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Sun, 1 Nov 2026 15:37:01 -0500
Subject: [PATCH 233/342] usb_webcam: the first skipped pictures' ends, in the
 log (for the test)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../usb_webcam/addons/uvc/UVCCamDevice.cpp     | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCCamDevice.cpp b/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCCamDevice.cpp
index 5092690536..3ab57f45e4 100644
--- a/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCCamDevice.cpp
+++ b/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCCamDevice.cpp
@@ -2067,8 +2067,22 @@ UVCCamDevice::_HardwareDecoderThread()
 					sizeof(write)) == 0;
 				if (!written)
 					notWritten++;
-			} else
-				cutShort++;
+			} else {
+				if (cutShort++ < 3) {
+					// where its end is, if anywhere (FF D9 can't be in the
+					// entropy-coded data)
+					size_t end = 0;
+					for (size_t k = length - 2; k > 2 && end == 0; k--) {
+						if (data[k] == 0xff && data[k + 1] == 0xd9)
+							end = k;
+					}
+					debug_printf("usb_webcam: picture skipped: %zu bytes, "
+						"starts %02x%02x, ends %02x%02x%02x%02x, EOI at %zu\n",
+						length, data[0], data[1], data[length - 4],
+						data[length - 3], data[length - 2], data[length - 1],
+						end);
+				}
+			}
 			delete frame;
 		}
 
