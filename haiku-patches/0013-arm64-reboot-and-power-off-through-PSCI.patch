From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Wed, 28 Oct 2026 01:18:50 -0400
Subject: [PATCH 013/342] arm64: reboot and power off through PSCI

The EFI loader records the PSCI conduit (smc or hvc, from the device tree
or the ACPI FADT) in the new arch_kernel_args::psci_conduit;
arch_cpu_shutdown() issues PSCI SYSTEM_RESET or SYSTEM_OFF with it instead
of returning B_ERROR. Also guards against a /psci node without "method".

Tested on the ODROID-C2: KDL "reboot" resets the board (BL31 prints
"bl31 reboot", the boot ROM starts over). SYSTEM_OFF is untested.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../kernel/arch/arm64/arch_kernel_args.h      |  7 ++++++
 .../boot/platform/efi/arch/arm64/arch_smp.cpp | 11 +++++++--
 src/system/kernel/arch/arm64/arch_cpu.cpp     | 23 ++++++++++++++++++-
 3 files changed, 38 insertions(+), 3 deletions(-)

diff --git a/headers/private/kernel/arch/arm64/arch_kernel_args.h b/headers/private/kernel/arch/arm64/arch_kernel_args.h
index 459ce88c4b..13d0b70277 100644
--- a/headers/private/kernel/arch/arm64/arch_kernel_args.h
+++ b/headers/private/kernel/arch/arm64/arch_kernel_args.h
@@ -35,6 +35,13 @@ typedef struct {
 	uart_info	uart;
 	intc_info	interrupt_controller;
 
+	// how to call PSCI firmware (system reset/off), see PSCI_CONDUIT_*
+	uint32		psci_conduit;
+
 } _PACKED arch_kernel_args;
 
+#define PSCI_CONDUIT_NONE	0
+#define PSCI_CONDUIT_SMC	1
+#define PSCI_CONDUIT_HVC	2
+
 #endif	/* KERNEL_ARCH_ARM64_KERNEL_ARGS_H */
diff --git a/src/system/boot/platform/efi/arch/arm64/arch_smp.cpp b/src/system/boot/platform/efi/arch/arm64/arch_smp.cpp
index e697a773e3..b59e27cfd2 100644
--- a/src/system/boot/platform/efi/arch/arm64/arch_smp.cpp
+++ b/src/system/boot/platform/efi/arch/arm64/arch_smp.cpp
@@ -263,10 +263,13 @@ arm64_handle_acpi_fadt(acpi_fadt_arm_boot_arch armBootFlags)
 		return;
 
 	sCpuEnableMethod = CpuEnableMethod::Psci;
-	if (armBootFlags.psci_use_hvc)
+	if (armBootFlags.psci_use_hvc) {
 		sPsciCallFn = arm64_psci_call_hvc;
-	else
+		gKernelArgs.arch_args.psci_conduit = PSCI_CONDUIT_HVC;
+	} else {
 		sPsciCallFn = arm64_psci_call_smc;
+		gKernelArgs.arch_args.psci_conduit = PSCI_CONDUIT_SMC;
+	}
 }
 
 
@@ -275,11 +278,15 @@ arm64_handle_fdt_psci_node(const void* fdt, int node)
 {
 	const char* method = (const char*)fdt_getprop(fdt, node,
 		"method", NULL);
+	if (method == NULL)
+		return;
 
 	if (strcmp(method, "smc") == 0) {
 		sPsciCallFn = arm64_psci_call_smc;
+		gKernelArgs.arch_args.psci_conduit = PSCI_CONDUIT_SMC;
 	} else if (strcmp(method, "hvc") == 0) {
 		sPsciCallFn = arm64_psci_call_hvc;
+		gKernelArgs.arch_args.psci_conduit = PSCI_CONDUIT_HVC;
 	}
 }
 
diff --git a/src/system/kernel/arch/arm64/arch_cpu.cpp b/src/system/kernel/arch/arm64/arch_cpu.cpp
index 643dc98c96..8f622310d0 100644
--- a/src/system/kernel/arch/arm64/arch_cpu.cpp
+++ b/src/system/kernel/arch/arm64/arch_cpu.cpp
@@ -46,9 +46,14 @@ arch_cpu_init_percpu(kernel_args *args, int curr_cpu)
 }
 
 
+static uint32 sPsciConduit = PSCI_CONDUIT_NONE;
+
+
 status_t
 arch_cpu_init(kernel_args *args)
 {
+	sPsciConduit = args->arch_args.psci_conduit;
+
 	for (uint32 i = 0; i < args->num_cpus; i++) {
 		cpu_ent* cpu = &gCPU[i];
 
@@ -77,7 +82,23 @@ arch_cpu_init_post_modules(kernel_args *args)
 status_t
 arch_cpu_shutdown(bool reboot)
 {
-	// never reached
+	// PSCI 0.2+ SYSTEM_RESET / SYSTEM_OFF; they only return on failure.
+	static const uint64 kPsciSystemOff = 0x84000008;
+	static const uint64 kPsciSystemReset = 0x84000009;
+
+	register uint64 function asm("x0") = reboot
+		? kPsciSystemReset : kPsciSystemOff;
+	switch (sPsciConduit) {
+		case PSCI_CONDUIT_SMC:
+			asm volatile("smc #0" : "+r"(function) : : "memory");
+			break;
+		case PSCI_CONDUIT_HVC:
+			asm volatile("hvc #0" : "+r"(function) : : "memory");
+			break;
+		default:
+			break;
+	}
+
 	return B_ERROR;
 }
 
