+
+#ifndef R22B_RX_DESC_H
+#define R22B_RX_DESC_H
+
+/*
+ * Rx descriptor (rtw88 rx.h, struct rtw_rx_desc; 24 bytes on the 8822B).
+ * Dword 0 has the same layout as rtwn's struct rtwn_rx_stat_common
+ * (RTWN_RXDW0_*), so the generic rtwn Rx code can parse it; only the
+ * fields rtw88 uses are defined here.
+ */
+struct r22b_rx_stat {
+	uint32_t	rxdw0;		/* see RTWN_RXDW0_* */
+
+	uint32_t	rxdw1;
+#define R22B_RXDW1_MACID_M	0x0000007f
+#define R22B_RXDW1_MACID_S	0
+
+	uint32_t	rxdw2;
+#define R22B_RXDW2_C2H		0x10000000
+#define R22B_RXDW2_PPDU_CNT_M	0x60000000
+#define R22B_RXDW2_PPDU_CNT_S	29
+
+	uint32_t	rxdw3;
+#define R22B_RXDW3_RATE_M	0x0000007f
+#define R22B_RXDW3_RATE_S	0
+
+	uint32_t	rxdw4;
+#define R22B_RXDW4_BW_M		0x00000030
+#define R22B_RXDW4_BW_S		4
+#define R22B_RXDW4_BW20		0
+#define R22B_RXDW4_BW40		1
+#define R22B_RXDW4_BW80		2
+
+	uint32_t	tsf_low;	/* W5 TSFL */
+} __packed __attribute__((aligned(4)));
+
+/*
+ * PHY status (rtw8822b.h GET_PHY_STAT_*); 32 bytes, page selected by the
+ * low nibble of byte 0.  Page 0 is reported for CCK, page 1 for OFDM,
+ * HT and VHT frames.
+ */
+#define R22B_PHY_STAT_PAGE(p)		((p)[0] & 0x0f)
+#define R22B_PHY_STAT_P0_PWDB(p)	((p)[1])	/* W0 [15:8] */
+#define R22B_PHY_STAT_P1_PWDB_A(p)	((p)[1])	/* W0 [15:8] */
+#define R22B_PHY_STAT_P1_PWDB_B(p)	((p)[2])	/* W0 [23:16] */
+#define R22B_PHY_STAT_P1_L_RXSC(p)	((p)[5] & 0x0f)	/* W1 [11:8] */
+#define R22B_PHY_STAT_P1_HT_RXSC(p)	((p)[5] >> 4)	/* W1 [15:12] */
+#define R22B_PHY_STAT_P1_RF_MODE(p)	(((p)[15] >> 4) & 0x3) /* W3 [29:28] */
+
+#endif	/* R22B_RX_DESC_H */
