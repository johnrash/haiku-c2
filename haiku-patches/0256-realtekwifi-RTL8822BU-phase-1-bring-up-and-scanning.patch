@@ -0,0 +1,399 @@
+/*-
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright(c) 2018-2019  Realtek Corporation
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ *
+ * Derived from Linux's rtw88 driver (v7.0), used under its BSD-3-Clause option;
+ * see LICENSE.rtw88 in this directory.
+ */
+
+#ifndef R22B_REG_H
+#define R22B_REG_H
+
+/*
+ * RTL8822B register definitions, taken from rtw88's reg.h, rtw8822b.h,
+ * bf.h, mac.h and usb.h.  Names keep the rtw88 spelling with an R22B_
+ * prefix so that they can be compared with the Linux driver easily.
+ */
+
+#define R22B_BIT(n)		(1U << (n))
+#define R22B_GENMASK(h, l)	(((~0U) >> (31 - (h))) & ((~0U) << (l)))
+
+/*
+ * MAC / system registers.
+ */
+#define R22B_REG_SYS_FUNC_EN		0x0002
+#define R22B_BIT_FEN_BB_GLB_RST		R22B_BIT(1)
+#define R22B_BIT_FEN_BB_RSTB		R22B_BIT(0)
+#define R22B_BIT_FEN_CPUEN		R22B_BIT(2)	/* in REG_SYS_FUNC_EN + 1 */
+#define R22B_REG_SYS_PW_CTRL		0x0004
+#define R22B_REG_SYS_CLK_CTRL		0x0008
+#define R22B_BIT_CPU_CLK_EN		R22B_BIT(14)
+#define R22B_REG_RSV_CTRL		0x001c
+#define R22B_BIT_WLMCU_IOIF		R22B_BIT(0)	/* in REG_RSV_CTRL + 1 */
+#define R22B_REG_RF_CTRL		0x001f
+#define R22B_BIT_RF_SDM_RSTB		R22B_BIT(2)
+#define R22B_BIT_RF_RSTB		R22B_BIT(1)
+#define R22B_BIT_RF_EN			R22B_BIT(0)
+#define R22B_REG_AFE_CTRL1		0x0024
+#define R22B_BIT_MAC_CLK_SEL		(R22B_BIT(20) | R22B_BIT(21))
+#define R22B_BIT_SHIFT_MAC_CLK_SEL	20
+#define R22B_MAC_CLK_HW_DEF_80M		0
+#define R22B_MAC_CLK_SPEED		80
+#define R22B_REG_AFE_XTAL_CTRL		0x0024
+#define R22B_REG_AFE_PLL_CTRL		0x0028
+#define R22B_REG_LDO_EFUSE_CTRL		0x0034
+#define R22B_BIT_MASK_EFUSE_BANK_SEL	(R22B_BIT(8) | R22B_BIT(9))
+#define R22B_BIT_LDO25_EN		R22B_BIT(7)	/* in REG_LDO_EFUSE_CTRL + 3 */
+#define R22B_REG_GPIO_MUXCFG		0x0040
+#define R22B_BIT_FSPI_EN		R22B_BIT(19)
+#define R22B_BIT_PO_BT_PTA_PINS		R22B_BIT(9)
+#define R22B_BIT_BT_PTA_EN		R22B_BIT(5)
+#define R22B_BIT_WLRFE_4_5_EN		R22B_BIT(2)
+#define R22B_REG_LED_CFG		0x004c
+#define R22B_BIT_LNAON_SEL_EN		R22B_BIT(26)
+#define R22B_BIT_PAPE_SEL_EN		R22B_BIT(25)
+#define R22B_BIT_DPDT_WL_SEL		R22B_BIT(24)
+#define R22B_BIT_DPDT_SEL_EN		R22B_BIT(23)
+#define R22B_REG_PAD_CTRL1		0x0064
+#define R22B_BIT_PAPE_WLBT_SEL		R22B_BIT(29)
+#define R22B_BIT_LNAON_WLBT_SEL		R22B_BIT(28)
+#define R22B_BIT_BTGP_JTAG_EN		R22B_BIT(24)
+#define R22B_BIT_BTGP_SPI_EN		R22B_BIT(20)
+#define R22B_BIT_LED1DIS		R22B_BIT(15)
+#define R22B_REG_SYS_SDIO_CTRL		0x0070
+#define R22B_BIT_DBG_GNT_WL_BT		R22B_BIT(27)
+#define R22B_BIT_LTE_MUX_CTRL_PATH	R22B_BIT(26)
+#define R22B_REG_MCUFW_CTRL		0x0080
+#define R22B_BIT_BOOT_FSPI_EN		R22B_BIT(20)
+#define R22B_BIT_FW_INIT_RDY		R22B_BIT(15)
+#define R22B_BIT_FW_DW_RDY		R22B_BIT(14)
+#define R22B_BIT_CPU_CLK_SEL		(R22B_BIT(12) | R22B_BIT(13))
+#define R22B_BIT_RPWM_TOGGLE		R22B_BIT(7)
+#define R22B_BIT_DMEM_CHKSUM_OK		R22B_BIT(6)
+#define R22B_BIT_DMEM_DW_OK		R22B_BIT(5)
+#define R22B_BIT_IMEM_CHKSUM_OK		R22B_BIT(4)
+#define R22B_BIT_IMEM_DW_OK		R22B_BIT(3)
+#define R22B_BIT_MCUFWDL_EN		R22B_BIT(0)
+#define R22B_BIT_CHECK_SUM_OK		(R22B_BIT(4) | R22B_BIT(6))
+#define R22B_FW_READY			(R22B_BIT_FW_INIT_RDY | \
+					 R22B_BIT_FW_DW_RDY | \
+					 R22B_BIT_IMEM_DW_OK | \
+					 R22B_BIT_DMEM_DW_OK | \
+					 R22B_BIT_CHECK_SUM_OK)
+#define R22B_FW_READY_MASK		(0xffff & ~R22B_BIT_CPU_CLK_SEL)
+#define R22B_REG_WIFI_BT_INFO		0x00aa
+#define R22B_BIT_BT_INT_EN		R22B_BIT(15)
+#define R22B_REG_EFUSE_ACCESS		0x00cf
+#define R22B_REG_WLRF1			0x00ec
+#define R22B_BIT_WLRF1_BBRF_EN		(R22B_BIT(24) | R22B_BIT(25) | \
+					 R22B_BIT(26))
+#define R22B_REG_SYS_CFG1		0x00f0
+#define R22B_BIT_RTL_ID			R22B_BIT(23)
+#define R22B_BIT_RF_TYPE_ID		R22B_BIT(27)
+#define R22B_BIT_SHIFT_CHIP_VER		12
+#define R22B_BIT_MASK_CHIP_VER		0xf
+#define R22B_REG_SYS_STATUS1		0x00f4
+#define R22B_REG_SYS_CFG2		0x00fc
+
