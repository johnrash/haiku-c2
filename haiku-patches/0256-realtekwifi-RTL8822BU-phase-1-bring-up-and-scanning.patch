+/*
+ * TODO (later phase): LED control.  rtw8822b_led_set() drives LED2 in
+ * software mode: REG_LED_CFG[18:16] (LED2_CM) = 0, clear
+ * BIT_GPIO13_14_WL_CTRL_EN (bit 22), BIT_LED2_SV (bit 19) = 1 for off.
+ */
+void
+r22b_set_led(struct rtwn_softc *sc, int led, int on)
+{
+}
