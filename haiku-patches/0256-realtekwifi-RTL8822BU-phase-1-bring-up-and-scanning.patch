index 0000000000..bacda87642
--- /dev/null
+++ b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_attach.c
@@ -0,0 +1,379 @@
+/*-
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright(c) 2018-2019  Realtek Corporation
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ *
+ * Derived from Linux's rtw88 driver (v7.0), used under its BSD-3-Clause option;
+ * see LICENSE.rtw88 in this directory.
+ */
+
+/*
+ * RTL8822BU ("RTL8812BU AC1300") attachment: rtwn hooks and chip
+ * parameters (rtw88's rtw8822b_hw_spec), register access over USB.
+ *
+ * Sources (rtw88 v7.0): rtw8822b.c (rtw8822b_hw_spec), usb.c
+ * (rtw_usb_read, rtw_usb_write, rtw_usb_reg_sec), main.c
+ * (rtw_init_ht_cap, rtw_init_vht_cap, rtw_core_init).
+ */
+
+#include <sys/cdefs.h>
+#include "opt_wlan.h"
+
+#include <sys/param.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/mbuf.h>
+#include <sys/kernel.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/taskqueue.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/linker.h>
+
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/ethernet.h>
+#include <net/if_media.h>
+
+#include <net80211/ieee80211_var.h>
+#include <net80211/ieee80211_radiotap.h>
+
+#include <dev/usb/usb.h>
+#include <dev/usb/usbdi.h>
+
+#include <dev/rtwn/if_rtwnreg.h>
+#include <dev/rtwn/if_rtwnvar.h>
+
+#include <dev/rtwn/if_rtwn_nop.h>
+
+#include <dev/rtwn/usb/rtwn_usb_var.h>
+#include <dev/rtwn/usb/rtwn_usb_reg.h>
+
+#include <dev/rtwn/rtl8192c/r92c.h>
+#include <dev/rtwn/rtl8192c/r92c_reg.h>
+
+#include <dev/rtwn/rtl8822b/r22b.h>
+#include <dev/rtwn/rtl8822b/r22b_tx_desc.h>
+#include <dev/rtwn/rtl8822b/r22b_var.h>
+#include <dev/rtwn/rtl8822b/usb/r22bu.h>
+
+/*
+ * rtw_usb_reg_sec(): after every access to the always-on register
+ * sections (0x00-0xff, 0x1000-0x10ff) rtw88 writes the first byte of the
+ * transferred data to register 0x4e0 on the 8822B/8822C/8821C.  Like
+ * rtw88 this is a single attempt whose result is ignored (rtwn's own
+ * register access retries failed requests ten times).
+ */
+static void
+r22bu_reg_sec(struct rtwn_softc *sc, uint16_t addr, uint8_t data)
+{
+	struct rtwn_usb_softc *uc = RTWN_USB_SOFTC(sc);
+	usb_device_request_t req;
+
+	if (!(addr <= 0xff || (addr >= 0x1000 && addr <= 0x10ff)))
+		return;
+
+	RTWN_ASSERT_LOCKED(sc);
+
+	req.bmRequestType = UT_WRITE_VENDOR_DEVICE;
+	req.bRequest = R22BU_REQ_REGS;
+	USETW(req.wValue, R22BU_REG_ON_SEC_DUMMY);
+	USETW(req.wIndex, 0);
+	USETW(req.wLength, 1);
+	(void)usbd_do_request_flags(uc->uc_udev, &sc->sc_mtx, &req, &data, 0,
+	    NULL, 250 /* ms */);
+}
+
+static uint8_t
+r22bu_read_1(struct rtwn_softc *sc, uint16_t addr)
+{
+	uint8_t val;
+
+	val = rtwn_usb_read_1(sc, addr);
+	r22bu_reg_sec(sc, addr, val);
+	return (val);
+}
+
+static uint16_t
+r22bu_read_2(struct rtwn_softc *sc, uint16_t addr)
+{
+	uint16_t val;
+
+	val = rtwn_usb_read_2(sc, addr);
+	r22bu_reg_sec(sc, addr, val & 0xff);
+	return (val);
+}
+
+static uint32_t
+r22bu_read_4(struct rtwn_softc *sc, uint16_t addr)
+{
+	uint32_t val;
+
+	val = rtwn_usb_read_4(sc, addr);
+	r22bu_reg_sec(sc, addr, val & 0xff);
+	return (val);
+}
+
+static int
+r22bu_write_1(struct rtwn_softc *sc, uint16_t addr, uint8_t val)
+{
+	int error;
+
+	error = rtwn_usb_write_1(sc, addr, val);
+	r22bu_reg_sec(sc, addr, val);
+	return (error);
+}
+
+static int
+r22bu_write_2(struct rtwn_softc *sc, uint16_t addr, uint16_t val)
+{
+	int error;
+
+	error = rtwn_usb_write_2(sc, addr, val);
+	r22bu_reg_sec(sc, addr, val & 0xff);
+	return (error);
+}
+
+static int
+r22bu_write_4(struct rtwn_softc *sc, uint16_t addr, uint32_t val)
+{
+	int error;
+
+	error = rtwn_usb_write_4(sc, addr, val);
+	r22bu_reg_sec(sc, addr, val & 0xff);
+	return (error);
+}
+
+static void
+r22bu_postattach(struct rtwn_softc *sc)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct r22b_softc *rs = sc->sc_priv;
+
+	/* Initial gain for maximum coverage while scanning. */
+	rs->rs_scan_start = ic->ic_scan_start;
+	ic->ic_scan_start = r22b_scan_start;
+	rs->rs_scan_end = ic->ic_scan_end;
+	ic->ic_scan_end = r22b_scan_end;
+
+	RTWN_LOCK(sc);
+	r22bu_phy_cfg(sc);
+	RTWN_UNLOCK(sc);
+}
+
+static void
+r22b_attach_private(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs;
+
+	rs = malloc(sizeof(struct r22b_softc), M_RTWN_PRIV, M_WAITOK | M_ZERO);
+
+	rs->rs_write_rsvd_page = r22bu_write_rsvd_page;
+	rs->rs_write_h2c_pkt = r22bu_write_h2c_pkt;
+
+	/* rtw_core_init(): hal.current_channel = 1 */
+	rs->cur_chan = 1;
+	rs->cur_pri_chan = 1;
+	rs->cur_bw = R22B_CHANNEL_WIDTH_20;
+	rs->cch_by_bw[R22B_CHANNEL_WIDTH_20] = 1;
+
+	/* Until r22b_read_chipid_vendor() reads REG_SYS_CFG1. */
+	rs->rf_path_num = 2;
+	rs->antenna_tx = R22B_BB_PATH_AB;
+	rs->antenna_rx = R22B_BB_PATH_AB;
+
+	sc->sc_priv = rs;
+}
+
+static void
+r22b_detach_private(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	free(rs, M_RTWN_PRIV);
+}
+
+/* rtw_init_ht_cap() / rtw_init_vht_cap() */
+static void
+r22bu_adj_devcaps(struct rtwn_softc *sc)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+
+	/*
+	 * TODO: beaconing (hostap/IBSS).  The 3081-CPU chips need the
+	 * beacon downloaded as a reserved page (rtw_fw_download_rsvd_page()),
+	 * rtwn's beacon path does not do that yet.
+	 */
+	ic->ic_caps &= ~(IEEE80211_C_IBSS | IEEE80211_C_HOSTAP);
+
+	ic->ic_htcaps |=
+	    IEEE80211_HTCAP_CHWIDTH40 |		/* 40 MHz channel width */
+	    IEEE80211_HTCAP_SHORTGI40 |		/* short GI in 40MHz */
+	    IEEE80211_HTCAP_LDPC |		/* chip->rx_ldpc */
+	    IEEE80211_HTCAP_RXSTBC_1STREAM;
+
+	/* TODO: Tx STBC/LDPC, beamformee capabilities (rtw88 bf.c). */
+
+	/* VHT config */
+	ic->ic_flags_ext |= IEEE80211_FEXT_VHT;
+	ic->ic_vht_cap.vht_cap_info =
+	    IEEE80211_VHTCAP_MAX_MPDU_LENGTH_11454 |
+	    IEEE80211_VHTCAP_SHORT_GI_80 |
+	    IEEE80211_VHTCAP_RXSTBC_1 |
+	    IEEE80211_VHTCAP_HTC_VHT |
+	    IEEE80211_VHTCAP_RXLDPC |
+	    _IEEE80211_SHIFTMASK(7,
+	      IEEE80211_VHTCAP_MAX_A_MPDU_LENGTH_EXPONENT_MASK);
+	if (sc->ntxchains > 1)
+		ic->ic_vht_cap.vht_cap_info |= IEEE80211_VHTCAP_TXSTBC;
+
+	rtwn_attach_vht_cap_info_mcs(sc);
+}
+
+void
+r22bu_attach(struct rtwn_usb_softc *uc)
+{
+	struct rtwn_softc *sc		= &uc->uc_sc;
+
+	/* USB part. */
+	uc->uc_align_rx			= r22bu_align_rx;
+	uc->tx_agg_desc_num		= 1;	/* TODO: Tx aggregation */
+	uc->tx_no_own			= 1;	/* W0 bit 31 is DISQSELSEQ */
+	uc->uc_setup_ep_map		= r22bu_setup_ep_map;
+
+	/* Register access with the rtw88 "reg_on section" workaround. */
+	sc->sc_write_1			= r22bu_write_1;
+	sc->sc_write_2			= r22bu_write_2;
+	sc->sc_write_4			= r22bu_write_4;
+	sc->sc_read_1			= r22bu_read_1;
+	sc->sc_read_2			= r22bu_read_2;
+	sc->sc_read_4			= r22bu_read_4;
+
+	/* Common part. */
+	sc->sc_flags			= RTWN_FLAG_EXT_HDR;
+
+	sc->sc_set_chan			= r22b_set_chan;
+	sc->sc_fill_tx_desc		= r22b_fill_tx_desc;
+	sc->sc_fill_tx_desc_raw		= r22b_fill_tx_desc_raw;
+	sc->sc_fill_tx_desc_null	= r22b_fill_tx_desc_null;
+	sc->sc_dump_tx_desc		= r22bu_dump_tx_desc;
+	sc->sc_tx_radiotap_flags	= r22b_tx_radiotap_flags;
+	sc->sc_rx_radiotap_flags	= r22b_rx_radiotap_flags;
+	sc->sc_get_rx_stats		= r22b_get_rx_stats;
+	sc->sc_get_rssi_cck		= r22b_get_rssi_cck;
+	sc->sc_get_rssi_ofdm		= r22b_get_rssi_ofdm;
+	sc->sc_classify_intr		= r22bu_classify_intr;
+	/* TODO (phase 2): C2H tx reports for net80211 rate control. */
+	sc->sc_handle_tx_report		= rtwn_nop_softc_uint8_int;
+	sc->sc_handle_tx_report2	= rtwn_nop_softc_uint8_int;
+	sc->sc_handle_c2h_report	= r22b_handle_c2h_report;
+	sc->sc_check_frame		= r22b_check_frame;
+	sc->sc_rf_read			= r22b_rf_read;
+	sc->sc_rf_write			= r22b_rf_write;
+	sc->sc_check_condition		= r22b_check_condition;
+	sc->sc_efuse_postread		= r22b_efuse_postread;
+	sc->sc_parse_rom		= r22b_parse_rom;
+	sc->sc_set_led			= r22b_set_led;
+	sc->sc_power_on			= r22b_power_on;
+	sc->sc_power_off		= r22b_power_off;
+#ifndef RTWN_WITHOUT_UCODE
+	/* Not used: sc_fw_download replaces rtwn_load_firmware(). */
+	sc->sc_fw_reset			= rtwn_nop_softc_int;
+	sc->sc_fw_download_enable	= rtwn_nop_softc_int;
+	sc->sc_fw_download		= r22b_fw_download;
+#endif
+	sc->sc_dma_init			= r22bu_dma_init;
+	/* Not used: sc_dma_init replaces rtwn_dma_init(). */
+	sc->sc_llt_init			= rtwn_nop_int_softc;
+	sc->sc_set_page_size		= rtwn_nop_int_softc;
+	sc->sc_lc_calib			= r22b_lc_calib;
+	sc->sc_iq_calib			= r22b_iq_calib;
+	sc->sc_read_chipid_vendor	= r22b_read_chipid_vendor;
+	sc->sc_adj_devcaps		= r22bu_adj_devcaps;
+	sc->sc_vap_preattach		= rtwn_nop_softc_vap;
+	sc->sc_postattach		= r22bu_postattach;
+	sc->sc_detach_private		= r22b_detach_private;
+#ifndef RTWN_WITHOUT_UCODE
+	sc->sc_set_media_status		= r22b_set_media_status;
+	sc->sc_set_rsvd_page		= r22b_set_rsvd_page;
+	sc->sc_set_pwrmode		= r22b_set_pwrmode;
+	sc->sc_set_rssi			= rtwn_nop_softc;	/* TODO */
+#else
+	sc->sc_set_media_status		= rtwn_nop_softc_int;
+#endif
+	sc->sc_beacon_init		= r22b_beacon_init;
+	sc->sc_beacon_enable		= r92c_beacon_enable;
+	sc->sc_sta_beacon_enable	= r92c_sta_beacon_enable;
+	sc->sc_beacon_set_rate		= r22b_beacon_set_rate;
+	sc->sc_beacon_select		= rtwn_nop_softc_int;
+	sc->sc_temp_measure		= r22b_temp_measure;
+	sc->sc_temp_read		= r22b_temp_read;
+	sc->sc_init_tx_agg		= rtwn_nop_softc;	/* TODO */
+	sc->sc_init_rx_agg		= r22bu_init_rx_agg;
+	sc->sc_init_ampdu		= rtwn_nop_softc;	/* in mac init */
+	sc->sc_init_intr		= rtwn_nop_softc;	/* USB */
+	sc->sc_init_edca		= rtwn_nop_softc;	/* in mac init */
+	sc->sc_init_bb			= r22b_init_bb;
+	sc->sc_init_rf			= r22b_init_rf;
+	sc->sc_init_antsel		= rtwn_nop_softc;	/* RFE: set_chan */
+	sc->sc_post_init		= r22b_post_init;
+	sc->sc_init_bcnq1_boundary	= rtwn_nop_int_softc;
+	sc->sc_set_tx_power		= rtwn_nop_int_softc_vap;
+
+	sc->chan_list_5ghz[0]		= r22b_chan_5ghz_0;
+	sc->chan_list_5ghz[1]		= r22b_chan_5ghz_1;
+	sc->chan_list_5ghz[2]		= r22b_chan_5ghz_2;
+	sc->chan_num_5ghz[0]		= nitems(r22b_chan_5ghz_0);
+	sc->chan_num_5ghz[1]		= nitems(r22b_chan_5ghz_1);
+	sc->chan_num_5ghz[2]		= nitems(r22b_chan_5ghz_2);
+
+	/* The rtw88 tables are loaded by r22b_load_table(). */
+	sc->mac_prog			= NULL;
+	sc->mac_size			= 0;
+	sc->bb_prog			= NULL;
+	sc->bb_size			= 0;
+	sc->agc_prog			= NULL;
+	sc->agc_size			= 0;
+	sc->rf_prog			= NULL;
+
+	sc->name			= "RTL8822BU";
+	sc->fwname			= "rtwn-rtl8822bufw";
+	sc->fwsig			= 0;	/* rtw88 header, not checked */
+
+	/* Queue pages are set up by r22bu_dma_init(), not rtwn_dma_init(). */
+	sc->page_count			= 0;
+	sc->pktbuf_count		= 0;
+	sc->npubqpages			= 0;
+	sc->page_size			= R22B_TX_PAGE_SIZE;
+
+	sc->ackto			= R22B_ACKTO;
+
+	sc->txdesc_len			= sizeof(struct r22b_tx_desc);
+	/* rtw_dump_logical_efuse_map() stops at phy - protected size. */
+	sc->efuse_maxlen		= R22B_EFUSE_MAX_LEN -
+					  R22B_EFUSE_PROTECT_LEN;
+	sc->efuse_maplen		= R22B_EFUSE_MAP_LEN;
+	sc->rx_dma_size			= R22B_RXFF_SIZE - R22B_C2H_PKT_BUF - 1;
+
+	/* rtwn uses ids 0 .. macid_limit (inclusive). */
+	sc->macid_limit			= R22B_MACID_MAX;
+	sc->cam_entry_limit		= R22B_CAM_ENTRY_COUNT;
+	sc->fwsize_limit		= R22B_MAX_FW_SIZE;
+	sc->temp_delta			= R22B_IQK_THRESHOLD;
+
+	sc->bcn_status_reg[0]		= R92C_TDECTRL;
+	sc->bcn_status_reg[1]		= R92C_TDECTRL;
+	sc->rcr				= R22B_RCR_DEFAULT;
+
+	/* Updated from REG_SYS_CFG1 by r22b_read_chipid_vendor(). */
+	sc->ntxchains			= 2;
+	sc->nrxchains			= 2;
+
+	sc->sc_ht40			= 1;
+
+	r22b_attach_private(sc);
+}
