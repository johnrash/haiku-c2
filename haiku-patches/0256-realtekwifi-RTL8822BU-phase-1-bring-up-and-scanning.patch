+++ b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_priv.h
@@ -0,0 +1,125 @@
+/*-
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright(c) 2018-2019  Realtek Corporation
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ *
+ * Derived from Linux's rtw88 driver (v7.0), used under its BSD-3-Clause option;
+ * see LICENSE.rtw88 in this directory.
+ */
+
+#ifndef R22B_PRIV_H
+#define R22B_PRIV_H
+
+/*
+ * Masked register access, with the semantics of rtw88's hci.h helpers
+ * (rtw_read32_mask(), rtw_write32_mask(), rtw_write8_mask(), ...): the
+ * value is shifted to the lowest set bit of the mask and every write is
+ * a read-modify-write, even for a full mask.
+ */
+static __inline int
+r22b_mask_shift(uint32_t mask)
+{
+	return (mask == 0 ? 0 : __builtin_ctz(mask));
+}
+
+static __inline uint32_t
+r22b_read32_mask(struct rtwn_softc *sc, uint16_t addr, uint32_t mask)
+{
+	return ((rtwn_read_4(sc, addr) & mask) >> r22b_mask_shift(mask));
+}
+
+static __inline void
+r22b_write32_mask(struct rtwn_softc *sc, uint16_t addr, uint32_t mask,
+    uint32_t data)
+{
+	uint32_t orig;
+
+	orig = rtwn_read_4(sc, addr);
+	rtwn_write_4(sc, addr,
+	    (orig & ~mask) | ((data << r22b_mask_shift(mask)) & mask));
+}
+
+/* rtw8822b.h rtw_write32s_mask(): 0xc00-0xcff and 0xe00-0xeff alike. */
+static __inline void
+r22b_write32s_mask(struct rtwn_softc *sc, uint16_t addr, uint32_t mask,
+    uint32_t data)
+{
+	KASSERT(addr >= 0xc00 && addr < 0xd00,
+	    ("%s: bad address 0x%x\n", __func__, addr));
+	r22b_write32_mask(sc, addr, mask, data);
+	r22b_write32_mask(sc, addr + 0x200, mask, data);
+}
+
+static __inline uint8_t
+r22b_read8_mask(struct rtwn_softc *sc, uint16_t addr, uint32_t mask)
+{
+	mask &= 0xff;
+	return ((rtwn_read_1(sc, addr) & mask) >> r22b_mask_shift(mask));
+}
+
+static __inline void
+r22b_write8_mask(struct rtwn_softc *sc, uint16_t addr, uint32_t mask,
+    uint8_t data)
+{
+	uint8_t orig;
+
+	mask &= 0xff;
+	orig = rtwn_read_1(sc, addr);
+	rtwn_write_1(sc, addr,
+	    (orig & ~mask) | ((data << r22b_mask_shift(mask)) & mask));
+}
+
+static __inline void
+r22b_write8_set(struct rtwn_softc *sc, uint16_t addr, uint8_t bits)
+{
+	rtwn_write_1(sc, addr, rtwn_read_1(sc, addr) | bits);
+}
+
+static __inline void
+r22b_write8_clr(struct rtwn_softc *sc, uint16_t addr, uint8_t bits)
+{
+	rtwn_write_1(sc, addr, rtwn_read_1(sc, addr) & ~bits);
+}
+
+static __inline void
+r22b_write16_set(struct rtwn_softc *sc, uint16_t addr, uint16_t bits)
+{
+	rtwn_write_2(sc, addr, rtwn_read_2(sc, addr) | bits);
+}
+
+static __inline void
+r22b_write32_set(struct rtwn_softc *sc, uint16_t addr, uint32_t bits)
+{
+	rtwn_write_4(sc, addr, rtwn_read_4(sc, addr) | bits);
+}
+
+static __inline void
+r22b_write32_clr(struct rtwn_softc *sc, uint16_t addr, uint32_t bits)
+{
+	rtwn_write_4(sc, addr, rtwn_read_4(sc, addr) & ~bits);
+}
+
+/*
+ * le32p_replace_bits() on dword "dw" of a little-endian H2C buffer, like
+ * rtw88's SET_* H2C macros.
+ */
+static __inline void
+r22b_h2c_set(uint8_t *pkt, int dw, uint32_t mask, uint32_t val)
+{
+	uint32_t v;
+
+	v = le32dec(pkt + dw * 4);
+	v = (v & ~mask) | ((val << r22b_mask_shift(mask)) & mask);
+	le32enc(pkt + dw * 4, v);
+}
+
+/* Sign-extend a 4-bit efuse difference (rtw88 s8:4 bitfields). */
+static __inline int8_t
+r22b_sign4(uint8_t val)
+{
+	val &= 0x0f;
+	return ((val & 0x08) ? (int8_t)(val | 0xf0) : (int8_t)val);
+}
+
+#endif	/* R22B_PRIV_H */
