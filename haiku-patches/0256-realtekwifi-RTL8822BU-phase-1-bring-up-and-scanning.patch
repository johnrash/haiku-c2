+/*
+ * rtw88 util.c check_hw_ready(): poll until (reg & mask) >> shift equals
+ * the target.  rtw88 polls 1000 times, 10 us apart; over USB every read
+ * already takes longer than that, so the timeout here is longer too.
+ */
+int
+r22b_check_hw_ready(struct rtwn_softc *sc, uint16_t addr, uint32_t mask,
+    uint32_t target)
+{
+	int ntries;
+
+	for (ntries = 0; ntries < 1000; ntries++) {
+		if (r22b_read32_mask(sc, addr, mask) == target)
+			return (1);
+		rtwn_delay(sc, 10);
+	}
+
+	return (0);
+}
+
+/*
+ * RF register access.
+ */
+static const uint16_t r22b_rf_base[R22B_RF_PATH_MAX] =
+	{ R22B_RF_BASE_A, R22B_RF_BASE_B };
+static const uint16_t r22b_rf_sipi[R22B_RF_PATH_MAX] =
+	{ R22B_REG_LSSI_WRITE_A, R22B_REG_LSSI_WRITE_B };
+
+/* rtw_phy_read_rf(): direct read through the RF window (full 20 bits). */
+uint32_t
+r22b_rf_read(struct rtwn_softc *sc, int chain, uint8_t addr)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	if (chain < 0 || chain >= rs->rf_path_num) {
+		device_printf(sc->sc_dev, "%s: unsupported RF path %d\n",
+		    __func__, chain);
+		return (0);
+	}
+
+	return (rtwn_read_4(sc, r22b_rf_base[chain] + (addr << 2)) &
+	    R22B_RFREG_MASK);
+}
+
+/* rtw_phy_write_rf_reg_sipi() with a full mask. */
+void
+r22b_rf_write(struct rtwn_softc *sc, int chain, uint8_t addr, uint32_t val)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t data_and_addr;
+
+	if (chain < 0 || chain >= rs->rf_path_num) {
+		device_printf(sc->sc_dev, "%s: unsupported RF path %d\n",
+		    __func__, chain);
+		return;
+	}
+
+	data_and_addr = (((uint32_t)addr << 20) | (val & R22B_RFREG_MASK)) &
+	    0x0fffffff;
+	rtwn_write_4(sc, r22b_rf_sipi[chain], data_and_addr);
+	rtwn_delay(sc, 13);
+}
+
+/* rtw_read_rf() with a mask. */
+uint32_t
+r22b_rf_read_mask(struct rtwn_softc *sc, int chain, uint8_t addr,
+    uint32_t mask)
+{
+	mask &= R22B_RFREG_MASK;
+
+	return ((r22b_rf_read(sc, chain, addr) & mask) >>
+	    r22b_mask_shift(mask));
+}
+
+/* rtw_write_rf() / rtw_phy_write_rf_reg_sipi() with a mask. */
+void
+r22b_rf_write_mask(struct rtwn_softc *sc, int chain, uint8_t addr,
+    uint32_t mask, uint32_t data)
+{
+	uint32_t old;
+
+	mask &= R22B_RFREG_MASK;
+	if (mask != R22B_RFREG_MASK) {
+		old = r22b_rf_read(sc, chain, addr);
+		data = (old & ~mask) |
+		    ((data << r22b_mask_shift(mask)) & mask);
+	}
+
+	r22b_rf_write(sc, chain, addr, data);
+}
+
+/*
+ * Conditional register tables (rtw_parse_tbl_phy_cond()).
+ *
+ * Each table entry is a pair of 32-bit words.  A pair whose first word
+ * has bit 31 ("pos") set opens/closes a branch; one with bit 30 ("neg")
+ * set evaluates the condition stored by the preceding "pos" word; any
+ * other pair is an (address, value) register write.
+ */
+#define R22B_COND_POS		0x80000000
+#define R22B_COND_NEG		0x40000000
+#define R22B_COND_BRANCH(w)	(((w) >> 28) & 0x3)
+#define R22B_COND_CUT(w)	(((w) >> 24) & 0xf)
+#define R22B_COND_PKG(w)	(((w) >> 12) & 0xf)
+#define R22B_COND_INTF(w)	(((w) >> 8) & 0xf)
+#define R22B_COND_RFE(w)	((w) & 0xff)
+
+#define R22B_BRANCH_IF		0
+#define R22B_BRANCH_ELIF	1
+#define R22B_BRANCH_ELSE	2
+#define R22B_BRANCH_ENDIF	3
+
+#define R22B_COND_INTF_USB	0x02	/* INTF_USB */
+
+/* check_positive() for chips other than the RTL8812A/RTL8821A. */
+static int
+r22b_check_positive(struct rtwn_softc *sc, uint32_t cond)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	/* rtw_phy_setup_phy_cond(): pkg_type is 0 on the 8822B, i.e. 15. */
+	const uint32_t drv_cut = rs->cut_version ? rs->cut_version : 15;
+	const uint32_t drv_pkg = 15;
+	const uint32_t drv_intf = R22B_COND_INTF_USB;
+
+	if (R22B_COND_CUT(cond) && R22B_COND_CUT(cond) != drv_cut)
+		return (0);
+	if (R22B_COND_PKG(cond) && R22B_COND_PKG(cond) != drv_pkg)
+		return (0);
+	if (R22B_COND_INTF(cond) && R22B_COND_INTF(cond) != drv_intf)
+		return (0);
+	if (R22B_COND_RFE(cond) != rs->rfe_option)
+		return (0);
+
+	return (1);
+}
+
+/* rtw_phy_cfg_mac / _bb / _agc / _rf */
+static void
+r22b_table_cfg(struct rtwn_softc *sc, const struct r22b_table *tbl,
+    uint32_t addr, uint32_t data)
+{
+	switch (tbl->cfg) {
+	case R22B_TABLE_CFG_MAC:
+		rtwn_write_1(sc, addr, data);
+		break;
+	case R22B_TABLE_CFG_AGC:
+		rtwn_write_4(sc, addr, data);
+		break;
+	case R22B_TABLE_CFG_BB:
+		if (addr == 0xfe)
+			rtwn_delay(sc, 50000);
+		else if (addr == 0xfd)
+			rtwn_delay(sc, 5000);
+		else if (addr == 0xfc)
+			rtwn_delay(sc, 1000);
+		else if (addr == 0xfb)
+			rtwn_delay(sc, 50);
+		else if (addr == 0xfa)
+			rtwn_delay(sc, 5);
+		else if (addr == 0xf9)
+			rtwn_delay(sc, 1);
+		else
+			rtwn_write_4(sc, addr, data);
+		break;
+	case R22B_TABLE_CFG_RF:
+		if (addr == 0xffe)
+			rtwn_delay(sc, 50000);
+		else if (addr == 0xfe)
+			rtwn_delay(sc, 100);
+		else {
+			r22b_rf_write(sc, tbl->rf_path, addr & 0xff, data);
+			rtwn_delay(sc, 1);
+		}
+		break;
+	default:
+		KASSERT(0, ("%s: wrong table type %d\n", __func__, tbl->cfg));
+		break;
+	}
+}
+
+void
+r22b_load_table(struct rtwn_softc *sc, const struct r22b_table *tbl)
+{
+	const uint32_t *p = tbl->data;
+	uint32_t i, w0, w1, pos_cond = 0;
+	int is_matched = 1, is_skipped = 0;
+
+	KASSERT(tbl->cfg <= R22B_TABLE_CFG_RF,
+	    ("%s: not a register table (%d)\n", __func__, tbl->cfg));
+
+	for (i = 0; i + 1 < tbl->size; i += 2) {
+		w0 = p[i];
+		w1 = p[i + 1];
+
+		if (w0 & R22B_COND_POS) {
+			switch (R22B_COND_BRANCH(w0)) {
+			case R22B_BRANCH_ENDIF:
+				is_matched = 1;
+				is_skipped = 0;
+				break;
+			case R22B_BRANCH_ELSE:
+				is_matched = is_skipped ? 0 : 1;
+				break;
+			case R22B_BRANCH_IF:
+			case R22B_BRANCH_ELIF:
+			default:
+				pos_cond = w0;
+				break;
+			}
+		} else if (w0 & R22B_COND_NEG) {
+			if (!is_skipped) {
+				if (r22b_check_positive(sc, pos_cond)) {
+					is_matched = 1;
+					is_skipped = 1;
+				} else {
+					is_matched = 0;
+					is_skipped = 0;
+				}
+			} else
+				is_matched = 0;
+		} else if (is_matched)
+			r22b_table_cfg(sc, tbl, w0, w1);
+	}
+}
+
+/* rtw8822b_cfg_ldo25() */
+void
+r22b_cfg_ldo25(struct rtwn_softc *sc, int enable)
+{
+	uint8_t ldo_pwr;
+
+	ldo_pwr = rtwn_read_1(sc, R22B_REG_LDO_EFUSE_CTRL + 3);
+	if (enable)
+		ldo_pwr |= R22B_BIT_LDO25_EN;
+	else
+		ldo_pwr &= ~R22B_BIT_LDO25_EN;
+	rtwn_write_1(sc, R22B_REG_LDO_EFUSE_CTRL + 3, ldo_pwr);
+}
+
+/*
+ * RFE-type dependent parameters (rtw8822b.c, struct rtw8822b_rfe_info).
+ */
+enum {
+	R22B_CCUT_IDX_1R_2G,
+	R22B_CCUT_IDX_2R_2G,
+	R22B_CCUT_IDX_1R_5G,
+	R22B_CCUT_IDX_2R_5G,
+	R22B_CCUT_IDX_NR
+};
+
+struct r22b_cca_ccut {
+	uint32_t	reg82c[R22B_CCUT_IDX_NR];
+	uint32_t	reg830[R22B_CCUT_IDX_NR];
+	uint32_t	reg838[R22B_CCUT_IDX_NR];
+};
+
+static const struct r22b_cca_ccut r22b_cca_ifem_ccut = {
+	{0x75C97010, 0x75C97010, 0x75C97010, 0x75C97010}, /*Reg82C*/
+	{0x79a0eaaa, 0x79A0EAAC, 0x79a0eaaa, 0x79a0eaaa}, /*Reg830*/
+	{0x87765541, 0x87746341, 0x87765541, 0x87746341}, /*Reg838*/
+};
+
+static const struct r22b_cca_ccut r22b_cca_efem_ccut = {
+	{0x75B86010, 0x75B76010, 0x75B86010, 0x75B76010}, /*Reg82C*/
+	{0x79A0EAA8, 0x79A0EAAC, 0x79A0EAA8, 0x79a0eaaa}, /*Reg830*/
+	{0x87766451, 0x87766431, 0x87766451, 0x87766431}, /*Reg838*/
+};
+
+static const struct r22b_cca_ccut r22b_cca_ifem_ccut_ext = {
+	{0x75da8010, 0x75da8010, 0x75da8010, 0x75da8010}, /*Reg82C*/
+	{0x79a0eaaa, 0x97A0EAAC, 0x79a0eaaa, 0x79a0eaaa}, /*Reg830*/
+	{0x87765541, 0x86666341, 0x87765561, 0x86666361}, /*Reg838*/
+};
+
+enum {
+	R22B_RFE_IFEM,
+	R22B_RFE_EFEM,
+	R22B_RFE_IFEM2G_EFEM5G
+};
+
+struct r22b_rfe_info {
+	const struct r22b_cca_ccut *cca_ccut_2g;
+	const struct r22b_cca_ccut *cca_ccut_5g;
+	int		fem;
+	int		ifem_ext;
+	int		efem_rfe;	/* use rtw8822b_set_channel_rfe_efem() */
+};
+
+static const struct r22b_rfe_info r22b_rfe_info[] = {
+	[2] = {		/* I2GE5G_CCUT(efem) */
+		.cca_ccut_2g = &r22b_cca_ifem_ccut,
+		.cca_ccut_5g = &r22b_cca_efem_ccut,
+		.fem = R22B_RFE_IFEM2G_EFEM5G,
+		.ifem_ext = 0,
+		.efem_rfe = 1,
+	},
+	[3] = {		/* IFEM_EXT_CCUT(ifem) */
+		.cca_ccut_2g = &r22b_cca_ifem_ccut_ext,
+		.cca_ccut_5g = &r22b_cca_ifem_ccut_ext,
+		.fem = R22B_RFE_IFEM,
+		.ifem_ext = 1,
+		.efem_rfe = 0,
+	},
+	[5] = {		/* IFEM_EXT_CCUT(ifem) */
+		.cca_ccut_2g = &r22b_cca_ifem_ccut_ext,
+		.cca_ccut_5g = &r22b_cca_ifem_ccut_ext,
+		.fem = R22B_RFE_IFEM,
+		.ifem_ext = 1,
+		.efem_rfe = 0,
+	},
+};
+
+static const struct r22b_rfe_info *
+r22b_get_rfe_info(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	/* rtw_check_supported_rfe() already refused other RFE types. */
+	if (rs->rfe_option >= nitems(r22b_rfe_info) ||
+	    r22b_rfe_info[rs->rfe_option].cca_ccut_2g == NULL)
+		return (NULL);
+
+	return (&r22b_rfe_info[rs->rfe_option]);
+}
+
+/* rtw8822b_set_channel_rfe_efem() */
+static void
+r22b_set_channel_rfe_efem(struct rtwn_softc *sc, uint8_t channel)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	if (R22B_IS_CH_2G_BAND(channel)) {
+		r22b_write32s_mask(sc, R22B_REG_RFESEL0, 0xffffff, 0x705770);
+		r22b_write32s_mask(sc, R22B_REG_RFESEL8, R22B_MASKBYTE1, 0x57);
+		r22b_write32s_mask(sc, R22B_REG_RFECTL, R22B_BIT(4), 0);
+	} else {
+		r22b_write32s_mask(sc, R22B_REG_RFESEL0, 0xffffff, 0x177517);
+		r22b_write32s_mask(sc, R22B_REG_RFESEL8, R22B_MASKBYTE1, 0x75);
+		r22b_write32s_mask(sc, R22B_REG_RFECTL, R22B_BIT(5), 0);
+	}
+
+	r22b_write32s_mask(sc, R22B_REG_RFEINV,
+	    R22B_BIT(11) | R22B_BIT(10) | 0x3f, 0x0);
+
+	if (rs->antenna_rx == R22B_BB_PATH_AB ||
+	    rs->antenna_tx == R22B_BB_PATH_AB) {
+		/* 2TX or 2RX */
+		r22b_write32s_mask(sc, R22B_REG_TRSW, R22B_MASKLWORD, 0xa501);
+	} else if (rs->antenna_rx == rs->antenna_tx) {
+		/* TXA+RXA or TXB+RXB */
+		r22b_write32s_mask(sc, R22B_REG_TRSW, R22B_MASKLWORD, 0xa500);
+	} else {
+		/* TXB+RXA or TXA+RXB */
+		r22b_write32s_mask(sc, R22B_REG_TRSW, R22B_MASKLWORD, 0xa005);
+	}
+}
+
+/* rtw8822b_set_channel_rfe_ifem() */
+static void
+r22b_set_channel_rfe_ifem(struct rtwn_softc *sc, uint8_t channel)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	if (R22B_IS_CH_2G_BAND(channel)) {
+		/* signal source */
+		r22b_write32s_mask(sc, R22B_REG_RFESEL0, 0xffffff, 0x745774);
+		r22b_write32s_mask(sc, R22B_REG_RFESEL8, R22B_MASKBYTE1, 0x57);
+	} else {
+		/* signal source */
+		r22b_write32s_mask(sc, R22B_REG_RFESEL0, 0xffffff, 0x477547);
+		r22b_write32s_mask(sc, R22B_REG_RFESEL8, R22B_MASKBYTE1, 0x75);
+	}
+
+	r22b_write32s_mask(sc, R22B_REG_RFEINV,
+	    R22B_BIT(11) | R22B_BIT(10) | 0x3f, 0x0);
+
+	if (R22B_IS_CH_2G_BAND(channel)) {
+		if (rs->antenna_rx == R22B_BB_PATH_AB ||
+		    rs->antenna_tx == R22B_BB_PATH_AB) {
+			/* 2TX or 2RX */
+			r22b_write32s_mask(sc, R22B_REG_TRSW, R22B_MASKLWORD,
+			    0xa501);
+		} else if (rs->antenna_rx == rs->antenna_tx) {
+			/* TXA+RXA or TXB+RXB */
+			r22b_write32s_mask(sc, R22B_REG_TRSW, R22B_MASKLWORD,
+			    0xa500);
+		} else {
+			/* TXB+RXA or TXA+RXB */
+			r22b_write32s_mask(sc, R22B_REG_TRSW, R22B_MASKLWORD,
+			    0xa005);
+		}
+	} else
+		r22b_write32s_mask(sc, R22B_REG_TRSW, R22B_MASKLWORD, 0xa5a5);
+}
+
+/* (*rfe_info->rtw_set_channel_rfe)() */
+void
+r22b_set_channel_rfe(struct rtwn_softc *sc, uint8_t channel)
+{
+	const struct r22b_rfe_info *rfe_info = r22b_get_rfe_info(sc);
+
+	if (rfe_info == NULL)
+		return;
+
+	if (rfe_info->efem_rfe)
+		r22b_set_channel_rfe_efem(sc, channel);
+	else
+		r22b_set_channel_rfe_ifem(sc, channel);
+}
+
+/* rtw8822b_set_channel_cca() */
+void
+r22b_set_channel_cca(struct rtwn_softc *sc, uint8_t channel, uint8_t bw)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const struct r22b_rfe_info *rfe_info = r22b_get_rfe_info(sc);
+	const struct r22b_cca_ccut *cca_ccut;
+	uint32_t reg82c, reg830, reg838;
+	int col, is_efem_cca = 0, is_ifem_cca = 0, is_rfe_type = 0;
+
+	if (rfe_info == NULL)
+		return;
+
+	if (R22B_IS_CH_2G_BAND(channel)) {
+		cca_ccut = rfe_info->cca_ccut_2g;
+
+		if (rs->antenna_rx == R22B_BB_PATH_A ||
+		    rs->antenna_rx == R22B_BB_PATH_B)
+			col = R22B_CCUT_IDX_1R_2G;
+		else
+			col = R22B_CCUT_IDX_2R_2G;
+	} else {
+		cca_ccut = rfe_info->cca_ccut_5g;
+
+		if (rs->antenna_rx == R22B_BB_PATH_A ||
+		    rs->antenna_rx == R22B_BB_PATH_B)
+			col = R22B_CCUT_IDX_1R_5G;
+		else
+			col = R22B_CCUT_IDX_2R_5G;
+	}
+
+	reg82c = cca_ccut->reg82c[col];
+	reg830 = cca_ccut->reg830[col];
+	reg838 = cca_ccut->reg838[col];
+
+	switch (rfe_info->fem) {
+	case R22B_RFE_IFEM:
+	default:
+		is_ifem_cca = 1;
+		if (rfe_info->ifem_ext)
+			is_rfe_type = 1;
+		break;
+	case R22B_RFE_EFEM:
+		is_efem_cca = 1;
+		break;
+	case R22B_RFE_IFEM2G_EFEM5G:
+		if (R22B_IS_CH_2G_BAND(channel))
+			is_ifem_cca = 1;
+		else
+			is_efem_cca = 1;
+		break;
+	}
+
+	if (is_ifem_cca) {
+		if ((rs->cut_version == R22B_CUT_B &&
+		     (col == R22B_CCUT_IDX_2R_2G ||
+		      col == R22B_CCUT_IDX_2R_5G) &&
+		     bw == R22B_CHANNEL_WIDTH_40) ||
+		    (!is_rfe_type && col == R22B_CCUT_IDX_2R_5G &&
+		     bw == R22B_CHANNEL_WIDTH_40) ||
+		    (rs->rfe_option == 5 && col == R22B_CCUT_IDX_2R_5G))
+			reg830 = 0x79a0ea28;
+	}
+
+	r22b_write32_mask(sc, R22B_REG_CCASEL, R22B_MASKDWORD, reg82c);
+	r22b_write32_mask(sc, R22B_REG_PDMFTH, R22B_MASKDWORD, reg830);
+	r22b_write32_mask(sc, R22B_REG_CCA2ND, R22B_MASKDWORD, reg838);
+
+	if (is_efem_cca && rs->cut_version != R22B_CUT_B)
+		r22b_write32_mask(sc, R22B_REG_L1WT, R22B_MASKDWORD,
+		    0x9194b2b9);
+
+	if (bw == R22B_CHANNEL_WIDTH_20 && R22B_IS_CH_5G_BAND_MID(channel))
+		r22b_write32_mask(sc, R22B_REG_CCA2ND, 0xf0, 0x4);
+}
+
+/* rtw8822b_toggle_igi() */
+void
+r22b_toggle_igi(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t igi;
+
+	igi = r22b_read32_mask(sc, R22B_REG_RXIGI_A, 0x7f);
+	r22b_write32_mask(sc, R22B_REG_RXIGI_A, 0x7f, igi - 2);
+	r22b_write32_mask(sc, R22B_REG_RXIGI_A, 0x7f, igi);
+	r22b_write32_mask(sc, R22B_REG_RXIGI_B, 0x7f, igi - 2);
+	r22b_write32_mask(sc, R22B_REG_RXIGI_B, 0x7f, igi);
+
+	r22b_write32_mask(sc, R22B_REG_RXPSEL, R22B_MASKBYTE0, 0x0);
+	r22b_write32_mask(sc, R22B_REG_RXPSEL, R22B_MASKBYTE0,
+	    rs->antenna_rx | (rs->antenna_rx << 4));
+}
+
+/* rtw8822b_config_trx_mode() */
+void
+r22b_config_trx_mode(struct rtwn_softc *sc, uint8_t tx_path, uint8_t rx_path,
+    int is_tx2_path)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t rf_reg33;
+	uint8_t tx_path_sel, rx_path_sel;
+	int counter;
+
+	if (r22b_get_rfe_info(sc) == NULL) {
+		device_printf(sc->sc_dev, "%s: rfe_option %d is out of "
+		    "boundary\n", __func__, rs->rfe_option);
+		return;
+	}
+
+	if ((tx_path | rx_path) & R22B_BB_PATH_A)
+		r22b_write32_mask(sc, R22B_REG_AGCTR_A, R22B_MASKLWORD, 0x3231);
+	else
+		r22b_write32_mask(sc, R22B_REG_AGCTR_A, R22B_MASKLWORD, 0x1111);
+
+	if ((tx_path | rx_path) & R22B_BB_PATH_B)
+		r22b_write32_mask(sc, R22B_REG_AGCTR_B, R22B_MASKLWORD, 0x3231);
+	else
+		r22b_write32_mask(sc, R22B_REG_AGCTR_B, R22B_MASKLWORD, 0x1111);
+
+	r22b_write32_mask(sc, R22B_REG_CDDTXP, R22B_BIT(19) | R22B_BIT(18),
+	    0x3);
+	r22b_write32_mask(sc, R22B_REG_TXPSEL, R22B_BIT(29) | R22B_BIT(28),
+	    0x1);
+	r22b_write32_mask(sc, R22B_REG_TXPSEL, R22B_BIT(30), 0x1);
+
+	if (tx_path & R22B_BB_PATH_A) {
+		r22b_write32_mask(sc, R22B_REG_CDDTXP, 0xfff00000, 0x001);
+		r22b_write32_mask(sc, R22B_REG_ADCINI, 0xf0000000, 0x8);
+	} else if (tx_path & R22B_BB_PATH_B) {
+		r22b_write32_mask(sc, R22B_REG_CDDTXP, 0xfff00000, 0x002);
+		r22b_write32_mask(sc, R22B_REG_ADCINI, 0xf0000000, 0x4);
+	}
+
+	if (tx_path == R22B_BB_PATH_A || tx_path == R22B_BB_PATH_B)
+		r22b_write32_mask(sc, R22B_REG_TXPSEL1, 0xfff0, 0x01);
+	else
+		r22b_write32_mask(sc, R22B_REG_TXPSEL1, 0xfff0, 0x43);
+
+	tx_path_sel = (tx_path << 4) | tx_path;
+	r22b_write32_mask(sc, R22B_REG_TXPSEL, R22B_MASKBYTE0, tx_path_sel);
+
+	if (tx_path != R22B_BB_PATH_A && tx_path != R22B_BB_PATH_B) {
+		/* rtwdev->mp_mode is never set here. */
+		if (is_tx2_path) {
+			r22b_write32_mask(sc, R22B_REG_CDDTXP, 0xfff00000,
+			    0x043);
+			r22b_write32_mask(sc, R22B_REG_ADCINI, 0xf0000000,
+			    0xc);
+		}
+	}
+
+	r22b_write32_mask(sc, R22B_REG_RXDESC, R22B_BIT(22), 0x0);
+	r22b_write32_mask(sc, R22B_REG_RXDESC, R22B_BIT(18), 0x0);
+
+	if (rx_path & R22B_BB_PATH_A)
+		r22b_write32_mask(sc, R22B_REG_ADCINI, 0x0f000000, 0x0);
+	else if (rx_path & R22B_BB_PATH_B)
+		r22b_write32_mask(sc, R22B_REG_ADCINI, 0x0f000000, 0x5);
+
+	rx_path_sel = (rx_path << 4) | rx_path;
+	r22b_write32_mask(sc, R22B_REG_RXPSEL, R22B_MASKBYTE0, rx_path_sel);
+
+	if (rx_path == R22B_BB_PATH_A || rx_path == R22B_BB_PATH_B) {
+		r22b_write32_mask(sc, R22B_REG_ANTWT, R22B_BIT(16), 0x0);
+		r22b_write32_mask(sc, R22B_REG_HTSTFWT, R22B_BIT(28), 0x0);
+		r22b_write32_mask(sc, R22B_REG_MRC, R22B_BIT(23), 0x0);
+	} else {
+		r22b_write32_mask(sc, R22B_REG_ANTWT, R22B_BIT(16), 0x1);
+		r22b_write32_mask(sc, R22B_REG_HTSTFWT, R22B_BIT(28), 0x1);
+		r22b_write32_mask(sc, R22B_REG_MRC, R22B_BIT(23), 0x1);
+	}
+
+	for (counter = 100; counter > 0; counter--) {
+		r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_LUTWE, 0x80000);
+		r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_LUTWA, 0x00001);
+
+		rtwn_delay(sc, 2);
+		rf_reg33 = r22b_rf_read(sc, R22B_RF_PATH_A, 0x33);
+
+		if (rf_reg33 == 0x00001)
+			break;
+	}
+
+	if (counter <= 0) {
+		device_printf(sc->sc_dev, "%s: write RF mode table fail\n",
+		    __func__);
+		return;
+	}
+
+	r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_LUTWE, 0x80000);
+	r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_LUTWA, 0x00001);
+	r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_LUTWD1, 0x00034);
+	r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_LUTWD0, 0x4080c);
+	r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_LUTWE, 0x00000);
+	r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_LUTWE, 0x00000);
+
+	r22b_toggle_igi(sc);
+	r22b_set_channel_cca(sc, 1, R22B_CHANNEL_WIDTH_20);
+	r22b_set_channel_rfe(sc, rs->cur_chan);
+}
+
+/* rtw_phy_set_edcca_th() with rtw8822b_edcca_th[] */
+static void
+r22b_set_edcca_th(struct rtwn_softc *sc, uint8_t l2h, uint8_t h2l)
+{
+	r22b_write32_mask(sc, R22B_REG_EDCCA_TH, R22B_MASKBYTE0, l2h);
+	r22b_write32_mask(sc, R22B_REG_EDCCA_TH, R22B_MASKBYTE1, h2l);
+}
+
+/* rtw8822b_adaptivity_init() */
+static void
+r22b_adaptivity_init(struct rtwn_softc *sc)
+{
+	r22b_set_edcca_th(sc, R22B_EDCCA_MAX, R22B_EDCCA_MAX);
+
+	/* mac edcca state setting */
+	r22b_write32_clr(sc, R22B_REG_TX_PTCL_CTRL, R22B_BIT_DIS_EDCCA);
+	r22b_write32_set(sc, R22B_REG_RD_CTRL, R22B_BIT_EDCCA_MSK_CNTDOWN_EN);
+	r22b_write32_mask(sc, R22B_REG_EDCCA_SOURCE, R22B_BIT_SOURCE_OPTION,
+	    R22B_EDCCA_SRC_DEF);
+	r22b_write32_mask(sc, R22B_REG_EDCCA_POW_MA, R22B_BIT_MA_LEVEL, 0);
+
+	/* edcca decision opt */
+	r22b_write32_set(sc, R22B_REG_EDCCA_DECISION, R22B_BIT_EDCCA_OPTION);
+}
+
+/*
+ * rtw_phy_init(): only the register side.  The dynamic mechanisms that
+ * use this state (DIG, EDCCA adaptivity, CCK PD, CFO tracking) run from
+ * rtw88's watchdog and are not ported yet (see docs/rtl8822b-port.md).
+ */
+void
+r22b_phy_init(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	rs->igi_default = r22b_read32_mask(sc, R22B_REG_RXIGI_A, 0x7f);
+
+	/*
+	 * rtw_phy_adaptivity_init(): rtw88 picks the EDCCA mode from the
+	 * DFS region (ETSI/JP -> adaptivity); the register init is the
+	 * same for every mode.
+	 */
+	r22b_adaptivity_init(sc);
+}
+
+/* rtw_phy_dig_write() */
+void
+r22b_dig_write(struct rtwn_softc *sc, uint8_t igi)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	static const uint16_t dig_reg[R22B_RF_PATH_MAX] =
+	    { R22B_REG_RXIGI_A, R22B_REG_RXIGI_B };
+	int path;
+
+	for (path = 0; path < rs->rf_path_num; path++)
+		r22b_write32_mask(sc, dig_reg[path], 0x7f, igi);
+}
+
+/* rtw8822b_phy_rfe_init() */
+void
+r22b_phy_rfe_init(struct rtwn_softc *sc)
+{
+	/* chip top mux */
+	r22b_write32_mask(sc, 0x64, R22B_BIT(29) | R22B_BIT(28), 0x3);
+	r22b_write32_mask(sc, 0x4c, R22B_BIT(26) | R22B_BIT(25), 0x0);
+	r22b_write32_mask(sc, 0x40, R22B_BIT(2), 0x1);
+
+	/* from s0 or s1 */
+	r22b_write32_mask(sc, 0x1990, 0x3f, 0x30);
+	r22b_write32_mask(sc, 0x1990, R22B_BIT(11) | R22B_BIT(10), 0x3);
+
+	/* input or output */
+	r22b_write32_mask(sc, 0x974, 0x3f, 0x3f);
+	r22b_write32_mask(sc, 0x974, R22B_BIT(11) | R22B_BIT(10), 0x3);
+}
+
+#define R22B_TXSCALE_SIZE	37
+static const uint32_t r22b_txscale_tbl[R22B_TXSCALE_SIZE] = {
+	0x081, 0x088, 0x090, 0x099, 0x0a2, 0x0ac, 0x0b6, 0x0c0, 0x0cc, 0x0d8,
+	0x0e5, 0x0f2, 0x101, 0x110, 0x120, 0x131, 0x143, 0x156, 0x16a, 0x180,
+	0x197, 0x1af, 0x1c8, 0x1e3, 0x200, 0x21e, 0x23e, 0x261, 0x285, 0x2ab,
+	0x2d3, 0x2fe, 0x32b, 0x35c, 0x38e, 0x3c4, 0x3fe
+};
+
+/*
+ * rtw8822b_pwrtrack_init(): only records the default BB swing index.
+ * TODO (phase 2/3): thermal power tracking (rtw8822b_pwr_track(),
+ * rtw8822b_phy_pwrtrack(), rtw8822b_pwrtrack_set*()).
+ */
+void
+r22b_pwrtrack_init(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t swing;
+	int i;
+
+	swing = r22b_read32_mask(sc, R22B_REG_TXSCALE_A, 0xffe00000);
+	for (i = 0; i < R22B_TXSCALE_SIZE; i++) {
+		if (swing == r22b_txscale_tbl[i])
+			break;
+	}
+
+	if (i >= R22B_TXSCALE_SIZE)
+		rs->default_ofdm_index = 24;
+	else
+		rs->default_ofdm_index = i;
+}
+
+/* rtw8822b_phy_bf_init() / rtw_bf_phy_init() */
+void
+r22b_phy_bf_init(struct rtwn_softc *sc)
+{
+	const uint8_t retry_limit = 0xa;
+	const uint8_t ndpa_rate = 0x10;
+	const uint8_t ack_policy = 3;
+	uint32_t tmp32;
+	uint8_t tmp8;
+
+	tmp32 = rtwn_read_4(sc, R22B_REG_MU_TX_CTL);
+	/* Enable P1 aggr new packet according to P0 transfer time */
+	tmp32 |= R22B_BIT_MU_P1_WAIT_STATE_EN;
+	/* MU Retry Limit */
+	tmp32 &= ~R22B_BIT_MASK_R_MU_RL;
+	tmp32 |= (retry_limit << R22B_BIT_SHIFT_R_MU_RL) &
+	    R22B_BIT_MASK_R_MU_RL;
+	/* Disable Tx MU-MIMO until sounding done */
+	tmp32 &= ~R22B_BIT_EN_MU_MIMO;
+	/* Clear validity of MU STAs */
+	tmp32 &= ~R22B_BIT_MASK_R_MU_TABLE_VALID;
+	rtwn_write_4(sc, R22B_REG_MU_TX_CTL, tmp32);
+
+	/* MU-MIMO Option as default value */
+	tmp8 = ack_policy << R22B_BIT_SHIFT_WMAC_TXMU_ACKPOLICY;
+	tmp8 |= R22B_BIT_WMAC_TXMU_ACKPOLICY_EN;
+	rtwn_write_1(sc, R22B_REG_WMAC_MU_BF_OPTION, tmp8);
+
+	/* MU-MIMO Control as default value */
+	rtwn_write_2(sc, R22B_REG_WMAC_MU_BF_CTL, 0);
+	/* Set MU NDPA rate & BW source */
+	r22b_write32_set(sc, R22B_REG_TXBF_CTRL, R22B_BIT_USE_NDPA_PARAMETER);
+	/* Set NDPA Rate */
+	rtwn_write_1(sc, R22B_REG_NDPA_OPT_CTRL, ndpa_rate);
+
+	r22b_write32_mask(sc, R22B_REG_BBPSF_CTRL, R22B_BIT_MASK_CSI_RATE,
+	    0x04 /* DESC_RATE6M */);
+
+	/* Grouping bitmap parameters */
+	rtwn_write_4(sc, R22B_REG_GROUPING_BITMAP, 0xafffafff);
+}
+
+/*
+ * Thermal meter (rtw8822b_pwr_track(): trigger, then read RF 0x42).
+ */
+void
+r22b_temp_measure(struct rtwn_softc *sc)
+{
+	r22b_rf_write_mask(sc, R22B_RF_PATH_A, R22B_RF_T_METER,
+	    R22B_GENMASK(17, 16), 0x03);
+}
+
+uint8_t
+r22b_temp_read(struct rtwn_softc *sc)
+{
+	return (r22b_rf_read_mask(sc, R22B_RF_PATH_A, R22B_RF_T_METER,
+	    0xfc00));
+}
+
+/*
+ * TODO (phase 2/3): LC calibration.  rtw88 has no separate LCK for the
+ * 8822B; it is part of the firmware IQK and of power tracking
+ * (rtw_phy_pwrtrack_need_lck() is not used by rtw8822b.c).
+ */
+void
+r22b_lc_calib(struct rtwn_softc *sc)
+{
+	RTWN_DPRINTF(sc, RTWN_DEBUG_CALIB, "%s: not implemented\n",
+	    __func__);
+}
+
+/*
+ * TODO (phase 2): IQ calibration.  rtw88 (rtw8822b_do_iqk()) sends the
+ * H2C_PKT_IQK packet (clear = 0, segment_iqk = 0), polls RF_DTXLOK of
+ * path A until it reads 0xabcde (up to 300 x 20 ms), writes 0 back and
+ * reads REG_IQKFAILMSK.  It runs before the first transmission on a
+ * new channel (rtw_chip_prepare_tx(), i.e. before association) and from
+ * power tracking when the thermal delta exceeds iqk_threshold (8).
+ */
+void
+r22b_iq_calib(struct rtwn_softc *sc)
+{
+	RTWN_DPRINTF(sc, RTWN_DEBUG_CALIB, "%s: not implemented\n",
+	    __func__);
+}
