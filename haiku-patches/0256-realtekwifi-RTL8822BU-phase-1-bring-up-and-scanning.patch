+/*
+ * RTL8822B firmware download and host-to-card (H2C) commands.
+ *
+ * The 8822B has a 3081 (MIPS) CPU; its firmware is not written page by
+ * page through REG_MCUFW_CTRL like the 8051 chips rtwn supports.  Each
+ * firmware section is copied in up to 4 KiB chunks into the Tx packet
+ * buffer as a "reserved page" (a beacon-queue packet sent through the
+ * bulk-out pipe of the high priority queue), and the chip's DDMA engine
+ * then moves it from the Tx buffer into the CPU's DMEM/IMEM/EMEM,
+ * verifying a checksum.
+ *
+ * Sources (rtw88 v7.0): mac.c (__rtw_download_firmware,
+ * check_firmware_size, wlan_cpu_enable, download_firmware_reg_backup,
+ * download_firmware_reset_platform, send_firmware_pkt, iddma_enable,
+ * iddma_download_firmware, check_fw_checksum, download_firmware_to_mem,
+ * start_download_firmware, download_firmware_validate,
+ * download_firmware_end_flow), fw.c (rtw_fw_write_data_rsvd_page,
+ * rtw_fw_send_h2c_command, rtw_fw_send_h2c_packet,
+ * rtw_fw_send_general_info, rtw_fw_send_phydm_info), util.c
+ * (ltecoex_read_reg, ltecoex_reg_write, rtw_restore_reg),
+ * main.c (__update_firmware_info).
+ */
+
+#include <sys/cdefs.h>
+#include "opt_wlan.h"
+
+#include <sys/param.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/mbuf.h>
+#include <sys/kernel.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/taskqueue.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/linker.h>
