+const struct r22b_page_table r22b_page_table[5] = {
+	{64, 64, 64, 64, 1},
+	{64, 64, 64, 64, 1},
+	{64, 64, 0, 0, 1},
+	{64, 64, 64, 0, 1},
+	{64, 64, 64, 64, 1},
+};
+
+const struct r22b_rqpn r22b_rqpn_table[5] = {
+	{R22B_DMA_MAPPING_NORMAL, R22B_DMA_MAPPING_NORMAL,
+	 R22B_DMA_MAPPING_LOW, R22B_DMA_MAPPING_LOW,
+	 R22B_DMA_MAPPING_EXTRA, R22B_DMA_MAPPING_HIGH},
+	{R22B_DMA_MAPPING_NORMAL, R22B_DMA_MAPPING_NORMAL,
+	 R22B_DMA_MAPPING_LOW, R22B_DMA_MAPPING_LOW,
+	 R22B_DMA_MAPPING_EXTRA, R22B_DMA_MAPPING_HIGH},
+	{R22B_DMA_MAPPING_NORMAL, R22B_DMA_MAPPING_NORMAL,
+	 R22B_DMA_MAPPING_NORMAL, R22B_DMA_MAPPING_HIGH,
+	 R22B_DMA_MAPPING_HIGH, R22B_DMA_MAPPING_HIGH},
+	{R22B_DMA_MAPPING_NORMAL, R22B_DMA_MAPPING_NORMAL,
+	 R22B_DMA_MAPPING_LOW, R22B_DMA_MAPPING_LOW,
+	 R22B_DMA_MAPPING_HIGH, R22B_DMA_MAPPING_HIGH},
+	{R22B_DMA_MAPPING_NORMAL, R22B_DMA_MAPPING_NORMAL,
+	 R22B_DMA_MAPPING_LOW, R22B_DMA_MAPPING_LOW,
+	 R22B_DMA_MAPPING_EXTRA, R22B_DMA_MAPPING_HIGH},
+};
