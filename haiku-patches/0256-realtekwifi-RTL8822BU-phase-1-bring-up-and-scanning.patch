+#ifndef R22B_TABLE_H
+#define R22B_TABLE_H
+
+/*
+ * Table descriptor; replaces rtw88's struct rtw_table (main.h).  Instead of
+ * parse/do_cfg function pointers it carries the kind of table, which
+ * r22b_load_table() dispatches on.
+ */
+struct r22b_table {
+	const void	*data;
+	uint32_t	size;		/* number of array elements (rtw88) */
+	uint8_t		cfg;		/* R22B_TABLE_* */
+	uint8_t		rf_path;	/* R22B_TABLE_CFG_RF only */
+};
+
+/* Values for r22b_table.cfg. */
+#define R22B_TABLE_CFG_MAC	0	/* rtw_phy_cfg_mac: 8-bit writes */
+#define R22B_TABLE_CFG_BB	1	/* rtw_phy_cfg_bb: 32-bit + delays */
+#define R22B_TABLE_CFG_AGC	2	/* rtw_phy_cfg_agc: 32-bit writes */
+#define R22B_TABLE_CFG_RF	3	/* rtw_phy_cfg_rf: RF writes + delays */
+#define R22B_TABLE_BB_PG	4	/* tx power by rate (rtw_parse_tbl_bb_pg) */
+#define R22B_TABLE_TXPWR_LMT	5	/* tx power limit (rtw_parse_tbl_txpwr_lmt) */
+
+#define R22B_RF_PATH_A		0
+#define R22B_RF_PATH_B		1
+
+/* rtw88 phy.h: struct rtw_phy_pg_cfg_pair. */
+struct r22b_phy_pg_cfg_pair {
+	uint32_t	band;
+	uint32_t	rf_path;
+	uint32_t	tx_num;
+	uint32_t	addr;
+	uint32_t	bitmask;
+	uint32_t	data;
+};
+
+/* rtw88 phy.h: struct rtw_txpwr_lmt_cfg_pair. */
+struct r22b_txpwr_lmt_cfg_pair {
+	uint8_t		regd;
+	uint8_t		band;
+	uint8_t		bw;
+	uint8_t		rs;
+	uint8_t		ch;
+	int8_t		txpwr_lmt;
+};
+
+/* rtw88 rtw8822b_table.h */
+extern const struct r22b_table rtw8822b_mac_tbl;
+extern const struct r22b_table rtw8822b_agc_tbl;
+extern const struct r22b_table rtw8822b_bb_tbl;
+extern const struct r22b_table rtw8822b_bb_pg_type2_tbl;
+extern const struct r22b_table rtw8822b_bb_pg_type3_tbl;
+extern const struct r22b_table rtw8822b_bb_pg_type5_tbl;
+extern const struct r22b_table rtw8822b_rf_a_tbl;
+extern const struct r22b_table rtw8822b_rf_b_tbl;
+extern const struct r22b_table rtw8822b_txpwr_lmt_type0_tbl;
+extern const struct r22b_table rtw8822b_txpwr_lmt_type2_tbl;
+extern const struct r22b_table rtw8822b_txpwr_lmt_type5_tbl;
+
+#endif	/* R22B_TABLE_H */
