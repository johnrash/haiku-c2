+/*
+ * rtw_get_channel_params() + rtw_update_channel(): center channel,
+ * bandwidth and primary 20 MHz sub-channel index of a net80211 channel.
+ */
+static void
+r22b_update_channel(struct rtwn_softc *sc, struct ieee80211_channel *c)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t primary, center, bw, idx;
+
+	primary = c->ic_ieee;
+	if (IEEE80211_IS_CHAN_VHT80(c)) {
+		bw = R22B_CHANNEL_WIDTH_80;
+		center = c->ic_vht_ch_freq1;
+	} else if (IEEE80211_IS_CHAN_HT40(c)) {
+		bw = R22B_CHANNEL_WIDTH_40;
+		center = rtwn_chan2centieee(c);
+	} else {
+		bw = R22B_CHANNEL_WIDTH_20;
+		center = primary;
+	}
+
+	/* assign the center channel used while 20M bw is selected */
+	rs->cch_by_bw[R22B_CHANNEL_WIDTH_20] = primary;
+
+	/* assign the center channel used while current bw is selected */
+	rs->cch_by_bw[bw] = center;
+
+	switch (bw) {
+	case R22B_CHANNEL_WIDTH_20:
+	default:
+		idx = R22B_SC_DONT_CARE;
+		break;
+	case R22B_CHANNEL_WIDTH_40:
+		if (primary > center)
+			idx = R22B_SC_20_UPPER;
+		else
+			idx = R22B_SC_20_LOWER;
+		break;
+	case R22B_CHANNEL_WIDTH_80:
+		/* 10 MHz = 2 channel numbers */
+		if (primary > center) {
+			if (primary - center == 2)
+				idx = R22B_SC_20_UPPER;
+			else
+				idx = R22B_SC_20_UPMOST;
+
+			/* the center channel used while 40M bw is selected */
+			rs->cch_by_bw[R22B_CHANNEL_WIDTH_40] = center + 4;
+		} else {
+			if (center - primary == 2)
+				idx = R22B_SC_20_LOWER;
+			else
+				idx = R22B_SC_20_LOWEST;
+
+			/* the center channel used while 40M bw is selected */
+			rs->cch_by_bw[R22B_CHANNEL_WIDTH_40] = center - 4;
+		}
+		break;
+	}
+
+	rs->cur_pri_idx = idx;
+	rs->cur_bw = bw;
+	rs->cur_pri_chan = primary;
+	rs->cur_chan = center;
+}
+
+/* rtw_set_channel() -> rtw8822b_set_channel() */
+void
+r22b_set_chan(struct rtwn_softc *sc, struct ieee80211_channel *c)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t channel, bw, pri_idx;
+
+	r22b_update_channel(sc, c);
+	channel = rs->cur_chan;
+	bw = rs->cur_bw;
+	pri_idx = rs->cur_pri_idx;
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_STATE, "%s: primary %u, center %u, "
+	    "bw %u, sc %u\n", __func__, rs->cur_pri_chan, channel, bw,
+	    pri_idx);
+
+	if (!R22B_IS_CH_2G_BAND(channel) && !R22B_IS_CH_5G_BAND(channel)) {
+		device_printf(sc->sc_dev, "%s: invalid channel %u\n", __func__,
+		    channel);
+		return;
+	}
+
+	r22b_set_channel_bb(sc, channel, bw, pri_idx);
+	r22b_set_channel_mac(sc, channel, bw, pri_idx);
+	r22b_set_channel_rf(sc, channel, bw);
+	r22b_set_channel_rxdfir(sc, bw);
+	r22b_toggle_igi(sc);
+	r22b_set_channel_cca(sc, channel, bw);
+	r22b_set_channel_rfe(sc, channel);
+
+	/* rtw_coex_switchband_notify(): nothing to do (stop_dm). */
+
+	r22b_set_tx_power_level(sc);
+
+	/*
+	 * TODO (phase 2): rtw88 sets need_rfk here and runs the firmware
+	 * IQK (r22b_iq_calib()) before the first transmission on a channel
+	 * outside a scan (rtw_chip_prepare_tx() from mgd_prepare_tx).
+	 */
+}
+
+/*
+ * net80211 scan hooks wrapped around rtwn_scan_start() / rtwn_scan_end():
+ * rtw_core_scan_start() lowers the initial gain for maximum coverage and
+ * rtw_core_scan_complete() restores it.
+ */
+void
+r22b_scan_start(struct ieee80211com *ic)
+{
+	struct rtwn_softc *sc = ic->ic_softc;
+	struct r22b_softc *rs = sc->sc_priv;
+
+	rs->rs_scan_start(ic);
+
+	RTWN_LOCK(sc);
+	if (sc->sc_flags & RTWN_RUNNING)
+		r22b_dig_write(sc, R22B_DIG_CVRG_MIN);
+	RTWN_UNLOCK(sc);
+}
+
+void
+r22b_scan_end(struct ieee80211com *ic)
+{
+	struct rtwn_softc *sc = ic->ic_softc;
+	struct r22b_softc *rs = sc->sc_priv;
+
+	RTWN_LOCK(sc);
+	/* rtw_phy_dig_reset() */
+	if (sc->sc_flags & RTWN_RUNNING)
+		r22b_dig_write(sc, rs->igi_default);
+	RTWN_UNLOCK(sc);
+
+	rs->rs_scan_end(ic);
+}
diff --git a/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_coex.c b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_coex.c
new file mode 100644
index 0000000000..540ee86dc4
--- /dev/null
+++ b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_coex.c
@@ -0,0 +1,557 @@
+/*-
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright(c) 2018-2019  Realtek Corporation
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ *
+ * Derived from Linux's rtw88 driver (v7.0), used under its BSD-3-Clause option;
+ * see LICENSE.rtw88 in this directory.
+ */
+
+/*
+ * Wi-Fi/Bluetooth coexistence, reduced to what rtw88 does on a device
+ * without Bluetooth (RTL8812BU): rtw_coex_power_on_setting() and
+ * rtw_coex_init_hw_config(wifi_only = true).  These set the antenna
+ * switch, the RFE buffer mux, the WL/BT grant signals (GNT_WL forced
+ * high, GNT_BT forced low) and the PTA defaults.  Afterwards rtw88 sets
+ * coex->stop_dm, so none of its run-time coexistence code runs on such
+ * a device.
+ *
+ * Left out: everything that only matters with an active BT core (the
+ * coex state machine, BT info/C2H handling, TDMA/table switching on
+ * scan/connect/band change, LPS interaction, BT rx gain and tx power
+ * control, the other antenna switch control types).  A chip whose efuse
+ * reports BT coexistence (efuse->btcoex) gets the same wifi-only setup
+ * with a warning.
+ *
+ * Sources (rtw88 v7.0): coex.c (rtw_coex_power_on_setting,
+ * __rtw_coex_init_hw_config, rtw_coex_init_coex_var,
+ * rtw_coex_monitor_bt_enable, rtw_coex_write_scbd, rtw_coex_read_scbd,
+ * rtw_coex_write_indirect_reg, rtw_coex_coex_ctrl_owner,
+ * rtw_coex_set_gnt_bt, rtw_coex_set_gnt_wl, rtw_coex_set_ant_path,
+ * rtw_coex_set_wl_pri_mask, rtw_coex_table, rtw_coex_set_table,
+ * rtw_coex_tdma, rtw_coex_set_tdma, rtw_coex_wl_slot_extend,
+ * rtw_coex_query_bt_info, rtw_coex_power_off_setting), rtw8822b.c
+ * (rtw8822b_coex_cfg_init, rtw8822b_coex_cfg_ant_switch,
+ * rtw8822b_coex_cfg_gnt_debug, rtw8822b_coex_cfg_rfe_type, table_sant),
+ * fw.c (rtw_fw_coex_tdma_type, rtw_fw_bt_wifi_control,
+ * rtw_fw_query_bt_info).
+ */
+
+#include <sys/cdefs.h>
+#include "opt_wlan.h"
+
+#include <sys/param.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/mbuf.h>
+#include <sys/kernel.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/taskqueue.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/linker.h>
+
+#include <net/if.h>
+#include <net/ethernet.h>
+#include <net/if_media.h>
+
+#include <net80211/ieee80211_var.h>
+#include <net80211/ieee80211_radiotap.h>
+
+#include <dev/rtwn/if_rtwnreg.h>
+#include <dev/rtwn/if_rtwnvar.h>
+
+#include <dev/rtwn/if_rtwn_debug.h>
+
+#include <dev/rtwn/rtl8822b/r22b.h>
+#include <dev/rtwn/rtl8822b/r22b_fw_cmd.h>
+#include <dev/rtwn/rtl8822b/r22b_priv.h>
+#include <dev/rtwn/rtl8822b/r22b_reg.h>
+#include <dev/rtwn/rtl8822b/r22b_var.h>
+
+/* rtw88 coex.h */
+#define COEX_SCBD_ACTIVE	R22B_BIT(0)
+#define COEX_SCBD_ONOFF		R22B_BIT(1)
+#define COEX_SCBD_EXTFEM	R22B_BIT(8)
+#define COEX_SCBD_TDMA		R22B_BIT(9)
+#define COEX_SCBD_FIX2M		R22B_BIT(10)
+
+#define COEX_GNT_SET_HW_PTA	0x0
+#define COEX_GNT_SET_SW_LOW	0x1
+#define COEX_GNT_SET_SW_HIGH	0x3
+
+#define COEX_SET_ANT_WONLY	1
+#define COEX_SET_ANT_POWERON	5
+
+#define COEX_SWITCH_TO_BT	0
+#define COEX_SWITCH_TO_WLG	1
+#define COEX_SWITCH_TO_WLG_BT	4
+
+#define COEX_SWITCH_CTRL_BY_BBSW 0
+
+#define COEX_WLPRI_TX_RSP	3
+#define COEX_WLPRI_TX_BEACON	4
+#define COEX_WLPRI_TX_BEACONQ	27
+
+/* rtw8822b.c table_sant_8822b[1] ("case-1") */
+#define COEX_TABLE_SANT_1_BT	0x55555555
+#define COEX_TABLE_SANT_1_WL	0x55555555
+#define DEF_BRK_TABLE_VAL	0xf0ffffff
+
+/* rtw_coex_read_scbd() */
+static uint16_t
+r22b_coex_read_scbd(struct rtwn_softc *sc)
+{
+	return (rtwn_read_2(sc, R22B_REG_WIFI_BT_INFO) & ~R22B_BIT_BT_INT_EN);
+}
+
+/* rtw_coex_write_scbd() (chip->scbd_support, !chip->new_scbd10_def) */
+static void
+r22b_coex_write_scbd(struct rtwn_softc *sc, uint16_t bitpos, int set)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint16_t val = 0x2;
+
+	val |= rs->coex_score_board;
+
+	/* for 8822b, scbd[10] is CQDDR on */
+	if (bitpos & COEX_SCBD_FIX2M) {
+		if (set)
+			val &= ~COEX_SCBD_FIX2M;
+		else
+			val |= COEX_SCBD_FIX2M;
+	} else {
+		if (set)
+			val |= bitpos;
+		else
+			val &= ~bitpos;
+	}
+
+	if (val != rs->coex_score_board) {
+		rs->coex_score_board = val;
+		val |= R22B_BIT_BT_INT_EN;
+		rtwn_write_2(sc, R22B_REG_WIFI_BT_INFO, val);
+	}
+}
+
+/* rtw_coex_monitor_bt_enable() (scoreboard variant) */
+static void
+r22b_coex_monitor_bt_enable(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	int bt_disabled;
+
+	bt_disabled = !(r22b_coex_read_scbd(sc) & COEX_SCBD_ONOFF);
+	if (rs->coex_bt_disabled != bt_disabled) {
+		RTWN_DPRINTF(sc, RTWN_DEBUG_RESET,
+		    "%s: BT state changed (%d) -> (%d)\n", __func__,
+		    rs->coex_bt_disabled, bt_disabled);
+		rs->coex_bt_disabled = bt_disabled;
+	}
+}
+
+/* rtw_coex_write_indirect_reg() */
+static void
+r22b_coex_write_indirect_reg(struct rtwn_softc *sc, uint16_t addr,
+    uint32_t mask, uint32_t val)
+{
+	uint32_t tmp;
+
+	if (r22b_ltecoex_read(sc, addr, &tmp) != 0) {
+		device_printf(sc->sc_dev,
+		    "failed to read indirect register 0x%x\n", addr);
+		tmp = 0;	/* rtw_coex_read_indirect_reg() returns 0 */
+	}
+	tmp = (tmp & ~mask) | ((val << r22b_mask_shift(mask)) & mask);
+
+	if (r22b_ltecoex_write(sc, addr, tmp) != 0) {
+		device_printf(sc->sc_dev,
+		    "failed to write indirect register 0x%x\n", addr);
+	}
+}
+
+/* coex_rfe->ant_switch_exist (rtw8822b_coex_cfg_rfe_type()) */
+static int
+r22b_coex_ant_switch_exist(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	return (rs->rfe_option != 0x12 && rs->rfe_option != 0x15 &&
+	    rs->rfe_option != 0x16);
+}
+
+/* rtw8822b_coex_cfg_rfe_type() */
+static void
+r22b_coex_cfg_rfe_type(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	/* ant_switch_polarity = 0, ant_switch_diversity = false */
+	if (rs->rfe_option == 2 || rs->rfe_option == 4)
+		r22b_coex_write_scbd(sc, COEX_SCBD_EXTFEM, 1);
+	else
+		r22b_coex_write_scbd(sc, COEX_SCBD_EXTFEM, 0);
+
+	/* wlg_at_btg = false; ant_switch_with_bt is only used with BT. */
+
+	/* Ext switch buffer mux */
+	rtwn_write_1(sc, R22B_REG_RFE_CTRL_E, 0xff);
+	r22b_write8_mask(sc, R22B_REG_RFESEL_CTRL + 1, 0x3, 0x0);
+	r22b_write8_mask(sc, R22B_REG_RFE_INV16, R22B_BIT_RFE_BUF_EN, 0x0);
+
+	/* Disable LTE Coex Function in WiFi side */
+	r22b_coex_write_indirect_reg(sc, R22B_LTE_COEX_CTRL,
+	    R22B_BIT_LTE_COEX_EN, 0);
+
+	/* BTC_CTT_WL_VS_LTE */
+	r22b_coex_write_indirect_reg(sc, R22B_LTE_WL_TRX_CTRL,
+	    R22B_MASKLWORD, 0xffff);
+
+	/* BTC_CTT_BT_VS_LTE */
+	r22b_coex_write_indirect_reg(sc, R22B_LTE_BT_TRX_CTRL,
+	    R22B_MASKLWORD, 0xffff);
+}
+
+/* rtw8822b_coex_cfg_ant_switch(), COEX_SWITCH_CTRL_BY_BBSW only */
+static void
+r22b_coex_cfg_ant_switch(struct rtwn_softc *sc, uint8_t ctrl_type,
+    uint8_t pos_type)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t regval;
+
+	if (((ctrl_type << 8) + pos_type) == rs->coex_cur_switch_status)
+		return;
+
+	rs->coex_cur_switch_status = (ctrl_type << 8) + pos_type;
+
+	KASSERT(ctrl_type == COEX_SWITCH_CTRL_BY_BBSW,
+	    ("%s: unsupported ctrl type %u\n", __func__, ctrl_type));
+
+	/* 0x4c[23] = 0 */
+	r22b_write8_mask(sc, R22B_REG_LED_CFG + 2, R22B_BIT_DPDT_SEL_EN >> 16,
+	    0x0);
+	/* 0x4c[24] = 1 */
+	r22b_write8_mask(sc, R22B_REG_LED_CFG + 3, R22B_BIT_DPDT_WL_SEL >> 24,
+	    0x1);
+	/* BB SW, DPDT use RFE_ctrl8 and RFE_ctrl9 as ctrl pin */
+	r22b_write8_mask(sc, R22B_REG_RFE_CTRL8, R22B_BIT_MASK_RFE_SEL89, 0x77);
+
+	/* polarity_inverse is false */
+	if (pos_type == COEX_SWITCH_TO_WLG_BT) {
+		if (rs->rfe_option != 0x4 && rs->rfe_option != 0x2)
+			regval = 0x3;
+		else
+			regval = 0x2;
+	} else if (pos_type == COEX_SWITCH_TO_WLG)
+		regval = 0x2;
+	else
+		regval = 0x1;
+
+	r22b_write8_mask(sc, R22B_REG_RFE_INV8, R22B_BIT_MASK_RFE_INV89, regval);
+}
+
+/* rtw_coex_coex_ctrl_owner() (the 8822B has no btg_reg) */
+static void
+r22b_coex_ctrl_owner(struct rtwn_softc *sc, int wifi_control)
+{
+	if (wifi_control) {
+		r22b_write8_set(sc, R22B_REG_SYS_SDIO_CTRL + 3,
+		    R22B_BIT_LTE_MUX_CTRL_PATH >> 24);
+	} else {
+		r22b_write8_clr(sc, R22B_REG_SYS_SDIO_CTRL + 3,
+		    R22B_BIT_LTE_MUX_CTRL_PATH >> 24);
+	}
+}
+
+/* rtw_coex_set_gnt_bt() */
+static void
+r22b_coex_set_gnt_bt(struct rtwn_softc *sc, uint8_t state)
+{
+	r22b_coex_write_indirect_reg(sc, R22B_LTE_COEX_CTRL, 0xc000, state);
+	r22b_coex_write_indirect_reg(sc, R22B_LTE_COEX_CTRL, 0x0c00, state);
+}
+
+/* rtw_coex_set_gnt_wl() */
+static void
+r22b_coex_set_gnt_wl(struct rtwn_softc *sc, uint8_t state)
+{
+	r22b_coex_write_indirect_reg(sc, R22B_LTE_COEX_CTRL, 0x3000, state);
+	r22b_coex_write_indirect_reg(sc, R22B_LTE_COEX_CTRL, 0x0300, state);
+}
+
+/* rtw_coex_set_ant_path(), COEX_SET_ANT_POWERON and _WONLY only */
+static void
+r22b_coex_set_ant_path(struct rtwn_softc *sc, int force, uint8_t phase)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t ctrl_type, pos_type;
+
+	if (!force && rs->coex_cur_ant_pos_type == phase)
+		return;
+
+	rs->coex_cur_ant_pos_type = phase;
+
+	/* rtw_coex_check_rfk(): nothing to wait for without wlg_at_btg. */
+
+	switch (phase) {
+	case COEX_SET_ANT_POWERON:
+		/* set path control owner to BT at power-on */
+		if (rs->coex_bt_disabled)
+			r22b_coex_ctrl_owner(sc, 1);
+		else
+			r22b_coex_ctrl_owner(sc, 0);
+
+		ctrl_type = COEX_SWITCH_CTRL_BY_BBSW;
+		pos_type = COEX_SWITCH_TO_BT;
+		break;
+	case COEX_SET_ANT_WONLY:
+		/* set GNT_BT to SW Low */
+		r22b_coex_set_gnt_bt(sc, COEX_GNT_SET_SW_LOW);
+
+		/* set GNT_WL to SW high */
+		r22b_coex_set_gnt_wl(sc, COEX_GNT_SET_SW_HIGH);
+
+		/* set path control owner to wl at initial step */
+		r22b_coex_ctrl_owner(sc, 1);
+
+		ctrl_type = COEX_SWITCH_CTRL_BY_BBSW;
+		pos_type = COEX_SWITCH_TO_WLG;
+		break;
+	default:
+		KASSERT(0, ("%s: unsupported phase %u\n", __func__, phase));
+		return;
+	}
+
+	if (r22b_coex_ant_switch_exist(sc))
+		r22b_coex_cfg_ant_switch(sc, ctrl_type, pos_type);
+}
+
+/* rtw_coex_table() / rtw_coex_set_table(), forced, case 1. */
+static void
+r22b_coex_table_case1(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	/*
+	 * With a non-shared antenna rtw88 looks up table_nsant[1 - 100],
+	 * which is out of range, and writes nothing.
+	 */
+	if (!rs->share_ant)
+		return;
+
+	rtwn_write_4(sc, R22B_REG_BT_COEX_TABLE0, COEX_TABLE_SANT_1_BT);
+	rtwn_write_4(sc, R22B_REG_BT_COEX_TABLE1, COEX_TABLE_SANT_1_WL);
+	rtwn_write_4(sc, R22B_REG_BT_COEX_BRK_TABLE, DEF_BRK_TABLE_VAL);
+}
+
+/* rtw_fw_bt_wifi_control() */
+static void
+r22b_fw_bt_wifi_control(struct rtwn_softc *sc, uint8_t op_code,
+    const uint8_t *data)
+{
+	uint8_t h2c[8] = { 0 };
+
+	h2c[0] = R22B_H2C_CMD_BT_WIFI_CONTROL;
+	h2c[1] = op_code;
+	h2c[2] = data[0];
+	h2c[3] = data[1];
+	h2c[4] = data[2];
+	h2c[5] = data[3];
+	h2c[6] = data[4];
+
+	(void)r22b_fw_cmd(sc, h2c);
+}
+
+/* rtw_coex_wl_slot_extend() */
+static void
+r22b_coex_wl_slot_extend(struct rtwn_softc *sc, int enable)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t para[6] = { 0 };
+
+	para[0] = R22B_COEX_H2C69_WL_LEAKAP;
+	para[1] = enable ? 0x0 /* PARA1_H2C69_EN_5MS */ :
+	    R22B_PARA1_H2C69_DIS_5MS;
+
+	rs->coex_wl_slot_extend = !!enable;
+	r22b_fw_bt_wifi_control(sc, para[0], &para[1]);
+}
+
+/*
+ * rtw_coex_tdma(force, 0): TDMA off.  The TDMA timer base H2C is skipped
+ * by rtw88 too (it equals the initial value), and with a non-shared
+ * antenna rtw88 looks up tdma_nsant[0 - 100], which is out of range.
+ */
+static void
+r22b_coex_tdma_off(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t h2c[8] = { 0 };
+
+	/* !wl_busy */
+	r22b_coex_write_scbd(sc, COEX_SCBD_TDMA, 0);
+
+	if (!rs->share_ant)
+		return;
+
+	/* rtw_coex_set_tdma(0, 0, 0, 0, 0) -> rtw_fw_coex_tdma_type() */
+	h2c[0] = R22B_H2C_CMD_COEX_TDMA_TYPE;
+	(void)r22b_fw_cmd(sc, h2c);
+}
+
+/* rtw_coex_query_bt_info() */
+static void
+r22b_coex_query_bt_info(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t h2c[8] = { 0 };
+
+	if (rs->coex_bt_disabled)
+		return;
+
+	/* The reply (C2H_BT_INFO) is ignored by r22b_handle_c2h_report(). */
+	h2c[0] = R22B_H2C_CMD_QUERY_BT_INFO;
+	h2c[1] = 0x01;	/* SET_QUERY_BT_INFO: dword 0 BIT(8) */
+	(void)r22b_fw_cmd(sc, h2c);
+}
+
+/* rtw_coex_set_wl_pri_mask() */
+static void
+r22b_coex_set_wl_pri_mask(struct rtwn_softc *sc, uint8_t bitmap,
+    uint8_t data)
+{
+	uint16_t addr;
+
+	addr = R22B_REG_BT_COEX_TABLE_H + (bitmap / 8);
+	bitmap = bitmap % 8;
+
+	r22b_write8_mask(sc, addr, R22B_BIT(bitmap), data);
+}
+
+/* rtw8822b_coex_cfg_init() */
+static void
+r22b_coex_cfg_init(struct rtwn_softc *sc)
+{
+	/* enable TBTT nterrupt */
+	r22b_write8_set(sc, R22B_REG_BCN_CTRL, R22B_BIT_EN_BCN_FUNCTION);
+
+	/* BT report packet sample rate */
+	/* 0x790[5:0]=0x5 */
+	r22b_write8_mask(sc, R22B_REG_BT_TDMA_TIME, R22B_BIT_MASK_SAMPLE_RATE,
+	    0x5);
+
+	/* enable BT counter statistics */
+	rtwn_write_1(sc, R22B_REG_BT_STAT_CTRL, 0x1);
+
+	/* enable PTA (3-wire function form BT side) */
+	r22b_write32_set(sc, R22B_REG_GPIO_MUXCFG, R22B_BIT_BT_PTA_EN);
+	r22b_write32_set(sc, R22B_REG_GPIO_MUXCFG, R22B_BIT_PO_BT_PTA_PINS);
+
+	/* enable PTA (tx/rx signal form WiFi side) */
+	r22b_write8_set(sc, R22B_REG_QUEUE_CTRL, R22B_BIT_PTA_WL_TX_EN);
+	/* wl tx signal to PTA not case EDCCA */
+	r22b_write8_clr(sc, R22B_REG_QUEUE_CTRL, R22B_BIT_PTA_EDCCA_EN);
+	/* GNT_BT=1 while select both */
+	r22b_write16_set(sc, R22B_REG_BT_COEX_V2, R22B_BIT_GNT_BT_POLARITY);
+}
+
+/* rtw8822b_coex_cfg_gnt_debug() */
+static void
+r22b_coex_cfg_gnt_debug(struct rtwn_softc *sc)
+{
+	r22b_write8_mask(sc, R22B_REG_PAD_CTRL1 + 2,
+	    R22B_BIT_BTGP_SPI_EN >> 16, 0);
+	r22b_write8_mask(sc, R22B_REG_PAD_CTRL1 + 3,
+	    R22B_BIT_BTGP_JTAG_EN >> 24, 0);
+	r22b_write8_mask(sc, R22B_REG_GPIO_MUXCFG + 2,
+	    R22B_BIT_FSPI_EN >> 16, 0);
+	r22b_write8_mask(sc, R22B_REG_PAD_CTRL1 + 1,
+	    R22B_BIT_LED1DIS >> 8, 0);
+	r22b_write8_mask(sc, R22B_REG_SYS_SDIO_CTRL + 3,
+	    R22B_BIT_DBG_GNT_WL_BT >> 24, 0);
+}
+
+/* rtw_coex_power_on_setting() */
+void
+r22b_coex_power_on_setting(struct rtwn_softc *sc)
+{
+	/* coex->stop_dm = true; coex->wl_rf_off = false */
+
+	/* enable BB, we can write 0x948 */
+	r22b_write8_set(sc, R22B_REG_SYS_FUNC_EN,
+	    R22B_BIT_FEN_BB_GLB_RST | R22B_BIT_FEN_BB_RSTB);
+
+	r22b_coex_monitor_bt_enable(sc);
+	r22b_coex_cfg_rfe_type(sc);
+
+	/* set antenna path to BT */
+	r22b_coex_set_ant_path(sc, 1, COEX_SET_ANT_POWERON);
+
+	r22b_coex_table_case1(sc);
+	/* red x issue */
+	rtwn_write_1(sc, R22B_REG_USB_RED_X, 0x0);
+	r22b_coex_cfg_gnt_debug(sc);
+}
+
+/* rtw_coex_init_hw_config() / __rtw_coex_init_hw_config() */
+void
+r22b_coex_init_hw_config(struct rtwn_softc *sc, int wifi_only)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	/* rtw_coex_init_coex_var(): coex_dm and coex_stat are cleared. */
+	rs->coex_score_board = 0;
+	rs->coex_cur_switch_status = 0;
+	rs->coex_cur_ant_pos_type = 0;
+	rs->coex_bt_disabled = 0;
+	rs->coex_wl_slot_extend = 0;
+
+	/* (coex_stat->kt_ver is read from 0xf1 for debugging only.) */
+
+	r22b_coex_monitor_bt_enable(sc);
+	r22b_coex_wl_slot_extend(sc, rs->coex_wl_slot_extend);
+
+	r22b_write8_set(sc, R22B_REG_BCN_CTRL, R22B_BIT_EN_BCN_FUNCTION);
+
+	r22b_coex_cfg_rfe_type(sc);
+	r22b_coex_cfg_init(sc);
+
+	/* set Tx response = Hi-Pri (ex: Transmitting ACK,BA,CTS) */
+	r22b_coex_set_wl_pri_mask(sc, COEX_WLPRI_TX_RSP, 1);
+
+	/* set Tx beacon = Hi-Pri */
+	r22b_coex_set_wl_pri_mask(sc, COEX_WLPRI_TX_BEACON, 1);
+
+	/* set Tx beacon queue = Hi-Pri */
+	r22b_coex_set_wl_pri_mask(sc, COEX_WLPRI_TX_BEACONQ, 1);
+
+	/* antenna config */
+	if (!wifi_only) {
+		/*
+		 * TODO: chips with a BT core need rtw88's full coexistence
+		 * code (COEX_SET_ANT_INIT and the run-time state machine).
+		 */
+		device_printf(sc->sc_dev, "efuse reports BT coexistence; "
+		    "only the Wi-Fi-only antenna setup is supported\n");
+	}
+	r22b_coex_set_ant_path(sc, 1, COEX_SET_ANT_WONLY);
+	r22b_coex_write_scbd(sc, COEX_SCBD_ACTIVE | COEX_SCBD_ONOFF, 1);
+	/* coex->stop_dm = true */
+
+	/* PTA parameter */
+	r22b_coex_table_case1(sc);
+	r22b_coex_tdma_off(sc);
+	r22b_coex_query_bt_info(sc);
+}
+
+/* rtw_coex_power_off_setting() */
+void
+r22b_coex_power_off_setting(struct rtwn_softc *sc)
+{
+	rtwn_write_2(sc, R22B_REG_WIFI_BT_INFO, R22B_BIT_BT_INT_EN);
+}
