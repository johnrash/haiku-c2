+#define R22B_EFUSE_RF_BT_SETTING	0xc3
+#define R22B_EFUSE_EEPROM_VERSION	0xc4
+#define R22B_EFUSE_EEPROM_CUSTOMER_ID	0xc5
+#define R22B_EFUSE_RF_ANTENNA_OPTION	0xc9
+#define R22B_EFUSE_RFE_OPTION		0xca
+#define R22B_EFUSE_COUNTRY_CODE		0xcb	/* [2] */
+/* struct rtw8822bu_efuse, at 0xd0 */
+#define R22B_EFUSE_U_VID		0x100
+#define R22B_EFUSE_U_PID		0x102
+#define R22B_EFUSE_U_MAC_ADDR		0x107
+
+/*
+ * Offsets inside one struct rtw_txpwr_idx (42 bytes, packed; the s8:4
+ * bit-fields are allocated from the least significant bit of each byte
+ * by GCC on little-endian targets).
+ */
+#define TXPWR_2G_CCK_BASE		0	/* [6] */
+#define TXPWR_2G_BW40_BASE		6	/* [5] */
+#define TXPWR_2G_HT_1S_DIFF		11	/* ofdm:4 (lo), bw20:4 (hi) */
+#define TXPWR_2G_HT_2S_DIFF		12	/* bw20 (lo), bw40 (hi); cck, ofdm */
+#define TXPWR_2G_HT_3S_DIFF		14
+#define TXPWR_2G_HT_4S_DIFF		16
+#define TXPWR_5G_BW40_BASE		18	/* [14] */
+#define TXPWR_5G_HT_1S_DIFF		32	/* ofdm:4 (lo), bw20:4 (hi) */
+#define TXPWR_5G_HT_2S_DIFF		33	/* bw20 (lo), bw40 (hi) */
+#define TXPWR_5G_HT_3S_DIFF		34
+#define TXPWR_5G_HT_4S_DIFF		35
+#define TXPWR_5G_OFDM_DIFF		36	/* [2] */
+#define TXPWR_5G_VHT_1S_DIFF		38	/* bw160 (lo), bw80 (hi) */
+
+#define LO4(b)	r22b_sign4((b) & 0x0f)
+#define HI4(b)	r22b_sign4((b) >> 4)
+
+static void
+r22b_parse_txpwr_idx(struct r22b_txpwr_idx *idx, const uint8_t *p)
+{
+	int i;
+
+	for (i = 0; i < R22B_GROUP_2G_CCK; i++)
+		idx->cck_base_2g[i] = p[TXPWR_2G_CCK_BASE + i];
+	for (i = 0; i < R22B_GROUP_2G; i++)
+		idx->bw40_base_2g[i] = p[TXPWR_2G_BW40_BASE + i];
+	idx->ht_1s_ofdm_2g = LO4(p[TXPWR_2G_HT_1S_DIFF]);
+	idx->ht_1s_bw20_2g = HI4(p[TXPWR_2G_HT_1S_DIFF]);
+	for (i = 0; i < 3; i++) {
+		/* struct rtw_2g_ns_pwr_idx_diff: 2 bytes per stream */
+		idx->ht_ns_bw20_2g[i] = LO4(p[TXPWR_2G_HT_2S_DIFF + 2 * i]);
+		idx->ht_ns_bw40_2g[i] = HI4(p[TXPWR_2G_HT_2S_DIFF + 2 * i]);
+	}
+
+	for (i = 0; i < R22B_GROUP_5G; i++)
+		idx->bw40_base_5g[i] = p[TXPWR_5G_BW40_BASE + i];
+	idx->ht_1s_ofdm_5g = LO4(p[TXPWR_5G_HT_1S_DIFF]);
+	idx->ht_1s_bw20_5g = HI4(p[TXPWR_5G_HT_1S_DIFF]);
+	for (i = 0; i < 3; i++) {
+		/* struct rtw_5g_ht_ns_pwr_idx_diff: 1 byte per stream */
+		idx->ht_ns_bw20_5g[i] = LO4(p[TXPWR_5G_HT_2S_DIFF + i]);
+		idx->ht_ns_bw40_5g[i] = HI4(p[TXPWR_5G_HT_2S_DIFF + i]);
+	}
+	for (i = 0; i < 4; i++) {
+		/* struct rtw_5g_vht_ns_pwr_idx_diff: bw160 (lo), bw80 (hi) */
+		idx->vht_bw80_5g[i] = HI4(p[TXPWR_5G_VHT_1S_DIFF + i]);
+	}
+}
+
+#undef LO4
+#undef HI4
+
+void
+r22b_parse_rom(struct rtwn_softc *sc, uint8_t *buf)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	struct ieee80211com *ic = &sc->sc_ic;
+	uint8_t *macaddr = &buf[R22B_EFUSE_U_MAC_ADDR];
+	int i;
+
+	/* rtw8822b_read_efuse() */
+	rs->usb_mode_switch = (buf[R22B_EFUSE_USB_MODE] >> 7) & 0x1;
+	rs->rfe_option = buf[R22B_EFUSE_RFE_OPTION];
+	rs->rf_board_option = buf[R22B_EFUSE_RF_BOARD_OPTION];
+	rs->crystal_cap = buf[R22B_EFUSE_XTAL_K];
+	rs->pa_type_2g = buf[R22B_EFUSE_PA_TYPE];
+	rs->pa_type_5g = buf[R22B_EFUSE_PA_TYPE];
+	rs->lna_type_2g = buf[R22B_EFUSE_LNA_TYPE_2G];
+	rs->lna_type_5g = buf[R22B_EFUSE_LNA_TYPE_5G];
+	rs->channel_plan = buf[R22B_EFUSE_CHANNEL_PLAN];
+	rs->country_code[0] = buf[R22B_EFUSE_COUNTRY_CODE];
+	rs->country_code[1] = buf[R22B_EFUSE_COUNTRY_CODE + 1];
+	rs->bt_setting = buf[R22B_EFUSE_RF_BT_SETTING];
+	rs->regd = rs->rf_board_option & 0x7;
+	rs->thermal_meter = buf[R22B_EFUSE_THERMAL_METER];
+	sc->thermal_meter = rs->thermal_meter;
+
+	for (i = 0; i < R22B_RF_PATH_MAX; i++) {
+		r22b_parse_txpwr_idx(&rs->txpwr_idx[i],
+		    &buf[R22B_EFUSE_TXPWR_IDX_TABLE +
+		    i * R22B_EFUSE_TXPWR_IDX_SIZE]);
+	}
+
+	/* rtw_chip_efuse_info_setup() */
+	if (rs->crystal_cap == 0xff)
+		rs->crystal_cap = 0;
+	if (rs->pa_type_2g == 0xff)
+		rs->pa_type_2g = 0;
+	if (rs->pa_type_5g == 0xff)
+		rs->pa_type_5g = 0;
+	if (rs->lna_type_2g == 0xff)
+		rs->lna_type_2g = 0;
+	if (rs->lna_type_5g == 0xff)
+		rs->lna_type_5g = 0;
+	if (rs->channel_plan == 0xff)
+		rs->channel_plan = 0x7f;
+	if (rs->rf_board_option == 0xff)
+		rs->rf_board_option = 0;
+	if (rs->bt_setting & 0x1)
+		rs->share_ant = 1;
+	if (rs->regd == 0xff)
+		rs->regd = 0;
+
+	rs->btcoex = (rs->rf_board_option & 0xe0) == 0x20;
+	rs->ext_pa_2g = (rs->pa_type_2g & 0x10) ? 1 : 0;
+	rs->ext_lna_2g = (rs->lna_type_2g & 0x08) ? 1 : 0;
+	rs->ext_pa_5g = (rs->pa_type_5g & 0x01) ? 1 : 0;
+	rs->ext_lna_5g = (rs->lna_type_5g & 0x08) ? 1 : 0;
+
+	/* rtw_check_supported_rfe() / rtw8822b_rfe_defs[] */
+	switch (rs->rfe_option) {
+	case 2:
+		rs->pg_tbl = &rtw8822b_bb_pg_type2_tbl;
+		rs->lmt_tbl = &rtw8822b_txpwr_lmt_type2_tbl;
+		break;
+	case 3:
+		rs->pg_tbl = &rtw8822b_bb_pg_type3_tbl;
+		rs->lmt_tbl = &rtw8822b_txpwr_lmt_type0_tbl;
+		break;
+	case 5:
+		rs->pg_tbl = &rtw8822b_bb_pg_type5_tbl;
+		rs->lmt_tbl = &rtw8822b_txpwr_lmt_type5_tbl;
+		break;
+	default:
+		rs->pg_tbl = NULL;
+		rs->lmt_tbl = NULL;
+		break;
+	}
+	rs->rfe_supported = (rs->pg_tbl != NULL);
+	if (!rs->rfe_supported) {
+		device_printf(sc->sc_dev, "rfe %u isn't supported\n",
+		    rs->rfe_option);
+	}
+
+	/* Read MAC address (rtw8822bu_efuse_parsing()). */
+	if (ETHER_IS_MULTICAST(macaddr) || ETHER_IS_ZERO(macaddr)) {
+		/* rtw_chip_efuse_info_setup(): eth_random_addr() */
+		arc4random_buf(macaddr, IEEE80211_ADDR_LEN);
+		macaddr[0] &= 0xfe;	/* clear multicast bit */
+		macaddr[0] |= 0x02;	/* set local assignment bit */
+		device_printf(sc->sc_dev, "efuse MAC invalid, using random\n");
+	}
+	IEEE80211_ADDR_COPY(ic->ic_macaddr, macaddr);
+
+	device_printf(sc->sc_dev, "cut %c, RFE type %u, crystal cap 0x%02x, "
+	    "thermal 0x%02x, PA 0x%02x, LNA 0x%02x/0x%02x, board 0x%02x%s\n",
+	    'A' + rs->cut_version, rs->rfe_option, rs->crystal_cap,
+	    rs->thermal_meter, rs->pa_type_2g, rs->lna_type_2g,
+	    rs->lna_type_5g, rs->rf_board_option,
+	    rs->btcoex ? ", BT coex" : "");
+
+	/* rtw_chip_board_info_setup(): tx power tables for this RFE. */
+	if (rs->rfe_supported)
+		r22b_txpwr_setup(sc);
+}
