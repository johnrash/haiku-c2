 	RTWN_CHIP_RTL8812AU,
 	RTWN_CHIP_RTL8821AU,
+	RTWN_CHIP_RTL8822BU,
 	RTWN_CHIP_MAX_USB
 };
 
@@ -171,6 +173,54 @@ static const STRUCT_USB_HOST_ID rtwn_devs[] = {
 	RTWN_RTL8821AU_DEV(TPLINK,		T2UPLUS),
 	RTWN_RTL8821AU_DEV(TPLINK,		T2UV3),
 #undef RTWN_RTL8821AU_DEV
+
+	/*
+	 * RTL8822BU (RTL8812BU/RTL8822BU, e.g. "AC1300"); the IDs of Linux
+	 * rtw88's rtw8822bu.c.  Most have no usbdevs name, so they are
