+#include <dev/rtwn/if_rtwnvar.h>
+
+#include <dev/rtwn/if_rtwn_debug.h>
+
+#include <dev/rtwn/usb/rtwn_usb_var.h>
+
+#include <dev/rtwn/rtl8822b/r22b.h>
+#include <dev/rtwn/rtl8822b/r22b_priv.h>
+#include <dev/rtwn/rtl8822b/r22b_reg.h>
+#include <dev/rtwn/rtl8822b/r22b_var.h>
+#include <dev/rtwn/rtl8822b/usb/r22bu.h>
+
+/*
+ * The chip moves the data of each bulk-out endpoint into a fixed DMA
+ * priority queue (rtw88 dma_mapping_to_ep(): HIGH = first endpoint,
+ * NORMAL = second, LOW = third, EXTRA = fourth), and REG_TXDMA_PQ_MAP
+ * maps the hardware queues (QSEL) onto those priorities.  Every frame
+ * must therefore be sent on the endpoint of its queue's priority.
+ *
+ * rtwn has four Tx transfers; for the RTL8822B they are used per DMA
+ * priority instead of per access category:
+ *
+ *	RTWN_BULK_TX_BK	HIGH endpoint: H2C, reserved pages (firmware
+ *			download), beacons, and data mapped to HIGH
+ *	RTWN_BULK_TX_VI	NORMAL endpoint
+ *	RTWN_BULK_TX_BE	LOW endpoint (3 or 4 endpoints)
+ *	RTWN_BULK_TX_VO	endpoint of the management queue (rtwn_usb_tx_start()
+ *			sends all management/control frames there)
+ *
+ * and wme2qid[] sends each access category to the transfer of the
+ * priority rqpn_table_8822b[] assigns to it, exactly like rtw88:
+ *
+ *	endpoints  VO      VI      BE      BK      MGMT    HI/H2C
+ *	2          NORMAL  NORMAL  NORMAL  HIGH    HIGH    HIGH
+ *	3          NORMAL  NORMAL  LOW     LOW     HIGH    HIGH
+ *	4          NORMAL  NORMAL  LOW     LOW     EXTRA   HIGH
+ *
+ * Called by rtwn_usb_setup_endpoints() (uc_setup_ep_map hook).
+ */
+static int
+r22bu_prio_to_ep(int ntx, uint8_t prio)
+{
+	switch (prio) {
+	case R22B_DMA_MAPPING_HIGH:
+		return (0);
+	case R22B_DMA_MAPPING_NORMAL:
+		return (1);
+	case R22B_DMA_MAPPING_LOW:
+		return (ntx >= 3 ? 2 : -1);
+	case R22B_DMA_MAPPING_EXTRA:
+		return (ntx >= 4 ? 3 : -1);
+	default:
+		return (-1);
+	}
+}
+
+static int
+r22bu_prio_to_qid(const struct r22b_rqpn *rqpn, uint8_t prio)
+{
+	switch (prio) {
+	case R22B_DMA_MAPPING_HIGH:
+		return (RTWN_BULK_TX_BK);
+	case R22B_DMA_MAPPING_NORMAL:
+		return (RTWN_BULK_TX_VI);
+	case R22B_DMA_MAPPING_LOW:
+		return (RTWN_BULK_TX_BE);
+	default:
+		/* Only the management queue may use EXTRA. */
+		if (prio == rqpn->dma_map_mg)
+			return (RTWN_BULK_TX_VO);
+		return (-1);
+	}
+}
+
+int
+r22bu_setup_ep_map(struct rtwn_usb_softc *uc, struct usb_config *cfg,
+    const uint8_t *addr)
+{
+	struct rtwn_softc *sc = &uc->uc_sc;
+	struct r22b_softc *rs = sc->sc_priv;
+	const struct r22b_rqpn *rqpn;
+	int ep_mg, qid_vo, qid_vi, qid_be, qid_bk;
+
+	/* rtw88 txdma_queue_mapping() supports 2, 3 and 4 endpoints. */
+	if (uc->ntx < 2 || uc->ntx > 4) {
+		device_printf(sc->sc_dev, "%s: %d bulk-out endpoints, "
+		    "need 2 to 4\n", __func__, uc->ntx);
+		return (ENXIO);
+	}
+
+	rqpn = &r22b_rqpn_table[uc->ntx];
+	rs->rqpn = rqpn;
+	rs->page_table = &r22b_page_table[uc->ntx];
+
+	ep_mg = r22bu_prio_to_ep(uc->ntx, rqpn->dma_map_mg);
+	qid_vo = r22bu_prio_to_qid(rqpn, rqpn->dma_map_vo);
+	qid_vi = r22bu_prio_to_qid(rqpn, rqpn->dma_map_vi);
+	qid_be = r22bu_prio_to_qid(rqpn, rqpn->dma_map_be);
+	qid_bk = r22bu_prio_to_qid(rqpn, rqpn->dma_map_bk);
+	if (ep_mg < 0 || qid_vo < 0 || qid_vi < 0 || qid_be < 0 ||
+	    qid_bk < 0 ||
+	    r22bu_prio_to_ep(uc->ntx, rqpn->dma_map_hi) != 0) {
+		device_printf(sc->sc_dev, "%s: bad queue mapping\n", __func__);
+		return (EINVAL);
+	}
+
+	cfg[RTWN_BULK_TX_BK].endpoint = addr[0];
+	cfg[RTWN_BULK_TX_VI].endpoint = addr[1];
+	cfg[RTWN_BULK_TX_BE].endpoint = addr[uc->ntx >= 3 ? 2 : 1];
+	cfg[RTWN_BULK_TX_VO].endpoint = addr[ep_mg];
+
+	uc->wme2qid[WME_AC_VO] = qid_vo;
+	uc->wme2qid[WME_AC_VI] = qid_vi;
+	uc->wme2qid[WME_AC_BE] = qid_be;
+	uc->wme2qid[WME_AC_BK] = qid_bk;
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_USB, "%s: %d bulk-out endpoints: "
+	    "high 0x%02x, normal 0x%02x, low 0x%02x, mgmt 0x%02x\n",
+	    __func__, uc->ntx, addr[0], addr[1], addr[uc->ntx >= 3 ? 2 : 1],
+	    addr[ep_mg]);
+
+	return (0);
+}
+
+/* rtw_usb_init_burst_pkt_len() (rtw_usb_interface_cfg()) */
+static void
+r22bu_init_burst_pkt_len(struct rtwn_softc *sc)
+{
+	struct rtwn_usb_softc *uc = RTWN_USB_SOFTC(sc);
+	uint8_t rxdma, burst_size;
+
+	rxdma = R22B_BIT_DMA_BURST_CNT | R22B_BIT_DMA_MODE;
+
+	switch (usbd_get_speed(uc->uc_udev)) {
+	case USB_SPEED_SUPER:
+		burst_size = R22B_BIT_DMA_BURST_SIZE_1024;
+		break;
+	case USB_SPEED_HIGH:
+		burst_size = R22B_BIT_DMA_BURST_SIZE_512;
+		break;
+	default:
+		burst_size = R22B_BIT_DMA_BURST_SIZE_64;
+		break;
+	}
+
+	rxdma &= ~R22B_BIT_DMA_BURST_SIZE;
+	rxdma |= (burst_size << r22b_mask_shift(R22B_BIT_DMA_BURST_SIZE)) &
+	    R22B_BIT_DMA_BURST_SIZE;
+
+	rtwn_write_1(sc, R22B_REG_RXDMA_MODE, rxdma);
+	r22b_write16_set(sc, R22B_REG_TXDMA_OFFSET_CHK, R22B_BIT_DROP_DATA_EN);
+}
+
+/*
+ * sc_dma_init hook (rtwn_init() calls it instead of rtwn_dma_init()):
+ * rtw_mac_init() including rtw_hci_interface_cfg(), then the MAC table
+ * (see r22b_load_mac_table()).
+ */
+int
+r22bu_dma_init(struct rtwn_softc *sc)
+{
+	int error;
+
+	error = r22b_mac_init(sc);
+	if (error != 0)
+		return (error);
+
+	r22bu_init_burst_pkt_len(sc);
+	r22b_load_mac_table(sc);
+
+	return (0);
+}
+
+/* rtw_usb_dynamic_rx_agg_v1() */
+static void
+r22bu_set_rx_agg(struct rtwn_softc *sc, int enable)
+{
+	uint8_t size, timeout;
+	uint16_t val16;
+
+	r22b_write8_set(sc, R22B_REG_TXDMA_PQ_MAP, R22B_BIT_RXDMA_AGG_EN);
+	r22b_write8_clr(sc, R22B_REG_RXDMA_AGG_PG_TH + 3, R22B_BIT(7));
+
+	if (enable) {
+		size = 0x5;
+		timeout = 0x20;
+	} else {
+		size = 0x0;
+		timeout = 0x1;
+	}
+	val16 = (size & R22B_BIT_RXDMA_AGG_PG_TH) |
+	    ((timeout << 8) & R22B_BIT_DMA_AGG_TO_V1);
+
+	rtwn_write_2(sc, R22B_REG_RXDMA_AGG_PG_TH, val16);
+}
+
+/*
+ * sc_init_rx_agg: start with the low-traffic setting rtw88's watchdog
+ * selects (rtw_hci_dynamic_rx_agg(rtwdev, false)).
+ *
+ * TODO (later phase): switch to the aggregating setting (size 0x5,
+ * timeout 0x20) under load, like rtw_watch_dog_work() does when the
+ * unicast throughput is >= 1 Mbps.
+ */
+void
+r22bu_init_rx_agg(struct rtwn_softc *sc)
+{
+	r22bu_set_rx_agg(sc, 0);
+}
+
+/* rtw_usb_phy_write() for SuperSpeed */
+static void
+r22bu_usb3_phy_write(struct rtwn_softc *sc, uint8_t addr, uint16_t data)
+{
+	rtwn_write_1(sc, R22B_REG_USB3_PHY_DAT_L, data & 0xff);
+	rtwn_write_1(sc, R22B_REG_USB3_PHY_DAT_H, data >> 8);
+	rtwn_write_1(sc, R22B_REG_USB3_PHY_ADR, addr | R22B_BIT_USB3_PHY_ADR_WR);
+}
+
+/*
+ * rtw_usb_phy_cfg(USB_SPEED_HIGH) + rtw_usb_phy_cfg(USB_SPEED_SUPER), as
+ * rtw_usb_probe() does after reading the efuse (both regardless of the
+ * actual speed).  usb2_param_8822b[] is empty; usb3_param_8822b[] has one
+ * entry for D-cut chips (PHY register 0x01 = 0xa841).
+ *
+ * Not done: rtw_usb_switch_mode() (switching a USB 3 capable adapter
+ * from USB 2 to USB 3 mode, which re-enumerates the device).
+ */
+void
+r22bu_phy_cfg(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	/* RTW_INTF_PHY_CUT_D == BIT(3) */
+	if (R22B_BIT(rs->cut_version) & R22B_BIT(3)) {
+		/* rtw_usb_page_switch() does nothing for SuperSpeed. */
+		r22bu_usb3_phy_write(sc, 0x01, 0xa841);
+	}
+}
diff --git a/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_rx.c b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_rx.c
new file mode 100644
index 0000000000..21b7a78e61
--- /dev/null
+++ b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_rx.c
@@ -0,0 +1,78 @@
+/*-
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright(c) 2018-2019  Realtek Corporation
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ *
+ * Derived from Linux's rtw88 driver (v7.0), used under its BSD-3-Clause option;
+ * see LICENSE.rtw88 in this directory.
+ */
+
+/*
+ * RTL8822BU Rx transfer classification.
+ *
+ * rtw88 (usb.c rtw_usb_rx_handler()) walks every packet of an Rx
+ * transfer, 8-byte aligned, and routes each one by the C2H bit of its
+ * descriptor (RTW_RX_DESC_W2_C2H).  rtwn classifies a whole transfer by
+ * its first packet, so a transfer is only reported as a C2H event when
+ * that event is all it contains; C2H events aggregated with frames are
+ * caught per packet by r22b_check_frame().
+ */
+
+#include <sys/cdefs.h>
+#include "opt_wlan.h"
+
+#include <sys/param.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/mbuf.h>
+#include <sys/kernel.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/taskqueue.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/linker.h>
+
+#include <net/if.h>
+#include <net/ethernet.h>
+#include <net/if_media.h>
+
+#include <net80211/ieee80211_var.h>
+#include <net80211/ieee80211_radiotap.h>
+
+#include <dev/rtwn/if_rtwnreg.h>
+#include <dev/rtwn/if_rtwnvar.h>
+
+#include <dev/rtwn/rtl8822b/r22b_rx_desc.h>
+#include <dev/rtwn/rtl8822b/usb/r22bu.h>
+
+int
+r22bu_classify_intr(struct rtwn_softc *sc, void *buf, int len)
+{
+	const struct r22b_rx_stat *stat = buf;
+	uint32_t rxdw0;
+	int totlen;
+
+	if (le32toh(stat->rxdw2) & R22B_RXDW2_C2H) {
+		rxdw0 = le32toh(stat->rxdw0);
+		totlen = sizeof(*stat) + MS(rxdw0, RTWN_RXDW0_INFOSZ) * 8 +
+		    MS(rxdw0, RTWN_RXDW0_SHIFT) + MS(rxdw0, RTWN_RXDW0_PKTLEN);
+		if (roundup2(totlen, 8) >= len)
+			return (RTWN_RX_OTHER);
+	}
+
+	return (RTWN_RX_DATA);
+}
+
+/* rtw_usb_rx_handler(): next_pkt = round_up(skb_len, 8) */
+int
+r22bu_align_rx(int totlen, int len)
+{
+	if (totlen < len)
+		return (roundup2(totlen, 8));
+
+	return (totlen);
+}
diff --git a/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_tx.c b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_tx.c
new file mode 100644
index 0000000000..dc8bb82d77
--- /dev/null
+++ b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_tx.c
@@ -0,0 +1,161 @@
+/*-
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright(c) 2018-2019  Realtek Corporation
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ *
+ * Derived from Linux's rtw88 driver (v7.0), used under its BSD-3-Clause option;
+ * see LICENSE.rtw88 in this directory.
+ */
+
+/*
+ * RTL8822BU: raw packets to the firmware (reserved pages for the
+ * firmware download, H2C packets) on the high priority bulk-out pipe.
+ *
+ * rtwn_usb_tx_start() cannot be used for these: it overwrites the offset
+ * (rtw88 sends H2C packets with offset 0) and picks the pipe from the
+ * frame type.  r22bu_tx_raw() queues a prepared buffer on the transfer
+ * of the high priority queue the same way rtwn_usb_tx_start() does
+ * (rtwn_data without node/mbuf, like a beacon); the standard Tx
+ * completion callback recycles it.
+ *
+ * Sources (rtw88 v7.0): usb.c (rtw_usb_write_data,
+ * rtw_usb_write_data_rsvd_page, rtw_usb_write_data_h2c,
+ * rtw_usb_write_port), tx.c (rtw_tx_fill_tx_desc), rtw8822b.c
+ * (rtw8822b_fill_txdesc_checksum).
+ */
+
+#include <sys/cdefs.h>
+#include "opt_wlan.h"
+
+#include <sys/param.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/mbuf.h>
+#include <sys/kernel.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/taskqueue.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/linker.h>
+
+#include <net/if.h>
+#include <net/ethernet.h>
+#include <net/if_media.h>
+
+#include <net80211/ieee80211_var.h>
+#include <net80211/ieee80211_radiotap.h>
+
+#include <dev/usb/usb.h>
+#include <dev/usb/usbdi.h>
+
+#include <dev/rtwn/if_rtwnreg.h>
+#include <dev/rtwn/if_rtwnvar.h>
+
+#include <dev/rtwn/if_rtwn_debug.h>
+
+#include <dev/rtwn/usb/rtwn_usb_var.h>
+#include <dev/rtwn/usb/rtwn_usb_reg.h>
+
+#include <dev/rtwn/rtl8822b/r22b_tx_desc.h>
+#include <dev/rtwn/rtl8822b/usb/r22bu.h>
+
+static int
+r22bu_tx_raw(struct rtwn_softc *sc, struct r22b_tx_desc *txd,
+    const uint8_t *data, int len)
+{
+	struct rtwn_usb_softc *uc = RTWN_USB_SOFTC(sc);
+	struct rtwn_data *bf = NULL;
+	const int qid = R22BU_HIGH_QID;
+	int ntries;
+
+	RTWN_ASSERT_LOCKED(sc);
+
+	if (len < 0 || len + sizeof(*txd) > RTWN_USB_TXBUFSZ)
+		return (EINVAL);
+
+	/* rtw8822b_fill_txdesc_checksum(): XOR of the first 32 bytes */
+	txd->txdw7 = 0;
+	txd->txdw7 = rtwn_usb_calc_tx_checksum(txd);
+
+	rtwn_dump_tx_desc(sc, txd);
+
+	/*
+	 * Wait for a free buffer; completions are processed whenever the
+	 * driver lock is dropped (register access, rtwn_delay()).
+	 */
+	for (ntries = 0; ntries < 100; ntries++) {
+		bf = STAILQ_FIRST(&uc->uc_tx_inactive);
+		if (bf != NULL)
+			break;
+		rtwn_delay(sc, 1000);
+	}
+	if (bf == NULL)
+		return (ENOBUFS);
+	STAILQ_REMOVE_HEAD(&uc->uc_tx_inactive, next);
+
+	memcpy(bf->buf, txd, sizeof(*txd));
+	memcpy(bf->buf + sizeof(*txd), data, len);
+	bf->buflen = sizeof(*txd) + len;
+	bf->id = 0;
+	bf->qid = qid;
+	bf->ni = NULL;
+	bf->m = NULL;
+
+	STAILQ_INSERT_TAIL(&uc->uc_tx_pending[qid], bf, next);
+	if (STAILQ_EMPTY(&uc->uc_tx_inactive))
+		sc->qfullmsk = 1;
+
+	usbd_transfer_start(uc->uc_xfer[qid]);
+
+	return (0);
+}
+
+/* rtw_usb_write_data_rsvd_page() */
+int
+r22bu_write_rsvd_page(struct rtwn_softc *sc, const uint8_t *buf, int size)
+{
+	struct r22b_tx_desc txd;
+
+	memset(&txd, 0, sizeof(txd));
+	txd.pktlen = htole16(size);
+	txd.offset = sizeof(txd);
+	txd.flags0 = R22B_FLAGS0_LS;
+	txd.txdw1 = htole32(SM(R22B_TXDW1_QSEL, R22B_TXDW1_QSEL_BEACON));
+
+	return (r22bu_tx_raw(sc, &txd, buf, size));
+}
+
+/* rtw_usb_write_data_h2c(): offset and LS are left at 0 by rtw88. */
+int
+r22bu_write_h2c_pkt(struct rtwn_softc *sc, const uint8_t *buf, int size)
+{
+	struct r22b_tx_desc txd;
+
+	memset(&txd, 0, sizeof(txd));
+	txd.pktlen = htole16(size);
+	txd.txdw1 = htole32(SM(R22B_TXDW1_QSEL, R22B_TXDW1_QSEL_H2C));
+
+	return (r22bu_tx_raw(sc, &txd, buf, size));
+}
+
+void
+r22bu_dump_tx_desc(struct rtwn_softc *sc, const void *desc)
+{
+#ifdef RTWN_DEBUG
+	const struct r22b_tx_desc *txd = desc;
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_XMIT_DESC,
+	    "%s: len %d, off %d, flags0 %02X, dw: 1 %08X, 2 %08X, 3 %08X "
+	    "(rate %02X), 4 %08X, 5 %08X, 6 %08X, 7 %04X, 8 %08X, "
+	    "9 %08X\n", __func__, le16toh(txd->pktlen), txd->offset,
+	    txd->flags0, le32toh(txd->txdw1), le32toh(txd->txdw2),
+	    le32toh(txd->txdw3), MS(le32toh(txd->txdw4),
+	    R22B_TXDW4_DATARATE), le32toh(txd->txdw4), le32toh(txd->txdw5),
+	    le32toh(txd->txdw6), le16toh(txd->txdw7), le32toh(txd->txdw8),
+	    le32toh(txd->txdw9));
+#endif
+}
diff --git a/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/usb/rtwn_usb_attach.h b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/usb/rtwn_usb_attach.h
index cd5485b366..534afa0de3 100644
--- a/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/usb/rtwn_usb_attach.h
+++ b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/usb/rtwn_usb_attach.h
@@ -23,6 +23,7 @@ void	r92eu_attach(struct rtwn_usb_softc *);
 void	r88eu_attach(struct rtwn_usb_softc *);
