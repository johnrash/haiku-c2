+/* rtw_set_channel_mac() (3081 CPU) */
+static void
+r22b_set_channel_mac(struct rtwn_softc *sc, uint8_t channel, uint8_t bw,
+    uint8_t primary_ch_idx)
+{
+	uint8_t txsc40 = 0, txsc20 = 0, value8;
+	uint32_t value32;
+
+	txsc20 = primary_ch_idx;
+	if (bw == R22B_CHANNEL_WIDTH_80) {
+		if (txsc20 == R22B_SC_20_UPPER || txsc20 == R22B_SC_20_UPMOST)
+			txsc40 = R22B_SC_40_UPPER;
+		else
+			txsc40 = R22B_SC_40_LOWER;
+	}
+	rtwn_write_1(sc, R22B_REG_DATA_SC,
+	    R22B_BIT_TXSC_20M(txsc20) | R22B_BIT_TXSC_40M(txsc40));
+
+	value32 = rtwn_read_4(sc, R22B_REG_WMAC_TRXPTCL_CTL);
+	value32 &= ~R22B_BIT_RFMOD;
+	switch (bw) {
+	case R22B_CHANNEL_WIDTH_80:
+		value32 |= R22B_BIT_RFMOD_80M;
+		break;
+	case R22B_CHANNEL_WIDTH_40:
+		value32 |= R22B_BIT_RFMOD_40M;
+		break;
+	case R22B_CHANNEL_WIDTH_20:
+	default:
+		break;
+	}
+	rtwn_write_4(sc, R22B_REG_WMAC_TRXPTCL_CTL, value32);
+
+	value32 = rtwn_read_4(sc, R22B_REG_AFE_CTRL1) & ~R22B_BIT_MAC_CLK_SEL;
+	value32 |= (R22B_MAC_CLK_HW_DEF_80M << R22B_BIT_SHIFT_MAC_CLK_SEL);
+	rtwn_write_4(sc, R22B_REG_AFE_CTRL1, value32);
+
+	rtwn_write_1(sc, R22B_REG_USTIME_TSF, R22B_MAC_CLK_SPEED);
+	rtwn_write_1(sc, R22B_REG_USTIME_EDCA, R22B_MAC_CLK_SPEED);
+
+	value8 = rtwn_read_1(sc, R22B_REG_CCK_CHECK);
+	value8 = value8 & ~R22B_BIT_CHECK_CCK_EN;
+	if (R22B_IS_CH_5G_BAND(channel))
+		value8 |= R22B_BIT_CHECK_CCK_EN;
+	rtwn_write_1(sc, R22B_REG_CCK_CHECK, value8);
+}
+
+static const uint8_t low_band[15] = {0x7, 0x6, 0x6, 0x5, 0x0, 0x0, 0x7, 0xff,
+	0x6, 0x5, 0x0, 0x0, 0x7, 0x6, 0x6};
+static const uint8_t middle_band[23] = {0x6, 0x5, 0x0, 0x0, 0x7, 0x6, 0x6,
+	0xff, 0x0, 0x0, 0x7, 0x6, 0x6, 0x5, 0x0, 0xff, 0x7, 0x6, 0x6, 0x5, 0x0,
+	0x0, 0x7};
+static const uint8_t high_band[15] = {0x5, 0x5, 0x0, 0x7, 0x7, 0x6, 0x5, 0xff,
+	0x0, 0x7, 0x7, 0x6, 0x5, 0x5, 0x0};
+
+/* rtw8822b_set_channel_rf() */
+static void
+r22b_set_channel_rf(struct rtwn_softc *sc, uint8_t channel, uint8_t bw)
+{
+#define RF18_BAND_MASK		(R22B_BIT(16) | R22B_BIT(9) | R22B_BIT(8))
+#define RF18_BAND_2G		(0)
+#define RF18_BAND_5G		(R22B_BIT(16) | R22B_BIT(8))
+#define RF18_CHANNEL_MASK	(R22B_MASKBYTE0)
+#define RF18_RFSI_MASK		(R22B_BIT(18) | R22B_BIT(17))
+#define RF18_RFSI_GE_CH80	(R22B_BIT(17))
+#define RF18_RFSI_GT_CH144	(R22B_BIT(18))
+#define RF18_BW_MASK		(R22B_BIT(11) | R22B_BIT(10))
+#define RF18_BW_20M		(R22B_BIT(11) | R22B_BIT(10))
+#define RF18_BW_40M		(R22B_BIT(11))
+#define RF18_BW_80M		(R22B_BIT(10))
+#define RFBE_MASK		(R22B_BIT(17) | R22B_BIT(16) | R22B_BIT(15))
+
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t rf_reg18, rf_reg_be;
+
+	rf_reg18 = r22b_rf_read(sc, R22B_RF_PATH_A, R22B_RF_CFGCH);
+
+	rf_reg18 &= ~(RF18_BAND_MASK | RF18_CHANNEL_MASK | RF18_RFSI_MASK |
+		      RF18_BW_MASK);
+
+	rf_reg18 |= (R22B_IS_CH_2G_BAND(channel) ? RF18_BAND_2G : RF18_BAND_5G);
+	rf_reg18 |= (channel & RF18_CHANNEL_MASK);
+	if (channel > 144)
+		rf_reg18 |= RF18_RFSI_GT_CH144;
+	else if (channel >= 80)
+		rf_reg18 |= RF18_RFSI_GE_CH80;
+
+	switch (bw) {
+	case R22B_CHANNEL_WIDTH_20:
+	default:
+		rf_reg18 |= RF18_BW_20M;
+		break;
+	case R22B_CHANNEL_WIDTH_40:
+		rf_reg18 |= RF18_BW_40M;
+		break;
+	case R22B_CHANNEL_WIDTH_80:
+		rf_reg18 |= RF18_BW_80M;
+		break;
+	}
+
+	if (R22B_IS_CH_2G_BAND(channel))
+		rf_reg_be = 0x0;
+	else if (R22B_IS_CH_5G_BAND_1(channel) ||
+	    R22B_IS_CH_5G_BAND_2(channel))
+		rf_reg_be = low_band[(channel - 36) >> 1];
+	else if (R22B_IS_CH_5G_BAND_3(channel))
+		rf_reg_be = middle_band[(channel - 100) >> 1];
+	else if (R22B_IS_CH_5G_BAND_4(channel))
+		rf_reg_be = high_band[(channel - 149) >> 1];
+	else {
+		device_printf(sc->sc_dev, "%s: invalid channel %u\n",
+		    __func__, channel);
+		return;
+	}
+
+	r22b_rf_write_mask(sc, R22B_RF_PATH_A, R22B_RF_MALSEL, RFBE_MASK,
+	    rf_reg_be);
+
+	/* need to set 0xdf[18]=1 before writing RF18 when channel 144 */
+	if (channel == 144)
+		r22b_rf_write_mask(sc, R22B_RF_PATH_A, R22B_RF_LUTDBG,
+		    R22B_BIT(18), 0x1);
+	else
+		r22b_rf_write_mask(sc, R22B_RF_PATH_A, R22B_RF_LUTDBG,
+		    R22B_BIT(18), 0x0);
+
+	r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_CFGCH, rf_reg18);
+	if (rs->rf_path_num > 1)	/* hal->rf_type > RF_1T1R */
+		r22b_rf_write(sc, R22B_RF_PATH_B, R22B_RF_CFGCH, rf_reg18);
+
+	r22b_rf_write_mask(sc, R22B_RF_PATH_A, R22B_RF_XTALX2, R22B_BIT(19), 0);
+	r22b_rf_write_mask(sc, R22B_RF_PATH_A, R22B_RF_XTALX2, R22B_BIT(19), 1);
+
+#undef RF18_BAND_MASK
+#undef RF18_BAND_2G
+#undef RF18_BAND_5G
+#undef RF18_CHANNEL_MASK
+#undef RF18_RFSI_MASK
+#undef RF18_RFSI_GE_CH80
+#undef RF18_RFSI_GT_CH144
+#undef RF18_BW_MASK
+#undef RF18_BW_20M
+#undef RF18_BW_40M
+#undef RF18_BW_80M
+#undef RFBE_MASK
+}
+
+/* rtw8822b_set_channel_rxdfir() */
+static void
+r22b_set_channel_rxdfir(struct rtwn_softc *sc, uint8_t bw)
+{
+	if (bw == R22B_CHANNEL_WIDTH_40) {
+		/* RX DFIR for BW40 */
+		r22b_write32_mask(sc, R22B_REG_ACBB0,
+		    R22B_BIT(29) | R22B_BIT(28), 0x1);
+		r22b_write32_mask(sc, R22B_REG_ACBBRXFIR,
+		    R22B_BIT(29) | R22B_BIT(28), 0x0);
+		r22b_write32s_mask(sc, R22B_REG_TXDFIR, R22B_BIT(31), 0x0);
+	} else if (bw == R22B_CHANNEL_WIDTH_80) {
+		/* RX DFIR for BW80 */
+		r22b_write32_mask(sc, R22B_REG_ACBB0,
+		    R22B_BIT(29) | R22B_BIT(28), 0x2);
+		r22b_write32_mask(sc, R22B_REG_ACBBRXFIR,
+		    R22B_BIT(29) | R22B_BIT(28), 0x1);
+		r22b_write32s_mask(sc, R22B_REG_TXDFIR, R22B_BIT(31), 0x0);
+	} else {
+		/* RX DFIR for BW20, BW10 and BW5*/
+		r22b_write32_mask(sc, R22B_REG_ACBB0,
+		    R22B_BIT(29) | R22B_BIT(28), 0x2);
+		r22b_write32_mask(sc, R22B_REG_ACBBRXFIR,
+		    R22B_BIT(29) | R22B_BIT(28), 0x2);
+		r22b_write32s_mask(sc, R22B_REG_TXDFIR, R22B_BIT(31), 0x1);
+	}
+}
+
+/* rtw8822b_set_channel_bb() (5 and 10 MHz widths left out) */
+static void
+r22b_set_channel_bb(struct rtwn_softc *sc, uint8_t channel, uint8_t bw,
+    uint8_t primary_ch_idx)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const uint8_t rfe_option = rs->rfe_option;
+	uint32_t val32;
+
+	if (R22B_IS_CH_2G_BAND(channel)) {
+		r22b_write32_mask(sc, R22B_REG_RXPSEL, R22B_BIT(28), 0x1);
+		r22b_write32_mask(sc, R22B_REG_CCK_CHECK, R22B_BIT(7), 0x0);
+		r22b_write32_mask(sc, R22B_REG_ENTXCCK, R22B_BIT(18), 0x0);
+		r22b_write32_mask(sc, R22B_REG_RXCCAMSK, 0x0000fc00, 15);
+
+		r22b_write32_mask(sc, R22B_REG_ACGG2TBL, 0x1f, 0x0);
+		r22b_write32_mask(sc, R22B_REG_CLKTRK, 0x1ffe0000, 0x96a);
+		if (channel == 14) {
+			r22b_write32_mask(sc, R22B_REG_TXSF2, R22B_MASKDWORD,
+			    0x00006577);
+			r22b_write32_mask(sc, R22B_REG_TXSF6, R22B_MASKLWORD,
+			    0x0000);
+		} else {
+			r22b_write32_mask(sc, R22B_REG_TXSF2, R22B_MASKDWORD,
+			    0x384f6577);
+			r22b_write32_mask(sc, R22B_REG_TXSF6, R22B_MASKLWORD,
+			    0x1525);
+		}
+
+		r22b_write32_mask(sc, R22B_REG_RFEINV, 0x300, 0x2);
+	} else if (R22B_IS_CH_5G_BAND(channel)) {
+		r22b_write32_mask(sc, R22B_REG_ENTXCCK, R22B_BIT(18), 0x1);
+		r22b_write32_mask(sc, R22B_REG_CCK_CHECK, R22B_BIT(7), 0x1);
+		r22b_write32_mask(sc, R22B_REG_RXPSEL, R22B_BIT(28), 0x0);
+		r22b_write32_mask(sc, R22B_REG_RXCCAMSK, 0x0000fc00, 34);
+
+		if (R22B_IS_CH_5G_BAND_1(channel) ||
+		    R22B_IS_CH_5G_BAND_2(channel))
+			r22b_write32_mask(sc, R22B_REG_ACGG2TBL, 0x1f, 0x1);
+		else if (R22B_IS_CH_5G_BAND_3(channel))
+			r22b_write32_mask(sc, R22B_REG_ACGG2TBL, 0x1f, 0x2);
+		else if (R22B_IS_CH_5G_BAND_4(channel))
+			r22b_write32_mask(sc, R22B_REG_ACGG2TBL, 0x1f, 0x3);
+
+		if (R22B_IS_CH_5G_BAND_1(channel))
+			r22b_write32_mask(sc, R22B_REG_CLKTRK, 0x1ffe0000,
+			    0x494);
+		else if (R22B_IS_CH_5G_BAND_2(channel))
+			r22b_write32_mask(sc, R22B_REG_CLKTRK, 0x1ffe0000,
+			    0x453);
+		else if (channel >= 100 && channel <= 116)
+			r22b_write32_mask(sc, R22B_REG_CLKTRK, 0x1ffe0000,
+			    0x452);
+		else if (channel >= 118 && channel <= 177)
+			r22b_write32_mask(sc, R22B_REG_CLKTRK, 0x1ffe0000,
+			    0x412);
+
+		r22b_write32_mask(sc, 0xcbc, 0x300, 0x1);
+	}
+
+	switch (bw) {
+	case R22B_CHANNEL_WIDTH_20:
+	default:
+		val32 = r22b_read32_mask(sc, R22B_REG_ADCCLK, R22B_MASKDWORD);
+		val32 &= 0xffcffc00;
+		val32 |= (R22B_CHANNEL_WIDTH_20);
+		r22b_write32_mask(sc, R22B_REG_ADCCLK, R22B_MASKDWORD, val32);
+
+		r22b_write32_mask(sc, R22B_REG_ADC160, R22B_BIT(30), 0x1);
+		break;
+	case R22B_CHANNEL_WIDTH_40:
+		if (primary_ch_idx == R22B_SC_20_UPPER)
+			r22b_write32_set(sc, R22B_REG_RXSB, R22B_BIT(4));
+		else
+			r22b_write32_clr(sc, R22B_REG_RXSB, R22B_BIT(4));
+
+		val32 = r22b_read32_mask(sc, R22B_REG_ADCCLK, R22B_MASKDWORD);
+		val32 &= 0xff3ff300;
+		val32 |= (((primary_ch_idx & 0xf) << 2) |
+		    R22B_CHANNEL_WIDTH_40);
+		r22b_write32_mask(sc, R22B_REG_ADCCLK, R22B_MASKDWORD, val32);
+
+		r22b_write32_mask(sc, R22B_REG_ADC160, R22B_BIT(30), 0x1);
+		break;
+	case R22B_CHANNEL_WIDTH_80:
+		val32 = r22b_read32_mask(sc, R22B_REG_ADCCLK, R22B_MASKDWORD);
+		val32 &= 0xfcefcf00;
+		val32 |= (((primary_ch_idx & 0xf) << 2) |
+		    R22B_CHANNEL_WIDTH_80);
+		r22b_write32_mask(sc, R22B_REG_ADCCLK, R22B_MASKDWORD, val32);
+
+		r22b_write32_mask(sc, R22B_REG_ADC160, R22B_BIT(30), 0x1);
+
+		if (rfe_option == 2 || rfe_option == 3) {
+			r22b_write32_mask(sc, R22B_REG_L1PKWT, 0x0000f000, 0x6);
+			r22b_write32_mask(sc, R22B_REG_ADC40, R22B_BIT(10),
+			    0x1);
+		}
+		break;
+	}
+}
