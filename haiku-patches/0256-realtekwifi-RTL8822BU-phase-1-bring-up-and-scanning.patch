+
+#ifndef R22B_TX_DESC_H
+#define R22B_TX_DESC_H
+
+/*
+ * Tx descriptor (rtw88 tx.h, struct rtw_tx_desc; 48 bytes on the 8822B,
+ * rtw8822b_hw_spec.tx_pkt_desc_sz).  The first dword is split like
+ * struct rtwn_tx_desc_common so that rtwn_usb_tx_start() can fill in
+ * the packet length and offset; dword 7 holds the USB checksum.
+ */
+struct r22b_tx_desc {
+	uint16_t	pktlen;		/* W0 TXPKTSIZE [15:0] */
+	uint8_t		offset;		/* W0 OFFSET [23:16] */
+	uint8_t		flags0;		/* W0 [31:24] */
+#define R22B_FLAGS0_BMC		0x01	/* W0 BIT(24) */
+#define R22B_FLAGS0_LS		0x04	/* W0 BIT(26) */
+#define R22B_FLAGS0_DISQSELSEQ	0x80	/* W0 BIT(31); NOT an OWN bit */
+
+	uint32_t	txdw1;
+#define R22B_TXDW1_MACID_M	0x000000ff
+#define R22B_TXDW1_MACID_S	0
+#define R22B_TXDW1_QSEL_M	0x00001f00
+#define R22B_TXDW1_QSEL_S	8
+#define R22B_TXDW1_RATE_ID_M	0x001f0000
+#define R22B_TXDW1_RATE_ID_S	16
+#define R22B_TXDW1_SEC_TYPE_M	0x00c00000	/* == RTWN_TXDW1_CIPHER */
+#define R22B_TXDW1_SEC_TYPE_S	22
+#define R22B_TXDW1_PKT_OFFSET_M	0x1f000000
+#define R22B_TXDW1_PKT_OFFSET_S	24
+#define R22B_TXDW1_MORE_DATA	0x20000000
+
+	uint32_t	txdw2;
+#define R22B_TXDW2_AGG_EN	0x00001000
+#define R22B_TXDW2_SPE_RPT	0x00080000
+#define R22B_TXDW2_AMPDU_DEN_M	0x00700000
+#define R22B_TXDW2_AMPDU_DEN_S	20
+#define R22B_TXDW2_BT_NULL	0x00800000
+
+	uint32_t	txdw3;
+#define R22B_TXDW3_HW_SSN_SEL_M	0x000000c0
+#define R22B_TXDW3_HW_SSN_SEL_S	6
+#define R22B_TXDW3_USE_RATE	0x00000100
+#define R22B_TXDW3_DISDATAFB	0x00000400
+#define R22B_TXDW3_USE_RTS	0x00001000
+#define R22B_TXDW3_NAVUSEHDR	0x00008000
+#define R22B_TXDW3_MAX_AGG_NUM_M 0x003e0000
+#define R22B_TXDW3_MAX_AGG_NUM_S 17
+
+	uint32_t	txdw4;
+#define R22B_TXDW4_DATARATE_M	0x0000007f
+#define R22B_TXDW4_DATARATE_S	0
+#define R22B_TXDW4_DATARATE_FB_LIMIT_M	0x00001f00
+#define R22B_TXDW4_DATARATE_FB_LIMIT_S	8
+#define R22B_TXDW4_RTSRATE_M	0x1f000000
+#define R22B_TXDW4_RTSRATE_S	24
+
+	uint32_t	txdw5;
+#define R22B_TXDW5_DATA_SHORT	0x00000010
+#define R22B_TXDW5_DATA_BW_M	0x00000060
+#define R22B_TXDW5_DATA_BW_S	5
+#define R22B_TXDW5_DATA_LDPC	0x00000080
+#define R22B_TXDW5_DATA_STBC_M	0x00000300
+#define R22B_TXDW5_DATA_STBC_S	8
+#define R22B_TXDW5_DATA_RTS_SHORT 0x00001000
+
+	uint32_t	txdw6;
+#define R22B_TXDW6_SW_DEFINE_M	0x00000fff
+#define R22B_TXDW6_SW_DEFINE_S	0
+
+	uint16_t	txdw7;		/* USB checksum, W7 [15:0] */
+	uint8_t		txdw7_rsvd;
+	uint8_t		txdw7_agg_num;	/* W7 DMA_TXAGG_NUM [31:24] */
+
+	uint32_t	txdw8;
+#define R22B_TXDW8_EN_HWSEQ	0x00008000
+
+	uint32_t	txdw9;
+#define R22B_TXDW9_TIM_OFFSET_M	0x0000007f
+#define R22B_TXDW9_TIM_OFFSET_S	0
+#define R22B_TXDW9_TIM_EN	0x00000080
+#define R22B_TXDW9_SW_SEQ_M	0x00fff000
+#define R22B_TXDW9_SW_SEQ_S	12
+
+	uint32_t	txdw10;
+	uint32_t	txdw11;
+} __packed __attribute__((aligned(4)));
