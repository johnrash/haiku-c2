@@ -1919,8 +1919,11 @@ rtwn_init(struct rtwn_softc *sc)
 		goto fail;
 
 #ifndef RTWN_WITHOUT_UCODE
-	/* Load 8051 microcode. */
-	error = rtwn_load_firmware(sc);
+	/* Load 8051 microcode (or use the chip's own download method). */
+	if (sc->sc_fw_download != NULL)
+		error = sc->sc_fw_download(sc);
+	else
+		error = rtwn_load_firmware(sc);
