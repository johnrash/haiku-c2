+#ifndef RTL8822BU_H
+#define RTL8822BU_H
+
+#include <dev/rtwn/rtl8822b/r22b.h>
+
+/*
+ * USB transfer used for the high priority DMA queue (the first bulk-out
+ * endpoint, rtw88 dma_mapping_to_ep(RTW_DMA_MAPPING_HIGH)): H2C packets,
+ * reserved pages (firmware download) and beacons go there.  See
+ * r22bu_setup_ep_map().
+ */
+#define R22BU_HIGH_QID		RTWN_BULK_TX_BK
+
+/* rtw88 usb.c: reads/writes of the "on" section need a dummy write. */
+#define R22BU_REG_ON_SEC_DUMMY	0x04e0
+#define R22BU_REQ_REGS		0x05	/* RTW_USB_CMD_REQ */
+
+struct usb_config;
+struct rtwn_usb_softc;
+
+/*
+ * Function declarations.
+ */
+/* r22bu_attach.c */
+void	r22bu_attach(struct rtwn_usb_softc *);
+
+/* r22bu_init.c */
+int	r22bu_setup_ep_map(struct rtwn_usb_softc *, struct usb_config *,
+	    const uint8_t *);
+int	r22bu_dma_init(struct rtwn_softc *);
+void	r22bu_init_rx_agg(struct rtwn_softc *);
+void	r22bu_phy_cfg(struct rtwn_softc *);
+
+/* r22bu_rx.c */
+int	r22bu_classify_intr(struct rtwn_softc *, void *, int);
+int	r22bu_align_rx(int, int);
+
+/* r22bu_tx.c */
+int	r22bu_write_rsvd_page(struct rtwn_softc *, const uint8_t *, int);
+int	r22bu_write_h2c_pkt(struct rtwn_softc *, const uint8_t *, int);
+void	r22bu_dump_tx_desc(struct rtwn_softc *, const void *);
+
+#endif	/* RTL8822BU_H */
diff --git a/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_attach.c b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/usb/r22bu_attach.c
