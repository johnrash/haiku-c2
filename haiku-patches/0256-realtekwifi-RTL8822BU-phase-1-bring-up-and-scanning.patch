+/* rtw_tx_pkt_info_update_rate(): rate id of management frames */
+static uint8_t
+r22b_mgmt_rate_id(struct rtwn_softc *sc, struct ieee80211_node *ni)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct ieee80211_channel *c;
+
+	c = (ni != NULL && ni->ni_chan != IEEE80211_CHAN_ANYC) ?
+	    ni->ni_chan : ic->ic_curchan;
+	if (c != NULL && c != IEEE80211_CHAN_ANYC &&
+	    IEEE80211_IS_CHAN_5GHZ(c))
+		return (R22B_RATEID_G);
+
+	return (R22B_RATEID_B_20M);
+}
+
+/* Spatial streams usable towards a node (rtw_update_sta_info() tx_num). */
+static int
+r22b_tx_num(struct rtwn_softc *sc, struct ieee80211_node *ni)
+{
+	int i;
+
+	if (sc->ntxchains < 2)
+		return (1);
+
+	if (ni->ni_flags & IEEE80211_NODE_VHT) {
+		/* MCS map of the second spatial stream */
+		if (((ni->ni_vht_mcsinfo.rx_mcs_map >> 2) & 0x3) !=
+		    IEEE80211_VHT_MCS_NOT_SUPPORTED)
+			return (2);
+		return (1);
+	}
+
+	if (ni->ni_flags & IEEE80211_NODE_HT) {
+		for (i = 0; i < ni->ni_htrates.rs_nrates; i++) {
+			if ((ni->ni_htrates.rs_rates[i] & 0x7f) >= 8)
+				return (2);
+		}
+	}
+
+	return (1);
+}
+
+/*
+ * get_rate_id() for a data frame to "ni" (rtw_update_sta_info() derives
+ * the wireless set from the band and the station's capabilities).
+ */
+static uint8_t
+r22b_data_rate_id(struct rtwn_softc *sc, struct ieee80211_node *ni)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct ieee80211_channel *c;
+	int is5ghz, tx_num;
+
+	c = (ni->ni_chan != IEEE80211_CHAN_ANYC) ? ni->ni_chan :
+	    ic->ic_curchan;
+	is5ghz = (c != NULL && c != IEEE80211_CHAN_ANYC &&
+	    IEEE80211_IS_CHAN_5GHZ(c));
+	tx_num = r22b_tx_num(sc, ni);
+
+	if (ni->ni_flags & IEEE80211_NODE_VHT) {
+		if (is5ghz)	/* WIRELESS_OFDM | WIRELESS_VHT */
+			return (tx_num == 1 ? R22B_RATEID_ARFR1_AC_1SS :
+			    R22B_RATEID_ARFR0_AC_2SS);
+		/* WIRELESS_CCK | WIRELESS_OFDM | WIRELESS_VHT, < 80 MHz */
+		return (tx_num == 1 ? R22B_RATEID_ARFR2_AC_2G_1SS :
+		    R22B_RATEID_ARFR3_AC_2G_2SS);
+	}
+
+	if (ni->ni_flags & IEEE80211_NODE_HT) {
+		if (is5ghz)	/* WIRELESS_OFDM | WIRELESS_HT */
+			return (tx_num == 1 ? R22B_RATEID_GN_N1SS :
+			    R22B_RATEID_GN_N2SS);
+		/* WIRELESS_CCK | WIRELESS_OFDM | WIRELESS_HT */
+		if (c != NULL && c != IEEE80211_CHAN_ANYC &&
+		    IEEE80211_IS_CHAN_HT40(c))
+			return (tx_num == 1 ? R22B_RATEID_BGN_40M_1SS :
+			    R22B_RATEID_BGN_40M_2SS);
+		return (tx_num == 1 ? R22B_RATEID_BGN_20M_1SS :
+		    R22B_RATEID_BGN_20M_2SS);
+	}
+
+	/* WIRELESS_OFDM or WIRELESS_CCK | WIRELESS_OFDM */
+	return (is5ghz ? R22B_RATEID_G : R22B_RATEID_BG);
+}
+
+/* Data bandwidth towards a node (r12a_tx_set_vht_bw/_ht40 equivalent). */
+static void
+r22b_tx_set_bw(struct rtwn_softc *sc, struct r22b_tx_desc *txd,
+    struct ieee80211_node *ni, uint8_t ridx)
+{
+	if (RTWN_RATE_IS_VHT(ridx)) {
+		if (ieee80211_vht_check_tx_bw(ni, NET80211_STA_RX_BW_80))
+			txd->txdw5 |= htole32(SM(R22B_TXDW5_DATA_BW,
+			    R22B_TXDW5_DATA_BW80));
+		else if (ieee80211_vht_check_tx_bw(ni, NET80211_STA_RX_BW_40))
+			txd->txdw5 |= htole32(SM(R22B_TXDW5_DATA_BW,
+			    R22B_TXDW5_DATA_BW40));
+	} else if (RTWN_RATE_IS_HT(ridx)) {
+		if (ieee80211_ht_check_tx_ht40(ni))
+			txd->txdw5 |= htole32(SM(R22B_TXDW5_DATA_BW,
+			    R22B_TXDW5_DATA_BW40));
+	}
+}
+
+/* Short GI for HT rates (same policy as r12a_tx_set_sgi()). */
+static void
+r22b_tx_set_sgi(struct rtwn_softc *sc, struct r22b_tx_desc *txd,
+    struct ieee80211_node *ni)
+{
+	if (ieee80211_ht_check_tx_ht40(ni)) {
+		if (ieee80211_ht_check_tx_shortgi_40(ni))
+			txd->txdw5 |= htole32(R22B_TXDW5_DATA_SHORT);
+	} else if (ieee80211_ht_check_tx_ht(ni)) {
+		if (ieee80211_ht_check_tx_shortgi_20(ni))
+			txd->txdw5 |= htole32(R22B_TXDW5_DATA_SHORT);
+	}
+}
+
+/* get_tx_ampdu_factor() equivalent from the BA window. */
+static int
+r22b_tx_agg_window(const struct ieee80211_node *ni, int tid)
+{
+	const struct ieee80211_tx_ampdu *tap = &ni->ni_tx_ampdu[tid];
+	int wnd;
+
+	wnd = tap->txa_wnd / 2;
+	if (wnd == 0)
+		wnd = 1;
+	else if (wnd > 0x1f)
+		wnd = 0x1f;
+
+	return (wnd);
+}
+
+/* Hardware sequence numbering (rtw_tx_mgmt_pkt_info_update()). */
+static void
+r22b_tx_set_hwseq(struct r22b_tx_desc *txd, int id)
+{
+	txd->flags0 |= R22B_FLAGS0_DISQSELSEQ;
+	txd->txdw8 |= htole32(R22B_TXDW8_EN_HWSEQ);
+	txd->txdw3 |= htole32(SM(R22B_TXDW3_HW_SSN_SEL, id));
+}
+
+void
+r22b_fill_tx_desc(struct rtwn_softc *sc, struct ieee80211_node *ni,
+    struct mbuf *m, void *buf, uint8_t ridx, bool force_rate, int maxretry)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct ieee80211vap *vap = ni->ni_vap;
+	struct rtwn_vap *uvp = RTWN_VAP(vap);
+	struct ieee80211_frame *wh;
+	struct r22b_tx_desc *txd;
+	uint16_t seqno;
+	uint8_t type, tid, qsel, rate_id;
+	int hasqos, ismcast, macid;
+
+	wh = mtod(m, struct ieee80211_frame *);
+	type = wh->i_fc[0] & IEEE80211_FC0_TYPE_MASK;
+	hasqos = IEEE80211_QOS_HAS_SEQ(wh);
+	ismcast = IEEE80211_IS_MULTICAST(wh->i_addr1);
+
+	if (hasqos)
+		tid = ((const struct ieee80211_qosframe *)wh)->i_qos[0] &
+		    IEEE80211_QOS_TID;
+	else
+		tid = 0;
+
+	txd = (struct r22b_tx_desc *)buf;
+	txd->flags0 |= R22B_FLAGS0_LS;
+	if (ismcast)
+		txd->flags0 |= R22B_FLAGS0_BMC;
+
+	if (!ismcast)
+		macid = RTWN_NODE(ni)->id;
+	else
+		macid = RTWN_MACID_BC;
+
+	if (type == IEEE80211_FC0_TYPE_DATA) {
+		/* rtw_tx_data_pkt_info_update() */
+		qsel = R22B_TXDW1_QSEL_TID(tid % R22B_MAX_TID);
+
+		if (ismcast)
+			rate_id = R22B_RATEID_BG;	/* rtw88: "default" */
+		else {
+			rate_id = r22b_data_rate_id(sc, ni);
+
+			if (m->m_flags & M_AMPDU_MPDU) {
+				txd->txdw2 |= htole32(R22B_TXDW2_AGG_EN);
+				txd->txdw2 |= htole32(SM(R22B_TXDW2_AMPDU_DEN,
+				    ieee80211_ht_get_node_ampdu_density(ni)));
+				txd->txdw3 |= htole32(SM(R22B_TXDW3_MAX_AGG_NUM,
+				    r22b_tx_agg_window(ni, tid)));
+			}
+
+			r22b_tx_set_bw(sc, txd, ni, ridx);
+			if (RTWN_RATE_IS_HT(ridx))
+				r22b_tx_set_sgi(sc, txd, ni);
+
+			if (RTWN_RATE_IS_CCK(ridx) && ridx != RTWN_RIDX_CCK1 &&
+			    (ic->ic_flags & IEEE80211_F_SHPREAMBLE))
+				txd->txdw5 |= htole32(R22B_TXDW5_DATA_SHORT);
+
+			/*
+			 * RTS/CTS: rtw88 uses RTS at 24M with short
+			 * preamble above the RTS threshold.
+			 * TODO: CTS-to-self and the protection mode.
+			 */
+			if (m->m_pkthdr.len + IEEE80211_CRC_LEN >
+			    vap->iv_rtsthreshold &&
+			    vap->iv_rtsthreshold != IEEE80211_RTS_MAX) {
+				txd->txdw3 |= htole32(R22B_TXDW3_USE_RTS);
+				txd->txdw4 |= htole32(SM(R22B_TXDW4_RTSRATE,
+				    RTWN_RIDX_OFDM24));
+				txd->txdw5 |= htole32(
+				    R22B_TXDW5_DATA_RTS_SHORT);
+			}
+		}
+
+		/* Software sequence number (rtw88: from the header). */
+		if (hasqos && (m->m_flags & M_AMPDU_MPDU)) {
+			seqno = ni->ni_txseqs[tid];
+			ni->ni_txseqs[tid]++;
+		} else {
+			seqno = le16dec(wh->i_seq) >> IEEE80211_SEQ_SEQ_SHIFT;
+		}
+		txd->txdw9 |= htole32(SM(R22B_TXDW9_SW_SEQ,
+		    seqno % IEEE80211_SEQ_RANGE));
+
+		/*
+		 * TODO (phase 2): ask for a tx report (SPE_RPT + SW_DEFINE)
+		 * once C2H tx reports are handled.
+		 */
+	} else {
+		/* rtw_tx_mgmt_pkt_info_update(); control frames too */
+		qsel = R22B_TXDW1_QSEL_MGMT;
+		rate_id = r22b_mgmt_rate_id(sc, ni);
+		force_rate = true;
+		r22b_tx_set_hwseq(txd, uvp->id);
+	}
+
+	txd->txdw1 |= htole32(SM(R22B_TXDW1_MACID, macid));
+	txd->txdw1 |= htole32(SM(R22B_TXDW1_QSEL, qsel));
+	txd->txdw1 |= htole32(SM(R22B_TXDW1_RATE_ID, rate_id));
+
+	txd->txdw4 |= htole32(SM(R22B_TXDW4_DATARATE, ridx));
+
+	/* use_rate / dis_rate_fallback */
+	if (force_rate)
+		txd->txdw3 |= htole32(R22B_TXDW3_USE_RATE |
+		    R22B_TXDW3_DISDATAFB);
+	else if (sc->sc_ratectl != RTWN_RATECTL_FW)
+		txd->txdw3 |= htole32(R22B_TXDW3_USE_RATE);
+}
+
+void
+r22b_fill_tx_desc_raw(struct rtwn_softc *sc, struct ieee80211_node *ni,
+    struct mbuf *m, void *buf, const struct ieee80211_bpf_params *params)
+{
+	struct ieee80211vap *vap = ni->ni_vap;
+	struct rtwn_vap *uvp = RTWN_VAP(vap);
+	struct ieee80211_frame *wh;
+	struct r22b_tx_desc *txd;
+	uint8_t ridx;
+	int ismcast;
+
+	wh = mtod(m, struct ieee80211_frame *);
+	ismcast = IEEE80211_IS_MULTICAST(wh->i_addr1);
+	ridx = rate2ridx(params->ibp_rate0);
+
+	txd = (struct r22b_tx_desc *)buf;
+	txd->flags0 |= R22B_FLAGS0_LS;
+	if (ismcast)
+		txd->flags0 |= R22B_FLAGS0_BMC;
+
+	/* TODO: IEEE80211_BPF_CTS (CTS-to-self) */
+	if (params->ibp_flags & IEEE80211_BPF_RTS) {
+		txd->txdw3 |= htole32(R22B_TXDW3_USE_RTS);
+		txd->txdw4 |= htole32(SM(R22B_TXDW4_RTSRATE,
+		    RTWN_RIDX_OFDM24));
+		txd->txdw5 |= htole32(R22B_TXDW5_DATA_RTS_SHORT);
+	}
+
+	txd->txdw1 |= htole32(SM(R22B_TXDW1_MACID, RTWN_MACID_BC));
+	txd->txdw1 |= htole32(SM(R22B_TXDW1_QSEL, R22B_TXDW1_QSEL_MGMT));
+	txd->txdw1 |= htole32(SM(R22B_TXDW1_RATE_ID,
+	    r22b_mgmt_rate_id(sc, ni)));
+
+	/* Set TX rate index. */
+	txd->txdw4 |= htole32(SM(R22B_TXDW4_DATARATE, ridx));
+	txd->txdw3 |= htole32(R22B_TXDW3_USE_RATE | R22B_TXDW3_DISDATAFB);
+
+	if (!IEEE80211_QOS_HAS_SEQ(wh))
+		r22b_tx_set_hwseq(txd, uvp->id);
+	else {
+		txd->txdw9 |= htole32(SM(R22B_TXDW9_SW_SEQ,
+		    M_SEQNO_GET(m) % IEEE80211_SEQ_RANGE));
+	}
+}
+
+/*
+ * (QoS) Null data frames for the firmware's reserved pages
+ * (rtw_tx_rsvd_page_pkt_info_update() for RSVD_NULL / RSVD_QOS_NULL).
+ * Only used with power save, which is not enabled yet.
+ */
+void
+r22b_fill_tx_desc_null(struct rtwn_softc *sc, void *buf, int is11b, int qos,
+    int id)
+{
+	struct r22b_tx_desc *txd = (struct r22b_tx_desc *)buf;
+
+	txd->flags0 = R22B_FLAGS0_LS;
+	txd->txdw1 = htole32(SM(R22B_TXDW1_QSEL, R22B_TXDW1_QSEL_MGMT));
+	txd->txdw3 = htole32(R22B_TXDW3_USE_RATE | R22B_TXDW3_DISDATAFB);
+	if (is11b) {
+		txd->txdw1 |= htole32(SM(R22B_TXDW1_RATE_ID,
+		    R22B_RATEID_B_20M));
+		txd->txdw4 = htole32(SM(R22B_TXDW4_DATARATE,
+		    RTWN_RIDX_CCK1));
+	} else {
+		txd->txdw1 |= htole32(SM(R22B_TXDW1_RATE_ID, R22B_RATEID_G));
+		txd->txdw4 = htole32(SM(R22B_TXDW4_DATARATE,
+		    RTWN_RIDX_OFDM6));
+	}
+
+	r22b_tx_set_hwseq(txd, id);
+	if (qos)
+		txd->txdw2 |= htole32(R22B_TXDW2_BT_NULL);
+}
+
+uint8_t
+r22b_tx_radiotap_flags(const void *buf)
+{
+	const struct r22b_tx_desc *txd = buf;
+	uint8_t flags, rate;
+
+	if (!(txd->txdw5 & htole32(R22B_TXDW5_DATA_SHORT)))
+		return (0);
+
+	rate = MS(le32toh(txd->txdw4), R22B_TXDW4_DATARATE);
+	if (RTWN_RATE_IS_CCK(rate))
+		flags = IEEE80211_RADIOTAP_F_SHORTPRE;
+	else
+		flags = IEEE80211_RADIOTAP_F_SHORTGI;
+	return (flags);
+}
+
+/*
+ * Beacon descriptor template (rtw_tx_rsvd_page_pkt_info_update() for
+ * RSVD_BEACON).  Beaconing (AP/IBSS) is not supported yet: on the 8822B
+ * the beacon has to be downloaded as a reserved page, see
+ * docs/rtl8822b-port.md.
+ */
+void
+r22b_beacon_init(struct rtwn_softc *sc, void *buf, int id)
+{
+	struct r22b_tx_desc *txd = (struct r22b_tx_desc *)buf;
+
+	txd->flags0 = R22B_FLAGS0_LS | R22B_FLAGS0_BMC;
+	txd->txdw1 = htole32(SM(R22B_TXDW1_QSEL, R22B_TXDW1_QSEL_BEACON));
+	txd->txdw1 |= htole32(SM(R22B_TXDW1_MACID, RTWN_MACID_BC));
+	txd->txdw1 |= htole32(SM(R22B_TXDW1_RATE_ID, R22B_RATEID_B_20M));
+	txd->txdw3 = htole32(R22B_TXDW3_USE_RATE | R22B_TXDW3_DISDATAFB);
+	txd->txdw4 = htole32(SM(R22B_TXDW4_DATARATE, RTWN_RIDX_CCK1));
+	r22b_tx_set_hwseq(txd, id);
+}
+
+void
+r22b_beacon_set_rate(void *buf, int is5ghz)
+{
+	struct r22b_tx_desc *txd = (struct r22b_tx_desc *)buf;
+
+	txd->txdw1 &= ~htole32(R22B_TXDW1_RATE_ID_M);
+	txd->txdw4 &= ~htole32(R22B_TXDW4_DATARATE_M);
+	if (is5ghz) {
+		txd->txdw1 |= htole32(SM(R22B_TXDW1_RATE_ID, R22B_RATEID_G));
+		txd->txdw4 |= htole32(SM(R22B_TXDW4_DATARATE,
+		    RTWN_RIDX_OFDM6));
+	} else {
+		txd->txdw1 |= htole32(SM(R22B_TXDW1_RATE_ID,
+		    R22B_RATEID_B_20M));
+		txd->txdw4 |= htole32(SM(R22B_TXDW4_DATARATE,
+		    RTWN_RIDX_CCK1));
+	}
+}
