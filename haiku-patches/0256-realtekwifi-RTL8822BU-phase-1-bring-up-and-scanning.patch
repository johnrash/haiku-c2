+
+/*
+ * RTL8822B receive path: Rx descriptor and PHY status parsing, C2H
+ * (card-to-host) firmware events.
+ *
+ * Sources (rtw88 v7.0): rx.h / rx.c (struct rtw_rx_desc,
+ * rtw_rx_query_rx_desc, rtw_rx_fill_rx_status), rtw8822b.h / rtw8822b.c
+ * (GET_PHY_STAT_*, query_phy_status, query_phy_status_page0,
+ * query_phy_status_page1), fw.c / fw.h (rtw_fw_c2h_cmd_rx_irqsafe,
+ * struct rtw_c2h_cmd, enum rtw_c2h_cmd_id).
+ */
+
+#include <sys/cdefs.h>
+#include "opt_wlan.h"
+
+#include <sys/param.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/mbuf.h>
+#include <sys/kernel.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/taskqueue.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/linker.h>
+
+#include <net/if.h>
+#include <net/ethernet.h>
+#include <net/if_media.h>
+
+#include <net80211/ieee80211_var.h>
+#include <net80211/ieee80211_radiotap.h>
+
+#include <dev/rtwn/if_rtwnreg.h>
+#include <dev/rtwn/if_rtwnvar.h>
+
+#include <dev/rtwn/if_rtwn_debug.h>
+#include <dev/rtwn/if_rtwn_ridx.h>
+
+#include <dev/rtwn/rtl8822b/r22b.h>
+#include <dev/rtwn/rtl8822b/r22b_fw_cmd.h>
+#include <dev/rtwn/rtl8822b/r22b_rx_desc.h>
+#include <dev/rtwn/rtl8822b/r22b_var.h>
+
+/*
+ * C2H event in an Rx buffer (rtw_fw_c2h_cmd_rx_irqsafe()): the payload
+ * (struct rtw_c2h_cmd: id, seq, payload[]) starts after the Rx
+ * descriptor, the driver info and the shift.
+ *
+ * TODO (phase 2): C2H_RA_RPT (firmware rate adaptation report),
+ * C2H_CCX_TX_RPT / C2H_HALMAC sub-id C2H_CCX_RPT (tx status, needed for
+ * net80211 rate control and EAPOL status), C2H_BT_INFO (coexistence).
+ */
+void
+r22b_handle_c2h_report(struct rtwn_softc *sc, uint8_t *buf, int len)
+{
+	const struct r22b_rx_stat *stat = (const struct r22b_rx_stat *)buf;
+	uint32_t rxdw0;
+	int infosz, shift, pktlen, off;
+	uint8_t id, seq;
+
+	if (len < (int)sizeof(*stat)) {
+		device_printf(sc->sc_dev, "C2H report too short (len %d)\n",
+		    len);
+		return;
+	}
+
+	rxdw0 = le32toh(stat->rxdw0);
+	pktlen = MS(rxdw0, RTWN_RXDW0_PKTLEN);
+	infosz = MS(rxdw0, RTWN_RXDW0_INFOSZ) * 8;
+	shift = MS(rxdw0, RTWN_RXDW0_SHIFT);
+	off = sizeof(*stat) + infosz + shift;
+
+	if (pktlen < 2 || len < off + 2) {
+		device_printf(sc->sc_dev,
+		    "C2H report too short (len %d, pktlen %d)\n", len, pktlen);
+		return;
+	}
+
+	id = buf[off];
+	seq = buf[off + 1];
+
+	switch (id) {
+	case R22B_C2H_CCX_TX_RPT:
+	case R22B_C2H_BT_INFO:
+	case R22B_C2H_RA_RPT:
+	case R22B_C2H_HW_FEATURE_REPORT:
+	case R22B_C2H_HALMAC:
+	default:
+		RTWN_DPRINTF(sc, RTWN_DEBUG_INTR,
+		    "%s: C2H id 0x%02x seq %u len %d ignored\n", __func__, id,
+		    seq, pktlen);
+		break;
+	}
+}
+
+/*
+ * sc_check_frame: called for every packet of an Rx transfer.  C2H
+ * events can be aggregated with frames (r22bu_classify_intr() only
+ * routes transfers holding nothing but one C2H event to
+ * r22b_handle_c2h_report()); hand those over here and drop them.
+ */
+int
+r22b_check_frame(struct rtwn_softc *sc, struct mbuf *m)
+{
+	const struct r22b_rx_stat *stat;
+	uint32_t rxdw0;
+	int totlen;
+
+	stat = mtod(m, const struct r22b_rx_stat *);
+	if (!(le32toh(stat->rxdw2) & R22B_RXDW2_C2H))
+		return (0);
+
+	rxdw0 = le32toh(stat->rxdw0);
+	totlen = sizeof(*stat) + MS(rxdw0, RTWN_RXDW0_INFOSZ) * 8 +
+	    MS(rxdw0, RTWN_RXDW0_SHIFT) + MS(rxdw0, RTWN_RXDW0_PKTLEN);
+	if (m->m_next == NULL && m->m_len >= totlen)
+		r22b_handle_c2h_report(sc, mtod(m, uint8_t *), m->m_len);
+
+	return (EAGAIN);
+}
+
+uint8_t
+r22b_rx_radiotap_flags(const void *buf)
+{
+	/* rtw88 does not parse the short preamble / GI bits. */
+	return (0);
+}
+
+/* query_phy_status_page0(): CCK, path A only. */
+static int8_t
+r22b_phy_stat_power_p0(const uint8_t *physt)
+{
+	return ((int)R22B_PHY_STAT_P0_PWDB(physt) - 110);
+}
+
+/* query_phy_status_page1(): signal_power = max(path A, path B, -120). */
+static int8_t
+r22b_phy_stat_power_p1(const uint8_t *physt)
+{
+	int power_a, power_b, signal;
+
+	power_a = (int)R22B_PHY_STAT_P1_PWDB_A(physt) - 110;
+	power_b = (int)R22B_PHY_STAT_P1_PWDB_B(physt) - 110;
+
+	signal = MAX(power_a, power_b);
+	signal = MAX(signal, -120);
+
+	return (signal);
+}
+
+static int8_t
+r22b_get_rssi(const uint8_t *physt)
+{
+	switch (R22B_PHY_STAT_PAGE(physt)) {
+	case 0:
+		return (r22b_phy_stat_power_p0(physt));
+	case 1:
+		return (r22b_phy_stat_power_p1(physt));
+	default:
+		/* rtw88: "unused phy status page" */
+		return (-120);
+	}
+}
+
+int8_t
+r22b_get_rssi_cck(struct rtwn_softc *sc, void *physt)
+{
+	return (r22b_get_rssi(physt));
+}
+
+int8_t
+r22b_get_rssi_ofdm(struct rtwn_softc *sc, void *physt)
+{
+	return (r22b_get_rssi(physt));
+}
+
+/*
+ * Channel width of a received frame (query_phy_status_page1(): from the
+ * Rx sub-channel of the PHY status, or the descriptor without one).
+ */
+static int
+r22b_rx_bw(const struct r22b_rx_stat *stat, const uint8_t *physt,
+    uint8_t rate)
+{
+	uint32_t rxdw0 = le32toh(stat->rxdw0);
+	uint8_t rxsc;
+
+	if (!(rxdw0 & RTWN_RXDW0_PHYST) || MS(rxdw0, RTWN_RXDW0_INFOSZ) == 0)
+		return (MS(le32toh(stat->rxdw4), R22B_RXDW4_BW));
+
+	if (R22B_PHY_STAT_PAGE(physt) != 1)
+		return (R22B_RXDW4_BW20);
+
+	if (rate > RTWN_RIDX_CCK11 && rate < RTWN_RIDX_HT_MCS_SHIFT)
+		rxsc = R22B_PHY_STAT_P1_L_RXSC(physt);
+	else
+		rxsc = R22B_PHY_STAT_P1_HT_RXSC(physt);
+
+	if (rxsc >= 1 && rxsc <= 8)
+		return (R22B_RXDW4_BW20);
+	else if (rxsc >= 9 && rxsc <= 12)
+		return (R22B_RXDW4_BW40);
+	else if (rxsc >= 13)
+		return (R22B_RXDW4_BW80);
+	else
+		return (R22B_PHY_STAT_P1_RF_MODE(physt));
+}
+
+void
+r22b_get_rx_stats(struct rtwn_softc *sc, struct ieee80211_rx_stats *rxs,
+    const void *desc, const void *physt_ptr)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	const struct r22b_rx_stat *stat = desc;
+	const uint8_t *physt = physt_ptr;
+	uint8_t rate;
+	int is5ghz;
+
+	rate = MS(le32toh(stat->rxdw3), R22B_RXDW3_RATE);
+
+	switch (r22b_rx_bw(stat, physt, rate)) {
+	case R22B_RXDW4_BW20:
+		rxs->c_width = IEEE80211_RX_FW_20MHZ;
+		break;
+	case R22B_RXDW4_BW40:
+		rxs->c_width = IEEE80211_RX_FW_40MHZ;
+		break;
+	case R22B_RXDW4_BW80:
+		rxs->c_width = IEEE80211_RX_FW_80MHZ;
+		break;
+	default:
+		break;
+	}
+
+	/* rtw_rx_fill_rx_status(): the band of the current channel. */
+	is5ghz = (ic->ic_curchan != NULL &&
+	    ic->ic_curchan != IEEE80211_CHAN_ANYC &&
+	    IEEE80211_IS_CHAN_5GHZ(ic->ic_curchan));
+
+	if (RTWN_RATE_IS_CCK(rate))
+		rxs->c_phytype = IEEE80211_RX_FP_11B;
+	else if (RTWN_RATE_IS_OFDM(rate)) {
+		rxs->c_phytype = is5ghz ? IEEE80211_RX_FP_11A :
+		    IEEE80211_RX_FP_11G;
+	} else if (RTWN_RATE_IS_HT(rate)) {
+		rxs->c_phytype = is5ghz ? IEEE80211_RX_FP_11NA :
+		    IEEE80211_RX_FP_11NG;
+	} else if (RTWN_RATE_IS_VHT(rate)) {
+		/* TODO: there's no FP_VHT_5GHZ yet */
+		rxs->c_phytype = IEEE80211_RX_FP_11NA;
+	}
+
+	/* Map HW rate index to 802.11 rate. */
+	if (RTWN_RATE_IS_CCK(rate) || RTWN_RATE_IS_OFDM(rate)) {
+		rxs->c_rate = ridx2rate[rate];
+		if (RTWN_RATE_IS_CCK(rate))
+			rxs->c_pktflags |= IEEE80211_RX_F_CCK;
+		else
+			rxs->c_pktflags |= IEEE80211_RX_F_OFDM;
+	} else if (RTWN_RATE_IS_HT(rate)) {	/* MCS0~15. */
+		rxs->c_rate =
+		    IEEE80211_RATE_MCS | RTWN_RIDX_TO_MCS(rate);
+		rxs->c_pktflags |= IEEE80211_RX_F_HT;
+	} else if (RTWN_RATE_IS_VHT(rate)) {
+		/* Same representation as r12a_get_rx_stats(). */
+		rxs->c_vhtnss = (rate - RTWN_RIDX_VHT_MCS_SHIFT) / 10;
+		rxs->c_rate = (rate - RTWN_RIDX_VHT_MCS_SHIFT) % 10;
+		rxs->c_pktflags |= IEEE80211_RX_F_VHT;
+	}
+
+	/*
+	 * TODO: A-MPDU, short GI, LDPC and STBC flags.  rtw88 does not read
+	 * them from the 8822B Rx descriptor; IEEE80211_RX_F_AMPDU would also
+	 * let rtwn_rx_common() keep the PHY status for the following MPDUs.
+	 */
+}
