+/* enum rtw_trx_desc_rate (the subset used here) */
+#define DESC_RATE1M		0x00
+#define DESC_RATE11M		0x03
+#define DESC_RATE6M		0x04
+#define DESC_RATE54M		0x0b
+#define DESC_RATEMCS0		0x0c
+#define DESC_RATEMCS7		0x13
+#define DESC_RATEMCS8		0x14
+#define DESC_RATEMCS15		0x1b
+#define DESC_RATEMCS16		0x1c
+#define DESC_RATEMCS24		0x24
+#define DESC_RATEMCS31		0x2b
+#define DESC_RATEVHT1SS_MCS0	0x2c
+#define DESC_RATEVHT1SS_MCS9	0x35
+#define DESC_RATEVHT2SS_MCS0	0x36
+#define DESC_RATEVHT2SS_MCS9	0x3f
+#define DESC_RATEVHT3SS_MCS0	0x40
+#define DESC_RATEVHT4SS_MCS0	0x4a
+#define DESC_RATEVHT4SS_MCS9	0x53
+
+/* Default for an unprogrammed (0xff) efuse base index. */
+#define R22B_DEF_TXPWR_IDX	0x20
+
+/* rtw_rate_section[] / rtw_rate_size[]; every section is contiguous. */
+static const struct {
+	uint8_t		first;
+	uint8_t		size;
+} r22b_rate_section[R22B_RS_NUM] = {
+	[R22B_RS_CCK]		= { DESC_RATE1M, 4 },
+	[R22B_RS_OFDM]		= { DESC_RATE6M, 8 },
+	[R22B_RS_HT_1S]		= { DESC_RATEMCS0, 8 },
+	[R22B_RS_HT_2S]		= { DESC_RATEMCS8, 8 },
+	[R22B_RS_VHT_1S]	= { DESC_RATEVHT1SS_MCS0, 10 },
+	[R22B_RS_VHT_2S]	= { DESC_RATEVHT2SS_MCS0, 10 },
+};
+
+#define PHY_BAND_2G	0
+#define PHY_BAND_5G	1
+
+/* rtw_channel_idx_5g[] */
+static const uint8_t r22b_channel_idx_5g[R22B_MAX_CHANNEL_NUM_5G] = {
+	36,  38,  40,  42,  44,  46,  48, /* Band 1 */
+	52,  54,  56,  58,  60,  62,  64, /* Band 2 */
+	100, 102, 104, 106, 108, 110, 112, /* Band 3 */
+	116, 118, 120, 122, 124, 126, 128, /* Band 3 */
+	132, 134, 136, 138, 140, 142, 144, /* Band 3 */
+	149, 151, 153, 155, 157, 159, 161, /* Band 4 */
+	165, 167, 169, 171, 173, 175, 177}; /* Band 4 */
+
+/* rtw_channel_to_idx() */
+static int
+r22b_channel_to_idx(int band, uint8_t channel)
+{
+	int ch_idx, n_channel;
+
+	if (band == PHY_BAND_2G) {
+		ch_idx = channel - 1;
+		n_channel = R22B_MAX_CHANNEL_NUM_2G;
+	} else if (band == PHY_BAND_5G) {
+		n_channel = R22B_MAX_CHANNEL_NUM_5G;
+		for (ch_idx = 0; ch_idx < n_channel; ch_idx++)
+			if (r22b_channel_idx_5g[ch_idx] == channel)
+				break;
+	} else
+		return (-1);
+
+	if (ch_idx < 0 || ch_idx >= n_channel)
+		return (-1);
+
+	return (ch_idx);
+}
+
+/* rtw_phy_rate_to_rate_section(); R22B_RS_NUM if invalid */
+static int
+r22b_rate_to_rate_section(uint8_t rate)
+{
+	if (rate <= DESC_RATE11M)
+		return (R22B_RS_CCK);
+	else if (rate >= DESC_RATE6M && rate <= DESC_RATE54M)
+		return (R22B_RS_OFDM);
+	else if (rate >= DESC_RATEMCS0 && rate <= DESC_RATEMCS7)
+		return (R22B_RS_HT_1S);
+	else if (rate >= DESC_RATEMCS8 && rate <= DESC_RATEMCS15)
+		return (R22B_RS_HT_2S);
+	else if (rate >= DESC_RATEVHT1SS_MCS0 && rate <= DESC_RATEVHT1SS_MCS9)
+		return (R22B_RS_VHT_1S);
+	else if (rate >= DESC_RATEVHT2SS_MCS0 && rate <= DESC_RATEVHT2SS_MCS9)
+		return (R22B_RS_VHT_2S);
+	else
+		return (R22B_RS_NUM);
+}
+
+/* bcd2bin() of byte i (tbl_to_dec_pwr_by_rate(), is_pwr_by_rate_dec) */
+static int8_t
+r22b_bcd_to_dec_pwr_by_rate(uint32_t val, int i)
+{
+	uint8_t b = (val >> (i * 8)) & 0xff;
+
+	return ((b & 0x0f) + (b >> 4) * 10);
+}
+
+/*
+ * rtw_phy_get_rate_values_of_txpwr_by_rate() for the TXAGC register
+ * addresses used by the 8822B tables (0xc20-0xc4c, 0xe20-0xe4c): each
+ * address covers four consecutive hardware rates.
+ */
+static int
+r22b_get_rate_values_of_txpwr_by_rate(uint32_t addr, uint32_t val,
+    uint8_t *rate, int8_t *pwr_by_rate)
+{
+	uint32_t off = addr & 0xff;
+	uint8_t first;
+	int i;
+
+	if ((addr & ~0xffU) != 0xc00 && (addr & ~0xffU) != 0xe00)
+		return (0);
+
+	if (off >= 0x20 && off <= 0x38 && (off & 3) == 0)
+		first = off - 0x20;			/* CCK .. MCS15 */
+	else if (off >= 0x3c && off <= 0x4c && (off & 3) == 0)
+		first = DESC_RATEVHT1SS_MCS0 + (off - 0x3c); /* VHT */
+	else
+		return (0);
+
+	for (i = 0; i < 4; i++) {
+		rate[i] = first + i;
+		pwr_by_rate[i] = r22b_bcd_to_dec_pwr_by_rate(val, i);
+	}
+
+	return (4);
+}
+
+/* rtw_parse_tbl_bb_pg() / rtw_phy_store_tx_power_by_rate() */
+static void
+r22b_parse_tbl_bb_pg(struct rtwn_softc *sc, const struct r22b_table *tbl)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const struct r22b_phy_pg_cfg_pair *p = tbl->data;
+	const struct r22b_phy_pg_cfg_pair *end = p + tbl->size;
+	uint8_t rates[4];
+	int8_t pwr_by_rate[4];
+	int i, rate_num;
+
+	for (; p < end; p++) {
+		/* rtw88 sleeps 50 ms on these; none are in the 8822B tables */
+		if (p->addr == 0xfe || p->addr == 0xffe)
+			continue;
+
+		rate_num = r22b_get_rate_values_of_txpwr_by_rate(p->addr,
+		    p->data, rates, pwr_by_rate);
+		if (rate_num == 0) {
+			device_printf(sc->sc_dev,
+			    "invalid tx power index addr 0x%08x\n", p->addr);
+			continue;
+		}
+
+		if (p->rf_path >= R22B_RF_PATH_MAX ||
+		    (p->band != PHY_BAND_2G && p->band != PHY_BAND_5G)) {
+			device_printf(sc->sc_dev, "%s: wrong entry (band %u, "
+			    "path %u)\n", __func__, p->band, p->rf_path);
+			continue;
+		}
+
+		for (i = 0; i < rate_num; i++) {
+			if (p->band == PHY_BAND_2G)
+				rs->pwr_by_rate_2g[p->rf_path][rates[i]] =
+				    pwr_by_rate[i];
+			else
+				rs->pwr_by_rate_5g[p->rf_path][rates[i]] =
+				    pwr_by_rate[i];
+		}
+	}
+}
+
+/* rtw_phy_set_tx_power_limit(), keeping only the worldwide minimum */
+static void
+r22b_set_tx_power_limit(struct rtwn_softc *sc, uint8_t band, uint8_t bw,
+    uint8_t rs_idx, uint8_t ch, int8_t pwr_limit)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	int ch_idx;
+
+	if (pwr_limit > R22B_MAX_POWER_INDEX)
+		pwr_limit = R22B_MAX_POWER_INDEX;
+	if (pwr_limit < -R22B_MAX_POWER_INDEX)
+		pwr_limit = -R22B_MAX_POWER_INDEX;
+	ch_idx = r22b_channel_to_idx(band, ch);
+
+	if (bw >= R22B_CHANNEL_WIDTH_MAX || rs_idx >= R22B_RS_NUM ||
+	    ch_idx < 0) {
+		device_printf(sc->sc_dev, "wrong txpwr_lmt band=%u bw=%u, "
+		    "rs=%u, ch=%u, pwr_limit=%d\n", band, bw, rs_idx, ch,
+		    pwr_limit);
+		return;
+	}
+
+	if (band == PHY_BAND_2G) {
+		if (pwr_limit < rs->pwr_lmt_2g[bw][rs_idx][ch_idx])
+			rs->pwr_lmt_2g[bw][rs_idx][ch_idx] = pwr_limit;
+	} else if (band == PHY_BAND_5G) {
+		if (pwr_limit < rs->pwr_lmt_5g[bw][rs_idx][ch_idx])
+			rs->pwr_lmt_5g[bw][rs_idx][ch_idx] = pwr_limit;
+	}
+}
+
+/* rtw_xref_5g_txpwr_lmt() */
+static void
+r22b_xref_5g_txpwr_lmt(struct rtwn_softc *sc, int bw, int ch_idx,
+    int rs_ht, int rs_vht)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	int8_t lmt_ht = rs->pwr_lmt_5g[bw][rs_ht][ch_idx];
+	int8_t lmt_vht = rs->pwr_lmt_5g[bw][rs_vht][ch_idx];
+
+	if (lmt_ht == lmt_vht)
+		return;
+
+	if (lmt_ht == R22B_MAX_POWER_INDEX)
+		rs->pwr_lmt_5g[bw][rs_ht][ch_idx] = lmt_vht;
+	else if (lmt_vht == R22B_MAX_POWER_INDEX)
+		rs->pwr_lmt_5g[bw][rs_vht][ch_idx] = lmt_ht;
+}
+
+/* rtw_parse_tbl_txpwr_lmt() + rtw_xref_txpwr_lmt() */
+static void
+r22b_parse_tbl_txpwr_lmt(struct rtwn_softc *sc, const struct r22b_table *tbl)
+{
+	const struct r22b_txpwr_lmt_cfg_pair *p = tbl->data;
+	const struct r22b_txpwr_lmt_cfg_pair *end = p + tbl->size;
+	int bw, ch_idx;
+
+	/* Every regulatory domain contributes to the worldwide limit. */
+	for (; p < end; p++) {
+		r22b_set_tx_power_limit(sc, p->band, p->bw, p->rs, p->ch,
+		    p->txpwr_lmt);
+	}
+
+	/* cross-reference HT/VHT power limits of 5G 20/40M channels */
+	for (bw = R22B_CHANNEL_WIDTH_20; bw <= R22B_CHANNEL_WIDTH_40; bw++) {
+		for (ch_idx = 0; ch_idx < R22B_MAX_CHANNEL_NUM_5G; ch_idx++) {
+			r22b_xref_5g_txpwr_lmt(sc, bw, ch_idx, R22B_RS_HT_1S,
+			    R22B_RS_VHT_1S);
+			r22b_xref_5g_txpwr_lmt(sc, bw, ch_idx, R22B_RS_HT_2S,
+			    R22B_RS_VHT_2S);
+		}
+	}
+}
+
+/*
+ * rtw_chip_board_info_setup(): rtw_phy_init_tx_power(), load the by-rate
+ * and limit tables of this RFE type, rtw_phy_tx_power_by_rate_config()
+ * and rtw_phy_tx_power_limit_config().
+ */
+void
+r22b_txpwr_setup(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	int path, rsi, bw, ch, i;
+	uint8_t base_idx, rate;
+	int8_t base_2g, base_5g;
+
+	/* rtw_phy_init_tx_power() */
+	memset(rs->pwr_by_rate_2g, 0, sizeof(rs->pwr_by_rate_2g));
+	memset(rs->pwr_by_rate_5g, 0, sizeof(rs->pwr_by_rate_5g));
+	memset(rs->pwr_lmt_2g, R22B_MAX_POWER_INDEX, sizeof(rs->pwr_lmt_2g));
+	memset(rs->pwr_lmt_5g, R22B_MAX_POWER_INDEX, sizeof(rs->pwr_lmt_5g));
+
+	r22b_parse_tbl_bb_pg(sc, rs->pg_tbl);
+	r22b_parse_tbl_txpwr_lmt(sc, rs->lmt_tbl);
+
+	/* rtw_phy_tx_power_by_rate_config() */
+	for (path = 0; path < R22B_RF_PATH_MAX; path++) {
+		for (rsi = 0; rsi < R22B_RS_NUM; rsi++) {
+			const uint8_t size = r22b_rate_section[rsi].size;
+			const uint8_t first = r22b_rate_section[rsi].first;
+
+			if (size == 10)	/* VHT rates */
+				base_idx = first + size - 3;
+			else
+				base_idx = first + size - 1;
+			base_2g = rs->pwr_by_rate_2g[path][base_idx];
+			base_5g = rs->pwr_by_rate_5g[path][base_idx];
+			rs->pwr_by_rate_base_2g[path][rsi] = base_2g;
+			rs->pwr_by_rate_base_5g[path][rsi] = base_5g;
+			for (i = 0; i < size; i++) {
+				rate = first + i;
+				rs->pwr_by_rate_2g[path][rate] -= base_2g;
+				rs->pwr_by_rate_5g[path][rate] -= base_5g;
+			}
+		}
+	}
+
+	/* rtw_phy_tx_power_limit_config() */
+	rs->cch_by_bw[R22B_CHANNEL_WIDTH_20] = 1;	/* default at channel 1 */
+	for (bw = 0; bw < R22B_CHANNEL_WIDTH_MAX; bw++) {
+		for (rsi = 0; rsi < R22B_RS_NUM; rsi++) {
+			for (ch = 0; ch < R22B_MAX_CHANNEL_NUM_2G; ch++)
+				rs->pwr_lmt_2g[bw][rsi][ch] -=
+				    rs->pwr_by_rate_base_2g[0][rsi];
+			for (ch = 0; ch < R22B_MAX_CHANNEL_NUM_5G; ch++)
+				rs->pwr_lmt_5g[bw][rsi][ch] -=
+				    rs->pwr_by_rate_base_5g[0][rsi];
+		}
+	}
+}
+
+/* rtw_get_channel_group() */
+static int
+r22b_get_channel_group(uint8_t channel, uint8_t rate)
+{
+	switch (channel) {
+	default:
+		/* rtw88: WARN_ON(1) */
+	case 1:
+	case 2:
+	case 36:
+	case 38:
+	case 40:
+	case 42:
+		return (0);
+	case 3:
+	case 4:
+	case 5:
+	case 44:
+	case 46:
+	case 48:
+	case 50:
+		return (1);
+	case 6:
+	case 7:
+	case 8:
+	case 52:
+	case 54:
+	case 56:
+	case 58:
+		return (2);
+	case 9:
+	case 10:
+	case 11:
+	case 60:
+	case 62:
+	case 64:
+		return (3);
+	case 12:
+	case 13:
+	case 100:
+	case 102:
+	case 104:
+	case 106:
+		return (4);
+	case 14:
+		return (rate <= DESC_RATE11M ? 5 : 4);
+	case 108:
+	case 110:
+	case 112:
+	case 114:
+		return (5);
+	case 116:
+	case 118:
+	case 120:
+	case 122:
+		return (6);
+	case 124:
+	case 126:
+	case 128:
+	case 130:
+		return (7);
+	case 132:
+	case 134:
+	case 136:
+	case 138:
+		return (8);
+	case 140:
+	case 142:
+	case 144:
+		return (9);
+	case 149:
+	case 151:
+	case 153:
+	case 155:
+		return (10);
+	case 157:
+	case 159:
+	case 161:
+		return (11);
+	case 165:
+	case 167:
+	case 169:
+	case 171:
+		return (12);
+	case 173:
+	case 175:
+	case 177:
+		return (13);
+	}
+}
+
+static int
+r22b_is_mcs_rate(uint8_t rate)
+{
+	return ((rate >= DESC_RATEMCS0 && rate <= DESC_RATEMCS31) ||
+	    (rate >= DESC_RATEVHT1SS_MCS0 && rate <= DESC_RATEVHT4SS_MCS9));
+}
+
+#define ABOVE_2SS(r)	(((r) >= DESC_RATEMCS8 && (r) <= DESC_RATEMCS31) || \
+			 (r) >= DESC_RATEVHT2SS_MCS0)
+#define ABOVE_3SS(r)	(((r) >= DESC_RATEMCS16 && (r) <= DESC_RATEMCS31) || \
+			 (r) >= DESC_RATEVHT3SS_MCS0)
+#define ABOVE_4SS(r)	(((r) >= DESC_RATEMCS24 && (r) <= DESC_RATEMCS31) || \
+			 (r) >= DESC_RATEVHT4SS_MCS0)
+
+static int
+r22b_efuse_base(struct rtwn_softc *sc, uint8_t base)
+{
+	if (base == 0xff) {
+		RTWN_DPRINTF(sc, RTWN_DEBUG_TXPWR,
+		    "unprogrammed efuse tx power index, using 0x%x\n",
+		    R22B_DEF_TXPWR_IDX);
+		return (R22B_DEF_TXPWR_IDX);
+	}
+
+	return (base);
+}
+
+/* rtw_phy_get_2g_tx_power_index() (txgi_factor 1) */
+static int
+r22b_get_2g_tx_power_index(struct rtwn_softc *sc,
+    const struct r22b_txpwr_idx *idx, int bw, uint8_t rate, int group)
+{
+	int tx_power;
+
+	if (rate <= DESC_RATE11M)
+		tx_power = r22b_efuse_base(sc, idx->cck_base_2g[group]);
+	else
+		tx_power = r22b_efuse_base(sc, idx->bw40_base_2g[group]);
+
+	if (rate >= DESC_RATE6M && rate <= DESC_RATE54M)
+		tx_power += idx->ht_1s_ofdm_2g;
+
+	if (!r22b_is_mcs_rate(rate))
+		return (tx_power);
+
+	switch (bw) {
+	default:
+		/* rtw88: WARN_ON(1) */
+	case R22B_CHANNEL_WIDTH_20:
+		tx_power += idx->ht_1s_bw20_2g;
+		if (ABOVE_2SS(rate))
+			tx_power += idx->ht_ns_bw20_2g[0];
+		if (ABOVE_3SS(rate))
+			tx_power += idx->ht_ns_bw20_2g[1];
+		if (ABOVE_4SS(rate))
+			tx_power += idx->ht_ns_bw20_2g[2];
+		break;
+	case R22B_CHANNEL_WIDTH_40:
+		/* bw40 is the base power */
+		if (ABOVE_2SS(rate))
+			tx_power += idx->ht_ns_bw40_2g[0];
+		if (ABOVE_3SS(rate))
+			tx_power += idx->ht_ns_bw40_2g[1];
+		if (ABOVE_4SS(rate))
+			tx_power += idx->ht_ns_bw40_2g[2];
+		break;
+	}
+
+	return (tx_power);
+}
+
+/* rtw_phy_get_5g_tx_power_index() (txgi_factor 1) */
+static int
+r22b_get_5g_tx_power_index(struct rtwn_softc *sc,
+    const struct r22b_txpwr_idx *idx, int bw, uint8_t rate, int group)
+{
+	int tx_power, lower, upper;
+
+	tx_power = r22b_efuse_base(sc, idx->bw40_base_5g[group]);
+
+	if (!r22b_is_mcs_rate(rate)) {
+		tx_power += idx->ht_1s_ofdm_5g;
+		return (tx_power);
+	}
+
+	switch (bw) {
+	default:
+		/* rtw88: WARN_ON(1) */
+	case R22B_CHANNEL_WIDTH_20:
+		tx_power += idx->ht_1s_bw20_5g;
+		if (ABOVE_2SS(rate))
+			tx_power += idx->ht_ns_bw20_5g[0];
+		if (ABOVE_3SS(rate))
+			tx_power += idx->ht_ns_bw20_5g[1];
+		if (ABOVE_4SS(rate))
+			tx_power += idx->ht_ns_bw20_5g[2];
+		break;
+	case R22B_CHANNEL_WIDTH_40:
+		/* bw40 is the base power */
+		if (ABOVE_2SS(rate))
+			tx_power += idx->ht_ns_bw40_5g[0];
+		if (ABOVE_3SS(rate))
+			tx_power += idx->ht_ns_bw40_5g[1];
+		if (ABOVE_4SS(rate))
+			tx_power += idx->ht_ns_bw40_5g[2];
+		break;
+	case R22B_CHANNEL_WIDTH_80:
+		/* the base idx of bw80 is the average of bw40+/bw40- */
+		lower = r22b_efuse_base(sc, idx->bw40_base_5g[group]);
+		upper = r22b_efuse_base(sc, idx->bw40_base_5g[
+		    group + 1 < R22B_GROUP_5G ? group + 1 : group]);
+
+		tx_power = (lower + upper) / 2;
+		tx_power += idx->vht_bw80_5g[0];
+		if (ABOVE_2SS(rate))
+			tx_power += idx->vht_bw80_5g[1];
+		if (ABOVE_3SS(rate))
+			tx_power += idx->vht_bw80_5g[2];
+		if (ABOVE_4SS(rate))
+			tx_power += idx->vht_bw80_5g[3];
+		break;
+	}
+
+	return (tx_power);
+}
+
+/* rtw_phy_get_tx_power_limit() for RTW_REGD_WW */
+static int8_t
+r22b_get_tx_power_limit(struct rtwn_softc *sc, int band, int bw,
+    uint8_t rate, uint8_t channel)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	int8_t power_limit = R22B_MAX_POWER_INDEX, cur_lmt;
+	int rsi, cur_bw, ch_idx;
+	uint8_t cur_ch;
+
+	rsi = r22b_rate_to_rate_section(rate);
+	if (rsi == R22B_RS_NUM)
+		goto err;
+
+	/* only 20M BW with cck and ofdm */
+	if (rsi == R22B_RS_CCK || rsi == R22B_RS_OFDM)
+		bw = R22B_CHANNEL_WIDTH_20;
+
+	/* only 20/40M BW with ht */
+	if (rate >= DESC_RATEMCS0 && rate <= DESC_RATEMCS31)
+		bw = MIN(bw, R22B_CHANNEL_WIDTH_40);
+
+	/* select min power limit among [20M BW ~ current BW] */
+	for (cur_bw = R22B_CHANNEL_WIDTH_20; cur_bw <= bw; cur_bw++) {
+		cur_ch = rs->cch_by_bw[cur_bw];
+
+		ch_idx = r22b_channel_to_idx(band, cur_ch);
+		if (ch_idx < 0)
+			goto err;
+
+		cur_lmt = cur_ch <= R22B_MAX_CHANNEL_NUM_2G ?
+		    rs->pwr_lmt_2g[cur_bw][rsi][ch_idx] :
+		    rs->pwr_lmt_5g[cur_bw][rsi][ch_idx];
+
+		power_limit = MIN(cur_lmt, power_limit);
+	}
+
+	return (power_limit);
+
+err:
+	device_printf(sc->sc_dev, "%s: invalid arguments, band=%d, bw=%d, "
+	    "rate=%d, ch=%d\n", __func__, band, bw, rate, channel);
+	return (R22B_MAX_POWER_INDEX);
+}
+
+/* rtw_get_tx_power_params() + rtw_phy_get_tx_power_index() */
+static uint8_t
+r22b_get_tx_power_index(struct rtwn_softc *sc, int path, uint8_t rate,
+    int bw, uint8_t channel)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const struct r22b_txpwr_idx *idx = &rs->txpwr_idx[path];
+	int group, band, base, tx_power;
+	int8_t offset, limit;
+	const int8_t sar = R22B_MAX_POWER_INDEX;	/* no SAR source */
+	const int remnant = 0;		/* dm_info->txagc_remnant_* */
+
+	group = r22b_get_channel_group(channel, rate);
+
+	/* base power index for 2.4G/5G */
+	if (R22B_IS_CH_2G_BAND(channel)) {
+		band = PHY_BAND_2G;
+		base = r22b_get_2g_tx_power_index(sc, idx, bw, rate, group);
+		offset = rs->pwr_by_rate_2g[path][rate];
+	} else {
+		band = PHY_BAND_5G;
+		base = r22b_get_5g_tx_power_index(sc, idx, bw, rate, group);
+		offset = rs->pwr_by_rate_5g[path][rate];
+	}
+
+	limit = r22b_get_tx_power_limit(sc, band, bw, rate, channel);
+
+	offset = MIN(offset, limit);
+	offset = MIN(offset, sar);
+
+	tx_power = base + offset + remnant;
+	if (tx_power > R22B_MAX_POWER_INDEX)
+		tx_power = R22B_MAX_POWER_INDEX;
+	if (tx_power < 0)
+		tx_power = 0;
+
+	return (tx_power);
+}
+
+/* rtw8822b_set_tx_power_index() */
+static void
+r22b_set_tx_power_index(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	static const uint16_t offset_txagc[R22B_RF_PATH_MAX] =
+	    { R22B_REG_TXAGC_A, R22B_REG_TXAGC_B };
+	uint32_t phy_pwr_idx = 0;
+	uint8_t rate, shift;
+	int path, rsi, j;
+
+	for (path = 0; path < rs->rf_path_num; path++) {
+		for (rsi = 0; rsi <= R22B_RS_VHT_2S; rsi++) {
+			for (j = 0; j < r22b_rate_section[rsi].size; j++) {
+				rate = r22b_rate_section[rsi].first + j;
+				shift = rate & 0x3;
+				phy_pwr_idx |=
+				    (uint32_t)rs->tx_pwr_tbl[path][rate] <<
+				    (shift * 8);
+				if (shift == 0x3) {
+					rtwn_write_4(sc, offset_txagc[path] +
+					    (rate & 0xfc), phy_pwr_idx);
+					phy_pwr_idx = 0;
+				}
+			}
+		}
+	}
+}
+
+/*
+ * rtw_phy_set_tx_power_level() for the current (center) channel and
+ * bandwidth; called after every channel change, like rtw_set_channel().
+ */
+void
+r22b_set_tx_power_level(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const uint8_t ch = rs->cur_chan;
+	int path, rsi, j;
+	uint8_t rate;
+
+	for (path = 0; path < rs->rf_path_num; path++) {
+		/* do not need cck rates if we are not in 2.4G */
+		rsi = R22B_IS_CH_2G_BAND(ch) ? R22B_RS_CCK : R22B_RS_OFDM;
+		for (; rsi < R22B_RS_NUM; rsi++) {
+			for (j = 0; j < r22b_rate_section[rsi].size; j++) {
+				rate = r22b_rate_section[rsi].first + j;
+				rs->tx_pwr_tbl[path][rate] =
+				    r22b_get_tx_power_index(sc, path, rate,
+				    rs->cur_bw, ch);
+			}
+		}
+
+		RTWN_DPRINTF(sc, RTWN_DEBUG_TXPWR, "%s: path %c, ch %u, "
+		    "bw %u: CCK1 %u OFDM6 %u OFDM54 %u MCS7 %u MCS15 %u "
+		    "VHT2SS_MCS9 %u\n", __func__, 'A' + path, ch, rs->cur_bw,
+		    rs->tx_pwr_tbl[path][DESC_RATE1M],
+		    rs->tx_pwr_tbl[path][DESC_RATE6M],
+		    rs->tx_pwr_tbl[path][DESC_RATE54M],
+		    rs->tx_pwr_tbl[path][DESC_RATEMCS7],
+		    rs->tx_pwr_tbl[path][DESC_RATEMCS15],
+		    rs->tx_pwr_tbl[path][DESC_RATEVHT2SS_MCS9]);
+	}
+
+	r22b_set_tx_power_index(sc);
+}
