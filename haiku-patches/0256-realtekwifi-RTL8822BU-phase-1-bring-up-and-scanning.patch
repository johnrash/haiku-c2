+int
+r22b_check_condition(struct rtwn_softc *sc, const uint8_t cond[])
+{
+	/* Not used: the rtw88 tables carry their own conditions. */
+	return (1);
+}
+
+/*
+ * rtw_pwr_cmd_polling() / do_pwr_poll_cmd(): rtw88 polls for up to
+ * RTW_PWR_POLLING_CNT * 50 us = 1 s.
+ */
+static int
+r22b_pwr_cmd_polling(struct rtwn_softc *sc, const struct r22b_pwr_seq_cmd *cmd)
+{
+	uint8_t target = cmd->value & cmd->mask;
+	int start = ticks;
+
+	for (;;) {
+		if ((rtwn_read_1(sc, cmd->offset) & cmd->mask) == target)
+			return (0);
+		if (ticks - start > hz)
+			break;
+		rtwn_delay(sc, 50);
+	}
+
+	device_printf(sc->sc_dev,
+	    "failed to poll offset=0x%x mask=0x%x value=0x%x\n",
+	    cmd->offset, cmd->mask, cmd->value);
+	return (EBUSY);
+}
+
+/* rtw_pwr_seq_parser() / rtw_sub_pwr_seq_parser(), USB interface. */
+static int
+r22b_pwr_seq_parser(struct rtwn_softc *sc,
+    const struct r22b_pwr_seq_cmd * const *cmd_seq)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const struct r22b_pwr_seq_cmd *cmd;
+	const uint32_t cut_mask = 1U << (rs->cut_version + 1);
+	const uint8_t intf_mask = R22B_PWR_INTF_USB_MSK;
+	uint8_t value;
+	int idx, error;
+
+	for (idx = 0; cmd_seq[idx] != NULL; idx++) {
+		for (cmd = cmd_seq[idx]; cmd->cmd != R22B_PWR_CMD_END; cmd++) {
+			if (!(cmd->intf_mask & intf_mask) ||
+			    !(cmd->cut_mask & cut_mask))
+				continue;
+
+			switch (cmd->cmd) {
+			case R22B_PWR_CMD_WRITE:
+				/* SDIO-local entries never match USB. */
+				value = rtwn_read_1(sc, cmd->offset);
+				value &= ~cmd->mask;
+				value |= (cmd->value & cmd->mask);
+				rtwn_write_1(sc, cmd->offset, value);
+				break;
+			case R22B_PWR_CMD_POLLING:
+				error = r22b_pwr_cmd_polling(sc, cmd);
+				if (error != 0)
+					return (error);
+				break;
+			case R22B_PWR_CMD_DELAY:
+				if (cmd->value == R22B_PWR_DELAY_US)
+					rtwn_delay(sc, cmd->offset);
+				else
+					rtwn_delay(sc, cmd->offset * 1000);
+				break;
+			case R22B_PWR_CMD_READ:
+				break;
+			default:
+				return (EINVAL);
+			}
+		}
+	}
+
+	return (0);
+}
+
+/* rtw_mac_pre_system_cfg() for a 3081-CPU chip on USB. */
+static void
+r22b_mac_pre_system_cfg(struct rtwn_softc *sc)
+{
+	uint32_t value32;
+	uint8_t value8;
+
+	rtwn_write_1(sc, R22B_REG_RSV_CTRL, 0);
+
+	/* config PIN Mux */
+	value32 = rtwn_read_4(sc, R22B_REG_PAD_CTRL1);
+	value32 |= R22B_BIT_PAPE_WLBT_SEL | R22B_BIT_LNAON_WLBT_SEL;
+	rtwn_write_4(sc, R22B_REG_PAD_CTRL1, value32);
+
+	value32 = rtwn_read_4(sc, R22B_REG_LED_CFG);
+	value32 &= ~(R22B_BIT_PAPE_SEL_EN | R22B_BIT_LNAON_SEL_EN);
+	rtwn_write_4(sc, R22B_REG_LED_CFG, value32);
+
+	value32 = rtwn_read_4(sc, R22B_REG_GPIO_MUXCFG);
+	value32 |= R22B_BIT_WLRFE_4_5_EN;
+	rtwn_write_4(sc, R22B_REG_GPIO_MUXCFG, value32);
+
+	/* disable BB/RF */
+	value8 = rtwn_read_1(sc, R22B_REG_SYS_FUNC_EN);
+	value8 &= ~(R22B_BIT_FEN_BB_RSTB | R22B_BIT_FEN_BB_GLB_RST);
+	rtwn_write_1(sc, R22B_REG_SYS_FUNC_EN, value8);
+
+	value8 = rtwn_read_1(sc, R22B_REG_RF_CTRL);
+	value8 &= ~(R22B_BIT_RF_SDM_RSTB | R22B_BIT_RF_RSTB | R22B_BIT_RF_EN);
+	rtwn_write_1(sc, R22B_REG_RF_CTRL, value8);
+
+	value32 = rtwn_read_4(sc, R22B_REG_WLRF1);
+	value32 &= ~R22B_BIT_WLRF1_BBRF_EN;
+	rtwn_write_4(sc, R22B_REG_WLRF1, value32);
+}
+
+/* rtw_mac_power_switch() */
+static int
+r22b_mac_power_switch(struct rtwn_softc *sc, int pwr_on)
+{
+	uint8_t rpwm;
+	int cur_pwr, error;
+
+	/* 3081 CPU: check whether the firmware is still there. */
+	rpwm = rtwn_read_1(sc, R22B_REG_USB_HRPWM);
+	if (rtwn_read_2(sc, R22B_REG_MCUFW_CTRL) == 0xc078) {
+		rpwm = (rpwm ^ R22B_BIT_RPWM_TOGGLE) & R22B_BIT_RPWM_TOGGLE;
+		rtwn_write_1(sc, R22B_REG_USB_HRPWM, rpwm);
+	}
+
+	if (rtwn_read_1(sc, R22B_REG_CR) == 0xea)
+		cur_pwr = 0;
+	else if (rtwn_read_1(sc, R22B_REG_SYS_STATUS1 + 1) & R22B_BIT(0))
+		cur_pwr = 0;	/* USB, not an RTL8814A */
+	else
+		cur_pwr = 1;
+
+	if (!!pwr_on == cur_pwr)
+		return (EALREADY);
+
+	error = r22b_pwr_seq_parser(sc,
+	    pwr_on ? r22b_card_enable_flow : r22b_card_disable_flow);
+
+	if (pwr_on)
+		r22b_write8_clr(sc, R22B_REG_SYS_STATUS1 + 1, R22B_BIT(0));
+
+	return (error);
+}
+
+/* __rtw_mac_init_system_cfg() */
+static void
+r22b_mac_init_system_cfg(struct rtwn_softc *sc)
+{
+	uint32_t value, tmp;
+	uint8_t value8;
+
+	value = rtwn_read_4(sc, R22B_REG_CPU_DMEM_CON);
+	value |= R22B_BIT_WL_PLATFORM_RST | R22B_BIT_DDMA_EN;
+	rtwn_write_4(sc, R22B_REG_CPU_DMEM_CON, value);
+
+	r22b_write8_set(sc, R22B_REG_SYS_FUNC_EN + 1, R22B_SYS_FUNC_EN_VAL);
+	value8 = (rtwn_read_1(sc, R22B_REG_CR_EXT + 3) & 0xf0) | 0x0c;
+	rtwn_write_1(sc, R22B_REG_CR_EXT + 3, value8);
+
+	/* disable boot-from-flash for driver's DL FW */
+	tmp = rtwn_read_4(sc, R22B_REG_MCUFW_CTRL);
+	if (tmp & R22B_BIT_BOOT_FSPI_EN) {
+		rtwn_write_4(sc, R22B_REG_MCUFW_CTRL,
+		    tmp & ~R22B_BIT_BOOT_FSPI_EN);
+		value = rtwn_read_4(sc, R22B_REG_GPIO_MUXCFG) &
+		    ~R22B_BIT_FSPI_EN;
+		rtwn_write_4(sc, R22B_REG_GPIO_MUXCFG, value);
+	}
+}
+
+/* rtw_mac_power_on() */
+int
+r22b_mac_power_on(struct rtwn_softc *sc)
+{
+	int error;
+
+	r22b_mac_pre_system_cfg(sc);
+
+	error = r22b_mac_power_switch(sc, 1);
+	if (error == EALREADY) {
+		(void)r22b_mac_power_switch(sc, 0);
+
+		r22b_mac_pre_system_cfg(sc);
+
+		error = r22b_mac_power_switch(sc, 1);
+		if (error != 0)
+			goto fail;
+	} else if (error != 0)
+		goto fail;
+
+	r22b_mac_init_system_cfg(sc);
+
+	return (0);
+
+fail:
+	device_printf(sc->sc_dev, "mac power on failed (error %d)\n", error);
+	return (error);
+}
+
+/* rtw_mac_power_off() */
+void
+r22b_mac_power_off(struct rtwn_softc *sc)
+{
+	(void)r22b_mac_power_switch(sc, 0);
+}
+
+/*
+ * rtw_chip_parameter_setup() and the first half of rtw_chip_efuse_enable().
+ *
+ * This is the last chip hook rtwn_attach() calls before reading the efuse
+ * (rtwn_read_rom()), so the MAC is powered on here like rtw88 does before
+ * rtw_dump_physical_efuse_map(); r22b_efuse_postread() powers it off
+ * again (rtw_chip_efuse_disable()).
+ *
+ * Not done (yet): rtw88 also downloads the firmware at this point to
+ * read the C2H_HW_FEATURE_REPORT (bandwidth/NSS/antenna limits); the
+ * capabilities here come from REG_SYS_CFG1 only.
+ */
+void
+r22b_read_chipid_vendor(struct rtwn_softc *sc, uint32_t reg_sys_cfg)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	rs->chip_version = reg_sys_cfg;
+	rs->cut_version = (reg_sys_cfg >> R22B_BIT_SHIFT_CHIP_VER) &
+	    R22B_BIT_MASK_CHIP_VER;
+	if (reg_sys_cfg & R22B_BIT_RF_TYPE_ID) {
+		rs->rf_path_num = 2;
+		rs->antenna_tx = R22B_BB_PATH_AB;
+		rs->antenna_rx = R22B_BB_PATH_AB;
+	} else {
+		rs->rf_path_num = 1;
+		rs->antenna_tx = R22B_BB_PATH_A;
+		rs->antenna_rx = R22B_BB_PATH_A;
+	}
+	sc->ntxchains = rs->rf_path_num;
+	sc->nrxchains = rs->rf_path_num;
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_RESET, "%s: SYS_CFG1 0x%08x, cut %u, %uT%uR\n",
+	    __func__, reg_sys_cfg, rs->cut_version, rs->rf_path_num,
+	    rs->rf_path_num);
+
+	if (r22b_mac_power_on(sc) == 0)
+		rs->efuse_powered = 1;
+	else {
+		device_printf(sc->sc_dev,
+		    "%s: cannot power on the MAC to read the efuse\n",
+		    __func__);
+	}
+
+	/* rtw_dump_physical_efuse_map(): switch_efuse_bank(), no 2.5V LDO */
+	r22b_write32_mask(sc, R22B_REG_LDO_EFUSE_CTRL,
+	    R22B_BIT_MASK_EFUSE_BANK_SEL, 0);
+	r22b_cfg_ldo25(sc, 0);
+}
+
+/* rtw_chip_efuse_disable() */
+void
+r22b_efuse_postread(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	if (rs->efuse_powered) {
+		r22b_mac_power_off(sc);
+		rs->efuse_powered = 0;
+	}
+}
+
+int
+r22b_power_on(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	/* rtw_check_supported_rfe() */
+	if (!rs->rfe_supported) {
+		device_printf(sc->sc_dev, "RFE type %u isn't supported\n",
+		    rs->rfe_option);
+		return (EOPNOTSUPP);
+	}
+
+	/* rtw_hci_setup() is empty for USB. */
+	return (r22b_mac_power_on(sc));
+}
+
+/* rtw_power_off(): rtw_hci_stop() is empty for USB. */
+void
+r22b_power_off(struct rtwn_softc *sc)
+{
+	r22b_coex_power_off_setting(sc);
+	r22b_mac_power_off(sc);
+}
+
+/* txdma_queue_mapping() for USB. */
+static int
+r22b_txdma_queue_mapping(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const struct r22b_rqpn *rqpn = rs->rqpn;
+	uint16_t txdma_pq_map;
+
+	if (rqpn == NULL)
+		return (EINVAL);
+
+	txdma_pq_map = R22B_BIT_TXDMA_HIQ_MAP(rqpn->dma_map_hi) |
+	    R22B_BIT_TXDMA_MGQ_MAP(rqpn->dma_map_mg) |
+	    R22B_BIT_TXDMA_BKQ_MAP(rqpn->dma_map_bk) |
+	    R22B_BIT_TXDMA_BEQ_MAP(rqpn->dma_map_be) |
+	    R22B_BIT_TXDMA_VIQ_MAP(rqpn->dma_map_vi) |
+	    R22B_BIT_TXDMA_VOQ_MAP(rqpn->dma_map_vo);
+	rtwn_write_2(sc, R22B_REG_TXDMA_PQ_MAP, txdma_pq_map);
+
+	rtwn_write_1(sc, R22B_REG_CR, 0);
+	rtwn_write_1(sc, R22B_REG_CR, R22B_MAC_TRX_ENABLE);
+	rtwn_write_4(sc, R22B_REG_H2CQ_CSR, R22B_BIT_H2CQ_FULL);
+
+	r22b_write8_set(sc, R22B_REG_TXDMA_PQ_MAP, R22B_BIT_RXDMA_ARBBW_EN);
+
+	return (0);
+}
+
+/* rtw_set_trx_fifo_info() */
+static int
+r22b_set_trx_fifo_info(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const uint16_t txff_pg_num = R22B_TXFF_SIZE / R22B_TX_PAGE_SIZE;
+	const uint16_t rsvd_pg_num = R22B_RSVD_DRV_PG_NUM +
+	    R22B_RSVD_PG_H2C_EXTRAINFO_NUM + R22B_RSVD_PG_H2C_STATICINFO_NUM +
+	    R22B_RSVD_PG_H2CQ_NUM + R22B_RSVD_PG_CPU_INSTRUCTION_NUM +
+	    R22B_RSVD_PG_FW_TXBUF_NUM + R22B_CSI_BUF_PG_NUM;
+	uint16_t cur_pg_addr;
+
+	if (rsvd_pg_num > txff_pg_num)
+		return (ENOMEM);
+
+	rs->acq_pg_num = txff_pg_num - rsvd_pg_num;
+	rs->rsvd_boundary = txff_pg_num - rsvd_pg_num;
+
+	cur_pg_addr = txff_pg_num;
+	cur_pg_addr -= R22B_CSI_BUF_PG_NUM;
+	cur_pg_addr -= R22B_RSVD_PG_FW_TXBUF_NUM;
+	rs->rsvd_fw_txbuf_addr = cur_pg_addr;
+	cur_pg_addr -= R22B_RSVD_PG_CPU_INSTRUCTION_NUM;
+	rs->rsvd_cpu_instr_addr = cur_pg_addr;
+	cur_pg_addr -= R22B_RSVD_PG_H2CQ_NUM;
+	rs->rsvd_h2cq_addr = cur_pg_addr;
+	cur_pg_addr -= R22B_RSVD_PG_H2C_STATICINFO_NUM;
+	rs->rsvd_h2c_sta_info_addr = cur_pg_addr;
+	cur_pg_addr -= R22B_RSVD_PG_H2C_EXTRAINFO_NUM;
+	rs->rsvd_h2c_info_addr = cur_pg_addr;
+	cur_pg_addr -= R22B_RSVD_DRV_PG_NUM;
+	rs->rsvd_drv_addr = cur_pg_addr;
+
+	if (rs->rsvd_boundary != rs->rsvd_drv_addr) {
+		device_printf(sc->sc_dev, "wrong rsvd driver address\n");
+		return (EINVAL);
+	}
+
+	return (0);
+}
+
+/* priority_queue_cfg() / __priority_queue_cfg() for USB. */
+static int
+r22b_priority_queue_cfg(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const struct r22b_page_table *pg_tbl = rs->page_table;
+	uint16_t pubq_num;
+	int error;
+
+	error = r22b_set_trx_fifo_info(sc);
+	if (error != 0)
+		return (error);
+
+	if (pg_tbl == NULL)
+		return (EINVAL);
+
+	pubq_num = rs->acq_pg_num - pg_tbl->hq_num - pg_tbl->lq_num -
+	    pg_tbl->nq_num - pg_tbl->exq_num - pg_tbl->gapq_num;
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_RESET, "%s: pages: high %u, normal %u, "
+	    "low %u, extra %u, public %u, rsvd boundary %u\n", __func__,
+	    pg_tbl->hq_num, pg_tbl->nq_num, pg_tbl->lq_num, pg_tbl->exq_num,
+	    pubq_num, rs->rsvd_boundary);
+
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_INFO_1, pg_tbl->hq_num);
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_INFO_2, pg_tbl->lq_num);
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_INFO_3, pg_tbl->nq_num);
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_INFO_4, pg_tbl->exq_num);
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_INFO_5, pubq_num);
+	r22b_write32_set(sc, R22B_REG_RQPN_CTRL_2, R22B_BIT_LD_RQPN);
+
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_CTRL_2, rs->rsvd_boundary);
+	r22b_write8_set(sc, R22B_REG_FWHW_TXQ_CTRL + 2,
+	    R22B_BIT_EN_WR_FREE_TAIL >> 16);
+
+	rtwn_write_2(sc, R22B_REG_BCNQ_BDNY_V1, rs->rsvd_boundary);
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_CTRL_2 + 2, rs->rsvd_boundary);
+	rtwn_write_2(sc, R22B_REG_BCNQ1_BDNY_V1, rs->rsvd_boundary);
+	rtwn_write_4(sc, R22B_REG_RXFF_BNDY,
+	    R22B_RXFF_SIZE - R22B_C2H_PKT_BUF - 1);
+
+	/* USB */
+	r22b_write8_mask(sc, R22B_REG_AUTO_LLT_V1, R22B_BIT_MASK_BLK_DESC_NUM,
+	    R22B_USB_TX_AGG_DESC_NUM);
+	rtwn_write_1(sc, R22B_REG_AUTO_LLT_V1 + 3, R22B_USB_TX_AGG_DESC_NUM);
+	r22b_write8_set(sc, R22B_REG_TXDMA_OFFSET_CHK + 1, R22B_BIT(1));
+
+	r22b_write8_set(sc, R22B_REG_AUTO_LLT_V1, R22B_BIT_AUTO_INIT_LLT_V1);
+
+	if (!r22b_check_hw_ready(sc, R22B_REG_AUTO_LLT_V1,
+	    R22B_BIT_AUTO_INIT_LLT_V1, 0)) {
+		device_printf(sc->sc_dev, "%s: auto LLT init timeout\n",
+		    __func__);
+		return (EBUSY);
+	}
+
+	rtwn_write_1(sc, R22B_REG_CR + 3, 0);
+
+	return (0);
+}
+
+/* init_h2c() */
+static int
+r22b_init_h2c(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t value32, h2cq_addr, h2cq_size, h2cq_free, wp, rp;
+	uint8_t value8;
+
+	h2cq_addr = (uint32_t)rs->rsvd_h2cq_addr << R22B_TX_PAGE_SIZE_SHIFT;
+	h2cq_size = R22B_RSVD_PG_H2CQ_NUM << R22B_TX_PAGE_SIZE_SHIFT;
+
+	value32 = rtwn_read_4(sc, R22B_REG_H2C_HEAD);
+	value32 = (value32 & 0xfffc0000) | h2cq_addr;
+	rtwn_write_4(sc, R22B_REG_H2C_HEAD, value32);
+
+	value32 = rtwn_read_4(sc, R22B_REG_H2C_READ_ADDR);
+	value32 = (value32 & 0xfffc0000) | h2cq_addr;
+	rtwn_write_4(sc, R22B_REG_H2C_READ_ADDR, value32);
+
+	value32 = rtwn_read_4(sc, R22B_REG_H2C_TAIL);
+	value32 &= 0xfffc0000;
+	value32 |= (h2cq_addr + h2cq_size);
+	rtwn_write_4(sc, R22B_REG_H2C_TAIL, value32);
+
+	value8 = rtwn_read_1(sc, R22B_REG_H2C_INFO);
+	value8 = (value8 & 0xfc) | 0x01;
+	rtwn_write_1(sc, R22B_REG_H2C_INFO, value8);
+
+	value8 = rtwn_read_1(sc, R22B_REG_H2C_INFO);
+	value8 = (value8 & 0xfb) | 0x04;
+	rtwn_write_1(sc, R22B_REG_H2C_INFO, value8);
+
+	value8 = rtwn_read_1(sc, R22B_REG_TXDMA_OFFSET_CHK + 1);
+	value8 = (value8 & 0x7f) | 0x80;
+	rtwn_write_1(sc, R22B_REG_TXDMA_OFFSET_CHK + 1, value8);
+
+	wp = rtwn_read_4(sc, R22B_REG_H2C_PKT_WRITEADDR) & 0x3ffff;
+	rp = rtwn_read_4(sc, R22B_REG_H2C_PKT_READADDR) & 0x3ffff;
+	h2cq_free = wp >= rp ? h2cq_size - (wp - rp) : rp - wp;
+
+	if (h2cq_size != h2cq_free) {
+		device_printf(sc->sc_dev, "H2C queue mismatch (wp 0x%x, "
+		    "rp 0x%x)\n", wp, rp);
+		return (EINVAL);
+	}
+
+	return (0);
+}
+
+#define WLAN_SLOT_TIME		0x09
+#define WLAN_PIFS_TIME		0x19
+#define WLAN_SIFS_CCK_CONT_TX	0xA
+#define WLAN_SIFS_OFDM_CONT_TX	0xE
+#define WLAN_SIFS_CCK_TRX	0x10
+#define WLAN_SIFS_OFDM_TRX	0x10
+#define WLAN_VO_TXOP_LIMIT	0x186 /* unit : 32us */
+#define WLAN_VI_TXOP_LIMIT	0x3BC /* unit : 32us */
+#define WLAN_RDG_NAV		0x05
+#define WLAN_TXOP_NAV		0x1B
+#define WLAN_CCK_RX_TSF		0x30
+#define WLAN_OFDM_RX_TSF	0x30
+#define WLAN_TBTT_PROHIBIT	0x04 /* unit : 32us */
+#define WLAN_TBTT_HOLD_TIME	0x064 /* unit : 32us */
+#define WLAN_DRV_EARLY_INT	0x04
+#define WLAN_BCN_DMA_TIME	0x02
+
+#define WLAN_RX_FILTER0		0x0FFFFFFF
+#define WLAN_RX_FILTER2		0xFFFF
+#define WLAN_RCR_CFG		0xE400220E
+#define WLAN_RXPKT_MAX_SZ	12288
+#define WLAN_RXPKT_MAX_SZ_512	(WLAN_RXPKT_MAX_SZ >> 9)
+
+#define WLAN_AMPDU_MAX_TIME		0x70
+#define WLAN_RTS_LEN_TH			0xFF
+#define WLAN_RTS_TX_TIME_TH		0x08
+#define WLAN_MAX_AGG_PKT_LIMIT		0x20
+#define WLAN_RTS_MAX_AGG_PKT_LIMIT	0x20
+#define FAST_EDCA_VO_TH		0x06
+#define FAST_EDCA_VI_TH		0x06
+#define FAST_EDCA_BE_TH		0x06
+#define FAST_EDCA_BK_TH		0x06
+#define WLAN_BAR_RETRY_LIMIT		0x01
+#define WLAN_RA_TRY_RATE_AGG_LIMIT	0x08
+
+#define WLAN_TX_FUNC_CFG1		0x30
+#define WLAN_TX_FUNC_CFG2		0x30
+#define WLAN_MAC_OPT_NORM_FUNC1		0x98
+#define WLAN_MAC_OPT_LB_FUNC1		0x80
+#define WLAN_MAC_OPT_FUNC2		0xb0810041
+
+#define WLAN_SIFS_CFG	(WLAN_SIFS_CCK_CONT_TX | \
+			(WLAN_SIFS_OFDM_CONT_TX << R22B_BIT_SHIFT_SIFS_OFDM_CTX) | \
+			(WLAN_SIFS_CCK_TRX << R22B_BIT_SHIFT_SIFS_CCK_TRX) | \
+			(WLAN_SIFS_OFDM_TRX << R22B_BIT_SHIFT_SIFS_OFDM_TRX))
+
+#define WLAN_TBTT_TIME	(WLAN_TBTT_PROHIBIT |\
+			(WLAN_TBTT_HOLD_TIME << R22B_BIT_SHIFT_TBTT_HOLD_TIME_AP))
+
+#define WLAN_NAV_CFG		(WLAN_RDG_NAV | (WLAN_TXOP_NAV << 16))
+#define WLAN_RX_TSF_CFG		(WLAN_CCK_RX_TSF | (WLAN_OFDM_RX_TSF) << 8)
+
+/* rtw8822b_mac_init() */
+static void
+r22b_mac_init_regs(struct rtwn_softc *sc)
+{
+	uint32_t value32;
+
+	/* protocol configuration */
+	r22b_write8_clr(sc, R22B_REG_SW_AMPDU_BURST_MODE_CTRL,
+	    R22B_BIT_PRE_TX_CMD);
+	rtwn_write_1(sc, R22B_REG_AMPDU_MAX_TIME_V1, WLAN_AMPDU_MAX_TIME);
+	r22b_write8_set(sc, R22B_REG_TX_HANG_CTRL, R22B_BIT_EN_EOF_V1);
+	value32 = WLAN_RTS_LEN_TH | (WLAN_RTS_TX_TIME_TH << 8) |
+		  (WLAN_MAX_AGG_PKT_LIMIT << 16) |
+		  (WLAN_RTS_MAX_AGG_PKT_LIMIT << 24);
+	rtwn_write_4(sc, R22B_REG_PROT_MODE_CTRL, value32);
+	rtwn_write_2(sc, R22B_REG_BAR_MODE_CTRL + 2,
+	    WLAN_BAR_RETRY_LIMIT | WLAN_RA_TRY_RATE_AGG_LIMIT << 8);
+	rtwn_write_1(sc, R22B_REG_FAST_EDCA_VOVI_SETTING, FAST_EDCA_VO_TH);
+	rtwn_write_1(sc, R22B_REG_FAST_EDCA_VOVI_SETTING + 2, FAST_EDCA_VI_TH);
+	rtwn_write_1(sc, R22B_REG_FAST_EDCA_BEBK_SETTING, FAST_EDCA_BE_TH);
+	rtwn_write_1(sc, R22B_REG_FAST_EDCA_BEBK_SETTING + 2, FAST_EDCA_BK_TH);
+	/* EDCA configuration */
+	r22b_write8_clr(sc, R22B_REG_TIMER0_SRC_SEL, R22B_BIT_TSFT_SEL_TIMER0);
+	rtwn_write_2(sc, R22B_REG_TXPAUSE, 0x0000);
+	rtwn_write_1(sc, R22B_REG_SLOT, WLAN_SLOT_TIME);
+	rtwn_write_1(sc, R22B_REG_PIFS, WLAN_PIFS_TIME);
+	rtwn_write_4(sc, R22B_REG_SIFS, WLAN_SIFS_CFG);
+	rtwn_write_2(sc, R22B_REG_EDCA_VO_PARAM + 2, WLAN_VO_TXOP_LIMIT);
+	rtwn_write_2(sc, R22B_REG_EDCA_VI_PARAM + 2, WLAN_VI_TXOP_LIMIT);
+	rtwn_write_4(sc, R22B_REG_RD_NAV_NXT, WLAN_NAV_CFG);
+	rtwn_write_2(sc, R22B_REG_RXTSF_OFFSET_CCK, WLAN_RX_TSF_CFG);
+	/* Set beacon cotnrol - enable TSF and other related functions */
+	r22b_write8_set(sc, R22B_REG_BCN_CTRL, R22B_BIT_EN_BCN_FUNCTION);
+	/* Set send beacon related registers */
+	rtwn_write_4(sc, R22B_REG_TBTT_PROHIBIT, WLAN_TBTT_TIME);
+	rtwn_write_1(sc, R22B_REG_DRVERLYINT, WLAN_DRV_EARLY_INT);
+	rtwn_write_1(sc, R22B_REG_BCNDMATIM, WLAN_BCN_DMA_TIME);
+	r22b_write8_clr(sc, R22B_REG_TX_PTCL_CTRL + 1,
+	    R22B_BIT_SIFS_BK_EN >> 8);
+	/* WMAC configuration */
+	rtwn_write_4(sc, R22B_REG_RXFLTMAP0, WLAN_RX_FILTER0);
+	rtwn_write_2(sc, R22B_REG_RXFLTMAP2, WLAN_RX_FILTER2);
+	rtwn_write_4(sc, R22B_REG_RCR, WLAN_RCR_CFG);
+	rtwn_write_1(sc, R22B_REG_RX_PKT_LIMIT, WLAN_RXPKT_MAX_SZ_512);
+	rtwn_write_1(sc, R22B_REG_TCR + 2, WLAN_TX_FUNC_CFG2);
+	rtwn_write_1(sc, R22B_REG_TCR + 1, WLAN_TX_FUNC_CFG1);
+	rtwn_write_4(sc, R22B_REG_WMAC_OPTION_FUNCTION + 8,
+	    WLAN_MAC_OPT_FUNC2);
+	rtwn_write_1(sc, R22B_REG_WMAC_OPTION_FUNCTION + 4,
+	    WLAN_MAC_OPT_NORM_FUNC1);
+	r22b_write8_set(sc, R22B_REG_SND_PTCL_CTRL,
+	    R22B_BIT_DIS_CHK_VHTSIGB_CRC);
+}
+
+/* rtw_drv_info_cfg() */
+static void
+r22b_drv_info_cfg(struct rtwn_softc *sc)
+{
+	uint8_t value8;
+
+	rtwn_write_1(sc, R22B_REG_RX_DRVINFO_SZ, R22B_PHY_STATUS_SIZE);
+	value8 = rtwn_read_1(sc, R22B_REG_TRXFF_BNDY + 1);
+	value8 &= 0xf0;
+	/* For rxdesc len = 0 issue */
+	value8 |= 0xf;
+	rtwn_write_1(sc, R22B_REG_TRXFF_BNDY + 1, value8);
+	r22b_write32_set(sc, R22B_REG_RCR, R22B_BIT_APP_PHYSTS);
+	r22b_write32_clr(sc, R22B_REG_WMAC_OPTION_FUNCTION + 4,
+	    R22B_BIT(8) | R22B_BIT(9));
+}
+
+/*
+ * rtw_mac_init() without rtw_hci_interface_cfg(), which the bus code
+ * (r22bu_dma_init()) does next.  Called through the sc_dma_init hook,
+ * i.e. after the firmware download, in place of rtwn_dma_init().
+ */
+int
+r22b_mac_init(struct rtwn_softc *sc)
+{
+	int error;
+
+	/*
+	 * rtw88 aborts rtw_power_on() when the firmware download fails;
+	 * rtwn_init() would carry on without firmware, so stop here.
+	 */
+	if (!(sc->sc_flags & RTWN_FW_LOADED)) {
+		device_printf(sc->sc_dev,
+		    "firmware is not running, cannot initialize the MAC\n");
+		return (EIO);
+	}
+
+	/* rtw_init_trx_cfg() */
+	error = r22b_txdma_queue_mapping(sc);
+	if (error != 0)
+		return (error);
+
+	error = r22b_priority_queue_cfg(sc);
+	if (error != 0)
+		return (error);
+
+	error = r22b_init_h2c(sc);
+	if (error != 0)
+		return (error);
+
+	r22b_mac_init_regs(sc);
+	r22b_drv_info_cfg(sc);
+
+	return (0);
+}
+
+/*
+ * The MAC register table.  rtw88 loads it at the start of
+ * rtw8822b_phy_set_param() (rtw_phy_load_tables()), i.e. right after
+ * rtw_mac_init(); here it is loaded at the end of the sc_dma_init hook
+ * so that the generic MAC setup rtwn_init() does afterwards (Rx filter,
+ * retry limits, beacon timing, ...) is not overwritten by it.  Only the
+ * BB "power on" writes of phy_set_param() move after it, which do not
+ * touch any register in the MAC table.
+ */
+void
+r22b_load_mac_table(struct rtwn_softc *sc)
+{
+	r22b_load_table(sc, &rtw8822b_mac_tbl);
+}
+
+/* rtw8822b_phy_set_param(), first half: BB/RF power and BB/AGC tables. */
+void
+r22b_init_bb(struct rtwn_softc *sc)
+{
+	/* power on BB/RF domain */
+	r22b_write8_set(sc, R22B_REG_SYS_FUNC_EN,
+	    R22B_BIT_FEN_BB_RSTB | R22B_BIT_FEN_BB_GLB_RST);
+	r22b_write8_set(sc, R22B_REG_RF_CTRL,
+	    R22B_BIT_RF_EN | R22B_BIT_RF_RSTB | R22B_BIT_RF_SDM_RSTB);
+	r22b_write32_set(sc, R22B_REG_WLRF1, R22B_BIT_WLRF1_BBRF_EN);
+
+	/* pre init before header files config */
+	r22b_write32_clr(sc, R22B_REG_RXPSEL, R22B_BIT_RX_PSEL_RST);
+
+	/*
+	 * rtw_phy_load_tables(): MAC (see r22b_load_mac_table()), BB, AGC;
+	 * the 8822B has no agc_btg_tbl and no rfk_init_tbl.
+	 */
+	r22b_load_table(sc, &rtw8822b_bb_tbl);
+	r22b_load_table(sc, &rtw8822b_agc_tbl);
+}
+
+/* rtw8822b_phy_set_param(), second half: RF tables and PHY setup. */
+void
+r22b_init_rf(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t crystal_cap;
+	int path;
+
+	for (path = 0; path < rs->rf_path_num; path++) {
+		r22b_load_table(sc, path == R22B_RF_PATH_A ?
+		    &rtw8822b_rf_a_tbl : &rtw8822b_rf_b_tbl);
+	}
+
+	crystal_cap = rs->crystal_cap & 0x3f;
+	r22b_write32_mask(sc, R22B_REG_AFE_XTAL_CTRL, 0x7e000000, crystal_cap);
+	r22b_write32_mask(sc, R22B_REG_AFE_PLL_CTRL, 0x7e, crystal_cap);
+
+	/* post init after header files config */
+	r22b_write32_set(sc, R22B_REG_RXPSEL, R22B_BIT_RX_PSEL_RST);
+
+	r22b_config_trx_mode(sc, rs->antenna_tx, rs->antenna_rx, 0);
+	r22b_phy_init(sc);
+
+	r22b_phy_rfe_init(sc);
+	r22b_pwrtrack_init(sc);
+
+	r22b_phy_bf_init(sc);
+}
+
+/*
+ * rtwn_init() writes a few registers with the values the older chips
+ * want after sc_dma_init; put back what rtw88 (rtw8822b_mac_init() and
+ * the MAC table) programs there.
+ */
+static void
+r22b_restore_mac_defaults(struct rtwn_softc *sc)
+{
+	static const uint8_t darfrc[8] =
+	    { 0x00, 0x00, 0x00, 0x01, 0x04, 0x05, 0x07, 0x08 };
+	static const uint8_t rarfrch[4] = { 0x04, 0x05, 0x07, 0x08 };
+	u_int i;
+
+	/* rtwn_mrr_init(); 0x438-0x43b are not in the MAC table. */
+	for (i = 0; i < nitems(darfrc); i++)
+		rtwn_write_1(sc, R22B_REG_DARFRC + i, darfrc[i]);
+	for (i = 0; i < nitems(rarfrch); i++)
+		rtwn_write_1(sc, R22B_REG_RARFRCH + i, rarfrch[i]);
+
+	/* "Disable BAR" (0x0201ffff) */
+	rtwn_write_2(sc, R22B_REG_BAR_MODE_CTRL + 2,
+	    WLAN_BAR_RETRY_LIMIT | WLAN_RA_TRY_RATE_AGG_LIMIT << 8);
+
+	/* NAV limit (MAC table) */
+	rtwn_write_1(sc, R22B_REG_NAV_UPPER, 0xc8);
+
+	/* rtwn_init_beacon_reg() */
+	rtwn_write_1(sc, R22B_REG_DRVERLYINT, WLAN_DRV_EARLY_INT);
+}
+
+/*
+ * The remainder of rtw_power_on(): rtw_mac_postinit() (nothing on the
+ * 8822B), rtw_hci_start() (nothing on USB), the H2C general and phydm
+ * info packets and the coexistence power-on settings; then the security
+ * engine enable of rtw_core_start() (rtwn_init_seccfg() has already
+ * written REG_SECCFG).
+ */
+void
+r22b_post_init(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	r22b_restore_mac_defaults(sc);
+
+	/*
+	 * rtw_sec_enable_sec_engine(): REG_CR BIT(9); the other rtwn chips
+	 * set R92C_CR_ENSEC (the same bit) in their power-on code.
+	 */
+	if (sc->sc_hwcrypto != RTWN_CRYPTO_SW)
+		r22b_write16_set(sc, R22B_REG_CR, R22B_BIT_SEC_ENGINE_EN);
+
+	/* send H2C after HCI has started */
+	r22b_fw_send_general_info(sc);
+	r22b_fw_send_phydm_info(sc);
+
+	r22b_coex_power_on_setting(sc);
+	r22b_coex_init_hw_config(sc, !rs->btcoex);
+
+	/*
+	 * TODO (phase 2): firmware rate adaptation (H2C_CMD_RA_INFO) is not
+	 * implemented; use net80211 rate control like the RTL8812AU does.
+	 */
+#ifndef RTWN_WITHOUT_UCODE
+	if (sc->sc_flags & RTWN_FW_LOADED) {
+		if (sc->sc_ratectl_sysctl == RTWN_RATECTL_FW)
+			sc->sc_ratectl = RTWN_RATECTL_NET80211;
+		else
+			sc->sc_ratectl = sc->sc_ratectl_sysctl;
+	} else
+#endif
+		sc->sc_ratectl = RTWN_RATECTL_NONE;
+}
