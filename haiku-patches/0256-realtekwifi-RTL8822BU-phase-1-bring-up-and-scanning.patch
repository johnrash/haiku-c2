+/*
+ * Indirect access to the LTE coexistence block (util.c ltecoex_read_reg()
+ * / ltecoex_reg_write()).  Return 0 or EBUSY.
+ */
+int
+r22b_ltecoex_read(struct rtwn_softc *sc, uint16_t offset, uint32_t *val)
+{
+	if (!r22b_check_hw_ready(sc, R22B_REG_LTECOEX_CTRL,
+	    R22B_BIT_LTECOEX_READY, 1))
+		return (EBUSY);
+
+	rtwn_write_4(sc, R22B_REG_LTECOEX_CTRL, 0x800f0000 | offset);
+	*val = rtwn_read_4(sc, R22B_REG_LTECOEX_READ_DATA);
+
+	return (0);
+}
+
+int
+r22b_ltecoex_write(struct rtwn_softc *sc, uint16_t offset, uint32_t value)
+{
+	if (!r22b_check_hw_ready(sc, R22B_REG_LTECOEX_CTRL,
+	    R22B_BIT_LTECOEX_READY, 1))
+		return (EBUSY);
+
+	rtwn_write_4(sc, R22B_REG_LTECOEX_WRITE_DATA, value);
+	rtwn_write_4(sc, R22B_REG_LTECOEX_CTRL, 0xc00f0000 | offset);
+
+	return (0);
+}
+
+/* check_firmware_size() */
+static int
+r22b_fw_check_size(const struct r22b_fw_hdr *hdr, size_t size)
+{
+	uint32_t dmem_size, imem_size, emem_size, real_size;
+
+	dmem_size = le32toh(hdr->dmem_size);
+	imem_size = le32toh(hdr->imem_size);
+	emem_size = (hdr->mem_usage & R22B_FW_MEM_USAGE_EMEM) ?
+	    le32toh(hdr->emem_size) : 0;
+
+	dmem_size += R22B_FW_HDR_CHKSUM_SIZE;
+	imem_size += R22B_FW_HDR_CHKSUM_SIZE;
+	emem_size += emem_size ? R22B_FW_HDR_CHKSUM_SIZE : 0;
+	real_size = R22B_FW_HDR_SIZE + dmem_size + imem_size + emem_size;
+
+	return (real_size == size);
+}
+
+/* wlan_cpu_enable() */
+static void
+r22b_wlan_cpu_enable(struct rtwn_softc *sc, int enable)
+{
+	if (enable) {
+		/* cpu io interface enable */
+		r22b_write8_set(sc, R22B_REG_RSV_CTRL + 1,
+		    R22B_BIT_WLMCU_IOIF);
+
+		/* cpu enable */
+		r22b_write8_set(sc, R22B_REG_SYS_FUNC_EN + 1,
+		    R22B_BIT_FEN_CPUEN);
+	} else {
+		/* cpu io interface disable */
+		r22b_write8_clr(sc, R22B_REG_SYS_FUNC_EN + 1,
+		    R22B_BIT_FEN_CPUEN);
+
+		/* cpu disable */
+		r22b_write8_clr(sc, R22B_REG_RSV_CTRL + 1,
+		    R22B_BIT_WLMCU_IOIF);
+	}
+}
+
+/* struct rtw_backup_info */
+struct r22b_backup_info {
+	uint8_t		len;
+	uint16_t	reg;
+	uint32_t	val;
+};
+
+#define R22B_DLFW_RESTORE_REG_NUM	6
+
+/* download_firmware_reg_backup() */
+static void
+r22b_fw_reg_backup(struct rtwn_softc *sc, struct r22b_backup_info *bckp)
+{
+	uint8_t tmp;
+	int idx = 0;
+
+	/* set HIQ to hi priority */
+	bckp[idx].len = 1;
+	bckp[idx].reg = R22B_REG_TXDMA_PQ_MAP + 1;
+	bckp[idx].val = rtwn_read_1(sc, R22B_REG_TXDMA_PQ_MAP + 1);
+	idx++;
+	tmp = R22B_DMA_MAPPING_HIGH << 6;
+	rtwn_write_1(sc, R22B_REG_TXDMA_PQ_MAP + 1, tmp);
+
+	/* DLFW only use HIQ, map HIQ to hi priority */
+	bckp[idx].len = 1;
+	bckp[idx].reg = R22B_REG_CR;
+	bckp[idx].val = rtwn_read_1(sc, R22B_REG_CR);
+	idx++;
+	bckp[idx].len = 4;
+	bckp[idx].reg = R22B_REG_H2CQ_CSR;
+	bckp[idx].val = R22B_BIT_H2CQ_FULL;
+	idx++;
+	tmp = R22B_BIT_HCI_TXDMA_EN | R22B_BIT_TXDMA_EN;
+	rtwn_write_1(sc, R22B_REG_CR, tmp);
+	rtwn_write_4(sc, R22B_REG_H2CQ_CSR, R22B_BIT_H2CQ_FULL);
+
+	/* Config hi priority queue and public priority queue page number */
+	bckp[idx].len = 2;
+	bckp[idx].reg = R22B_REG_FIFOPAGE_INFO_1;
+	bckp[idx].val = rtwn_read_2(sc, R22B_REG_FIFOPAGE_INFO_1);
+	idx++;
+	bckp[idx].len = 4;
+	bckp[idx].reg = R22B_REG_RQPN_CTRL_2;
+	bckp[idx].val = rtwn_read_4(sc, R22B_REG_RQPN_CTRL_2) |
+	    R22B_BIT_LD_RQPN;
+	idx++;
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_INFO_1, 0x200);
+	rtwn_write_4(sc, R22B_REG_RQPN_CTRL_2, bckp[idx - 1].val);
+
+	/* Disable beacon related functions */
+	tmp = rtwn_read_1(sc, R22B_REG_BCN_CTRL);
+	bckp[idx].len = 1;
+	bckp[idx].reg = R22B_REG_BCN_CTRL;
+	bckp[idx].val = tmp;
+	idx++;
+	tmp = (uint8_t)((tmp & ~R22B_BIT_EN_BCN_FUNCTION) |
+	    R22B_BIT_DIS_TSF_UDT);
+	rtwn_write_1(sc, R22B_REG_BCN_CTRL, tmp);
+
+	KASSERT(idx == R22B_DLFW_RESTORE_REG_NUM,
+	    ("%s: wrong backup number %d\n", __func__, idx));
+}
+
+/* rtw_restore_reg() */
+static void
+r22b_fw_reg_restore(struct rtwn_softc *sc, const struct r22b_backup_info *bckp,
+    int num)
+{
+	int i;
+
+	for (i = 0; i < num; i++, bckp++) {
+		switch (bckp->len) {
+		case 1:
+			rtwn_write_1(sc, bckp->reg, (uint8_t)bckp->val);
+			break;
+		case 2:
+			rtwn_write_2(sc, bckp->reg, (uint16_t)bckp->val);
+			break;
+		case 4:
+			rtwn_write_4(sc, bckp->reg, bckp->val);
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+/* download_firmware_reset_platform() */
+static void
+r22b_fw_reset_platform(struct rtwn_softc *sc)
+{
+	r22b_write8_clr(sc, R22B_REG_CPU_DMEM_CON + 2,
+	    R22B_BIT_WL_PLATFORM_RST >> 16);
+	r22b_write8_clr(sc, R22B_REG_SYS_CLK_CTRL + 1,
+	    R22B_BIT_CPU_CLK_EN >> 8);
+	r22b_write8_set(sc, R22B_REG_CPU_DMEM_CON + 2,
+	    R22B_BIT_WL_PLATFORM_RST >> 16);
+	r22b_write8_set(sc, R22B_REG_SYS_CLK_CTRL + 1,
+	    R22B_BIT_CPU_CLK_EN >> 8);
+}
+
+/*
+ * rtw_fw_write_data_rsvd_page(): put one packet into the reserved page
+ * area starting at page "pg_addr" of the Tx buffer.
+ */
+static int
+r22b_fw_write_data_rsvd_page(struct rtwn_softc *sc, uint16_t pg_addr,
+    const uint8_t *buf, int size)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t bckp[3], val;
+	int error;
+
+	if (size == 0)
+		return (EINVAL);
+
+	bckp[2] = rtwn_read_1(sc, R22B_REG_BCN_CTRL);
+
+	pg_addr &= R22B_BIT_MASK_BCN_HEAD_1_V1;
+	pg_addr |= R22B_BIT_BCN_VALID_V1;
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_CTRL_2, pg_addr);
+
+	val = rtwn_read_1(sc, R22B_REG_CR + 1);
+	bckp[0] = val;
+	val |= R22B_BIT_ENSWBCN >> 8;
+	rtwn_write_1(sc, R22B_REG_CR + 1, val);
+
+	rtwn_write_1(sc, R22B_REG_BCN_CTRL,
+	    (bckp[2] & ~R22B_BIT_EN_BCN_FUNCTION) | R22B_BIT_DIS_TSF_UDT);
+
+	/* (REG_FWHW_TXQ_CTRL + 2 is only touched for PCIe.) */
+
+	error = rs->rs_write_rsvd_page(sc, buf, size);
+	if (error != 0) {
+		device_printf(sc->sc_dev,
+		    "failed to write data to rsvd page (error %d)\n", error);
+		goto restore;
+	}
+
+	if (!r22b_check_hw_ready(sc, R22B_REG_FIFOPAGE_CTRL_2,
+	    R22B_BIT_BCN_VALID_V1, 1)) {
+		device_printf(sc->sc_dev, "error beacon valid\n");
+		error = EBUSY;
+	}
+
+restore:
+	rtwn_write_2(sc, R22B_REG_FIFOPAGE_CTRL_2,
+	    rs->rsvd_boundary | R22B_BIT_BCN_VALID_V1);
+	rtwn_write_1(sc, R22B_REG_BCN_CTRL, bckp[2]);
+	rtwn_write_1(sc, R22B_REG_CR + 1, bckp[0]);
+
+	return (error);
+}
+
+/*
+ * send_firmware_pkt(): on USB, avoid a transfer that is an exact
+ * multiple of 512 bytes (descriptor included) by sending one extra
+ * (zero) byte; "tmpbuf" has room for it.
+ */
+static int
+r22b_fw_send_pkt(struct rtwn_softc *sc, uint16_t pg_addr, const uint8_t *data,
+    int size, uint8_t *tmpbuf)
+{
+	int error;
+
+	memcpy(tmpbuf, data, size);
+	if (((size + sizeof(struct r22b_tx_desc)) & (512 - 1)) == 0)
+		tmpbuf[size++] = 0;
+
+	error = r22b_fw_write_data_rsvd_page(sc, pg_addr, tmpbuf, size);
+	if (error != 0)
+		device_printf(sc->sc_dev, "failed to download rsvd page\n");
+
+	return (error);
+}
+
+/* iddma_enable() */
+static int
+r22b_iddma_enable(struct rtwn_softc *sc, uint32_t src, uint32_t dst,
+    uint32_t ctrl)
+{
+	rtwn_write_4(sc, R22B_REG_DDMA_CH0SA, src);
+	rtwn_write_4(sc, R22B_REG_DDMA_CH0DA, dst);
+	rtwn_write_4(sc, R22B_REG_DDMA_CH0CTRL, ctrl);
+
+	if (!r22b_check_hw_ready(sc, R22B_REG_DDMA_CH0CTRL,
+	    R22B_BIT_DDMACH0_OWN, 0))
+		return (EBUSY);
+
+	return (0);
+}
+
+/* iddma_download_firmware() */
+static int
+r22b_iddma_download_firmware(struct rtwn_softc *sc, uint32_t src,
+    uint32_t dst, uint32_t len, int first)
+{
+	uint32_t ch0_ctrl = R22B_BIT_DDMACH0_CHKSUM_EN | R22B_BIT_DDMACH0_OWN;
+
+	if (!r22b_check_hw_ready(sc, R22B_REG_DDMA_CH0CTRL,
+	    R22B_BIT_DDMACH0_OWN, 0))
+		return (EBUSY);
+
+	ch0_ctrl |= len & R22B_BIT_MASK_DDMACH0_DLEN;
+	if (!first)
+		ch0_ctrl |= R22B_BIT_DDMACH0_CHKSUM_CONT;
+
+	return (r22b_iddma_enable(sc, src, dst, ch0_ctrl));
+}
+
+/* check_fw_checksum() */
+static int
+r22b_check_fw_checksum(struct rtwn_softc *sc, uint32_t addr)
+{
+	uint8_t fw_ctrl;
+
+	fw_ctrl = rtwn_read_1(sc, R22B_REG_MCUFW_CTRL);
+
+	if (rtwn_read_4(sc, R22B_REG_DDMA_CH0CTRL) &
+	    R22B_BIT_DDMACH0_CHKSUM_STS) {
+		if (addr < R22B_OCPBASE_DMEM_88XX) {
+			fw_ctrl |= R22B_BIT_IMEM_DW_OK;
+			fw_ctrl &= ~R22B_BIT_IMEM_CHKSUM_OK;
+		} else {
+			fw_ctrl |= R22B_BIT_DMEM_DW_OK;
+			fw_ctrl &= ~R22B_BIT_DMEM_CHKSUM_OK;
+		}
+		rtwn_write_1(sc, R22B_REG_MCUFW_CTRL, fw_ctrl);
+
+		device_printf(sc->sc_dev, "invalid fw checksum\n");
+
+		return (0);
+	}
+
+	if (addr < R22B_OCPBASE_DMEM_88XX)
+		fw_ctrl |= R22B_BIT_IMEM_DW_OK | R22B_BIT_IMEM_CHKSUM_OK;
+	else
+		fw_ctrl |= R22B_BIT_DMEM_DW_OK | R22B_BIT_DMEM_CHKSUM_OK;
+	rtwn_write_1(sc, R22B_REG_MCUFW_CTRL, fw_ctrl);
+
+	return (1);
+}
+
+/* download_firmware_to_mem() */
+static int
+r22b_download_firmware_to_mem(struct rtwn_softc *sc, const uint8_t *data,
+    uint32_t src, uint32_t dst, uint32_t size, uint8_t *tmpbuf)
+{
+	const uint32_t desc_size = sizeof(struct r22b_tx_desc);
+	uint32_t mem_offset, residue_size, pkt_size, val;
+	int first_part, error;
+
+	mem_offset = 0;
+	first_part = 1;
+	residue_size = size;
+
+	val = rtwn_read_4(sc, R22B_REG_DDMA_CH0CTRL);
+	val |= R22B_BIT_DDMACH0_RESET_CHKSUM_STS;
+	rtwn_write_4(sc, R22B_REG_DDMA_CH0CTRL, val);
+
+	while (residue_size) {
+		if (residue_size >= R22B_FW_DL_MAX_SIZE)
+			pkt_size = R22B_FW_DL_MAX_SIZE;
+		else
+			pkt_size = residue_size;
+
+		error = r22b_fw_send_pkt(sc, (uint16_t)(src >> 7),
+		    data + mem_offset, pkt_size, tmpbuf);
+		if (error != 0)
+			return (error);
+
+		error = r22b_iddma_download_firmware(sc,
+		    R22B_OCPBASE_TXBUF_88XX + src + desc_size,
+		    dst + mem_offset, pkt_size, first_part);
+		if (error != 0) {
+			device_printf(sc->sc_dev,
+			    "%s: DDMA timeout (dst 0x%x, offset %u)\n",
+			    __func__, dst, mem_offset);
+			return (error);
+		}
+
+		first_part = 0;
+		mem_offset += pkt_size;
+		residue_size -= pkt_size;
+	}
+
+	if (!r22b_check_fw_checksum(sc, dst))
+		return (EINVAL);
+
+	return (0);
+}
+
+/* start_download_firmware() */
+static int
+r22b_start_download_firmware(struct rtwn_softc *sc, const uint8_t *data,
+    uint8_t *tmpbuf)
+{
+	const struct r22b_fw_hdr *hdr = (const struct r22b_fw_hdr *)data;
+	const uint8_t *cur_fw;
+	uint32_t imem_size, dmem_size, emem_size, addr;
+	uint16_t val;
+	int error;
+
+	dmem_size = le32toh(hdr->dmem_size);
+	imem_size = le32toh(hdr->imem_size);
+	emem_size = (hdr->mem_usage & R22B_FW_MEM_USAGE_EMEM) ?
+	    le32toh(hdr->emem_size) : 0;
+	dmem_size += R22B_FW_HDR_CHKSUM_SIZE;
+	imem_size += R22B_FW_HDR_CHKSUM_SIZE;
+	emem_size += emem_size ? R22B_FW_HDR_CHKSUM_SIZE : 0;
+
+	val = (uint16_t)(rtwn_read_2(sc, R22B_REG_MCUFW_CTRL) & 0x3800);
+	val |= R22B_BIT_MCUFWDL_EN;
+	rtwn_write_2(sc, R22B_REG_MCUFW_CTRL, val);
+
+	cur_fw = data + R22B_FW_HDR_SIZE;
+	addr = le32toh(hdr->dmem_addr);
+	addr &= ~R22B_BIT(31);
+	error = r22b_download_firmware_to_mem(sc, cur_fw, 0, addr, dmem_size,
+	    tmpbuf);
+	if (error != 0)
+		return (error);
+
+	cur_fw = data + R22B_FW_HDR_SIZE + dmem_size;
+	addr = le32toh(hdr->imem_addr);
+	addr &= ~R22B_BIT(31);
+	error = r22b_download_firmware_to_mem(sc, cur_fw, 0, addr, imem_size,
+	    tmpbuf);
+	if (error != 0)
+		return (error);
+
+	if (emem_size) {
+		cur_fw = data + R22B_FW_HDR_SIZE + dmem_size + imem_size;
+		addr = le32toh(hdr->emem_addr);
+		addr &= ~R22B_BIT(31);
+		error = r22b_download_firmware_to_mem(sc, cur_fw, 0, addr,
+		    emem_size, tmpbuf);
+		if (error != 0)
+			return (error);
+	}
+
+	return (0);
+}
+
+/* download_firmware_validate() */
+static int
+r22b_download_firmware_validate(struct rtwn_softc *sc)
+{
+	uint32_t fw_key;
+
+	if (!r22b_check_hw_ready(sc, R22B_REG_MCUFW_CTRL, R22B_FW_READY_MASK,
+	    R22B_FW_READY)) {
+		fw_key = rtwn_read_4(sc, R22B_REG_FW_DBG7) & R22B_FW_KEY_MASK;
+		if (fw_key == R22B_ILLEGAL_KEY_GROUP)
+			device_printf(sc->sc_dev, "invalid fw key\n");
+		device_printf(sc->sc_dev,
+		    "firmware is not ready (MCUFW_CTRL 0x%04x)\n",
+		    rtwn_read_2(sc, R22B_REG_MCUFW_CTRL));
+		return (EINVAL);
+	}
+
+	return (0);
+}
+
+/* download_firmware_end_flow() */
+static void
+r22b_download_firmware_end_flow(struct rtwn_softc *sc)
+{
+	uint16_t fw_ctrl;
+
+	rtwn_write_4(sc, R22B_REG_TXDMA_STATUS, R22B_BIT_PAGE_OVF);
+
+	/* Check IMEM & DMEM checksum is OK or not */
+	fw_ctrl = rtwn_read_2(sc, R22B_REG_MCUFW_CTRL);
+	if ((fw_ctrl & R22B_BIT_CHECK_SUM_OK) != R22B_BIT_CHECK_SUM_OK)
+		return;
+
+	fw_ctrl = (fw_ctrl | R22B_BIT_FW_DW_RDY) & ~R22B_BIT_MCUFWDL_EN;
+	rtwn_write_2(sc, R22B_REG_MCUFW_CTRL, fw_ctrl);
+}
+
+/* __rtw_download_firmware() */
+static int
+r22b_download_firmware(struct rtwn_softc *sc, const uint8_t *data,
+    uint8_t *tmpbuf)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	struct r22b_backup_info bckp[R22B_DLFW_RESTORE_REG_NUM];
+	uint32_t ltecoex_bckp;
+	int error;
+
+	error = r22b_ltecoex_read(sc, 0x38, &ltecoex_bckp);
+	if (error != 0) {
+		device_printf(sc->sc_dev, "%s: LTE coex access timeout\n",
+		    __func__);
+		return (error);
+	}
+
+	r22b_wlan_cpu_enable(sc, 0);
+
+	r22b_fw_reg_backup(sc, bckp);
+	r22b_fw_reset_platform(sc);
+
+	error = r22b_start_download_firmware(sc, data, tmpbuf);
+	if (error != 0)
+		goto dlfw_fail;
+
+	r22b_fw_reg_restore(sc, bckp, R22B_DLFW_RESTORE_REG_NUM);
+
+	r22b_download_firmware_end_flow(sc);
+
+	r22b_wlan_cpu_enable(sc, 1);
+
+	error = r22b_ltecoex_write(sc, 0x38, ltecoex_bckp);
+	if (error != 0)
+		goto dlfw_fail;
+
+	error = r22b_download_firmware_validate(sc);
+	if (error != 0)
+		goto dlfw_fail;
+
+	/* reset desc and index (rtw_hci_setup() is empty on USB) */
+	rs->h2c_last_box = 0;
+	rs->h2c_seq = 0;
+
+	return (0);
+
+dlfw_fail:
+	/* Disable FWDL_EN */
+	r22b_write8_clr(sc, R22B_REG_MCUFW_CTRL, R22B_BIT_MCUFWDL_EN);
+	r22b_write8_set(sc, R22B_REG_SYS_FUNC_EN + 1, R22B_BIT_FEN_CPUEN);
+
+	return (error);
+}
+
+/*
+ * sc_fw_download hook (rtwn_init() calls it instead of
+ * rtwn_load_firmware()): rtw_load_firmware() + __update_firmware_info()
+ * + rtw_download_firmware().
+ */
+int
+r22b_fw_download(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	const struct firmware *fw;
+	const struct r22b_fw_hdr *hdr;
+	uint8_t *tmpbuf;
+	int error;
+
+	/* Read firmware image from the filesystem. */
+	RTWN_UNLOCK(sc);
+	fw = firmware_get(sc->fwname);
+	tmpbuf = malloc(R22B_FW_DL_MAX_SIZE + 1, M_TEMP, M_WAITOK);
+	RTWN_LOCK(sc);
+	if (fw == NULL) {
+		device_printf(sc->sc_dev,
+		    "failed loadfirmware of file %s\n", sc->fwname);
+		free(tmpbuf, M_TEMP);
+		return (ENOENT);
+	}
+
+	if (fw->datasize < R22B_FW_HDR_SIZE ||
+	    fw->datasize > (size_t)sc->fwsize_limit) {
+		device_printf(sc->sc_dev, "wrong firmware size (%zu)\n",
+		    (size_t)fw->datasize);
+		error = EINVAL;
+		goto fail;
+	}
+
+	hdr = (const struct r22b_fw_hdr *)fw->data;
+	if (!r22b_fw_check_size(hdr, fw->datasize)) {
+		device_printf(sc->sc_dev,
+		    "firmware size %zu does not match its header\n",
+		    (size_t)fw->datasize);
+		error = EINVAL;
+		goto fail;
+	}
+
+	rs->fw_h2c_version = le16toh(hdr->h2c_fmt_ver);
+	rs->fw_version = le16toh(hdr->version);
+	rs->fw_sub_version = hdr->subversion;
+	rs->fw_sub_index = hdr->subindex;
+	rs->fw_feature = le32toh(hdr->feature);
+	if (!(rs->fw_feature & R22B_FW_FEATURE_SIG))
+		rs->fw_feature = 0;
+	sc->fwver = rs->fw_version;
+
+	device_printf(sc->sc_dev,
+	    "firmware version %u.%u.%u, H2C version %u\n",
+	    rs->fw_version, rs->fw_sub_version, rs->fw_sub_index,
+	    rs->fw_h2c_version);
+
+	error = r22b_download_firmware(sc, fw->data, tmpbuf);
+	if (error != 0) {
+		device_printf(sc->sc_dev,
+		    "failed to download firmware (error %d)\n", error);
+	}
+
+fail:
+	firmware_put(fw, FIRMWARE_UNLOAD);
+	free(tmpbuf, M_TEMP);
+	return (error);
+}
+
+/*
+ * rtw_fw_send_h2c_command(): 8-byte command through the HMEBOX mailboxes.
+ */
+int
+r22b_fw_cmd(struct rtwn_softc *sc, const uint8_t *h2c)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint16_t box_reg, box_ex_reg;
+	uint8_t box, box_state;
+	int ntries;
+
+	RTWN_ASSERT_LOCKED(sc);
+
+	if (!(sc->sc_flags & RTWN_FW_LOADED)) {
+		RTWN_DPRINTF(sc, RTWN_DEBUG_FIRMWARE,
+		    "%s: firmware is not running\n", __func__);
+		return (ENXIO);
+	}
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_FIRMWARE,
+	    "send H2C content %02x%02x%02x%02x %02x%02x%02x%02x\n",
+	    h2c[3], h2c[2], h2c[1], h2c[0],
+	    h2c[7], h2c[6], h2c[5], h2c[4]);
+
+	box = rs->h2c_last_box;
+	box_reg = R22B_REG_HMEBOX0 + box * 4;
+	box_ex_reg = R22B_REG_HMEBOX0_EX + box * 4;
+
+	/* read_poll_timeout_atomic(..., 100, 3000, ...) */
+	for (ntries = 0; ntries < 30; ntries++) {
+		box_state = rtwn_read_1(sc, R22B_REG_HMETFR);
+		if (!((box_state >> box) & 0x1))
+			break;
+		rtwn_delay(sc, 100);
+	}
+	if (ntries == 30) {
+		device_printf(sc->sc_dev, "failed to send h2c command\n");
+		return (ETIMEDOUT);
+	}
+
+	rtwn_write_4(sc, box_ex_reg, le32dec(h2c + 4));
+	rtwn_write_4(sc, box_reg, le32dec(h2c));
+
+	if (++rs->h2c_last_box >= 4)
+		rs->h2c_last_box = 0;
+
+	return (0);
+}
+
+/* rtw_h2c_pkt_set_header() */
+static void
+r22b_h2c_pkt_set_header(uint8_t *h2c_pkt, uint8_t sub_id)
+{
+	r22b_h2c_set(h2c_pkt, 0, R22B_GENMASK(6, 0), R22B_H2C_PKT_CATEGORY);
+	r22b_h2c_set(h2c_pkt, 0, R22B_GENMASK(15, 8), R22B_H2C_PKT_CMD_ID);
+	r22b_h2c_set(h2c_pkt, 0, R22B_GENMASK(31, 16), sub_id);
+}
+
+/*
+ * rtw_fw_send_h2c_packet(): 32-byte packet through the H2C queue
+ * (on USB a QSEL_H2C packet on the high priority bulk-out pipe).
+ */
+int
+r22b_fw_send_h2c_pkt(struct rtwn_softc *sc, uint8_t *h2c_pkt)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	int error;
+
+	RTWN_ASSERT_LOCKED(sc);
+
+	if (!(sc->sc_flags & RTWN_FW_LOADED))
+		return (ENXIO);
+
+	/* FW_OFFLOAD_H2C_SET_SEQ_NUM */
+	r22b_h2c_set(h2c_pkt, 1, R22B_GENMASK(31, 16), rs->h2c_seq);
+	error = rs->rs_write_h2c_pkt(sc, h2c_pkt, R22B_H2C_PKT_SIZE);
+	if (error != 0) {
+		device_printf(sc->sc_dev,
+		    "failed to send h2c packet (error %d)\n", error);
+	}
+	rs->h2c_seq++;
+
+	return (error);
+}
+
+/* rtw_fw_send_general_info() */
+void
+r22b_fw_send_general_info(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t h2c_pkt[R22B_H2C_PKT_SIZE] = { 0 };
+	const uint16_t total_size = R22B_H2C_PKT_HDR_SIZE + 4;
+
+	r22b_h2c_pkt_set_header(h2c_pkt, R22B_H2C_PKT_GENERAL_INFO);
+
+	/* SET_PKT_H2C_TOTAL_LEN */
+	r22b_h2c_set(h2c_pkt, 1, R22B_GENMASK(15, 0), total_size);
+
+	/* GENERAL_INFO_SET_FW_TX_BOUNDARY */
+	r22b_h2c_set(h2c_pkt, 2, R22B_GENMASK(23, 16),
+	    rs->rsvd_fw_txbuf_addr - rs->rsvd_boundary);
+
+	(void)r22b_fw_send_h2c_pkt(sc, h2c_pkt);
+}
+
+/* rtw_fw_send_phydm_info() */
+void
+r22b_fw_send_phydm_info(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t h2c_pkt[R22B_H2C_PKT_SIZE] = { 0 };
+	const uint16_t total_size = R22B_H2C_PKT_HDR_SIZE + 8;
+	uint8_t fw_rf_type;
+
+	if (rs->rf_path_num == 1)
+		fw_rf_type = R22B_FW_RF_1T1R;
+	else
+		fw_rf_type = R22B_FW_RF_2T2R;
+
+	r22b_h2c_pkt_set_header(h2c_pkt, R22B_H2C_PKT_PHYDM_INFO);
+
+	r22b_h2c_set(h2c_pkt, 1, R22B_GENMASK(15, 0), total_size);
+	/* PHYDM_INFO_SET_REF_TYPE, _RF_TYPE, _CUT_VER */
+	r22b_h2c_set(h2c_pkt, 2, R22B_GENMASK(7, 0), rs->rfe_option);
+	r22b_h2c_set(h2c_pkt, 2, R22B_GENMASK(15, 8), fw_rf_type);
+	r22b_h2c_set(h2c_pkt, 2, R22B_GENMASK(23, 16), rs->cut_version);
+	/* rtw88 passes antenna_tx as "RX" and antenna_rx as "TX" status. */
+	r22b_h2c_set(h2c_pkt, 2, R22B_GENMASK(27, 24), rs->antenna_tx);
+	r22b_h2c_set(h2c_pkt, 2, R22B_GENMASK(31, 28), rs->antenna_rx);
+
+	(void)r22b_fw_send_h2c_pkt(sc, h2c_pkt);
+}
+
+/*
+ * TODO (phase 2): media status report.  rtw88 (rtw_fw_media_status_report())
+ * sends H2C_CMD_MEDIA_STATUS_RPT (0x01) with
+ *	byte 0 = 0x01, dword 0 BIT(8) = connected, dword 0 [23:16] = macid
+ * on association/disassociation; it is needed before firmware rate
+ * adaptation (H2C_CMD_RA_INFO, rtw_fw_send_ra_info()) and power save.
+ * "macid" here is rtwn's (id | RTWN_MACID_VALID) for connect and the
+ * plain id for disconnect, see rtwn_newassoc() / rtwn_node_free().
+ */
+void
+r22b_set_media_status(struct rtwn_softc *sc, int macid)
+{
+	RTWN_DPRINTF(sc, RTWN_DEBUG_RA, "%s: macid 0x%x (not implemented)\n",
+	    __func__, macid);
+}
+
+/*
+ * TODO (later phase): reserved pages (null data, PS-Poll, ...) and
+ * power save (H2C_CMD_SET_PWR_MODE, rtw_fw_set_pwr_mode()).  Not reached
+ * while IEEE80211_C_PMGT is off (it is off in rtwn_attach()).
+ */
+int
+r22b_set_rsvd_page(struct rtwn_softc *sc, int probe_resp, int null,
+    int qos_null)
+{
+	return (EOPNOTSUPP);
+}
+
+int
+r22b_set_pwrmode(struct rtwn_softc *sc, struct ieee80211vap *vap, int off)
+{
+	return (EOPNOTSUPP);
+}
