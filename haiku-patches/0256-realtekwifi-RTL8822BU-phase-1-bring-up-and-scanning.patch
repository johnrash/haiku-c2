+
+#ifndef R22B_FW_CMD_H
+#define R22B_FW_CMD_H
+
+/*
+ * Firmware image header (rtw88 fw.h, struct rtw_fw_hdr).  This is the
+ * format of linux-firmware's rtw88/rtw8822b_fw.bin, not rtwn's
+ * struct r92c_fw_hdr.
+ */
+struct r22b_fw_hdr {
+	uint16_t	signature;
+	uint8_t		category;
+	uint8_t		function;
+	uint16_t	version;	/* 0x04 */
+	uint8_t		subversion;
+	uint8_t		subindex;
+	uint32_t	rsvd;		/* 0x08 */
+	uint32_t	feature;	/* 0x0c */
+	uint8_t		month;		/* 0x10 */
+	uint8_t		day;
+	uint8_t		hour;
+	uint8_t		min;
+	uint16_t	year;		/* 0x14 */
+	uint16_t	rsvd3;
+	uint8_t		mem_usage;	/* 0x18 */
+	uint8_t		rsvd4[3];
+	uint16_t	h2c_fmt_ver;	/* 0x1c */
+	uint16_t	rsvd5;
+	uint32_t	dmem_addr;	/* 0x20 */
+	uint32_t	dmem_size;
+	uint32_t	rsvd6;
+	uint32_t	rsvd7;
+	uint32_t	imem_size;	/* 0x30 */
+	uint32_t	emem_size;
+	uint32_t	emem_addr;
+	uint32_t	imem_addr;
+} __packed;
+
+#define R22B_FW_HDR_SIZE		64
+#define R22B_FW_HDR_CHKSUM_SIZE		8
+#define R22B_FW_MEM_USAGE_EMEM		0x10	/* mem_usage BIT(4) */
+#define R22B_FW_FEATURE_SIG		0x01
+
+/* Firmware download (rtw88 mac.c / mac.h). */
+#define R22B_FW_DL_MAX_SIZE		0x1000	/* bytes per rsvd page chunk */
+#define R22B_OCPBASE_TXBUF_88XX		0x18780000
+#define R22B_OCPBASE_DMEM_88XX		0x00200000
+
+/*
+ * H2C packets (sent through the H2C queue; rtw88 fw.h "PKT H2C").
+ */
+#define R22B_H2C_PKT_SIZE		32
+#define R22B_H2C_PKT_HDR_SIZE		8
+#define R22B_H2C_PKT_CATEGORY		0x01
+#define R22B_H2C_PKT_CMD_ID		0xff
+#define R22B_H2C_PKT_GENERAL_INFO	0x0d
+#define R22B_H2C_PKT_IQK		0x0e
+#define R22B_H2C_PKT_PHYDM_INFO		0x11
+
+/* rtw88 enum rtw_fw_rf_type */
+#define R22B_FW_RF_2T2R			2
+#define R22B_FW_RF_1T1R			4
+
+/*
+ * H2C commands (sent through the HMEBOX mailboxes; rtw88 fw.h "Command
+ * H2C").  Byte 0 is the command id.
+ */
+#define R22B_H2C_CMD_MEDIA_STATUS_RPT	0x01
+#define R22B_H2C_CMD_SET_PWR_MODE	0x20
+#define R22B_H2C_CMD_RA_INFO		0x40
+#define R22B_H2C_CMD_RSSI_MONITOR	0x42
+#define R22B_H2C_CMD_COEX_TDMA_TYPE	0x60
+#define R22B_H2C_CMD_QUERY_BT_INFO	0x61
+#define R22B_H2C_CMD_BT_WIFI_CONTROL	0x69
+
+/* H2C_CMD_BT_WIFI_CONTROL op codes (rtw88 coex.h). */
+#define R22B_COEX_H2C69_WL_LEAKAP	0x0c
+#define R22B_PARA1_H2C69_DIS_5MS	0x01
+
+/* C2H events (rtw88 fw.h, enum rtw_c2h_cmd_id). */
+#define R22B_C2H_CCX_TX_RPT		0x03
+#define R22B_C2H_BT_INFO		0x09
+#define R22B_C2H_RA_RPT			0x0c
+#define R22B_C2H_HW_FEATURE_REPORT	0x19
+#define R22B_C2H_HALMAC			0xff
+
+#endif	/* R22B_FW_CMD_H */
diff --git a/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_init.c b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_init.c
new file mode 100644
index 0000000000..740194f865
--- /dev/null
+++ b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_init.c
@@ -0,0 +1,1289 @@
+/*-
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright(c) 2018-2019  Realtek Corporation
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ *
+ * Derived from Linux's rtw88 driver (v7.0), used under its BSD-3-Clause option;
+ * see LICENSE.rtw88 in this directory.
+ */
+
+/*
+ * RTL8822B power on/off and MAC/BB/RF initialization.
+ *
+ * rtw88's rtw_power_on() maps onto rtwn_init() like this:
