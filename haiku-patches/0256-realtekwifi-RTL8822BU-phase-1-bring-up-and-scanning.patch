+
+#ifndef R22B_VAR_H
+#define R22B_VAR_H
+
+#include <dev/rtwn/rtl8822b/r22b.h>
+
+struct r22b_table;
+
+/* rtw88 main.h: enum rtw_dma_mapping */
+#define R22B_DMA_MAPPING_EXTRA		0
+#define R22B_DMA_MAPPING_LOW		1
+#define R22B_DMA_MAPPING_NORMAL		2
+#define R22B_DMA_MAPPING_HIGH		3
+#define R22B_DMA_MAPPING_MAX		4
+
+/* rtw88 main.h: struct rtw_rqpn (Tx queue -> DMA priority) */
+struct r22b_rqpn {
+	uint8_t		dma_map_vo;
+	uint8_t		dma_map_vi;
+	uint8_t		dma_map_be;
+	uint8_t		dma_map_bk;
+	uint8_t		dma_map_mg;
+	uint8_t		dma_map_hi;
+};
+
+/* rtw88 main.h: struct rtw_page_table (pages per DMA priority) */
+struct r22b_page_table {
+	uint16_t	hq_num;
+	uint16_t	nq_num;
+	uint16_t	lq_num;
+	uint16_t	exq_num;
+	uint16_t	gapq_num;
+};
+
+/*
+ * Per-path tx power index groups from the efuse (rtw88 main.h, struct
+ * rtw_txpwr_idx), with the 4-bit signed differences sign-extended.
+ */
+struct r22b_txpwr_idx {
+	uint8_t		cck_base_2g[R22B_GROUP_2G_CCK];
+	uint8_t		bw40_base_2g[R22B_GROUP_2G];
+	int8_t		ht_1s_ofdm_2g;
+	int8_t		ht_1s_bw20_2g;
+	int8_t		ht_ns_bw20_2g[3];	/* 2S, 3S, 4S */
+	int8_t		ht_ns_bw40_2g[3];
+	uint8_t		bw40_base_5g[R22B_GROUP_5G];
+	int8_t		ht_1s_ofdm_5g;
+	int8_t		ht_1s_bw20_5g;
+	int8_t		ht_ns_bw20_5g[3];
+	int8_t		ht_ns_bw40_5g[3];
+	int8_t		vht_bw80_5g[4];		/* 1S .. 4S */
+};
+
+struct r22b_softc {
+	/* Chip identification (rtw_chip_parameter_setup()). */
+	uint32_t	chip_version;		/* REG_SYS_CFG1 */
+	uint8_t		cut_version;
+	uint8_t		rf_path_num;
+	uint8_t		antenna_tx;		/* R22B_BB_PATH_* */
+	uint8_t		antenna_rx;
+
+	/* Efuse contents (rtw8822b_read_efuse()). */
+	uint8_t		rfe_option;
+	uint8_t		rf_board_option;
+	uint8_t		crystal_cap;
+	uint8_t		pa_type_2g;
+	uint8_t		pa_type_5g;
+	uint8_t		lna_type_2g;
+	uint8_t		lna_type_5g;
+	uint8_t		channel_plan;
+	uint8_t		country_code[2];
+	uint8_t		bt_setting;
+	uint8_t		regd;
+	uint8_t		thermal_meter;
+	uint8_t		usb_mode_switch;
+	uint8_t		share_ant:1,
+			btcoex:1,
+			ext_pa_2g:1,
+			ext_lna_2g:1,
+			ext_pa_5g:1,
+			ext_lna_5g:1,
+			rfe_supported:1,
+			efuse_powered:1;
+	struct r22b_txpwr_idx txpwr_idx[R22B_RF_PATH_MAX];
+
+	/* RFE dependent tables (rtw8822b_rfe_defs[]). */
+	const struct r22b_table	*pg_tbl;
+	const struct r22b_table	*lmt_tbl;
+
+	/* Bus glue (USB): Tx queue mapping and raw packet output. */
+	const struct r22b_rqpn		*rqpn;
+	const struct r22b_page_table	*page_table;
+	int		(*rs_write_rsvd_page)(struct rtwn_softc *,
+			    const uint8_t *, int);
+	int		(*rs_write_h2c_pkt)(struct rtwn_softc *,
+			    const uint8_t *, int);
+	void		(*rs_set_rx_agg)(struct rtwn_softc *, int);
+
+	/* Tx FIFO layout (rtw_set_trx_fifo_info()), in pages. */
+	uint16_t	rsvd_boundary;
+	uint16_t	rsvd_drv_addr;
+	uint16_t	rsvd_h2c_info_addr;
+	uint16_t	rsvd_h2c_sta_info_addr;
+	uint16_t	rsvd_h2cq_addr;
+	uint16_t	rsvd_cpu_instr_addr;
+	uint16_t	rsvd_fw_txbuf_addr;
+	uint16_t	acq_pg_num;
+
+	/* Firmware (rtw_fw_state). */
+	uint16_t	fw_version;
+	uint8_t		fw_sub_version;
+	uint8_t		fw_sub_index;
+	uint16_t	fw_h2c_version;
+	uint32_t	fw_feature;
+	uint8_t		h2c_last_box;		/* rtwdev->h2c.last_box_num */
+	uint16_t	h2c_seq;		/* rtwdev->h2c.seq */
+
+	/* Current channel (rtw_update_channel()). */
+	uint8_t		cur_chan;		/* center channel */
+	uint8_t		cur_pri_chan;
+	uint8_t		cur_bw;			/* R22B_CHANNEL_WIDTH_* */
+	uint8_t		cur_pri_idx;		/* R22B_SC_* */
+	uint8_t		cch_by_bw[R22B_CHANNEL_WIDTH_MAX];
+
+	/* PHY dynamic state (rtw_dm_info subset). */
+	uint8_t		igi_default;		/* dm_info->igi_history[0] */
+	uint8_t		default_ofdm_index;	/* rtw8822b_pwrtrack_init() */
+
+	/* Tx power (rtw_hal subset; regulatory domain WW only). */
+	int8_t		pwr_by_rate_2g[R22B_RF_PATH_MAX][R22B_RATE_MAX];
+	int8_t		pwr_by_rate_5g[R22B_RF_PATH_MAX][R22B_RATE_MAX];
+	int8_t		pwr_by_rate_base_2g[R22B_RF_PATH_MAX][R22B_RS_NUM];
+	int8_t		pwr_by_rate_base_5g[R22B_RF_PATH_MAX][R22B_RS_NUM];
+	int8_t		pwr_lmt_2g[R22B_CHANNEL_WIDTH_MAX][R22B_RS_NUM]
+			    [R22B_MAX_CHANNEL_NUM_2G];
+	int8_t		pwr_lmt_5g[R22B_CHANNEL_WIDTH_MAX][R22B_RS_NUM]
+			    [R22B_MAX_CHANNEL_NUM_5G];
+	uint8_t		tx_pwr_tbl[R22B_RF_PATH_MAX][R22B_RATE_MAX];
+
+	/* Coexistence, wifi-only subset (rtw_coex). */
+	uint16_t	coex_score_board;
+	uint16_t	coex_cur_switch_status;
+	uint8_t		coex_cur_ant_pos_type;
+	uint8_t		coex_bt_disabled:1,
+			coex_wl_slot_extend:1;
+
+	/* net80211 methods wrapped by the chip code. */
+	void		(*rs_scan_start)(struct ieee80211com *);
+	void		(*rs_scan_end)(struct ieee80211com *);
+};
+
+/* r22b_init.c; indexed by the number of bulk-out endpoints (2..4). */
+extern const struct r22b_page_table r22b_page_table[5];
+extern const struct r22b_rqpn r22b_rqpn_table[5];
+
+#endif	/* R22B_VAR_H */
