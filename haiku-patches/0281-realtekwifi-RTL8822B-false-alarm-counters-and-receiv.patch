+/*
+ * rtw8822b_false_alarm_statistics(): the false alarm count since the last
+ * call, and the PHY's counters reset.
+ */
+static uint32_t
+r22b_false_alarm_statistics(struct rtwn_softc *sc)
+{
+	uint32_t count;
+
+	count = rtwn_read_2(sc, 0xf48);
+	if (rtwn_read_4(sc, 0x808) & R22B_BIT(28))
+		count += rtwn_read_2(sc, 0xa5c);
+
+	r22b_write32_set(sc, 0x9a4, R22B_BIT(17));
+	r22b_write32_clr(sc, 0x9a4, R22B_BIT(17));
+	r22b_write32_clr(sc, 0xa2c, R22B_BIT(15));
+	r22b_write32_set(sc, 0xa2c, R22B_BIT(15));
+	r22b_write32_set(sc, 0xb58, R22B_BIT(0));
+	r22b_write32_clr(sc, 0xb58, R22B_BIT(0));
+
+	return (count);
+}
+
+/* rtw_phy_dig_check_damping() */
+static int
+r22b_dig_check_damping(struct r22b_softc *rs)
+{
+	const uint16_t fa_lo = R22B_DIG_PERF_FA_TH_LOW;
+	const uint16_t fa_hi = R22B_DIG_PERF_FA_TH_HIGH;
+	const uint8_t *igi = rs->igi_history;
+	const uint16_t *fa = rs->fa_history;
+	int damping = 0;
+
+	if (rs->damping) {
+		int diff = abs((int)rs->min_rssi - (int)rs->damping_rssi);
+		if (diff > 3 || rs->damping_cnt++ > 20) {
+			rs->damping = 0;
+			return (0);
+		}
+		return (1);
+	}
+
+	switch (rs->igi_bitmap & 0xf) {
+	case 5:
+		/* down -> up -> down -> up */
+		if (igi[0] > igi[1] && igi[2] > igi[3] &&
+		    igi[0] - igi[1] >= 2 && igi[2] - igi[3] >= 2 &&
+		    fa[0] > fa_hi && fa[1] < fa_lo &&
+		    fa[2] > fa_hi && fa[3] < fa_lo)
+			damping = 1;
+		break;
+	case 9:
+		/* up -> down -> down -> up */
+		if (igi[0] > igi[1] && igi[3] > igi[2] &&
+		    igi[0] - igi[1] >= 4 && igi[3] - igi[2] >= 2 &&
+		    fa[0] > fa_hi && fa[1] < fa_lo &&
+		    fa[2] < fa_lo && fa[3] > fa_hi)
+			damping = 1;
+		break;
+	default:
+		return (0);
+	}
+
+	if (damping) {
+		rs->damping = 1;
+		rs->damping_cnt = 0;
+		rs->damping_rssi = rs->min_rssi;
+	}
+	return (damping);
+}
+
+/*
+ * rtw_phy_dig() while linked, which is when it is called here: the receive
+ * gain follows the false alarm count, within bounds from the weakest
+ * station's signal.
+ */
+static void
+r22b_dig(struct rtwn_softc *sc, uint32_t fa_cnt)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint16_t fa_th[3] = { R22B_DIG_PERF_FA_TH_EXTRA_HIGH,
+	    R22B_DIG_PERF_FA_TH_HIGH, R22B_DIG_PERF_FA_TH_LOW };
+	uint8_t step[3] = { 4, 3, 2 };
+	uint8_t pre_igi, min_rssi, lower, upper, dig_max;
+	int cur_igi, level;
+
+	if (r22b_dig_check_damping(rs))
+		return;
+
+	pre_igi = rs->igi_history[0];
+	if (rs->pre_min_rssi > rs->min_rssi) {
+		step[0] = 6;
+		step[1] = 4;
+		step[2] = 2;
+	}
+
+	/* the step size is offset by -2 */
+	cur_igi = pre_igi;
+	for (level = 0; level < 3; level++) {
+		if (fa_cnt > fa_th[level]) {
+			cur_igi += step[level];
+			break;
+		}
+	}
+	cur_igi -= 2;
+
+	/* rtw_phy_dig_get_boundary(), linked */
+	min_rssi = MAX(rs->min_rssi, R22B_DIG_CVRG_MIN);
+	dig_max = MIN(R22B_DIG_PERF_MAX, min_rssi + R22B_DIG_RSSI_GAIN_OFFSET);
+	lower = MIN(min_rssi, R22B_DIG_PERF_MID);
+	upper = MIN(lower + R22B_DIG_RSSI_GAIN_OFFSET, dig_max);
+	if (cur_igi < lower)
+		cur_igi = lower;
+	else if (cur_igi > upper)
+		cur_igi = upper;
+
+	/* rtw_phy_dig_recorder() */
+	rs->igi_bitmap = (rs->igi_bitmap << 1 & 0xfe) |
+	    (cur_igi > rs->igi_history[0]);
+	memmove(rs->igi_history + 1, rs->igi_history,
+	    3 * sizeof(rs->igi_history[0]));
+	rs->igi_history[0] = cur_igi;
+	memmove(rs->fa_history + 1, rs->fa_history,
+	    3 * sizeof(rs->fa_history[0]));
+	rs->fa_history[0] = fa_cnt > 0xffff ? 0xffff : fa_cnt;
+
+	if (cur_igi != pre_igi)
+		r22b_dig_write(sc, cur_igi);
+}
+
+/*
+ * What is ported of rtw_phy_dynamic_mechanism(), every 2 seconds while
+ * associated, with the weakest station's signal on rtw88's 0..100 scale:
+ * rtw_phy_stat_false_alarm() and rtw_phy_dig().
+ */
+void
+r22b_phy_dynamic_mechanism(struct rtwn_softc *sc, uint8_t min_rssi)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t fa_cnt;
+
+	rs->pre_min_rssi = rs->min_rssi;
+	rs->min_rssi = min_rssi;
+
+	fa_cnt = r22b_false_alarm_statistics(sc);
+	if ((sc->sc_ic.ic_flags & IEEE80211_F_SCAN) == 0)
+		r22b_dig(sc, fa_cnt);
+}
+
 /* rtw8822b_phy_rfe_init() */
 void
 r22b_phy_rfe_init(struct rtwn_softc *sc)
