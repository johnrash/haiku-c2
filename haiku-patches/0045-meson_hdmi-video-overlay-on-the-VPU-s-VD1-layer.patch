+/*!	For KDL: the canvas byte order of the video layer, applied at once. */
+void
+MesonHdmi::SetOverlayEndian(uint32 endian)
+{
+	fOverlayEndian = endian & 0xf;
+	if (fOverlay.buffer >= 0)
+		_ApplyOverlay();
+}
