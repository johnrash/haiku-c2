+			if (user_memcpy(&config, buffer, sizeof(config)) != B_OK)
+				return B_BAD_ADDRESS;
+			return device->ConfigureOverlay(config);
+		}
 	}
 	return B_DEV_INVALID_IOCTL;
 }
