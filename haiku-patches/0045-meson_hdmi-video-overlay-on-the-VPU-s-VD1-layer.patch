+//	#pragma mark - overlay
+
+
+/*!	Physically contiguous pages for an overlay buffer, used like the frame
+	buffer: their cache lines are written back once, then they are only
+	accessed through a write-combining mapping with user access. The buffer
+	starts out black (Y 16, Cb and Cr 128).
+*/
+status_t
+MesonHdmi::AllocateOverlayBuffer(meson_hdmi_overlay_buffer& buffer)
+{
+	if (buffer.size == 0 || buffer.size > kMaxWidth * kMaxHeight * 4)
+		return B_BAD_VALUE;
+
+	MutexLocker locker(fModeLock);
+	overlay_buffer_info* info = NULL;
+	for (uint32 i = 0; i < kMaxOverlayBuffers; i++) {
+		if (fOverlayBuffers[i].pagesArea < 0) {
+			info = &fOverlayBuffers[i];
+			break;
+		}
+	}
+	if (info == NULL)
+		return B_NO_MEMORY;
+
+	size_t size = (buffer.size + B_PAGE_SIZE - 1) & ~(B_PAGE_SIZE - 1);
+	void* pages;
+	area_id pagesArea = create_area("meson_hdmi overlay pages", &pages,
+		B_ANY_KERNEL_ADDRESS, size, B_32_BIT_CONTIGUOUS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+	if (pagesArea < 0)
+		return pagesArea;
+	physical_entry entry;
+	get_memory_map(pages, B_PAGE_SIZE, &entry, 1);
+	flush_cache_range(entry.address, size);
+
+	// cloneable: MediaPlayer hands the bitmap's area to the media_server
+	// as a media buffer (clones of a device area keep its memory type)
+	void* address;
+	area_id mapArea = map_physical_memory("meson_hdmi overlay buffer",
+		entry.address, size, B_ANY_KERNEL_ADDRESS,
+		B_READ_AREA | B_WRITE_AREA | B_CLONEABLE_AREA, &address);
+	if (mapArea < 0) {
+		delete_area(pagesArea);
+		return mapArea;
+	}
+	vm_set_area_memory_type(mapArea, entry.address, B_WRITE_COMBINING_MEMORY);
+	uint32* pixels = (uint32*)address;
+	for (size_t i = 0; i < size / 4; i++)
+		pixels[i] = B_HOST_TO_LENDIAN_INT32(0x80108010);
+
+	info->pagesArea = pagesArea;
+	info->mapArea = mapArea;
+	info->physical = entry.address;
+	info->size = size;
+
+	buffer.area = mapArea;
+	buffer.address = address;
+	buffer.physical = entry.address;
+	return B_OK;
+}
+
+
+status_t
+MesonHdmi::FreeOverlayBuffer(area_id area)
+{
+	MutexLocker locker(fModeLock);
+	for (uint32 i = 0; i < kMaxOverlayBuffers; i++) {
+		overlay_buffer_info& info = fOverlayBuffers[i];
+		if (info.pagesArea < 0 || info.mapArea != area)
+			continue;
+		if (fOverlay.buffer == area)
+			_HideOverlay();
+		delete_area(info.mapArea);
+		// the cached alias may hold stale lines from speculative reads
+		flush_cache_range(info.physical, info.size);
+		delete_area(info.pagesArea);
+		info.pagesArea = -1;
+		return B_OK;
+	}
+	return B_BAD_VALUE;
+}
+
+
+status_t
+MesonHdmi::ConfigureOverlay(const meson_hdmi_overlay_config& config)
+{
+	MutexLocker locker(fModeLock);
+	if (config.buffer < 0) {
+		_HideOverlay();
+		return B_OK;
+	}
+
+	const overlay_buffer_info* info = NULL;
+	for (uint32 i = 0; i < kMaxOverlayBuffers; i++) {
+		if (fOverlayBuffers[i].pagesArea >= 0
+			&& fOverlayBuffers[i].mapArea == config.buffer) {
+			info = &fOverlayBuffers[i];
+			break;
+		}
+	}
+	if (info == NULL || config.width < 2 || config.height < 1
+		|| config.width > kMaxOverlaySize || config.height > kMaxOverlaySize
+		|| config.bytes_per_row < (uint32)config.width * 2
+		|| config.bytes_per_row % 8 != 0
+		|| (size_t)config.bytes_per_row * config.height > info->size
+		|| config.source_width == 0 || config.source_height == 0
+		|| config.source_left + config.source_width > config.width
+		|| config.source_top + config.source_height > config.height
+		|| config.window_width == 0 || config.window_height == 0
+		|| config.window_width > 4 * kMaxWidth
+		|| config.window_height > 4 * kMaxHeight) {
+		return B_BAD_VALUE;
+	}
+	// the scaler steps are 4.24 fixed point: at most 1/4 down
+	if (config.source_width > 4 * config.window_width
+		|| config.source_height > 4 * config.window_height) {
+		return B_BAD_VALUE;
+	}
+
+	if (info->physical != fOverlayPhysical) {
+		// a new frame: the other canvas, so that the shown one stays intact
+		// until the video layer switches over
+		fOverlayCanvas ^= 1;
+		fOverlayPhysical = info->physical;
+	}
+	fOverlay = config;
+	_ApplyOverlay();
+	return B_OK;
+}
+
+
+/*!	Programs the video layer (VD1) for fOverlay: the read interface takes
+	the visible part of the buffer through a canvas, the formatter expands
+	4:2:2 to 4:4:4, the VPP scaler scales it to the visible part of the
+	window, and the postblender puts it under OSD1.
+
+	The video shows where OSD1's alpha is 0. Normally OSD1 replaces every
+	pixel's alpha with 0xff; while the video layer is on, the frame buffer's
+	own alpha counts instead. app_server fills the overlay window with its
+	key colour, whose alpha is 0, and draws everything else opaque. (OSD1's
+	colour key registers, VIU_OSD1_TCOLOR_AG0-3, do nothing for 32 bit
+	pixels: they only give an alpha to formats without one.)
+*/
+void
+MesonHdmi::_ApplyOverlay()
+{
+	const meson_hdmi_overlay_config& config = fOverlay;
+	int32 screenWidth = fShared->current_mode.timing.h_display;
+	int32 screenHeight = fShared->current_mode.timing.v_display;
+
+	// the visible part of the window
+	int32 left = max_c(config.left, 0);
+	int32 top = max_c(config.top, 0);
+	int32 right = min_c(config.left + (int32)config.window_width,
+		screenWidth) - 1;
+	int32 bottom = min_c(config.top + (int32)config.window_height,
+		screenHeight) - 1;
+	if (right < left || bottom < top) {
+		_DisableVideoLayer();
+		return;
+	}
+
+	// the buffer part it shows; a 4:2:2 pair cannot be split
+	uint32 hStart = config.source_left + (uint64)(left - config.left)
+		* config.source_width / config.window_width;
+	uint32 hEnd = config.source_left + ((uint64)(right + 1 - config.left)
+		* config.source_width + config.window_width - 1)
+		/ config.window_width - 1;
+	uint32 vStart = config.source_top + (uint64)(top - config.top)
+		* config.source_height / config.window_height;
+	uint32 vEnd = config.source_top + ((uint64)(bottom + 1 - config.top)
+		* config.source_height + config.window_height - 1)
+		/ config.window_height - 1;
+	hStart &= ~1u;
+	hEnd = min_c(hEnd | 1, config.bytes_per_row / 2 - 1);
+	vEnd = min_c(vEnd, (uint32)config.height - 1);
+
+	uint32 inWidth = hEnd - hStart + 1;
+	uint32 inHeight = vEnd - vStart + 1;
+	uint32 outWidth = right - left + 1;
+	uint32 outHeight = bottom - top + 1;
+	uint32 stepX = ((uint64)config.source_width << 24) / config.window_width;
+	uint32 stepY = ((uint64)config.source_height << 24)
+		/ config.window_height;
+
+	uint32 canvas = kVideoCanvas[fOverlayCanvas];
+	_WriteCanvas(canvas, fOverlayPhysical, config.bytes_per_row,
+		config.height, fOverlayEndian);
+
+	_SetVpu(VD1_IF0_GEN_REG, VD_URGENT_CHROMA | VD_URGENT_LUMA
+		| VD_HOLD_LINES(9) | VD_CHROMA_REPEAT_LAST_LINE | VD_BYTES_PER_PIXEL(1)
+		| VD_ENABLE);
+	_SetVpu(VD1_IF0_GEN_REG2, 0);
+	_SetVpu(VIU_VD1_FMT_CTRL, VD_HORZ_Y_C_RATIO(1) | VD_HORZ_FORMAT
+		| VD_VERT_REPEAT_LINE0 | VD_VERT_INITIAL_PHASE(12)
+		| VD_VERT_PHASE_STEP(16) | VD_VERT_FORMAT);
+	_SetVpu(VIU_VD1_FMT_W, (inWidth << 16) | (hEnd / 2 - hStart / 2 + 1));
+	uint32 canvases = canvas | (canvas << 8) | (canvas << 16);
+	_SetVpu(VD1_IF0_CANVAS0, canvases);
+	_SetVpu(VD1_IF0_CANVAS1, canvases);
+	uint32 lumaX = hStart | (hEnd << 16);
+	uint32 lumaY = vStart | (vEnd << 16);
+	uint32 chromaX = (hStart / 2) | ((hEnd / 2) << 16);
+	uint32 chromaY = (vStart / 2) | ((vEnd / 2) << 16);
+	_SetVpu(VD1_IF0_LUMA_X0, lumaX);
+	_SetVpu(VD1_IF0_LUMA_Y0, lumaY);
+	_SetVpu(VD1_IF0_CHROMA_X0, chromaX);
+	_SetVpu(VD1_IF0_CHROMA_Y0, chromaY);
+	_SetVpu(VD1_IF0_LUMA_X1, lumaX);
+	_SetVpu(VD1_IF0_LUMA_Y1, lumaY);
+	_SetVpu(VD1_IF0_CHROMA_X1, chromaX);
+	_SetVpu(VD1_IF0_CHROMA_Y1, chromaY);
+	_SetVpu(VD1_IF0_RPT_LOOP, 0);
+	_SetVpu(VD1_IF0_LUMA0_RPT_PAT, 0);
+	_SetVpu(VD1_IF0_CHROMA0_RPT_PAT, 0);
+	_SetVpu(VD1_IF0_LUMA1_RPT_PAT, 0);
+	_SetVpu(VD1_IF0_CHROMA1_RPT_PAT, 0);
+	_SetVpu(VD1_IF0_LUMA_PSEL, 0);
+	_SetVpu(VD1_IF0_CHROMA_PSEL, 0);
+	_SetVpu(VD1_IF0_RANGE_MAP_Y, 0);
+	_SetVpu(VD1_IF0_RANGE_MAP_CB, 0);
+	_SetVpu(VD1_IF0_RANGE_MAP_CR, 0);
+
+	// linear scaling everywhere: all region slopes 0; the regions before
+	// region 1 and after region 4's start are empty or one pixel
+	_SetVpu(VPP_LINE_IN_LENGTH, inWidth);
+	_SetVpu(VPP_PIC_IN_HEIGHT, inHeight);
+	_SetVpu(VPP_PREBLEND_H_SIZE, inWidth);
+	_SetVpu(VPP_HSC_REGION12_STARTP, 0);
+	_SetVpu(VPP_HSC_REGION34_STARTP, ((outWidth - 1) << 16) | (outWidth - 1));
+	_SetVpu(VPP_HSC_REGION4_ENDP, outWidth - 1);
+	_SetVpu(VPP_HSC_START_PHASE_STEP, stepX);
+	for (uint32 i = 0; i < 4; i++)
+		_SetVpu(VPP_HSC_REGION0_PHASE_SLOPE + i, 0);
+	_SetVpu(VPP_HSC_PHASE_CTRL, (1 << 21) | (4 << 16));
+		// initial: repeat pixel 0 once, receive 4 pixels; phase 0
+	_SetVpu(VPP_VSC_REGION12_STARTP, 0);
+	_SetVpu(VPP_VSC_REGION34_STARTP,
+		((outHeight - 1) << 16) | (outHeight - 1));
+	_SetVpu(VPP_VSC_REGION4_ENDP, outHeight - 1);
+	_SetVpu(VPP_VSC_START_PHASE_STEP, stepY);
+	for (uint32 i = 0; i < 4; i++)
+		_SetVpu(VPP_VSC_REGION0_PHASE_SLOPE + i, 0);
+	_SetVpu(VPP_VSC_INI_PHASE, 0);
+	_SetVpu(VPP_VSC_PHASE_CTRL, (1 << 13) | (4 << 8) | (1 << 5) | 4);
+		// bottom and top field: repeat line 0 once, receive 4 lines
+	_SetVpu(VPP_SC_MISC, VPP_VSC_BANK_LENGTH(4) | VPP_HSC_BANK_LENGTH(4)
+		| VPP_SC_VD_OUT | VPP_SC_TOP | VPP_SC_HSC | VPP_SC_VSC);
+	_SetVpu(VPP_POSTBLEND_VD1_H_START_END, ((uint32)left << 16) | right);
+	_SetVpu(VPP_POSTBLEND_VD1_V_START_END, ((uint32)top << 16) | bottom);
+
+	_SetVpu(VIU_OSD1_CTRL_STAT2,
+		_Vpu(VIU_OSD1_CTRL_STAT2) & ~OSD_REPLACE_ALPHA);
+	_SetVpu(VPP_MISC, _Vpu(VPP_MISC) | VPP_VD1_PREBLEND | VPP_VD1_POSTBLEND);
+}
+
+
+void
+MesonHdmi::_DisableVideoLayer()
+{
+	_SetVpu(VPP_MISC,
+		_Vpu(VPP_MISC) & ~(VPP_VD1_PREBLEND | VPP_VD1_POSTBLEND));
+	_SetVpu(VD1_IF0_GEN_REG, _Vpu(VD1_IF0_GEN_REG) & ~VD_ENABLE);
+	_SetVpu(VIU_OSD1_CTRL_STAT2,
+		_Vpu(VIU_OSD1_CTRL_STAT2) | OSD_REPLACE_ALPHA);
+}
+
+
+void
+MesonHdmi::_HideOverlay()
+{
+	_DisableVideoLayer();
+	fOverlay.buffer = -1;
+	fOverlayPhysical = 0;
+}
