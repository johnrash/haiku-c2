diff --git a/headers/private/graphics/meson_hdmi/meson_hdmi_info.h b/headers/private/graphics/meson_hdmi/meson_hdmi_info.h
index 539052db2a..94db0e0c2f 100644
--- a/headers/private/graphics/meson_hdmi/meson_hdmi_info.h
+++ b/headers/private/graphics/meson_hdmi/meson_hdmi_info.h
@@ -25,6 +25,47 @@ enum {
 		// display_mode; must be one of the modes in the shared info
 	MESON_HDMI_GET_DEVICE_NAME,
 		// char[B_PATH_NAME_LENGTH], for clone accelerants
+	MESON_HDMI_ALLOCATE_OVERLAY_BUFFER,
+		// meson_hdmi_overlay_buffer
+	MESON_HDMI_FREE_OVERLAY_BUFFER,
+		// area_id of an overlay buffer
+	MESON_HDMI_CONFIGURE_OVERLAY,
+		// meson_hdmi_overlay_config
+};
+
+
+/*!	An overlay buffer is physically contiguous memory the video layer (VD1)
+	reads. The driver maps it write combining into the kernel's address space
+	with user access, like the frame buffer, so the one address works in
+	every team: app_server hands it to the client that draws into the
+	overlay bitmap.
+*/
+struct meson_hdmi_overlay_buffer {
+	size_t			size;			// in: bytes
+	area_id			area;			// out: names the buffer in other calls
+	void*			address;		// out
+	phys_addr_t		physical;		// out
+};
+
+
+struct meson_hdmi_overlay_config {
+	area_id			buffer;			// -1 hides the overlay
+	uint32			bytes_per_row;
+	uint16			width;			// of the buffer, in pixels
+	uint16			height;
+
+	// the part of the buffer shown
+	uint16			source_left;
+	uint16			source_top;
+	uint16			source_width;
+	uint16			source_height;
+
+	// where it is shown, partly off screen too; the video shows where the
+	// frame buffer's alpha is 0 (the overlay key colour's alpha)
+	int32			left;
+	int32			top;
+	uint32			window_width;
+	uint32			window_height;
 };
 
 
diff --git a/src/add-ons/accelerants/meson_hdmi/accelerant.cpp b/src/add-ons/accelerants/meson_hdmi/accelerant.cpp
