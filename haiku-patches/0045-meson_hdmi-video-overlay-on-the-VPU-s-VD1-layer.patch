+void
+MesonHdmi::DumpOverlay()
+{
+	const meson_hdmi_overlay_config& config = fOverlay;
+	kprintf("meson_hdmi overlay: buffer %" B_PRId32 " (%#" B_PRIxPHYSADDR
+		"), canvas %#" B_PRIx32 ", endian %" B_PRIu32 "\n", config.buffer,
+		fOverlayPhysical, kVideoCanvas[fOverlayCanvas], fOverlayEndian);
+	kprintf("  %ux%u, %" B_PRIu32 " bytes per row; source %u,%u %ux%u; "
+		"window %" B_PRId32 ",%" B_PRId32 " %" B_PRIu32 "x%" B_PRIu32 "\n",
+		config.width, config.height, config.bytes_per_row, config.source_left,
+		config.source_top, config.source_width, config.source_height,
+		config.left, config.top, config.window_width, config.window_height);
+	for (uint32 i = 0; i < kMaxOverlayBuffers; i++) {
+		if (fOverlayBuffers[i].pagesArea >= 0) {
+			kprintf("  buffer %" B_PRId32 ": %#" B_PRIxPHYSADDR ", %" B_PRIuSIZE
+				" bytes\n", fOverlayBuffers[i].mapArea,
+				fOverlayBuffers[i].physical, fOverlayBuffers[i].size);
+		}
+	}
+	static const struct {
+		const char*	name;
+		uint32		first;
+		uint32		count;
+	} kRanges[] = {
+		{ "VD1_IF0", VD1_IF0_GEN_REG, 0x1e },
+		{ "VPP scaler", VPP_LINE_IN_LENGTH, 0x1d },
+		{ "VPP blend", VPP_PREBLEND_H_SIZE, 0x7 },
+	};
+	for (size_t r = 0; r < B_COUNT_OF(kRanges); r++) {
+		kprintf("  %s:", kRanges[r].name);
+		for (uint32 i = 0; i < kRanges[r].count; i++) {
+			if (i % 8 == 0)
+				kprintf("\n    %04" B_PRIx32 ":", kRanges[r].first + i);
+			kprintf(" %08" B_PRIx32, _Vpu(kRanges[r].first + i));
+		}
+		kprintf("\n");
+	}
+	kprintf("  OSD1 W0 %#" B_PRIx32 ", stat2 %#" B_PRIx32 "\n",
+		_Vpu(VIU_OSD1_BLK0_CFG_W0), _Vpu(VIU_OSD1_CTRL_STAT2));
+}
