 */
 
 
@@ -21,6 +29,7 @@
 #include <Accelerant.h>
 #include <OS.h>
 #include <edid.h>
+#include <video_overlay.h>
 
 #include "meson_hdmi_info.h"
 
@@ -37,6 +46,23 @@ struct accelerant_info {
 
 static accelerant_info sInfo = { -1, false, -1, NULL, -1, NULL, 0 };
 
+static const uint32 kMaxOverlayBuffers = 8;
+static const uint16 kMaxOverlayWidth = 2048;
+static const uint16 kMaxOverlayHeight = 2048;
+
+struct overlay_buffer_slot {
+	overlay_buffer			buffer;
+	area_id					area;		// -1: unused
+};
+
+static overlay_buffer_slot sOverlayBuffers[kMaxOverlayBuffers] = {
+	{ {}, -1 }, { {}, -1 }, { {}, -1 }, { {}, -1 },
+	{ {}, -1 }, { {}, -1 }, { {}, -1 }, { {}, -1 },
+};
+static int32 sOverlayChannel;
+	// the token of the one overlay channel; its address is the token
+static int32 sOverlayChannelUsed;
+
 
 static status_t
 init_common(int device, bool isClone)
@@ -247,6 +273,191 @@ meson_get_pixel_clock_limits(display_mode* mode, uint32* _low, uint32* _high)
 }
 
 
+// #pragma mark - overlay
+
+
+static uint32
+meson_overlay_count(const display_mode* mode)
+{
+	return 1;
+}
+
+
+static const uint32*
+meson_overlay_supported_spaces(const display_mode* mode)
+{
+	static const uint32 kSpaces[] = { B_YCbCr422, 0 };
+	return kSpaces;
+}
+
+
+static uint32
+meson_overlay_supported_features(uint32 colorSpace)
+{
+	return B_OVERLAY_COLOR_KEY | B_OVERLAY_KEYING_USES_ALPHA
+		| B_OVERLAY_HORIZONTAL_FILTERING | B_OVERLAY_VERTICAL_FILTERING;
+}
+
+
+static const overlay_buffer*
+meson_allocate_overlay_buffer(color_space space, uint16 width, uint16 height)
+{
+	// the video layer's formatter and the VPP line buffers take lines of
+	// up to 2048 pixels; MediaPlayer uses a normal bitmap for larger ones
+	if (space != B_YCbCr422 || width == 0 || height == 0
+		|| width > kMaxOverlayWidth || height > kMaxOverlayHeight) {
+		return NULL;
+	}
+
+	overlay_buffer_slot* slot = NULL;
+	for (uint32 i = 0; i < kMaxOverlayBuffers; i++) {
+		if (sOverlayBuffers[i].area < 0) {
+			slot = &sOverlayBuffers[i];
+			break;
+		}
+	}
+	if (slot == NULL)
+		return NULL;
+
+	// the canvas takes rows in units of 8 bytes; 32 keep them in whole
+	// DDR bursts
+	uint32 bytesPerRow = ((uint32)((width + 1) & ~1) * 2 + 31) & ~31u;
+	meson_hdmi_overlay_buffer request;
+	request.size = (size_t)bytesPerRow * height;
+	if (ioctl(sInfo.device, MESON_HDMI_ALLOCATE_OVERLAY_BUFFER, &request,
+			sizeof(request)) != 0) {
+		return NULL;
+	}
+
+	slot->area = request.area;
+	slot->buffer.space = space;
+	slot->buffer.width = width;
+	slot->buffer.height = height;
+	slot->buffer.bytes_per_row = bytesPerRow;
+	slot->buffer.buffer = request.address;
+	slot->buffer.buffer_dma = (void*)(addr_t)request.physical;
+	return &slot->buffer;
+}
+
+
+static overlay_buffer_slot*
+find_overlay_buffer(const overlay_buffer* buffer)
+{
+	for (uint32 i = 0; i < kMaxOverlayBuffers; i++) {
+		if (sOverlayBuffers[i].area >= 0 && &sOverlayBuffers[i].buffer == buffer)
+			return &sOverlayBuffers[i];
+	}
+	return NULL;
+}
+
+
+static status_t
+meson_release_overlay_buffer(const overlay_buffer* buffer)
+{
+	overlay_buffer_slot* slot = find_overlay_buffer(buffer);
+	if (slot == NULL)
+		return B_BAD_VALUE;
+	ioctl(sInfo.device, MESON_HDMI_FREE_OVERLAY_BUFFER, &slot->area,
+		sizeof(area_id));
+	slot->area = -1;
+	return B_OK;
+}
+
+
+static status_t
+meson_get_overlay_constraints(const display_mode* mode,
+	const overlay_buffer* buffer, overlay_constraints* constraints)
+{
+	if (buffer == NULL || constraints == NULL)
+		return B_BAD_VALUE;
+
+	memset(constraints, 0, sizeof(overlay_constraints));
+	// the view: any part of the buffer, starting at an even column
+	constraints->view.h_alignment = 1;
+	constraints->view.width_alignment = 1;
+	constraints->view.width.min = 2;
+	constraints->view.width.max = buffer->width;
+	constraints->view.height.min = 1;
+	constraints->view.height.max = buffer->height;
+	// the window: anywhere, partly off screen too
+	constraints->window.width.min = 2;
+	constraints->window.width.max = 4096;
+	constraints->window.height.min = 2;
+	constraints->window.height.max = 4096;
+	constraints->h_scale.min = 0.25f;
+	constraints->h_scale.max = 64.0f;
+	constraints->v_scale.min = 0.25f;
+	constraints->v_scale.max = 64.0f;
+	return B_OK;
+}
+
+
+static overlay_token
+meson_allocate_overlay(void)
+{
+	if (atomic_test_and_set(&sOverlayChannelUsed, 1, 0) != 0)
+		return NULL;
+	return &sOverlayChannel;
+}
+
+
+static status_t
+meson_release_overlay(overlay_token token)
+{
+	if (token != &sOverlayChannel)
+		return B_BAD_VALUE;
+	meson_hdmi_overlay_config config;
+	memset(&config, 0, sizeof(config));
+	config.buffer = -1;
+	ioctl(sInfo.device, MESON_HDMI_CONFIGURE_OVERLAY, &config, sizeof(config));
+	atomic_set(&sOverlayChannelUsed, 0);
+	return B_OK;
+}
+
+
+static status_t
+meson_configure_overlay(overlay_token token, const overlay_buffer* buffer,
+	const overlay_window* window, const overlay_view* view)
+{
+	if (token != &sOverlayChannel)
+		return B_BAD_VALUE;
+
+	meson_hdmi_overlay_config config;
+	memset(&config, 0, sizeof(config));
+	config.buffer = -1;
+	if (buffer != NULL && window != NULL && view != NULL) {
+		overlay_buffer_slot* slot = find_overlay_buffer(buffer);
+		if (slot == NULL)
+			return B_BAD_VALUE;
+		// keying is by the frame buffer's alpha only
+		if ((window->flags & B_OVERLAY_COLOR_KEY) == 0
+			|| (window->alpha.value & window->alpha.mask) != 0) {
+			return B_NOT_SUPPORTED;
+		}
+		config.buffer = slot->area;
+		config.bytes_per_row = buffer->bytes_per_row;
+		config.width = buffer->width;
+		config.height = buffer->height;
+		config.source_left = view->h_start;
+		config.source_top = view->v_start;
+		config.source_width = view->width;
+		config.source_height = view->height;
+		// the window part the offsets cut off is not shown
+		config.left = window->h_start + window->offset_left;
+		config.top = window->v_start + window->offset_top;
+		config.window_width = window->width - window->offset_left
+			- window->offset_right;
+		config.window_height = window->height - window->offset_top
+			- window->offset_bottom;
+	}
+	if (ioctl(sInfo.device, MESON_HDMI_CONFIGURE_OVERLAY, &config,
+			sizeof(config)) != 0) {
+		return errno;
+	}
+	return B_OK;
+}
+
+
 extern "C" void*
 get_accelerant_hook(uint32 feature, void* data)
 {
@@ -284,6 +495,25 @@ get_accelerant_hook(uint32 feature, void* data)
 			return (void*)meson_get_frame_buffer_config;
 		case B_GET_PIXEL_CLOCK_LIMITS:
 			return (void*)meson_get_pixel_clock_limits;
+
+		case B_OVERLAY_COUNT:
+			return (void*)meson_overlay_count;
+		case B_OVERLAY_SUPPORTED_SPACES:
+			return (void*)meson_overlay_supported_spaces;
+		case B_OVERLAY_SUPPORTED_FEATURES:
+			return (void*)meson_overlay_supported_features;
+		case B_ALLOCATE_OVERLAY_BUFFER:
+			return (void*)meson_allocate_overlay_buffer;
+		case B_RELEASE_OVERLAY_BUFFER:
+			return (void*)meson_release_overlay_buffer;
+		case B_GET_OVERLAY_CONSTRAINTS:
+			return (void*)meson_get_overlay_constraints;
+		case B_ALLOCATE_OVERLAY:
+			return (void*)meson_allocate_overlay;
+		case B_RELEASE_OVERLAY:
+			return (void*)meson_release_overlay;
+		case B_CONFIGURE_OVERLAY:
+			return (void*)meson_configure_overlay;
 	}
 	return NULL;
 }
