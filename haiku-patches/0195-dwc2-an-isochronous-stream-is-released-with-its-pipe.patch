 	if (!fIsoAvailable || isochronousData == NULL)
 		return B_NOT_SUPPORTED;
 	bool highSpeed = !_NeedsSplit(pipe);
-	// DEBUG M45
-	dprintf("dwc2: DEBUG iso submit: high speed %d, interval %u, in %d, mps %"
