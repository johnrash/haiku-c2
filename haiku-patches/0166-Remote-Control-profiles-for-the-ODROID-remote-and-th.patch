--- a/src/add-ons/input_server/devices/remote_control/Jamfile
+++ b/src/add-ons/input_server/devices/remote_control/Jamfile
@@ -3,6 +3,7 @@ SubDir HAIKU_TOP src add-ons input_server devices remote_control ;
 UsePrivateHeaders input drivers shared ;
 
 Addon <input>remote_control :
