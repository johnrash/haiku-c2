+/*static*/ status_t
+MesonVdec::_SetupThread(void* data)
+{
+	MesonVdec* device = (MesonVdec*)data;
+	while (acquire_sem(device->fSetupSem) == B_OK) {
+		InterruptsSpinLocker locker(device->fStateLock);
+		if (!device->fRunning)
+			break;
+		if (!device->fSetupPending || device->fEndOfStream) {
+			// The end of the stream's own picture asks for frames of its
+			// size: left unanswered, the firmware stops there.
+			continue;
+		}
+		uint32 info[4];
+		memcpy(info, device->fSetupInfo, sizeof(info));
+		locker.Unlock();
+
+		status_t status = device->_SetupH264Frames(info);
+		if (status != B_OK) {
+			INFO("no frames for the stream: %s\n", strerror(status));
+			locker.Lock();
+			if (!device->fFatal)
+				release_sem_etc(device->fFrameSem, 1, B_DO_NOT_RESCHEDULE);
+			device->fFatal = true;
+		}
+	}
+	return B_OK;
+}
