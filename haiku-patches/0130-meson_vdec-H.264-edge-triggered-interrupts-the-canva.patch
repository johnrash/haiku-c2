+/*!	The H.264 firmware's command in AV_SCRATCH_0: its wish for frames
+	(left for the setup thread, which answers in the same register), decoded
+	frames (up to six, each with its status in AV_SCRATCH_1-6 and its
+	stream offset's high half in AV_SCRATCH_A-C), or a fatal error.
+*/
+bool
+MesonVdec::_CheckH264()
+{
+	uint32 command = _Dos(AV_SCRATCH_0);
+	bool handled = true;
+	switch (command & 0xff) {
+		case 0:
+			handled = false;
+			break;
+
+		case H264_COMMAND_SEQUENCE:
+			if (fSetupPending)
+				break;
+			fSetupPending = true;
+			fSetupInfo[0] = _Dos(AV_SCRATCH_1);
+			fSetupInfo[1] = _Dos(AV_SCRATCH_2);
+			fSetupInfo[2] = _Dos(AV_SCRATCH_3);
+			fSetupInfo[3] = _Dos(AV_SCRATCH_6);
+			_Trace('C', command, fSetupInfo[0], fSetupInfo[3],
+				fSetupInfo[1]);
+			release_sem_etc(fSetupSem, 1, B_DO_NOT_RESCHEDULE);
+			break;
+
+		case H264_COMMAND_FRAMES:
+		{
+			fLastReport = system_time();
+			uint32 errors = _Dos(AV_SCRATCH_D);
+			if (errors != 0) {
+				fDecodeErrors += errors;
+				_SetDos(AV_SCRATCH_D, 0);
+			}
+			uint32 count = (command >> 8) & 0xff;
+			if (count > kH264MaxReportFrames)
+				count = kH264MaxReportFrames;
+			for (uint32 i = 0; i < count; i++) {
