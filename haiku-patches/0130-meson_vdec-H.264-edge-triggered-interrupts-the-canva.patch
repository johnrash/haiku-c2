+void
+MesonVdec::_QueueFrame(uint32 index, uint32 info, uint32 offset)
+{
+	if (fQueueCount >= kMaxFrames)
+		return;
+	uint32 slot = (fQueueHead + fQueueCount) % kMaxFrames;
+	fQueue[slot] = index;
+	fQueueInfo[slot] = info;
+	fQueueOffset[slot] = offset;
+	fQueueCount++;
+	fFramesDecoded++;
+	release_sem_etc(fFrameSem, 1, B_DO_NOT_RESCHEDULE);
+}
