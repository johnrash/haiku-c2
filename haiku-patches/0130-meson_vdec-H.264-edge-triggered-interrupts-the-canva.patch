+/*!	The H.264 firmware's start: its extension (the 20 KB after what the
+	IMEM DMA loaded) in a buffer of its own, its workspace and SEI buffer.
+	It asks for frames later (_SetupH264Frames()).
+*/
+status_t
+MesonVdec::_StartH264(const void* userFirmware)
+{
+	if (user_memcpy(fExtension.address,
+			(const uint8*)userFirmware + kFirmwareSize, kH264ExtensionSize)
+				!= B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	flush_cache_range(fExtension.physical, kH264ExtensionSize);
+
+	uint32 workspace = fWorkspace.physical - kH264WorkspaceBias;
+	_SetDos(POWER_CTL_VLD, _Dos(POWER_CTL_VLD) | (1 << 9) | (1 << 6));
+	_SetDos(AV_SCRATCH_1, workspace);
+	_SetDos(AV_SCRATCH_G, fExtension.physical);
+	_SetDos(AV_SCRATCH_I, fSei.physical - workspace);
+	_SetDos(AV_SCRATCH_F, (_Dos(AV_SCRATCH_F) & ~0x3cu) | 0x90);
+	_SetDos(MDEC_PIC_DC_THRESH, 0x404038aa);
+	// what an earlier session left: no command, no frames handed back
+	_SetDos(AV_SCRATCH_0, 0);
+	_SetDos(AV_SCRATCH_7, 0);
+	_SetDos(AV_SCRATCH_8, 0);
+	_SetDos(AV_SCRATCH_J, 0);
+	return B_OK;
+}
