+/*!	Gives the H.264 firmware the frames for the stream it found (its
+	command 1, \a info: AV_SCRATCH_1, 2, 3 and 6): the stream's reference
+	frame count and five more (at most 24), each in an area of its own, and
+	room for their motion vectors. A later command (the stream changed)
+	reuses the frames if they are enough, else replaces them once the caller
+	gave all back.
+*/
+status_t
+MesonVdec::_SetupH264Frames(const uint32* info)
+{
+	uint32 mbWidth = info[0] & 0xff;
+	uint32 mbTotal = (info[0] >> 8) & 0xffff;
+	uint32 maxReferences = ((info[0] >> 24) & 0x7f) + 1;
+	if (mbWidth == 0 || mbTotal < mbWidth)
+		return B_BAD_DATA;
+	uint32 mbHeight = mbTotal / mbWidth;
+	uint32 cropBottom = info[3] & 0xff;
+	uint32 cropRight = (info[3] >> 16) & 0xff;
+	if (16 * mbWidth > kMaxWidth || 16 * mbHeight > kMaxHeight
+		|| cropRight >= 16 * mbWidth || cropBottom >= 16 * mbHeight) {
+		INFO("stream of %" B_PRIu32 "x%" B_PRIu32 " macroblocks: too large\n",
+			mbWidth, mbHeight);
+		return B_BAD_VALUE;
+	}
+	uint32 count = min_c(max_c(maxReferences + 5, 2), kMaxFrames);
+	uint32 bytesPerRow = align_up(16 * mbWidth, 32);
+	uint32 rows = align_up(16 * mbHeight, 32);
+	uint32 lumaSize = align_up(bytesPerRow * rows, 64 * 1024);
+	size_t frameSize = ROUNDUP(lumaSize + lumaSize / 2, B_PAGE_SIZE);
+
+	if (fFrameCount < count || fFrameSize < frameSize) {
+		if (fFrameCount > 0) {
+			// the caller has the old frames to give back first
+			bigtime_t timeout = system_time() + 5000000;
+			while (true) {
+				InterruptsSpinLocker locker(fStateLock);
+				bool done = fHeld == 0 && fQueueCount == 0;
+				locker.Unlock();
+				if (done)
+					break;
+				if (system_time() > timeout || !fRunning)
+					return B_TIMED_OUT;
+				snooze(5000);
+			}
+			_FreeH264Frames();
+		}
+		for (uint32 i = 0; i < count; i++) {
+			char name[32];
+			snprintf(name, sizeof(name), "meson_vdec frame %" B_PRIu32, i);
+			status_t status = _AllocateBuffer(name, frameSize,
+				fFrameBuffers[i], true);
+			if (status != B_OK) {
+				INFO("no memory for frame %" B_PRIu32 " of %" B_PRIu32 ", %"
+					B_PRIuSIZE " bytes\n", i, count, frameSize);
+				_FreeH264Frames();
+				return status;
+			}
+		}
+		fFrameSize = frameSize;
+	} else
+		count = fFrameCount;
+
+	for (uint32 i = 0; i < count; i++) {
+		uint32 luma = kFirstCanvas + 2 * i;
+		uint32 chroma = luma + 1;
+		_WriteCanvas(luma, fFrameBuffers[i].physical, bytesPerRow, rows);
+		_WriteCanvas(chroma, fFrameBuffers[i].physical + lumaSize,
+			bytesPerRow, rows / 2);
+		_SetDos(ANC0_CANVAS_ADDR + 4 * i,
+			luma | (chroma << 8) | (chroma << 16));
+	}
+
+	_FreeBuffer(fMotionVectors);
+	size_t motionVectors = (size_t)align_up(mbWidth, 4)
+		* align_up(mbHeight, 4) * kMotionVectorBytes * maxReferences;
+	status_t status = _AllocateBuffer("meson_vdec motion vectors",
+		motionVectors, fMotionVectors, false);
+	if (status != B_OK)
+		return status;
+
+	InterruptsSpinLocker locker(fStateLock);
+	if (!fRunning)
+		return B_OK;
+	fFrameCount = count;
+	fWidth = 16 * mbWidth - cropRight;
+	fHeight = 16 * mbHeight - cropBottom;
+	fBytesPerRow = bytesPerRow;
+	fLumaSize = lumaSize;
+	_SetDos(AV_SCRATCH_1, fMotionVectors.physical);
+	_SetDos(AV_SCRATCH_4, fMotionVectors.physical + motionVectors);
+	_SetDos(AV_SCRATCH_0, (maxReferences << 24) | (count << 16)
+		| ((maxReferences - 1) << 8));
+		// last: it lets the firmware go on
+	fSetupPending = false;
+	_Trace('P', info[0], count, frameSize, motionVectors);
+	locker.Unlock();
+
+	INFO("H.264 %" B_PRIu32 "x%" B_PRIu32 " (%" B_PRIu32 "x%" B_PRIu32
+		" macroblocks), %" B_PRIu32 " references: %" B_PRIu32 " frames of %"
+		B_PRIuSIZE " bytes\n", fWidth, fHeight, mbWidth, mbHeight,
+		maxReferences, count, frameSize);
 	return B_OK;
 }
 
 
+void
+MesonVdec::_FreeH264Frames()
+{
+	for (uint32 i = 0; i < kMaxFrames; i++)
+		_FreeBuffer(fFrameBuffers[i]);
+	InterruptsSpinLocker locker(fStateLock);
+	fFrameCount = 0;
+}
