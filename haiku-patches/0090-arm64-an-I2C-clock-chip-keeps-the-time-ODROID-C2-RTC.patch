diff --git a/headers/private/kernel/real_time_clock.h b/headers/private/kernel/real_time_clock.h
index 6e380d31f9..8738c7e335 100644
--- a/headers/private/kernel/real_time_clock.h
+++ b/headers/private/kernel/real_time_clock.h
@@ -35,6 +35,26 @@ void rtc_secs_to_tm(uint64 seconds, struct tm *t);
 
 uint32 get_timezone_offset(void);
 
+/*!	A real-time clock chip that a driver serves, for a machine whose
+	architecture code has none (an I2C clock on an ARM board, for example).
+	set_time() is called whenever the system time is set: the clock is to
+	show system_time() + offset microseconds since 1970, in its own time zone
+	(GMT or local time, as for arch_rtc_set_hw_time()). It is called with a
+	spinlock held and must not block; it is not called in the kernel
+	debugger.
+*/
+typedef struct rtc_hw_clock {
+	void*	cookie;
+	void	(*set_time)(void* cookie, bigtime_t offset);
+} rtc_hw_clock;
+
+status_t rtc_set_hw_clock(const rtc_hw_clock* clock);
+	// Registers the clock, or with NULL unregisters it; after that it is not
+	// called anymore.
+void rtc_hw_clock_read(bigtime_t offset);
+	// The driver read the clock: it shows system_time() + offset. Sets the
+	// system time from it, without writing it back.
+
 bigtime_t _user_system_time(void);
 status_t _user_set_real_time_clock(bigtime_t time);
 status_t _user_set_timezone(int32 timezoneOffset, const char *name,
