new file mode 100644
index 0000000000..fffc4e2bc6
--- /dev/null
+++ b/src/add-ons/kernel/busses/i2c/meson/meson_i2c.cpp
@@ -0,0 +1,667 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * Amlogic Meson GX I2C master (S905, ODROID-C2) for the I2C bus manager.
+ *
+ * The controller runs a list of up to 16 four-bit tokens (start, slave
+ * address for writing or reading, data byte, last data byte, stop) and moves
+ * up to 8 data bytes each way through its registers; longer transfers take
+ * more lists. Transfers are polled: they are short (a list of 8 bytes takes
+ * under a millisecond at 100 kHz), and the one user so far, the real-time
+ * clock, needs no interrupt.
+ *
+ * Neither U-Boot nor Haiku has a pin controller driver for these pins, so
+ * the driver muxes them itself for the two controllers on the ODROID-C2's
+ * 40-pin header: I2C A on pins 3 (SDA, GPIODV_24) and 5 (SCK, GPIODV_25),
+ * I2C B on pins 27 and 28 (GPIODV_26, GPIODV_27). It also opens the
+ * controllers' clock gate and sets 100 kHz from clk81.
+ *
+ * Devices: the C2's device tree describes none (its I2C nodes have no
+ * children), and add-on boards are found by probing their addresses:
+ * scan_bus() looks for the real-time clock of Hardkernel's RTC shield, an
+ * NXP PCF8563 at address 0x51, and registers it with its compatible string.
+ */
+
+
+#include <new>
+#include <stdlib.h>
+#include <string.h>
+
+#include <KernelExport.h>
+#include <bus/FDT.h>
+#include <cpu.h>
+#include <device_manager.h>
+#include <i2c.h>
+#include <kernel.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+
+
+#define DRIVER_MODULE_NAME	"busses/i2c/meson_i2c/driver_v1"
+
+//#define TRACE_MESON_I2C
+#ifdef TRACE_MESON_I2C
+#	define TRACE(x...) dprintf("meson_i2c: " x)
+#else
+#	define TRACE(x...)
+#endif
+#define INFO(x...) dprintf("meson_i2c: " x)
+
+
+// registers
+static const uint32 kControl = 0x00;
+static const uint32 kSlaveAddress = 0x04;
+static const uint32 kTokenList0 = 0x08;
+static const uint32 kTokenList1 = 0x0c;
+static const uint32 kWriteData0 = 0x10;
+static const uint32 kWriteData1 = 0x14;
+static const uint32 kReadData0 = 0x18;
+static const uint32 kReadData1 = 0x1c;
+static const uint32 kRegistersSize = 0x20;
+
+// control register
+static const uint32 kControlStart = 1 << 0;
+static const uint32 kControlBusy = 1 << 2;
+static const uint32 kControlError = 1 << 3;
+	// the slave did not acknowledge
+static const uint32 kControlClockDividerShift = 12;
+static const uint32 kControlClockDividerMask = 0x3ff << 12;
+static const uint32 kControlClockDividerExtShift = 28;
+static const uint32 kControlClockDividerExtMask = 0x3 << 28;
+
+// tokens
+enum {
+	kTokenEnd = 0,
+	kTokenStart,
+	kTokenSlaveAddressWrite,
+	kTokenSlaveAddressRead,
+	kTokenData,
+	kTokenDataLast,
+		// a byte read and not acknowledged: the last one
+	kTokenStop
+};
+
+static const size_t kMaxTokens = 16;
+static const size_t kMaxDataBytes = 8;
+static const bigtime_t kTransferTimeout = 50000;
+
+static const uint32 kBusSpeed = 100000;
+static const uint32 kDividerFactor = 4;
+	// SCL = clk81 / (divider * 4) on GXBB
+
+// the clock input, clk81 (HHI registers)
+static const phys_addr_t kHhiBase = 0xc883c000;
+static const uint32 kHhiGateMpeg0 = 0x50 * 4;
+static const uint32 kHhiGateMpeg0I2c = 1 << 9;
+static const uint32 kHhiMpegClockControl = 0x5d * 4;
+static const uint32 kXtalRate = 24000000;
+static const uint32 kFixedPllRate = 2000000000;
+static const uint32 kDefaultClk81Rate = 166666667;
+
+// pin muxing (periphs pin controller)
+static const phys_addr_t kPinMuxBase = 0xc88344b0;
+	// PERIPHS_PIN_MUX_0
+static const phys_addr_t kI2cABase = 0xc1108500;
+static const phys_addr_t kI2cBBase = 0xc11087c0;
+
+struct PinMux {
+	phys_addr_t	controller;
+	const char*	name;
+	uint32		set7;
+		// PERIPHS_PIN_MUX_7: the I2C function
+	uint32		clear2;
+		// PERIPHS_PIN_MUX_2: UART B, which shares the pins
+};
+
+static const PinMux kPinMuxes[] = {
+	{ kI2cABase, "I2C A (header pins 3, 5)", (1 << 27) | (1 << 26),
+		(1 << 29) | (1 << 28) },
+	{ kI2cBBase, "I2C B (header pins 27, 28)", (1 << 25) | (1 << 24),
+		(1 << 27) | (1 << 26) },
+};
+
+// add-on boards
+static const i2c_addr kPcf8563Address = 0x51;
+
+
+static device_manager_info* gDeviceManager;
+static i2c_for_controller_interface* gI2c;
+
+
+class MesonI2c {
+public:
+								MesonI2c(device_node* node);
+								~MesonI2c();
+
+			status_t			Init();
+
+			void				SetBus(i2c_bus bus) { fBus = bus; }
+			status_t			ExecCommand(i2c_op op, i2c_addr address,
+									const uint8* command, size_t commandLength,
+									uint8* data, size_t dataLength);
+			status_t			ScanBus();
+			status_t			AcquireBus();
+			void				ReleaseBus();
+
+private:
+			uint32				_Read(uint32 offset)
+									{ return fRegisters[offset / 4]; }
+			void				_Write(uint32 offset, uint32 value)
+									{ fRegisters[offset / 4] = value; }
+
+			void				_SetupPinsAndClock(phys_addr_t base);
+			status_t			_Run();
+			status_t			_Message(i2c_addr address, bool read,
+									uint8* buffer, size_t length, bool stop);
+			void				_Stop();
+			void				_AddToken(uint32 token);
+			bool				_LooksLikePcf8563(const uint8* registers);
+
+			device_node*		fNode;
+			i2c_bus				fBus;
+			recursive_lock		fLock;
+			area_id				fRegistersArea;
+			volatile uint32*	fRegisters;
+			uint32				fTokens[2];
+			size_t				fTokenCount;
+};
+
+
+MesonI2c::MesonI2c(device_node* node)
+	:
+	fNode(node),
+	fBus(NULL),
+	fRegistersArea(-1),
+	fRegisters(NULL),
+	fTokenCount(0)
+{
+	recursive_lock_init(&fLock, "meson i2c");
+}
+
+
+MesonI2c::~MesonI2c()
+{
+	if (fRegistersArea >= 0)
+		delete_area(fRegistersArea);
+	recursive_lock_destroy(&fLock);
+}
+
+
+status_t
+MesonI2c::Init()
+{
+	device_node* parent = gDeviceManager->get_parent_node(fNode);
+	fdt_device_module_info* fdtModule;
+	fdt_device* fdtDevice;
+	status_t status = gDeviceManager->get_driver(parent,
+		(driver_module_info**)&fdtModule, (void**)&fdtDevice);
+	gDeviceManager->put_node(parent);
+	if (status != B_OK)
+		return status;
+
+	uint64 base;
+	uint64 size;
+	if (!fdtModule->get_reg(fdtDevice, 0, &base, &size)
+		|| size < kRegistersSize) {
+		return B_ERROR;
+	}
+
+	// the registers sit inside a page shared with other controllers
+	phys_addr_t pageBase = ROUNDDOWN(base, B_PAGE_SIZE);
+	void* page;
+	fRegistersArea = map_physical_memory("meson i2c", pageBase, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &page);
+	if (fRegistersArea < 0)
+		return fRegistersArea;
+	fRegisters = (volatile uint32*)((addr_t)page + (base - pageBase));
+
+	_SetupPinsAndClock(base);
+	return B_OK;
+}
+
+
+/*!	Muxes the pins of the header's controllers, opens the clock gate and
+	sets the bus clock.
+*/
+void
+MesonI2c::_SetupPinsAndClock(phys_addr_t base)
+{
+	uint32 clk81 = kDefaultClk81Rate;
+
+	void* hhi;
+	area_id area = map_physical_memory("meson i2c hhi", kHhiBase,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &hhi);
+	if (area >= 0) {
+		volatile uint32* gate
+			= (volatile uint32*)((addr_t)hhi + kHhiGateMpeg0);
+		*gate |= kHhiGateMpeg0I2c;
+
+		// clk81: a source, divided by (n + 1)
+		uint32 control = *(volatile uint32*)((addr_t)hhi
+			+ kHhiMpegClockControl);
+		uint32 divider = (control & 0x7f) + 1;
+		uint32 source = 0;
+		switch ((control >> 12) & 7) {
+			case 0:
+				source = kXtalRate;
+				break;
+			case 2:
+				source = kFixedPllRate / 7;
+				break;
+			case 5:
+				source = kFixedPllRate / 4;
+				break;
+			case 6:
+				source = kFixedPllRate / 3;
+				break;
+			case 7:
+				source = kFixedPllRate / 5;
+				break;
+		}
+		if (source != 0)
+			clk81 = source / divider;
+		delete_area(area);
+	}
+
+	for (size_t i = 0; i < B_COUNT_OF(kPinMuxes); i++) {
+		const PinMux& mux = kPinMuxes[i];
+		if (mux.controller != base)
+			continue;
+
+		phys_addr_t pageBase = ROUNDDOWN(kPinMuxBase, B_PAGE_SIZE);
+		void* page;
+		area = map_physical_memory("meson i2c pinmux", pageBase,
+			B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+			B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &page);
+		if (area < 0)
+			break;
+		volatile uint32* pinMux = (volatile uint32*)((addr_t)page
+			+ (kPinMuxBase - pageBase));
+		pinMux[2] &= ~mux.clear2;
+		pinMux[7] |= mux.set7;
+		delete_area(area);
+		INFO("%s: pins muxed\n", mux.name);
+	}
+
+	uint32 divider = (clk81 + kBusSpeed * kDividerFactor - 1)
+		/ (kBusSpeed * kDividerFactor);
+	uint32 control = _Read(kControl);
+	control &= ~(kControlStart | kControlClockDividerMask
+		| kControlClockDividerExtMask);
+	control |= ((divider & 0x3ff) << kControlClockDividerShift)
+		| ((divider >> 10) << kControlClockDividerExtShift);
+	_Write(kControl, control);
+	INFO("controller at %#" B_PRIx64 ": clk81 %" B_PRIu32 " Hz, divider %"
+		B_PRIu32 ", %" B_PRIu32 " Hz\n", (uint64)base, clk81, divider,
+		clk81 / (divider * kDividerFactor));
+}
+
+
+void
+MesonI2c::_AddToken(uint32 token)
+{
+	if (fTokenCount >= kMaxTokens)
+		return;
+	fTokens[fTokenCount / 8] |= token << ((fTokenCount % 8) * 4);
+	fTokenCount++;
+}
+
+
+/*!	Runs the token list and resets it. */
+status_t
+MesonI2c::_Run()
+{
+	_Write(kTokenList0, fTokens[0]);
+	_Write(kTokenList1, fTokens[1]);
+	fTokens[0] = fTokens[1] = 0;
+	fTokenCount = 0;
+
+	uint32 control = _Read(kControl) & ~kControlStart;
+	_Write(kControl, control);
+	_Write(kControl, control | kControlStart);
+
+	bigtime_t start = system_time();
+	status_t status = B_OK;
+	while ((_Read(kControl) & kControlBusy) != 0) {
+		bigtime_t now = system_time();
+		if (now - start > kTransferTimeout) {
+			status = B_TIMED_OUT;
+			break;
+		}
+		if (now - start > 200)
+			snooze(50);
+		else
+			cpu_pause();
+	}
+	control = _Read(kControl);
+	_Write(kControl, control & ~kControlStart);
+	if (status == B_OK && (control & kControlError) != 0)
+		status = B_DEV_NOT_READY;
+	return status;
+}
+
+
+/*!	A stop condition, after an error. */
+void
+MesonI2c::_Stop()
+{
+	_AddToken(kTokenStop);
+	_Run();
+}
+
+
+/*!	One message: a start, the address, \a length bytes written or read
+	(none: only the address), and a stop if \a stop.
+*/
+status_t
+MesonI2c::_Message(i2c_addr address, bool read, uint8* buffer, size_t length,
+	bool stop)
+{
+	_Write(kSlaveAddress, (address & 0x7f) << 1);
+	_AddToken(kTokenStart);
+	_AddToken(read ? kTokenSlaveAddressRead : kTokenSlaveAddressWrite);
+
+	size_t position = 0;
+	do {
+		size_t count = length - position;
+		if (count > kMaxDataBytes)
+			count = kMaxDataBytes;
+
+		uint32 data[2] = { 0, 0 };
+		for (size_t i = 0; i < count; i++) {
+			_AddToken(read && position + i + 1 == length
+				? kTokenDataLast : kTokenData);
+			if (!read)
+				data[i / 4] |= (uint32)buffer[position + i] << ((i % 4) * 8);
+		}
+		if (!read) {
+			_Write(kWriteData0, data[0]);
+			_Write(kWriteData1, data[1]);
+		}
+		if (stop && position + count == length)
+			_AddToken(kTokenStop);
+
+		status_t status = _Run();
+		if (status != B_OK) {
+			TRACE("address %#x: %s at byte %" B_PRIuSIZE "\n", address,
+				strerror(status), position);
+			_Stop();
+			return status;
+		}
+
+		if (read) {
+			data[0] = _Read(kReadData0);
+			data[1] = _Read(kReadData1);
+			for (size_t i = 0; i < count; i++)
+				buffer[position + i] = data[i / 4] >> ((i % 4) * 8);
+		}
+		position += count;
+	} while (position < length);
+
+	return B_OK;
+}
+
+
+status_t
+MesonI2c::ExecCommand(i2c_op op, i2c_addr address, const uint8* command,
+	size_t commandLength, uint8* data, size_t dataLength)
+{
+	if (IS_BLOCK_OP(op))
+		return B_NOT_SUPPORTED;
+
+	RecursiveLocker locker(fLock);
+
+	bool stop = IS_STOP_OP(op);
+	if (IS_WRITE_OP(op)) {
+		// the command and the data as one message
+		size_t length = commandLength + dataLength;
+		uint8 stackBuffer[64];
+		uint8* buffer = stackBuffer;
+		if (length > sizeof(stackBuffer)) {
+			buffer = (uint8*)malloc(length);
+			if (buffer == NULL)
+				return B_NO_MEMORY;
+		}
+		if (commandLength > 0)
+			memcpy(buffer, command, commandLength);
+		if (dataLength > 0)
+			memcpy(buffer + commandLength, data, dataLength);
+		status_t status = _Message(address, false, buffer, length, stop);
+		if (buffer != stackBuffer)
+			free(buffer);
+		return status;
+	}
+
+	// the command written, then the data read after a repeated start
+	if (commandLength > 0) {
+		status_t status = _Message(address, false, (uint8*)command,
+			commandLength, false);
+		if (status != B_OK)
+			return status;
+	}
+	return _Message(address, true, data, dataLength, stop);
+}
+
+
+/*!	The PCF8563's control and time registers (0 to 8): the bits it doesn't
+	have read as 0, and the time is valid BCD unless the clock says it isn't
+	(VL, its battery ran out or it was never set).
+*/
+bool
+MesonI2c::_LooksLikePcf8563(const uint8* registers)
+{
+	if ((registers[0] & 0x57) != 0 || (registers[1] & 0xe0) != 0)
+		return false;
+	if ((registers[2] & 0x80) != 0)
+		return true;
+
+	static const uint8 kMasks[7] = { 0x7f, 0x7f, 0x3f, 0x3f, 0x07, 0x1f,
+		0xff };
+	static const uint8 kMaxima[7] = { 59, 59, 23, 31, 6, 12, 99 };
+	for (int i = 0; i < 7; i++) {
+		uint8 value = registers[2 + i] & kMasks[i];
+		if ((value & 0xf) > 9)
+			return false;
+		if ((value >> 4) * 10 + (value & 0xf) > kMaxima[i])
+			return false;
+	}
+	return true;
+}
+
+
+status_t
+MesonI2c::ScanBus()
+{
+	uint8 reg = 0;
+	uint8 registers[9];
+	status_t status = ExecCommand(I2C_OP_READ_STOP, kPcf8563Address, &reg, 1,
+		registers, sizeof(registers));
+	if (status != B_OK) {
+		INFO("nothing at address %#x\n", kPcf8563Address);
+		return B_OK;
+	}
+	if (!_LooksLikePcf8563(registers)) {
+		INFO("the device at address %#x is not a PCF8563 (%02x %02x %02x)\n",
+			kPcf8563Address, registers[0], registers[1], registers[2]);
+		return B_OK;
+	}
+	INFO("PCF8563 real-time clock at address %#x\n", kPcf8563Address);
+	return gI2c->register_device(fBus, kPcf8563Address,
+		(char*)"nxp,pcf8563", NULL, NULL);
+}
+
+
+status_t
+MesonI2c::AcquireBus()
+{
+	return recursive_lock_lock(&fLock);
+}
+
+
+void
+MesonI2c::ReleaseBus()
+{
+	recursive_lock_unlock(&fLock);
+}
+
+
+//	#pragma mark - driver module
+
+
+/*!	The FDT bus also registers nodes with status "disabled" (I2C B and C on
+	the ODROID-C2).
+*/
+static bool
+fdt_device_enabled(fdt_device_module_info* module, fdt_device* device)
+{
+	int length;
+	const char* status = (const char*)module->get_prop(device, "status",
+		&length);
+	return status == NULL || strcmp(status, "okay") == 0
+		|| strcmp(status, "ok") == 0;
+}
+
+
+static float
+supports_device(device_node* parent)
+{
+	const char* bus;
+	if (gDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false)
+			!= B_OK || strcmp(bus, "fdt") != 0) {
+		return 0.0f;
+	}
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(parent, "fdt/compatible", &compatible,
+			false) != B_OK
+		|| (strcmp(compatible, "amlogic,meson-gxbb-i2c") != 0
+			&& strcmp(compatible, "amlogic,meson-gx-i2c") != 0
+			&& strcmp(compatible, "amlogic,meson6-i2c") != 0)) {
+		return 0.0f;
+	}
+
+	fdt_device_module_info* fdtModule;
+	fdt_device* fdtDevice;
+	if (gDeviceManager->get_driver(parent, (driver_module_info**)&fdtModule,
+			(void**)&fdtDevice) != B_OK
+		|| !fdt_device_enabled(fdtModule, fdtDevice)) {
+		return 0.0f;
+	}
+	return 0.8f;
+}
+
+
+static status_t
+register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "Amlogic Meson GX I2C controller" } },
+		{ B_DEVICE_FIXED_CHILD, B_STRING_TYPE,
+			{ .string = I2C_FOR_CONTROLLER_MODULE_NAME } },
+		{ NULL }
+	};
+	return gDeviceManager->register_node(parent, DRIVER_MODULE_NAME, attrs,
+		NULL, NULL);
+}
+
+
+static status_t
+init_driver(device_node* node, void** _cookie)
+{
+	MesonI2c* controller = new(std::nothrow) MesonI2c(node);
+	if (controller == NULL)
+		return B_NO_MEMORY;
+	status_t status = controller->Init();
+	if (status != B_OK) {
+		delete controller;
+		return status;
+	}
+	*_cookie = controller;
+	return B_OK;
+}
+
+
+static void
+uninit_driver(void* cookie)
+{
+	delete (MesonI2c*)cookie;
+}
+
+
+static void
+set_i2c_bus(i2c_bus_cookie cookie, i2c_bus bus)
+{
+	((MesonI2c*)cookie)->SetBus(bus);
+}
+
+
+static status_t
+exec_command(i2c_bus_cookie cookie, i2c_op op, i2c_addr address,
+	const void* command, size_t commandLength, void* data, size_t dataLength)
+{
+	return ((MesonI2c*)cookie)->ExecCommand(op, address,
+		(const uint8*)command, commandLength, (uint8*)data, dataLength);
+}
+
+
+static status_t
+scan_bus(i2c_bus_cookie cookie)
+{
+	return ((MesonI2c*)cookie)->ScanBus();
+}
+
+
+static status_t
+acquire_bus(i2c_bus_cookie cookie)
+{
+	return ((MesonI2c*)cookie)->AcquireBus();
+}
+
+
+static void
+release_bus(i2c_bus_cookie cookie)
+{
+	((MesonI2c*)cookie)->ReleaseBus();
+}
