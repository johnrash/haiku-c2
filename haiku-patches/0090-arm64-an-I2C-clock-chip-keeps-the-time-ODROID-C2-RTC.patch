+//	#pragma mark - driver module
+
+
+static float
+supports_device(device_node* parent)
+{
+	const char* bus;
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false)
+			!= B_OK || strcmp(bus, "i2c") != 0
+		|| gDeviceManager->get_attr_string(parent, I2C_DEVICE_COMPATIBLE_ITEM,
+			&compatible, false) != B_OK
+		|| strcmp(compatible, "nxp,pcf8563") != 0) {
+		return 0.0f;
+	}
+	return 0.8f;
+}
+
+
+static status_t
+register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "NXP PCF8563 real-time clock" } },
+		{ B_DEVICE_FLAGS, B_UINT32_TYPE, { .ui32 = B_KEEP_DRIVER_LOADED } },
+		{ NULL }
+	};
+	return gDeviceManager->register_node(parent, DRIVER_MODULE_NAME, attrs,
+		NULL, NULL);
+}
+
+
+static status_t
+init_driver(device_node* node, void** _cookie)
+{
+	Pcf8563* clock = new(std::nothrow) Pcf8563(node);
+	if (clock == NULL)
+		return B_NO_MEMORY;
+	status_t status = clock->Init();
+	if (status != B_OK) {
+		delete clock;
+		return status;
+	}
+	*_cookie = clock;
+	return B_OK;
+}
+
+
+static void
+uninit_driver(void* cookie)
+{
+	delete (Pcf8563*)cookie;
+}
+
+
+static status_t
+register_child_devices(void* cookie)
+{
+	Pcf8563* clock = (Pcf8563*)cookie;
+	return gDeviceManager->publish_device(clock->Node(), "misc/rtc",
+		DEVICE_MODULE_NAME);
+}
+
+
+//	#pragma mark - device module
+
+
+static status_t
+device_init(void* driverCookie, void** _deviceCookie)
+{
+	*_deviceCookie = driverCookie;
+	return B_OK;
+}
+
+
+static void
+device_uninit(void* deviceCookie)
+{
+}
+
+
+static status_t
+device_open(void* deviceCookie, const char* path, int openMode,
+	void** _cookie)
+{
+	*_cookie = deviceCookie;
+	return B_OK;
+}
+
+
+static status_t
+device_close(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+device_free(void* cookie)
+{
+	return B_OK;
+}
+
+
+static status_t
+device_read(void* cookie, off_t position, void* buffer, size_t* _length)
+{
+	return ((Pcf8563*)cookie)->Read(position, (char*)buffer, _length);
+}
+
+
+static status_t
+device_write(void* cookie, off_t position, const void* buffer,
+	size_t* _length)
+{
+	*_length = 0;
+	return B_NOT_ALLOWED;
+}
+
+
+static status_t
+device_control(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	return B_DEV_INVALID_IOCTL;
+}
