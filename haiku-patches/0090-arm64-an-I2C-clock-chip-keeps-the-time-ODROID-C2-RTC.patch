--- /dev/null
+++ b/src/add-ons/kernel/drivers/rtc/pcf8563/pcf8563.cpp
@@ -0,0 +1,757 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * NXP PCF8563 real-time clock on I2C (Hardkernel's RTC shield for the
+ * ODROID-C2, with a coin cell): the system time comes from it at boot, and
+ * it is set whenever the system time is (Time preferences, NTP).
+ *
+ * The kernel knows it as its hardware clock (rtc_set_hw_clock(): GMT or
+ * local time, as the Time preferences say). Its registers hold whole
+ * seconds, so the driver works at its second ticks:
+ * - Reading: it reads the clock once at once and sets the system time
+ *   from it, half a second assumed; then it polls the clock until its
+ *   seconds change and sets the system time again from that moment, to a
+ *   millisecond or two.
+ * - Writing: it stops the clock's divider (STOP), writes the second about
+ *   to come and releases the divider so the next tick, which the datasheet
+ *   puts 0.507813 s after the release, falls on the second. Then it polls
+ *   for that tick and logs how far off it came.
+ * A clock whose VL flag is set (its supply dropped too low: battery empty,
+ * or never set) is not used until the time is set.
+ *
+ * /dev/misc/rtc reads as a short text: the clock's time, and how the last
+ * reading and setting went.
+ */
+
+
+#include <new>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#include <KernelExport.h>
+#include <device_manager.h>
+#include <cpu.h>
+#include <i2c.h>
+#include <lock.h>
+#include <real_time_clock.h>
+#include <util/AutoLock.h>
+
+
+#define DRIVER_MODULE_NAME	"drivers/rtc/pcf8563/driver_v1"
+#define DEVICE_MODULE_NAME	"drivers/rtc/pcf8563/device_v1"
+
+#define INFO(x...) dprintf("pcf8563: " x)
+
+
+// registers
+static const uint8 kControl1 = 0x00;
+static const uint8 kControl1Stop = 1 << 5;
+static const uint8 kSeconds = 0x02;
+	// then minutes, hours, days, weekdays, months, years
+static const uint8 kSecondsVoltageLow = 1 << 7;
+static const size_t kTimeRegisters = 7;
+
+static const bigtime_t kFirstTickAfterStop = 507813;
+	// the datasheet: 0.507813 to 0.507935 s after STOP is released
+static const bigtime_t kReleaseWriteTime = 270;
+	// from the start of the release's write to the end of its data byte
+static const bigtime_t kSetMargin = 50000;
+static const bigtime_t kTickTimeout = 1300000;
+
+
+static device_manager_info* gDeviceManager;
+
+
+struct Measurement {
+	bool		done;
+	int64		seconds;
+		// the clock's time at the tick
+	bigtime_t	error;
+		// writing: when the tick came, against when it should have
+	bigtime_t	when;
+		// real time, for the status text
+};
+
+
+class Pcf8563 {
+public:
+								Pcf8563(device_node* node);
+								~Pcf8563();
+
+			status_t			Init();
+			device_node*		Node() const { return fNode; }
+			status_t			Read(off_t position, char* buffer,
+									size_t* _length);
+
+private:
+	static	void				_SetTimeHook(void* cookie, bigtime_t offset);
+	static	status_t			_ThreadEntry(void* cookie);
+			void				_Thread();
+
+			status_t			_ReadRegisters(uint8 first, uint8* buffer,
+									size_t count);
+			status_t			_WriteRegisters(uint8 first,
+									const uint8* buffer, size_t count);
+			status_t			_WaitForTick(uint8* registers,
+									bigtime_t* _tick);
+			status_t			_WriteTime(bigtime_t offset);
+			void				_ReadAtTick();
+
+	static	bool				_SecondsFromRegisters(const uint8* registers,
+									int64* _seconds);
+	static	void				_RegistersFromSeconds(int64 seconds,
+									uint8* registers);
+	static	void				_FormatTime(char* buffer, size_t size,
+									int64 seconds);
+
+			device_node*		fNode;
+			i2c_device_interface* fI2c;
+			i2c_device			fI2cCookie;
+			i2c_addr			fAddress;
+
+			rtc_hw_clock		fHwClock;
+			bool				fHwClockSet;
+			spinlock			fRequestLock;
+			bool				fRequestPending;
+			bigtime_t			fRequestOffset;
+			sem_id				fRequestSem;
+			thread_id			fThread;
+			bool				fQuit;
+
+			mutex				fStatusLock;
+			bool				fValidAtBoot;
+			Measurement			fBootRead;
+			Measurement			fLastSet;
+};
+
+
+Pcf8563::Pcf8563(device_node* node)
+	:
+	fNode(node),
+	fI2c(NULL),
+	fI2cCookie(NULL),
+	fAddress(0),
+	fHwClockSet(false),
+	fRequestPending(false),
+	fRequestOffset(0),
+	fRequestSem(-1),
+	fThread(-1),
+	fQuit(false),
+	fValidAtBoot(false)
+{
+	B_INITIALIZE_SPINLOCK(&fRequestLock);
+	mutex_init(&fStatusLock, "pcf8563 status");
+	memset(&fBootRead, 0, sizeof(fBootRead));
+	memset(&fLastSet, 0, sizeof(fLastSet));
+	fHwClock.cookie = this;
+	fHwClock.set_time = &_SetTimeHook;
+}
+
+
+Pcf8563::~Pcf8563()
+{
+	if (fHwClockSet)
+		rtc_set_hw_clock(NULL);
+	if (fThread >= 0) {
+		fQuit = true;
+		release_sem(fRequestSem);
+		resume_thread(fThread);
+			// if Init() failed before it did
+		status_t result;
+		wait_for_thread(fThread, &result);
+	}
+	if (fRequestSem >= 0)
+		delete_sem(fRequestSem);
+	mutex_destroy(&fStatusLock);
+}
+
+
+status_t
+Pcf8563::Init()
+{
+	device_node* parent = gDeviceManager->get_parent_node(fNode);
+	status_t status = gDeviceManager->get_driver(parent,
+		(driver_module_info**)&fI2c, (void**)&fI2cCookie);
+	if (status == B_OK) {
+		status = gDeviceManager->get_attr_uint16(parent,
+			I2C_DEVICE_SLAVE_ADDR_ITEM, &fAddress, false);
+	}
+	gDeviceManager->put_node(parent);
+	if (status != B_OK)
+		return status;
+
+	uint8 control;
+	uint8 registers[kTimeRegisters];
+	bigtime_t readTime = system_time();
+	status = _ReadRegisters(kControl1, &control, 1);
+	if (status == B_OK)
+		status = _ReadRegisters(kSeconds, registers, kTimeRegisters);
+	if (status != B_OK) {
+		INFO("can't read the clock: %s\n", strerror(status));
+		return status;
+	}
+
+	int64 seconds;
+	fValidAtBoot = (control & kControl1Stop) == 0
+		&& _SecondsFromRegisters(registers, &seconds);
+	char text[32];
+	if (fValidAtBoot) {
+		// within a second; the thread reads it at its next tick
+		rtc_hw_clock_read(seconds * 1000000 + 500000 - readTime);
+		_FormatTime(text, sizeof(text), seconds);
+		INFO("clock at I2C address %#x: %s\n", fAddress, text);
+	} else {
+		INFO("clock at I2C address %#x: no valid time (%s); set the time to "
+			"set it\n", fAddress, (control & kControl1Stop) != 0
+				? "stopped" : "battery ran low, or never set");
+	}
+
+	fRequestSem = create_sem(0, "pcf8563 requests");
+	if (fRequestSem < 0)
+		return fRequestSem;
+	fThread = spawn_kernel_thread(&_ThreadEntry, "pcf8563",
+		B_NORMAL_PRIORITY, this);
+	if (fThread < 0)
+		return fThread;
+
+	status = rtc_set_hw_clock(&fHwClock);
+	if (status != B_OK) {
+		INFO("the kernel has a hardware clock already\n");
+		return status;
+	}
+	fHwClockSet = true;
+	resume_thread(fThread);
+	return B_OK;
+}
+
+
+/*!	The kernel's request: the clock is to show system_time() + offset. Called
+	with interrupts disabled; the thread does the work.
+*/
+/*static*/ void
+Pcf8563::_SetTimeHook(void* cookie, bigtime_t offset)
+{
+	Pcf8563* clock = (Pcf8563*)cookie;
+	SpinLocker locker(clock->fRequestLock);
+	clock->fRequestOffset = offset;
+	clock->fRequestPending = true;
+	locker.Unlock();
+	release_sem_etc(clock->fRequestSem, 1, B_DO_NOT_RESCHEDULE);
+}
+
+
+/*static*/ status_t
+Pcf8563::_ThreadEntry(void* cookie)
+{
+	((Pcf8563*)cookie)->_Thread();
+	return B_OK;
+}
+
+
+void
+Pcf8563::_Thread()
+{
+	if (fValidAtBoot)
+		_ReadAtTick();
+
+	while (acquire_sem(fRequestSem) == B_OK && !fQuit) {
+		InterruptsSpinLocker locker(fRequestLock);
+		if (!fRequestPending)
+			continue;
+		bigtime_t offset = fRequestOffset;
+		fRequestPending = false;
+		locker.Unlock();
+
+		status_t status = _WriteTime(offset);
+		if (status != B_OK)
+			INFO("setting the clock failed: %s\n", strerror(status));
+	}
+}
+
+
+status_t
+Pcf8563::_ReadRegisters(uint8 first, uint8* buffer, size_t count)
+{
+	status_t status = fI2c->acquire_bus(fI2cCookie);
+	if (status != B_OK)
+		return status;
+	status = fI2c->exec_command(fI2cCookie, I2C_OP_READ_STOP, &first, 1,
+		buffer, count);
+	fI2c->release_bus(fI2cCookie);
+	return status;
+}
+
+
+status_t
+Pcf8563::_WriteRegisters(uint8 first, const uint8* buffer, size_t count)
+{
+	status_t status = fI2c->acquire_bus(fI2cCookie);
+	if (status != B_OK)
+		return status;
+	status = fI2c->exec_command(fI2cCookie, I2C_OP_WRITE_STOP, &first, 1,
+		(void*)buffer, count);
+	fI2c->release_bus(fI2cCookie);
+	return status;
+}
+
+
+/*!	Polls the time registers until the seconds change: \a registers gets
+	them after the change, \a _tick the system time of the change (between
+	the last two reads, which take about a millisecond each).
+*/
+status_t
+Pcf8563::_WaitForTick(uint8* registers, bigtime_t* _tick)
+{
+	bigtime_t deadline = system_time() + kTickTimeout;
+	int previous = -1;
+	bigtime_t previousTime = 0;
+	while (!fQuit) {
+		bigtime_t before = system_time();
+		if (before > deadline)
+			return B_TIMED_OUT;
+		status_t status = _ReadRegisters(kSeconds, registers,
+			kTimeRegisters);
+		if (status != B_OK)
+			return status;
+		int seconds = registers[0] & 0x7f;
+		if (previous >= 0 && seconds != previous) {
+			*_tick = (previousTime + before) / 2;
+			return B_OK;
+		}
+		previous = seconds;
+		previousTime = before;
+		snooze(1000);
+	}
+	return B_INTERRUPTED;
+}
+
+
+/*!	At boot: the system time from the clock's next tick, unless the time has
+	been set meanwhile.
+*/
+void
+Pcf8563::_ReadAtTick()
+{
+	uint8 registers[kTimeRegisters];
+	bigtime_t tick;
+	status_t status = _WaitForTick(registers, &tick);
+	int64 seconds;
+	if (status != B_OK || !_SecondsFromRegisters(registers, &seconds)) {
+		INFO("reading the clock at its tick failed: %s\n",
+			status != B_OK ? strerror(status) : "no valid time");
+		return;
+	}
+
+	{
+		InterruptsSpinLocker locker(fRequestLock);
+		if (fRequestPending)
+			return;
+	}
+	bigtime_t before = real_time_clock_usecs();
+	rtc_hw_clock_read(seconds * 1000000 - tick);
+	bigtime_t correction = real_time_clock_usecs() - before;
+
+	MutexLocker locker(fStatusLock);
+	fBootRead.done = true;
+	fBootRead.seconds = seconds;
+	fBootRead.error = correction;
+	fBootRead.when = real_time_clock_usecs();
+	char text[32];
+	_FormatTime(text, sizeof(text), seconds);
+	INFO("system time from the clock's tick at %s (%" B_PRId64 " ms from the "
+		"first reading)\n", text, correction / 1000);
+}
+
+
+/*!	Sets the clock to show system_time() + offset, its next tick on the
+	second; then measures that tick.
+*/
+status_t
+Pcf8563::_WriteTime(bigtime_t offset)
+{
+	// set to the second whose last part is at least kSetMargin away, the
+	// divider released (1 - kFirstTickAfterStop) into it
+	bigtime_t clockNow = system_time() + offset;
+	int64 seconds = (clockNow + kSetMargin + kFirstTickAfterStop - 1)
+		/ 1000000;
+	bigtime_t release = seconds * 1000000 + 1000000 - kFirstTickAfterStop
+		- offset - kReleaseWriteTime;
+
+	uint8 stop = kControl1Stop;
+	uint8 registers[kTimeRegisters];
+	_RegistersFromSeconds(seconds, registers);
+	status_t status = _WriteRegisters(kControl1, &stop, 1);
+	if (status == B_OK)
+		status = _WriteRegisters(kSeconds, registers, kTimeRegisters);
+	if (status != B_OK)
+		return status;
+
+	snooze_until(release - 2000, B_SYSTEM_TIMEBASE);
+	while (system_time() < release)
+		cpu_pause();
+	uint8 run = 0;
+	bigtime_t released = system_time();
+	status = _WriteRegisters(kControl1, &run, 1);
+	if (status != B_OK)
+		return status;
+
+	// when it ticked to seconds + 1, against when it should have
+	bigtime_t tick;
+	status = _WaitForTick(registers, &tick);
+	int64 tickSeconds;
+	if (status != B_OK || !_SecondsFromRegisters(registers, &tickSeconds)) {
+		INFO("the clock didn't tick after it was set: %s\n",
+			status != B_OK ? strerror(status) : "no valid time");
+		return B_OK;
+	}
+	bigtime_t error = tick + offset - (seconds + 1) * 1000000;
+
+	MutexLocker locker(fStatusLock);
+	fLastSet.done = true;
+	fLastSet.seconds = tickSeconds;
+	fLastSet.error = error;
+	fLastSet.when = real_time_clock_usecs();
+	char text[32];
+	_FormatTime(text, sizeof(text), tickSeconds);
+	INFO("clock set: %s, its tick %" B_PRId64 ".%03" B_PRId64 " ms %s the "
+		"second (released %" B_PRId64 " us late, ticked %" B_PRId64 " us "
+		"after the release)\n", text, (error < 0 ? -error : error) / 1000,
+		(error < 0 ? -error : error) % 1000, error < 0 ? "before" : "after",
+		released - release, tick - released);
+	return B_OK;
+}
+
+
+static inline int
+from_bcd(uint8 value)
+{
+	return (value >> 4) * 10 + (value & 0xf);
+}
+
+
+static inline uint8
+to_bcd(int value)
+{
+	return ((value / 10) << 4) | (value % 10);
+}
+
+
+/*!	From the seconds to the years register; false if the clock's time isn't
+	valid. Years 00 to 99 are 2000 to 2099 (the century bit is left as it
+	is: Linux uses either value for this century).
+*/
+/*static*/ bool
+Pcf8563::_SecondsFromRegisters(const uint8* registers, int64* _seconds)
+{
+	if ((registers[0] & kSecondsVoltageLow) != 0)
+		return false;
+
+	static const uint8 kMasks[kTimeRegisters]
+		= { 0x7f, 0x7f, 0x3f, 0x3f, 0x07, 0x1f, 0xff };
+	static const uint8 kMinima[kTimeRegisters] = { 0, 0, 0, 1, 0, 1, 0 };
+	static const uint8 kMaxima[kTimeRegisters] = { 59, 59, 23, 31, 6, 12, 99 };
+	int values[kTimeRegisters];
+	for (size_t i = 0; i < kTimeRegisters; i++) {
+		uint8 value = registers[i] & kMasks[i];
+		values[i] = from_bcd(value);
+		if ((value & 0xf) > 9 || values[i] < kMinima[i]
+			|| values[i] > kMaxima[i]) {
+			return false;
+		}
+	}
+
+	struct tm time = {};
+	time.tm_sec = values[0];
+	time.tm_min = values[1];
+	time.tm_hour = values[2];
+	time.tm_mday = values[3];
+	time.tm_mon = values[5] - 1;
+	time.tm_year = 2000 + values[6] - RTC_EPOCH_BASE_YEAR;
+	*_seconds = rtc_tm_to_secs(&time);
+	return true;
+}
+
+
+/*static*/ void
+Pcf8563::_RegistersFromSeconds(int64 seconds, uint8* registers)
+{
+	struct tm time;
+	rtc_secs_to_tm(seconds, &time);
+	int year = time.tm_year + RTC_EPOCH_BASE_YEAR;
+
+	registers[0] = to_bcd(time.tm_sec);
+		// VL cleared
+	registers[1] = to_bcd(time.tm_min);
+	registers[2] = to_bcd(time.tm_hour);
+	registers[3] = to_bcd(time.tm_mday);
+	registers[4] = (seconds / 86400 + 4) % 7;
+		// 1 January 1970 was a Thursday; Sunday is 0
+	registers[5] = to_bcd(time.tm_mon + 1);
+	registers[6] = to_bcd(year % 100);
+}
+
+
+/*static*/ void
+Pcf8563::_FormatTime(char* buffer, size_t size, int64 seconds)
+{
+	struct tm time;
+	rtc_secs_to_tm(seconds, &time);
+	snprintf(buffer, size, "%04d-%02d-%02d %02d:%02d:%02d",
+		time.tm_year + RTC_EPOCH_BASE_YEAR, time.tm_mon + 1, time.tm_mday,
+		time.tm_hour, time.tm_min, time.tm_sec);
+}
+
+
+/*!	/dev/misc/rtc: the clock's time now, and how the boot reading and the
+	last setting went.
+*/
+status_t
+Pcf8563::Read(off_t position, char* buffer, size_t* _length)
+{
+	char text[640];
+	size_t length = 0;
+	char time[32];
+
+	uint8 control;
+	uint8 registers[kTimeRegisters];
+	status_t status = _ReadRegisters(kControl1, &control, 1);
+	if (status == B_OK)
+		status = _ReadRegisters(kSeconds, registers, kTimeRegisters);
+	int64 seconds;
+	if (status != B_OK) {
+		length += snprintf(text + length, sizeof(text) - length,
+			"clock:    can't be read (%s)\n", strerror(status));
+	} else if ((control & kControl1Stop) != 0
+		|| !_SecondsFromRegisters(registers, &seconds)) {
+		length += snprintf(text + length, sizeof(text) - length,
+			"clock:    no valid time (%s)\n", (control & kControl1Stop) != 0
+				? "stopped" : "battery ran low, or never set");
+	} else {
+		_FormatTime(time, sizeof(time), seconds);
+		length += snprintf(text + length, sizeof(text) - length,
+			"clock:    %s (PCF8563 at I2C address %#x)\n", time, fAddress);
+	}
+
+	MutexLocker locker(fStatusLock);
+	if (fBootRead.done) {
+		_FormatTime(time, sizeof(time), fBootRead.seconds);
+		length += snprintf(text + length, sizeof(text) - length,
+			"boot:     system time from its tick at %s (%" B_PRId64 " ms "
+			"from the first reading)\n", time, fBootRead.error / 1000);
+	} else {
+		length += snprintf(text + length, sizeof(text) - length,
+			"boot:     %s\n", fValidAtBoot
+				? "reading at its tick not done" : "not used, no valid time");
+	}
+	if (fLastSet.done) {
+		_FormatTime(time, sizeof(time), fLastSet.seconds);
+		bigtime_t error = fLastSet.error;
+		length += snprintf(text + length, sizeof(text) - length,
+			"last set: ticked to %s %" B_PRId64 ".%03" B_PRId64 " ms %s the "
+			"second\n", time, (error < 0 ? -error : error) / 1000,
+			(error < 0 ? -error : error) % 1000,
+			error < 0 ? "before" : "after");
+	} else {
+		length += snprintf(text + length, sizeof(text) - length,
+			"last set: not since boot\n");
+	}
+	locker.Unlock();
+
+	if (length > sizeof(text) - 1)
+		length = sizeof(text) - 1;
+	if (position >= (off_t)length) {
+		*_length = 0;
+		return B_OK;
+	}
+	size_t count = length - position;
+	if (count > *_length)
+		count = *_length;
+	if (user_memcpy(buffer, text + position, count) != B_OK)
+		return B_BAD_ADDRESS;
+	*_length = count;
+	return B_OK;
+}
