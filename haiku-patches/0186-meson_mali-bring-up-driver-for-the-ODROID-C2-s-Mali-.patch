+//	#pragma mark - driver module
+
+
+static float
+supports_device(device_node* parent)
+{
+	const char* bus;
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false)
+			!= B_OK || strcmp(bus, "fdt") != 0
+		|| gDeviceManager->get_attr_string(parent, "fdt/compatible",
+			&compatible, false) != B_OK
+		|| strcmp(compatible, "amlogic,meson-gxbb-mali") != 0) {
+		return 0.0f;
+	}
+	return 0.8f;
+}
+
+
+static status_t
+register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "ARM Mali-450 MP3" } },
+		{ NULL }
+	};
+	return gDeviceManager->register_node(parent, DRIVER_MODULE_NAME, attrs,
+		NULL, NULL);
+}
+
+
+static status_t
+init_driver(device_node* node, void** _cookie)
+{
+	DeviceNodePutter<&gDeviceManager> fdtNode(
+		gDeviceManager->get_parent_node(node));
+	fdt_device_module_info* fdtModule;
+	fdt_device* fdtDevice;
+	if (gDeviceManager->get_driver(fdtNode.Get(),
+			(driver_module_info**)&fdtModule, (void**)&fdtDevice) != B_OK) {
+		return B_ERROR;
+	}
+	if (!fdt_device_enabled(fdtModule, fdtDevice))
+		return B_DEVICE_NOT_FOUND;
+
+	uint64 base;
+	uint64 length;
+	if (!fdtModule->get_reg(fdtDevice, 0, &base, &length)
+		|| length < kWindowSize) {
+		return B_ERROR;
+	}
+	status_t status = translate_fdt_address(fdtModule, fdtNode.Get(), base);
+	if (status != B_OK)
+		return status;
+
+	int32 interrupts[kIrqCount];
+	for (int32 i = 0; i < kIrqCount; i++) {
+		interrupts[i] = named_interrupt(fdtModule, fdtDevice,
+			kInterruptNames[i]);
+	}
+
+	MesonMali* device = new(std::nothrow) MesonMali(node);
+	if (device == NULL)
+		return B_NO_MEMORY;
+	status = device->Init(base, interrupts);
+	if (status != B_OK) {
+		INFO("not used: %s\n", strerror(status));
+		delete device;
+		return status;
+	}
+	sDevice = device;
+	add_debugger_command("mali", &dump_meson_mali,
+		"Shows the Mali-450's registers");
+	*_cookie = device;
+	return B_OK;
+}
+
+
+static void
+uninit_driver(void* cookie)
+{
+	remove_debugger_command("mali", &dump_meson_mali);
+	sDevice = NULL;
+	delete (MesonMali*)cookie;
+}
