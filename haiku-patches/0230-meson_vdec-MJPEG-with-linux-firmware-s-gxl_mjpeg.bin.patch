+++ b/headers/private/drivers/meson_vdec.h
@@ -11,8 +11,9 @@
 
 /*!	The Amlogic S905's (Meson GXBB) video decoder, /dev/video/meson_vdec/0.
 	One session at a time: start it with the codec's firmware, write the
-	compressed stream (an elementary stream: MPEG-1/2, or H.264 in Annex B
-	form), take the decoded frames in display order and give each back when
+	compressed stream (an elementary stream: MPEG-1/2, H.264 in Annex B
+	form, or MJPEG: baseline JPEG pictures one after the other, each written
+	whole), take the decoded frames in display order and give each back when
 	done with it. The frames are NV12 (a Y plane, then interleaved Cb and Cr
 	at half the height) in an area the caller clones; their contents are
 	valid from GET_FRAME until RECYCLE_FRAME. For H.264, the firmware asks
@@ -43,6 +44,11 @@ enum {
 	MESON_VDEC_HEVC = 3,
 		// Main and Main 10, 4:2:0, to 8-bit NV12; linux-firmware's
 		// gxl_hevc.bin
+	MESON_VDEC_MJPEG = 4,
+		// baseline JPEG to planar 4:2:0 (cr_offset; 4:2:2 pictures too);
+		// linux-firmware's gxl_mjpeg.bin; the size from the first picture's
+		// SOF, the same for all; a picture's frame comes once the next
+		// picture (or the end of the stream) is written
 };
 
 struct meson_vdec_start {
@@ -83,6 +89,10 @@ struct meson_vdec_frame {
 	size_t			offset;			// out: the frame's start in it
 	uint32			stream_offset;	// out: H.264: where in the stream its
 									// picture is (as WRITE's offset)
+	uint32			cr_offset;		// out: MJPEG: the frame is planar, Cb
+									// at chroma_offset and Cr here, each
+									// half the width and height, with
