--- a/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec_private.h
+++ b/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec_private.h
@@ -70,6 +70,7 @@ enum {
 // reset controller (byte offsets)
 enum {
 	RESET1						= 0x408,
+	RESET2						= 0x40c,
 };
 #define RESET1_PARSER				(1 << 8)	// a pulse
 
@@ -78,14 +79,19 @@ static const uint32 kFirstCanvas = 0x80;
 
 // DOS (byte offsets)
 enum {
+	VDEC_ASSIST_AMR1_INT8		= 0x00b4,
 	ASSIST_MBOX1_CLR_REG		= 0x01d4,
 	ASSIST_MBOX1_MASK			= 0x01d8,
 	MPSR						= 0x0c04,
+	MCPU_INTR_MSK				= 0x0c10,
 	CPSR						= 0x0c84,
 	IMEM_DMA_CTRL				= 0x0d00,
 	IMEM_DMA_ADR				= 0x0d04,
 	IMEM_DMA_COUNT				= 0x0d08,
+	PSCALE_RST					= 0x2440,
 	PSCALE_CTRL					= 0x2444,
+	PSCALE_BMEM_ADDR			= 0x247c,
+	PSCALE_BMEM_DAT				= 0x2480,
 	GCLK_EN						= 0x260c,
 	MDEC_PIC_DC_CTRL			= 0x2638,
 	ANC0_CANVAS_ADDR			= 0x2640,	// H.264: to 23, the frames
@@ -178,6 +184,10 @@ static const size_t kVififoMargin = 6 * 1024;
 	// the parser's own FIFO
 static const uint32 kFrameCount = 8;
 	// MPEG-1/2's
+static const uint32 kMjpegFrameCount = 4;
+	// MJPEG's: the firmware's protocol has room for no more
+#define MJPEG_REPORT_INDEX_MASK		0x7		// the frame + 1
+#define MJPEG_REPORT_INTERLACED		(1 << 5)
 static const uint32 kMaxFrames = 24;
 	// H.264's at most (and the queue's)
 static const uint32 kMaxWidth = 1920;
@@ -294,6 +304,7 @@ private:
 			bool				_CheckDecoder();
 			bool				_CheckMpeg12();
 			bool				_CheckH264();
+			bool				_CheckMjpeg();
 			bool				_CheckParser();
 			void				_QueueFrame(uint32 index, uint32 info,
 									uint32 offset);
@@ -323,6 +334,8 @@ private:
 			void				_SetupVififo();
 			status_t			_LoadFirmware(const void* userFirmware);
 			void				_StartCodec();
+			void				_StartMjpeg();
+			void				_SetupPictureScaler();
 			status_t			_StartH264(const void* userFirmware);
 	static	status_t			_SetupThread(void* data);
 			status_t			_SetupH264Frames(const uint32* info);
