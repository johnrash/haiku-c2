+	virtual int32		CountFrameSizes();
+	virtual status_t	GetFrameSize(int32 index, uint32& width,
+							uint32& height, float& frameRate,
+							bool& compressed);
 	virtual status_t	SetVideoFrame(BRect rect);
 	virtual BRect		VideoFrame() const { return fVideoFrame; };
