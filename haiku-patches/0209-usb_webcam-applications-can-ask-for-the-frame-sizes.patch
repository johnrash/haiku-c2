diff --git a/src/add-ons/media/media-add-ons/usb_webcam/Producer.cpp b/src/add-ons/media/media-add-ons/usb_webcam/Producer.cpp
index e369647b7d..36c5ae4528 100644
--- a/src/add-ons/media/media-add-ons/usb_webcam/Producer.cpp
+++ b/src/add-ons/media/media-add-ons/usb_webcam/Producer.cpp
@@ -22,6 +22,8 @@
 //XXX: change interface
 #include <interface/Bitmap.h>
 
+#include <VideoFrameSizes.h>
+
 #include "AddOn.h"
 #include "CamDevice.h"
 #include "CamSensor.h"
@@ -158,6 +160,38 @@ VideoProducer::HandleMessage(int32 message, const void* data, size_t size)
 				return B_BAD_VALUE;
 			_ReplaceCamera(*(CamDevice* const*)data);
 			return B_OK;
+
+		case VIDEO_FRAME_SIZES_REQUEST:
+		{
+			if (size < sizeof(video_frame_sizes_request))
+				return B_BAD_VALUE;
+			const video_frame_sizes_request* request
+				= (const video_frame_sizes_request*)data;
+
+			video_frame_sizes_reply reply;
+			memset(&reply, 0, sizeof(reply));
+			reply.status = B_NO_INIT;
+			if (HasCamera()) {
+				int32 count = fCamDevice->CountFrameSizes();
+				for (int32 i = 0; i < count
+						&& reply.count < VIDEO_FRAME_SIZES_MAX; i++) {
+					video_frame_size& frameSize = reply.sizes[reply.count];
+					bool compressed;
+					if (fCamDevice->GetFrameSize(i, frameSize.width,
+							frameSize.height, frameSize.frame_rate,
+							compressed) != B_OK) {
+						continue;
+					}
+					frameSize.flags
+						= compressed ? VIDEO_FRAME_SIZE_COMPRESSED : 0;
+					reply.count++;
+				}
+				reply.status = B_OK;
+			}
+			write_port_etc(request->reply_port, VIDEO_FRAME_SIZES_REPLY,
+				&reply, sizeof(reply), B_RELATIVE_TIMEOUT, 1000000);
+			return B_OK;
+		}
 	}
 	return B_ERROR;
 }
diff --git a/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCCamDevice.cpp b/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCCamDevice.cpp
index 19fb7cf5c2..69f4c78fe4 100644
--- a/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCCamDevice.cpp
+++ b/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/UVCCamDevice.cpp
@@ -671,6 +671,31 @@ UVCCamDevice::SuggestVideoFrame(uint32& width, uint32& height)
 }
 
 
+int32
+UVCCamDevice::CountFrameSizes()
+{
+	const Mode* modes[64];
+	return _SizeModes(modes);
+}
+
+
+status_t
+UVCCamDevice::GetFrameSize(int32 index, uint32& width, uint32& height,
+	float& frameRate, bool& compressed)
+{
+	const Mode* modes[64];
+	int32 count = _SizeModes(modes);
+	if (index < 0 || index >= count)
+		return B_BAD_INDEX;
+	width = modes[index]->width;
+	height = modes[index]->height;
+	frameRate = modes[index]->interval > 0
+		? 10000000.0f / modes[index]->interval : 0;
+	compressed = modes[index]->compressed;
+	return B_OK;
+}
+
+
 /*!	A frame size of either format; 0x0 asks for the suggested one. */
 status_t
 UVCCamDevice::AcceptVideoFrame(uint32& width, uint32& height)
@@ -788,6 +813,34 @@ UVCCamDevice::_FindMode(uint32 width, uint32 height) const
 }
 
 
+/*!	Each frame size once, as the mode AcceptVideoFrame() would choose for
+	it, from the smallest to the largest.
+*/
+int32
+UVCCamDevice::_SizeModes(const Mode** modes) const
+{
+	int32 count = 0;
+	for (int32 i = 0; i < fModeCount; i++) {
+		const Mode* mode = _FindMode(fModes[i].width, fModes[i].height);
+		bool listed = false;
+		for (int32 j = 0; j < count && !listed; j++)
+			listed = modes[j] == mode;
+		if (listed)
+			continue;
+
+		int32 at = count++;
+		uint32 pixels = (uint32)mode->width * mode->height;
+		while (at > 0 && (uint32)modes[at - 1]->width * modes[at - 1]->height
+				> pixels) {
+			modes[at] = modes[at - 1];
+			at--;
+		}
+		modes[at] = mode;
+	}
+	return count;
+}
+
+
 status_t
 UVCCamDevice::_ProbeCommitFormat()
 {
