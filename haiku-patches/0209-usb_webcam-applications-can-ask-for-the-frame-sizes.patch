diff --git a/headers/private/media/VideoFrameSizes.h b/headers/private/media/VideoFrameSizes.h
new file mode 100644
index 0000000000..333fa7165d
--- /dev/null
+++ b/headers/private/media/VideoFrameSizes.h
@@ -0,0 +1,53 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _VIDEO_FRAME_SIZES_H
+#define _VIDEO_FRAME_SIZES_H
+
+
+#include <OS.h>
+
+
+/*!	The frame sizes a video producer can stream, for an application to offer
+	them: it writes a video_frame_sizes_request to the producer node's
+	control port as VIDEO_FRAME_SIZES_REQUEST, and the producer writes a
+	video_frame_sizes_reply to the request's reply port as
+	VIDEO_FRAME_SIZES_REPLY. Unlike a format proposal, asking changes nothing
+	in the producer, also while it streams. usb_webcam answers it.
+*/
+
+
+enum {
+	VIDEO_FRAME_SIZES_REQUEST	= 0x60465301,
+	VIDEO_FRAME_SIZES_REPLY		= 0x60465302
+};
+
+enum {
+	VIDEO_FRAME_SIZE_COMPRESSED	= 0x01
+		// the camera sends it compressed (MJPEG): it costs CPU to decode
+};
+
+#define VIDEO_FRAME_SIZES_MAX	64
+
+
+struct video_frame_sizes_request {
+	port_id				reply_port;
+};
+
+struct video_frame_size {
+	uint32				width;
+	uint32				height;
+	float				frame_rate;
+	uint32				flags;
+};
+
+struct video_frame_sizes_reply {
+	status_t			status;
+	int32				count;
+	video_frame_size	sizes[VIDEO_FRAME_SIZES_MAX];
+		// from the smallest to the largest
+};
+
+
+#endif	// _VIDEO_FRAME_SIZES_H
diff --git a/src/add-ons/media/media-add-ons/usb_webcam/CamDevice.cpp b/src/add-ons/media/media-add-ons/usb_webcam/CamDevice.cpp
index 06c6d3b21c..d8a8fc0eea 100644
--- a/src/add-ons/media/media-add-ons/usb_webcam/CamDevice.cpp
+++ b/src/add-ons/media/media-add-ons/usb_webcam/CamDevice.cpp
@@ -213,6 +213,27 @@ CamDevice::SuggestVideoFrame(uint32 &width, uint32 &height)
 }
 
 
+/*!	Without a list of its own, a camera offers the size it suggests. */
+int32
+CamDevice::CountFrameSizes()
+{
+	uint32 width, height;
+	return SuggestVideoFrame(width, height) == B_OK ? 1 : 0;
+}
+
+
+status_t
+CamDevice::GetFrameSize(int32 index, uint32& width, uint32& height,
+	float& frameRate, bool& compressed)
+{
+	if (index != 0)
+		return B_BAD_INDEX;
+	frameRate = 0;
+	compressed = false;
+	return SuggestVideoFrame(width, height);
+}
+
+
 status_t
 CamDevice::AcceptVideoFrame(uint32 &width, uint32 &height)
 {
