+#ifndef DWC2_H
+#define DWC2_H
+
+
+#include "usb_private.h"
+
+#include <condition_variable.h>
+#include <lock.h>
+#include <util/DoublyLinkedList.h>
+
+
+class DWC2RootHub;
+
+
+struct dwc2_transfer : DoublyLinkedListLinkImpl<dwc2_transfer> {
+	Transfer*		transfer;
+	bigtime_t		due;			// interrupt transfers: next attempt
+	bool			canceled;
+};
+
+typedef DoublyLinkedList<dwc2_transfer> dwc2_transfer_list;
+
+
+/*!	Synopsys DesignWare "DWC2" USB 2.0 host controller as found on the
+	Amlogic Meson GXBB (S905, ODROID-C2), in buffer DMA mode.
+*/
+class DWC2 : public BusManager {
+public:
+								DWC2(Stack* stack, device_node* node,
+									phys_addr_t registers, size_t length,
+									int32 irq);
+								~DWC2();
+
+	virtual	status_t			InitCheck();
+	virtual	status_t			Start();
+
+	virtual	status_t			SubmitTransfer(Transfer* transfer);
+	virtual	status_t			CancelQueuedTransfers(Pipe* pipe, bool force);
+	virtual	status_t			NotifyPipeChange(Pipe* pipe,
+									usb_change change);
+
+	virtual	const char*			TypeName() const { return "dwc2"; }
+
+			// root hub
+			uint8				PortCount() const { return 1; }
+			status_t			GetPortStatus(uint8 index,
+									usb_port_status* status);
+			status_t			SetPortFeature(uint8 index, uint16 feature);
+			status_t			ClearPortFeature(uint8 index, uint16 feature);
+
+private:
+			uint32				_Read(uint32 offset)
+									{ return fRegisters[offset / 4]; }
+			void				_Write(uint32 offset, uint32 value)
+									{ fRegisters[offset / 4] = value; }
+
+			status_t			_InitPlatform();
+			status_t			_InitPhy();
+			status_t			_InitCore();
+			status_t			_WaitForReset(uint32 bits);
+			uint32				_PortBits();
+			status_t			_ResetPort();
+
+			status_t			_Process(dwc2_transfer* entry, bool* retry);
+			status_t			_ControlTransfer(Transfer* transfer,
+									size_t* actual);
+			status_t			_DataTransfer(Transfer* transfer, bool in,
+									size_t* actual, bool* nak);
+			status_t			_Transaction(Pipe* pipe, uint32 pid, bool in,
+									uint32 offset, uint32 length,
+									uint32* nextPid, size_t* actual,
+									bool* nak);
+			void				_HaltChannel();
+
+			status_t			_CopyToBounce(Transfer* transfer, uint32 offset,
+									size_t length);
+			status_t			_CopyFromBounce(Transfer* transfer,
+									uint32 offset, size_t length);
+
+	static	int32				_InterruptHandler(void* data);
+	static	status_t			_WorkerThread(void* data);
+			void				_Worker();
+
+private:
+			area_id				fRegisterArea;
+			volatile uint32*	fRegisters;
+			phys_addr_t			fPhysicalBase;
+			int32				fIrq;
+			bool				fInterruptInstalled;
+
+			area_id				fBounceArea;
+			uint8*				fBounce;
+			phys_addr_t			fBouncePhysical;
+
+			uint32				fChannelCount;
+			int8				fRootHubAddress;
+			DWC2RootHub*		fRootHub;
+			uint8				fPortResetChange;
+
+			mutex				fQueueLock;
+			dwc2_transfer_list	fQueue;
+			sem_id				fWorkSemaphore;
+			thread_id			fWorkerThread;
+			bool				fStopWorker;
+			dwc2_transfer*		fCurrent;
+
+			ConditionVariable	fChannelHalted;
+			int32				fChannelStatus;
+			bool				fWarnedSplit;
+};
+
+
+class DWC2RootHub : public Hub {
+public:
+								DWC2RootHub(Object* rootObject,
+									int8 deviceAddress);
+
+	static	status_t			ProcessTransfer(DWC2* dwc2,
+									Transfer* transfer);
+};
+
+
+#endif	// DWC2_H
