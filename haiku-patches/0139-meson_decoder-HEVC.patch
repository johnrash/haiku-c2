+ * Distributed under the terms of the MIT License.
+ */
+#ifndef H265_H
+#define H265_H
+
+
+#include <SupportDefs.h>
+
+
+/*!	What the decoder needs to know of an HEVC stream before decoding it:
+	from its first sequence parameter set.
+*/
+struct h265_sequence {
+	uint32	profile;			// general_profile_idc: 1 Main, 2 Main 10
+	uint32	level;				// general_level_idc
+	uint32	chroma_format;		// 1: 4:2:0
+	uint32	bit_depth;			// luma and chroma (0 if they differ)
+	uint32	coded_width;
+	uint32	coded_height;
+	uint32	width;				// after cropping
+	uint32	height;
+};
+
+
+bool	h265_parse_sequence(const uint8* nal, size_t size,
+			h265_sequence& sequence);
+			// nal: from its 2-byte header, without the start code
+
+/*!	The parameter sets of an MP4/Matroska "hvcC" record as Annex B NAL units
+	(each after 00 00 00 01), and the length of the length prefix of the
+	stream's NAL units. Returns false if \a data is not an hvcC record.
+*/
+bool	h265_parse_hvcc(const uint8* data, size_t size, uint8* annexB,
+			size_t* _annexBSize, size_t annexBCapacity, uint32* _lengthSize);
+
+/*!	The first sequence parameter set in Annex B data. */
+const uint8* h265_find_sps(const uint8* data, size_t size, size_t* _nalSize);
+
+
+#endif	// H265_H
