@@ -0,0 +1,242 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * The little of HEVC's syntax (ITU-T H.265, 7.3.2.2 and 7.3.3) and of its
+ * MP4 storage (ISO/IEC 14496-15, the HEVCDecoderConfigurationRecord) the
+ * hardware decoder's plugin needs.
+ */
+
+
+#include "H265.h"
+
+#include <string.h>
+
+
+namespace {
+
+
+/*!	Reads the bits of a NAL unit's payload, skipping the emulation
+	prevention bytes (00 00 03 -> 00 00).
+*/
+class BitReader {
+public:
+	BitReader(const uint8* data, size_t size)
+		:
+		fData(data),
+		fSize(size),
+		fPosition(0),
+		fBit(0),
+		fZeros(0),
+		fByte(0),
+		fError(false)
+	{
+	}
+
+	bool Error() const { return fError; }
+
+	uint32 Bit()
+	{
+		if (fBit == 0 && !_NextByte())
+			return 0;
+		uint32 bit = (fByte >> (7 - fBit)) & 1;
+		fBit = (fBit + 1) % 8;
+		return bit;
+	}
+
+	uint32 Bits(uint32 count)
+	{
+		uint32 value = 0;
+		while (count-- > 0)
+			value = (value << 1) | Bit();
+		return value;
+	}
+
+	void Skip(uint32 count)
+	{
+		while (count-- > 0)
+			Bit();
+	}
+
+	uint32 UnsignedGolomb()
+	{
+		uint32 zeros = 0;
+		while (Bit() == 0) {
+			if (fError || ++zeros > 31) {
+				fError = true;
+				return 0;
+			}
+		}
+		return ((1u << zeros) - 1) + Bits(zeros);
+	}
+
+private:
+	bool _NextByte()
+	{
+		while (fPosition < fSize) {
+			uint8 byte = fData[fPosition++];
+			if (fZeros >= 2 && byte == 3) {
+				fZeros = 0;
+				continue;
+			}
+			fZeros = byte == 0 ? fZeros + 1 : 0;
+			fByte = byte;
+			return true;
+		}
+		fError = true;
+		return false;
+	}
+
+	const uint8*	fData;
+	size_t			fSize;
+	size_t			fPosition;
+	uint32			fBit;
+	uint32			fZeros;
+	uint8			fByte;
+	bool			fError;
+};
+
+
+inline uint32
+read_be(const uint8* data, uint32 length)
+{
+	uint32 value = 0;
+	for (uint32 i = 0; i < length; i++)
+		value = (value << 8) | data[i];
+	return value;
+}
+
+
+}	// namespace
+
+
+bool
+h265_parse_sequence(const uint8* nal, size_t size, h265_sequence& sequence)
+{
+	if (size < 4 || ((nal[0] >> 1) & 0x3f) != 33)
+		return false;
+
+	BitReader reader(nal + 2, size - 2);
+	memset(&sequence, 0, sizeof(sequence));
+	reader.Skip(4);		// sps_video_parameter_set_id
+	uint32 subLayers = reader.Bits(3);	// sps_max_sub_layers_minus1
+	reader.Skip(1);		// sps_temporal_id_nesting_flag
+
+	// profile_tier_level: the general part, then the sub-layers'
+	reader.Skip(2 + 1);	// general_profile_space, general_tier_flag
+	sequence.profile = reader.Bits(5);
+	reader.Skip(32);	// general_profile_compatibility_flags
+	reader.Skip(48);	// the source and constraint flags
+	sequence.level = reader.Bits(8);
+	bool profilePresent[8];
+	bool levelPresent[8];
+	for (uint32 i = 0; i < subLayers; i++) {
+		profilePresent[i] = reader.Bit() != 0;
+		levelPresent[i] = reader.Bit() != 0;
+	}
+	if (subLayers > 0) {
+		for (uint32 i = subLayers; i < 8; i++)
+			reader.Skip(2);
+	}
+	for (uint32 i = 0; i < subLayers; i++) {
+		if (profilePresent[i])
+			reader.Skip(88);
+		if (levelPresent[i])
+			reader.Skip(8);
+	}
+
+	reader.UnsignedGolomb();	// sps_seq_parameter_set_id
+	sequence.chroma_format = reader.UnsignedGolomb();
+	if (sequence.chroma_format == 3)
+		reader.Skip(1);			// separate_colour_plane_flag
+	sequence.coded_width = reader.UnsignedGolomb();
+	sequence.coded_height = reader.UnsignedGolomb();
+	sequence.width = sequence.coded_width;
+	sequence.height = sequence.coded_height;
+	if (reader.Bit()) {
+		// conformance_window_flag: in chroma samples
+		uint32 left = reader.UnsignedGolomb();
+		uint32 right = reader.UnsignedGolomb();
+		uint32 top = reader.UnsignedGolomb();
+		uint32 bottom = reader.UnsignedGolomb();
+		uint32 unitX = sequence.chroma_format == 1
+			|| sequence.chroma_format == 2 ? 2 : 1;
+		uint32 unitY = sequence.chroma_format == 1 ? 2 : 1;
+		uint32 cropX = (left + right) * unitX;
+		uint32 cropY = (top + bottom) * unitY;
+		if (cropX >= sequence.coded_width || cropY >= sequence.coded_height)
+			return false;
+		sequence.width -= cropX;
+		sequence.height -= cropY;
+	}
+	uint32 lumaDepth = reader.UnsignedGolomb() + 8;
+	uint32 chromaDepth = reader.UnsignedGolomb() + 8;
+	sequence.bit_depth = lumaDepth == chromaDepth ? lumaDepth : 0;
+	return !reader.Error() && sequence.coded_width > 0
+		&& sequence.coded_height > 0 && sequence.coded_width <= 16384
+		&& sequence.coded_height <= 16384;
+}
+
+
+bool
+h265_parse_hvcc(const uint8* data, size_t size, uint8* annexB,
+	size_t* _annexBSize, size_t annexBCapacity, uint32* _lengthSize)
+{
+	// version 1; profile, compatibility, constraints, level, ... (22 bytes);
+	// the length size - 1 in the low bits of byte 21; byte 22: the arrays
+	if (size < 23 || data[0] != 1)
+		return false;
+	*_lengthSize = (data[21] & 3) + 1;
+
+	uint32 arrays = data[22];
+	size_t position = 23;
+	size_t written = 0;
+	for (uint32 array = 0; array < arrays; array++) {
+		// completeness and the NAL unit type, the count
+		if (position + 3 > size)
+			return false;
+		uint32 count = read_be(data + position + 1, 2);
+		position += 3;
+		for (uint32 i = 0; i < count; i++) {
+			if (position + 2 > size)
+				return false;
+			uint32 length = read_be(data + position, 2);
+			position += 2;
+			if (position + length > size
+				|| written + 4 + length > annexBCapacity) {
+				return false;
+			}
+			static const uint8 kStartCode[4] = { 0, 0, 0, 1 };
+			memcpy(annexB + written, kStartCode, 4);
+			memcpy(annexB + written + 4, data + position, length);
+			written += 4 + length;
+			position += length;
+		}
+	}
+	*_annexBSize = written;
+	return true;
+}
+
+
+const uint8*
+h265_find_sps(const uint8* data, size_t size, size_t* _nalSize)
+{
+	for (size_t i = 0; i + 4 < size; i++) {
+		if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1
+			|| ((data[i + 3] >> 1) & 0x3f) != 33) {
+			continue;
+		}
+		const uint8* nal = data + i + 3;
+		size_t end = i + 3;
+		while (end + 2 < size
+			&& !(data[end] == 0 && data[end + 1] == 0
+				&& (data[end + 2] == 1 || data[end + 2] == 0))) {
+			end++;
+		}
+		if (end + 2 >= size)
+			end = size;
+		*_nalSize = data + end - nal;
+		return nal;
+	}
+	return NULL;
+}
