+
+/*!	An isochronous transfer: its packets, one per frame, wait in a slot of
+	the stream's bounce buffer, each at a multiple of \a stride. An IN
+	packet may arrive in pieces, each stored at the next 32-bit boundary.
+*/
+struct dwc2_iso_transfer : DoublyLinkedListLinkImpl<dwc2_iso_transfer> {
+	Transfer*		transfer;
+	struct dwc2_iso_stream* stream;
+	uint32			slot;
+	uint32			packetCount;
+	uint32			stride;
+	uint16			length[kIsoMaxPackets];
+	uint16			actual[kIsoMaxPackets];
+	status_t		status[kIsoMaxPackets];
+	uint8			pieceCount[kIsoMaxPackets];
+	uint8			pieces[kIsoMaxPackets][kIsoMaxPieces];
+};
+
+typedef DoublyLinkedList<dwc2_iso_transfer> dwc2_iso_transfer_list;
+
+
+/*!	What an isochronous stream did. It is reported when the stream stops:
+	nothing is printed while it runs, since serial debug output keeps
+	interrupts off for milliseconds.
+*/
+struct dwc2_iso_statistics {
+	uint64		packets;
+	uint64		bytes;
+	uint64		late;				// skipped: the timer came too late
+	uint64		errors;
+	uint32		lastError;			// channel status
+	uint64		gaps;				// OUT: parts not in consecutive
+									// microframes
+	uint64		empty;				// IN: zero-length packets
+	uint32		completeSplits[8];	// IN: data at complete-split n
+	bigtime_t	worstTimer;			// the latest the timer fired
+};
+
+
+/*!	One isochronous endpoint of a full speed device behind the high speed
+	hub, on a host channel of its own. Each frame a timer arms the channel
+	for the frame's packet; its start-split parts (and complete-splits, IN)
+	follow from the channel's halt interrupt. State changes under
+	DWC2::fIsoLock.
+*/
+struct dwc2_iso_stream {
+	timer					armTimer;		// first: the hook's argument
+	DWC2*					dwc2;
+	Pipe*					pipe;			// NULL: unused
+	uint32					channel;
+	bool					in;
+	uint8*					bounce;
+	phys_addr_t				bouncePhysical;
+	uint32					freeSlots;		// bit mask
+	dwc2_iso_transfer_list	queue;			// head: being sent
+	uint32					packet;			// of the head transfer
+	uint32					part;			// start-split part / complete-split
+	uint32					size;			// of the running part
+	uint32					pieceOffset;	// IN: where the next piece goes
+	uint32					received;		// IN: bytes of the packet so far
+	bool					running;		// the channel is enabled
+	bool					timerPending;
+	bool					stopping;
+	bigtime_t				timerTarget;
+	uint32					partFrame;		// microframe of the last part
+
+	dwc2_iso_statistics		stats;
+};
