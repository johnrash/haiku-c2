diff --git a/src/add-ons/kernel/busses/usb/dwc2_isochronous.cpp b/src/add-ons/kernel/busses/usb/dwc2_isochronous.cpp
new file mode 100644
index 0000000000..af6d8cc4ea
--- /dev/null
+++ b/src/add-ons/kernel/busses/usb/dwc2_isochronous.cpp
@@ -0,0 +1,656 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * Isochronous transfers of the DWC2 host driver (dwc2.cpp): full speed
+ * devices behind the ODROID-C2's high speed hub, such as USB audio.
+ *
+ * An isochronous endpoint moves one packet per 1 ms frame. Through the
+ * hub's transaction translator (USB 2.0, 11.18 to 11.21) a packet goes
+ * - OUT: as start-splits only, in consecutive microframes, each with up to
+ *   188 bytes ("all", or "begin", "mid"..., "end");
+ * - IN: as a start-split, then complete-splits in the following
+ *   microframes until one returns the data (the translator answers NYET
+ *   until it has it). When the device's packet crosses a microframe
+ *   boundary, the translator hands it over in pieces: MDATA with what it
+ *   has so far, DATA0 with the rest.
+ * The controller runs a periodic channel in the next microframe whose
+ * parity matches HCCHAR.ODDFRM. A kernel timer fires in the microframe
+ * before a packet's start microframe and arms the channel for it; the
+ * channel's halt interrupt then arms each further part for the microframe
+ * after. OUT packets start in microframe 0. IN packets start in microframe
+ * 2: a device prepares its packet when the full speed frame begins, and an
+ * IN token right at its start may find nothing ready yet (an audio device's
+ * microphone answered a third of them with zero-length packets). A packet
+ * that cannot start in time is skipped, so every packet keeps its frame;
+ * all start-splits go out by microframe 5, where the translator runs them
+ * within the same full speed frame.
+ *
+ * The data waits in slots of the stream's bounce buffer (32-bit DMA, cache
+ * maintained by hand): OUT data is copied in when the transfer is
+ * submitted; a worker thread copies IN data out, fills in the packet
+ * descriptors and finishes the transfers.
+ */
+
+
+#include "dwc2.h"
+#include "dwc2_hardware.h"
+
+#include <new>
+#include <stdio.h>
+#include <string.h>
+
+#include <AutoDeleter.h>
+#include <kernel.h>
+#include <util/AutoLock.h>
+
+
+#define INFO(x...)				dprintf("dwc2: " x)
+
+static const uint32 kSplitPayload = 188;
+	// the most one start-split carries for a full speed isochronous OUT
+static const uint32 kMaxCompleteSplits = 6;
+static const bigtime_t kIsoArmDelay = 30;
+	// into the microframe before the start: clear of the one before that,
+	// where arming would start the packet two microframes early
+
+
+/*!	The microframe a stream's packets start in (even, see above), and how
+	many microframes after the one before it the channel may still be armed.
+*/
+static uint32
+start_microframe(dwc2_iso_stream* stream)
+{
+	return stream->in ? 2 : 0;
+}
+
+
+static uint32
+arm_window(dwc2_iso_stream* stream)
+{
+	// OUT: start-splits up to microframe 5 for two parts; IN: complete-splits
+	// within the frame
+	return stream->in ? 2 : 4;
+}
+
+
+status_t
+DWC2::_InitIsochronous(uint8* bounce, phys_addr_t physical)
+{
+	fIsoSemaphore = create_sem(0, "dwc2 isochronous");
+	if (fIsoSemaphore < 0)
+		return fIsoSemaphore;
+
+	size_t streamSize = kIsoSlotCount * kIsoSlotSize;
+	for (uint32 i = 0; i < kIsoStreamCount; i++) {
+		dwc2_iso_stream& stream = fIsoStreams[i];
+		memset(&stream.armTimer, 0, sizeof(stream.armTimer));
+		stream.dwc2 = this;
+		stream.pipe = NULL;
+		stream.channel = kLaneCount + i;
+		stream.in = false;
+		stream.bounce = bounce + i * streamSize;
+		stream.bouncePhysical = physical + i * streamSize;
+		stream.freeSlots = (1 << kIsoSlotCount) - 1;
+		stream.packet = 0;
+		stream.part = 0;
+		stream.size = 0;
+		stream.running = false;
+		stream.timerPending = false;
+		stream.stopping = false;
+		stream.timerTarget = 0;
+		memset(&stream.stats, 0, sizeof(stream.stats));
+	}
+	return B_OK;
+}
+
+
+/*!	The stream of \a pipe, a new one if \a create is set and one is free.
+	Called with fIsoLock held.
+*/
+dwc2_iso_stream*
+DWC2::_IsoStreamFor(Pipe* pipe, bool create)
+{
+	dwc2_iso_stream* unused = NULL;
+	for (uint32 i = 0; i < kIsoStreamCount; i++) {
+		if (fIsoStreams[i].pipe == pipe)
+			return &fIsoStreams[i];
+		if (fIsoStreams[i].pipe == NULL && unused == NULL)
+			unused = &fIsoStreams[i];
+	}
+	if (!create || unused == NULL)
+		return NULL;
+
+	unused->pipe = pipe;
+	unused->in = pipe->Direction() == Pipe::In;
+	unused->freeSlots = (1 << kIsoSlotCount) - 1;
+	unused->packet = 0;
+	unused->part = 0;
+	memset(&unused->stats, 0, sizeof(unused->stats));
+	return unused;
+}
+
+
+status_t
+DWC2::_SubmitIsochronous(Transfer* transfer)
+{
+	Pipe* pipe = transfer->TransferPipe();
+	usb_isochronous_data* isochronousData = transfer->IsochronousData();
+	if (!fIsoAvailable || isochronousData == NULL)
+		return B_NOT_SUPPORTED;
+	if (!_NeedsSplit(pipe)) {
+		if (!fWarnedIso) {
+			INFO("isochronous endpoints of high speed devices are not"
+				" supported\n");
+			fWarnedIso = true;
+		}
+		return B_NOT_SUPPORTED;
+	}
+
+	// each packet at a 32-bit aligned place for the controller's DMA; IN
+	// packets get room for the alignment of their pieces
+	uint32 maxPacket = pipe->MaxPacketSize();
+	uint32 stride = maxPacket;
+	if (pipe->Direction() == Pipe::In)
+		stride += 3 * (kIsoMaxPieces - 1);
+	stride = (stride + 3) & ~(uint32)3;
+	uint32 count = isochronousData->packet_count;
+	if (count == 0 || count > kIsoMaxPackets || count * stride > kIsoSlotSize)
+		return B_BAD_VALUE;
+
+	dwc2_iso_transfer* entry = new(std::nothrow) dwc2_iso_transfer;
+	if (entry == NULL)
+		return B_NO_MEMORY;
+	ObjectDeleter<dwc2_iso_transfer> entryDeleter(entry);
+	entry->transfer = transfer;
+	entry->packetCount = count;
+	entry->stride = stride;
+	size_t total = 0;
+	for (uint32 i = 0; i < count; i++) {
+		uint32 length = isochronousData->packet_descriptors[i].request_length;
+		if (length > maxPacket)
+			return B_BAD_VALUE;
+		entry->length[i] = length;
+		entry->actual[i] = 0;
+		entry->status[i] = B_DEV_PENDING;
+		entry->pieceCount[i] = 0;
+		total += length;
+	}
+	if (total > transfer->DataLength())
+		return B_BAD_VALUE;
+
+	status_t status = transfer->InitKernelAccess();
+	if (status != B_OK)
+		return status;
+
+	InterruptsSpinLocker locker(fIsoLock);
+	dwc2_iso_stream* stream = _IsoStreamFor(pipe, true);
+	if (stream == NULL || stream->freeSlots == 0)
+		return B_BUSY;
+	entry->stream = stream;
+	entry->slot = 0;
+	while ((stream->freeSlots & (1 << entry->slot)) == 0)
+		entry->slot++;
+	stream->freeSlots &= ~(1 << entry->slot);
+	locker.Unlock();
+
+	uint8* slot = stream->bounce + entry->slot * kIsoSlotSize;
+	if (!stream->in) {
+		size_t offset = 0;
+		for (uint32 i = 0; i < count && status == B_OK; i++) {
+			status = dwc2_copy_transfer_data(transfer, offset,
+				slot + i * stride, entry->length[i], true);
+			offset += entry->length[i];
+		}
+		if (status != B_OK) {
+			locker.Lock();
+			stream->freeSlots |= 1 << entry->slot;
+			return status;
+		}
+	}
+	// OUT: the data has to be in memory for the DMA; IN: no dirty cache line
+	// may later be written back over what the controller stored
+	dwc2_dcache_maintain(stream->bouncePhysical + entry->slot * kIsoSlotSize,
+		count * stride, stream->in);
+
+	locker.Lock();
+	uint32 frame = (_Read(kHfnum) >> 3) + 1;
+	for (dwc2_iso_transfer* queued = stream->queue.Head(); queued != NULL;
+			queued = stream->queue.GetNext(queued)) {
+		frame += queued->packetCount;
+	}
+	frame -= stream->packet;
+	stream->queue.Add(entryDeleter.Detach());
+	if (!stream->running && !stream->timerPending && !stream->stopping)
+		_IsoScheduleTimer(stream);
+	locker.Unlock();
+
+	if (isochronousData->starting_frame_number != NULL) {
+		frame &= 0x7ff;
+		if (IS_USER_ADDRESS(isochronousData->starting_frame_number)) {
+			user_memcpy(isochronousData->starting_frame_number, &frame,
+				sizeof(frame));
+		} else
+			*isochronousData->starting_frame_number = frame;
+	}
+	return B_OK;
+}
+
+
+/*!	Stops the stream of \a pipe and cancels its transfers; with \a force
+	(the pipe goes away) without calling back, and the stream is released.
+*/
+void
+DWC2::_CancelIsochronous(Pipe* pipe, bool force)
+{
+	InterruptsSpinLocker locker(fIsoLock);
+	dwc2_iso_stream* stream = _IsoStreamFor(pipe, false);
+	if (stream == NULL)
+		return;
+
+	// from now on neither the timer nor the halt interrupt arms the channel
+	stream->stopping = true;
+	bool running = stream->running;
+	if (running) {
+		_Write(HC_CHAR(stream->channel),
+			_Read(HC_CHAR(stream->channel)) | HCCHAR_CHDIS | HCCHAR_CHENA);
+	}
+	locker.Unlock();
+
+	// waits for the hook if it runs on another CPU; it must not be called
+	// with fIsoLock held
+	cancel_timer(&stream->armTimer);
+
+	for (int32 i = 0; i < 100 && running; i++) {
+		snooze(100);
+		locker.Lock();
+		running = stream->running;
+		locker.Unlock();
+	}
+
+	dwc2_iso_transfer_list canceled;
+	locker.Lock();
+	if (stream->running) {
+		INFO("isochronous channel %" B_PRIu32 " did not halt\n",
+			stream->channel);
+		stream->running = false;
+	}
+	canceled.TakeFrom(&stream->queue);
+	if (force) {
+		dwc2_iso_transfer* entry = fIsoDone.Head();
+		while (entry != NULL) {
+			dwc2_iso_transfer* next = fIsoDone.GetNext(entry);
+			if (entry->stream == stream) {
+				fIsoDone.Remove(entry);
+				canceled.Add(entry);
+			}
+			entry = next;
+		}
+	}
+	stream->packet = 0;
+	stream->part = 0;
+	stream->timerPending = false;
+	stream->stopping = false;
+	bool in = stream->in;
+	dwc2_iso_statistics stats = stream->stats;
+	memset(&stream->stats, 0, sizeof(stream->stats));
+	locker.Unlock();
+
+	if (stats.packets > 0) {
+		char detail[96];
+		if (in) {
+			snprintf(detail, sizeof(detail), "%" B_PRIu64 " empty, data at"
+				" complete-split 1-4: %" B_PRIu32 " %" B_PRIu32 " %" B_PRIu32
+				" %" B_PRIu32, stats.empty, stats.completeSplits[1],
+				stats.completeSplits[2], stats.completeSplits[3],
+				stats.completeSplits[4]);
+		} else {
+			snprintf(detail, sizeof(detail), "%" B_PRIu64 " split gaps",
+				stats.gaps);
+		}
+		INFO("isochronous %s, device %d endpoint %d (hub %d port %d): %"
+			B_PRIu64 " packets, %" B_PRIu64 " bytes, %" B_PRIu64 " late, %"
+			B_PRIu64 " errors (last %#" B_PRIx32 "), timer up to %"
+			B_PRIdBIGTIME " us late; %s\n", in ? "IN" : "OUT",
+			pipe->DeviceAddress(), pipe->EndpointAddress() & 0xf,
+			pipe->HubAddress(), pipe->HubPort(), stats.packets, stats.bytes,
+			stats.late, stats.errors, stats.lastError, stats.worstTimer,
+			detail);
+	}
+
+	dwc2_iso_transfer* entry;
+	while ((entry = canceled.RemoveHead()) != NULL) {
+		if (!force)
+			entry->transfer->Finished(B_CANCELED, 0);
+		_IsoFinish(entry, false);
+	}
+
+	if (force) {
+		locker.Lock();
+		stream->pipe = NULL;
+	}
+}
+
+
+/*!	Arms the channel for the packet of the next start microframe (called
+	from the timer in the microframe before), or skips the packet if that is
+	too late. Called with fIsoLock held.
+*/
+void
+DWC2::_IsoArm(dwc2_iso_stream* stream)
+{
+	if (stream->queue.IsEmpty())
+		return;
+
+	uint32 arm = (start_microframe(stream) + 7) & 7;
+	uint32 offset = ((_Read(kHfnum) & 7) - arm) & 7;
+	if (offset == 7) {
+		// early: the packet would start two microframes before its time
+		_IsoScheduleTimer(stream);
+		return;
+	}
+	if (offset > arm_window(stream)) {
+		// too late for this frame: the packet is lost, the next one keeps
+		// its frame
+		stream->stats.late++;
+		_IsoPacketDone(stream, B_DEV_TOO_LATE, 0);
+		return;
+	}
+
+	// the start microframe (or a later even one, when the timer was late)
+	stream->part = 0;
+	stream->pieceOffset = 0;
+	stream->received = 0;
+	_IsoStartPart(stream, false);
+}
+
+
+/*!	Runs the current part of the head transfer's current packet on the
+	stream's channel, in the next microframe of the given parity.
+	Called with fIsoLock held.
+*/
+void
+DWC2::_IsoStartPart(dwc2_iso_stream* stream, bool oddFrame)
+{
+	dwc2_iso_transfer* entry = stream->queue.Head();
+	Pipe* pipe = stream->pipe;
+	uint32 length = entry->length[stream->packet];
+	uint32 offset = entry->slot * kIsoSlotSize + stream->packet * entry->stride;
+
+	uint32 split = HCSPLT_SPLTENA
+		| ((uint32)pipe->HubAddress() << HCSPLT_HUBADDR_SHIFT)
+		| (pipe->HubPort() & 0x7f);
+	uint32 size;
+	if (stream->in) {
+		// a start-split, then complete-splits; pieces one after the other
+		offset += stream->pieceOffset;
+		size = min_c(entry->stride - stream->pieceOffset,
+			(pipe->MaxPacketSize() + 3) & ~(uint32)3);
+		split |= HCSPLT_XACTPOS_ALL << HCSPLT_XACTPOS_SHIFT;
+		if (stream->part > 0)
+			split |= HCSPLT_COMPSPLT;
+	} else {
+		uint32 done = stream->part * kSplitPayload;
+		size = min_c(length - done, kSplitPayload);
+		offset += done;
+		uint32 position = HCSPLT_XACTPOS_MID;
+		if (length <= kSplitPayload)
+			position = HCSPLT_XACTPOS_ALL;
+		else if (done == 0)
+			position = HCSPLT_XACTPOS_BEGIN;
+		else if (length - done <= kSplitPayload)
+			position = HCSPLT_XACTPOS_END;
+		split |= position << HCSPLT_XACTPOS_SHIFT;
+	}
+	stream->size = size;
+
+	uint32 character = pipe->MaxPacketSize()
+		| ((pipe->EndpointAddress() & 0xf) << HCCHAR_EPNUM_SHIFT)
+		| (stream->in ? HCCHAR_EPDIR_IN : 0)
+		| (EPTYPE_ISOCHRONOUS << HCCHAR_EPTYPE_SHIFT)
+		| (1 << HCCHAR_MC_SHIFT)
+		| ((uint32)pipe->DeviceAddress() << HCCHAR_DEVADDR_SHIFT)
+		| (oddFrame ? HCCHAR_ODDFRM : 0);
+
+	uint32 channel = stream->channel;
+	_Write(HC_SPLT(channel), split);
+	_Write(HC_INT(channel), HCINT_ALL);
+	_Write(HC_INTMSK(channel), HCINT_CHHLTD);
+	_Write(HC_TSIZ(channel), size | (1 << HCTSIZ_PKTCNT_SHIFT)
+		| (PID_DATA0 << HCTSIZ_PID_SHIFT));
+	_Write(HC_DMA(channel), (uint32)(stream->bouncePhysical + offset));
+	asm volatile("dsb sy" : : : "memory");
+	_Write(HC_CHAR(channel), character | HCCHAR_CHENA);
+	stream->running = true;
+}
+
+
+/*!	The stream's channel halted: the next part goes out in the next
+	microframe, or the packet is done. Called from the interrupt handler
+	with fIsoLock held.
+*/
+void
+DWC2::_IsoHalted(dwc2_iso_stream* stream, uint32 status)
+{
+	if (!stream->running)
+		return;
+	stream->running = false;
+	if (stream->stopping || stream->queue.IsEmpty())
+		return;
+
+	uint32 frame = _Read(kHfnum) & 0x3fff;
+	bool nextOdd = ((frame + 1) & 1) != 0;
+	status_t error = dwc2_channel_error(status);
+
+	if (!stream->in) {
+		// start-splits of isochronous OUT get no handshake; the translator
+		// needs a packet's parts in consecutive microframes
+		if (stream->part > 0 && frame != ((stream->partFrame + 1) & 0x3fff))
+			stream->stats.gaps++;
+		stream->partFrame = frame;
+		if (error == B_OK && (status & HCINT_XFERCOMPL) != 0) {
+			uint32 length = stream->queue.Head()->length[stream->packet];
+			if ((stream->part + 1) * kSplitPayload < length) {
+				stream->part++;
+				_IsoStartPart(stream, nextOdd);
+				return;
+			}
+			_IsoPacketDone(stream, B_OK, length);
+			return;
+		}
+	} else if (stream->part == 0) {
+		// the start-split went through: complete-splits from the next
+		// microframe on
+		if (error == B_OK && (status & (HCINT_NAK | HCINT_NYET)) == 0) {
+			stream->part = 1;
+			_IsoStartPart(stream, nextOdd);
+			return;
+		}
+	} else if ((status & HCINT_NYET) != 0) {
+		// the translator does not have the data yet
+		if (stream->part < kMaxCompleteSplits) {
+			stream->part++;
+			_IsoStartPart(stream, nextOdd);
+			return;
+		}
+	} else if (error == B_OK && (status & HCINT_XFERCOMPL) != 0) {
+		uint32 transferSize = _Read(HC_TSIZ(stream->channel));
+		uint32 got = stream->size - (transferSize & HCTSIZ_XFERSIZE_MASK);
+		bool more = ((transferSize >> HCTSIZ_PID_SHIFT) & 3) == PID_MDATA;
+		dwc2_iso_transfer* entry = stream->queue.Head();
+		uint8& pieces = entry->pieceCount[stream->packet];
+		if (got == 0 && pieces == 0)
+			stream->stats.empty++;
+		entry->pieces[stream->packet][pieces++] = got;
+		stream->received += got;
+		stream->pieceOffset = (stream->pieceOffset + got + 3) & ~(uint32)3;
+		if (more && stream->part < kMaxCompleteSplits
+			&& pieces < kIsoMaxPieces) {
+			// the rest follows in the next microframe
+			stream->part++;
+			_IsoStartPart(stream, nextOdd);
+			return;
+		}
+		stream->stats.completeSplits[min_c(stream->part, 7)]++;
+		_IsoPacketDone(stream, B_OK, stream->received);
+		return;
+	}
+
+	stream->stats.lastError = status;
+	_IsoPacketDone(stream, error != B_OK ? error : B_DEV_DATA_UNDERRUN, 0);
+}
+
+
+/*!	Records the current packet's result and moves on to the next one (the
+	next frame). Called with fIsoLock held.
+*/
+void
+DWC2::_IsoPacketDone(dwc2_iso_stream* stream, status_t status,
+	uint32 actual)
+{
+	dwc2_iso_transfer* entry = stream->queue.Head();
+	entry->status[stream->packet] = status;
+	entry->actual[stream->packet] = actual;
+	stream->stats.packets++;
+	stream->stats.bytes += actual;
+	if (status != B_OK && status != B_DEV_TOO_LATE)
+		stream->stats.errors++;
+
+	stream->part = 0;
+	if (++stream->packet == entry->packetCount) {
+		stream->queue.Remove(entry);
+		fIsoDone.Add(entry);
+		stream->packet = 0;
+		release_sem_etc(fIsoSemaphore, 1, B_DO_NOT_RESCHEDULE);
+	}
+
+	if (!stream->queue.IsEmpty() && !stream->timerPending)
+		_IsoScheduleTimer(stream);
+}
+
+
+/*!	Sets the timer for the next microframe before the stream's start
+	microframe (or fires right away, when that has begun). Called with
+	fIsoLock held.
+*/
+void
+DWC2::_IsoScheduleTimer(dwc2_iso_stream* stream)
+{
+	uint32 hfnum = _Read(kHfnum);
+	uint32 microframe = hfnum & 7;
+	uint32 arm = (start_microframe(stream) + 7) & 7;
+	uint32 interval = _Read(kHfir) & 0xffff;
+	bigtime_t remaining = interval != 0
+		? (bigtime_t)(hfnum >> HFNUM_FRREM_SHIFT) * 125 / interval : 0;
+	bigtime_t delay = microframe == arm ? 0
+		: remaining + ((arm - microframe - 1) & 7) * 125 + kIsoArmDelay;
+
+	stream->timerTarget = system_time() + delay;
+	stream->timerPending = true;
+	add_timer(&stream->armTimer, &_IsoTimer, delay, B_ONE_SHOT_RELATIVE_TIMER);
+}
+
+
+/*static*/ int32
+DWC2::_IsoTimer(timer* timer)
+{
+	dwc2_iso_stream* stream = (dwc2_iso_stream*)timer;
+	DWC2* self = stream->dwc2;
+
+	SpinLocker locker(self->fIsoLock);
+	stream->timerPending = false;
+	bigtime_t late = system_time() - stream->timerTarget;
+	if (late > stream->stats.worstTimer)
+		stream->stats.worstTimer = late;
+	if (!stream->stopping && !stream->running)
+		self->_IsoArm(stream);
+	return B_HANDLED_INTERRUPT;
+}
+
+
+/*static*/ status_t
+DWC2::_IsoThread(void* data)
+{
+	((DWC2*)data)->_IsoWorker();
+	return B_OK;
+}
+
+
+/*!	Finishes the completed transfers. */
+void
+DWC2::_IsoWorker()
+{
+	while (acquire_sem(fIsoSemaphore) == B_OK) {
+		dwc2_iso_transfer_list done;
+		InterruptsSpinLocker locker(fIsoLock);
+		done.TakeFrom(&fIsoDone);
+		locker.Unlock();
+
+		dwc2_iso_transfer* entry;
+		while ((entry = done.RemoveHead()) != NULL)
+			_IsoFinish(entry, true);
+	}
+}
+
+
+/*!	Hands a transfer back: with \a callback, IN data and the packets'
+	results go to the transfer and it is finished.
+*/
+void
+DWC2::_IsoFinish(dwc2_iso_transfer* entry, bool callback)
+{
+	Transfer* transfer = entry->transfer;
+	dwc2_iso_stream* stream = entry->stream;
+	size_t total = 0;
+
+	if (callback) {
+		usb_isochronous_data* isochronousData = transfer->IsochronousData();
+		uint8* slot = stream->bounce + entry->slot * kIsoSlotSize;
+		if (stream->in) {
+			dwc2_dcache_maintain(
+				stream->bouncePhysical + entry->slot * kIsoSlotSize,
+				entry->packetCount * entry->stride, true);
+			status_t status = transfer->PrepareKernelAccess();
+			size_t offset = 0;
+			for (uint32 i = 0; i < entry->packetCount; i++) {
+				if (status != B_OK)
+					entry->actual[i] = 0;
+				// pieces, each from the next 32-bit boundary, as long as
+				// they fit the packet's place in the data
+				uint32 pieceOffset = 0;
+				uint32 copied = 0;
+				for (uint32 k = 0; k < entry->pieceCount[i]
+						&& copied < entry->actual[i]; k++) {
+					uint32 length = min_c((uint32)entry->pieces[i][k],
+						min_c(entry->actual[i], entry->length[i]) - copied);
+					if (length > 0) {
+						dwc2_copy_transfer_data(transfer, offset + copied,
+							slot + i * entry->stride + pieceOffset, length,
+							false);
+					}
+					copied += length;
+					pieceOffset = (pieceOffset + entry->pieces[i][k] + 3)
+						& ~(uint32)3;
+				}
+				entry->actual[i] = copied;
+				offset += entry->length[i];
+			}
+		}
+		for (uint32 i = 0; i < entry->packetCount; i++) {
+			isochronousData->packet_descriptors[i].actual_length
+				= entry->actual[i];
+			isochronousData->packet_descriptors[i].status = entry->status[i];
+			total += entry->actual[i];
+		}
+	}
+
+	// free the slot first: the callback usually submits the next transfer
+	InterruptsSpinLocker locker(fIsoLock);
+	stream->freeSlots |= 1 << entry->slot;
+	locker.Unlock();
+
+	if (callback)
+		transfer->Finished(B_OK, total);
+	delete transfer;
+	delete entry;
+}
