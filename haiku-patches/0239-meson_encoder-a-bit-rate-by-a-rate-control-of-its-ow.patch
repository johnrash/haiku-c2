+/*!	The QP for the next picture. The P pictures' follows a model of their
+	size (it halves every 6 QP steps, from the last pictures' sizes) toward
+	the average a picture may take, less a share of what was written beyond
+	it so far: what the IDR pictures and busy scenes take is made up within
+	half a second. An IDR picture takes the P pictures' QP less 3, but no
+	lower than keeps it in kMaxPictureBits.
+*/
+uint32
+MesonEncoder::_RateQp(bool idr)
+{
+	if (idr) {
+		double qp = fRateQp - kIdrQpOffset;
+		if (fComplexityI > 0) {
+			double lowest = 6 * log2(fComplexityI / kMaxPictureBits);
+			if (qp < lowest)
+				qp = lowest;
+		}
+		return (uint32)lround(fmin(fmax(qp, kMinQp), kMaxQp));
+	}
+
+	if (fComplexityP > 0) {
+		double target = fTargetBits
+			- fOverBits / fmax(fFrameRate / 2, 1);
+		if (target < fTargetBits / 4)
+			target = fTargetBits / 4;
+		double qp = 6 * log2(fComplexityP / target);
+		// settled, at most two steps a picture
+		double step = fPPictures < 10 ? 6 : 2;
+		fRateQp = fmin(fmax(qp, fRateQp - step), fRateQp + step);
+		fRateQp = fmin(fmax(fRateQp, kMinQp), kMaxQp);
+	}
+	return (uint32)lround(fRateQp);
+}
+
+
+void
+MesonEncoder::_RateUpdate(bool idr, uint32 qp, size_t size)
+{
+	double bits = size * 8.0;
+	double complexity = bits * exp2(qp / 6.0);
+	if (idr)
+		fComplexityI = complexity;
+	else {
+		fComplexityP = fComplexityP > 0
+			? 0.6 * complexity + 0.4 * fComplexityP : complexity;
+		fPPictures++;
+	}
+	fOverBits += bits - fTargetBits;
+	// at most two seconds' worth either way: an old excess counts no more
+	double limit = 2 * fTargetBits * fFrameRate;
+	fOverBits = fmin(fmax(fOverBits, -limit), limit);
+
+	fBitsWritten += size * 8;
+	fLowestQp = min_c(fLowestQp, qp);
+	fHighestQp = max_c(fHighestQp, qp);
+}
+
+
 void
 MesonEncoder::_Close()
 {
+	if (fTargetBits > 0 && fBitsWritten > 0) {
+		printf("MesonEncoder: %" B_PRId64 " pictures, %.2f Mbit/s asked, "
+			"%.2f written, QP %" B_PRIu32 " to %" B_PRIu32 "\n",
+			fFramesWritten, fTargetBits * fFrameRate / 1e6,
+			fBitsWritten * fFrameRate / fFramesWritten / 1e6, fLowestQp,
+			fHighestQp);
+		fflush(stdout);
+		fBitsWritten = 0;
+	}
 	if (fInputArea >= 0) {
 		delete_area(fInputArea);
 		fInputArea = -1;
