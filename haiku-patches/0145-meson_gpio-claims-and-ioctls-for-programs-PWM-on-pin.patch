+/*!	The pin as GPIO, an output or an input; its output level and pull stay
+	as they are. A PWM output stops.
+*/
+void
+MesonGpio::_SetDirection(size_t index, bool output)
+{
+	_DisablePwm(index);
+	const HeaderPin& pin = kPins[index];
+	const Bank& bank = kBanks[pin.bank];
+	_Set(kGpioOffset, bank.directionWord, bank.directionBit + pin.offset,
+		!output);
+	for (size_t i = 0; i < B_COUNT_OF(pin.functions); i++) {
+		const MuxBit& mux = pin.functions[i];
+		if (mux.function != NULL)
+			_Set(kMuxOffset, mux.word, mux.bit, false);
+	}
+}
+
+
+const PwmPin*
+MesonGpio::_PwmPin(size_t index)
+{
+	for (size_t i = 0; i < B_COUNT_OF(kPwmPins); i++) {
+		if (kPwmPins[i].pin == kPins[index].pin)
+			return &kPwmPins[i];
+	}
+	return NULL;
+}
+
+
+/*!	Stops the pin's PWM slot, if it has one. Only the slot's own enable bit
+	changes: the MISC word is shared with the other slot.
+*/
+void
+MesonGpio::_DisablePwm(size_t index)
+{
+	const PwmPin* pwm = _PwmPin(index);
+	fPwmActive[index] = false;
+	if (pwm == NULL)
+		return;
+	volatile uint32& misc = fPwmRegisters[(pwm->controller + kPwmMisc) / 4];
+	InterruptsLocker locker;
+	misc &= ~(pwm->slotB ? 1u << 1 : 1u << 0);
+}
+
+
+/*!	The pin as a PWM output, high for \a duty of every 255 crystal cycles;
+	0 and 255 as a GPIO output, low or high.
+*/
+status_t
+MesonGpio::_SetPwm(size_t index, uint32 duty)
+{
+	const PwmPin* pwm = _PwmPin(index);
+	if (pwm == NULL)
+		return B_NOT_SUPPORTED;
+	if (duty > 255)
+		return B_BAD_VALUE;
+	const HeaderPin& pin = kPins[index];
+
+	if (duty == 0 || duty == 255) {
+		const Bank& bank = kBanks[pin.bank];
+		_Set(kGpioOffset, bank.outputWord, bank.outputBit + pin.offset,
+			duty == 255);
+		_SetDirection(index, true);
+	} else {
+		// the counts first, then the slot (crystal, no divider, its clock
+		// on, running), then the pin
+		fPwmRegisters[(pwm->controller + (pwm->slotB ? 4 : 0)) / 4]
+			= ((duty - 1) << 16) | (kPwmPeriod - 1 - duty);
+		volatile uint32& misc
+			= fPwmRegisters[(pwm->controller + kPwmMisc) / 4];
+		uint32 fields = pwm->slotB
+			? (1u << 23) | (0x7fu << 16) | (3u << 6) | (1u << 1)
+			: (1u << 15) | (0x7fu << 8) | (3u << 4) | (1u << 0);
+		uint32 enable = pwm->slotB ? (1u << 23) | (1u << 1)
+			: (1u << 15) | (1u << 0);
+		{
+			InterruptsLocker locker;
+			misc = (misc & ~fields) | enable;
+		}
+		for (size_t i = 0; i < B_COUNT_OF(pin.functions); i++) {
+			const MuxBit& mux = pin.functions[i];
+			if (mux.function != NULL) {
+				_Set(kMuxOffset, mux.word, mux.bit,
+					strncmp(mux.function, "PWM", 3) == 0);
+			}
+		}
+	}
+	fPwmActive[index] = true;
+	fPwmDuty[index] = duty;
+	return B_OK;
+}
+
+
+status_t
+MesonGpio::_Claim(gpio_cookie* cookie, const meson_gpio_pins& pins)
+{
+	if (cookie->count != 0 || pins.count == 0
+		|| pins.count > B_COUNT_OF(pins.pins)) {
+		return B_BAD_VALUE;
+	}
+	uint8 indexes[B_COUNT_OF(pins.pins)];
+	for (uint32 i = 0; i < pins.count; i++) {
+		ssize_t index = -1;
+		for (size_t j = 0; j < kPinCount; j++) {
+			if (kPins[j].pin == pins.pins[i])
+				index = j;
+		}
+		if (index < 0)
+			return B_ENTRY_NOT_FOUND;
+		for (uint32 j = 0; j < i; j++) {
+			if (indexes[j] == index)
+				return B_BAD_VALUE;
+		}
+		const char* function = _Function(kPins[index]);
+		if (fOwner[index] != NULL || (kPins[index].i2c && function != NULL
+				&& strncmp(function, "I2C", 3) == 0)) {
+			return B_BUSY;
+		}
+		indexes[i] = index;
+	}
+	for (uint32 i = 0; i < pins.count; i++) {
+		// for "release", once the program is done
+		_Save(indexes[i]);
+		fOwner[indexes[i]] = cookie;
+		cookie->pins[i] = indexes[i];
+	}
+	cookie->count = pins.count;
+	return B_OK;
+}
+
+
+status_t
+MesonGpio::Control(gpio_cookie* cookie, uint32 op, void* buffer,
+	size_t length)
+{
+	MutexLocker locker(fLock);
+	switch (op) {
+		case MESON_GPIO_CLAIM:
+		{
+			meson_gpio_pins pins;
+			if (user_memcpy(&pins, buffer, sizeof(pins)) != B_OK)
+				return B_BAD_ADDRESS;
+			return _Claim(cookie, pins);
+		}
+
+		case MESON_GPIO_SET_OUTPUTS:
+		{
+			uint32 outputs;
+			if (user_memcpy(&outputs, buffer, sizeof(outputs)) != B_OK)
+				return B_BAD_ADDRESS;
+			for (uint32 i = 0; i < cookie->count; i++)
+				_SetDirection(cookie->pins[i], (outputs >> i) & 1);
+			return B_OK;
+		}
+
+		case MESON_GPIO_GET_OUTPUTS:
+		case MESON_GPIO_READ:
+		{
+			uint32 bits = 0;
+			for (uint32 i = 0; i < cookie->count; i++) {
+				const HeaderPin& pin = kPins[cookie->pins[i]];
+				const Bank& bank = kBanks[pin.bank];
+				bool set;
+				if (op == MESON_GPIO_READ) {
+					set = _Get(kGpioOffset, bank.inputWord,
+						bank.inputBit + pin.offset);
+				} else {
+					set = _Function(pin) == NULL
+						&& !_Get(kGpioOffset, bank.directionWord,
+							bank.directionBit + pin.offset);
+				}
+				if (set)
+					bits |= 1u << i;
+			}
+			return user_memcpy(buffer, &bits, sizeof(bits));
+		}
+
+		case MESON_GPIO_SET_PWM:
+		case MESON_GPIO_GET_PWM:
+		{
+			meson_gpio_pwm pwm;
+			if (user_memcpy(&pwm, buffer, sizeof(pwm)) != B_OK)
+				return B_BAD_ADDRESS;
+			if (pwm.bit >= cookie->count)
+				return B_BAD_VALUE;
+			size_t index = cookie->pins[pwm.bit];
+			if (op == MESON_GPIO_SET_PWM)
+				return _SetPwm(index, pwm.duty);
+			if (_PwmPin(index) == NULL)
+				return B_NOT_SUPPORTED;
+			pwm.duty = fPwmDuty[index];
+			return user_memcpy(buffer, &pwm, sizeof(pwm));
+		}
+
+		case MESON_GPIO_WRITE:
+		{
+			uint32 levels;
+			if (user_memcpy(&levels, buffer, sizeof(levels)) != B_OK)
+				return B_BAD_ADDRESS;
+			for (uint32 i = 0; i < cookie->count; i++) {
+				const HeaderPin& pin = kPins[cookie->pins[i]];
+				const Bank& bank = kBanks[pin.bank];
+				_Set(kGpioOffset, bank.outputWord, bank.outputBit + pin.offset,
+					(levels >> i) & 1);
+			}
+			return B_OK;
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+/*!	The file is closed: its GPIO pins become inputs, its PWM outputs stay,
+	and the pins are free again.
+*/
+void
+MesonGpio::Free(gpio_cookie* cookie)
+{
+	MutexLocker locker(fLock);
+	for (uint32 i = 0; i < cookie->count; i++) {
+		size_t index = cookie->pins[i];
+		if (!fPwmActive[index] && _Function(kPins[index]) == NULL)
+			_SetDirection(index, false);
+		fOwner[index] = NULL;
+	}
+	cookie->count = 0;
+}
+
