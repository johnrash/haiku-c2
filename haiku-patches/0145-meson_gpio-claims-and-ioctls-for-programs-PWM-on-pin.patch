+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _MESON_GPIO_H
+#define _MESON_GPIO_H
+
+
+#include <Drivers.h>
+
+
+/*!	The ODROID-C2's 40-pin header as GPIO (meson_gpio). Reading the device
+	gives a table of the pins, writing it takes text commands (see the
+	driver); these ioctls are the binary interface programs use (libdevice's
+	BDigitalPort and BD2A).
+
+	An open file first claims the pins it uses, in an order of its choice:
+	the other calls take and give a bit for each of them, bit 0 for the
+	first. A pin belongs to one open file at a time, and the text commands
+	leave claimed pins alone. When the file is closed, its GPIO pins become
+	inputs; its PWM outputs keep their duty cycle (as the BeBox's D/A
+	converter kept its voltage).
+*/
+
+
+#define MESON_GPIO_DEVICE	"/dev/misc/gpio"
+
+enum {
+	MESON_GPIO_CLAIM = B_DEVICE_OP_CODES_END + 0x4750,
+		// meson_gpio_pins: B_BUSY if another file has one of them, or its
+		// I2C function is selected; once per file
+	MESON_GPIO_SET_OUTPUTS,
+		// uint32: the claimed pins with their bit set become GPIO outputs
+		// (at the level last written), the others GPIO inputs
+	MESON_GPIO_GET_OUTPUTS,
+		// uint32: which claimed pins are GPIO outputs
+	MESON_GPIO_READ,
+		// uint32: the claimed pins' levels
+	MESON_GPIO_WRITE,
+		// uint32: the claimed pins' output levels (also for inputs: the
+		// level they get as outputs)
+	MESON_GPIO_SET_PWM,
+		// meson_gpio_pwm: a claimed pin as a PWM output (pins 11 and 19)
+	MESON_GPIO_GET_PWM,
+		// meson_gpio_pwm: in pin, out duty (the last one set, by any file)
+};
+
+
+struct meson_gpio_pins {
+	uint32		count;
+	uint8		pins[32];		// header pin numbers
+};
+
+
+struct meson_gpio_pwm {
+	uint32		bit;			// the claimed pin's bit
+	uint32		duty;			// 0 (low) to 255 (high), at about 94 kHz
+};
+
+
+#endif	// _MESON_GPIO_H
