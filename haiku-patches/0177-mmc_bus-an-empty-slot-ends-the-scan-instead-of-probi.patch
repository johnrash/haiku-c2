From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Sat, 31 Oct 2026 18:21:31 -0400
Subject: [PATCH 177/342] mmc_bus: an empty slot ends the scan instead of
 probing forever

Without card detect (the Meson GX driver), CMD0 "works" on an empty slot,
since it has no response to check. CMD8 and CMD1 then time out, and the
ACMD41 loop ignored CMD55's and ACMD41's failures, so it went on forever
(about 10 rounds a second), logging "Card did not enter ACMD mode" from
an uninitialized status. Now a CMD55 or ACMD41 that fails, or a card that
isn't ready within 2 s (both specifications allow 1 s), ends the scan
with one "No card ready" line until the next scan request.

meson_gx_mmc: "(read-only)" only for a card that is.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../kernel/bus_managers/mmc/mmc_bus.cpp       | 45 +++++++++++++++++--
 .../kernel/busses/mmc/meson_gx_mmc.cpp        | 12 ++---
 2 files changed, 48 insertions(+), 9 deletions(-)

diff --git a/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp b/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
index d7ba54b9e6..af7801ac26 100644
--- a/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
+++ b/src/add-ons/kernel/bus_managers/mmc/mmc_bus.cpp
@@ -218,6 +218,9 @@ MMCBus::_WorkerThread(void* cookie)
 	// out
 	snooze(30000);
 
+	// Both specifications give a card 1 s to get ready (ACMD41, CMD1)
+	static const bigtime_t kCardReadyTimeout = 2000000;
+
 	while (bus->fStatus != B_SHUTTING_DOWN) {
 		TRACE("Scanning the bus\n");
 
@@ -241,7 +244,7 @@ MMCBus::_WorkerThread(void* cookie)
 		// If ACMD41 also does not work, it may be an SDIO card, too
 		uint32_t probe = (HOST_27_36V << 8) | kVoltageCheckPattern;
 		uint32_t hcs = 1 << 30;
-		uint32_t ocr;
+		uint32_t ocr = 0;
 		status_t status = bus->ExecuteCommand(0, SD_SEND_IF_COND, probe, &response);
 		if (status != B_OK) {
 			TRACE("Card does not implement CMD8, may be a V1 SD or MMC card\n");
@@ -249,6 +252,7 @@ MMCBus::_WorkerThread(void* cookie)
 			hcs = 0;
 
 			TRACE("Trying MMC CMD1 initialization...\n");
+			bigtime_t deadline = system_time() + kCardReadyTimeout;
 			do {
 				status = bus->ExecuteCommand(0, MMC_SEND_OP_COND, 0xFF8000, &ocr);
 				// full voltage window, byte addressable, should look into this.
@@ -257,6 +261,12 @@ MMCBus::_WorkerThread(void* cookie)
 					break;
 				}
 				if ((ocr & (1 << 31)) == 0) {
+					if (system_time() >= deadline) {
+						// an MMC card that stays busy: no ACMD41 either
+						cardType = CARD_TYPE_MMC;
+						status = B_TIMED_OUT;
+						break;
+					}
 					TRACE("MMC card is busy\n");
 					snooze(100000);
 				}
@@ -281,26 +291,53 @@ MMCBus::_WorkerThread(void* cookie)
 		// We keep repeating ACMD41 until the card replies that it is
 		// initialized. For MMC we already probed using CMD1 above.
 		if ((cardType != CARD_TYPE_MMC) && (cardType != CARD_TYPE_MMC_EXTENDED_CAPACITY)) {
+			bigtime_t deadline = system_time() + kCardReadyTimeout;
 			do {
-				uint32_t cardStatus;
-				while (bus->ExecuteCommand(0, SD_APP_CMD, 0, &cardStatus) == B_BUSY) {
+				uint32_t cardStatus = 0;
+				while ((status = bus->ExecuteCommand(0, SD_APP_CMD, 0,
+						&cardStatus)) == B_BUSY) {
 					ERROR("Card locked after CMD8...\n");
 					snooze(1000000);
 				}
+				if (status != B_OK) {
+					// nothing answers CMD8, CMD1 or CMD55: no card
+					break;
+				}
 				if ((cardStatus & 0xFFFF8000) != 0)
 					ERROR("SD card reports error %x\n", cardStatus);
 				if ((cardStatus & (1 << 5)) == 0)
 					ERROR("Card did not enter ACMD mode\n");
 
-				bus->ExecuteCommand(0, SD_SEND_OP_COND, hcs | 0xFF8000, &ocr);
+				ocr = 0;
+				status = bus->ExecuteCommand(0, SD_SEND_OP_COND,
+					hcs | 0xFF8000, &ocr);
+				if (status != B_OK)
+					break;
 
 				if ((ocr & (1 << 31)) == 0) {
+					if (system_time() >= deadline) {
+						status = B_TIMED_OUT;
+						break;
+					}
 					TRACE("Card is busy\n");
 					snooze(100000);
 				}
 			} while ((ocr & (1 << 31)) == 0);
 		}
 
+		if (status != B_OK) {
+			// An empty slot (CMD0 has no response, so it "works" there too),
+			// or a card that never got ready. Probing again would only repeat
+			// that: wait for the next scan request, as for an unpowered bus.
+			TRACE_ALWAYS("No card ready (%s)\n", strerror(status));
+			bus->_AcquireScanSemaphore();
+			if (bus->fStatus == B_SHUTTING_DOWN)
+				break;
+			bus->ExecuteCommand(0, GO_IDLE_STATE, 0, NULL);
+			snooze(30000);
+			continue;
+		}
+
 		// FIXME this should be asked to each card, when there are multiple
 		// ones. So ACMD41 should be moved inside the probing loop below?
 		if (cardType == CARD_TYPE_SD) {
diff --git a/src/add-ons/kernel/busses/mmc/meson_gx_mmc.cpp b/src/add-ons/kernel/busses/mmc/meson_gx_mmc.cpp
index 2294d0e88f..6fcf4515f1 100644
--- a/src/add-ons/kernel/busses/mmc/meson_gx_mmc.cpp
+++ b/src/add-ons/kernel/busses/mmc/meson_gx_mmc.cpp
@@ -623,8 +623,9 @@ MesonMmc::SetCardType(card_type type)
 void
 MesonMmc::SetScanSemaphore(sem_id semaphore)
 {
-	// Both slots are treated as populated: the eMMC is soldered in and the
-	// SD card holds the firmware we booted from. There is no card detect.
+	// No card detect: the bus manager scans once and finds an empty slot
+	// (an eMMC socket without a module, an SD slot without a card) when
+	// nothing answers.
 	fScanSemaphore = semaphore;
 	release_sem(fScanSemaphore);
 }
@@ -1274,9 +1275,9 @@ init_driver(device_node* node, void** _cookie)
 	irq = 0;
 #endif
 
+	bool readOnly = removable && !sd_writable();
 	MesonMmc* controller = new(std::nothrow) MesonMmc(area,
-		(volatile uint32*)mapped, registers, (int32)irq,
-		removable && !sd_writable(),
+		(volatile uint32*)mapped, registers, (int32)irq, readOnly,
 		removable ? kProtectedRemovableBlocks : 0);
 	if (controller == NULL) {
 		delete_area(area);
@@ -1284,7 +1285,8 @@ init_driver(device_node* node, void** _cookie)
 	}
 
 	INFO("controller at %#" B_PRIx64 ", %s\n", registers,
-		removable ? "removable card (read-only)" : "eMMC");
+		!removable ? "eMMC"
+			: readOnly ? "removable card (read-only)" : "removable card");
 	log_firmware_clocks();
 	controller->Init();
 
