 #ifndef _KERNEL_ARCH_ARM64_ARCH_USER_DEBUGGER_H_
 #define _KERNEL_ARCH_ARM64_ARCH_USER_DEBUGGER_H_
 
 
+// Hardware break- and watchpoints the kernel uses at most (ARMv8 has 2 to 16
+// of each; the Cortex-A53 has 6 breakpoints and 4 watchpoints). Fewer are
+// used if the CPU has fewer (ID_AA64DFR0_EL1).
+#define ARM64_BREAKPOINT_COUNT		6
+#define ARM64_WATCHPOINT_COUNT		4
+
+// The software breakpoint instruction: "brk #0", as GDB uses it.
+#define ARM64_SOFTWARE_BREAKPOINT	0xd4200000
+
+
+#ifndef _ASSEMBLER
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct iframe;
+
+
+struct arm64_hardware_breakpoint {
+	void*		address;	// NULL: unused
+	uint32		control;	// DBGBCR<n>_EL1/DBGWCR<n>_EL1 value
+};
+
+
 struct arch_team_debug_info {
+	struct arm64_hardware_breakpoint	breakpoints[ARM64_BREAKPOINT_COUNT];
+	struct arm64_hardware_breakpoint	watchpoints[ARM64_WATCHPOINT_COUNT];
+};
+
+
+// arch_thread_debug_info::flags
+enum {
+	// the debugger let the thread continue at resume_address: the first
+	// instruction there runs without hardware break- and watchpoints (what
+	// the x86 resume flag does for instruction breakpoints)
+	ARM64_THREAD_DEBUG_RESUMING		= 0x01,
+	// single-stepping that instruction, break- and watchpoints off
+	ARM64_THREAD_DEBUG_STEP_OVER	= 0x02,
+	// the debugger asked for a single step
+	ARM64_THREAD_DEBUG_STEP_USER	= 0x04,
+	// MDSCR_EL1.SS was set for this thread on its way to userland
+	ARM64_THREAD_DEBUG_SS_ENABLED	= 0x08,
 };
 
 
 struct arch_thread_debug_info {
+	uint32		flags;
+	addr_t		resume_address;
 };
 
 
+extern const uint8 kArm64SoftwareBreakpoint[4];
+
+void arm64_init_user_debug();
+void arm64_init_user_debug_percpu();
+void arm64_user_debug_at_kernel_entry();
+void arm64_user_debug_at_kernel_exit(struct iframe* frame);
+bool arm64_handle_debug_exception(struct iframe* frame, uint32 exceptionClass);
+
+#ifdef __cplusplus
+}
+#endif
+
+
+#define ARCH_INIT_USER_DEBUG	arm64_init_user_debug
+
+// Feature macros we're supposed to define.
+#define DEBUG_MAX_BREAKPOINTS			ARM64_BREAKPOINT_COUNT
+#define DEBUG_MAX_WATCHPOINTS			ARM64_WATCHPOINT_COUNT
+#define DEBUG_SOFTWARE_BREAKPOINT		kArm64SoftwareBreakpoint
+#define DEBUG_SOFTWARE_BREAKPOINT_SIZE	4
+#define DEBUG_SHARED_BREAK_AND_WATCHPOINTS	0
+
+#endif	// !_ASSEMBLER
+
+
 #endif /* _KERNEL_ARCH_ARM64_ARCH_USER_DEBUGGER_H_ */
