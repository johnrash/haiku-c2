+// #pragma mark - in-kernel public interface
+
+
 void
 arch_clear_team_debug_info(struct arch_team_debug_info *info)
 {
+	memset(info, 0, sizeof(*info));
 }
 
 
 void
 arch_destroy_team_debug_info(struct arch_team_debug_info *info)
 {
+	arch_clear_team_debug_info(info);
 }
 
 
 void
 arch_clear_thread_debug_info(struct arch_thread_debug_info *info)
 {
+	info->flags = 0;
+	info->resume_address = 0;
 }
 
 
 void
 arch_destroy_thread_debug_info(struct arch_thread_debug_info *info)
 {
+	arch_clear_thread_debug_info(info);
 }
 
 
+/*!	Called by the current thread whenever the debugger lets it continue. */
 void
 arch_update_thread_single_step()
 {
+	Thread* thread = thread_get_current_thread();
+	iframe* frame = arm64_get_user_iframe(thread);
+	if (frame == NULL)
+		return;
+
+	InterruptsLocker interruptsLocker;
+	arch_thread_debug_info& info = thread->debug_info.arch_info;
+
+	// The first instruction must not hit the break- or watchpoint we may
+	// have stopped at.
+	info.flags |= ARM64_THREAD_DEBUG_RESUMING;
+	info.resume_address = frame->elr;
+
+	// A single step starts with the next instruction: PSTATE.SS = 1
+	// ("active-not-pending").
+	if ((thread->debug_info.flags & B_THREAD_DEBUG_SINGLE_STEP) != 0) {
+		info.flags |= ARM64_THREAD_DEBUG_STEP_USER;
+		frame->spsr |= DBG_SPSR_SS;
+	} else {
+		info.flags &= ~ARM64_THREAD_DEBUG_STEP_USER;
+		if ((info.flags & ARM64_THREAD_DEBUG_STEP_OVER) == 0)
+			frame->spsr &= ~DBG_SPSR_SS;
+	}
 }
 
 
 void
 arch_set_debug_cpu_state(const debug_cpu_state *cpuState)
 {
+	iframe* frame = arm64_get_user_iframe(thread_get_current_thread());
+	if (frame == NULL)
+		return;
+
+	// iframe stores x0-x28 in x[], with x29 (the frame pointer) separate
+	memcpy(frame->x, cpuState->x, sizeof(frame->x));
+	frame->fp = cpuState->x[29];
+	frame->lr = cpuState->lr;
+	frame->sp = cpuState->sp;
+	frame->elr = cpuState->elr;
+	// userland may only change the condition flags
+	frame->spsr = (frame->spsr & ~SPSR_NZCV) | (cpuState->spsr & SPSR_NZCV);
 }
 
 
