+// TODO: Make those real error codes (as on x86).
+#define B_NO_MORE_BREAKPOINTS				B_BUSY
+#define B_NO_MORE_WATCHPOINTS				B_BUSY
+#define B_BAD_WATCHPOINT_ALIGNMENT			B_BAD_VALUE
+#define B_WATCHPOINT_TYPE_NOT_SUPPORTED		B_NOT_SUPPORTED
+#define B_WATCHPOINT_LENGTH_NOT_SUPPORTED	B_NOT_SUPPORTED
+#define B_BREAKPOINT_NOT_FOUND				B_NAME_NOT_FOUND
+#define B_WATCHPOINT_NOT_FOUND				B_NAME_NOT_FOUND
+
+
+// "brk #0", little endian
+const uint8 kArm64SoftwareBreakpoint[4] = { 0x00, 0x00, 0x20, 0xd4 };
+
+// exception classes of the debug exceptions from EL0
+#define EXCP_BRKPT_EL0		0x30	// hardware breakpoint
+#define EXCP_WATCHPT_EL0	0x34	// watchpoint
+
+// DBGBCR<n>_EL1: enabled, EL0 only, the whole A64 instruction
+#define DBGBCR_E			(1u << 0)
+#define DBGBCR_PMC_EL0		(2u << 1)
+#define DBGBCR_BAS_A64		(0xfu << 5)
+#define DBGBCR_USER_BREAKPOINT	(DBGBCR_E | DBGBCR_PMC_EL0 | DBGBCR_BAS_A64)
+
+// DBGWCR<n>_EL1: enabled, EL0 only, loads and/or stores, byte select
+#define DBGWCR_E			(1u << 0)
+#define DBGWCR_PAC_EL0		(2u << 1)
+#define DBGWCR_LSC_LOAD		(1u << 3)
+#define DBGWCR_LSC_STORE	(2u << 3)
+#define DBGWCR_BAS_SHIFT	5
+
+#define SPSR_NZCV			0xf0000000ul
+
+static int32 sBreakpointCount = 0;
+static int32 sWatchpointCount = 0;
+
+
+// #pragma mark - debug registers
+
+
+#define SET_DEBUG_REGISTER(name, index, value)							\
+	switch (index) {													\
+		case 0: WRITE_SPECIALREG(name##0_el1, value); break;			\
+		case 1: WRITE_SPECIALREG(name##1_el1, value); break;			\
+		case 2: WRITE_SPECIALREG(name##2_el1, value); break;			\
+		case 3: WRITE_SPECIALREG(name##3_el1, value); break;			\
+		case 4: WRITE_SPECIALREG(name##4_el1, value); break;			\
+		case 5: WRITE_SPECIALREG(name##5_el1, value); break;			\
+	}
+
+
+static void
+set_breakpoint_registers(int32 index, uint64 address, uint32 control)
+{
+	if (control != 0)
+		SET_DEBUG_REGISTER(dbgbvr, index, address);
+	SET_DEBUG_REGISTER(dbgbcr, index, (uint64)control);
+}
+
+
+static void
+set_watchpoint_registers(int32 index, uint64 address, uint32 control)
+{
+	if (control != 0)
+		SET_DEBUG_REGISTER(dbgwvr, index, address);
+	SET_DEBUG_REGISTER(dbgwcr, index, (uint64)control);
+}
+
+
+/*!	Interrupts must be disabled. */
+static void
+install_breakpoints(const arch_team_debug_info& info)
+{
+	for (int32 i = 0; i < sBreakpointCount; i++) {
+		set_breakpoint_registers(i, (addr_t)info.breakpoints[i].address,
+			info.breakpoints[i].address != NULL
+				? info.breakpoints[i].control : 0);
+	}
+	for (int32 i = 0; i < sWatchpointCount; i++) {
+		set_watchpoint_registers(i,
+			(addr_t)info.watchpoints[i].address & ~(addr_t)7,
+			info.watchpoints[i].address != NULL
+				? info.watchpoints[i].control : 0);
+	}
+	asm volatile("isb");
+}
+
+
+/*!	Interrupts must be disabled. */
+static void
+disable_breakpoints()
+{
+	for (int32 i = 0; i < sBreakpointCount; i++)
+		set_breakpoint_registers(i, 0, 0);
+	for (int32 i = 0; i < sWatchpointCount; i++)
+		set_watchpoint_registers(i, 0, 0);
+	asm volatile("isb");
+}
+
+
+// #pragma mark - team break- and watchpoints
+
+
+static iframe*
+arm64_get_user_iframe(Thread* thread)
+{
+	iframe_stack* iframes = &thread->arch_info.iframes;
+
+	// walk outwards from the innermost frame, skipping any kernel frames
+	for (int32 i = iframes->index - 1; i >= 0; i--) {
+		iframe* frame = iframes->frames[i];
+		if ((frame->spsr & PSR_M_MASK) == PSR_M_EL0t)
+			return frame;
+	}
+
+	return NULL;
+}
+
+
+static status_t
+set_hardware_point(arm64_hardware_breakpoint* points, int32 count,
+	void* address, uint32 control, status_t noMoreError)
+{
+	Thread* thread = thread_get_current_thread();
+
+	InterruptsLocker interruptsLocker;
+	GRAB_TEAM_DEBUG_INFO_LOCK(thread->team->debug_info);
+
+	status_t error = B_OK;
+	int32 freeSlot = -1;
+	for (int32 i = 0; i < count; i++) {
+		if (points[i].address == address) {
+			freeSlot = -2;
+			break;
+		}
+		if (points[i].address == NULL && freeSlot < 0)
+			freeSlot = i;
+	}
+
+	if (freeSlot >= 0) {
+		points[freeSlot].address = address;
+		points[freeSlot].control = control;
+	} else if (freeSlot == -1)
+		error = noMoreError;
+
+	RELEASE_TEAM_DEBUG_INFO_LOCK(thread->team->debug_info);
+	return error;
+}
+
+
+static status_t
+clear_hardware_point(arm64_hardware_breakpoint* points, int32 count,
+	void* address, status_t notFoundError)
+{
+	Thread* thread = thread_get_current_thread();
+
+	InterruptsLocker interruptsLocker;
+	GRAB_TEAM_DEBUG_INFO_LOCK(thread->team->debug_info);
+
+	status_t error = notFoundError;
+	for (int32 i = 0; i < count; i++) {
+		if (points[i].address == address) {
+			points[i].address = NULL;
+			points[i].control = 0;
+			error = B_OK;
+			break;
+		}
+	}
+
+	RELEASE_TEAM_DEBUG_INFO_LOCK(thread->team->debug_info);
+	return error;
+}
+
