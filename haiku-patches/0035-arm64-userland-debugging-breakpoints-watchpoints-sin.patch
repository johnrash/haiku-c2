 {
-	return B_ERROR;
+	Thread* thread = thread_get_current_thread();
+	return clear_hardware_point(thread->team->debug_info.arch_info.watchpoints,
+		sWatchpointCount, address, B_WATCHPOINT_NOT_FOUND);
 }
 
 
 bool
 arch_has_breakpoints(struct arch_team_debug_info *info)
 {
+	for (int32 i = 0; i < ARM64_BREAKPOINT_COUNT; i++) {
+		if (info->breakpoints[i].address != NULL)
+			return true;
+	}
+	for (int32 i = 0; i < ARM64_WATCHPOINT_COUNT; i++) {
+		if (info->watchpoints[i].address != NULL)
+			return true;
+	}
+	return false;
+}
+
+
+// #pragma mark - arm64 interface
+
+
+void
+arm64_init_user_debug()
+{
+	uint64 dfr0 = READ_SPECIALREG(ID_AA64DFR0_EL1);
+	sBreakpointCount = min_c(ID_AA64DFR0_BRPS(dfr0), ARM64_BREAKPOINT_COUNT);
+	sWatchpointCount = min_c(ID_AA64DFR0_WRPS(dfr0), ARM64_WATCHPOINT_COUNT);
+	dprintf("arm64: %" B_PRId32 " hardware breakpoints, %" B_PRId32
+		" watchpoints for userland debugging\n", sBreakpointCount,
+		sWatchpointCount);
+}
+
+
+/*!	Called on every CPU at boot: makes debug exceptions possible and clears
+	the break- and watchpoint registers, whose reset values are unknown.
+*/
+void
+arm64_init_user_debug_percpu()
+{
+	uint64 dfr0 = READ_SPECIALREG(ID_AA64DFR0_EL1);
+	int32 breakpoints = ID_AA64DFR0_BRPS(dfr0);
+	int32 watchpoints = ID_AA64DFR0_WRPS(dfr0);
+	for (int32 i = 0; i < min_c(breakpoints, ARM64_BREAKPOINT_COUNT); i++)
+		set_breakpoint_registers(i, 0, 0);
+	for (int32 i = 0; i < min_c(watchpoints, ARM64_WATCHPOINT_COUNT); i++)
+		set_watchpoint_registers(i, 0, 0);
+
+	// the OS lock is set at reset and blocks all debug exceptions
+	WRITE_SPECIALREG(OSLAR_EL1, 0);
+	WRITE_SPECIALREG(OSDLR_EL1, 0);
+	// break- and watchpoints on, no single step, nothing in the kernel
+	WRITE_SPECIALREG(MDSCR_EL1, DBG_MDSCR_MDE);
+	asm volatile("isb");
+}
+
+
+/*!	Called with interrupts disabled when the current thread enters the kernel
+	from userland.
+*/
+void
+arm64_user_debug_at_kernel_entry()
+{
+	Thread* thread = thread_get_current_thread();
+	arch_thread_debug_info& info = thread->debug_info.arch_info;
+
+	if ((info.flags & ARM64_THREAD_DEBUG_SS_ENABLED) != 0) {
+		// Single stepping is on for this thread only.
+		WRITE_SPECIALREG(MDSCR_EL1,
+			READ_SPECIALREG(MDSCR_EL1) & ~(uint64)DBG_MDSCR_SS);
+		info.flags &= ~ARM64_THREAD_DEBUG_SS_ENABLED;
+	}
+
+	if ((thread->flags & THREAD_FLAGS_BREAKPOINTS_INSTALLED) != 0) {
+		disable_breakpoints();
+		atomic_and(&thread->flags, ~THREAD_FLAGS_BREAKPOINTS_INSTALLED);
+	}
+}
+
+
+/*!	Called with interrupts disabled when the current thread is about to return
+	to userland at \a frame.
+*/
+void
+arm64_user_debug_at_kernel_exit(iframe* frame)
+{
+	Thread* thread = thread_get_current_thread();
+	arch_thread_debug_info& info = thread->debug_info.arch_info;
+
+	if ((info.flags & ARM64_THREAD_DEBUG_RESUMING) != 0) {
+		info.flags &= ~ARM64_THREAD_DEBUG_RESUMING;
+		// AArch64 has no resume flag: step over the instruction we stopped
+		// at with the break- and watchpoints off.
+		if (frame->elr == info.resume_address
+			&& (thread->flags & THREAD_FLAGS_BREAKPOINTS_DEFINED) != 0
+			&& (info.flags & ARM64_THREAD_DEBUG_STEP_OVER) == 0) {
+			info.flags |= ARM64_THREAD_DEBUG_STEP_OVER;
+			frame->spsr |= DBG_SPSR_SS;
+		}
+	}
+
+	if ((thread->flags & THREAD_FLAGS_BREAKPOINTS_DEFINED) != 0
+		&& (info.flags & ARM64_THREAD_DEBUG_STEP_OVER) == 0) {
+		GRAB_TEAM_DEBUG_INFO_LOCK(thread->team->debug_info);
+		install_breakpoints(thread->team->debug_info.arch_info);
+		RELEASE_TEAM_DEBUG_INFO_LOCK(thread->team->debug_info);
+		atomic_or(&thread->flags, THREAD_FLAGS_BREAKPOINTS_INSTALLED);
+	}
+
+	if ((info.flags
+			& (ARM64_THREAD_DEBUG_STEP_OVER | ARM64_THREAD_DEBUG_STEP_USER))
+			!= 0) {
+		// SPSR.SS is what the step state machine left (0 after an SVC: the
+		// step is complete, the exception comes before the next instruction)
+		// or what arch_update_thread_single_step() set.
+		WRITE_SPECIALREG(MDSCR_EL1,
+			READ_SPECIALREG(MDSCR_EL1) | DBG_MDSCR_SS);
+		info.flags |= ARM64_THREAD_DEBUG_SS_ENABLED;
+	}
+}
+
+
+/*!	Handles the debug exceptions from userland: hardware break- and
+	watchpoints, software steps, and "brk #0". Returns \c false for an
+	exception that is not one of these (other "brk"s).
+	Interrupts are disabled and may be enabled.
+*/
+bool
+arm64_handle_debug_exception(iframe* frame, uint32 exceptionClass)
+{
+	Thread* thread = thread_get_current_thread();
+	arch_thread_debug_info& info = thread->debug_info.arch_info;
+
+	switch (exceptionClass) {
+		case EXCP_BRKPT_EL0:
+			TRACE(("arm64: breakpoint at %#" B_PRIx64 "\n", frame->elr));
+			enable_interrupts();
+			user_debug_breakpoint_hit(false);
+			return true;
+
+		case EXCP_WATCHPT_EL0:
+			TRACE(("arm64: watchpoint at %#" B_PRIx64 " for %#" B_PRIx64 "\n",
+				frame->elr, frame->far));
+			enable_interrupts();
+			user_debug_watchpoint_hit();
+			return true;
+
+		case EXCP_SOFTSTP_EL0:
+		{
+			TRACE(("arm64: single step at %#" B_PRIx64 "\n", frame->elr));
+			info.flags &= ~ARM64_THREAD_DEBUG_STEP_OVER;
+			frame->spsr &= ~DBG_SPSR_SS;
+			if ((info.flags & ARM64_THREAD_DEBUG_STEP_USER) == 0) {
+				// only the step over a break- or watchpoint: continue
+				return true;
+			}
+			info.flags &= ~ARM64_THREAD_DEBUG_STEP_USER;
+			enable_interrupts();
+			user_debug_single_stepped();
+			return true;
+		}
+
+		case EXCP_BRK:
+			// the immediate is in the ISS
+			if ((frame->esr & 0xffff) != 0)
+				return false;
+			TRACE(("arm64: brk #0 at %#" B_PRIx64 "\n", frame->elr));
+			enable_interrupts();
+			user_debug_breakpoint_hit(true);
+			return true;
+	}
+
 	return false;
 }
