+/*!	Reads the card's first 128 blocks three times; true if no read had an
+	error (the controller checks each data line's CRC).
+*/
+bool
+MesonMmc::_TestRead()
+{
+	static const uint32 kTestBlocks = 128;
+	if (fBounceArea < 0)
+		return false;
+	for (int round = 0; round < 3; round++) {
+		uint32 response;
+		status_t status = _Execute(SD_READ_MULTIPLE_BLOCKS, 0, &response,
+			fBouncePhysical, kTestBlocks, false, true);
+		status_t stopStatus = _Execute(SD_STOP_TRANSMISSION, 0, &response,
+			0, 0, false, true);
+		if (status != B_OK || stopStatus != B_OK)
+			return false;
+	}
+	return true;
+}
