+/*!	SD high speed: CMD6 (SWITCH_FUNC) mode 1 selects function 1 of group 1
+	(access mode), which allows a 50 MHz clock at 3.3 V. The card answers
+	with its 64-byte switch status, whose bits 379-376 (in byte 16) give the
+	function now selected. A few CRC-checked test reads at 50 MHz follow;
+	on an error, 25 MHz again (a card in high speed mode works there too).
+*/
+static bool
+switch_sd_high_speed(mmc_disk_driver_info* info)
+{
+	static const uint8 kSdSwitchFunction = 6;
+	static const uint32 kSwitchToHighSpeed = 0x80fffff1;
+	if (info->mmc->execute_read_command == NULL
+		|| info->mmc->set_clock == NULL) {
+		return false;
+	}
+
+	uint8 switchStatus[64];
+	status_t status = info->mmc->execute_read_command(info->parent,
+		info->parentCookie, info->rca, kSdSwitchFunction, kSwitchToHighSpeed,
+		switchStatus, sizeof(switchStatus));
+	if (status != B_OK || (switchStatus[16] & 0xf) != 1) {
+		INFO("SD: no high speed (%s, function %u)\n", strerror(status),
+			status == B_OK ? switchStatus[16] & 0xf : 0);
+		return false;
+	}
+
+	info->mmc->set_clock(info->parent, info->parentCookie, 50000);
+	uint8* block = (uint8*)malloc(kBlockSize);
+	if (block == NULL) {
+		info->mmc->set_clock(info->parent, info->parentCookie, 25000);
+		return false;
+	}
+	for (int i = 0; i < 3 && status == B_OK; i++) {
+		status = info->mmc->execute_read_command(info->parent,
+			info->parentCookie, info->rca, SD_READ_SINGLE_BLOCK, 0, block,
+			kBlockSize);
+	}
+	free(block);
+	if (status != B_OK) {
+		ERROR("SD: test reads at 50 MHz failed (%s), back to 25 MHz\n",
+			strerror(status));
+		info->mmc->set_clock(info->parent, info->parentCookie, 25000);
+		return false;
+	}
+	return true;
+}
+
+
+/*!	eMMC DDR52: after the switch to high speed, BUS_WIDTH (EXT_CSD[183])
+	5 or 6 (4 or 8 bits, both edges), then the host controller. The I/O
+	voltage has to be what the card's DDR52 bit is for; the ODROID-C2's
+	eMMC runs at 1.8 V, which EXT_CSD's DEVICE_TYPE bit 2 covers. Goes back
+	to single data rate if anything fails.
+*/
+static bool
+switch_to_ddr(mmc_disk_driver_info* info, int busWidth)
+{
+	static const uint8 kMmcDeviceTypeDdr52 = 1 << 2;
+	static const uint8 kMmcSendStatus = 13;
+	static const uint32 kMmcSwitchError = 1 << 7;
+	if ((info->mmcDeviceType & kMmcDeviceTypeDdr52) == 0
+		|| info->mmc->set_ddr == NULL || (busWidth != 4 && busWidth != 8)) {
+		return false;
+	}
+
+	uint32 cardStatus = 0;
+	const uint32 kSwitchDdrBusWidth = 0x3B70000
+		| ((busWidth == 8 ? 6 : 5) << 8);
+	status_t status = info->mmc->execute_command(info->parent,
+		info->parentCookie, info->rca, MMC_SWITCH, kSwitchDdrBusWidth,
+		&cardStatus);
+	if (status == B_OK) {
+		status = info->mmc->execute_command(info->parent, info->parentCookie,
+			info->rca, kMmcSendStatus, (uint32)info->rca << 16, &cardStatus);
+	}
+	if (status != B_OK || (cardStatus & kMmcSwitchError) != 0) {
+		ERROR("eMMC: DDR bus width switch failed (%s, status %#" B_PRIx32
+			")\n", strerror(status), cardStatus);
+		return false;
+	}
+
+	status = info->mmc->set_ddr(info->parent, info->parentCookie, true);
+	if (status == B_OK)
+		return true;
+
+	// the controller cannot or should not: single data rate again
+	const uint32 kSwitchSdrBusWidth = 0x3B70000
+		| ((busWidth == 8 ? 2 : 1) << 8);
+	info->mmc->execute_command(info->parent, info->parentCookie, info->rca,
+		MMC_SWITCH, kSwitchSdrBusWidth, &cardStatus);
+	return false;
+}
