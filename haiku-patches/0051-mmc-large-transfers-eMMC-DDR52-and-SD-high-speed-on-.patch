+/*!	In DDR mode the controller clock runs at twice the bus clock, and the
+	data lines need resampling at the right step of the source clock (the
+	ADJUST register, as for HS200 tuning): each step is tried with test
+	reads of the card's first blocks, whose CRCs the controller checks, and
+	the middle of the longest passing window is kept. Without one, single
+	data rate again and B_ERROR (the caller switches the card back).
+*/
+status_t
+MesonMmc::SetDDR(bool ddr)
+{
+	if (ddr && !emmc_ddr_allowed())
+		return B_NOT_SUPPORTED;
+	MutexLocker locker(fLock);
+	fDDR = ddr;
+	_Write(kAdjust, 0);
+	if (fClockKilohertz == 0)
+		return ddr ? B_NO_INIT : B_OK;
+	status_t status = _ApplyClock();
+	if (status != B_OK || !ddr)
+		return status;
+
+	uint32 steps = std::min(fDivider, (uint32)32);
+	bool passed[32];
+	uint32 passCount = 0;
+	for (uint32 step = 0; step < steps; step++) {
+		_Write(kAdjust, ADJUST_ENABLE | (step << ADJUST_DELAY_SHIFT));
+		passed[step] = _TestRead();
+		if (passed[step])
+			passCount++;
+	}
+
+	// the longest run of passing steps, which may wrap around
+	uint32 bestStart = 0;
+	uint32 bestLength = 0;
+	for (uint32 start = 0; start < steps; start++) {
+		uint32 length = 0;
+		while (length < steps && passed[(start + length) % steps])
+			length++;
+		if (length > bestLength) {
+			bestStart = start;
+			bestLength = length;
+		}
+	}
+	if (bestLength == 0) {
+		ERROR("%#" B_PRIxPHYSADDR ": DDR: no resampling step reads without "
+			"errors\n", fPhysicalBase);
+		_Write(kAdjust, 0);
+		fDDR = false;
+		_ApplyClock();
+		return B_ERROR;
+	}
+	uint32 chosen = (bestStart + bestLength / 2) % steps;
+	_Write(kAdjust, ADJUST_ENABLE | (chosen << ADJUST_DELAY_SHIFT));
+	INFO("%#" B_PRIxPHYSADDR ": DDR: %" B_PRIu32 " of %" B_PRIu32
+		" resampling steps read without errors, window %" B_PRIu32 "-%"
+		B_PRIu32 ", using %" B_PRIu32 "\n", fPhysicalBase, passCount, steps,
+		bestStart, (bestStart + bestLength - 1) % steps, chosen);
+	return B_OK;
+}
+
