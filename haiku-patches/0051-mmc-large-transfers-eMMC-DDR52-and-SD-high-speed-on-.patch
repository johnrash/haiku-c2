+/*!	Copies \a length bytes between the I/O vectors, starting at \a vecs
+	and \a vecOffset, and the bounce buffer: into it with \a toBounce,
+	else out of it. The vectors are physical; all RAM is mapped at
+	KERNEL_PMAP_BASE. Advances \a vecs and \a vecOffset past them.
+*/
+void
+MesonMmc::_CopyVecs(const generic_io_vec*& vecs,
+	const generic_io_vec* vecsEnd, generic_size_t& vecOffset,
+	generic_size_t length, bool toBounce)
+{
+	uint8* bounce = (uint8*)fBounceBuffer;
+	while (length > 0 && vecs < vecsEnd) {
+		generic_size_t piece = std::min(length, vecs->length - vecOffset);
+		uint8* memory = (uint8*)(KERNEL_PMAP_BASE + vecs->base + vecOffset);
+		if (toBounce)
+			memcpy(bounce, memory, piece);
+		else
+			memcpy(memory, bounce, piece);
+		bounce += piece;
+		length -= piece;
+		vecOffset += piece;
+		if (vecOffset == vecs->length) {
+			vecs++;
+			vecOffset = 0;
+		}
+	}
+}
+
+
+void
+MesonMmc::_SkipVecs(const generic_io_vec*& vecs,
+	const generic_io_vec* vecsEnd, generic_size_t& vecOffset,
+	generic_size_t length)
+{
+	while (length > 0 && vecs < vecsEnd) {
+		generic_size_t piece = std::min(length, vecs->length - vecOffset);
+		length -= piece;
+		vecOffset += piece;
+		if (vecOffset == vecs->length) {
+			vecs++;
+			vecOffset = 0;
+		}
+	}
+}
