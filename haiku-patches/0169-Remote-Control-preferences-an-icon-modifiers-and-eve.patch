+/*!	The modifiers ticked, as a key on the keyboard's left side gives them. */
+uint32
+RemoteWindow::_CheckedModifiers() const
+{
+	uint32 modifiers = 0;
+	if (fAltBox->Value() == B_CONTROL_ON)
+		modifiers |= B_COMMAND_KEY | B_LEFT_COMMAND_KEY;
+	if (fCtrlBox->Value() == B_CONTROL_ON)
+		modifiers |= B_CONTROL_KEY | B_LEFT_CONTROL_KEY;
+	if (fShiftBox->Value() == B_CONTROL_ON)
+		modifiers |= B_SHIFT_KEY | B_LEFT_SHIFT_KEY;
+	if (fWinBox->Value() == B_CONTROL_ON)
+		modifiers |= B_OPTION_KEY | B_LEFT_OPTION_KEY;
+	return modifiers;
+}
