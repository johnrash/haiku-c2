 }
+
+
+static int
+CompareCharacterKeys(const CharacterKey* a, const CharacterKey* b)
+{
+	// letters, then digits, then the rest; by character within each
+	int classA = isalpha((uint8)a->name[0]) ? 0 : isdigit((uint8)a->name[0])
+		? 1 : 2;
+	int classB = isalpha((uint8)b->name[0]) ? 0 : isdigit((uint8)b->name[0])
+		? 1 : 2;
+	if (classA != classB)
+		return classA - classB;
+	return strcmp(a->name.String(), b->name.String());
+}
+
+
+void
+GetCharacterKeys(BObjectList<CharacterKey, true>& keys)
+{
+	BKeymap keymap;
+	if (keymap.SetToCurrent() != B_OK)
+		return;
+	for (uint32 key = 1; key < 128; key++) {
+		char* chars = NULL;
+		int32 count = 0;
+		keymap.GetChars(key, 0, 0, &chars, &count);
+		ArrayDeleter<char> charsDeleter(chars);
+		// printable, and not a key with a name of its own (Space)
+		if (count != 1 || !isgraph((uint8)chars[0]))
+			continue;
+		CharacterKey* character = new(std::nothrow) CharacterKey;
+		if (character == NULL)
+			return;
+		character->key = key;
+		character->name.SetTo((char)toupper((uint8)chars[0]), 1);
+		// the keypad repeats the digits and some punctuation: one of each
+		bool known = false;
+		for (int32 i = 0; i < keys.CountItems() && !known; i++)
+			known = keys.ItemAt(i)->name == character->name;
+		if (known || !keys.AddItem(character))
+			delete character;
+	}
+	keys.SortItems(&CompareCharacterKeys);
+}
