+/*!	Whether the picture whose first slice header is in fRpm has another
+	size (or CTB size, or bit depth) than the frames: a new sequence.
+*/
+bool
+MesonVdec::_HevcPicturesChange()
+{
+	uint32 log2Ctb = _Rpm(RPM_LOG2_MIN_CB) + 3 + _Rpm(RPM_LOG2_DIFF_CB);
+	return _Rpm(RPM_WIDTH) != fHevcCodedWidth
+		|| _Rpm(RPM_HEIGHT) != fHevcCodedHeight || log2Ctb != fHevcLog2Ctb
+		|| (_Rpm(RPM_BIT_DEPTH) != 0) != fHevcCompressed;
+}
+
+
+/*!	Before frames for a new sequence's pictures (_SetupHevcFrames()): the
+	pictures so far are handed out, and every frame comes back from the
+	reader (GET_FRAME asks it to, MESON_VDEC_FRAME_GIVE_BACK). Returns false
+	while it has some; the session's thread asks again.
+*/
+bool
+MesonVdec::_HevcFramesBack()
+{
+	if (!fWaitingForFrames) {
+		_FinishHevcPicture();
+		InterruptsSpinLocker locker(fStateLock);
+		_BumpHevcFrames(0);
+		for (uint32 i = 0; i < fFrameCount; i++)
+			fHevcFrames[i].referenced = false;
+		fWaitingForFrames = true;
+		fHevcResizeStart = system_time();
+	}
+	InterruptsSpinLocker locker(fStateLock);
+	if (fHeld != 0 || fQueueCount != 0) {
+		if (system_time() - fHevcResizeStart < 5000000)
+			return false;
+		INFO("HEVC: the frames didn't come back for the new pictures\n");
+	}
+	fWaitingForFrames = false;
+	fFrameCount = 0;
+	return true;
+}
