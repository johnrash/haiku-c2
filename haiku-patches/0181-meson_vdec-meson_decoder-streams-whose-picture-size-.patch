+/*!	Waits until the reader gave back every frame it took and took every
+	frame decoded. A setup for new pictures (a new size: the stream changed)
+	does so first: the firmware takes all frames as free once it has them,
+	and a frame's size is the session's when the reader takes it. Meanwhile
+	GET_FRAME tells a reader that holds frames to give them back
+	(MESON_VDEC_FRAME_GIVE_BACK).
+*/
+status_t
+MesonVdec::_WaitForFramesBack()
+{
+	bigtime_t timeout = system_time() + 5000000;
+	InterruptsSpinLocker locker(fStateLock);
+	fWaitingForFrames = true;
+	while (fHeld != 0 || fQueueCount != 0) {
+		locker.Unlock();
+		if (system_time() > timeout || !fRunning) {
+			locker.Lock();
+			fWaitingForFrames = false;
+			return B_TIMED_OUT;
+		}
+		snooze(2000);
+		locker.Lock();
+	}
+	fWaitingForFrames = false;
+	return B_OK;
+}
