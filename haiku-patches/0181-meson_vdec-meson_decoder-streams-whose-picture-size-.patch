+/*!	A picture of another size than the negotiated one (the stream changed
+	its size): scaled to fit, its aspect kept, with black around it.
+*/
+status_t
+MesonVdecDecoder::_ConvertFitted(void* buffer, const uint8* luma,
+	const uint8* chroma)
+{
+	uint32 fitWidth = fWidth;
+	uint32 fitHeight = fHeight;
+	if ((uint64)fFrame.width * fHeight > (uint64)fFrame.height * fWidth)
+		fitHeight = (uint64)fFrame.height * fWidth / fFrame.width;
+	else
+		fitWidth = (uint64)fFrame.width * fHeight / fFrame.height;
+	fitWidth = max_c(fitWidth & ~1u, 2u);
+	fitHeight = max_c(fitHeight & ~1u, 2u);
+	uint32 left = ((fWidth - fitWidth) / 2) & ~1u;
+	uint32 top = ((fHeight - fitHeight) / 2) & ~1u;
+
+	uint8* target = (uint8*)buffer;
+	size_t bytesPerRow = fOutputBytesPerRow;
+	uint8* targetPlanes[4] = { NULL, NULL, NULL, NULL };
+	int targetStrides[4] = { (int)bytesPerRow, 0, 0, 0 };
+	AVPixelFormat format;
+	if (fOutputColorSpace == B_NV12) {
+		uint8* chromaTarget = target + bytesPerRow * fHeight;
+		memset(target, 16, bytesPerRow * fHeight);
+		memset(chromaTarget, 128, bytesPerRow * ((fHeight + 1) / 2));
+		targetPlanes[0] = target + top * bytesPerRow + left;
+		targetPlanes[1] = chromaTarget + top / 2 * bytesPerRow + left;
+		targetStrides[1] = (int)bytesPerRow;
+		format = AV_PIX_FMT_NV12;
+	} else if (fOutputColorSpace == B_YCbCr422) {
+		static const uint8 kBlack[4] = { 16, 128, 16, 128 };
+		for (uint32 y = 0; y < fHeight; y++) {
+			uint8* row = target + y * bytesPerRow;
+			for (uint32 x = 0; x + 4 <= 2 * fWidth; x += 4)
+				memcpy(row + x, kBlack, 4);
+		}
+		targetPlanes[0] = target + top * bytesPerRow + 2 * left;
+		format = AV_PIX_FMT_YUYV422;
+	} else {
+		memset(target, 0, bytesPerRow * fHeight);
+		targetPlanes[0] = target + top * bytesPerRow + 4 * left;
+		format = AV_PIX_FMT_BGRA;
+	}
+
+	fSwsContext = sws_getCachedContext(fSwsContext, fFrame.width,
+		fFrame.height, AV_PIX_FMT_NV12, fitWidth, fitHeight, format,
+		SWS_FAST_BILINEAR, NULL, NULL, NULL);
+	if (fSwsContext == NULL)
+		return B_NO_MEMORY;
+	const uint8* sourcePlanes[4] = { luma, chroma, NULL, NULL };
+	int sourceStrides[4] = { (int)fFrame.bytes_per_row,
+		(int)fFrame.bytes_per_row, 0, 0 };
+	sws_scale(fSwsContext, sourcePlanes, sourceStrides, 0, fFrame.height,
+		targetPlanes, targetStrides);
+	return B_OK;
+}
