From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Sun, 1 Nov 2026 14:56:19 -0500
Subject: [PATCH 229/342] ffmpeg plugin: an audio track whose codec takes other
 samples is made

The writer refused a sound track whose codec doesn't take the samples
given and whose own format has no media_raw_audio_format (AAC's planar
floats): the encoder was dropped without a word, the stream already in
the file stayed empty, and every frame written failed with B_NO_INIT. As
the encoder converts the samples now, the writer only notes the codec's
format, and leaves the caller's as it is.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../media/plugins/ffmpeg/AVFormatWriter.cpp   | 47 ++++---------------
 1 file changed, 10 insertions(+), 37 deletions(-)

diff --git a/src/add-ons/media/plugins/ffmpeg/AVFormatWriter.cpp b/src/add-ons/media/plugins/ffmpeg/AVFormatWriter.cpp
index ead41f0552..6e98177572 100644
--- a/src/add-ons/media/plugins/ffmpeg/AVFormatWriter.cpp
+++ b/src/add-ons/media/plugins/ffmpeg/AVFormatWriter.cpp
@@ -220,50 +220,23 @@ AVFormatWriter::StreamCookie::Init(media_format* format,
 				break;
 		}
 
-		// Now negociate the actual format with the encoder
-		// First check if the requested format is acceptable
+		// The codec's own sample format, when it doesn't take these: the
+		// encoder converts the samples (the format stays the caller's, as
+		// some codecs' only one, AAC's planar floats, has no
+		// media_raw_audio_format)
 		const AVCodec* codec = avcodec_find_encoder(fStream->codecpar->codec_id);
 
 		if (codec == NULL)
 			return B_MEDIA_BAD_FORMAT;
 
-		const enum AVSampleFormat *p = codec->sample_fmts;
-		for (; *p != -1; p++) {
-			if (*p == fStream->codecpar->format)
-				break;
-		}
-		// If not, force one of the acceptable ones
-		if (*p == -1) {
-			fStream->codecpar->format = codec->sample_fmts[0];
-
-			// And finally set the format struct to the accepted format. It is
-			// then up to the caller to make sure we get data matching that
-			// format.
-			switch (fStream->codecpar->format) {
-				case AV_SAMPLE_FMT_FLT:
-					format->u.raw_audio.format
-						= media_raw_audio_format::B_AUDIO_FLOAT;
-					break;
-				case AV_SAMPLE_FMT_DBL:
-					format->u.raw_audio.format
-						= media_raw_audio_format::B_AUDIO_DOUBLE;
-					break;
-				case AV_SAMPLE_FMT_S32:
-					format->u.raw_audio.format
-						= media_raw_audio_format::B_AUDIO_INT;
-					break;
-				case AV_SAMPLE_FMT_S16:
-					format->u.raw_audio.format
-						= media_raw_audio_format::B_AUDIO_SHORT;
-					break;
-				case AV_SAMPLE_FMT_U8:
-					format->u.raw_audio.format
-						= media_raw_audio_format::B_AUDIO_UCHAR;
-					break;
-				default:
-					return B_MEDIA_BAD_FORMAT;
+		const enum AVSampleFormat* p = codec->sample_fmts;
+		if (p != NULL) {
+			for (; *p != AV_SAMPLE_FMT_NONE; p++) {
+				if (*p == fStream->codecpar->format)
 					break;
 			}
+			if (*p == AV_SAMPLE_FMT_NONE)
+				fStream->codecpar->format = codec->sample_fmts[0];
 		}
 
 #if LIBAVCODEC_VERSION_MAJOR >= 60
