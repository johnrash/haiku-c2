+
+/*static*/ bool
+LcdShield::Configured()
+{
+	void* settings = load_driver_settings("meson_gpio");
+	if (settings == NULL)
+		return false;
+	bool configured = get_driver_boolean_parameter(settings, "lcd_io_shield",
+		false, true);
+	unload_driver_settings(settings);
+	return configured;
+}
+
+
+LcdShield::LcdShield(MesonGpio* gpio)
+	:
+	fGpio(gpio),
+	fLcdStarted(false),
+	fRow(0),
+	fColumn(0),
+	fAddress(-1),
+	fPendingNewline(false),
+	fCursor(LCD_SHIELD_CURSOR_OFF),
+	fDisplayOn(true),
+	fUtf8Value(0),
+	fUtf8Remaining(0),
+	fLedsStarted(false),
+	fLeds(0),
+	fButtonsClaimed(false),
+	fButtonUsers(0),
+	fButtonThread(-1),
+	fButtonQuit(false),
+	fButtonsDown(0),
+	fButtonsLast(0),
+	fEventCount(0)
+{
+	mutex_init(&fLock, "lcd shield");
+	fButtonCondition.Init(this, "lcd shield buttons");
+	fLcdPins.gpio = fLedPins.gpio = fButtonPins.gpio = gpio;
+	fLcdPins.count = fLedPins.count = fButtonPins.count = 0;
+	memset(fText, ' ', sizeof(fText));
+}
+
+
+LcdShield::~LcdShield()
+{
+	_ButtonsStop();
+	// the pins become inputs again; the LCD keeps its text
+	fGpio->Free(&fLcdPins);
+	fGpio->Free(&fLedPins);
+	fGpio->Free(&fButtonPins);
+	mutex_destroy(&fLock);
+}
+
+
+status_t
+LcdShield::Open(lcd_shield_cookie* cookie)
+{
+	MutexLocker locker(fLock);
+	switch (cookie->part) {
+		case LCD_SHIELD_PART_LCD:
+			return _LcdStart();
+		case LCD_SHIELD_PART_LEDS:
+			return _LedsStart();
+		case LCD_SHIELD_PART_BUTTONS:
+		{
+			status_t status = _ButtonsStart();
+			if (status != B_OK)
+				return status;
+			fButtonUsers++;
+			cookie->nextEvent = fEventCount;
+			return B_OK;
+		}
+	}
+	return B_BAD_VALUE;
+}
+
+
+void
+LcdShield::Close(lcd_shield_cookie* cookie)
+{
+	if (cookie->part != LCD_SHIELD_PART_BUTTONS)
+		return;
+	// a read waiting for this file returns
+	MutexLocker locker(fLock);
+	cookie->closed = true;
+	fButtonCondition.NotifyAll();
+}
+
+
+void
+LcdShield::Free(lcd_shield_cookie* cookie)
+{
+	if (cookie->part != LCD_SHIELD_PART_BUTTONS)
+		return;
+	bool last;
+	{
+		MutexLocker locker(fLock);
+		last = --fButtonUsers == 0;
+	}
+	if (last)
+		_ButtonsStop();
+}
+
+
+status_t
+LcdShield::Read(lcd_shield_cookie* cookie, off_t position, void* buffer,
+	size_t* _length)
+{
+	switch (cookie->part) {
+		case LCD_SHIELD_PART_LCD:
+		{
+			MutexLocker locker(fLock);
+			return _LcdRead(position, buffer, _length);
+		}
+		case LCD_SHIELD_PART_LEDS:
+		{
+			MutexLocker locker(fLock);
+			return _LedsRead(position, buffer, _length);
+		}
+		case LCD_SHIELD_PART_BUTTONS:
+			return _ButtonsRead(cookie, buffer, _length);
+	}
+	return B_BAD_VALUE;
+}
+
+
+status_t
+LcdShield::Write(lcd_shield_cookie* cookie, const void* buffer,
+	size_t* _length)
+{
+	char chunk[128];
+	size_t done = 0;
+	while (done < *_length) {
+		size_t length = min_c(*_length - done, sizeof(chunk));
+		if (user_memcpy(chunk, (const char*)buffer + done, length) != B_OK)
+			return B_BAD_ADDRESS;
+		MutexLocker locker(fLock);
+		status_t status;
+		switch (cookie->part) {
+			case LCD_SHIELD_PART_LCD:
+				status = _LcdWrite(chunk, length);
+				break;
+			case LCD_SHIELD_PART_LEDS:
+				status = _LedsWrite(chunk, length);
+				break;
+			default:
+				status = B_NOT_ALLOWED;
+				break;
+		}
+		if (status != B_OK)
+			return status;
+		done += length;
+	}
+	return B_OK;
+}
+
+
+status_t
+LcdShield::Control(lcd_shield_cookie* cookie, uint32 op, void* buffer,
+	size_t length)
+{
+	switch (cookie->part) {
+		case LCD_SHIELD_PART_LCD:
+		{
+			MutexLocker locker(fLock);
+			return _LcdControl(op, buffer, length);
+		}
+
+		case LCD_SHIELD_PART_LEDS:
+		{
+			MutexLocker locker(fLock);
+			if (op == LCD_SHIELD_SET_LEDS) {
+				uint32 leds;
+				if (user_memcpy(&leds, buffer, sizeof(leds)) != B_OK)
+					return B_BAD_ADDRESS;
+				fLeds = leds & ((1u << LCD_SHIELD_LEDS) - 1);
+				fGpio->WriteLevels(&fLedPins, fLeds);
+				return B_OK;
+			}
+			if (op == LCD_SHIELD_GET_LEDS)
+				return user_memcpy(buffer, &fLeds, sizeof(fLeds));
+			return B_DEV_INVALID_IOCTL;
+		}
+
+		case LCD_SHIELD_PART_BUTTONS:
+		{
+			if (op == LCD_SHIELD_GET_BUTTONS) {
+				MutexLocker locker(fLock);
+				return user_memcpy(buffer, &fButtonsDown,
+					sizeof(fButtonsDown));
+			}
+			if (op == LCD_SHIELD_WAIT_BUTTON) {
+				lcd_shield_button_event event;
+				if (user_memcpy(&event, buffer, sizeof(event)) != B_OK)
+					return B_BAD_ADDRESS;
+				status_t status = _WaitButton(cookie, event.timeout, event);
+				if (status != B_OK)
+					return status;
+				return user_memcpy(buffer, &event, sizeof(event));
+			}
+			return B_DEV_INVALID_IOCTL;
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+//	#pragma mark - LCD
+
+
+status_t
+LcdShield::_LcdStart()
+{
+	if (fLcdStarted)
+		return B_OK;
+	status_t status = fGpio->ClaimPins(&fLcdPins, kLcdPins,
+		B_COUNT_OF(kLcdPins), "LCD shield");
+	if (status != B_OK)
+		return status;
+	fGpio->WriteLevels(&fLcdPins, 0);
+	fGpio->SetOutputs(&fLcdPins, (1u << B_COUNT_OF(kLcdPins)) - 1);
+	snooze(50000);
+
+	// initialization by instruction: three times 8-bit mode, whatever mode
+	// the display was in, then 4-bit
+	_Nibble(0x3, false);
+	snooze(4500);
+	_Nibble(0x3, false);
+	snooze(150);
+	_Nibble(0x3, false);
+	snooze(150);
+	_Nibble(0x2, false);
+	snooze(150);
+	_Send(LCD_FUNCTION_SET | LCD_TWO_LINES, false);
+	_Send(LCD_DISPLAY_CONTROL, false);
+	_Clear();
+	_Send(LCD_ENTRY_MODE | LCD_ENTRY_INCREMENT, false);
+	fDisplayOn = true;
+	fCursor = LCD_SHIELD_CURSOR_OFF;
+	_DisplayControl();
+	fLcdStarted = true;
+	INFO("LCD started\n");
+	return B_OK;
+}
+
+
+void
+LcdShield::_Nibble(uint8 value, bool data)
+{
+	uint32 levels = (data ? kRS : 0) | ((uint32)(value & 0xf) << kDataShift);
+	fGpio->WriteLevels(&fLcdPins, levels);
+	fGpio->WriteLevels(&fLcdPins, levels | kE);
+	spin(1);
+		// E high for at least 450 ns
+	fGpio->WriteLevels(&fLcdPins, levels);
+		// taken on its falling edge
+}
+
+
+void
+LcdShield::_Send(uint8 value, bool data, bigtime_t wait)
+{
+	_Nibble(value >> 4, data);
+	_Nibble(value, data);
+	if (wait >= 1000)
+		snooze(wait);
+	else
+		spin(wait);
+}
+
+
+void
+LcdShield::_GoTo(uint32 row, uint32 column)
+{
+	int32 address = (row == 0 ? 0x00 : 0x40) + column;
+	if (address == fAddress)
+		return;
+	_Send(LCD_SET_DDRAM | address, false);
+	fAddress = address;
+}
+
+
+void
+LcdShield::_PutCode(uint8 code)
+{
+	if (fPendingNewline) {
+		fPendingNewline = false;
+		_NewLine();
+	}
+	if (fColumn >= LCD_SHIELD_COLUMNS)
+		_NewLine();
+	_GoTo(fRow, fColumn);
+	_Send(code, true);
+	fAddress++;
+	fText[fRow][fColumn++] = code;
+}
+
+
+/*!	The start of the next line, cleared; from the second line, the display
+	scrolls up.
+*/
+void
+LcdShield::_NewLine()
+{
+	if (fRow == 0)
+		fRow = 1;
+	else {
+		memcpy(fText[0], fText[1], LCD_SHIELD_COLUMNS);
+		_GoTo(0, 0);
+		for (uint32 column = 0; column < LCD_SHIELD_COLUMNS; column++) {
+			_Send(fText[0][column], true);
+			fAddress++;
+		}
+	}
+	memset(fText[fRow], ' ', LCD_SHIELD_COLUMNS);
+	_GoTo(fRow, 0);
+	for (uint32 column = 0; column < LCD_SHIELD_COLUMNS; column++) {
+		_Send(' ', true);
+		fAddress++;
+	}
+	fColumn = 0;
+}
+
+
+void
+LcdShield::_Clear()
+{
+	_Send(LCD_CLEAR, false, kLongInstruction);
+	memset(fText, ' ', sizeof(fText));
+	fRow = fColumn = 0;
+	fAddress = 0;
+	fPendingNewline = false;
+}
+
+
+/*!	A visible cursor stands where the next character goes. */
+void
+LcdShield::_ShowCursor()
+{
+	if (fCursor == LCD_SHIELD_CURSOR_OFF)
+		return;
+	uint32 row = fRow;
+	uint32 column = fColumn;
+	if (fPendingNewline) {
+		row = 1;
+		column = 0;
+	}
+	_GoTo(row, min_c(column, (uint32)LCD_SHIELD_COLUMNS - 1));
+}
+
+
+void
+LcdShield::_DisplayControl()
+{
+	uint8 control = LCD_DISPLAY_CONTROL;
+	if (fDisplayOn)
+		control |= LCD_DISPLAY_ON;
+	if (fCursor != LCD_SHIELD_CURSOR_OFF)
+		control |= LCD_CURSOR_ON;
+	if (fCursor == LCD_SHIELD_CURSOR_BLINK)
+		control |= LCD_BLINK_ON;
+	_Send(control, false);
+}
+
+
+void
+LcdShield::_Character(uint32 character)
+{
+	switch (character) {
+		case '\n':
+			if (fPendingNewline)
+				_NewLine();
+			fPendingNewline = true;
+			return;
+		case '\r':
+			fPendingNewline = false;
+			fColumn = 0;
+			return;
+		case '\f':
+			_Clear();
+			return;
+		case '\b':
+			if (fPendingNewline)
+				fPendingNewline = false;
+			else if (fColumn > 0)
+				fColumn--;
+			return;
+		case '\t':
+			do {
+				_PutCode(' ');
+			} while (fColumn % 4 != 0 && fColumn < LCD_SHIELD_COLUMNS);
+			return;
+	}
+	if (character < 8) {
+		// a user character
+		_PutCode((uint8)character);
+		return;
+	}
+	if (character < 0x20 || character == 0x7f)
+		return;
+	_PutCode(code_for(character));
+}
+
+
+status_t
+LcdShield::_LcdWrite(const char* buffer, size_t length)
+{
+	for (size_t i = 0; i < length; i++) {
+		uint8 byte = buffer[i];
+		if (fUtf8Remaining > 0) {
+			if ((byte & 0xc0) == 0x80) {
+				fUtf8Value = (fUtf8Value << 6) | (byte & 0x3f);
+				if (--fUtf8Remaining == 0)
+					_Character(fUtf8Value);
+				continue;
+			}
+			// a broken sequence
+			fUtf8Remaining = 0;
+			_Character(kUnknown);
+		}
+		if (byte < 0x80)
+			_Character(byte);
+		else if ((byte & 0xe0) == 0xc0) {
+			fUtf8Value = byte & 0x1f;
+			fUtf8Remaining = 1;
+		} else if ((byte & 0xf0) == 0xe0) {
+			fUtf8Value = byte & 0x0f;
+			fUtf8Remaining = 2;
+		} else if ((byte & 0xf8) == 0xf0) {
+			fUtf8Value = byte & 0x07;
+			fUtf8Remaining = 3;
+		} else
+			_Character(kUnknown);
+	}
+	_ShowCursor();
+	return B_OK;
+}
+
+
+status_t
+LcdShield::_LcdRead(off_t position, void* buffer, size_t* _length)
+{
+	char text[LCD_SHIELD_ROWS * (LCD_SHIELD_COLUMNS * 3 + 1)];
+	size_t length = 0;
+	for (uint32 row = 0; row < LCD_SHIELD_ROWS; row++) {
+		for (uint32 column = 0; column < LCD_SHIELD_COLUMNS; column++)
+			length += utf8_for(fText[row][column], text + length);
+		text[length++] = '\n';
+	}
+	return read_text(text, length, position, buffer, _length);
+}
+
+
+status_t
+LcdShield::_LcdControl(uint32 op, void* buffer, size_t length)
+{
+	switch (op) {
+		case LCD_SHIELD_CLEAR:
+			_Clear();
+			_ShowCursor();
+			return B_OK;
+
+		case LCD_SHIELD_SET_POSITION:
+		{
+			lcd_shield_position position;
+			if (user_memcpy(&position, buffer, sizeof(position)) != B_OK)
+				return B_BAD_ADDRESS;
+			if (position.row >= LCD_SHIELD_ROWS
+				|| position.column >= LCD_SHIELD_COLUMNS) {
+				return B_BAD_VALUE;
+			}
+			fRow = position.row;
+			fColumn = position.column;
+			fPendingNewline = false;
+			_ShowCursor();
+			return B_OK;
+		}
+
+		case LCD_SHIELD_GET_POSITION:
+		{
+			lcd_shield_position position;
+			position.row = fPendingNewline ? 1 : fRow;
+			position.column = fPendingNewline ? 0
+				: min_c(fColumn, (uint32)LCD_SHIELD_COLUMNS - 1);
+			return user_memcpy(buffer, &position, sizeof(position));
+		}
+
+		case LCD_SHIELD_SET_CURSOR:
+		{
+			uint32 cursor;
+			if (user_memcpy(&cursor, buffer, sizeof(cursor)) != B_OK)
+				return B_BAD_ADDRESS;
+			if (cursor > LCD_SHIELD_CURSOR_BLINK)
+				return B_BAD_VALUE;
+			fCursor = cursor;
+			_DisplayControl();
+			_ShowCursor();
+			return B_OK;
+		}
+
+		case LCD_SHIELD_SET_DISPLAY:
+		{
+			uint32 on;
+			if (user_memcpy(&on, buffer, sizeof(on)) != B_OK)
+				return B_BAD_ADDRESS;
+			fDisplayOn = on != 0;
+			_DisplayControl();
+			return B_OK;
+		}
+
+		case LCD_SHIELD_DEFINE_CHARACTER:
+		{
+			lcd_shield_character character;
+			if (user_memcpy(&character, buffer, sizeof(character)) != B_OK)
+				return B_BAD_ADDRESS;
+			if (character.code > 7)
+				return B_BAD_VALUE;
+			_Send(LCD_SET_CGRAM | (character.code << 3), false);
+			for (uint32 i = 0; i < 8; i++)
+				_Send(character.rows[i] & 0x1f, true);
+			// the address counter is in CGRAM now
+			fAddress = -1;
+			_ShowCursor();
+			return B_OK;
+		}
+
+		case LCD_SHIELD_GET_TEXT:
+		{
+			lcd_shield_text text;
+			memcpy(text.codes, fText, sizeof(text.codes));
+			return user_memcpy(buffer, &text, sizeof(text));
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+//	#pragma mark - LEDs
+
+
+status_t
+LcdShield::_LedsStart()
+{
+	if (fLedsStarted)
+		return B_OK;
+	status_t status = fGpio->ClaimPins(&fLedPins, kLedPins,
+		B_COUNT_OF(kLedPins), "LCD shield");
+	if (status != B_OK)
+		return status;
+	fGpio->WriteLevels(&fLedPins, fLeds);
+	fGpio->SetOutputs(&fLedPins, (1u << B_COUNT_OF(kLedPins)) - 1);
+	fLedsStarted = true;
+	return B_OK;
+}
+
+
+status_t
+LcdShield::_LedsWrite(const char* buffer, size_t length)
+{
+	// each write, and each line, starts at D1
+	uint32 next = 0;
+	for (size_t i = 0; i < length; i++) {
+		char c = buffer[i];
+		if (c == '\n') {
+			next = 0;
+			continue;
+		}
+		if ((c != '0' && c != '1') || next >= LCD_SHIELD_LEDS)
+			continue;
+		if (c == '1')
+			fLeds |= 1u << next;
+		else
+			fLeds &= ~(1u << next);
+		next++;
+	}
+	fGpio->WriteLevels(&fLedPins, fLeds);
+	return B_OK;
+}
+
+
+status_t
+LcdShield::_LedsRead(off_t position, void* buffer, size_t* _length)
+{
+	char text[LCD_SHIELD_LEDS + 1];
+	for (uint32 i = 0; i < LCD_SHIELD_LEDS; i++)
+		text[i] = (fLeds >> i) & 1 ? '1' : '0';
+	text[LCD_SHIELD_LEDS] = '\n';
+	return read_text(text, sizeof(text), position, buffer, _length);
+}
+
+
+//	#pragma mark - buttons
+
+
+status_t
+LcdShield::_ButtonsStart()
+{
+	if (!fButtonsClaimed) {
+		status_t status = fGpio->ClaimPins(&fButtonPins, kButtonPins,
+			B_COUNT_OF(kButtonPins), "LCD shield");
+		if (status != B_OK)
+			return status;
+		fGpio->SetOutputs(&fButtonPins, 0);
+		fGpio->SetPulls(&fButtonPins, (1u << B_COUNT_OF(kButtonPins)) - 1,
+			MESON_GPIO_PULL_UP);
+		fButtonsClaimed = true;
+	}
+	if (fButtonThread >= 0)
+		return B_OK;
+
+	snooze(1000);
+		// for the pull-ups
+	fButtonsDown = fButtonsLast = ~fGpio->ReadLevels(&fButtonPins)
+		& ((1u << B_COUNT_OF(kButtonPins)) - 1);
+	fButtonQuit = false;
+	fButtonThread = spawn_kernel_thread(_ButtonThread, "lcd shield buttons",
+		B_NORMAL_PRIORITY, this);
+	if (fButtonThread < 0)
+		return fButtonThread;
+	resume_thread(fButtonThread);
+	return B_OK;
+}
+
+
+void
+LcdShield::_ButtonsStop()
+{
+	thread_id thread;
+	{
+		MutexLocker locker(fLock);
+		if (fButtonUsers > 0 || fButtonThread < 0)
+			return;
+		thread = fButtonThread;
+		fButtonThread = -1;
+		fButtonQuit = true;
+	}
+	status_t result;
+	wait_for_thread(thread, &result);
+}
+
+
+/*static*/ status_t
+LcdShield::_ButtonThread(void* self)
+{
+	LcdShield* shield = (LcdShield*)self;
+	while (!shield->fButtonQuit) {
+		shield->_SampleButtons();
+		snooze(kButtonPeriod);
+	}
+	return B_OK;
+}
+
+
+/*!	A change counts once two samples in a row agree on it. */
+void
+LcdShield::_SampleButtons()
+{
+	uint32 down = ~fGpio->ReadLevels(&fButtonPins)
+		& ((1u << B_COUNT_OF(kButtonPins)) - 1);
+	MutexLocker locker(fLock);
+	if (down == fButtonsLast && down != fButtonsDown) {
+		bigtime_t now = system_time();
+		for (uint32 button = 0; button < B_COUNT_OF(kButtonPins); button++) {
+			uint32 bit = 1u << button;
+			if (((down ^ fButtonsDown) & bit) == 0)
+				continue;
+			ButtonEvent& event = fEvents[fEventCount % kEventCount];
+			event.button = button;
+			event.pressed = (down & bit) != 0;
+			event.when = now;
+			fEventCount++;
+		}
+		fButtonsDown = down;
+		fButtonCondition.NotifyAll();
+	}
+	fButtonsLast = down;
+}
+
+
+status_t
+LcdShield::_WaitButton(lcd_shield_cookie* cookie, bigtime_t timeout,
+	lcd_shield_button_event& _event)
+{
+	bool forever = timeout == B_INFINITE_TIMEOUT;
+	bigtime_t deadline = forever ? 0 : system_time() + max_c(timeout,
+		(bigtime_t)0);
+
+	MutexLocker locker(fLock);
+	while (cookie->nextEvent == fEventCount) {
+		if (cookie->closed)
+			return B_FILE_ERROR;
+		if (!forever && system_time() >= deadline)
+			return B_TIMED_OUT;
+		ConditionVariableEntry entry;
+		fButtonCondition.Add(&entry);
+		locker.Unlock();
+		status_t status = entry.Wait(forever ? B_CAN_INTERRUPT
+			: B_CAN_INTERRUPT | B_ABSOLUTE_TIMEOUT, deadline);
+		locker.Lock();
+		if (status == B_INTERRUPTED)
+			return status;
+	}
+
+	uint32 missed = 0;
+	if (fEventCount - cookie->nextEvent > kEventCount) {
+		missed = fEventCount - kEventCount - cookie->nextEvent;
+		cookie->nextEvent = fEventCount - kEventCount;
+	}
+	const ButtonEvent& event = fEvents[cookie->nextEvent % kEventCount];
+	cookie->nextEvent++;
+	_event.button = event.button;
+	_event.pressed = event.pressed;
+	_event.when = event.when;
+	_event.missed = missed;
+	return B_OK;
+}
+
+
+status_t
+LcdShield::_ButtonsRead(lcd_shield_cookie* cookie, void* buffer,
+	size_t* _length)
+{
+	static const size_t kLineLength = 16;
+	if (*_length < kLineLength)
+		return B_BAD_VALUE;
+
+	// wait for one event, then take those that are there and fit
+	size_t length = 0;
+	char text[256];
+	bool nonBlocking = (cookie->openMode & O_NONBLOCK) != 0;
+	while (length + kLineLength <= min_c(*_length, sizeof(text))) {
+		lcd_shield_button_event event;
+		status_t status = _WaitButton(cookie,
+			length > 0 || nonBlocking ? 0 : B_INFINITE_TIMEOUT, event);
+		if (status == B_TIMED_OUT && length == 0 && nonBlocking)
+			return B_WOULD_BLOCK;
+		if (status != B_OK) {
+			if (length > 0)
+				break;
+			return status;
+		}
+		length += snprintf(text + length, sizeof(text) - length, "SW%u %s\n",
+			(unsigned)event.button + 1, event.pressed ? "pressed" : "released");
+	}
+	if (user_memcpy(buffer, text, length) != B_OK)
+		return B_BAD_ADDRESS;
+	*_length = length;
+	return B_OK;
+}
+
+
+//	#pragma mark - device module
+
+
+static status_t
+shield_init_device(void* driverCookie, void** _deviceCookie)
+{
+	*_deviceCookie = driverCookie;
+	return B_OK;
+}
+
+
+static void
+shield_uninit_device(void* deviceCookie)
+{
+}
+
+
+static status_t
+shield_open(void* deviceCookie, const char* path, int openMode,
+	void** _cookie)
+{
+	LcdShield* shield = ((MesonGpio*)deviceCookie)->Shield();
+	if (shield == NULL)
+		return B_NO_INIT;
+
+	const char* name = strrchr(path, '/');
+	name = name != NULL ? name + 1 : path;
+	uint32 part;
+	if (strcmp(name, "lcd") == 0)
+		part = LCD_SHIELD_PART_LCD;
+	else if (strcmp(name, "leds") == 0)
+		part = LCD_SHIELD_PART_LEDS;
+	else if (strcmp(name, "buttons") == 0)
+		part = LCD_SHIELD_PART_BUTTONS;
+	else
+		return B_ENTRY_NOT_FOUND;
+
+	lcd_shield_cookie* cookie = new(std::nothrow) lcd_shield_cookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	cookie->shield = shield;
+	cookie->part = part;
+	cookie->openMode = openMode;
+	cookie->nextEvent = 0;
+	cookie->closed = false;
+	status_t status = shield->Open(cookie);
+	if (status != B_OK) {
+		delete cookie;
+		return status;
+	}
+	*_cookie = cookie;
+	return B_OK;
+}
+
+
+static status_t
+shield_close(void* _cookie)
+{
+	lcd_shield_cookie* cookie = (lcd_shield_cookie*)_cookie;
+	cookie->shield->Close(cookie);
+	return B_OK;
+}
+
+
+static status_t
+shield_free(void* _cookie)
+{
+	lcd_shield_cookie* cookie = (lcd_shield_cookie*)_cookie;
+	cookie->shield->Free(cookie);
+	delete cookie;
+	return B_OK;
+}
+
+
+static status_t
+shield_read(void* _cookie, off_t position, void* buffer, size_t* _length)
+{
+	lcd_shield_cookie* cookie = (lcd_shield_cookie*)_cookie;
+	return cookie->shield->Read(cookie, position, buffer, _length);
+}
+
+
+static status_t
+shield_write(void* _cookie, off_t position, const void* buffer,
+	size_t* _length)
+{
+	lcd_shield_cookie* cookie = (lcd_shield_cookie*)_cookie;
+	status_t status = cookie->shield->Write(cookie, buffer, _length);
+	if (status != B_OK)
+		*_length = 0;
+	return status;
+}
+
+
+static status_t
+shield_control(void* _cookie, uint32 op, void* buffer, size_t length)
+{
+	lcd_shield_cookie* cookie = (lcd_shield_cookie*)_cookie;
+	return cookie->shield->Control(cookie, op, buffer, length);
+}
+
+
+struct device_module_info gLcdShieldDevice = {
+	{
+		LCD_SHIELD_DEVICE_MODULE_NAME,
+		0,
+		NULL
+	},
+
+	shield_init_device,
+	shield_uninit_device,
+	NULL,	// remove
+
+	shield_open,
+	shield_close,
+	shield_free,
+	shield_read,
+	shield_write,
+	NULL,	// io
+	shield_control,
+
+	NULL,	// select
+	NULL,	// deselect
+};
