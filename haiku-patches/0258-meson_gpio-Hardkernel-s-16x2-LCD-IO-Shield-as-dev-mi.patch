+			void				_SampleButtons();
+			status_t			_WaitButton(lcd_shield_cookie* cookie,
+									bigtime_t timeout,
+									lcd_shield_button_event& event);
+			status_t			_ButtonsRead(lcd_shield_cookie* cookie,
+									void* buffer, size_t* _length);
+
+			MesonGpio*			fGpio;
+			mutex				fLock;
+
+			gpio_cookie			fLcdPins;
+			bool				fLcdStarted;
+			uint8				fText[LCD_SHIELD_ROWS][LCD_SHIELD_COLUMNS];
+			uint32				fRow;
+			uint32				fColumn;
+			int32				fAddress;	// the display's next one, -1
+			bool				fPendingNewline;
+			uint32				fCursor;
+			bool				fDisplayOn;
+			uint32				fUtf8Value;
