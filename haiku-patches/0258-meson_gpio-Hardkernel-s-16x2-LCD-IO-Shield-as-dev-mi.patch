+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef MESON_GPIO_PRIVATE_H
+#define MESON_GPIO_PRIVATE_H
+
+
+#include <KernelExport.h>
+
+#include <condition_variable.h>
+#include <device_manager.h>
+#include <lock.h>
+
+#include <meson_gpio.h>
+
+
+static const uint32 kChannelCount = 8;
+static const uint32 kEdgeQueueSize = 32;
+static const uint32 kMaxPins = 32;
+
+static const uint32 kInterruptBlock = 0x880;
+
+
+class LcdShield;
+class MesonGpio;
+struct PwmPin;
+
+/*!	An open file: the pins it claimed (indexes into the header module's
+	table), in the order of their bits.
+*/
+struct gpio_cookie {
+	MesonGpio*	gpio;
+	uint32		count;
+	uint8		pins[32];
+};
+
+
+struct EdgeEvent {
+	bigtime_t	when;
+	uint8		edge;
+	uint8		level;
+};
+
+/*!	A pin whose edges are recorded: its channels, rising and falling, and
+	the edges waiting to be read.
+*/
+struct EdgeRecorder {
+	gpio_cookie*		owner;
+	uint8				edges;
+	uint8				channels[2];
+	bool				settling;
+	uint32				first;
+	uint32				count;
+	uint32				missed;
+	EdgeEvent			queue[kEdgeQueueSize];
+	ConditionVariable	condition;
+};
+
+struct EdgeChannel {
+	MesonGpio*	gpio;
+	bool		used;
+	uint8		index;		// the pin's
+	uint8		edge;		// MESON_GPIO_EDGE_*
+};
+
+
+class MesonGpio {
+public:
+								MesonGpio(device_node* node);
+								~MesonGpio();
+
+			status_t			Init();
+			device_node*		Node() const { return fNode; }
+
+			status_t			Read(off_t position, char* buffer,
+									size_t* _length);
+			status_t			Write(const char* buffer, size_t length);
+			status_t			Control(gpio_cookie* cookie, uint32 op,
+									void* buffer, size_t length);
+			void				Close(gpio_cookie* cookie);
+			void				Free(gpio_cookie* cookie);
+
+			// for users in the kernel (the LCD + IO shield): what the ioctls
+			// do, with kernel memory; a pin's bit is its place in the claim
+			status_t			ClaimPins(gpio_cookie* cookie,
+									const uint8* pins, uint32 count,
+									const char* use);
+			void				SetOutputs(gpio_cookie* cookie,
+									uint32 outputs);
+			void				WriteLevels(gpio_cookie* cookie,
+									uint32 levels);
+			uint32				ReadLevels(gpio_cookie* cookie);
+			void				SetPulls(gpio_cookie* cookie, uint32 bits,
+									uint32 pull);
+
+			LcdShield*			Shield() const { return fShield; }
+			void				SetShield(LcdShield* shield)
+									{ fShield = shield; }
+
+private:
+	struct SavedPin {
+		bool		saved;
+		const char*	function;
+		bool		input, output, pull, pullEnable;
+	};
+
+	struct PwmState {
+		bool		active;		// a PWM output, or a constant level for one
+		uint8		duty;		// the 8-bit duty cycle, last set or nearest
+		uint32		period;		// nanoseconds
+		uint32		high;
+	};
+
+			volatile uint32&	_Word(uint32 offset, uint32 word)
+									{ return fRegisters[(offset + word * 4)
+										/ 4]; }
+			bool				_Get(uint32 offset, uint32 word, uint32 bit)
+									{ return (_Word(offset, word) >> bit) & 1; }
+			void				_Set(uint32 offset, uint32 word, uint32 bit,
+									bool value);
+			bool				_Input(uint32 index);
+			bool				_Level(uint32 index);
+
+			status_t			_Command(char* line);
+			status_t			_Configure(uint32 index, bool output,
+									bool level, int pull);
+			status_t			_Release(uint32 index);
+			void				_Save(uint32 index);
+			void				_SetDirection(uint32 index, bool output);
+			void				_SetPull(uint32 index, uint32 pull);
+			void				_SetOutputLevel(uint32 index, bool level);
+			const PwmPin*		_PwmPin(uint32 index);
+			void				_DisablePwm(uint32 index);
+			status_t			_SetPwm(uint32 index, uint32 divider,
+									uint32 cycles, uint32 high);
+			status_t			_SetPwmPeriod(uint32 index, uint32 period,
+									uint32 high);
+			status_t			_Claim(gpio_cookie* cookie,
+									const meson_gpio_pins& pins,
+									const char* use);
+			status_t			_PinInfo(meson_gpio_pin_info& info);
+
+			volatile uint32&	_InterruptWord(uint32 word)
+									{ return fInterruptRegisters[
+										kInterruptBlock / 4 + word]; }
+			void				_SetChannel(uint32 channel, uint32 input,
+									bool falling);
+			status_t			_SetEdges(gpio_cookie* cookie, uint32 index,
+									uint32 edges);
+			void				_StopEdges(uint32 index);
+			status_t			_WaitEdge(gpio_cookie* cookie,
+									meson_gpio_edge& edge);
+	static	int32				_EdgeInterrupt(void* data);
+
+			device_node*		fNode;
+			area_id				fArea;
+			volatile uint32*	fRegisters;
+			area_id				fPwmArea;
+			volatile uint32*	fPwmRegisters;
+			area_id				fInterruptArea;
+			volatile uint32*	fInterruptRegisters;
+			mutex				fLock;
+			spinlock			fEdgeLock;
+				// the recorders, the channels and the interrupt block
+			uint32				fPinCount;
+			SavedPin			fSaved[kMaxPins];
+			PwmState			fPwm[kMaxPins];
+			EdgeRecorder		fRecorders[kMaxPins];
+			EdgeChannel			fChannels[kChannelCount];
+			LcdShield*			fShield;
+};
+
+
+
+#endif	// MESON_GPIO_PRIVATE_H
diff --git a/src/add-ons/kernel/drivers/misc/meson_gpio/lcd_shield.cpp b/src/add-ons/kernel/drivers/misc/meson_gpio/lcd_shield.cpp
new file mode 100644
index 0000000000..c0d1e3ebcb
--- /dev/null
+++ b/src/add-ons/kernel/drivers/misc/meson_gpio/lcd_shield.cpp
@@ -0,0 +1,1059 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * Hardkernel's 16x2 LCD + IO Shield ("ODROID-C 16x2 LCD + IO Kit", 2014) on
+ * the ODROID-C2's header: /dev/misc/shield/lcd, leds and buttons, published
+ * by meson_gpio when its driver settings have "lcd_io_shield true". The
+ * devices are described in headers/private/drivers/lcd_shield.h.
+ *
+ * The shield's schematic (header pins):
+ *   - the LCD, an HD44780 compatible SCM1602A on 5 V, in 4-bit mode: RS 7,
+ *     E 11, D4 13, D5 15, D6 12, D7 16; its R/W is tied low, so it is only
+ *     written, and its busy flag can't be read: commands get the
+ *     datasheet's time instead (37 us, 1.52 ms to clear or go home);
+ *   - LEDs D1 to D7 on pins 29, 31, 33, 35, 36, 32, 26, each through
+ *     3.9 kOhm to ground: high is lit;
+ *   - SW1 on pin 18, SW2 on pin 22, closing to ground, with no resistor:
+ *     the pins' pull-ups are turned on.
+ *
+ * The pins are claimed from meson_header (as "LCD shield") when a device is
+ * first opened, and kept until the driver goes: the LCD's E line must not
+ * float, and the LEDs keep what was written. The LCD is started then, by
+ * the datasheet's initialization by instruction into 4-bit mode.
+ *
+ * The HD44780's A00 character set is ASCII from 0x20 to 0x7d (but 0x5c is
+ * a yen sign, 0x7e and 0x7f arrows), katakana, and a few Greek and
+ * accented letters and symbols at 0xdf to 0xff: the UTF-8 written is mapped
+ * onto them (kCharacters), anything else becomes '?'.
+ */
+
+
+#include "LcdShield.h"
+
+#include <fcntl.h>
+#include <new>
+#include <stdio.h>
+#include <string.h>
+
+#include <KernelExport.h>
+#include <driver_settings.h>
+#include <util/AutoLock.h>
+
+
+#define INFO(x...) dprintf("meson_gpio: shield: " x)
+
+
+// the LCD's pins, in the order of their bits
+static const uint8 kLcdPins[] = { 7, 11, 13, 15, 12, 16 };
+static const uint32 kRS = 1 << 0;
+static const uint32 kE = 1 << 1;
+static const uint32 kDataShift = 2;
+
+static const uint8 kLedPins[] = { 29, 31, 33, 35, 36, 32, 26 };
+static const uint8 kButtonPins[] = { 18, 22 };
+
+static const bigtime_t kButtonPeriod = 10000;
+
+// HD44780 instructions
+enum {
+	LCD_CLEAR			= 0x01,
+	LCD_ENTRY_MODE		= 0x04,
+		LCD_ENTRY_INCREMENT	= 0x02,
+	LCD_DISPLAY_CONTROL	= 0x08,
+		LCD_DISPLAY_ON		= 0x04,
+		LCD_CURSOR_ON		= 0x02,
+		LCD_BLINK_ON		= 0x01,
+	LCD_FUNCTION_SET	= 0x20,
+		LCD_TWO_LINES		= 0x08,
+	LCD_SET_CGRAM		= 0x40,
+	LCD_SET_DDRAM		= 0x80,
+};
+
+static const bigtime_t kLongInstruction = 2000;
+	// clear and home: 1.52 ms
+
+static const uint8 kUnknown = '?';
+
+
+// characters outside ASCII that the A00 character set has, and its codes
+// that aren't ASCII's characters
+struct Character {
+	uint32	unicode;
+	uint8	code;
+};
+
+static const Character kCharacters[] = {
+	{ 0x00a5, 0x5c },	// ¥ (where ASCII has '\')
+	{ 0x2192, 0x7e },	// →
+	{ 0x2190, 0x7f },	// ←
+	{ 0x00b7, 0xa5 },	// ·
+	{ 0x00b0, 0xdf },	// °
+	{ 0x03b1, 0xe0 },	// α
+	{ 0x00e4, 0xe1 },	// ä
+	{ 0x03b2, 0xe2 },	// β
+	{ 0x00df, 0xe2 },	// ß, the same picture
+	{ 0x03b5, 0xe3 },	// ε
+	{ 0x00b5, 0xe4 },	// µ
+	{ 0x03bc, 0xe4 },	// μ
+	{ 0x03c3, 0xe5 },	// σ
+	{ 0x03c1, 0xe6 },	// ρ
+	{ 0x221a, 0xe8 },	// √
+	{ 0x00a2, 0xec },	// ¢
+	{ 0x00f1, 0xee },	// ñ
+	{ 0x00f6, 0xef },	// ö
+	{ 0x03b8, 0xf2 },	// θ
+	{ 0x221e, 0xf3 },	// ∞
+	{ 0x03a9, 0xf4 },	// Ω
+	{ 0x00fc, 0xf5 },	// ü
+	{ 0x03a3, 0xf6 },	// Σ
+	{ 0x03c0, 0xf7 },	// π
+	{ 0x00f7, 0xfd },	// ÷
+	{ 0x2588, 0xff },	// █
+};
+
+
+static uint8
+code_for(uint32 unicode)
+{
+	if (unicode >= 0x20 && unicode <= 0x7d && unicode != '\\')
+		return (uint8)unicode;
+	for (size_t i = 0; i < B_COUNT_OF(kCharacters); i++) {
+		if (kCharacters[i].unicode == unicode)
+			return kCharacters[i].code;
+	}
+	return kUnknown;
+}
+
+
+/*!	What a code shows, as UTF-8 (the user characters as '?'). */
+static size_t
+utf8_for(uint8 code, char* buffer)
+{
+	uint32 unicode = kUnknown;
+	if (code >= 0x20 && code <= 0x7d && code != 0x5c)
+		unicode = code;
+	else {
+		for (size_t i = 0; i < B_COUNT_OF(kCharacters); i++) {
+			if (kCharacters[i].code == code) {
+				unicode = kCharacters[i].unicode;
+				break;
+			}
+		}
+	}
+	if (unicode < 0x80) {
+		buffer[0] = (char)unicode;
+		return 1;
+	}
+	if (unicode < 0x800) {
+		buffer[0] = (char)(0xc0 | (unicode >> 6));
+		buffer[1] = (char)(0x80 | (unicode & 0x3f));
+		return 2;
+	}
+	buffer[0] = (char)(0xe0 | (unicode >> 12));
+	buffer[1] = (char)(0x80 | ((unicode >> 6) & 0x3f));
+	buffer[2] = (char)(0x80 | (unicode & 0x3f));
+	return 3;
+}
+
+
+/*!	Copies what remains of \a text from \a position to the user's buffer. */
+static status_t
+read_text(const char* text, size_t textLength, off_t position, void* buffer,
+	size_t* _length)
+{
+	if (position >= (off_t)textLength) {
+		*_length = 0;
+		return B_OK;
+	}
+	size_t length = min_c(*_length, textLength - (size_t)position);
+	if (user_memcpy(buffer, text + position, length) != B_OK)
+		return B_BAD_ADDRESS;
+	*_length = length;
+	return B_OK;
+}
+
+
+const char* const LcdShield::kDevicePaths[] = {
+	"misc/shield/lcd",
+	"misc/shield/leds",
+	"misc/shield/buttons",
+	NULL
+};
