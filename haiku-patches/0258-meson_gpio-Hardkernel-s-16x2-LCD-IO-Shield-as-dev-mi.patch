+
+			// lcd
+			status_t			_LcdStart();
+			void				_Nibble(uint8 value, bool data);
+			void				_Send(uint8 value, bool data,
+									bigtime_t wait = 50);
+			void				_GoTo(uint32 row, uint32 column);
+			void				_PutCode(uint8 code);
+			void				_NewLine();
+			void				_Clear();
+			void				_ShowCursor();
+			void				_DisplayControl();
+			void				_Character(uint32 character);
+			status_t			_LcdWrite(const char* buffer, size_t length);
+			status_t			_LcdRead(off_t position, void* buffer,
+									size_t* _length);
+			status_t			_LcdControl(uint32 op, void* buffer,
+									size_t length);
+
+			// leds
+			status_t			_LedsStart();
+			status_t			_LedsWrite(const char* buffer, size_t length);
+			status_t			_LedsRead(off_t position, void* buffer,
+									size_t* _length);
