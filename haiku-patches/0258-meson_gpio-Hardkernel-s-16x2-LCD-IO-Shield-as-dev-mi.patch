+								LcdShield(MesonGpio* gpio);
+								~LcdShield();
+
+			status_t			Open(lcd_shield_cookie* cookie);
+			void				Close(lcd_shield_cookie* cookie);
+			void				Free(lcd_shield_cookie* cookie);
+			status_t			Read(lcd_shield_cookie* cookie,
+									off_t position, void* buffer,
+									size_t* _length);
+			status_t			Write(lcd_shield_cookie* cookie,
+									const void* buffer, size_t* _length);
+			status_t			Control(lcd_shield_cookie* cookie, uint32 op,
