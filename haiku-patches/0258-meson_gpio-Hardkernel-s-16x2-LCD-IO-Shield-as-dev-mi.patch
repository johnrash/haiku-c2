--- /dev/null
+++ b/headers/private/drivers/lcd_shield.h
@@ -0,0 +1,111 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LCD_SHIELD_H
+#define _LCD_SHIELD_H
+
+
+#include <Drivers.h>
+
+
+/*!	Hardkernel's 16x2 LCD + IO Shield on the ODROID-C2's header, driven by
+	meson_gpio when "lcd_io_shield true" is in its driver settings
+	(~/config/settings/kernel/drivers/meson_gpio): the shield can't be
+	detected. Three devices; each takes its pins from GPIO when it is first
+	opened and keeps them.
+
+	lcd: the HD44780 character display, two lines of 16. Text written to it
+	appears at the cursor, UTF-8 mapped to the display's character set
+	(ASCII, and the few others it has: ° µ π Ω Σ √ ∞ ÷ ä ö ü ñ α β ε θ σ
+	ρ ¢ ¥ → ← █; anything else is '?'). Bytes 0 to 7 are the characters
+	defined with LCD_SHIELD_DEFINE_CHARACTER. '\n' goes to the start of the
+	next line and clears it, scrolling the display up from the second one,
+	but only once something follows (so that echo's newline doesn't scroll
+	the text away); '\r' to the start of the line, '\f' clears the display,
+	'\b' goes back one, '\t' to the next multiple of four. Text past the end
+	of a line goes on to the next. Reading it gives the two lines.
+
+	leds: the seven LEDs D1 to D7. Write '0' and '1', D1 first ("1010101");
+	other characters are skipped, and fewer than seven set the first ones.
+	Reading gives the same form. They stay as set when the file is closed.
+
+	buttons: SW1 and SW2. Reading waits for a press or a release and gives
+	a line for each ("SW1 pressed", "SW2 released"); every open file sees
+	every event from its open on. O_NONBLOCK reads return B_WOULD_BLOCK when
+	there is none. The buttons are sampled every 10 ms while the device is
+	open, and a change counts once it holds for two samples.
+*/
+
+
+#define LCD_SHIELD_LCD_DEVICE		"/dev/misc/shield/lcd"
+#define LCD_SHIELD_LEDS_DEVICE		"/dev/misc/shield/leds"
+#define LCD_SHIELD_BUTTONS_DEVICE	"/dev/misc/shield/buttons"
+
+#define LCD_SHIELD_COLUMNS			16
+#define LCD_SHIELD_ROWS				2
+#define LCD_SHIELD_LEDS				7
+#define LCD_SHIELD_BUTTONS			2
+
+
+enum {
+	// lcd
+	LCD_SHIELD_CLEAR = B_DEVICE_OP_CODES_END + 0x4c43,
+		// no argument: clear, cursor home
+	LCD_SHIELD_SET_POSITION,
+		// lcd_shield_position: where the next character goes
+	LCD_SHIELD_GET_POSITION,
+		// lcd_shield_position
+	LCD_SHIELD_SET_CURSOR,
+		// uint32: LCD_SHIELD_CURSOR_*
+	LCD_SHIELD_SET_DISPLAY,
+		// uint32: 0 off (the text is kept), 1 on
+	LCD_SHIELD_DEFINE_CHARACTER,
+		// lcd_shield_character: one of the eight user characters
+	LCD_SHIELD_GET_TEXT,
+		// lcd_shield_text: the display's character codes, as shown
+
+	// leds
+	LCD_SHIELD_SET_LEDS,
+		// uint32: bit 0 D1 to bit 6 D7, 1 lit
+	LCD_SHIELD_GET_LEDS,
+		// uint32
+
+	// buttons
+	LCD_SHIELD_GET_BUTTONS,
+		// uint32: bit 0 SW1, bit 1 SW2, 1 pressed
+	LCD_SHIELD_WAIT_BUTTON,
+		// lcd_shield_button_event: in timeout, out the next event of this
+		// file; B_TIMED_OUT, B_INTERRUPTED
+};
+
+enum {
+	LCD_SHIELD_CURSOR_OFF,
+	LCD_SHIELD_CURSOR_UNDERLINE,
+	LCD_SHIELD_CURSOR_BLINK,
+};
+
+struct lcd_shield_position {
+	uint32		row;			// 0 or 1
+	uint32		column;			// 0 to 15
+};
+
+struct lcd_shield_character {
+	uint32		code;			// 0 to 7
+	uint8		rows[8];		// five pixels each, bit 4 the left one
+};
+
+struct lcd_shield_text {
+	uint8		codes[LCD_SHIELD_ROWS][LCD_SHIELD_COLUMNS];
+};
+
+struct lcd_shield_button_event {
+	bigtime_t	timeout;		// in: relative, or B_INFINITE_TIMEOUT
+	uint32		button;			// 0 SW1, 1 SW2
+	uint32		pressed;
+	bigtime_t	when;			// system_time() of the change
+	uint32		missed;			// events lost before it (32 kept)
+};
+
+
+#endif	// _LCD_SHIELD_H
