+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "Mpeg12.h"
+
+
+static const uint8 kSequenceHeader = 0xb3;
+static const uint8 kExtension = 0xb5;
+static const uint8 kSequenceExtension = 1;
+	// extension_start_code_identifier
+
+
+/*!	The next start code's position (its 00 00 01) at or after \a from, or
+	\a size if there is none.
+*/
+static size_t
+next_start_code(const uint8* data, size_t size, size_t from)
+{
+	for (size_t i = from; i + 3 < size; i++) {
+		if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1)
+			return i;
+	}
+	return size;
+}
+
+
+size_t
+mpeg12_find_sequence(const uint8* data, size_t size, const uint8** _start)
+{
+	size_t at = 0;
+	while ((at = next_start_code(data, size, at)) < size
+		&& data[at + 3] != kSequenceHeader) {
+		at++;
+	}
+	if (at >= size)
+		return 0;
+	// extensions (b5) and user data (b2) go with it
+	size_t end = at + 4;
+	while ((end = next_start_code(data, size, end)) < size
+		&& (data[end + 3] == kExtension || data[end + 3] == 0xb2)) {
+		end += 4;
+	}
+	*_start = data + at;
+	return end - at;
+}
+
+
+bool
+mpeg12_parse_sequence(const uint8* data, size_t size,
+	mpeg12_sequence& sequence)
+{
+	size_t at = 0;
+	while ((at = next_start_code(data, size, at)) < size
+		&& data[at + 3] != kSequenceHeader) {
+		at++;
+	}
+	// the start code, then 12 bits of width, 12 of height
+	if (at + 7 > size)
+		return false;
+	const uint8* header = data + at + 4;
+	sequence.width = (header[0] << 4) | (header[1] >> 4);
+	sequence.height = ((header[1] & 0xf) << 8) | header[2];
+	sequence.mpeg2 = false;
+	sequence.chroma_format = 1;
+	sequence.progressive = true;
+
+	// MPEG-2's sequence extension comes next (after the quantizer matrices
+	// the header may carry: the next start code)
+	at = next_start_code(data, size, at + 4);
+	if (at + 4 + 6 > size || data[at + 3] != kExtension
+		|| (data[at + 4] >> 4) != kSequenceExtension) {
+		return sequence.width > 0 && sequence.height > 0;
+	}
+	const uint8* extension = data + at + 4;
+	sequence.mpeg2 = true;
+	// 4 bits identifier, 8 profile and level, 1 progressive_sequence,
+	// 2 chroma_format, 2 horizontal_size_extension, 2 vertical_size_extension
+	sequence.progressive = (extension[1] >> 3) & 1;
+	sequence.chroma_format = (extension[1] >> 1) & 3;
+	uint32 horizontalExtension = ((extension[1] & 1) << 1)
+		| (extension[2] >> 7);
+	uint32 verticalExtension = (extension[2] >> 5) & 3;
+	sequence.width |= horizontalExtension << 12;
+	sequence.height |= verticalExtension << 12;
+	return sequence.width > 0 && sequence.height > 0;
+}
