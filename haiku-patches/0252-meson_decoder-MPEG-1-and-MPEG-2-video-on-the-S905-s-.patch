+status_t
+MesonVdecDecoder::_SetupMpeg12(const uint8* info, size_t infoSize)
+{
+	free(fHeaders);
+	fHeaders = (uint8*)malloc(infoSize > 0 ? infoSize : 1);
+	if (fHeaders == NULL)
+		return B_NO_MEMORY;
+	memcpy(fHeaders, info, infoSize);
+	fHeadersSize = infoSize;
+	fLengthSize = 0;
+
+	mpeg12_sequence sequence;
+	if (infoSize > 0 && mpeg12_parse_sequence(info, infoSize, sequence)) {
+		TRACE("MPEG-%d %" B_PRIu32 "x%" B_PRIu32 ", chroma %" B_PRIu32 ", %s"
+			"\n", sequence.mpeg2 ? 2 : 1, sequence.width, sequence.height,
+			sequence.chroma_format,
+			sequence.progressive ? "progressive" : "interlaced");
+		if (sequence.chroma_format != 1) {
+			TRACE("not for the hardware: not 4:2:0\n");
+			return B_MEDIA_BAD_FORMAT;
+		}
+		fWidth = sequence.width;
+		fHeight = sequence.height;
+	} else {
+		const media_raw_video_format& output
+			= fInputFormat.u.encoded_video.output;
+		fWidth = output.display.line_width;
+		fHeight = output.display.line_count;
+		TRACE("MPEG-1/2 %" B_PRIu32 "x%" B_PRIu32 " (no sequence header "
+			"before the stream)\n", fWidth, fHeight);
+	}
+	if (fWidth == 0 || fHeight == 0
+		|| !picture_fits((fWidth + 15) & ~15u, (fHeight + 15) & ~15u)) {
+		TRACE("not for the hardware: %" B_PRIu32 "x%" B_PRIu32 "\n", fWidth,
+			fHeight);
+		return B_MEDIA_BAD_FORMAT;
+	}
+	return B_OK;
+}
