+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef MPEG12_H
+#define MPEG12_H
+
+
+#include <SupportDefs.h>
+
+
+/*!	What the decoder needs to know of an MPEG-1 or MPEG-2 video stream before
+	decoding it: from its sequence header, and MPEG-2's sequence extension
+	(ISO/IEC 13818-2, 6.2.2.1 and 6.2.2.3).
+*/
+struct mpeg12_sequence {
+	uint32	width;				// horizontal_size, with the extension's
+	uint32	height;				// vertical_size
+	bool	mpeg2;				// a sequence extension follows
+	uint32	chroma_format;		// 1: 4:2:0 (MPEG-1's only), 2: 4:2:2,
+								// 3: 4:4:4
+	bool	progressive;		// progressive_sequence (MPEG-1: true)
+};
+
+
+/*!	The first sequence header in \a data (start codes and all, as the
+	stream or a container's codec data has it), and its extension if one
+	follows. Returns false if there is none.
+*/
+bool	mpeg12_parse_sequence(const uint8* data, size_t size,
+			mpeg12_sequence& sequence);
+
+/*!	The first sequence header in \a data with what belongs to it (its
+	extensions and user data): from its start code to the next other start
+	code (a GOP's or a picture's). Returns its size, 0 if there is none.
+*/
+size_t	mpeg12_find_sequence(const uint8* data, size_t size,
+			const uint8** _start);
+
+
+#endif	// MPEG12_H
