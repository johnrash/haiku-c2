+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _MESON_SARADC_H
+#define _MESON_SARADC_H
+
+
+#include <Drivers.h>
+
+
+/*!	The S905's SAR ADC (meson_saradc): one device for each input on the
+	ODROID-C2's header, /dev/misc/adc/0 (header pin 40) and /dev/misc/adc/1
+	(pin 37), 0 to 1.8 V. Reading one gives a sample in millivolts as text
+	("1234\n"); the ioctl gives the converter's value too.
+*/
+
+
+#define MESON_SARADC_DEVICE_DIRECTORY	"/dev/misc/adc"
+
+enum {
+	MESON_SARADC_READ = B_DEVICE_OP_CODES_END + 0x4144,
+		// meson_saradc_sample: a sample of the device's input
+	MESON_SARADC_READ_REFERENCE,
+		// meson_saradc_reference: a sample of one of the converter's
+		// internal voltages, for a self-test
+};
+
+
+struct meson_saradc_sample {
+	uint32		raw;			// the converter's value, 0 to 1023
+	uint32		millivolts;		// 0 to 1800
+};
+
+
+struct meson_saradc_reference {
+	uint32		reference;		// in: 0 ground, 1 to 4 a quarter of the
+								// reference voltage to all of it
+	uint32		uncalibrated;	// out: the converter's value
+	uint32		raw;			// out: calibrated (expected: reference *
+								// 256, at most 1023)
+};
+
+
+#endif	// _MESON_SARADC_H
