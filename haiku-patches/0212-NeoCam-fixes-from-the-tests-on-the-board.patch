diff --git a/src/apps/neocam/MotionDetector.cpp b/src/apps/neocam/MotionDetector.cpp
index b5bc56c566..feb1755663 100644
--- a/src/apps/neocam/MotionDetector.cpp
+++ b/src/apps/neocam/MotionDetector.cpp
@@ -7,14 +7,23 @@
 #include "MotionDetector.h"
 
 #include <math.h>
+#include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
 
 
 // pixels sampled in each cell, across and down
 static const int32 kSamples = 4;
-// the first analyses only build the background
-static const int32 kWarmUpFrames = 10;
+// the first analyses only build the background: a camera that starts
+// streaming takes some seconds to settle its exposure and white balance
+static const int32 kWarmUpFrames = 30;
+// motion in this many analyses in a row counts
+static const int32 kPersistence = 2;
+// a change of more of the picture than this is the light's, as is one of
+// all of it by more than this gain or offset
+static const float kRelightShare = 0.7f;
+static const double kRelightGain = 0.25;
+static const double kRelightOffset = 40;
 
 
 MotionDetector::MotionDetector()
@@ -29,6 +38,7 @@ void
 MotionDetector::Reset()
 {
 	fFrames = 0;
+	fRunning = 0;
 	memset(fChanged, 0, sizeof(fChanged));
 }
 
@@ -60,7 +70,6 @@ MotionDetector::Analyze(const uint8* bits, uint32 width, uint32 height,
 		return 0;
 
 	// the cells' brightness
-	int32 total = 0;
 	for (int32 row = 0; row < kRows; row++) {
 		uint32 top = row * height / kRows;
 		uint32 cellHeight = (row + 1) * height / kRows - top;
@@ -79,9 +88,7 @@ MotionDetector::Analyze(const uint8* bits, uint32 width, uint32 height,
 						>> 8;
 				}
 			}
-			uint8 brightness = sum / (kSamples * kSamples);
-			fCurrent[row * kColumns + column] = brightness;
-			total += brightness;
+			fCurrent[row * kColumns + column] = sum / (kSamples * kSamples);
 		}
 	}
 
@@ -91,31 +98,84 @@ MotionDetector::Analyze(const uint8* bits, uint32 width, uint32 height,
 			fBackground[i] = fCurrent[i] * 16;
 	}
 
-	// the change of the whole picture is not motion
-	int32 backgroundTotal = 0;
-	for (int32 i = 0; i < cells; i++)
-		backgroundTotal += fBackground[i];
-	int32 shift = (total * 16 - backgroundTotal) / cells;
+	// a change of the whole picture (the camera's exposure, the light) is
+	// not motion: the picture as the background times a gain plus an
+	// offset, fitted over the cells that aren't clipped
+	double n = 0, sumX = 0, sumY = 0, sumXX = 0, sumXY = 0;
+	for (int32 i = 0; i < cells; i++) {
+		double x = fBackground[i] / 16.0;
+		double y = fCurrent[i];
+		if (x < 8 || x > 247 || y < 8 || y > 247)
+			continue;
+		n++;
+		sumX += x;
+		sumY += y;
+		sumXX += x * x;
+		sumXY += x * y;
+	}
+	double gain = 1;
+	double offset = 0;
+	double spread = n * sumXX - sumX * sumX;
+	if (n >= cells / 4 && spread > n * n * 25) {
+		gain = (n * sumXY - sumX * sumY) / spread;
+		if (gain < 0.5)
+			gain = 0.5;
+		else if (gain > 2)
+			gain = 2;
+		offset = (sumY - gain * sumX) / n;
+	} else if (n > 0)
+		offset = (sumY - sumX) / n;
 
 	// a step of 12 brightness levels at sensitivity 100, 52 at 1
-	int32 step = (12 + (100 - fSensitivity) * 40 / 99) * 16;
+	int32 step = 12 + (100 - fSensitivity) * 40 / 99;
 	int32 changed = 0;
 	for (int32 i = 0; i < cells; i++) {
-		int32 current = fCurrent[i] * 16;
-		int32 difference = current - fBackground[i] - shift;
-		fChanged[i] = abs(difference) > step;
+		// as the camera clips it
+		double expected = gain * fBackground[i] / 16.0 + offset;
+		expected = expected < 0 ? 0 : expected > 255 ? 255 : expected;
+		fChanged[i] = fabs(fCurrent[i] - expected) > step;
 		if (fChanged[i])
 			changed++;
+	}
+	float share = (float)changed / cells;
+
+	// most of the picture changed in a way the fit didn't catch, or the
+	// whole picture changed a lot at once (a lamp, the camera's contrast):
+	// the light changed, the background starts over
+	bool relight = share > kRelightShare || fabs(gain - 1) > kRelightGain
+		|| fabs(offset) > kRelightOffset;
 
+	for (int32 i = 0; i < cells; i++) {
+		int32 current = fCurrent[i] * 16;
+		if (relight) {
+			fBackground[i] = current;
+			continue;
+		}
 		// the background follows: quickly where it is still, slowly where
 		// something moves (something that stays becomes background within
 		// some seconds)
 		fBackground[i] += (current - fBackground[i]) / (fChanged[i] ? 32 : 8);
 	}
 
-	if (++fFrames <= kWarmUpFrames) {
+	if (getenv("NEOCAM_MOTION_DEBUG") != NULL && share > Threshold() / 3) {
+		printf("motion: %.4f (threshold %.4f), gain %.3f, offset %.1f, "
+			"%d fitted%s\n", share, Threshold(), gain, offset, (int)n,
+			relight ? ", light changed" : "");
+		fflush(stdout);
+	}
+
+	if (++fFrames <= kWarmUpFrames || relight) {
 		memset(fChanged, 0, sizeof(fChanged));
+		fRunning = 0;
 		return 0;
 	}
-	return (float)changed / cells;
+
+	// a single analysis isn't enough (a frame that came out wrong)
+	if (share >= Threshold())
+		fRunning++;
+	else
+		fRunning = 0;
+	if (fRunning < kPersistence && share >= Threshold())
+		return Threshold() * 0.99f;
+	return share;
 }
diff --git a/src/apps/neocam/MotionDetector.h b/src/apps/neocam/MotionDetector.h
