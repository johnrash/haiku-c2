diff --git a/src/apps/neocam/NeoCam.h b/src/apps/neocam/NeoCam.h
index 5d1bb52466..c5a73fa083 100644
--- a/src/apps/neocam/NeoCam.h
+++ b/src/apps/neocam/NeoCam.h
@@ -34,6 +34,7 @@ enum {
 	kMsgUploadChanged		= 'upch',
 	kMsgTestUpload			= 'tstu',
 	kMsgPulse				= 'puls',
+	kMsgStart				= 'strt',
 
 	// from the camera controller to the window
 	kMsgCameraReady			= 'crdy',	// "size" (frame sizes), "current",
@@ -41,6 +42,8 @@ enum {
 	kMsgCameraFailed		= 'cfai',	// "text"
 
 	kMsgRecordingStarted	= 'rsta',	// "status", "path", "trigger"
+	kMsgCameraReleased		= 'crel',	// after a disconnect for quitting
+	kMsgCameraWeb			= 'cweb',	// "web" (pointer, for the window)
 
 	// from the camera node to the window
 	kMsgFrameStats			= 'fsts',	// "fps"
