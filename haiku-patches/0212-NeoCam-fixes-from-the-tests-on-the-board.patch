--- a/src/apps/neocam/MotionDetector.h
+++ b/src/apps/neocam/MotionDetector.h
@@ -12,9 +12,11 @@
 /*!	Simple motion detection: the picture as a grid of cells, each the
 	average brightness of a few pixels, compared with a background that
 	follows the picture slowly. A cell whose brightness differs from the
-	background by more than a step (after taking off the change of the whole
-	picture, as when the camera adjusts its exposure) has changed; motion is
-	when more of the picture changed than the sensitivity allows.
+	background by more than a step has changed, after taking off the change
+	of the whole picture (a gain and an offset fitted to the cells, as when
+	the camera adjusts its exposure); motion is when more of the picture
+	changed than the sensitivity allows, in two analyses in a row. A change
+	of most of the picture is the light's: the background starts over.
 */
 class MotionDetector {
 public:
@@ -43,6 +45,8 @@ public:
 private:
 			int32				fSensitivity;
 			int32				fFrames;
+			int32				fRunning;
+				// analyses with motion in a row
 			int32				fBackground[kRows * kColumns];
 				// brightness * 16
 			uint8				fCurrent[kRows * kColumns];
