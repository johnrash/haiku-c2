+void
+MesonVenc::Dump()
+{
+	kprintf("meson_venc: %s, %" B_PRIu32 "x%" B_PRIu32 " format %" B_PRIu32
+		", %" B_PRIu32 " pictures, %" B_PRId32 " interrupts\n",
+		fRunning ? "running" : "stopped", fWidth, fHeight, fFormat,
+		fPictures, fInterrupts);
+	if (fRunning) {
+		kprintf("  status %" B_PRIu32 ", bytes %" B_PRIu32 ", MPSR %#"
+			B_PRIx32 "\n", _Dos(SCRATCH(ENCODER_STATUS)),
+			_Dos(HCODEC_VLC_TOTAL_BYTES), _Dos(HCODEC_MPSR));
+	}
+}
