+
+static status_t
+map_registers(const char* name, phys_addr_t base, size_t size, area_id& area,
+	volatile uint32*& registers)
+{
+	phys_addr_t page = base & ~(phys_addr_t)(B_PAGE_SIZE - 1);
+	size_t mapSize = ROUNDUP(base + size - page, B_PAGE_SIZE);
+	void* address;
+	area = map_physical_memory(name, page, mapSize, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	if (area < 0)
+		return area;
+	registers = (volatile uint32*)((addr_t)address + (base - page));
+	return B_OK;
+}
+
+
+/*!	Physically contiguous, below 4 GB (every address register has 32 bits),
+	aligned as meson_vdec's buffers (to the size up to 1 MB), cleared.
+*/
+static status_t
+allocate_buffer(const char* name, size_t size, dma_buffer& buffer,
+	bool userAccessible)
+{
+	size = ROUNDUP(size, B_PAGE_SIZE);
+	phys_size_t alignment = B_PAGE_SIZE;
+	while (alignment < size && alignment < 1024 * 1024)
+		alignment *= 2;
+
+	virtual_address_restrictions virtualRestrictions = {};
+	virtualRestrictions.address_specification = B_ANY_KERNEL_ADDRESS;
+	physical_address_restrictions physicalRestrictions = {};
+	physicalRestrictions.high_address = (phys_addr_t)1 << 32;
+	physicalRestrictions.alignment = alignment;
+	void* address;
+	buffer.area = create_area_etc(B_SYSTEM_TEAM, name, size, B_CONTIGUOUS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA
+			| (userAccessible
+				? B_READ_AREA | B_WRITE_AREA | B_CLONEABLE_AREA : 0),
+		0, 0, &virtualRestrictions, &physicalRestrictions, &address);
+	if (buffer.area < 0)
+		return buffer.area;
+	physical_entry entry;
+	get_memory_map(address, B_PAGE_SIZE, &entry, 1);
+	buffer.address = (uint8*)address;
+	buffer.physical = entry.address;
+	buffer.size = size;
+	memset(address, 0, size);
+	flush_cache_range(buffer.physical, size);
+	return B_OK;
+}
+
+
+static void
+free_buffer(dma_buffer& buffer)
+{
+	if (buffer.area >= 0)
+		delete_area(buffer.area);
+	buffer = dma_buffer();
+}
+
+
+/*!	A QP and its chroma QP (H.264's mapping, chroma_qp_index_offset 0) as
+	HCODEC_QDCT_Q_QUANT_I/P take them (§10).
+*/
+static uint32
+quant_word(uint32 qp)
+{
+	static const uint8 kChroma[] = { 29, 30, 31, 32, 32, 33, 34, 34, 35, 35,
+		36, 36, 37, 37, 37, 38, 38, 38, 39, 39, 39, 39 };
+	uint32 chroma = qp < 30 ? qp : kChroma[min_c(qp, 51) - 30];
+	return (chroma << 22) | (qp << 16) | ((chroma % 6) << 12)
+		| ((chroma / 6) << 8) | ((qp % 6) << 4) | (qp / 6);
+}
