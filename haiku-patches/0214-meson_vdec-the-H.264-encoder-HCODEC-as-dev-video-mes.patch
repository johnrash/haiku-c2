@@ -532,4 +533,116 @@ private:
 
 
 
+/*!	The DOS block's bus clock (HHI_GCLK_MPEG0's DOS bit) and the power and
+	clock registers VDEC_1, HEVC and HCODEC share (the AO domain bits,
+	HHI_VDEC_CLK_CNTL, DOS_GCLK_EN0): their read-modify-writes go under
+	gDosPowerLock, and the bus clock stays on while any of them is powered.
+*/
+extern spinlock gDosPowerLock;
+void dos_clock_acquire(volatile uint32* hhi);
+void dos_clock_release(volatile uint32* hhi);
+
+
+/*!	The H.264 encoder, HCODEC (meson_venc.cpp), published as
+	/dev/video/meson_venc/0. From docs/m48-venc-facts.md.
+*/
+class MesonVenc {
+public:
+								MesonVenc();
+								~MesonVenc();
+
+			status_t			Init(int32 irq);
+
+			status_t			Open();
+			void				Close();
+			status_t			Control(uint32 op, void* buffer,
+									size_t length);
+			void				Dump();
+
+private:
+	static	int32				_Interrupt(void* data);
+
+			status_t			_Start(meson_venc_start& start,
+									const void* userFirmware);
+			void				_Stop();
+			status_t			_Headers(meson_venc_output& output);
+			status_t			_Encode(meson_venc_encode& encode);
+
+			void				_PowerUp();
+			void				_PowerDown();
+			status_t			_LoadMicrocode(const void* userFirmware);
+			void				_StartProcessor();
+			void				_StopProcessor();
+			void				_ResetPulse(uint32 bits);
+			void				_WriteCanvases();
+			void				_SetCanvasWords();
+			void				_FullInit(uint32 frameNumber, uint32 poc);
+			void				_ProtocolInit();
+			void				_SetupInput();
+			void				_SetCommandParameters(uint32 macroblockType);
+			status_t			_Command(uint32 command, uint32 done,
+									bigtime_t timeout);
+			status_t			_CopyOut(meson_venc_output& output,
+									size_t size);
+
+			status_t			_AllocateBuffers();
+			void				_FreeBuffers();
+
+			uint32				_Dos(uint32 offset)
+									{ return fDos[offset / 4]; }
+			void				_SetDos(uint32 offset, uint32 value)
+									{ fDos[offset / 4] = value; }
+
+private:
+			area_id				fDosArea;
+			area_id				fAoArea;
+			area_id				fHhiArea;
+			volatile uint32*	fDos;
+			volatile uint32*	fAo;
+			volatile uint32*	fHhi;
+			int32				fIrq;
+
+			mutex				fLock;
+			sem_id				fDoneSem;
+			bool				fOpen;
+			bool				fRunning;
+			int32				fInterrupts;
+
+			uint32				fWidth;
+			uint32				fHeight;
+			uint32				fFormat;
+			uint32				fFlags;
+			uint32				fBytesPerRow;
+			uint32				fChromaOffset;
+			size_t				fInputSize;
+			uint32				fQp;
+			uint32				fIdrPicId;
+			uint32				fFrameNumber;
+			uint32				fPoc;
+			bool				fNeedIdr;
+			uint32				fReconstruction;
