diff --git a/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec.cpp b/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec.cpp
index 15907a83d7..2f7619fc80 100644
--- a/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec.cpp
+++ b/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec.cpp
@@ -30,6 +30,28 @@ meson_canvas_module_info* gCanvas;
 
 
 static MesonVdec* sDevice;
+static MesonVenc* sEncoder;
+
+spinlock gDosPowerLock = B_SPINLOCK_INITIALIZER;
+static int32 sDosClockUsers;
+
+
+void
+dos_clock_acquire(volatile uint32* hhi)
+{
+	InterruptsSpinLocker locker(gDosPowerLock);
+	if (sDosClockUsers++ == 0)
+		hhi[HHI_GCLK_MPEG0 / 4] |= GCLK_MPEG0_DOS;
+}
+
+
+void
+dos_clock_release(volatile uint32* hhi)
+{
+	InterruptsSpinLocker locker(gDosPowerLock);
+	if (sDosClockUsers > 0 && --sDosClockUsers == 0)
+		hhi[HHI_GCLK_MPEG0 / 4] &= ~GCLK_MPEG0_DOS;
+}
 
 
 MesonVdec::MesonVdec(device_node* node)
@@ -571,7 +593,9 @@ void
 MesonVdec::_PowerUp()
 {
 	fHhi[HHI_GCLK_MPEG1 / 4] |= GCLK_MPEG1_DOS_PARSER;
-	fHhi[HHI_GCLK_MPEG0 / 4] |= GCLK_MPEG0_DOS;
+	dos_clock_acquire(fHhi);
+
+	InterruptsSpinLocker locker(gDosPowerLock);
 	uint32 clock = fHhi[HHI_VDEC_CLK_CNTL / 4]
 		& ~(VDEC_CLK_SOURCE_MASK | VDEC_CLK_DIVIDER_MASK | VDEC_CLK_GATE);
 	fHhi[HHI_VDEC_CLK_CNTL / 4]
@@ -583,9 +607,11 @@ MesonVdec::_PowerUp()
 
 	_SetDos(DOS_SW_RESET0, 0xfffffffc);
 	_SetDos(DOS_SW_RESET0, 0);
-	_SetDos(DOS_GCLK_EN0, 0x3ff);
+	// VDEC_1's gates only: the encoder's are in the same register
+	_SetDos(DOS_GCLK_EN0, _Dos(DOS_GCLK_EN0) | 0x3ff);
 	_SetDos(DOS_MEM_PD_VDEC, 0);
 	fAo[AO_RTI_GEN_PWR_ISO0 / 4] &= ~AO_ISO_VDEC1;
+	locker.Unlock();
 	_SetDos(DOS_VDEC_MCRCC_STALL_CTRL, 0);
 	_SetDos(GCLK_EN, 0x3ff);
 	_SetDos(MDEC_PIC_DC_CTRL, _Dos(MDEC_PIC_DC_CTRL) & ~MDEC_PIC_DC_BIT31);
@@ -601,11 +627,14 @@ MesonVdec::_PowerDown()
 	_SetDos(DOS_SW_RESET0, (1 << 12) | (1 << 11));
 	_SetDos(DOS_SW_RESET0, 0);
 	(void)_Dos(DOS_SW_RESET0);
-	fAo[AO_RTI_GEN_PWR_ISO0 / 4] |= AO_ISO_VDEC1;
-	_SetDos(DOS_MEM_PD_VDEC, 0xffffffff);
-	fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] |= AO_SLEEP_VDEC1;
-	fHhi[HHI_VDEC_CLK_CNTL / 4] &= ~VDEC_CLK_GATE;
-	fHhi[HHI_GCLK_MPEG0 / 4] &= ~GCLK_MPEG0_DOS;
+	{
+		InterruptsSpinLocker locker(gDosPowerLock);
+		fAo[AO_RTI_GEN_PWR_ISO0 / 4] |= AO_ISO_VDEC1;
+		_SetDos(DOS_MEM_PD_VDEC, 0xffffffff);
+		fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] |= AO_SLEEP_VDEC1;
+		fHhi[HHI_VDEC_CLK_CNTL / 4] &= ~VDEC_CLK_GATE;
+	}
+	dos_clock_release(fHhi);
 	fHhi[HHI_GCLK_MPEG1 / 4] &= ~GCLK_MPEG1_DOS_PARSER;
 }
 
@@ -1659,6 +1688,17 @@ dump_meson_vdec(int argc, char** argv)
 }
 
 
+static int
+dump_meson_venc(int argc, char** argv)
+{
+	if (sEncoder == NULL)
+		kprintf("meson_venc: no device\n");
+	else
+		sEncoder->Dump();
+	return 0;
+}
+
+
 //	#pragma mark - driver module
 
 
@@ -1749,6 +1789,15 @@ init_driver(device_node* node, void** _cookie)
 	sDevice = device;
 	add_debugger_command("meson_vdec", &dump_meson_vdec,
 		"Shows the video decoder's state");
+
+	// the encoder: same block, its own device
+	MesonVenc* encoder = new(std::nothrow) MesonVenc;
+	if (encoder != NULL && encoder->Init(-1) == B_OK) {
+		sEncoder = encoder;
+		add_debugger_command("meson_venc", &dump_meson_venc,
+			"Shows the video encoder's state");
+	} else
+		delete encoder;
 	*_cookie = device;
 	return B_OK;
 }
@@ -1758,6 +1807,11 @@ static void
 uninit_driver(void* cookie)
 {
 	remove_debugger_command("meson_vdec", &dump_meson_vdec);
+	if (sEncoder != NULL) {
+		remove_debugger_command("meson_venc", &dump_meson_venc);
+		delete sEncoder;
+		sEncoder = NULL;
+	}
 	sDevice = NULL;
 	delete (MesonVdec*)cookie;
 }
@@ -1767,8 +1821,13 @@ static status_t
 register_child_devices(void* cookie)
 {
 	MesonVdec* device = (MesonVdec*)cookie;
-	return gDeviceManager->publish_device(device->Node(),
+	status_t status = gDeviceManager->publish_device(device->Node(),
 		"video/meson_vdec/0", DEVICE_MODULE_NAME);
+	if (status == B_OK && sEncoder != NULL) {
+		gDeviceManager->publish_device(device->Node(), "video/meson_venc/0",
+			DEVICE_MODULE_NAME);
+	}
+	return status;
 }
 
 
@@ -1793,6 +1852,15 @@ static status_t
 device_open(void* deviceCookie, const char* path, int openMode,
 	void** _cookie)
 {
+	// the encoder's device, or the decoder's
+	if (sEncoder != NULL && strstr(path, "meson_venc") != NULL) {
+		status_t status = sEncoder->Open();
+		if (status != B_OK)
+			return status;
+		*_cookie = sEncoder;
+		return B_OK;
+	}
+
 	MesonVdec* device = (MesonVdec*)deviceCookie;
 	status_t status = device->Open();
 	if (status != B_OK)
@@ -1812,7 +1880,10 @@ device_close(void* cookie)
 static status_t
 device_free(void* cookie)
 {
-	((MesonVdec*)cookie)->Close();
+	if (cookie == sEncoder)
+		sEncoder->Close();
+	else
+		((MesonVdec*)cookie)->Close();
 	return B_OK;
 }
 
@@ -1837,6 +1908,8 @@ device_write(void* cookie, off_t position, const void* buffer,
 static status_t
 device_control(void* cookie, uint32 op, void* buffer, size_t length)
 {
+	if (cookie == sEncoder)
+		return sEncoder->Control(op, buffer, length);
 	return ((MesonVdec*)cookie)->Control(op, buffer, length);
 }
 
