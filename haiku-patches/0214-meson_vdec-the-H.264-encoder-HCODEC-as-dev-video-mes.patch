+// DOS_SW_RESET1 pulses (§2.6)
+static const uint32 kResetAll = 0xffffffff;
+static const uint32 kResetPicture = 0x000341c4;
+	// every unit but the processor
+static const uint32 kResetProcessorStart = 0x00001800;
+static const uint32 kResetProcessorStop = 0x000359c4;
+
+// HCODEC's canvases (§5.4): the two reconstruction buffers (Y, chroma, the
+// chroma again as a third plane) and the input's planes
+static const uint32 kCanvasFrames[2] = { 0xe4, 0xe7 };
+static const uint32 kCanvasInput = 0xea;
+
+// the input reader's byte lanes (§6.7): field i (3 bits) names the source
+// lane of lane i. 7 - i gives the bytes in memory order; 7 - (i ^ 3) turns
+// each 4-byte pixel around (B_RGB32's B, G, R, A to the A, R, G, B the
+// RGBA mode reads, found on the board)
+static const uint32 kByteLanesMemoryOrder = 0x00053977;
+static const uint32 kByteLanesPixelSwapped = 0x00688fac;
+
+static const uint32 kInterruptVector = 77;	// GIC SPI 45, mailbox 2 (§3)
+static const size_t kMicrocodeDmaSize = 16384;	// 0x1000 words (§4.2)
+static const size_t kAssistSize = 0xc0000;
+static const size_t kBitstreamSize = 0x100000;
+static const uint32 kLog2MaxFrameNumber = 4;
+static const uint32 kInitialQp = 26;
