+MesonVenc::MesonVenc()
+	:
+	fDosArea(-1),
+	fAoArea(-1),
+	fHhiArea(-1),
+	fDos(NULL),
+	fAo(NULL),
+	fHhi(NULL),
+	fIrq(-1),
+	fDoneSem(-1),
+	fOpen(false),
+	fRunning(false),
+	fInterrupts(0),
+	fWidth(0),
+	fHeight(0),
+	fFormat(0),
+	fFlags(0),
+	fBytesPerRow(0),
+	fChromaOffset(0),
+	fInputSize(0),
+	fQp(kInitialQp),
+	fIdrPicId(0),
+	fFrameNumber(0),
+	fPoc(0),
+	fNeedIdr(true),
+	fReconstruction(0),
+	fLastEncodeTime(0),
+	fLastSize(0),
+	fPictures(0),
+	fIrqLogCount(0)
+{
+	mutex_init(&fLock, "meson_venc");
+}
+
+
+MesonVenc::~MesonVenc()
+{
+	if (fRunning)
+		_Stop();
+	_FreeBuffers();
+	if (fIrq >= 0)
+		remove_io_interrupt_handler(fIrq, &_Interrupt, this);
+	if (fDoneSem >= 0)
+		delete_sem(fDoneSem);
+	if (fDosArea >= 0)
+		delete_area(fDosArea);
+	if (fAoArea >= 0)
+		delete_area(fAoArea);
+	if (fHhiArea >= 0)
+		delete_area(fHhiArea);
+	mutex_destroy(&fLock);
+}
+
+
+status_t
+MesonVenc::Init(int32 irq)
+{
+	status_t status;
+	if ((status = map_registers("meson_venc dos", 0xc8820000, 0x10000,
+			fDosArea, fDos)) != B_OK
+		|| (status = map_registers("meson_venc ao", kAoBase, B_PAGE_SIZE,
+			fAoArea, fAo)) != B_OK
+		|| (status = map_registers("meson_venc hhi", kHhiBase, B_PAGE_SIZE,
+			fHhiArea, fHhi)) != B_OK) {
+		return status;
+	}
+
+	fDoneSem = create_sem(0, "meson_venc done");
+	if (fDoneSem < 0)
+		return fDoneSem;
+
+	// mailbox 2's short pulse: an edge (§3)
+	if (irq < 0)
+		irq = kInterruptVector;
+	arch_int_configure_io_interrupt(irq, B_EDGE_TRIGGERED,
+		B_RISING_EDGE_POLARITY);
+	if (install_io_interrupt_handler(irq, &_Interrupt, this, 0) == B_OK)
+		fIrq = irq;
+	TRACE("interrupt %" B_PRId32 "\n", fIrq);
+	return B_OK;
+}
+
+
+status_t
+MesonVenc::Open()
+{
+	MutexLocker locker(fLock);
+	if (fOpen)
+		return B_BUSY;
+	fOpen = true;
+	return B_OK;
+}
+
+
+void
+MesonVenc::Close()
+{
+	MutexLocker locker(fLock);
+	if (fRunning)
+		_Stop();
+	_FreeBuffers();
+	fOpen = false;
+}
+
+
+status_t
+MesonVenc::Control(uint32 op, void* buffer, size_t length)
+{
+	MutexLocker locker(fLock);
+
+	switch (op) {
+		case MESON_VENC_START:
+		{
+			meson_venc_start start;
+			if (length < sizeof(start) || !IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&start, buffer, sizeof(start)) != B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			status_t status = _Start(start, start.firmware);
+			if (status != B_OK)
+				return status;
+			return user_memcpy(buffer, &start, sizeof(start));
+		}
+
+		case MESON_VENC_HEADERS:
+		{
+			meson_venc_output output;
+			if (length < sizeof(output) || !IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&output, buffer, sizeof(output)) != B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			status_t status = _Headers(output);
+			if (status != B_OK)
+				return status;
+			return user_memcpy(buffer, &output, sizeof(output));
+		}
+
+		case MESON_VENC_ENCODE:
+		{
+			meson_venc_encode encode;
+			if (length < sizeof(encode) || !IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&encode, buffer, sizeof(encode)) != B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			status_t status = _Encode(encode);
+			if (status != B_OK)
+				return status;
+			return user_memcpy(buffer, &encode, sizeof(encode));
+		}
+
+		case MESON_VENC_STOP:
+			if (fRunning)
+				_Stop();
+			return B_OK;
+	}
+	return B_DEV_INVALID_IOCTL;
+}
