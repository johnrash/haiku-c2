+	locker.Unlock();
 	_SetDos(DOS_SW_RESET3, 0xffffffff);
 	spin(10);
 	_SetDos(DOS_SW_RESET3, 0);
@@ -334,12 +336,15 @@ MesonVdec::_StopHevcProcessor()
 void
 MesonVdec::_PowerDownHevc()
 {
-	fAo[AO_RTI_GEN_PWR_ISO0 / 4] |= AO_ISO_HEVC;
-	_SetDos(DOS_MEM_PD_HEVC, 0xffffffff);
-	fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] |= AO_SLEEP_HEVC;
