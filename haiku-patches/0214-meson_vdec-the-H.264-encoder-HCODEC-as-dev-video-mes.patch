+
+//	#pragma mark - interrupt
+
+
+/*static*/ int32
+MesonVenc::_Interrupt(void* data)
+{
+	MesonVenc* encoder = (MesonVenc*)data;
+	if (!encoder->fRunning)
+		return B_UNHANDLED_INTERRUPT;
+	encoder->_SetDos(HCODEC_ASSIST_MBOX2_CLR_REG, 1);
+	int32 index = atomic_add(&encoder->fIrqLogCount, 1);
+	if (index < 32) {
+		irq_entry& entry = encoder->fIrqLog[index];
+		entry.time = system_time();
+		entry.status = encoder->_Dos(SCRATCH(ENCODER_STATUS));
+		entry.bytes = encoder->_Dos(HCODEC_VLC_TOTAL_BYTES);
+	}
+	atomic_add(&encoder->fInterrupts, 1);
+	release_sem_etc(encoder->fDoneSem, 1, B_DO_NOT_RESCHEDULE);
+	return B_INVOKE_SCHEDULER;
+}
+
+
+//	#pragma mark - session
+
+
+status_t
+MesonVenc::_Start(meson_venc_start& start, const void* userFirmware)
+{
+	if (fRunning)
+		return B_BUSY;
+	if (start.firmware_size != MESON_VENC_FIRMWARE_SIZE
+		|| start.width < 16 || start.height < 16
+		|| start.width > MESON_VENC_MAX_WIDTH
+		|| start.height > MESON_VENC_MAX_HEIGHT) {
+		return B_BAD_VALUE;
+	}
+
+	fWidth = start.width;
+	fHeight = start.height;
+	fFormat = start.format;
+	fFlags = start.flags;
+
+	// the input's layout (§6.4, §6.8): its planes are read PH lines high
+	uint32 paddedWidth = align_up(fWidth, 16);
+	uint32 paddedHeight = align_up(fHeight, 16);
+	switch (fFormat) {
+		case MESON_VENC_NV12:
+		case MESON_VENC_NV21:
+			fBytesPerRow = align_up(fWidth, 32);
+			fChromaOffset = fBytesPerRow * paddedHeight;
+			fInputSize = fChromaOffset + fBytesPerRow * paddedHeight / 2;
+			break;
+		case MESON_VENC_RGB24:
+			fBytesPerRow = align_up(paddedWidth * 3, 32);
+			fChromaOffset = 0;
+			fInputSize = fBytesPerRow * paddedHeight;
+			break;
+		case MESON_VENC_RGB32:
+			fBytesPerRow = paddedWidth * 4;
+			fChromaOffset = 0;
+			fInputSize = fBytesPerRow * paddedHeight;
+			break;
+		default:
+			return B_BAD_VALUE;
+	}
+
+	status_t status = _AllocateBuffers();
+	if (status != B_OK) {
+		_FreeBuffers();
+		return status;
+	}
+
+	fQp = kInitialQp;
+	fIdrPicId = 0;
+	fFrameNumber = 0;
+	fPoc = 0;
+	fNeedIdr = true;
+	fReconstruction = 0;
+	fPictures = 0;
+	while (acquire_sem_etc(fDoneSem, 1, B_RELATIVE_TIMEOUT, 0) == B_OK)
+		;
+
+	// the session start (§11.1)
+	_PowerUp();
+	fRunning = true;
+	_WriteCanvases();
+	status = _LoadMicrocode(userFirmware);
+	if (status != B_OK) {
+		_Stop();
+		return status;
+	}
+	_FullInit(0, 0);
+	_SetCanvasWords();
+	_SetCommandParameters(0);
+	_SetDos(SCRATCH(ENCODER_STATUS), ENCODER_IDLE);
+	_SetDos(SCRATCH(FIXED_SLICE_CFG), 0);
+	_StartProcessor();
+
+	start.input = fInput.area;
+	start.input_size = fInputSize;
+	start.bytes_per_row = fBytesPerRow;
+	start.chroma_offset = fChromaOffset;
+	TRACE("started %" B_PRIu32 "x%" B_PRIu32 ", format %" B_PRIu32
+		", input %zu bytes, %" B_PRIu32 " bytes a row\n", fWidth, fHeight,
+		fFormat, fInputSize, fBytesPerRow);
+	return B_OK;
+}
+
+
+void
+MesonVenc::_Stop()
+{
+	_StopProcessor();
+	_SetDos(HCODEC_ASSIST_MBOX2_MASK, 0);
+	_PowerDown();
+	fRunning = false;
+	TRACE("stopped after %" B_PRIu32 " pictures, %" B_PRId32
+		" interrupts\n", fPictures, fInterrupts);
+}
+
+
+/*!	The SPS and the PPS (§11.2): each a command of its own, the PPS's bytes
+	after the SPS's.
+*/
+status_t
+MesonVenc::_Headers(meson_venc_output& output)
+{
+	if (!fRunning)
+		return B_NO_INIT;
+
+	_FullInit(fFrameNumber, fPoc);
+	_SetCommandParameters(0);
+	status_t status = _Command(ENCODER_SEQUENCE, ENCODER_SEQUENCE_DONE,
+		5000000);
+	if (status != B_OK)
+		return status;
+	uint32 sequenceSize = _Dos(HCODEC_VLC_TOTAL_BYTES);
+
+	_SetCommandParameters(0);
+	status = _Command(ENCODER_PICTURE, ENCODER_PICTURE_DONE, 5000000);
+	if (status != B_OK)
+		return status;
+	uint32 total = _Dos(HCODEC_VLC_TOTAL_BYTES);
+	TRACE("SPS %" B_PRIu32 " bytes, PPS %" B_PRIu32 "\n", sequenceSize,
+		total - sequenceSize);
+	return _CopyOut(output, total);
+}
+
+
+/*!	One picture from the input area (§11.3, §11.4). */
+status_t
+MesonVenc::_Encode(meson_venc_encode& encode)
+{
+	if (!fRunning)
+		return B_NO_INIT;
+	if (encode.qp > 51)
+		return B_BAD_VALUE;
+
+	bool idr = fNeedIdr || (encode.flags & MESON_VENC_IDR) != 0;
+	fQp = encode.qp;
+
+	// what the caller wrote, to memory
+	flush_cache_range(fInput.physical, fInputSize);
+
+	// the counters are written reduced (log2_max 4, §7.5)
+	uint32 mask = (1 << kLog2MaxFrameNumber) - 1;
+	_FullInit(idr ? 0 : fFrameNumber & mask, idr ? 0 : fPoc & mask);
+	_SetCanvasWords();
+	_SetupInput();
+	_SetCommandParameters(idr ? 0x00000009 : 0xffff00ff);
+
+	bigtime_t start = system_time();
+	status_t status = _Command(idr ? ENCODER_IDR : ENCODER_NON_IDR,
+		idr ? ENCODER_IDR_DONE : ENCODER_NON_IDR_DONE,
+		encode.timeout > 0 ? encode.timeout : 1000000);
+	fLastEncodeTime = system_time() - start;
+	if (status != B_OK) {
+		// the reference may be lost: the next picture starts over
+		fNeedIdr = true;
+		return status;
+	}
+	uint32 size = _Dos(HCODEC_VLC_TOTAL_BYTES);
+	fLastSize = size;
+	fPictures++;
+
+	// the counters and the reference for the next picture
+	if (idr) {
+		fIdrPicId = (fIdrPicId + 1) & 0xffff;
+		fFrameNumber = 1;
+		fPoc = 2;
+		fNeedIdr = false;
+	} else {
+		fFrameNumber++;
+		fPoc += 2;
+	}
+	fReconstruction ^= 1;
+
+	encode.idr = idr;
+	encode.encode_time = fLastEncodeTime;
+	return _CopyOut(encode.output, size);
+}
+
+
+//	#pragma mark - hardware sequences
+
+
+/*!	§2.4, under the lock VDEC_1 and HEVC take for the registers they share
+	with HCODEC.
+*/
+void
+MesonVenc::_PowerUp()
+{
+	dos_clock_acquire(fHhi);
+	{
+		InterruptsSpinLocker locker(gDosPowerLock);
+		fAo[AO_RTI_PWR_CNTL_REG0 / 4] &= ~AO_PWR_CNTL_HCODEC;
+		spin(10);
+		fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] &= ~AO_SLEEP_HCODEC;
+		spin(10);
+		_SetDos(DOS_SW_RESET1, kResetAll);
+		_SetDos(DOS_SW_RESET1, 0);
+		fHhi[HHI_VDEC_CLK_CNTL / 4] = (fHhi[HHI_VDEC_CLK_CNTL / 4]
+			& ~HCODEC_CLOCK_MASK) | HCODEC_CLOCK_500MHZ;
+		_SetDos(DOS_GCLK_EN0, _Dos(DOS_GCLK_EN0) | HCODEC_GCLK_MASK);
+		_SetDos(DOS_MEM_PD_HCODEC, 0);
+		fAo[AO_RTI_GEN_PWR_ISO0 / 4] &= ~AO_ISO_HCODEC;
+		spin(10);
+		_SetDos(DOS_GEN_CTRL0, _Dos(DOS_GEN_CTRL0) | 1);
+		_SetDos(DOS_GEN_CTRL0, _Dos(DOS_GEN_CTRL0) & ~1);
+	}
+	snooze(10000);
+}
+
+
+/*!	§2.5. */
+void
+MesonVenc::_PowerDown()
+{
+	{
+		InterruptsSpinLocker locker(gDosPowerLock);
+		fAo[AO_RTI_GEN_PWR_ISO0 / 4] |= AO_ISO_HCODEC;
+		_SetDos(DOS_MEM_PD_HCODEC, 0xffffffff);
+		_SetDos(DOS_GCLK_EN0, _Dos(DOS_GCLK_EN0) & ~HCODEC_GCLK_MASK);
+		fHhi[HHI_VDEC_CLK_CNTL / 4] &= ~HCODEC_CLOCK_GATE;
+		fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] |= AO_SLEEP_HCODEC;
+	}
+	dos_clock_release(fHhi);
+}
+
+
+/*!	§4.3: the image, zero-padded to 16 KB, into the processor's instruction
+	memory by DMA.
+*/
+status_t
+MesonVenc::_LoadMicrocode(const void* userFirmware)
+{
+	if (!IS_USER_ADDRESS(userFirmware)
+		|| user_memcpy(fMicrocode.address, userFirmware,
+			MESON_VENC_FIRMWARE_SIZE) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	memset(fMicrocode.address + MESON_VENC_FIRMWARE_SIZE, 0,
+		kMicrocodeDmaSize - MESON_VENC_FIRMWARE_SIZE);
+	flush_cache_range(fMicrocode.physical, kMicrocodeDmaSize);
+
+	_SetDos(HCODEC_ASSIST_MMC_CTRL1, 0x32);
+	_SetDos(HCODEC_MPSR, 0);
+	_SetDos(HCODEC_CPSR, 0);
+	(void)_Dos(HCODEC_MPSR);
+	(void)_Dos(HCODEC_MPSR);
+	_SetDos(HCODEC_IMEM_DMA_ADR, fMicrocode.physical);
+	_SetDos(HCODEC_IMEM_DMA_COUNT, kMicrocodeDmaSize / 4);
+	_SetDos(HCODEC_IMEM_DMA_CTRL, 0x00078000);
+	bigtime_t timeout = system_time() + 1000000;
+	while ((_Dos(HCODEC_IMEM_DMA_CTRL) & (1 << 15)) != 0) {
+		if (system_time() > timeout) {
+			TRACE("the microcode DMA does not finish\n");
+			return B_TIMED_OUT;
+		}
+		snooze(100);
+	}
+	return B_OK;
+}
+
+
+void
+MesonVenc::_ResetPulse(uint32 bits)
+{
+	for (int i = 0; i < 3; i++)
+		(void)_Dos(DOS_SW_RESET1);
+	_SetDos(DOS_SW_RESET1, bits);
+	_SetDos(DOS_SW_RESET1, 0);
+	for (int i = 0; i < 3; i++)
+		(void)_Dos(DOS_SW_RESET1);
+}
+
+
+void
+MesonVenc::_StartProcessor()
+{
+	_ResetPulse(kResetProcessorStart);
+	_SetDos(HCODEC_MPSR, 1);
+}
+
+
+void
+MesonVenc::_StopProcessor()
+{
+	_SetDos(HCODEC_MPSR, 0);
+	_SetDos(HCODEC_CPSR, 0);
+	bigtime_t timeout = system_time() + 1000000;
+	while ((_Dos(HCODEC_IMEM_DMA_CTRL) & (1 << 15)) != 0
+		&& system_time() < timeout) {
+		spin(10);
+	}
+	_ResetPulse(kResetProcessorStop);
+}
+
+
+/*!	The reconstruction buffers' canvases (§5.4): linear, without a byte
+	swap (the input reader swaps by itself, §6.7).
+*/
+void
+MesonVenc::_WriteCanvases()
+{
+	uint32 width = align_up(fWidth, 32);
+	uint32 height = align_up(fHeight, 16);
+	for (int i = 0; i < 2; i++) {
+		phys_addr_t luma = fFrames[i].physical;
+		phys_addr_t chroma = luma + width * height;
+		gCanvas->write(kCanvasFrames[i], luma, width, height, 0);
+		gCanvas->write(kCanvasFrames[i] + 1, chroma, width, height / 2, 0);
+		gCanvas->write(kCanvasFrames[i] + 2, chroma, width, height / 2, 0);
+	}
+}
+
+
+/*!	The picture written next and its reference, the one written before
+	(§7.5).
+*/
+void
+MesonVenc::_SetCanvasWords()
+{
+	uint32 reconstruction = kCanvasFrames[fReconstruction];
+	uint32 reference = kCanvasFrames[fReconstruction ^ 1];
+	uint32 reconstructionWord = reconstruction | ((reconstruction + 1) << 8)
+		| ((reconstruction + 2) << 16);
+	uint32 referenceWord = reference | ((reference + 1) << 8)
+		| ((reference + 2) << 16);
+	_SetDos(HCODEC_REC_CANVAS_ADDR, reconstructionWord);
+	_SetDos(HCODEC_DBKR_CANVAS_ADDR, reconstructionWord);
+	_SetDos(HCODEC_DBKW_CANVAS_ADDR, reconstructionWord);
+	_SetDos(HCODEC_ANC0_CANVAS_ADDR, referenceWord);
+	_SetDos(HCODEC_VLC_HCMD_CONFIG, 0);
+}
+
+
+/*!	What precedes every command but the PPS (§11.3 steps 1-7): every unit
+	reset and programmed again.
+*/
+void
+MesonVenc::_FullInit(uint32 frameNumber, uint32 poc)
+{
+	_ResetPulse(kResetPicture);
+	_WriteCanvases();
+
+	// the encoder (§11.3 step 3)
+	_SetDos(HCODEC_VLC_TOTAL_BYTES, 0);
+	_SetDos(HCODEC_VLC_CONFIG, 0x07);
+	_SetDos(HCODEC_VLC_INT_CONTROL, 0);
+	_SetDos(HCODEC_ASSIST_AMR1_INT0, 0x15);
+	_SetDos(HCODEC_ASSIST_AMR1_INT1, 0x08);
+	_SetDos(HCODEC_ASSIST_AMR1_INT3, 0x14);
+	_SetDos(SCRATCH(IDR_PIC_ID), fIdrPicId);
+	_SetDos(SCRATCH(FRAME_NUMBER), frameNumber);
+	_SetDos(SCRATCH(PIC_ORDER_CNT_LSB), poc);
+	_SetDos(SCRATCH(LOG2_MAX_POC_LSB), kLog2MaxFrameNumber);
+	_SetDos(SCRATCH(LOG2_MAX_FRAME_NUM), kLog2MaxFrameNumber);
+	_SetDos(SCRATCH(ANC0_BUFFER_ID), 0);
+	_SetDos(SCRATCH(QP_PICTURE), kInitialQp);
+
+	// the QDCT's buffer, unused in this mode, on the input (§5.3)
+	uint32 input = fInput.physical;
+	_SetDos(HCODEC_QDCT_MB_START_PTR, input);
+	_SetDos(HCODEC_QDCT_MB_END_PTR, input + fInput.size - 1);
+	_SetDos(HCODEC_QDCT_MB_WR_PTR, input);
+	_SetDos(HCODEC_QDCT_MB_RD_PTR, input);
+	_SetDos(HCODEC_QDCT_MB_BUFF, 0);
+
+	// the bitstream (§11.3 step 5)
+	uint32 bitstream = fBitstream.physical;
+	_SetDos(HCODEC_VLC_VB_MEM_CTL, 0xbf200002);
+	_SetDos(HCODEC_VLC_VB_START_PTR, bitstream);
+	_SetDos(HCODEC_VLC_VB_WR_PTR, bitstream);
+	_SetDos(HCODEC_VLC_VB_SW_RD_PTR, bitstream);
+	_SetDos(HCODEC_VLC_VB_END_PTR, bitstream + kBitstreamSize - 1);
+	_SetDos(HCODEC_VLC_VB_CONTROL, 1);
+	_SetDos(HCODEC_VLC_VB_CONTROL, 0x3a);
+
+	_ProtocolInit();
+	_SetDos(SCRATCH(MEM_OFFSET), fAssist.physical);
+}
+
+
+/*!	§9.2, in the vendor's order, with one QP for the whole picture (§10). */
+void
+MesonVenc::_ProtocolInit()
+{
+	uint32 macroblockColumns = (fWidth + 15) / 16;
+	_SetDos(HCODEC_HDEC_MC_OMEM_AUTO,
+		(1u << 31) | ((macroblockColumns - 1) << 16));
+	_SetDos(HCODEC_VLC_ADV_CONFIG, 0x0000033e);
+	_SetDos(HCODEC_QDCT_ADV_CONFIG, 0x3f6c577f);
+	_SetDos(HCODEC_IE_WEIGHT, 0x33203655);
+	_SetDos(HCODEC_ME_WEIGHT, 0x00003320);
+	_SetDos(HCODEC_SAD_CONTROL_0, 0x33203655);
+	_SetDos(HCODEC_SAD_CONTROL_1, 0x01113320);
+	_SetDos(HCODEC_ADV_MV_CTL0, 0xf0003000);
+	_SetDos(HCODEC_ADV_MV_CTL1, 0x0000a000);
+
+	// the quant tables (I4, I16, ME), all of the one QP
+	for (uint32 table = 0; table < 3; table++) {
+		_SetDos(HCODEC_Q_QUANT_CONTROL, ((table * 8) << 23) | (1 << 22));
+		for (int word = 0; word < 8; word++)
+			_SetDos(HCODEC_QUANT_TABLE_DATA, fQp * 0x01010101);
+	}
+	_SetDos(HCODEC_QDCT_VLC_QUANT_CTL_0, (fQp << 13) | fQp);
+	_SetDos(HCODEC_QDCT_VLC_QUANT_CTL_1, 0x00000699);
+
+	_SetDos(HCODEC_VLC_PIC_SIZE, fWidth | (fHeight << 16));
+	_SetDos(HCODEC_VLC_PIC_POSITION, 0);
+	_SetDos(HCODEC_QDCT_Q_QUANT_I, quant_word(fQp));
+	_SetDos(HCODEC_QDCT_Q_QUANT_P, quant_word(fQp));
+	_SetDos(HCODEC_IGNORE_CONFIG, 0x84228423);
+	_SetDos(HCODEC_IGNORE_CONFIG_2, 0x84250000);
+	_SetDos(HCODEC_QDCT_MB_CONTROL, 0x00000201);
+	_SetDos(HCODEC_QDCT_MB_CONTROL, 0x301e7400);
+	_SetDos(HCODEC_SAD_CONTROL, 0x00000005);
+	_SetDos(HCODEC_IE_RESULT_BUFFER, 0);
+	_SetDos(HCODEC_SAD_CONTROL, 0x0000000a);
+	_SetDos(HCODEC_IE_CONTROL, 0x40000001);
+	_SetDos(HCODEC_IE_CONTROL, 0x40000000);
+	_SetDos(HCODEC_ME_SKIP_LINE, 0x08202000);
+
+	// motion search (§9.1)
+	_SetDos(HCODEC_ME_MV_MERGE_CTL, 0xff4ab080);
+	_SetDos(HCODEC_ME_STEP0_CLOSE_MV, 0x00040042);
+	_SetDos(HCODEC_ME_SAD_ENOUGH_01, 0x00004000);
+	_SetDos(HCODEC_ME_SAD_ENOUGH_23, 0x00020011);
+	_SetDos(HCODEC_ME_F_SKIP_SAD, 0x00203030);
+	_SetDos(HCODEC_ME_F_SKIP_WEIGHT, 0x00040404);
+	_SetDos(HCODEC_ME_MV_WEIGHT_01, 0);
+	_SetDos(HCODEC_ME_MV_WEIGHT_23, 0);
+	_SetDos(HCODEC_ME_SAD_RANGE_INC, 0);
+
+	_SetDos(HCODEC_IE_DATA_FEED_BUFF_INFO, 0);
+	_SetDos(HCODEC_CURR_CANVAS_CTRL, 0);
+	_SetDos(HCODEC_VLC_CONFIG, _Dos(HCODEC_VLC_CONFIG) | 1);
+	_SetDos(SCRATCH(INFO_DUMP_START), fDump.physical);
+	_SetDos(HCODEC_ASSIST_MBOX2_CLR_REG, 1);
+	_SetDos(HCODEC_ASSIST_MBOX2_MASK, 1);
+}
+
+
+/*!	The input reader (§6.4), in the vendor's order: the canvases, the noise
+	reduction, then the format and the size.
+*/
+void
+MesonVenc::_SetupInput()
+{
+	uint32 paddedWidth = align_up(fWidth, 16);
+	uint32 paddedHeight = align_up(fHeight, 16);
+	phys_addr_t input = fInput.physical;
+	bool noiseReduction = (fFlags & MESON_VENC_NOISE_REDUCTION) != 0;
+
+	uint32 format = 0;
+	uint32 canvases = 0;
+	uint32 linear0 = 0;
+	uint32 linear1 = 0;
+	uint32 byteLanes = kByteLanesMemoryOrder;
+	switch (fFormat) {
+		case MESON_VENC_NV12:
+		case MESON_VENC_NV21:
+			gCanvas->write(kCanvasInput, input, fBytesPerRow, paddedHeight,
+				0);
+			gCanvas->write(kCanvasInput + 1, input + fChromaOffset,
+				fBytesPerRow, paddedHeight / 2, 0);
+			format = fFormat == MESON_VENC_NV12 ? 3 : 2;
+			canvases = 0x15000000 | ((kCanvasInput + 1) << 8)
+				| kCanvasInput;
+			break;
+		case MESON_VENC_RGB24:
+			gCanvas->write(kCanvasInput, input, fBytesPerRow, paddedHeight,
+				0);
+			// 4:4:4, downsampled, converted
+			format = 1 | (1 << 6) | (1 << 12) | (1 << 13);
+			canvases = 0x17000000 | kCanvasInput;
+			break;
+		case MESON_VENC_RGB32:
+			// linear, 4 bytes a pixel (the vendor's width times 3,
+			// §6.9, is wrong): the hardware reads A, R, G, B
+			format = 12 | (1 << 6) | (1 << 12) | (1 << 13);
+			canvases = 0x15000000;
+			linear0 = (3 << 16) | fBytesPerRow;
+			linear1 = input;
+			byteLanes = kByteLanesPixelSwapped;
+			break;
+	}
+
+	// the noise reduction (§6.6): its values, the enable bits per setting
+	static const uint32 kLuma[] = { 0xfc07bf12, 0x001fe40a, 0x08040544,
+		0x2020140a, 0x000fc018 };
+	static const uint32 kChroma[] = { 0xfc07bf10, 0x001fe40a, 0x08040544,
+		0x2020140a, 0x000fc018 };
+	for (int i = 0; i < 5; i++) {
+		uint32 enable = noiseReduction && i == 0 ? 1 : 0;
+		uint32 lumaEnable = noiseReduction && i < 2 ? 1 : 0;
+		_SetDos(HCODEC_MFDIN_REG0D + 4 * i, kLuma[i] | lumaEnable);
+		_SetDos(HCODEC_MFDIN_REG0D + 4 * (5 + i), kChroma[i] | enable);
+	}
+
+	_SetDos(HCODEC_MFDIN_REG1_CTRL,
+		format | (noiseReduction ? 1 << 19 : 0));
+	_SetDos(HCODEC_MFDIN_REG8_DMBL, (paddedWidth << 14) | paddedHeight);
+	_SetDos(HCODEC_MFDIN_REG3_CANV, canvases);
+	_SetDos(HCODEC_MFDIN_REG4_LNR0, linear0);
+	_SetDos(HCODEC_MFDIN_REG5_LNR1, linear1);
+	_SetDos(HCODEC_MFDIN_REG9_ENDN, byteLanes);
+}
+
+
+/*!	The macroblock types the hardware may choose (§7.3), one slice. */
+void
+MesonVenc::_SetCommandParameters(uint32 macroblockType)
+{
+	_SetDos(SCRATCH(IE_ME_MODE), 0x0c);
+	_SetDos(SCRATCH(IE_REF_SEL), 0);
+	_SetDos(SCRATCH(IE_ME_MB_TYPE), macroblockType);
+	_SetDos(SCRATCH(FIXED_SLICE_CFG), 0);
+	_SetDos(SCRATCH(FIXED_SLICE_CFG), 0);
+}
+
+
+/*!	Writes the command (the microcode reads the register) and waits for
+	the done value. The mailbox interrupt wakes the wait; without it, the
+	register is looked at every 2 ms anyway.
+*/
+status_t
+MesonVenc::_Command(uint32 command, uint32 done, bigtime_t timeout)
+{
+	while (acquire_sem_etc(fDoneSem, 1, B_RELATIVE_TIMEOUT, 0) == B_OK)
+		;
+	fIrqLogCount = 0;
+	bigtime_t begin = system_time();
+	_SetDos(SCRATCH(ENCODER_STATUS), command);
+
+	bigtime_t end = begin + timeout;
+	status_t result = B_OK;
+	while (true) {
+		acquire_sem_etc(fDoneSem, 1, B_RELATIVE_TIMEOUT, 2000);
+		uint32 status = _Dos(SCRATCH(ENCODER_STATUS));
+		// GXBB's microcode answers a P picture with IDR_DONE too (as the
+		// vendor driver, which takes any done value, never noticed); the
+		// 5 it reports (and interrupts with) on the way is the slice
+		// header written
+		if (status == done || (done == ENCODER_NON_IDR_DONE
+				&& status == ENCODER_IDR_DONE)) {
+			break;
+		}
+		if (system_time() > end) {
+			TRACE("command %" B_PRIu32 " not done: status %" B_PRIu32
+				", %" B_PRIu32 " bytes, MPSR %#" B_PRIx32 "\n", command,
+				status, _Dos(HCODEC_VLC_TOTAL_BYTES), _Dos(HCODEC_MPSR));
+			result = B_TIMED_OUT;
+			break;
+		}
+	}
+	if (result != B_OK) {
+		int32 count = min_c(fIrqLogCount, 32);
+		for (int32 i = 0; i < count; i++) {
+			TRACE("  command %" B_PRIu32 ": interrupt at %" B_PRId64
+				" us: status %" B_PRIu32 ", %" B_PRIu32 " bytes\n", command,
+				fIrqLog[i].time - begin, fIrqLog[i].status,
+				fIrqLog[i].bytes);
+		}
+	}
+	return result;
+}
+
+
+status_t
+MesonVenc::_CopyOut(meson_venc_output& output, size_t size)
+{
+	if (size > kBitstreamSize)
+		return B_BAD_DATA;
+	if (size > output.buffer_size)
+		return B_BUFFER_OVERFLOW;
+	flush_cache_range(fBitstream.physical, size);
+	if (!IS_USER_ADDRESS(output.buffer)
+		|| user_memcpy(output.buffer, fBitstream.address, size) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	output.size = size;
+	return B_OK;
+}
+
+
+status_t
+MesonVenc::_AllocateBuffers()
+{
+	_FreeBuffers();
+
+	uint32 width = align_up(fWidth, 32);
+	uint32 height = align_up(fHeight, 16);
+	size_t frameSize = width * height * 3 / 2;
+	uint32 macroblocks = ((fWidth + 15) / 16) * ((fHeight + 15) / 16);
+
+	status_t status;
+	if ((status = allocate_buffer("meson_venc microcode", kMicrocodeDmaSize,
+			fMicrocode, false)) != B_OK
+		|| (status = allocate_buffer("meson_venc input", fInputSize, fInput,
+			true)) != B_OK
+		|| (status = allocate_buffer("meson_venc frame", frameSize,
+			fFrames[0], false)) != B_OK
+		|| (status = allocate_buffer("meson_venc frame", frameSize,
+			fFrames[1], false)) != B_OK
+		|| (status = allocate_buffer("meson_venc assist", kAssistSize,
+			fAssist, false)) != B_OK
+		|| (status = allocate_buffer("meson_venc bitstream", kBitstreamSize,
+			fBitstream, false)) != B_OK
+		|| (status = allocate_buffer("meson_venc dump", macroblocks * 80,
+			fDump, false)) != B_OK) {
+		TRACE("buffers: %s\n", strerror(status));
+		return status;
+	}
+	return B_OK;
+}
+
+
+void
+MesonVenc::_FreeBuffers()
+{
+	free_buffer(fMicrocode);
+	free_buffer(fInput);
+	free_buffer(fFrames[0]);
+	free_buffer(fFrames[1]);
+	free_buffer(fAssist);
+	free_buffer(fBitstream);
+	free_buffer(fDump);
+}
