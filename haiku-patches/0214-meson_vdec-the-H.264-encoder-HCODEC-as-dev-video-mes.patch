 #endif	// MESON_VDEC_PRIVATE_H
diff --git a/src/add-ons/kernel/drivers/video/meson_vdec/meson_venc.cpp b/src/add-ons/kernel/drivers/video/meson_vdec/meson_venc.cpp
new file mode 100644
index 0000000000..25784b0bf8
--- /dev/null
+++ b/src/add-ons/kernel/drivers/video/meson_vdec/meson_venc.cpp
@@ -0,0 +1,1075 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * meson_venc: the S905's H.264 encoder, HCODEC, written from
+ * docs/m48-venc-facts.md (the facts of Amlogic's vendor driver; section
+ * numbers below are that document's). Amlogic's microcode runs the picture:
+ * the CPU powers the block, loads the microcode, and before each command
+ * programs every unit (the vendor's "full mode" on GXBB), writes the command
+ * into a scratch register and waits for the done value and the interrupt.
+ */
+
+
+#include "meson_vdec_private.h"
+
+
