+	ENCODER_IDLE			= 0,
+	ENCODER_SEQUENCE		= 1,
+	ENCODER_PICTURE			= 2,
+	ENCODER_IDR				= 3,
+	ENCODER_NON_IDR			= 4,
+	ENCODER_SEQUENCE_DONE	= 7,
+	ENCODER_PICTURE_DONE	= 8,
+	ENCODER_IDR_DONE		= 9,
+	ENCODER_NON_IDR_DONE	= 10,
