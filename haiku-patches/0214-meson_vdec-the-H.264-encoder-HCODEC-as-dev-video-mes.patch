+		fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] |= AO_SLEEP_HEVC;
+		fHhi[HHI_VDEC2_CLK_CNTL / 4] &= ~(1u << 24);
+	}
 	_SetDos(DOS_GEN_CTRL0, 0);
-	fHhi[HHI_GCLK_MPEG0 / 4] &= ~GCLK_MPEG0_DOS;
+	dos_clock_release(fHhi);
