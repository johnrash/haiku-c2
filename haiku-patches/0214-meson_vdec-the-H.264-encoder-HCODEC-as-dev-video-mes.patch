 #define MESON_CANVAS_MODULE_NAME	"generic/meson_canvas/v1"
diff --git a/headers/private/drivers/meson_venc.h b/headers/private/drivers/meson_venc.h
new file mode 100644
index 0000000000..b65ee4da50
--- /dev/null
+++ b/headers/private/drivers/meson_venc.h
@@ -0,0 +1,86 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _MESON_VENC_H
+#define _MESON_VENC_H
+
+
+#include <Drivers.h>
+
+
+/*!	The Amlogic S905's (Meson GXBB) H.264 encoder (HCODEC), meson_vdec's
+	second device: /dev/video/meson_venc/0. One session at a time, for
+	pictures of one size and format: start it with Amlogic's microcode
+	(meson_venc_firmware's h264_enc_mc_gx.bin), take the stream's parameter
+	sets (HEADERS: the SPS and the PPS), then for each picture write it into
+	the input area START gives (cloned by the caller) and ENCODE it. The
+	output is H.264 in Annex B form, I and P pictures with one reference.
+*/
+
+#define MESON_VENC_DEVICE			"/dev/video/meson_venc/0"
+#define MESON_VENC_FIRMWARE_SIZE	8280
+#define MESON_VENC_MAX_WIDTH		1920
+#define MESON_VENC_MAX_HEIGHT		1088
+
+enum {
+	MESON_VENC_START = B_DEVICE_OP_CODES_END + 0x100,
+		// meson_venc_start
+	MESON_VENC_HEADERS,
+		// meson_venc_output: the SPS and the PPS
+	MESON_VENC_ENCODE,
+		// meson_venc_encode: the picture in the input area
+	MESON_VENC_STOP,
+		// no data: ends the session (closing the device does too)
+};
+
+// the input: the layout in the input area
+enum {
+	MESON_VENC_NV12 = 1,
+		// Y (bytes_per_row as START gives), then CbCr at chroma_offset,
+		// half the height
+	MESON_VENC_NV21 = 2,
+		// as NV12, CrCb
+	MESON_VENC_RGB24 = 3,
+		// packed, 3 bytes a pixel
+	MESON_VENC_RGB32 = 4,
+		// B_RGB32: B, G, R, A in memory (the hardware reads A, R, G, B: the
+		// bytes of each pixel are turned around on the way)
+};
+
+#define MESON_VENC_NOISE_REDUCTION	0x1
+	// the input reader's spatial and temporal noise reduction
+
+struct meson_venc_start {
+	const void*		firmware;		// in: MESON_VENC_FIRMWARE_SIZE bytes
+	size_t			firmware_size;	// in
+	uint32			width;			// in: at most MESON_VENC_MAX_*
+	uint32			height;			// in
+	uint32			format;			// in: MESON_VENC_*
+	uint32			flags;			// in: MESON_VENC_NOISE_REDUCTION
+	area_id			input;			// out: the input picture's area
+	size_t			input_size;		// out: its size
+	uint32			bytes_per_row;	// out: of the picture (and of CbCr)
+	uint32			chroma_offset;	// out: NV12/NV21: CbCr's start
+};
+
+struct meson_venc_output {
+	void*			buffer;			// in: where the bytes go
+	size_t			buffer_size;	// in
+	size_t			size;			// out: the bytes written
+};
+
+#define MESON_VENC_IDR				0x1
+	// an IDR picture (the first one is one anyway)
+
+struct meson_venc_encode {
+	uint32			flags;			// in: MESON_VENC_IDR
+	uint32			qp;				// in: the quantiser, 0-51
+	bigtime_t		timeout;		// in: relative
+	struct meson_venc_output output;
+	uint32			idr;			// out: it is an IDR picture
+	bigtime_t		encode_time;	// out: the hardware's time for it
+};
+
+
+#endif	// _MESON_VENC_H
