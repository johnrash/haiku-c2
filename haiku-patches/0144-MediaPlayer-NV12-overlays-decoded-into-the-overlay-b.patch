+/*!	The size of a frame in the connected format: B_NV12's CbCr plane
+	follows its Y plane.
+*/
+size_t
+VideoProducer::_FrameSize() const
+{
+	size_t lines = fConnectedFormat.display.line_count;
+	if (fConnectedFormat.display.format == B_NV12)
+		lines += (lines + 1) / 2;
+	return (size_t)fConnectedFormat.display.bytes_per_row * lines;
+}
