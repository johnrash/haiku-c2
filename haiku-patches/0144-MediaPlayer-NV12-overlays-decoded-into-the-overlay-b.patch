-/*!	Whether to have the video decoded to B_YCbCr422 instead of B_RGB32:
-	if it is planar YUV, which the decoders do not give, and the graphics
-	hardware can show B_YCbCr422 as an overlay, but not B_RGB32 (the Amlogic
-	VPU's video layer, for one). The overlay then does the scaling and the
-	conversion to RGB.
+/*!	Whether to have the video decoded to YCbCr (B_NV12 or B_YCbCr422)
+	instead of B_RGB32: if it is planar YUV, which the decoders do not give,
+	and the graphics hardware can show YCbCr as an overlay, but not B_RGB32
+	(the Amlogic VPU's video layer, for one). The overlay then does the
+	scaling and the conversion to RGB.
 */
 bool
-Controller::_OverlayNeedsYCbCr422() const
+Controller::_OverlayNeedsYCbCr() const
 {
 	media_format encoded;
 	if (fVideoTrackSupplier->GetEncodedFormat(&encoded) != B_OK)
@@ -259,14 +259,18 @@ Controller::_OverlayNeedsYCbCr422() const
 			return false;
 	}
 
-	uint32 flags = 0;
-	if (!bitmaps_support_space(B_YCbCr422, &flags)
-		|| (flags & B_BITMAPS_SUPPORT_OVERLAY) == 0) {
+	if (!_OverlaySupports(B_NV12) && !_OverlaySupports(B_YCbCr422))
 		return false;
-	}
-	flags = 0;
-	return !bitmaps_support_space(B_RGB32, &flags)
-		|| (flags & B_BITMAPS_SUPPORT_OVERLAY) == 0;
+	return !_OverlaySupports(B_RGB32);
+}
+
+
+/*static*/ bool
+Controller::_OverlaySupports(color_space space)
+{
+	uint32 flags = 0;
+	return bitmaps_support_space(space, &flags)
+		&& (flags & B_BITMAPS_SUPPORT_OVERLAY) != 0;
 }
 
 
@@ -363,20 +367,31 @@ Controller::SetTo(const PlaylistItemRef& item)
 		const media_format& format = fVideoTrackSupplier->Format();
 		preferredVideoFormat = format.u.raw_video.display.format;
 		if (useOverlays && preferredVideoFormat == B_RGB32
-			&& _OverlayNeedsYCbCr422()) {
+			&& _OverlayNeedsYCbCr()) {
 			// Switch the decoder now, to the overlay's row stride: doing it
 			// at the first frame takes long enough (more than a second for
 			// H.264) to lose the frames up to the next keyframe. NodeManager
 			// falls back to B_RGB32 if there is no overlay after all.
+			// B_NV12 first: a decoder of 4:2:0 video only copies it; then
+			// B_YCbCr422, for overlays or decoders without B_NV12.
+			static const color_space kSpaces[] = { B_NV12, B_YCbCr422 };
 			BRect bounds(0, 0, width - 1, height - 1);
-			BBitmap probe(bounds, B_BITMAP_WILL_OVERLAY, B_YCbCr422);
-			uint32 bytesPerRow
-				= probe.InitCheck() == B_OK ? probe.BytesPerRow() : 0;
-			if (fVideoTrackSupplier->SwitchFormat(B_YCbCr422, bytesPerRow)
-					== B_OK
-				&& fVideoTrackSupplier->Format().u.raw_video.display.format
-					== B_YCbCr422) {
-				preferredVideoFormat = B_YCbCr422;
+			for (size_t i = 0; i < B_COUNT_OF(kSpaces); i++) {
+				if (!_OverlaySupports(kSpaces[i]))
+					continue;
+				uint32 bytesPerRow = 0;
+				{
+					BBitmap probe(bounds, B_BITMAP_WILL_OVERLAY, kSpaces[i]);
+					if (probe.InitCheck() == B_OK)
+						bytesPerRow = probe.BytesPerRow();
+				}
+				if (fVideoTrackSupplier->SwitchFormat(kSpaces[i], bytesPerRow)
+						== B_OK
+					&& fVideoTrackSupplier->Format().u.raw_video.display
+						.format == kSpaces[i]) {
+					preferredVideoFormat = kSpaces[i];
+					break;
+				}
 			}
 		}
 	}
