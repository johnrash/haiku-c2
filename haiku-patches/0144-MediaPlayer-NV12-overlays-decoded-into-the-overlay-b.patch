+/*static*/ uint32
+MediaTrackVideoSupplier::_MinBytesPerRow(color_space format, uint32 width)
+{
+	switch (format) {
+		case B_NV12:
+			// the Y plane's rows (the CbCr plane's are as long)
+			return (width + 1) & ~1u;
+		case B_YCbCr422:
+			return ((width * 2 + 3) / 4) * 4;
+		default:
+			return width * 4;
+	}
+}
