+/*!	A buffer of at least \a size from an earlier session, or a new one: a
+	session (after each seek of the caller) shouldn't take the time to find
+	tens of megabytes of contiguous memory. With \a clear, a buffer kept is
+	cleared as a new one is.
+*/
+status_t
+MesonVdec::_KeepBuffer(const char* name, size_t size, dma_buffer& buffer,
+	bool userReadable, bool clear)
+{
+	if (buffer.area >= 0 && buffer.size >= size) {
+		if (clear) {
+			memset(buffer.address, 0, size);
+			flush_cache_range(buffer.physical, size);
+		}
+		return B_OK;
+	}
+	_FreeBuffer(buffer);
+	return _AllocateBuffer(name, size, buffer, userReadable);
+}
