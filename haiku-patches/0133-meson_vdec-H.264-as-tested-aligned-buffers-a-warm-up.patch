+/*!	The first H.264 session after boot decodes the first macroblock's luma
+	of its first picture wrongly (brighter, a corner garbled), and through
+	intra prediction and the frames referring to it, every picture up to
+	the next IDR picture. (MPEG-1/2's first session gets its first
+	macroblock wrong too, PLAN.md M26.) After a session that decoded a
+	16x16 picture, the decoder is right until the next boot: so the first
+	H.264 session starts with such a session of its own.
+*/
+void
+MesonVdec::_WarmUp(const meson_vdec_start& start, const void* userFirmware)
+{
+	meson_vdec_start warmUp = start;
+	if (_StartSession(warmUp, userFirmware) != B_OK)
+		return;
+	memcpy(fInput.address, kH264EndOfStream, sizeof(kH264EndOfStream));
+	_Submit(sizeof(kH264EndOfStream), true);
+	// until the firmware got its frames and decoded the picture
+	bigtime_t timeout = system_time() + 300000;
+	while (system_time() < timeout) {
+		InterruptsSpinLocker locker(fStateLock);
+		bool ready = fFrameCount > 0 && !fSetupPending;
+		locker.Unlock();
+		if (ready)
+			break;
+		snooze(2000);
+	}
+	snooze(20000);
+	INFO("warm-up session done\n");
+	_Stop(true);
+	fWarmedUp = true;
+}
