+/*!	Gives the firmware the frames given back, as many as it has places
+	for (AV_SCRATCH_7 and _8, free when 0). Called with fStateLock held.
+*/
+void
+MesonVdec::_HandBack()
+{
+	while (fBackCount > 0) {
+		uint32 slot;
+		if (_Dos(AV_SCRATCH_7) == 0)
+			slot = AV_SCRATCH_7;
+		else if (_Dos(AV_SCRATCH_8) == 0)
+			slot = AV_SCRATCH_8;
+		else
+			return;
+		uint32 index = fBack[fBackHead];
+		fBackHead = (fBackHead + 1) % kMaxFrames;
+		fBackCount--;
+		_Trace('B', index + 1, slot);
+		_SetDos(slot, index + 1);
+	}
+}
+
+
+/*!	Whether the H.264 firmware has put out all frames of the stream after
+	its end was written: it read all before the end's own picture (the
+	VIFIFO holds no more than that) and reported nothing for a while; or it
+	asks for frames for the end's picture. At the end's picture, it puts out
+	the frames it holds and stops; it takes no frames back then. Called with
+	fStateLock held.
+*/
+bool
+MesonVdec::_FirmwareDone()
+{
+	if (!fEndOfStream)
+		return false;
+	if (fEndReached)
+		return true;
+	return _Dos(VLD_MEM_VIFIFO_LEVEL) <= 2 * kMinimumFetch
+		&& system_time() - fLastReport > 100000;
+}
