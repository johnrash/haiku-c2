+/*!	The mode for a frame size: uncompressed (no decoding, no compression
+	artefacts) when it is as fast as MJPEG, else MJPEG; the C920's YUY2
+	runs at 30 frames a second only up to 640x480.
+*/
+const UVCCamDevice::Mode*
+UVCCamDevice::_FindMode(uint32 width, uint32 height) const
+{
+	const Mode* uncompressed = NULL;
+	const Mode* compressed = NULL;
+	for (int32 i = 0; i < fModeCount; i++) {
+		const Mode& mode = fModes[i];
+		if (mode.width != width || mode.height != height)
+			continue;
+		if (mode.compressed) {
+			if (compressed == NULL)
+				compressed = &mode;
+		} else if (uncompressed == NULL)
+			uncompressed = &mode;
+	}
+	if (uncompressed != NULL
+		&& (compressed == NULL || uncompressed->interval <= compressed->interval))
+		return uncompressed;
+	return compressed;
 }
 
 
