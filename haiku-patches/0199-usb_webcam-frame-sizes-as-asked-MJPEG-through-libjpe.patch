+		2000000);
+	if (status != B_OK)
+		return status;
+
+	fDecodeLock.Lock();
+	uint8* swap = fReadyBuffer;
+	fReadyBuffer = fReadingBuffer;
+	fReadingBuffer = swap;
+	fReadyPending = false;
+	if (stamp != NULL)
+		*stamp = fReadyStamp;
+	fDecodeLock.Unlock();
+
+	// the decoders don't touch the reading buffer
+	size_t size = (size_t)fStreamWidth * fStreamHeight * 4;
+	if (buffer->SizeAvailable() < size || fReadingBuffer == NULL)
+		return B_BAD_VALUE;
+	memcpy(buffer->Data(), fReadingBuffer, size);
+	return B_OK;
+}
+
+
+status_t
+UVCCamDevice::_StartDecoders()
+{
+#ifdef HAVE_TURBOJPEG
+	size_t size = (size_t)fStreamWidth * fStreamHeight * 4;
+	fReadyBuffer = (uint8*)malloc(size);
+	fReadingBuffer = (uint8*)malloc(size);
+	bool allocated = fReadyBuffer != NULL && fReadingBuffer != NULL;
+	for (int32 i = 0; i < kDecoderCount; i++) {
+		fDecodeBuffers[i] = (uint8*)malloc(size);
+		allocated &= fDecodeBuffers[i] != NULL;
+	}
+	fDecodedSem = create_sem(0, "UVC decoded frame");
+	if (!allocated || fDecodedSem < 0) {
+		_StopDecoders();
+		return B_NO_MEMORY;
+	}
+
+	fFramesTaken = 0;
+	fNewestDecoded = 0;
+	fReadyPending = false;
+	fDecoding = true;
+	for (int32 i = 0; i < kDecoderCount; i++) {
+		fDecoderStarts[i].device = this;
+		fDecoderStarts[i].index = i;
+		fDecoders[i] = spawn_thread(_DecoderEntry, "UVC MJPEG decoder",
+			B_DISPLAY_PRIORITY, &fDecoderStarts[i]);
+		if (fDecoders[i] >= 0)
+			resume_thread(fDecoders[i]);
+	}
+	return B_OK;
+#else
+	return B_NOT_SUPPORTED;
+#endif
+}
+
+
+void
+UVCCamDevice::_StopDecoders()
+{
+	fDecoding = false;
+	for (int32 i = 0; i < kDecoderCount; i++) {
+		if (fDecoders[i] >= 0) {
+			status_t result;
+			wait_for_thread(fDecoders[i], &result);
+			fDecoders[i] = -1;
+		}
+	}
+	if (fDecodedSem >= 0) {
+		delete_sem(fDecodedSem);
+		fDecodedSem = -1;
+	}
+	for (int32 i = 0; i < kDecoderCount; i++) {
+		free(fDecodeBuffers[i]);
+		fDecodeBuffers[i] = NULL;
+	}
+	free(fReadyBuffer);
+	fReadyBuffer = NULL;
+	free(fReadingBuffer);
+	fReadingBuffer = NULL;
+}
+
+
+status_t
+UVCCamDevice::_DecoderEntry(void* data)
+{
+	DecoderStart* start = (DecoderStart*)data;
+	return start->device->_DecoderThread(start->index);
+}
+
+
+/*!	One of the decoders: takes the newest frame the deframer has (the
+	other decoder may still work on the one before), decodes it into its
+	own buffer, and makes that the ready one unless a newer frame got
+	there first. libjpeg-turbo turns the C920's 4:2:2 JPEG into B_RGB32
+	(BGRA in memory) with NEON; a 1080p frame takes a core 37 ms, so two
+	decoders keep up with 30 frames a second.
+*/
+status_t
+UVCCamDevice::_DecoderThread(int32 index)
+{
+#ifdef HAVE_TURBOJPEG
+	tjhandle handle = tj3Init(TJINIT_DECOMPRESS);
+	if (handle == NULL)
+		return B_NO_MEMORY;
+
+	const int width = fStreamWidth;
+	const int height = fStreamHeight;
+	while (fDecoding) {
+		if (fDeframer->WaitFrame(100000) != B_OK)
+			continue;
+
+		CamFrame* frame;
+		bigtime_t stamp;
+		fDecodeLock.Lock();
+		status_t status = fDeframer->GetFrame(&frame, &stamp);
+		int32 sequence = ++fFramesTaken;
+		fDecodeLock.Unlock();
+		if (status != B_OK)
+			continue;
+
+		const uint8* data = (const uint8*)frame->Buffer();
+		size_t length = frame->BufferLength();
+		bool good = tj3DecompressHeader(handle, data, length) == 0
+			&& tj3Get(handle, TJPARAM_JPEGWIDTH) == width
+			&& tj3Get(handle, TJPARAM_JPEGHEIGHT) == height;
+		if (good && tj3Decompress8(handle, data, length,
+				fDecodeBuffers[index], width * 4, TJPF_BGRA) != 0) {
+			// damaged data only warns: the frame decodes as far as it goes
+			good = tj3GetErrorCode(handle) == TJERR_WARNING;
+		}
+		delete frame;
+		if (!good)
+			continue;
+
+		fDecodeLock.Lock();
+		bool wake = false;
+		if (sequence > fNewestDecoded) {
+			fNewestDecoded = sequence;
+			uint8* swap = fReadyBuffer;
+			fReadyBuffer = fDecodeBuffers[index];
+			fDecodeBuffers[index] = swap;
+			fReadyStamp = stamp;
+			wake = !fReadyPending;
+			fReadyPending = true;
+		}
+		fDecodeLock.Unlock();
+		if (wake)
+			release_sem(fDecodedSem);
+	}
+
+	tj3Destroy(handle);
 	return B_OK;
+#else
+	return B_NOT_SUPPORTED;
+#endif
 }
 
 
