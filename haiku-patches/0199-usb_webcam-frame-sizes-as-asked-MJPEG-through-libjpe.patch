+/*!	A frame descriptor of a usable format becomes a mode, with the frame
+	interval closest to 30 frames a second without going faster (the
+	producer's rate), else the slowest of the faster ones.
+*/
+void
+UVCCamDevice::_AddMode(const usb_video_frame_descriptor* descriptor,
+	bool compressed, size_t len)
+{
+	if (fModeCount >= (int32)(sizeof(fModes) / sizeof(fModes[0])))
+		return;
+
+	// 30 frames a second, allowing for cameras that round 333333 down
+	const uint32 kInterval = 330000;
+	uint32 interval = 0;
+	if (descriptor->frame_interval_type == 0) {
+		uint32 minimum = descriptor->continuous.min_frame_interval;
+		uint32 maximum = descriptor->continuous.max_frame_interval;
+		uint32 step = descriptor->continuous.frame_interval_step;
+		if (minimum >= kInterval)
+			interval = minimum;
+		else if (maximum <= kInterval)
+			interval = maximum;
+		else {
+			interval = 333333;
+			if (step != 0) {
+				interval = minimum
+					+ (333333 - minimum + step - 1) / step * step;
+				if (interval > maximum)
+					interval = maximum;
+			}
+		}
+	} else {
+		// only the intervals the descriptor really holds
+		size_t offset = (const uint8*)descriptor->discrete_frame_intervals
+			- (const uint8*)descriptor;
+		size_t count = len > offset ? (len - offset) / sizeof(uint32) : 0;
+		if (count > descriptor->frame_interval_type)
+			count = descriptor->frame_interval_type;
+		uint32 slower = 0;
+		uint32 faster = 0;
+		for (size_t i = 0; i < count; i++) {
+			uint32 value = descriptor->discrete_frame_intervals[i];
+			if (value >= kInterval) {
+				if (slower == 0 || value < slower)
+					slower = value;
+			} else if (value > faster)
+				faster = value;
 		}
+		interval = slower != 0 ? slower : faster;
 	}
+	if (interval == 0)
+		interval = descriptor->default_frame_interval;
+	if (interval == 0)
+		return;
+
+	Mode& mode = fModes[fModeCount++];
+	mode.formatIndex = fParsingFormatIndex;
+	mode.frameIndex = descriptor->frame_index;
+	mode.compressed = compressed;
+	mode.width = descriptor->width;
+	mode.height = descriptor->height;
+	mode.interval = interval;
+}
+
 
