+static uint32
+speed_of(const termios& config)
+{
+	static const uint32 kSpeeds[] = {
+		0, 50, 75, 110, 134, 150, 200, 300, 600, 1200, 1800, 2400, 4800,
+		9600, 19200, 38400, 57600, 115200, 230400, 31250
+	};
+	uint32 index = config.c_cflag & CBAUD;
+	if (index == CBAUD)
+		return config.c_ospeed | ((uint32)config.c_ospeed_high << 16);
+	return index < B_COUNT_OF(kSpeeds) ? kSpeeds[index] : 0;
+}
+
+
+/*!	The line format and speed (a speed of 0, "hang up", keeps the last one;
+	the speed changes once the bytes in the FIFO have gone out).
+*/
+void
+MesonUart::_SetModes(const termios& config)
+{
+	fConfig = config;
+	uint32 set = kControlTwoWire;
+	if ((config.c_cflag & CS8) == 0)
+		set |= kControlSevenBits;
+	if ((config.c_cflag & PARENB) != 0) {
+		set |= kControlParity;
+		if ((config.c_cflag & PARODD) != 0)
+			set |= kControlOddParity;
+	}
+	if ((config.c_cflag & CSTOPB) != 0)
+		set |= kControlTwoStopBits;
+	_ChangeControl(kControlLengthMask | kControlParity | kControlOddParity
+		| kControlStopBitsMask, set);
+
+	uint32 speed = speed_of(config);
+	if (speed == 0 || speed == fSpeed)
+		return;
+	speed = max_c(min_c(speed, kMaxSpeed), kMinSpeed);
+	_WaitTxIdle();
+	uint32 divider = (kBaudClock + speed / 2) / speed;
+	fRegisters[kBaud] = kBaudCrystal | kBaudNewDivider | (divider - 1);
+	fSpeed = speed;
+}
+
+
+/*!	tcflush(): the tty has dropped its buffers; these are the UART's. */
+void
+MesonUart::_Flush(int what)
+{
+	InterruptsSpinLocker locker(fSpinlock);
+	if ((what & TCIFLUSH) != 0) {
+		fReceiveFirst = fReceiveCount = 0;
+		while ((fRegisters[kStatus] & kStatusRxEmpty) == 0)
+			fRegisters[kReadFifo];
+	}
+	if ((what & TCOFLUSH) != 0) {
+		fRegisters[kControl] |= kControlTxReset;
+		fRegisters[kControl] &= ~kControlTxReset;
+	}
+}
+
+
+/*static*/ bool
+MesonUart::Service(struct tty* tty, uint32 op, void* buffer, size_t length)
+{
+	MesonUart* uart = sUart;
+	if (uart == NULL || !uart->fOpen || tty != uart->fSlaveTTY)
+		return false;
+	return uart->_Service(op, buffer);
+}
+
+
+bool
+MesonUart::_Service(uint32 op, void* buffer)
+{
+	switch (op) {
+		case TTYGETSIGNALS:
+			// no modem lines: carrier and CTS are always there
+			gTTYModule->tty_hardware_signal(fUserCookie, TTYHWDCD, true);
+			gTTYModule->tty_hardware_signal(fUserCookie, TTYHWCTS, true);
+			gTTYModule->tty_hardware_signal(fUserCookie, TTYHWDSR, false);
+			gTTYModule->tty_hardware_signal(fUserCookie, TTYHWRI, false);
+			return true;
+
+		case TTYSETMODES:
+			_SetModes(*(termios*)buffer);
+			return true;
+
+		case TTYSETBREAK:
+			// TX inverted: low while idle
+			if (*(bool*)buffer) {
+				_WaitTxIdle();
+				_ChangeControl(0, kControlInvertTx);
+			} else
+				_ChangeControl(kControlInvertTx, 0);
+			return true;
+
+		case TTYFLUSH:
+			_Flush(*(int*)buffer);
+			return true;
+
+		case TTYENABLE:
+		case TTYISTOP:
+		case TTYSETDTR:
+		case TTYSETRTS:
+		case TTYOSTART:
+		case TTYOSYNC:
+			return true;
+	}
+	return false;
+}
+
+
+/*!	Takes the bytes received into the buffer (the receive thread passes them
+	on to the tty), and wakes the transmit thread once the FIFO is below half
+	full. The UART has no interrupt status: STATUS tells what happened.
+*/
+/*static*/ int32
+MesonUart::_Interrupt(void* data)
+{
+	MesonUart* uart = (MesonUart*)data;
+	volatile uint32* registers = uart->fRegisters;
+	bool received = false;
+	bool transmit = false;
+
+	SpinLocker locker(uart->fSpinlock);
+	uint32 status;
+	while (((status = registers[kStatus]) & kStatusRxEmpty) == 0) {
+		bool bad = false;
+		if ((status & (kStatusParityError | kStatusFrameError)) != 0) {
+			if ((status & kStatusParityError) != 0)
+				uart->fParityErrors++;
+			if ((status & kStatusFrameError) != 0)
+				uart->fFrameErrors++;
+			registers[kControl] |= kControlClearError;
+			registers[kControl] &= ~kControlClearError;
+			bad = (uart->fConfig.c_iflag & INPCK) != 0;
+		}
+		uint8 byte = registers[kReadFifo] & 0xff;
+		if (bad)
+			continue;
+		if (uart->fReceiveCount == kReceiveBufferSize) {
+			uart->fOverruns++;
+			continue;
+		}
+		uart->fReceiveBuffer[(uart->fReceiveFirst + uart->fReceiveCount)
+			% kReceiveBufferSize] = byte;
+		uart->fReceiveCount++;
+		received = true;
+	}
+	bool overflowing = (status & kStatusRxOverflow) != 0;
+	if (overflowing && !uart->fOverflowing)
+		uart->fOverruns++;
+	uart->fOverflowing = overflowing;
+
+	uint32 control = registers[kControl];
+	if ((control & kControlTxInterrupt) != 0
+		&& (status & kStatusTxFull) == 0) {
+		registers[kControl] = control & ~kControlTxInterrupt;
+		transmit = true;
+	}
+	locker.Unlock();
+
+	if (received)
+		release_sem_etc(uart->fReceiveSem, 1, B_DO_NOT_RESCHEDULE);
+	if (transmit)
+		release_sem_etc(uart->fTransmitSem, 1, B_DO_NOT_RESCHEDULE);
+	return received || transmit ? B_INVOKE_SCHEDULER : B_HANDLED_INTERRUPT;
+}
+
+
+/*!	Passes received bytes on to the tty (the master side writes into the
+	slave's input, with the termios input processing), until the port is
+	closed. Not from the interrupt: the tty may block.
+*/
+/*static*/ status_t
+MesonUart::_ReceiveThread(void* data)
+{
+	MesonUart* uart = (MesonUart*)data;
+	while (acquire_sem(uart->fReceiveSem) == B_OK) {
+		while (true) {
+			uint8 chunk[256];
+			size_t length = 0;
+			{
+				InterruptsSpinLocker locker(uart->fSpinlock);
+				while (length < sizeof(chunk) && uart->fReceiveCount > 0) {
+					chunk[length++] = uart->fReceiveBuffer[uart->fReceiveFirst];
+					uart->fReceiveFirst = (uart->fReceiveFirst + 1)
+						% kReceiveBufferSize;
+					uart->fReceiveCount--;
+				}
+			}
+			if (length == 0)
+				break;
+			if (uart->fClosed
+				|| gTTYModule->tty_write(uart->fDriverCookie, chunk, &length)
+					!= B_OK) {
+				return B_OK;
+			}
+		}
+	}
+	return B_OK;
+}
+
+
+/*!	Sends what comes out of the tty (programs' writes after the output
+	processing, and echoes), waiting for room in the FIFO, until the port is
+	closed.
+*/
+/*static*/ status_t
+MesonUart::_TransmitThread(void* data)
+{
+	MesonUart* uart = (MesonUart*)data;
+	uint8 chunk[kFifoSize];
+	while (!uart->fClosed) {
+		size_t length = sizeof(chunk);
+		if (gTTYModule->tty_read(uart->fDriverCookie, chunk, &length) != B_OK)
+			break;
+		uart->fSending = true;
+		for (size_t i = 0; i < length; i++) {
+			while ((uart->_Status() & kStatusTxFull) != 0) {
+				if (uart->fClosed)
+					return B_OK;
+				// wait for the FIFO to drop below half full
+				uart->_ChangeControl(0, kControlTxInterrupt);
+				if ((uart->_Status() & kStatusTxFull) == 0) {
+					uart->_ChangeControl(kControlTxInterrupt, 0);
+					break;
+				}
+				status_t status = acquire_sem_etc(uart->fTransmitSem, 1,
+					B_RELATIVE_TIMEOUT, uart->_FifoTime());
+				if (status != B_OK && status != B_TIMED_OUT)
+					return B_OK;
+			}
+			uart->fRegisters[kWriteFifo] = chunk[i];
+		}
+		uart->fSending = false;
+	}
+	return B_OK;
+}
