+static float
+supports_device(device_node* parent)
+{
+	const char* bus;
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false)
+			!= B_OK || strcmp(bus, "fdt") != 0
+		|| gDeviceManager->get_attr_string(parent, "fdt/compatible",
+			&compatible, false) != B_OK
+		|| strcmp(compatible, "amlogic,meson-gx-uart") != 0) {
+		return 0.0f;
+	}
+	// UART A only, though the device tree has it disabled
+	fdt_device_module_info* fdtModule;
+	fdt_device* fdtDevice;
+	if (gDeviceManager->get_driver(parent, (driver_module_info**)&fdtModule,
+			(void**)&fdtDevice) != B_OK) {
+		return 0.0f;
+	}
+	const char* name = fdtModule->get_name(fdtDevice);
+	uint64 reg, size;
+	if (name == NULL || strcmp(name, kNodeName) != 0
+		|| !fdtModule->get_reg(fdtDevice, 0, &reg, &size)
+		|| (reg & 0xfff) != (kUartA & 0xfff) || size < 0x18) {
+		return 0.0f;
+	}
+	return 0.8f;
+}
