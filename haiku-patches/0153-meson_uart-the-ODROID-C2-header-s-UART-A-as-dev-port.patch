+static status_t
+register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "Amlogic Meson GX UART A (ODROID-C2 header)" } },
+		{ NULL }
+	};
+	return gDeviceManager->register_node(parent, DRIVER_MODULE_NAME, attrs,
+		NULL, NULL);
+}
+
+
+static status_t
+init_driver(device_node* node, void** _cookie)
+{
+	if (sUart != NULL)
+		return B_BUSY;
+	MesonUart* uart = new(std::nothrow) MesonUart(node);
+	if (uart == NULL)
+		return B_NO_MEMORY;
+	status_t status = uart->Init();
+	if (status != B_OK) {
+		delete uart;
+		return status;
+	}
+	sUart = uart;
+	*_cookie = uart;
+	return B_OK;
+}
+
+
+static void
+uninit_driver(void* cookie)
+{
+	sUart = NULL;
+	delete (MesonUart*)cookie;
+}
