diff --git a/src/add-ons/kernel/busses/usb/dwc2_isochronous.cpp b/src/add-ons/kernel/busses/usb/dwc2_isochronous.cpp
index baf40efe9e..6ad3598be9 100644
--- a/src/add-ons/kernel/busses/usb/dwc2_isochronous.cpp
+++ b/src/add-ons/kernel/busses/usb/dwc2_isochronous.cpp
@@ -22,7 +22,11 @@
  * after. OUT packets start in microframe 0. IN packets start in microframe
  * 2: a device prepares its packet when the full speed frame begins, and an
  * IN token right at its start may find nothing ready yet (an audio device's
- * microphone answered a third of them with zero-length packets). A packet
+ * microphone answered a third of them with zero-length packets). A translator
+ * takes an OUT packet's parts one right after the other, with nothing between
+ * them, and a hub here has one translator for all its ports: a second OUT
+ * stream behind a hub starts in microframe 4, clear of the first and of the
+ * IN start-splits, and a third has no place (two adapters per hub). A packet
  * that cannot start in time is skipped, so every packet keeps its frame;
  * all start-splits go out by microframe 5, where the translator runs them
  * within the same full speed frame.
@@ -76,7 +80,7 @@ static const bigtime_t kIsoArmDelay = 30;
 static uint32
 start_microframe(dwc2_iso_stream* stream)
 {
-	return stream->in ? 2 : 0;
+	return stream->startFrame;
 }
 
 
@@ -85,7 +89,7 @@ arm_window(dwc2_iso_stream* stream)
 {
 	// OUT: start-splits up to microframe 5 for two parts; IN: complete-splits
 	// within the frame
-	return stream->in ? 2 : 4;
+	return stream->in ? 2 : 4 - stream->startFrame;
 }
 
 
@@ -106,6 +110,7 @@ DWC2::_InitIsochronous(uint8* bounce, phys_addr_t physical)
 		stream.channel = kLaneCount + i;
 		stream.in = false;
 		stream.highSpeed = i >= kIsoFirstHighSpeedStream;
+		stream.startFrame = 0;
 		stream.mult = 1;
 		stream.targetFrame = UINT32_MAX;
 		stream.pendingFrame = UINT32_MAX;
@@ -152,6 +157,8 @@ DWC2::_IsoStreamFor(Pipe* pipe, bool create)
 		return NULL;
 
 	unused->pipe = pipe;
+	unused->released = true;
+		// _SubmitIsochronous gives it its place
 	unused->in = pipe->Direction() == Pipe::In;
 	unused->mult = highSpeed ? pipe->MaxBurst() + 1 : 1;
 	unused->targetFrame = UINT32_MAX;
@@ -167,6 +174,37 @@ DWC2::_IsoStreamFor(Pipe* pipe, bool create)
 }
 
 
+/*!	Gives a stream coming into use the microframe its packets start in, see
+	above; B_BUSY if there is none. Called with fIsoLock held.
+*/
+status_t
+DWC2::_IsoPlace(dwc2_iso_stream* stream)
+{
+	stream->startFrame = stream->in ? 2 : 0;
+	if (stream->highSpeed || stream->in)
+		return B_OK;
+
+	bool first = true;
+	bool second = true;
+	for (uint32 i = 0; i < kIsoFirstHighSpeedStream; i++) {
+		dwc2_iso_stream& other = fIsoStreams[i];
+		if (&other == stream || other.pipe == NULL || other.released
+			|| other.in
+			|| other.pipe->HubAddress() != stream->pipe->HubAddress()) {
+			continue;
+		}
+		if (other.startFrame == 0)
+			first = false;
+		else
+			second = false;
+	}
+	if (!first && !second)
+		return B_BUSY;
+	stream->startFrame = first ? 0 : 4;
+	return B_OK;
+}
+
+
 status_t
 DWC2::_SubmitIsochronous(Transfer* transfer)
 {
@@ -242,7 +280,17 @@ DWC2::_SubmitIsochronous(Transfer* transfer)
 	dwc2_iso_stream* stream = _IsoStreamFor(pipe, true);
 	if (stream == NULL || stream->freeSlots == 0)
 		return B_BUSY;
-	stream->released = false;
+	if (stream->released) {
+		if (_IsoPlace(stream) != B_OK) {
+			if (!fWarnedIsoPlace) {
+				INFO("no room for a third isochronous OUT stream behind hub "
+					"%d\n", pipe->HubAddress());
+				fWarnedIsoPlace = true;
+			}
+			return B_BUSY;
+		}
+		stream->released = false;
+	}
 	entry->stream = stream;
 	entry->slot = 0;
 	while ((stream->freeSlots & (1 << entry->slot)) == 0)
