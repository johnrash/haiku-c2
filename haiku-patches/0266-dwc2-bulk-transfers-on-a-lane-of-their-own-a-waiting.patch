 };
 
 
@@ -222,6 +228,7 @@ private:
 									uint32 offset, bool in, uint32* status,
 									uint32* transferSize);
 			void				_HaltChannel(dwc2_lane* lane);
+			bool				_ShouldYield(dwc2_lane* lane, uint32 packets);
 
 			// isochronous transfers (dwc2_isochronous.cpp)
 			status_t			_InitIsochronous(uint8* bounce,
@@ -280,7 +287,7 @@ private:
 			uint8				fPortResetChange;
 
 			mutex				fQueueLock;		// both lanes' queues
-			dwc2_lane			fLanes[kLaneCount];	// control/bulk, interrupt
+			dwc2_lane			fLanes[kLaneCount];	// control, interrupt, bulk
 			bool				fStopWorker;
 			bool				fWarnedSplit;
 			int64				fStatBulkBytes;
