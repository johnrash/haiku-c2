diff --git a/headers/private/drivers/meson_header.h b/headers/private/drivers/meson_header.h
new file mode 100644
index 0000000000..948db7cb40
--- /dev/null
+++ b/headers/private/drivers/meson_header.h
@@ -0,0 +1,74 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _MESON_HEADER_H
+#define _MESON_HEADER_H
+
+
+#include <module.h>
+#include <OS.h>
+
+
+/*!	The ODROID-C2's 40-pin header (J2): its pins with a SoC pad, who has
+	each one, and the pin controller's mux for them. The drivers that use
+	header pins (meson_gpio for GPIO and PWM, meson_i2c, the serial port's)
+	claim them here, so that a pin has one user at a time, and select their
+	functions here, under one lock (the mux words are shared).
+*/
+
+
+#define MESON_HEADER_MODULE_NAME	"generic/meson_header/v1"
+
+
+typedef struct meson_header_function {
+	uint8		word;			// PERIPHS_PIN_MUX_<word>
+	uint8		bit;
+	const char*	name;			// "PWM E", "UART A", "I2C B"; NULL: none
+} meson_header_function;
+
+
+typedef struct meson_header_pin {
+	uint8		pin;			// header pin number
+	uint8		bank;			// MESON_HEADER_BANK_*
+	uint8		offset;			// the pad in its bank
+	bool		programs;		// offered to programs as GPIO
+	meson_header_function functions[3];
+		// the alternate functions; none selected: GPIO
+} meson_header_pin;
+
+
+enum {
+	MESON_HEADER_BANK_X,
+	MESON_HEADER_BANK_Y,
+	MESON_HEADER_BANK_DV,
+};
+
+
+typedef struct meson_header_module_info {
+	module_info	info;
+
+	uint32		(*count_pins)(void);
+	const meson_header_pin* (*pin_at)(uint32 index);
+	int32		(*find_pin)(const char* name);
+		// "7", "Pin7" or "GPIOX_21": an index, or -1
+	void		(*pad_name)(uint32 index, char* buffer, size_t size);
+		// "GPIOX_21"
+
+	status_t	(*claim)(uint32 index, void* owner, const char* use);
+		// B_BUSY if another owner has the pin; \a use ("program",
+		// "I2C A") and the calling team are kept for user()
+	void		(*release)(uint32 index, void* owner);
+	bool		(*user)(uint32 index, void** _owner, char* use,
+					size_t useSize, team_id* _team);
+		// false: nobody has the pin
+
+	status_t	(*select)(uint32 index, const char* function);
+		// the alternate function with that name, the others off; NULL:
+		// GPIO (all off)
+	const char*	(*selected)(uint32 index);
+		// the alternate function the mux selects, or NULL (GPIO)
+} meson_header_module_info;
+
+
+#endif	// _MESON_HEADER_H
