diff --git a/src/add-ons/kernel/generic/meson_header/meson_header.cpp b/src/add-ons/kernel/generic/meson_header/meson_header.cpp
new file mode 100644
index 0000000000..89c3e77d90
--- /dev/null
+++ b/src/add-ons/kernel/generic/meson_header/meson_header.cpp
@@ -0,0 +1,278 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * The ODROID-C2's 40-pin header (headers/private/drivers/meson_header.h):
+ * the pins with a SoC pad, who has each one, and their pin mux, written
+ * under one lock for all the drivers that use the header.
+ *
+ * The pin map comes from the device tree's gpio-line-names, the mux bits
+ * from Linux's GXBB pin tables (facts only), as in meson_gpio before.
+ */
+
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <KernelExport.h>
+#include <kernel.h>
+#include <team.h>
+#include <util/AutoLock.h>
+
+#include <meson_header.h>
+
+
+static const phys_addr_t kMuxBase = 0xc88344b0;		// PERIPHS_PIN_MUX_0
+
+static const char* const kBankPrefixes[] = { "GPIOX_", "GPIOY_", "GPIODV_" };
+
+#define X	MESON_HEADER_BANK_X
+#define Y	MESON_HEADER_BANK_Y
+#define DV	MESON_HEADER_BANK_DV
+
+static const meson_header_pin kPins[] = {
+	// pins 3 and 5 carry I2C A (the RTC shield): not for programs
+	{ 3, DV, 24, false, { { 7, 26, "I2C A" }, { 2, 29, "UART B" } } },
+	{ 5, DV, 25, false, { { 7, 27, "I2C A" }, { 2, 28, "UART B" } } },
+	{ 7, X, 21, true, {} },
+	{ 8, X, 12, true, { { 4, 13, "UART A" } } },
+	{ 10, X, 13, true, { { 4, 12, "UART A" } } },
+	{ 11, X, 19, true, { { 2, 30, "PWM E" } } },
+	{ 12, X, 10, true, {} },
+	{ 13, X, 11, true, {} },
+	{ 15, X, 9, true, { { 3, 7, "TS B" } } },
+	{ 16, X, 8, true, { { 3, 10, "TS B" } } },
+	{ 18, X, 5, true, { { 8, 0, "SDIO" } } },
+	{ 19, X, 7, true, { { 8, 11, "SDIO" }, { 3, 18, "PWM F" },
+		{ 3, 8, "TS B" } } },
+	{ 21, X, 4, true, { { 8, 1, "SDIO" } } },
+	{ 22, X, 3, true, { { 8, 2, "SDIO" } } },
+	{ 23, X, 2, true, { { 8, 3, "SDIO" } } },
+	{ 24, X, 1, true, { { 8, 4, "SDIO" } } },
+	{ 26, Y, 14, true, { { 1, 18, "UART C" } } },
+	{ 27, DV, 26, true, { { 7, 24, "I2C B" }, { 2, 27, "UART B" } } },
+	{ 28, DV, 27, true, { { 7, 25, "I2C B" }, { 2, 26, "UART B" } } },
+	{ 29, X, 0, true, { { 8, 5, "SDIO" } } },
+	{ 31, Y, 8, true, { { 3, 5, "TS A" }, { 1, 5, "I2S" } } },
+	{ 32, Y, 13, true, { { 1, 19, "UART C" } } },
+	// pin 33's PWM A is left out: its controller's other channel sets a
+	// core voltage regulator
+	{ 33, X, 6, true, { { 3, 9, "TS B" } } },
+	{ 35, Y, 3, true, { { 3, 4, "TS A" } } },
+	{ 36, Y, 7, true, { { 3, 5, "TS A" } } },
+};
+static const uint32 kPinCount = B_COUNT_OF(kPins);
+
+#undef X
+#undef Y
+#undef DV
+
+
+struct pin_user {
+	void*		owner;
+	team_id		team;
+	char		use[32];
+};
+
+static area_id sMuxArea = -1;
+static volatile uint32* sMux;
+static spinlock sLock = B_SPINLOCK_INITIALIZER;
+static pin_user sUsers[kPinCount];
+
+
+static uint32
+count_pins(void)
+{
+	return kPinCount;
+}
+
+
+static const meson_header_pin*
+pin_at(uint32 index)
+{
+	return index < kPinCount ? &kPins[index] : NULL;
+}
+
+
+static void
+pad_name(uint32 index, char* buffer, size_t size)
+{
+	if (index >= kPinCount) {
+		strlcpy(buffer, "", size);
+		return;
+	}
+	snprintf(buffer, size, "%s%u", kBankPrefixes[kPins[index].bank],
+		kPins[index].offset);
+}
+
+
+static int32
+find_pin(const char* name)
+{
+	if (name == NULL)
+		return -1;
+	const char* number = name;
+	if (strncasecmp(name, "pin", 3) == 0)
+		number = name + 3;
+	char* end;
+	long value = strtol(number, &end, 10);
+	bool isNumber = *number != '\0' && *end == '\0';
+	for (uint32 i = 0; i < kPinCount; i++) {
+		char pad[16];
+		pad_name(i, pad, sizeof(pad));
+		if ((isNumber && kPins[i].pin == value)
+			|| strcasecmp(name, pad) == 0) {
+			return i;
+		}
+	}
+	return -1;
+}
+
+
+static status_t
+claim(uint32 index, void* owner, const char* use)
+{
+	if (index >= kPinCount || owner == NULL)
+		return B_BAD_VALUE;
+	team_id team = team_get_current_team_id();
+	InterruptsSpinLocker locker(sLock);
+	pin_user& user = sUsers[index];
+	if (user.owner != NULL && user.owner != owner)
+		return B_BUSY;
+	user.owner = owner;
+	user.team = team;
+	strlcpy(user.use, use != NULL ? use : "", sizeof(user.use));
+	return B_OK;
+}
+
+
+static void
+release(uint32 index, void* owner)
+{
+	if (index >= kPinCount)
+		return;
+	InterruptsSpinLocker locker(sLock);
+	if (sUsers[index].owner == owner)
+		sUsers[index].owner = NULL;
+}
+
+
+static bool
+user(uint32 index, void** _owner, char* use, size_t useSize, team_id* _team)
+{
+	if (index >= kPinCount)
+		return false;
+	InterruptsSpinLocker locker(sLock);
+	const pin_user& user = sUsers[index];
+	if (user.owner == NULL)
+		return false;
+	if (_owner != NULL)
+		*_owner = user.owner;
+	if (use != NULL)
+		strlcpy(use, user.use, useSize);
+	if (_team != NULL)
+		*_team = user.team;
+	return true;
+}
+
+
+static status_t
+select_function(uint32 index, const char* function)
+{
+	if (index >= kPinCount)
+		return B_BAD_VALUE;
+	const meson_header_pin& pin = kPins[index];
+	bool found = function == NULL;
+	for (size_t i = 0; i < B_COUNT_OF(pin.functions); i++) {
+		if (pin.functions[i].name != NULL && function != NULL
+			&& strcmp(pin.functions[i].name, function) == 0) {
+			found = true;
+		}
+	}
+	if (!found)
+		return B_NOT_SUPPORTED;
+
+	InterruptsSpinLocker locker(sLock);
+	// the others off first, then the one wanted
+	for (int32 pass = 0; pass < 2; pass++) {
+		for (size_t i = 0; i < B_COUNT_OF(pin.functions); i++) {
+			const meson_header_function& mux = pin.functions[i];
+			if (mux.name == NULL)
+				continue;
+			bool wanted = function != NULL && strcmp(mux.name, function) == 0;
+			if (pass == 0 && !wanted)
+				sMux[mux.word] &= ~(1u << mux.bit);
+			else if (pass == 1 && wanted)
+				sMux[mux.word] |= 1u << mux.bit;
+		}
+	}
+	return B_OK;
+}
+
+
+static const char*
+selected_function(uint32 index)
+{
+	if (index >= kPinCount)
+		return NULL;
+	const meson_header_pin& pin = kPins[index];
+	for (size_t i = 0; i < B_COUNT_OF(pin.functions); i++) {
+		const meson_header_function& mux = pin.functions[i];
+		if (mux.name != NULL && (sMux[mux.word] & (1u << mux.bit)) != 0)
+			return mux.name;
+	}
+	return NULL;
+}
+
+
+static status_t
+std_ops(int32 op, ...)
+{
+	switch (op) {
+		case B_MODULE_INIT:
+		{
+			phys_addr_t page = ROUNDDOWN(kMuxBase, B_PAGE_SIZE);
+			void* address;
+			sMuxArea = map_physical_memory("meson_header pin mux", page,
+				B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+				B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+			if (sMuxArea < 0)
+				return sMuxArea;
+			sMux = (volatile uint32*)((addr_t)address + (kMuxBase - page));
+			memset(sUsers, 0, sizeof(sUsers));
+			return B_OK;
+		}
+
+		case B_MODULE_UNINIT:
+			delete_area(sMuxArea);
+			sMuxArea = -1;
+			sMux = NULL;
+			return B_OK;
+	}
+	return B_ERROR;
+}
+
+
+static meson_header_module_info sMesonHeaderModule = {
+	{
+		MESON_HEADER_MODULE_NAME,
+		B_KEEP_LOADED,
+		std_ops
+	},
+	count_pins,
+	pin_at,
+	find_pin,
+	pad_name,
+	claim,
+	release,
+	user,
+	select_function,
+	selected_function
+};
+
+
+module_info* modules[] = {
+	(module_info*)&sMesonHeaderModule,
+	NULL
+};
