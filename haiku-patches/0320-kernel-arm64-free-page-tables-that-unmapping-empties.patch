From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Fri, 6 Nov 2026 09:15:36 -0500
Subject: [PATCH 320/342] kernel/arm64: free page tables that unmapping empties

Unmapping only cleared entries, and tables were freed with the whole map,
when the team exited. A program that keeps mapping at new addresses (and
Haiku randomizes them) kept every table it ever needed: sshd's listener
about 38 KB per connection, and on the test board tools/probes/mapchurn
held 285 MB of tables after 29,879 maps in 2 minutes.

After a range is unmapped (UnmapArea(), UnmapPages(), Unmap(); not for an
address space that is going, and not when the page daemon unmaps single
pages), the user map's tables that serve it and have no entry left are
detached, deepest first; the root stays, the kernel map is left alone.
Before their pages are freed, the address space's TLB entries go on all
CPUs (walk caches included), and one synchronous call on all CPUs waits
out the software walks that run without the map's lock with interrupts
disabled: QueryInterrupt() and the access flag/dirty fixup in arch_int.cpp.
Everything else that walks or changes a user map does it with the map
locked, as this does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../arch/arm64/VMSAv8TranslationMap.cpp       | 119 ++++++++++++++++++
 .../kernel/arch/arm64/VMSAv8TranslationMap.h  |  13 ++
 2 files changed, 132 insertions(+)

diff --git a/src/system/kernel/arch/arm64/VMSAv8TranslationMap.cpp b/src/system/kernel/arch/arm64/VMSAv8TranslationMap.cpp
index afeb1a1bb3..f3cae320e2 100644
--- a/src/system/kernel/arch/arm64/VMSAv8TranslationMap.cpp
+++ b/src/system/kernel/arch/arm64/VMSAv8TranslationMap.cpp
@@ -5,6 +5,7 @@
 #include "VMSAv8TranslationMap.h"
 
 #include <algorithm>
+#include <KernelExport.h>
 #include <slab/Slab.h>
 #include <util/AutoLock.h>
 #include <util/ThreadAutoLock.h>
@@ -646,6 +647,7 @@ VMSAv8TranslationMap::Unmap(addr_t start, addr_t end)
 			FlushVAIfAccessed(oldPte, effectiveVa);
 		});
 
+	ReclaimTables(start, end);
 	return B_OK;
 }
 
@@ -729,6 +731,9 @@ VMSAv8TranslationMap::UnmapPages(VMArea* area, addr_t address, size_t size,
 	// area range is unmapped for good (resized/cut) and the pages will likely
 	// be freed.
 
+	if (!deletingAddressSpace)
+		ReclaimTables(address, address + size - 1);
+
 	locker.Unlock();
 
 	// free removed mappings
@@ -741,6 +746,120 @@ VMSAv8TranslationMap::UnmapPages(VMArea* area, addr_t address, size_t size,
 }
 
 
+void
+VMSAv8TranslationMap::UnmapArea(VMArea* area, bool deletingAddressSpace,
+	bool ignoreTopCachePageFlags)
+{
+	VMTranslationMap::UnmapArea(area, deletingAddressSpace,
+		ignoreTopCachePageFlags);
+
+	if (!deletingAddressSpace)
+		ReclaimTables(area->Base(), area->Base() + (area->Size() - 1));
+}
+
+
+/*!	Frees the page tables that hold nothing any more after [start, end] was
+	unmapped. Unmapping only clears entries: without this, a program that
+	keeps mapping at new addresses (randomized ones, say) keeps every table
+	it ever needed until it exits, sshd's listener about 38 KB a connection.
+	User maps only; the root table stays. Expects the map locked or locks it.
+*/
+void
+VMSAv8TranslationMap::ReclaimTables(addr_t start, addr_t end)
+{
+	if (fIsKernel || fPageTable == 0 || start > end)
+		return;
+
+	RecursiveLocker locker(fLock);
+	DetachedTables detached;
+	DetachEmptyTables(fPageTable, fInitialLevel, 0, start, end, detached);
+	FreeDetachedTables(detached);
+}
+
+
+/*!	Detaches the empty tables below the table at \a ptPa (on \a level, its
+	first entry translating \a va) that serve [start, end], deepest first, and
+	collects them in \a detached. A table that still has an entry stays.
+*/
+void
+VMSAv8TranslationMap::DetachEmptyTables(phys_addr_t ptPa, int level, addr_t va,
+	addr_t start, addr_t end, DetachedTables& detached)
+{
+	int tableBits = fPageBits - 3;
+	uint64_t tableSize = 1UL << tableBits;
+	int shift = tableBits * (3 - level) + fPageBits;
+	uint64_t entrySize = 1UL << shift;
+	addr_t tableEnd = va + (tableSize * entrySize - 1);
+
+	uint64_t* table = TableFromPa(ptPa);
+	uint64_t first = (std::max(start, va) - va) >> shift;
+	uint64_t last = (std::min(end, tableEnd) - va) >> shift;
+	for (uint64_t i = first; i <= last; i++) {
+		uint64_t pte = atomic_get64((int64_t*)&table[i]);
+		if ((pte & kPteTypeMask) != kPteTypeL012Table)
+			continue;
+
+		phys_addr_t subTablePa = pte & kPteAddrMask;
+		if (level + 1 < 3) {
+			DetachEmptyTables(subTablePa, level + 1, va + i * entrySize, start,
+				end, detached);
+		}
+
+		uint64_t* subTable = TableFromPa(subTablePa);
+		bool empty = true;
+		for (uint64_t j = 0; j < tableSize && empty; j++)
+			empty = atomic_get64((int64_t*)&subTable[j]) == 0;
+		if (!empty)
+			continue;
+
+		if (detached.count == DetachedTables::kCapacity)
+			FreeDetachedTables(detached);
+		atomic_set64((int64_t*)&table[i], 0);
+		detached.tables[detached.count++] = subTablePa;
+	}
+}
+
+
+static void
+walkers_done(void*, int)
+{
+}
+
+
+/*!	Frees tables DetachEmptyTables() has taken out of the map, once nothing
+	can walk them any more: the hardware may still have their entries in its
+	TLB or walk caches, so they go for the whole address space on all CPUs;
+	software walks without the map's lock (QueryInterrupt(), the access flag
+	and dirty fault fixup in arch_int.cpp) run with interrupts disabled, so
+	once every CPU has taken an interrupt, those that started earlier are
+	done.
+*/
+void
+VMSAv8TranslationMap::FreeDetachedTables(DetachedTables& detached)
+{
+	if (detached.count == 0)
+		return;
+
+	arm64_dsb(ishst);
+	{
+		// Without an ASID the map runs nowhere, and the TLB was flushed for
+		// the ASID it had when that was given away.
+		InterruptsSpinLocker locker(sAsidLock);
+		if (fASID != -1)
+			flush_tlb_whole_asid(fASID);
+	}
+
+	call_all_cpus_sync(&walkers_done, NULL);
+
+	for (int i = 0; i < detached.count; i++) {
+		vm_page* page = vm_lookup_page(detached.tables[i] >> fPageBits);
+		DEBUG_PAGE_ACCESS_START(page);
+		vm_page_free_etc(NULL, page, NULL);
+	}
+	detached.count = 0;
+}
+
+
 bool
 VMSAv8TranslationMap::ValidateVa(addr_t va)
 {
diff --git a/src/system/kernel/arch/arm64/VMSAv8TranslationMap.h b/src/system/kernel/arch/arm64/VMSAv8TranslationMap.h
index 88abad88af..5eefdbcecc 100644
--- a/src/system/kernel/arch/arm64/VMSAv8TranslationMap.h
+++ b/src/system/kernel/arch/arm64/VMSAv8TranslationMap.h
@@ -62,6 +62,9 @@ public:
 	virtual	void				UnmapPages(VMArea* area, addr_t base,
 									size_t size, bool updatePageQueue,
 									bool deletingAddressSpace);
+	virtual	void				UnmapArea(VMArea* area,
+									bool deletingAddressSpace,
+									bool ignoreTopCachePageFlags);
 
 	virtual	status_t			Query(addr_t virtualAddress,
 									phys_addr_t* _physicalAddress,
@@ -123,6 +126,16 @@ private:
 		vm_page_reservation* reservation, UpdatePte &&updatePte);
 	bool AttemptPteBreakBeforeMake(uint64_t* ptePtr, uint64_t oldPte, addr_t va);
 	bool FlushVAIfAccessed(uint64_t pte, addr_t va);
+
+	struct DetachedTables {
+		static const int kCapacity = 32;
+		phys_addr_t	tables[kCapacity];
+		int			count = 0;
+	};
+	void ReclaimTables(addr_t start, addr_t end);
+	void DetachEmptyTables(phys_addr_t ptPa, int level, addr_t va, addr_t start,
+		addr_t end, DetachedTables& detached);
+	void FreeDetachedTables(DetachedTables& detached);
 };
 
 
