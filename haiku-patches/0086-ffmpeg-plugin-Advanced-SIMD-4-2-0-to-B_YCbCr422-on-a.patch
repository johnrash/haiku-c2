diff --git a/src/add-ons/media/plugins/ffmpeg/gfx_conv_neon.c b/src/add-ons/media/plugins/ffmpeg/gfx_conv_neon.c
new file mode 100644
index 0000000000..5beea4f9b0
--- /dev/null
+++ b/src/add-ons/media/plugins/ffmpeg/gfx_conv_neon.c
@@ -0,0 +1,51 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "gfx_conv_neon.h"
+
+// The build includes GCC's headers like its own, with -Werror.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wsign-compare"
+#pragma GCC diagnostic ignored "-Wmissing-braces"
+#include <arm_neon.h>
+#pragma GCC diagnostic pop
+
+
+/*!	Planar 4:2:0 (AV_PIX_FMT_YUV420P) to packed 4:2:2 Y0 Cb Y1 Cr
+	(B_YCbCr422), what overlays that can't show B_RGB32 take. Each chroma row
+	serves two rows, as in swscale's yv12toyuy2(), which does this in C on
+	arm64 (5.6 ms for a 1920x1080 frame on the ODROID-C2): the same bytes, 32
+	pixels at a time. Like swscale, an odd width's last column is left out.
+*/
+void
+gfx_conv_yuv420p_ycbcr422_neon(AVFrame* in, AVFrame* out, int width,
+	int height)
+{
+	int y;
+	for (y = 0; y < height; y++) {
+		const uint8_t* luma = in->data[0] + (size_t)y * in->linesize[0];
+		const uint8_t* cb = in->data[1] + (size_t)(y / 2) * in->linesize[1];
+		const uint8_t* cr = in->data[2] + (size_t)(y / 2) * in->linesize[2];
+		uint8_t* pixel = out->data[0] + (size_t)y * out->linesize[0];
+
+		int x = 0;
+		for (; x + 32 <= width; x += 32) {
+			uint8x16x2_t lumaPairs = vld2q_u8(luma + x);
+			uint8x16x4_t packed;
+			packed.val[0] = lumaPairs.val[0];
+			packed.val[1] = vld1q_u8(cb + x / 2);
+			packed.val[2] = lumaPairs.val[1];
+			packed.val[3] = vld1q_u8(cr + x / 2);
+			vst4q_u8(pixel + 2 * x, packed);
+		}
+		for (; x + 1 < width; x += 2) {
+			pixel[2 * x] = luma[x];
+			pixel[2 * x + 1] = cb[x / 2];
+			pixel[2 * x + 2] = luma[x + 1];
+			pixel[2 * x + 3] = cr[x / 2];
+		}
+	}
+}
diff --git a/src/add-ons/media/plugins/ffmpeg/gfx_conv_neon.h b/src/add-ons/media/plugins/ffmpeg/gfx_conv_neon.h
new file mode 100644
