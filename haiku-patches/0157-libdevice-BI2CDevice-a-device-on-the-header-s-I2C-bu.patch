From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Sat, 31 Oct 2026 01:45:41 -0400
Subject: [PATCH 157/342] libdevice: BI2CDevice, a device on the header's I2C
 bus

The bus "header" (I2C B on pins 27 and 28, 100 kHz, through meson_i2c)
and a 7-bit address, 0x08 to 0x77: Read(), Write(), WriteRead() with a
repeated start, ReadRegister() and WriteRegister(), IsPresent(), and a
Scan() of the addresses that answer. Several devices share the bus,
whose pins are the first one's to the last one's Close(). A device that
doesn't answer: B_DEV_NOT_READY.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 headers/os/device/I2CDevice.h |  65 ++++++++++
 src/kits/device/I2CDevice.cpp | 236 ++++++++++++++++++++++++++++++++++
 src/kits/device/Jamfile       |   1 +
 3 files changed, 302 insertions(+)
 create mode 100644 headers/os/device/I2CDevice.h
 create mode 100644 src/kits/device/I2CDevice.cpp

diff --git a/headers/os/device/I2CDevice.h b/headers/os/device/I2CDevice.h
new file mode 100644
index 0000000000..a7cc9bf9d1
--- /dev/null
+++ b/headers/os/device/I2CDevice.h
@@ -0,0 +1,65 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef	_I2C_DEVICE_H
+#define	_I2C_DEVICE_H
+
+
+#include <BeBuild.h>
+#include <OS.h>
+#include <SupportDefs.h>
+
+
+/*!	A device on the ODROID-C2 header's I2C bus, in the manner of the BeBox
+	GeekPort classes: the bus "header" (pins 27, SDA, and 28, SCL; 3.3 V,
+	1 kOhm pull-ups on the board, 100 kHz) and the device's 7-bit address,
+	0x08 to 0x77. The first device opened takes the two pins from GPIO
+	(B_BUSY while a program has one), the last one closed gives them back.
+	A device that doesn't answer: B_DEV_NOT_READY.
+*/
+class BI2CDevice {
+public:
+							BI2CDevice();
+	virtual					~BI2CDevice();
+
+			status_t		Open(const char* bus, uint8 address);
+			void			Close();
+			bool			IsOpen() const;
+			uint8			Address() const;
+
+			ssize_t			Read(void* buffer, size_t length);
+			ssize_t			Write(const void* buffer, size_t length);
+			status_t		WriteRead(const void* command,
+								size_t commandLength, void* buffer,
+								size_t length);
+								// a repeated start between them
+			status_t		ReadRegister(uint8 reg, uint8* _value);
+			status_t		WriteRegister(uint8 reg, uint8 value);
+			bool			IsPresent();
+								// whether the device answers its address
+
+			int32			CountDevices();
+			status_t		GetDeviceName(int32 index, char* name,
+								size_t bufSize = B_OS_NAME_LENGTH);
+								// the buses: "header"
+			status_t		Scan(const char* bus, uint8* addresses,
+								int32 maxCount, int32* _count);
+								// the addresses that answer
+
+private:
+			status_t		_Transfer(int fd, uint8 address,
+								const void* write, size_t writeLength,
+								void* read, size_t readLength);
+
+	virtual	void			_ReservedI2CDevice1();
+	virtual	void			_ReservedI2CDevice2();
+	virtual	void			_ReservedI2CDevice3();
+
+			int				fFd;
+			uint8			fAddress;
+			uint32			_reserved[4];
+};
+
+
+#endif // _I2C_DEVICE_H
diff --git a/src/kits/device/I2CDevice.cpp b/src/kits/device/I2CDevice.cpp
new file mode 100644
index 0000000000..4c427b1702
--- /dev/null
+++ b/src/kits/device/I2CDevice.cpp
@@ -0,0 +1,236 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * A device on the ODROID-C2 header's I2C bus, through meson_i2c's
+ * /dev/bus/i2c/header (headers/private/drivers/meson_i2c.h). Elsewhere
+ * Open() fails.
+ */
+
+
+#include <I2CDevice.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+
+#include <meson_i2c.h>
+
+
+static const char* kBusName = "header";
+static const uint8 kFirstAddress = 0x08;
+static const uint8 kLastAddress = 0x77;
+
+
+BI2CDevice::BI2CDevice()
+	:
+	fFd(-1),
+	fAddress(0)
+{
+}
+
+
+BI2CDevice::~BI2CDevice()
+{
+	Close();
+}
+
+
+status_t
+BI2CDevice::Open(const char* bus, uint8 address)
+{
+	Close();
+	if (bus == NULL || strcasecmp(bus, kBusName) != 0)
+		return B_ENTRY_NOT_FOUND;
+	if (address < kFirstAddress || address > kLastAddress)
+		return B_BAD_VALUE;
+	int fd = open(MESON_I2C_HEADER_DEVICE, O_RDWR | O_CLOEXEC);
+	if (fd < 0)
+		return errno == ENOENT ? B_ENTRY_NOT_FOUND : errno;
+	fFd = fd;
+	fAddress = address;
+	return B_OK;
+}
+
+
+void
+BI2CDevice::Close()
+{
+	if (fFd >= 0)
+		close(fFd);
+	fFd = -1;
+	fAddress = 0;
+}
+
+
+bool
+BI2CDevice::IsOpen() const
+{
+	return fFd >= 0;
+}
+
+
+uint8
+BI2CDevice::Address() const
+{
+	return fAddress;
+}
+
+
+status_t
+BI2CDevice::_Transfer(int fd, uint8 address, const void* write,
+	size_t writeLength, void* read, size_t readLength)
+{
+	meson_i2c_transfer transfer;
+	transfer.address = address;
+	transfer.write = write;
+	transfer.writeLength = writeLength;
+	transfer.read = read;
+	transfer.readLength = readLength;
+	if (ioctl(fd, MESON_I2C_TRANSFER, &transfer, sizeof(transfer)) != 0)
+		return errno;
+	return B_OK;
+}
+
+
+/*!	Reads \a length bytes from the device: returns how many, or an error. */
+ssize_t
+BI2CDevice::Read(void* buffer, size_t length)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (buffer == NULL || length == 0)
+		return B_BAD_VALUE;
+	status_t status = _Transfer(fFd, fAddress, NULL, 0, buffer, length);
+	return status == B_OK ? (ssize_t)length : status;
+}
+
+
+ssize_t
+BI2CDevice::Write(const void* buffer, size_t length)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (buffer == NULL || length == 0)
+		return B_BAD_VALUE;
+	status_t status = _Transfer(fFd, fAddress, buffer, length, NULL, 0);
+	return status == B_OK ? (ssize_t)length : status;
+}
+
+
+/*!	Writes \a command, then reads \a length bytes after a repeated start:
+	most devices' "read from a register".
+*/
+status_t
+BI2CDevice::WriteRead(const void* command, size_t commandLength,
+	void* buffer, size_t length)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (command == NULL || commandLength == 0 || buffer == NULL
+		|| length == 0) {
+		return B_BAD_VALUE;
+	}
+	return _Transfer(fFd, fAddress, command, commandLength, buffer, length);
+}
+
+
+status_t
+BI2CDevice::ReadRegister(uint8 reg, uint8* _value)
+{
+	if (_value == NULL)
+		return B_BAD_VALUE;
+	return WriteRead(&reg, 1, _value, 1);
+}
+
+
+status_t
+BI2CDevice::WriteRegister(uint8 reg, uint8 value)
+{
+	uint8 bytes[2] = { reg, value };
+	ssize_t written = Write(bytes, sizeof(bytes));
+	return written < 0 ? (status_t)written : B_OK;
+}
+
+
+bool
+BI2CDevice::IsPresent()
+{
+	return fFd >= 0 && _Transfer(fFd, fAddress, NULL, 0, NULL, 0) == B_OK;
+}
+
+
+int32
+BI2CDevice::CountDevices()
+{
+	return access(MESON_I2C_HEADER_DEVICE, F_OK) == 0 ? 1 : 0;
+}
+
+
+status_t
+BI2CDevice::GetDeviceName(int32 index, char* name, size_t bufSize)
+{
+	if (name == NULL || index < 0)
+		return B_BAD_VALUE;
+	if (index >= CountDevices())
+		return B_BAD_INDEX;
+	strlcpy(name, kBusName, bufSize);
+	return B_OK;
+}
+
+
+/*!	Each address from 0x08 to 0x77 that a device answers (only the address
+	is sent, nothing written or read): up to \a maxCount of them.
+*/
+status_t
+BI2CDevice::Scan(const char* bus, uint8* addresses, int32 maxCount,
+	int32* _count)
+{
+	if (_count == NULL || (addresses == NULL && maxCount > 0))
+		return B_BAD_VALUE;
+	if (bus == NULL || strcasecmp(bus, kBusName) != 0)
+		return B_ENTRY_NOT_FOUND;
+	int fd = fFd;
+	if (fd < 0) {
+		fd = open(MESON_I2C_HEADER_DEVICE, O_RDWR | O_CLOEXEC);
+		if (fd < 0)
+			return errno == ENOENT ? B_ENTRY_NOT_FOUND : errno;
+	}
+	int32 count = 0;
+	status_t status = B_OK;
+	for (uint8 address = kFirstAddress; address <= kLastAddress; address++) {
+		status_t result = _Transfer(fd, address, NULL, 0, NULL, 0);
+		if (result == B_OK) {
+			if (count < maxCount)
+				addresses[count] = address;
+			count++;
+		} else if (result != B_DEV_NOT_READY) {
+			status = result;
+			break;
+		}
+	}
+	if (fd != fFd)
+		close(fd);
+	*_count = min_c(count, maxCount);
+	return status;
+}
+
+
+void
+BI2CDevice::_ReservedI2CDevice1()
+{
+}
+
+
+void
+BI2CDevice::_ReservedI2CDevice2()
+{
+}
+
+
+void
+BI2CDevice::_ReservedI2CDevice3()
+{
+}
