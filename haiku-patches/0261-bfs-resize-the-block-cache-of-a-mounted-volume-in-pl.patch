From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Mon, 2 Nov 2026 16:42:40 -0500
Subject: [PATCH 261/342] bfs: resize the block cache of a mounted volume in
 place

Growing a mounted volume (BFS_IOCTL_RESIZE) replaced its block cache
with a new one and deleted the old one, but readers don't take the
journal lock that Volume::ResizeBlockCache() held: a thread in
block_cache_get_etc() on the old cache crashed (a boot volume grown at
boot took Tracker down reading an attribute). The cache now changes its
number of blocks in place (block_cache_set_num_blocks(), also in the
fs_shell), and BlockAllocator::Allocate() reads the allocation groups,
which Reinitialize() replaces, under the allocator lock.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 headers/os/drivers/fs_cache.h                 |  1 +
 headers/private/fs_shell/fssh_api_wrapper.h   |  1 +
 headers/private/fs_shell/fssh_fs_cache.h      |  2 ++
 .../file_systems/bfs/BlockAllocator.cpp       |  3 +++
 .../kernel/file_systems/bfs/Volume.cpp        | 20 ++++++++-----------
 src/system/kernel/cache/block_cache.cpp       | 19 ++++++++++++++++++
 src/tools/fs_shell/block_cache.cpp            | 13 ++++++++++++
 7 files changed, 47 insertions(+), 12 deletions(-)

diff --git a/headers/os/drivers/fs_cache.h b/headers/os/drivers/fs_cache.h
index 1d0d2729a4..96b26523f2 100644
--- a/headers/os/drivers/fs_cache.h
+++ b/headers/os/drivers/fs_cache.h
@@ -59,6 +59,7 @@ extern bool cache_has_block_in_transaction(void* cache, int32 id, off_t blockNum
 extern void block_cache_delete(void *cache, bool allowWrites);
 extern void *block_cache_create(int fd, off_t numBlocks, size_t blockSize,
 					bool readOnly);
+extern status_t block_cache_set_num_blocks(void *cache, off_t numBlocks);
 extern status_t block_cache_sync(void *cache);
 extern status_t block_cache_sync_etc(void *cache, off_t blockNumber,
 					size_t numBlocks);
diff --git a/headers/private/fs_shell/fssh_api_wrapper.h b/headers/private/fs_shell/fssh_api_wrapper.h
index 06ab98f2c8..036238c4a6 100644
--- a/headers/private/fs_shell/fssh_api_wrapper.h
+++ b/headers/private/fs_shell/fssh_api_wrapper.h
@@ -857,6 +857,7 @@
 /* block cache */
 #define block_cache_delete				fssh_block_cache_delete
 #define block_cache_create				fssh_block_cache_create
+#define block_cache_set_num_blocks		fssh_block_cache_set_num_blocks
 #define block_cache_sync				fssh_block_cache_sync
 #define block_cache_sync_etc			fssh_block_cache_sync_etc
 #define block_cache_discard				fssh_block_cache_discard
diff --git a/headers/private/fs_shell/fssh_fs_cache.h b/headers/private/fs_shell/fssh_fs_cache.h
index bd64ba3f16..d741550721 100644
--- a/headers/private/fs_shell/fssh_fs_cache.h
+++ b/headers/private/fs_shell/fssh_fs_cache.h
@@ -69,6 +69,8 @@ extern bool				fssh_cache_has_block_in_transaction(void *_cache,
 extern void				fssh_block_cache_delete(void *_cache, bool allowWrites);
 extern void *			fssh_block_cache_create(int fd, fssh_off_t numBlocks,
 							fssh_size_t blockSize, bool readOnly);
+extern fssh_status_t	fssh_block_cache_set_num_blocks(void *_cache,
+							fssh_off_t numBlocks);
 extern fssh_status_t	fssh_block_cache_sync(void *_cache);
 extern fssh_status_t	fssh_block_cache_sync_etc(void *_cache,
 							fssh_off_t blockNumber, fssh_size_t numBlocks);
diff --git a/src/add-ons/kernel/file_systems/bfs/BlockAllocator.cpp b/src/add-ons/kernel/file_systems/bfs/BlockAllocator.cpp
index 39a5a61870..fcac2ecf1c 100644
--- a/src/add-ons/kernel/file_systems/bfs/BlockAllocator.cpp
+++ b/src/add-ons/kernel/file_systems/bfs/BlockAllocator.cpp
@@ -1181,8 +1181,11 @@ BlockAllocator::Allocate(Transaction& transaction, Inode* inode,
 		return B_ERROR;
 
 	// one block_run can't hold more data than there is in one allocation group
+	// (under the lock: resizing a mounted volume replaces fGroups)
+	RecursiveLocker locker(fLock);
 	if (numBlocks > fGroups[0].NumBits())
 		numBlocks = fGroups[0].NumBits();
+	locker.Unlock();
 
 	// since block_run.length is uint16, the largest number of blocks that
 	// can be covered by a block_run is 65535
diff --git a/src/add-ons/kernel/file_systems/bfs/Volume.cpp b/src/add-ons/kernel/file_systems/bfs/Volume.cpp
index c405a13f6c..7a26cb5372 100644
--- a/src/add-ons/kernel/file_systems/bfs/Volume.cpp
+++ b/src/add-ons/kernel/file_systems/bfs/Volume.cpp
@@ -333,18 +333,14 @@ Volume::ResizeBlockCache(off_t numBlocks)
 	if (status != B_OK)
 		return status;
 
-	void* newBlockCache = block_cache_create(fDevice, numBlocks, fBlockSize,
-		IsReadOnly());
-
-	if (newBlockCache != NULL) {
-		block_cache_delete(fBlockCache, false);
-			// we have the journal flushed and locked, so there can't be
-			// any unwritten blocks in this cache
-
-		fBlockCache = newBlockCache;
-		status = B_OK;
-	} else
-		status = B_ERROR;
+	// The cache is resized in place: a mounted volume's readers don't take
+	// the journal lock, and a new cache in its place was freed under them
+	// (a boot volume grown at boot crashed Tracker reading an attribute).
+	if (numBlocks < NumBlocks()) {
+		// the blocks past the new end are free, and the journal is flushed
+		block_cache_discard(fBlockCache, numBlocks, NumBlocks() - numBlocks);
+	}
+	status = block_cache_set_num_blocks(fBlockCache, numBlocks);
 
 	fJournal->Unlock(NULL, true);
 	return status;
diff --git a/src/system/kernel/cache/block_cache.cpp b/src/system/kernel/cache/block_cache.cpp
index 8961c14a10..a4640c5ddb 100644
--- a/src/system/kernel/cache/block_cache.cpp
+++ b/src/system/kernel/cache/block_cache.cpp
@@ -3850,6 +3850,25 @@ block_cache_create(int fd, off_t numBlocks, size_t blockSize, bool readOnly)
 }
 
 
+/*!	Changes the number of blocks the cache serves, for a file system that
+	resizes its volume while it is mounted: other threads keep using the
+	cache all the while, so it cannot be replaced by a new one.
+	Blocks past a smaller end stay cached until they are reclaimed; the caller
+	writes them back or discards them first.
+*/
+status_t
+block_cache_set_num_blocks(void* _cache, off_t numBlocks)
+{
+	block_cache* cache = (block_cache*)_cache;
+	if (numBlocks <= 0)
+		return B_BAD_VALUE;
+
+	WriteLocker locker(&cache->lock);
+	cache->max_blocks = numBlocks;
+	return B_OK;
+}
+
+
 status_t
 block_cache_sync(void* _cache)
 {
diff --git a/src/tools/fs_shell/block_cache.cpp b/src/tools/fs_shell/block_cache.cpp
index 34e88e5e75..73e24f5022 100644
--- a/src/tools/fs_shell/block_cache.cpp
+++ b/src/tools/fs_shell/block_cache.cpp
@@ -1533,6 +1533,19 @@ fssh_block_cache_create(int fd, fssh_off_t numBlocks, fssh_size_t blockSize, boo
 }
 
 
+fssh_status_t
+fssh_block_cache_set_num_blocks(void* _cache, fssh_off_t numBlocks)
+{
+	block_cache* cache = (block_cache*)_cache;
+	if (numBlocks <= 0)
+		return FSSH_B_BAD_VALUE;
+
+	MutexLocker locker(&cache->lock);
+	cache->max_blocks = numBlocks;
+	return FSSH_B_OK;
+}
+
+
 fssh_status_t
 fssh_block_cache_sync(void* _cache)
 {
