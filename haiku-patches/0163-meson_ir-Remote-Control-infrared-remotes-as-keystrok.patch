@@ -0,0 +1,109 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef REMOTE_PROFILE_H
+#define REMOTE_PROFILE_H
+
+
+/*!	A remote control's profile: which remote (protocol and address), and
+	the keystroke each of its buttons sends. One file per profile in
+	~/config/settings/Remote Control/, a flattened BMessage; shared by the
+	input_server add-on and the Remote Control preferences.
+*/
+
+
+#include <ObjectList.h>
+#include <String.h>
+
+
+class BMessage;
+class BPath;
+
+
+namespace RemoteControl {
+
+
+// BInputDevice::Control() codes of the input_server add-on (device
+// "Remote Control"), from the preferences
+enum {
+	kMsgReloadProfiles	= 'rcRL',	// the profile files changed
+	kMsgStartLearning	= 'rcL+',	// "messenger": gets kMsgButtonEvent
+	kMsgStopLearning	= 'rcL-',	// keys again
+	kMsgButtonEvent		= 'rcEV'	// "protocol", "address", "command",
+									// "flags" (int32), "when" (int64)
+};
+
+static const char* const kDeviceName = "Remote Control";
+
+
+struct Button {
+	BString		label;
+	uint32		command;
+	uint32		key;			// raw key code, 0 for none
+	uint32		modifiers;
+	bool		repeat;			// held: key repeats; else one press
+};
+
+
+class Profile {
+public:
+								Profile();
+								Profile(const Profile& other);
+
+			Profile&			operator=(const Profile& other);
+
+			status_t			Archive(BMessage* archive) const;
+			status_t			Unarchive(const BMessage& archive);
+
+			status_t			Load(const char* path);
+			status_t			Save() const;
+			status_t			Remove() const;
+	// the file this profile is saved in
+			status_t			GetPath(BPath* path) const;
+
+			const BString&		Name() const { return fName; }
+			void				SetName(const char* name) { fName = name; }
+			bool				IsEnabled() const { return fEnabled; }
+			void				SetEnabled(bool enabled)
+									{ fEnabled = enabled; }
+			uint32				Protocol() const { return fProtocol; }
+			uint32				Address() const { return fAddress; }
+			void				SetRemote(uint32 protocol, uint32 address)
+									{ fProtocol = protocol;
+									  fAddress = address; }
+			bool				HasRemote() const { return fProtocol != 0; }
+
+	// whether an event of this protocol and address is from this remote
+			bool				Matches(uint32 protocol,
+									uint32 address) const;
+
+			int32				CountButtons() const
+									{ return fButtons.CountItems(); }
+			Button*				ButtonAt(int32 index) const
+									{ return fButtons.ItemAt(index); }
+			Button*				FindButton(uint32 command) const;
+			Button*				AddButton(const Button& button);
+			void				RemoveButton(int32 index);
+			void				MoveButton(int32 from, int32 to);
+
+	static	status_t			GetDirectory(BPath* path, bool create);
+	// every profile in the settings directory, by name
+	static	status_t			LoadAll(BObjectList<Profile, true>& profiles);
+	// the protocol's family: RC-5 and RC-5X are one remote
+	static	uint32				Family(uint32 protocol);
+	static	const char*			ProtocolName(uint32 protocol);
+
+private:
+			BString				fName;
+			bool				fEnabled;
+			uint32				fProtocol;
+			uint32				fAddress;
+			BObjectList<Button, true> fButtons;
+};
+
+
+}	// namespace RemoteControl
+
+
+#endif	// REMOTE_PROFILE_H
