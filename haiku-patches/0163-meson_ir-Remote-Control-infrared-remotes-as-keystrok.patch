+
+			BTextControl*		fNameControl;
+			BCheckBox*			fEnabledBox;
+			BStringView*		fRemoteView;
+			BButton*			fForgetRemoteButton;
+			BColumnListView*	fButtonList;
+
+			BTextControl*		fLabelControl;
+			KeystrokeView*		fKeystrokeView;
+			BMenuField*			fKeyMenuField;
+			BCheckBox*			fRepeatBox;
+			BButton*			fRemoveButton;
+			BButton*			fUpButton;
+			BButton*			fDownButton;
