+
+//	#pragma mark - device module
+
+
+static status_t
+device_init(void* driverCookie, void** _deviceCookie)
+{
+	*_deviceCookie = driverCookie;
+	return B_OK;
+}
+
+
+static void
+device_uninit(void* deviceCookie)
+{
+	(void)deviceCookie;
+}
+
+
+static status_t
+device_open(void* deviceCookie, const char* path, int openMode,
+	void** _cookie)
+{
+	(void)path;
+	ReaderCookie* cookie = new(std::nothrow) ReaderCookie;
+	if (cookie == NULL)
+		return B_NO_MEMORY;
+	cookie->device = (MesonIr*)deviceCookie;
+	cookie->openMode = openMode;
+	status_t status = cookie->device->Open(cookie);
+	if (status != B_OK) {
+		delete cookie;
+		return status;
+	}
+	*_cookie = cookie;
+	return B_OK;
+}
+
+
+static status_t
+device_close(void* cookie)
+{
+	(void)cookie;
+	return B_OK;
+}
+
+
+static status_t
+device_free(void* _cookie)
+{
+	ReaderCookie* cookie = (ReaderCookie*)_cookie;
+	cookie->device->Close(cookie);
+	delete cookie;
+	return B_OK;
+}
+
+
+static status_t
+device_read(void* _cookie, off_t position, void* buffer, size_t* _length)
+{
+	(void)position;
+	ReaderCookie* cookie = (ReaderCookie*)_cookie;
+	return cookie->device->Read(cookie, buffer, _length);
+}
+
+
+static status_t
+device_write(void* cookie, off_t position, const void* buffer,
+	size_t* _length)
+{
+	(void)cookie;
+	(void)position;
+	(void)buffer;
+	*_length = 0;
+	return B_NOT_ALLOWED;
+}
+
+
+static status_t
+device_control(void* _cookie, uint32 op, void* buffer, size_t length)
+{
+	ReaderCookie* cookie = (ReaderCookie*)_cookie;
+	return cookie->device->Control(cookie, op, buffer, length);
+}
+
+
+module_dependency module_dependencies[] = {
+	{ B_DEVICE_MANAGER_MODULE_NAME, (module_info**)&gDeviceManager },
+	{}
+};
+
+
+static struct device_module_info sMesonIrDevice = {
+	{
+		DEVICE_MODULE_NAME,
+		0,
+		NULL
+	},
+
+	device_init,
+	device_uninit,
+	NULL,	// remove
+
+	device_open,
+	device_close,
+	device_free,
+	device_read,
+	device_write,
+	NULL,	// io
+	device_control,
+
+	NULL,	// select
+	NULL,	// deselect
+};
+
+
+static struct driver_module_info sMesonIrDriver = {
+	{
+		DRIVER_MODULE_NAME,
+		0,
+		NULL
+	},
+
+	supports_device,
+	register_device,
+	init_driver,
+	uninit_driver,
+	register_child_devices,
+	NULL,	// rescan
+	NULL,	// removed
+};
+
+
+module_info* modules[] = {
+	(module_info*)&sMesonIrDriver,
+	(module_info*)&sMesonIrDevice,
+	NULL
+};
