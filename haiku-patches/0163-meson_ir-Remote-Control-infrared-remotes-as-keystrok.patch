+ */
+#ifndef TEMPLATES_H
+#define TEMPLATES_H
+
+
+#include <SupportDefs.h>
+
+
+struct TemplateButton {
+	const char*	label;
+	uint32		key;
+	uint32		modifiers;
+	bool		repeat;
+};
+
+struct Template {
+	const char*				name;
+	const TemplateButton*	buttons;
+	int32					count;
+};
+
+// buttons named for what they do in an application, with its keystrokes
+extern const Template kTemplates[];
+extern const int32 kTemplateCount;
