+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef KEY_NAMES_H
+#define KEY_NAMES_H
+
+
+#include <String.h>
+#include <SupportDefs.h>
+
+
+// Haiku's raw key codes (the keyboard layouts' numbering) and the media
+// keys as the HID keyboard driver reports them: usage page << 16 | usage
+enum {
+	kKeyEscape		= 0x01,
+	kKeyF1			= 0x02,
+	kKeyBackspace	= 0x1e,
+	kKeyInsert		= 0x1f,
+	kKeyHome		= 0x20,
+	kKeyPageUp		= 0x21,
+	kKeyTab			= 0x26,
+	kKeyDelete		= 0x34,
+	kKeyEnd			= 0x35,
+	kKeyPageDown	= 0x36,
+	kKeyEnter		= 0x47,
+	kKeyUp			= 0x57,
+	kKeySpace		= 0x5e,
+	kKeyLeft		= 0x61,
+	kKeyDown		= 0x62,
+	kKeyRight		= 0x63,
+	kKeyMenu		= 0x68,
+	kKeyM			= 0x52,
+	kKeyF			= 0x3f,
+	kKeyPeriod		= 0x54,
+
+	kKeyVolumeUp	= 0x0c00e9,
+	kKeyVolumeDown	= 0x0c00ea,
+	kKeyMute		= 0x0c00e2,
+	kKeyPlayPause	= 0x0c00cd,
+	kKeyNextTrack	= 0x0c00b5,
+	kKeyPreviousTrack = 0x0c00b6,
+	kKeyStop		= 0x0c00b7
+};
+
+
+struct NamedKey {
+	uint32		key;
+	const char*	name;
+};
+
+extern const NamedKey kNamedKeys[];
+extern const int32 kNamedKeyCount;
+
+
+// "Command+Shift+Right arrow", "Space", "Volume up", "None"
+BString KeystrokeName(uint32 key, uint32 modifiers);
+bool IsModifierKey(uint32 key);
+
+
+#endif	// KEY_NAMES_H
