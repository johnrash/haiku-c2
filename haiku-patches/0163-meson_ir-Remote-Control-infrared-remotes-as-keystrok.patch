new file mode 100644
index 0000000000..50027d7ae5
--- /dev/null
+++ b/src/preferences/remotecontrol/KeyNames.cpp
@@ -0,0 +1,92 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "KeyNames.h"
+
+#include <ctype.h>
+#include <stdio.h>
+
+#include <InterfaceDefs.h>
+
+#include <AutoDeleter.h>
+#include <Keymap.h>
+
+
+const NamedKey kNamedKeys[] = {
+	{ kKeySpace, "Space" },
+	{ kKeyEnter, "Enter" },
+	{ kKeyEscape, "Escape" },
+	{ kKeyTab, "Tab" },
+	{ kKeyBackspace, "Backspace" },
+	{ kKeyDelete, "Delete" },
+	{ kKeyInsert, "Insert" },
+	{ kKeyUp, "Up arrow" },
+	{ kKeyDown, "Down arrow" },
+	{ kKeyLeft, "Left arrow" },
+	{ kKeyRight, "Right arrow" },
+	{ kKeyPageUp, "Page up" },
+	{ kKeyPageDown, "Page down" },
+	{ kKeyHome, "Home" },
+	{ kKeyEnd, "End" },
+	{ kKeyMenu, "Menu" },
+	{ kKeyVolumeUp, "Volume up" },
+	{ kKeyVolumeDown, "Volume down" },
+	{ kKeyMute, "Mute" },
+	{ kKeyPlayPause, "Play/pause" },
+	{ kKeyNextTrack, "Next track" },
+	{ kKeyPreviousTrack, "Previous track" },
+	{ kKeyStop, "Stop" },
+};
+const int32 kNamedKeyCount = B_COUNT_OF(kNamedKeys);
+
+
+bool
+IsModifierKey(uint32 key)
+{
+	BKeymap keymap;
+	return keymap.SetToCurrent() == B_OK && keymap.IsModifierKey(key);
+}
+
+
+BString
+KeystrokeName(uint32 key, uint32 modifiers)
+{
+	if (key == 0)
+		return BString("None");
+
+	BString name;
+	if ((modifiers & B_COMMAND_KEY) != 0)
+		name << "Command+";
+	if ((modifiers & B_CONTROL_KEY) != 0)
+		name << "Control+";
+	if ((modifiers & B_OPTION_KEY) != 0)
+		name << "Option+";
+	if ((modifiers & B_SHIFT_KEY) != 0)
+		name << "Shift+";
+
+	for (int32 i = 0; i < kNamedKeyCount; i++) {
+		if (kNamedKeys[i].key == key)
+			return name << kNamedKeys[i].name;
+	}
+	if (key >= kKeyF1 && key < kKeyF1 + 12)
+		return name << "F" << key - kKeyF1 + 1;
+
+	// what the key types without modifiers
+	BKeymap keymap;
+	char* chars = NULL;
+	int32 count = 0;
+	if (key < 128 && keymap.SetToCurrent() == B_OK)
+		keymap.GetChars(key, 0, 0, &chars, &count);
+	ArrayDeleter<char> charsDeleter(chars);
+	if (count == 1 && isprint((uint8)chars[0]))
+		return name << (char)toupper((uint8)chars[0]);
+	if (count > 0)
+		return name << chars;
+
+	char code[24];
+	snprintf(code, sizeof(code), "Key 0x%" B_PRIx32, key);
+	return name << code;
+}
