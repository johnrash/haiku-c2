@@ -0,0 +1,174 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef IR_DECODER_H
+#define IR_DECODER_H
+
+
+/*!	Infrared remote control protocols decoded from mark and space
+	durations, in software, as a receiver in raw mode delivers them. No
+	hardware here: the decoders also build and run on the build host
+	(tools/tests/irdecoder-test.cpp).
+
+	Each pulse goes to every decoder; the first one to finish a frame wins,
+	and all start over. Frames that end with a space (RC-5, RC-6, Sony,
+	JVC) are finished by the gap after them: when no edge comes, the caller
+	feeds one with Gap().
+*/
+
+
+#include <SupportDefs.h>
+
+#include <ir_remote.h>
+
+
+namespace IRRemote {
+
+
+// longer than any space inside a frame of these protocols (RC-6's leader
+// space is 0.9 ms, NEC's header space 4.5 ms): the end of a frame
+static const uint32 kGap = 6000;
+
+
+class Decoder {
+public:
+	virtual				~Decoder() {}
+	virtual	void		Reset() = 0;
+	// true and *event filled (protocol, address, command, flags) when the
+	// pulse finishes a frame
+	virtual	bool		Feed(bool mark, uint32 duration,
+							ir_remote_event* event) = 0;
+};
+
+
+class NECDecoder : public Decoder {
+public:
+						NECDecoder() { Reset(); }
+	virtual	void		Reset();
+	virtual	bool		Feed(bool mark, uint32 duration,
+							ir_remote_event* event);
+private:
+			enum { kIdle, kHeaderSpace, kBitMark, kBitSpace, kStopMark,
+				kRepeatMark };
+			int			fState;
+			uint32		fBits;
+			uint32		fCount;
+};
+
+
+class RC5Decoder : public Decoder {
+public:
+						RC5Decoder() : fArmed(true) { Reset(); }
+	virtual	void		Reset();
+	virtual	bool		Feed(bool mark, uint32 duration,
+							ir_remote_event* event);
+private:
+			bool		_Add(bool mark, uint32 count);
+			bool		_Finish(ir_remote_event* event);
+
+			uint8		fHalves[28];	// half bits: 1 = mark
+			uint32		fCount;
+			bool		fArmed;			// after silence: a frame may start
+			bool		fComplete;		// all halves, waiting for the gap
+};
+
+
+class RC6Decoder : public Decoder {
+public:
+						RC6Decoder() { Reset(); }
+	virtual	void		Reset();
+	virtual	bool		Feed(bool mark, uint32 duration,
+							ir_remote_event* event);
+private:
+			bool		_Finish(ir_remote_event* event);
+
+			enum { kIdle, kLeaderSpace, kBody, kComplete };
+			int			fState;
+			uint8		fUnits[44];		// units of 444 us: 1 = mark
+			uint32		fCount;
+			uint32		fLeaderMark;
+			uint32		fUnit;			// as measured on the leader
+			int32		fStretch;		// marks longer than sent (leader)
+};
+
+
+class SonyDecoder : public Decoder {
+public:
+						SonyDecoder() { Reset(); }
+	virtual	void		Reset();
+	virtual	bool		Feed(bool mark, uint32 duration,
+							ir_remote_event* event);
+private:
+			enum { kIdle, kHeaderSpace, kBitMark, kBitSpace };
+			int			fState;
+			uint32		fBits;
+			uint32		fCount;
+			uint32		fHeaderMark;
+			uint32		fOneMark;		// shorter bit marks are 0s
+};
+
+
+class JVCDecoder : public Decoder {
+public:
+						JVCDecoder() : fSinceFrame(~0u) { Reset(); }
+	virtual	void		Reset();
+	virtual	bool		Feed(bool mark, uint32 duration,
+							ir_remote_event* event);
+	// time since the last JVC frame ended (for headerless repeats)
+			void		Elapse(uint32 duration);
+private:
+			enum { kIdle, kHeaderSpace, kBitMark, kBitSpace, kEnd };
+			int			fState;
+			bool		fRepeat;		// a frame without the header
+			uint32		fBits;
+			uint32		fCount;
+			uint32		fSinceFrame;
+};
+
+
+class Receiver {
+public:
+								Receiver();
+
+			void				Reset();
+	// one mark or space as measured; true when a frame was decoded
+			bool				Feed(bool mark, uint32 duration,
+									ir_remote_event* event);
+	// no edge for a while: the space so far ends any frame
+			bool				Gap(ir_remote_event* event);
+
+			uint32				Frames() const { return fFrames; }
+			uint32				Repeats() const { return fRepeats; }
+			uint32				Unknown() const { return fUnknown; }
+
+private:
+			bool				_FeedAll(bool mark, uint32 duration,
+									ir_remote_event* event);
+			bool				_Decoded(ir_remote_event* event);
+
+			NECDecoder			fNEC;
+			RC5Decoder			fRC5;
+			RC6Decoder			fRC6;
+			SonyDecoder			fSony;
+			JVCDecoder			fJVC;
+			Decoder*			fDecoders[5];
+
+			// the last frame, for repeats; time is counted in pulses
+			ir_remote_event		fLast;
+			bool				fHaveLast;
+			uint32				fSinceLast;		// us
+			uint32				fPulses;		// since the last gap
+			bool				fDecodedSinceGap;
+			bool				fInGap;
+
+			uint32				fFrames;
+			uint32				fRepeats;
+			uint32				fUnknown;
+};
+
+
+}	// namespace IRRemote
+
+
+#endif	// IR_DECODER_H
