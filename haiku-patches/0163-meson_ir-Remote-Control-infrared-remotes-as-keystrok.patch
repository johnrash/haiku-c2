+#define DRIVER_MODULE_NAME	"drivers/input/meson_ir/driver_v1"
+#define DEVICE_MODULE_NAME	"drivers/input/meson_ir/device_v1"
+
+#define INFO(x...) dprintf("meson_ir: " x)
+
+
+static const uint32 kEventCount = 64;		// the ring every reader reads
+static const uint32 kPulseCount = 1024;		// raw pulses kept for learning
+// no edge for this long: the space so far ends any frame
+static const bigtime_t kGapTimeout = IRRemote::kGap;
+
+
+static device_manager_info* gDeviceManager;
+
+
+struct ReaderCookie;
+
+
+class MesonIr {
+public:
+								MesonIr(device_node* node);
+								~MesonIr();
+
+			status_t			Init(phys_addr_t registers, int32 vector);
+			device_node*		Node() const { return fNode; }
+
+			status_t			Open(ReaderCookie* cookie);
+			void				Close(ReaderCookie* cookie);
+			status_t			Read(ReaderCookie* cookie, void* buffer,
+									size_t* _length);
+			status_t			Wait(ReaderCookie* cookie, bigtime_t timeout);
+			status_t			Control(ReaderCookie* cookie, uint32 op,
+									void* buffer, size_t length);
+
+private:
+			status_t			_Start();
+			void				_Stop();
+
+			uint32				_Read(uint32 offset) const
+									{ return *(volatile uint32*)
+										(fRegisters + offset); }
+			void				_Write(uint32 offset, uint32 value)
+									{ *(volatile uint32*)
+										(fRegisters + offset) = value; }
+			void				_Modify(uint32 offset, uint32 clear,
+									uint32 set);
+			void				_RestartGapTimer();
+
+			void				_Pulse(bool mark, uint32 duration);
+			void				_Push(const ir_remote_event& event);
+
+	static	int32				_Interrupt(void* data);
+	static	int32				_GapTimer(timer* timer);
+
+			device_node*		fNode;
+			mutex				fLock;			// opens, closes
+			uint32				fOpenCount;
+
+			// hardware
+			area_id				fArea;
+			volatile uint8*		fRegisters;		// the AO page
+			uint32				fBlock;			// the receiver in it
+			int32				fVector;
+			bool				fRunning;
+			bool				fFirstEdge;
+
+			// all below: fSpinlock, interrupts off
+			spinlock			fSpinlock;
+			IRRemote::Receiver	fReceiver;
+			timer				fGapTimer;
+			bool				fGapTimerArmed;
+			bigtime_t			fLastEdge;
+
+			ir_remote_event		fEvents[kEventCount];
+			uint64				fEventSequence;	// of the next event
+			ConditionVariable	fEventCondition;
+
+			ir_remote_pulse		fPulses[kPulseCount];
+			uint32				fPulseFirst;
+			uint32				fPulseCount;
+			bool				fCollectPulses;
+
+			uint32				fEdges;
+			uint32				fOverruns;
+};
+
+
+struct ReaderCookie {
+	MesonIr*	device;
+	uint64		next;		// sequence of the next event to read
+	int			openMode;
+};
+
+
+//	#pragma mark - hardware
+
+/*!	Everything that touches the receiver's registers is in this section;
+	see docs/m24-ir-facts.md. The receiver is the "multi-format" decoder of
+	the always-on domain, at 0xc8100580 in the page mapped here.
+*/
+
+static const phys_addr_t kAoBusBase = 0xc8100000;
+static const uint64 kAoBusSize = 0x100000;
+
+// the always-on page (offsets from 0xc8100000)
+static const uint32 kPinMux = 0x14;			// AO_RTI_PIN_MUX_REG
+static const uint32 kGpioInput = 0x28;		// AO_GPIO_I
+static const uint32 kPullEnable = 0x2c;		// AO_RTI_PULL_UP_REG, bits 0-15
+static const uint32 kGenControl = 0x40;		// AO_RTI_GEN_CNTL_REG0
+static const uint32 kLegacyReg1 = 0x49c;	// the older NEC-only decoder
+
+static const uint32 kPinRemoteInput = 1u << 0;	// GPIOAO_7 to the receiver
+static const uint32 kPinRemoteOutput = 1u << 21;	// GPIOAO_7 as IR output
+static const uint32 kGpioAo7 = 1u << 7;
+static const uint32 kIrClock = 1u << 0;
+
+// the receiver's registers (offsets from it)
+enum {
+	REG0		= 0x10,		// time base
+	FRAME		= 0x14,
+	STATUS		= 0x18,
+	REG1		= 0x1c,		// width, enable, interrupt select, reset
+	REG2		= 0x20		// decode mode
+};
+
+static const uint32 kReg0BaseMask = 0xfff;
+static const uint32 kReg0Base10us = 9;		// ticks of (9 + 1) * 1 us
+static const uint32 kReg0Base20us = 19;		// the hardware decoders'
+static const uint32 kReg1Reset = 1u << 0;
+static const uint32 kReg1BothEdges = 1u << 2;	// interrupt select 01
+static const uint32 kReg1Enable = 1u << 15;
+static const uint32 kReg2ModeMask = 0xf;
+static const uint32 kReg2ModeRaw = 2;		// "general time measurement"
+static const uint32 kStatusLevel = 1u << 8;	// the input after the edge
+
+static const uint32 kTick = 10;				// us
+static const uint32 kWidthMask = 0x1fff;	// REG1 bits 28:16, ~82 ms
+// longer than the counter can say: the system time tells
+static const bigtime_t kLongInterval = 80000;
+
+
+void
+MesonIr::_Modify(uint32 offset, uint32 clear, uint32 set)
+{
+	_Write(offset, (_Read(offset) & ~clear) | set);
+}
+
+
+status_t
+MesonIr::_Start()
+{
+	// the clock gate is on from reset; the IR module reset (bit 16) stays
+	// as it is
+	if ((_Read(kGenControl) & kIrClock) == 0)
+		_Modify(kGenControl, 0, kIrClock);
+
+	// the pad: to the receiver, not the IR output; no pull (the receiver
+	// module drives it). Read-modify-write: the console is in these too.
+	{
+		InterruptsLocker locker;
+		_Modify(kPinMux, kPinRemoteOutput, kPinRemoteInput);
+		_Modify(kPullEnable, kGpioAo7, 0);
+	}
+
+	// a previous owner may have left it decoding: stop and reset it, then
+	// raw mode, 10 us ticks, an interrupt at every edge
+	_Write(fBlock + REG1, kReg1Reset);
+	_Write(fBlock + REG1, 0);
+	_Write(fBlock + REG2, kReg2ModeRaw);
+	_Write(fBlock + REG0, kReg0Base10us);
+	_Write(fBlock + REG1, kReg1BothEdges);
+	_Read(fBlock + STATUS);
+	_Read(fBlock + FRAME);
+
+	{
+		InterruptsSpinLocker locker(fSpinlock);
+		fReceiver.Reset();
+		fFirstEdge = true;
+		fLastEdge = system_time();
+		fRunning = true;
+	}
+	arch_int_configure_io_interrupt(fVector, B_EDGE_TRIGGERED,
+		B_RISING_EDGE_POLARITY);
+	status_t status = install_io_interrupt_handler(fVector, &_Interrupt,
+		this, 0);
+	if (status != B_OK) {
+		InterruptsSpinLocker locker(fSpinlock);
+		fRunning = false;
+		return status;
+	}
+	_Write(fBlock + REG1, kReg1BothEdges | kReg1Enable);
+	return B_OK;
+}
+
+
+void
+MesonIr::_Stop()
+{
+	if (fRegisters == NULL)
+		return;
+	{
+		InterruptsSpinLocker locker(fSpinlock);
+		if (!fRunning)
+			return;
+		fRunning = false;
+	}
+	_Write(fBlock + REG1, kReg1BothEdges);
+	remove_io_interrupt_handler(fVector, &_Interrupt, this);
+	cancel_timer(&fGapTimer);
+
+	// back to what the hardware NEC decoder uses, as Linux leaves it (in
+	// case firmware wakes the board from the remote)
+	_Modify(fBlock + REG2, kReg2ModeMask, 0);
+	_Modify(fBlock + REG0, kReg0BaseMask, kReg0Base20us);
+}
+
+
+/*!	An edge: the level after it says what the interval that just ended
+	was (the receiver module's output is low while it sees the carrier),
+	the width counter how long it was.
+*/
+/*static*/ int32
+MesonIr::_Interrupt(void* data)
+{
+	MesonIr* device = (MesonIr*)data;
+	bigtime_t now = system_time();
+	uint32 status = device->_Read(device->fBlock + STATUS);
+	uint32 reg1 = device->_Read(device->fBlock + REG1);
+
+	{
+		SpinLocker locker(device->fSpinlock);
+		if (!device->fRunning)
+			return B_HANDLED_INTERRUPT;
+		device->fEdges++;
+
+		bool mark = (status & kStatusLevel) != 0;
+		uint32 duration = ((reg1 >> 16) & kWidthMask) * kTick;
+		bigtime_t elapsed = now - device->fLastEdge;
+		device->fLastEdge = now;
+		if (device->fFirstEdge || elapsed >= kLongInterval) {
+			// longer than the counter goes: idle, a space
+			device->fFirstEdge = false;
+			duration = elapsed < 0x7fffffff ? (uint32)elapsed : 0x7fffffff;
+		} else if (duration == 0) {
+			// the counter sometimes reads 0 (Amlogic's driver says so)
+			duration = (uint32)elapsed;
+		}
+		device->_Pulse(mark, duration);
+	}
+
+	device->_RestartGapTimer();
+	return B_HANDLED_INTERRUPT;
+}
+
+
+/*!	kGapTimeout from now, unless another edge comes first. */
+void
+MesonIr::_RestartGapTimer()
+{
+	cancel_timer(&fGapTimer);
+	fGapTimer.user_data = this;
+	add_timer(&fGapTimer, &_GapTimer, kGapTimeout,
+		B_ONE_SHOT_RELATIVE_TIMER);
+}
+
+
+//	#pragma mark - decoding
+
+
+/*!	A mark or space as measured. Called with fSpinlock held. */
+void
+MesonIr::_Pulse(bool mark, uint32 duration)
+{
+	if (fCollectPulses) {
+		if (fPulseCount == kPulseCount) {
+			fPulseFirst = (fPulseFirst + 1) % kPulseCount;
+			fPulseCount--;
+		}
+		ir_remote_pulse& pulse
+			= fPulses[(fPulseFirst + fPulseCount) % kPulseCount];
+		pulse.duration = duration < 0x7fffffff ? duration : 0x7fffffff;
+		pulse.mark = mark ? 1 : 0;
+		fPulseCount++;
+	}
+
+	ir_remote_event event;
+	if (fReceiver.Feed(mark, duration, &event))
+		_Push(event);
+}
+
+
+/*!	A decoded frame for every reader. Called with fSpinlock held. */
+void
+MesonIr::_Push(const ir_remote_event& event)
+{
+	ir_remote_event& slot = fEvents[fEventSequence % kEventCount];
+	slot = event;
+	slot.when = system_time();
+	fEventSequence++;
+	fEventCondition.NotifyAll();
+}
+
+
+/*!	No edge for kGapTimeout: the space so far ends a frame. */
+/*static*/ int32
+MesonIr::_GapTimer(timer* timer)
+{
+	MesonIr* device = (MesonIr*)timer->user_data;
+	SpinLocker locker(device->fSpinlock);
+	device->fGapTimerArmed = false;
+	ir_remote_event event;
+	if (device->fReceiver.Gap(&event))
+		device->_Push(event);
+	return B_HANDLED_INTERRUPT;
+}
+
+
+//	#pragma mark - device
+
+
+MesonIr::MesonIr(device_node* node)
+	:
+	fNode(node),
+	fOpenCount(0),
+	fArea(-1),
+	fRegisters(NULL),
+	fBlock(0),
+	fVector(-1),
+	fRunning(false),
+	fFirstEdge(true),
+	fSpinlock(B_SPINLOCK_INITIALIZER),
+	fGapTimerArmed(false),
+	fLastEdge(0),
+	fEventSequence(0),
+	fPulseFirst(0),
+	fPulseCount(0),
+	fCollectPulses(false),
+	fEdges(0),
+	fOverruns(0)
+{
+	mutex_init(&fLock, "meson ir");
+	fEventCondition.Init(this, "meson ir event");
+	memset(&fGapTimer, 0, sizeof(fGapTimer));
+}
+
+
+MesonIr::~MesonIr()
+{
+	_Stop();
+	if (fArea >= 0)
+		delete_area(fArea);
+	mutex_destroy(&fLock);
+}
+
+
+status_t
+MesonIr::Init(phys_addr_t registers, int32 vector)
+{
+	phys_addr_t page = registers & ~(phys_addr_t)(B_PAGE_SIZE - 1);
+	fBlock = (uint32)(registers - page);
+	fVector = vector;
+	void* address;
+	fArea = map_physical_memory("meson ir", page, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		&address);
+	if (fArea < 0)
+		return fArea;
+	fRegisters = (volatile uint8*)address;
+
+	// what the receiver sees with no remote, and whether the older decoder
+	// runs too (it may share the interrupt)
+	INFO("receiver at %#" B_PRIxPHYSADDR ", interrupt %" B_PRId32 "; idle "
+		"level %s (pad %s), older decoder %s\n", registers, vector,
+		(_Read(fBlock + STATUS) & kStatusLevel) != 0 ? "high" : "low",
+		(_Read(kGpioInput) & kGpioAo7) != 0 ? "high" : "low",
+		(_Read(kLegacyReg1) & kReg1Enable) != 0 ? "enabled" : "off");
+	return B_OK;
+}
+
+
+status_t
+MesonIr::Open(ReaderCookie* cookie)
+{
+	MutexLocker locker(fLock);
+	if (fOpenCount == 0) {
+		status_t status = _Start();
+		if (status != B_OK)
+			return status;
+	}
+	fOpenCount++;
+
+	InterruptsSpinLocker spinLocker(fSpinlock);
+	cookie->next = fEventSequence;
+	return B_OK;
+}
+
+
+void
+MesonIr::Close(ReaderCookie* cookie)
+{
+	(void)cookie;
+	MutexLocker locker(fLock);
+	if (--fOpenCount == 0)
+		_Stop();
+}
+
+
+status_t
+MesonIr::Read(ReaderCookie* cookie, void* buffer, size_t* _length)
+{
+	size_t capacity = *_length / sizeof(ir_remote_event);
+	*_length = 0;
+	if (capacity == 0)
+		return B_BAD_VALUE;
+
+	ir_remote_event events[16];
+	if (capacity > B_COUNT_OF(events))
+		capacity = B_COUNT_OF(events);
+	size_t count = 0;
+
+	InterruptsSpinLocker locker(fSpinlock);
+	while (fEventSequence == cookie->next) {
+		if ((cookie->openMode & O_NONBLOCK) != 0)
+			return B_WOULD_BLOCK;
+		ConditionVariableEntry entry;
+		fEventCondition.Add(&entry);
+		locker.Unlock();
+		status_t status = entry.Wait(B_CAN_INTERRUPT);
+		locker.Lock();
+		if (status == B_INTERRUPTED)
+			return status;
+	}
+	if (fEventSequence - cookie->next > kEventCount) {
+		// fell behind: the oldest are gone
+		fOverruns++;
+		cookie->next = fEventSequence - kEventCount;
+	}
+	while (count < capacity && cookie->next < fEventSequence)
+		events[count++] = fEvents[cookie->next++ % kEventCount];
+	locker.Unlock();
+
+	size_t length = count * sizeof(ir_remote_event);
+	if (user_memcpy(buffer, events, length) != B_OK)
+		return B_BAD_ADDRESS;
+	*_length = length;
+	return B_OK;
+}
+
+
+/*!	Waits until \a cookie has an event to read, at most \a timeout. */
+status_t
+MesonIr::Wait(ReaderCookie* cookie, bigtime_t timeout)
+{
+	bigtime_t deadline = system_time() + timeout;
+	InterruptsSpinLocker locker(fSpinlock);
+	while (fEventSequence == cookie->next) {
+		if (system_time() >= deadline)
+			return B_TIMED_OUT;
+		ConditionVariableEntry entry;
+		fEventCondition.Add(&entry);
+		locker.Unlock();
+		status_t status = entry.Wait(B_CAN_INTERRUPT | B_ABSOLUTE_TIMEOUT,
+			deadline);
+		locker.Lock();
+		if (status == B_INTERRUPTED)
+			return status;
+	}
+	return B_OK;
+}
+
+
+status_t
+MesonIr::Control(ReaderCookie* cookie, uint32 op, void* buffer,
+	size_t length)
+{
+	switch (op) {
+		case IR_REMOTE_WAIT_FOR_EVENT:
+		{
+			bigtime_t timeout;
+			if (length < sizeof(timeout)
+				|| user_memcpy(&timeout, buffer, sizeof(timeout)) != B_OK)
+				return B_BAD_ADDRESS;
+			return Wait(cookie, timeout);
+		}
+
+		case IR_REMOTE_GET_STATS:
+		{
+			ir_remote_stats stats;
+			{
+				InterruptsSpinLocker locker(fSpinlock);
+				stats.frames = fReceiver.Frames();
+				stats.repeats = fReceiver.Repeats();
+				stats.unknown = fReceiver.Unknown();
+				stats.edges = fEdges;
+				stats.overruns = fOverruns;
+			}
+			if (length < sizeof(stats))
+				return B_BAD_VALUE;
+			return user_memcpy(buffer, &stats, sizeof(stats));
+		}
+
+		case IR_REMOTE_COLLECT_PULSES:
+		{
+			bool collect;
+			if (length < sizeof(collect)
+				|| user_memcpy(&collect, buffer, sizeof(collect)) != B_OK)
+				return B_BAD_ADDRESS;
+			InterruptsSpinLocker locker(fSpinlock);
+			fCollectPulses = collect;
+			fPulseFirst = 0;
+			fPulseCount = 0;
+			return B_OK;
+		}
+
+		case IR_REMOTE_READ_PULSES:
+		{
+			ir_remote_pulse pulses[256];
+			size_t count = length / sizeof(ir_remote_pulse);
+			if (count > B_COUNT_OF(pulses))
+				count = B_COUNT_OF(pulses);
+			{
+				InterruptsSpinLocker locker(fSpinlock);
+				if (count > fPulseCount)
+					count = fPulseCount;
+				for (size_t i = 0; i < count; i++)
+					pulses[i] = fPulses[(fPulseFirst + i) % kPulseCount];
+				fPulseFirst = (fPulseFirst + count) % kPulseCount;
+				fPulseCount -= count;
+			}
+			if (user_memcpy(buffer, pulses, count * sizeof(ir_remote_pulse))
+					!= B_OK)
+				return B_BAD_ADDRESS;
+			// the size copied, as ioctl's return value
+			return (status_t)(count * sizeof(ir_remote_pulse));
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+//	#pragma mark - driver module
+
+
+static float
+supports_device(device_node* parent)
+{
+	const char* bus;
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false)
+			!= B_OK || strcmp(bus, "fdt") != 0
+		|| gDeviceManager->get_attr_string(parent, "fdt/compatible",
+			&compatible, false) != B_OK
+		|| strcmp(compatible, "amlogic,meson-gxbb-ir") != 0) {
+		return 0.0f;
+	}
+	return 0.8f;
+}
+
+
+static status_t
+register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "Amlogic Meson GXBB infrared receiver" } },
+		{ NULL }
+	};
+	return gDeviceManager->register_node(parent, DRIVER_MODULE_NAME, attrs,
+		NULL, NULL);
+}
+
+
+static status_t
+init_driver(device_node* node, void** _cookie)
+{
+	DeviceNodePutter<&gDeviceManager> fdtNode(
+		gDeviceManager->get_parent_node(node));
+	fdt_device_module_info* fdtModule;
+	fdt_device* fdtDevice;
+	if (gDeviceManager->get_driver(fdtNode.Get(),
+			(driver_module_info**)&fdtModule, (void**)&fdtDevice) != B_OK) {
+		return B_ERROR;
+	}
+	int length;
+	const char* enabled = (const char*)fdtModule->get_prop(fdtDevice,
+		"status", &length);
+	if (enabled != NULL && strcmp(enabled, "okay") != 0
+		&& strcmp(enabled, "ok") != 0) {
+		return B_DEVICE_NOT_FOUND;
+	}
+	uint64 registers;
+	uint64 size;
+	uint64 vector = 0;
+	if (!fdtModule->get_reg(fdtDevice, 0, &registers, &size)
+		|| !fdtModule->get_interrupt(fdtDevice, 0, NULL, &vector)
+		|| vector == 0) {
+		return B_ERROR;
+	}
+	// The node sits in GXBB's AO bus, which maps its 1 MB of child
+	// addresses to 0xc8100000; the FDT bus gives the address untranslated.
+	if (registers < kAoBusSize)
+		registers += kAoBusBase;
+
+	MesonIr* device = new(std::nothrow) MesonIr(node);
+	if (device == NULL)
+		return B_NO_MEMORY;
+	status_t status = device->Init(registers, (int32)vector);
+	if (status != B_OK) {
+		delete device;
+		return status;
+	}
+	*_cookie = device;
+	return B_OK;
+}
+
+
+static void
+uninit_driver(void* cookie)
+{
+	delete (MesonIr*)cookie;
+}
+
+
+static status_t
+register_child_devices(void* cookie)
+{
+	MesonIr* device = (MesonIr*)cookie;
+	return gDeviceManager->publish_device(device->Node(),
+		"input/remote/meson_ir/0", DEVICE_MODULE_NAME);
+}
