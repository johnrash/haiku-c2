@@ -0,0 +1,989 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * The Remote Control preferences: a profile per remote, each button's
+ * keystroke, and learning buttons from the remote itself. Every change is
+ * saved at once and the input_server add-on rereads the profiles.
+ *
+ * Learning: the add-on passes the presses here instead of typing them. The
+ * first press gives a new profile its remote (protocol and address); a
+ * button the profile doesn't have yet goes to the selected row if that
+ * one has no code yet (rows from a template), else to a new row.
+ */
+
+
+#include "RemoteWindow.h"
+
+#include <stdio.h>
+
+#include <Alert.h>
+#include <Application.h>
+#include <Button.h>
+#include <CheckBox.h>
+#include <ColumnListView.h>
+#include <ColumnTypes.h>
+#include <ControlLook.h>
+#include <Directory.h>
+#include <File.h>
+#include <FilePanel.h>
+#include <Input.h>
+#include <LayoutBuilder.h>
+#include <ListView.h>
+#include <MenuField.h>
+#include <MenuItem.h>
+#include <MessageFilter.h>
+#include <Path.h>
+#include <PopUpMenu.h>
+#include <ScrollView.h>
+#include <SeparatorView.h>
+#include <StringItem.h>
+#include <StringView.h>
+#include <TextControl.h>
+
+#include <ir_remote.h>
+
+#include "KeyNames.h"
+#include "Templates.h"
+
+
+using RemoteControl::Button;
+using RemoteControl::Profile;
+
+
+// a row from a template whose button wasn't learned yet
+static const uint32 kUnlearned = 0xffffffff;
+
+enum {
+	kMsgProfileSelected		= 'pSel',
+	kMsgNewProfile			= 'pNew',
+	kMsgDuplicateProfile	= 'pDup',
+	kMsgDeleteProfile		= 'pDel',
+	kMsgImport				= 'pImp',
+	kMsgExport				= 'pExp',
+	kMsgNameChanged			= 'pNam',
+	kMsgEnabled				= 'pEna',
+	kMsgForgetRemote		= 'pFgt',
+	kMsgButtonSelected		= 'bSel',
+	kMsgLabelChanged		= 'bLab',
+	kMsgRepeat				= 'bRep',
+	kMsgRemoveButton		= 'bRem',
+	kMsgMoveUp				= 'bUp ',
+	kMsgMoveDown			= 'bDn ',
+	kMsgNamedKey			= 'bKey',
+	kMsgLearn				= 'lrn ',
+	kMsgTemplate			= 'tmpl'
+};
+
+enum {
+	kLabelColumn,
+	kCodeColumn,
+	kKeystrokeColumn,
+	kRepeatColumn
+};
+
+
+static status_t
+control_add_on(uint32 code, BMessage* message)
+{
+	BInputDevice* device = find_input_device(RemoteControl::kDeviceName);
+	if (device == NULL)
+		return B_ENTRY_NOT_FOUND;
+	status_t status = device->Control(code, message);
+	delete device;
+	return status;
+}
+
+
+static bool
+receiver_present()
+{
+	BDirectory directory(IR_REMOTE_DEVICE_DIRECTORY);
+	return directory.InitCheck() == B_OK && directory.CountEntries() > 0;
+}
+
+
+//	#pragma mark - KeystrokeView
+
+
+/*!	Shows a keystroke; when focused, the next key pressed (with its
+	modifiers) becomes it. The window's filter hands it the keys, before
+	shortcuts and keyboard navigation take them.
+*/
+class KeystrokeView : public BView {
+public:
+	KeystrokeView()
+		:
+		BView("keystroke", B_WILL_DRAW | B_NAVIGABLE),
+		fKey(0),
+		fModifiers(0)
+	{
+		SetViewColor(B_TRANSPARENT_COLOR);
+	}
+
+	void SetKeystroke(uint32 key, uint32 modifiers)
+	{
+		fKey = key;
+		fModifiers = modifiers;
+		Invalidate();
+	}
+
+	virtual BSize MinSize()
+	{
+		font_height height;
+		GetFontHeight(&height);
+		return BSize(StringWidth("Command+Control+Shift+Right arrow") + 16,
+			ceilf(height.ascent + height.descent) + 10);
+	}
+
+	virtual BSize MaxSize()
+	{
+		return BSize(B_SIZE_UNLIMITED, MinSize().height);
+	}
+
+	virtual void MakeFocus(bool focus)
+	{
+		BView::MakeFocus(focus);
+		Invalidate();
+	}
+
+	virtual void MouseDown(BPoint where)
+	{
+		(void)where;
+		if (IsEnabled())
+			MakeFocus(true);
+	}
+
+	void SetEnabled(bool enabled)
+	{
+		fEnabled = enabled;
+		if (!enabled && IsFocus())
+			MakeFocus(false);
+		Invalidate();
+	}
+
+	bool IsEnabled() const { return fEnabled; }
+
+	virtual void Draw(BRect updateRect)
+	{
+		(void)updateRect;
+		BRect rect = Bounds();
+		rgb_color base = ui_color(B_PANEL_BACKGROUND_COLOR);
+		SetHighColor(base);
+		FillRect(rect);
+		uint32 flags = fEnabled ? 0 : BControlLook::B_DISABLED;
+		if (IsFocus())
+			flags |= BControlLook::B_FOCUSED;
+		be_control_look->DrawTextControlBorder(this, rect, rect, base, flags);
+		SetHighColor(ui_color(fEnabled ? B_DOCUMENT_TEXT_COLOR
+			: B_PANEL_TEXT_COLOR));
+		SetLowColor(ui_color(B_DOCUMENT_BACKGROUND_COLOR));
+		FillRect(rect, B_SOLID_LOW);
+		SetHighColor(ui_color(B_DOCUMENT_TEXT_COLOR));
+		if (!fEnabled)
+			SetHighColor(tint_color(HighColor(), B_LIGHTEN_1_TINT));
+		BString text = IsFocus() ? BString("Press the keys" B_UTF8_ELLIPSIS)
+			: KeystrokeName(fKey, fModifiers);
+		font_height height;
+		GetFontHeight(&height);
+		DrawString(text, BPoint(rect.left + 4,
+			rect.top + (rect.Height() + height.ascent - height.descent) / 2));
+	}
+
+private:
+	uint32	fKey;
+	uint32	fModifiers;
+	bool	fEnabled = true;
+};
+
+
+class KeystrokeFilter : public BMessageFilter {
+public:
+	KeystrokeFilter(RemoteWindow* window, KeystrokeView* view)
+		:
+		BMessageFilter(B_ANY_DELIVERY, B_ANY_SOURCE),
+		fWindow(window),
+		fView(view)
+	{
+	}
+
+	virtual filter_result Filter(BMessage* message, BHandler** target)
+	{
+		(void)target;
+		if ((message->what != B_KEY_DOWN
+				&& message->what != B_UNMAPPED_KEY_DOWN)
+			|| fWindow->CurrentFocus() != fView) {
+			return B_DISPATCH_MESSAGE;
+		}
+		uint32 key = (uint32)message->GetInt32("key", 0);
+		uint32 modifiers = (uint32)message->GetInt32("modifiers", 0);
+		if (key == 0 || IsModifierKey(key))
+			return B_SKIP_MESSAGE;
+		modifiers &= B_SHIFT_KEY | B_COMMAND_KEY | B_CONTROL_KEY | B_OPTION_KEY
+			| B_LEFT_SHIFT_KEY | B_RIGHT_SHIFT_KEY | B_LEFT_COMMAND_KEY
+			| B_RIGHT_COMMAND_KEY | B_LEFT_CONTROL_KEY | B_RIGHT_CONTROL_KEY
+			| B_LEFT_OPTION_KEY | B_RIGHT_OPTION_KEY;
+		fWindow->KeystrokeChanged(key, modifiers);
+		fView->MakeFocus(false);
+		return B_SKIP_MESSAGE;
+	}
+
+private:
+	RemoteWindow*	fWindow;
+	KeystrokeView*	fView;
+};
+
+
+//	#pragma mark - RemoteWindow
+
+
+RemoteWindow::RemoteWindow()
+	:
+	BWindow(BRect(100, 100, 900, 600), "Remote Control", B_TITLED_WINDOW,
+		B_ASYNCHRONOUS_CONTROLS | B_AUTO_UPDATE_SIZE_LIMITS),
+	fProfiles(10),
+	fLearning(false),
+	fOpenPanel(NULL),
+	fSavePanel(NULL)
+{
+	fProfileList = new BListView("profiles");
+	fProfileList->SetSelectionMessage(new BMessage(kMsgProfileSelected));
+	BScrollView* profileScroll = new BScrollView("profiles scroll",
+		fProfileList, 0, false, true);
+	fNewButton = new BButton("New", new BMessage(kMsgNewProfile));
+	fDuplicateButton = new BButton("Duplicate",
+		new BMessage(kMsgDuplicateProfile));
+	fDeleteButton = new BButton("Delete", new BMessage(kMsgDeleteProfile));
+	fImportButton = new BButton("Import" B_UTF8_ELLIPSIS,
+		new BMessage(kMsgImport));
+	fExportButton = new BButton("Export" B_UTF8_ELLIPSIS,
+		new BMessage(kMsgExport));
+
+	fNameControl = new BTextControl("Name:", "",
+		new BMessage(kMsgNameChanged));
+	fEnabledBox = new BCheckBox("Enabled", new BMessage(kMsgEnabled));
+	fRemoteView = new BStringView("remote", "");
+	fForgetRemoteButton = new BButton("Forget remote",
+		new BMessage(kMsgForgetRemote));
+
+	fButtonList = new BColumnListView("buttons", B_NAVIGABLE,
+		B_FANCY_BORDER, true);
+	fButtonList->SetSelectionMode(B_SINGLE_SELECTION_LIST);
+	fButtonList->SetSelectionMessage(new BMessage(kMsgButtonSelected));
+	float width = be_plain_font->StringWidth("Command+Shift+Right arrow");
+	fButtonList->AddColumn(new BStringColumn("Button", width, 40, 400,
+		B_TRUNCATE_END), kLabelColumn);
+	fButtonList->AddColumn(new BStringColumn("Code",
+		be_plain_font->StringWidth("0xffff  "), 30, 120, B_TRUNCATE_END),
+		kCodeColumn);
+	fButtonList->AddColumn(new BStringColumn("Keystroke", width, 40, 400,
+		B_TRUNCATE_END), kKeystrokeColumn);
+	fButtonList->AddColumn(new BStringColumn("When held",
+		be_plain_font->StringWidth("When held  "), 30, 200, B_TRUNCATE_END),
+		kRepeatColumn);
+
+	fLabelControl = new BTextControl("Button:", "",
+		new BMessage(kMsgLabelChanged));
+	fKeystrokeView = new KeystrokeView();
+	BPopUpMenu* keyMenu = new BPopUpMenu("Keys", true, false);
+	{
+		BMessage* none = new BMessage(kMsgNamedKey);
+		none->AddInt32("key", 0);
+		keyMenu->AddItem(new BMenuItem("None", none));
+		keyMenu->AddSeparatorItem();
+		for (int32 i = 0; i < kNamedKeyCount; i++) {
+			BMessage* message = new BMessage(kMsgNamedKey);
+			message->AddInt32("key", kNamedKeys[i].key);
+			keyMenu->AddItem(new BMenuItem(kNamedKeys[i].name, message));
+		}
+	}
+	keyMenu->SetRadioMode(false);
+	fKeyMenuField = new BMenuField("keys", NULL, keyMenu);
+	fRepeatBox = new BCheckBox("Repeats when held", new BMessage(kMsgRepeat));
+	fRemoveButton = new BButton("Remove", new BMessage(kMsgRemoveButton));
+	fUpButton = new BButton("Up", new BMessage(kMsgMoveUp));
+	fDownButton = new BButton("Down", new BMessage(kMsgMoveDown));
+
+	fLearnButton = new BButton("Learn", new BMessage(kMsgLearn));
+	fLearnButton->SetBehavior(BButton::B_TOGGLE_BEHAVIOR);
+	BPopUpMenu* templateMenu = new BPopUpMenu("Add buttons for",
+		true, false);
+	for (int32 i = 0; i < kTemplateCount; i++) {
+		BMessage* message = new BMessage(kMsgTemplate);
+		message->AddInt32("index", i);
+		templateMenu->AddItem(new BMenuItem(kTemplates[i].name, message));
+	}
+	templateMenu->SetRadioMode(false);
+	templateMenu->SetLabelFromMarked(false);
+	fTemplateField = new BMenuField("templates", NULL, templateMenu);
+
+	fStatusView = new BStringView("status", "");
+	fStatusView->SetExplicitMinSize(BSize(100, B_SIZE_UNSET));
+	fStatusView->SetExplicitMaxSize(BSize(B_SIZE_UNLIMITED, B_SIZE_UNSET));
+
+	BLayoutBuilder::Group<>(this, B_VERTICAL)
+		.SetInsets(B_USE_WINDOW_SPACING)
+		.AddGroup(B_HORIZONTAL)
+			.AddGroup(B_VERTICAL, B_USE_SMALL_SPACING, 0.3f)
+				.Add(new BStringView("remotes", "Remotes:"))
+				.Add(profileScroll)
+				.AddGrid(B_USE_SMALL_SPACING, B_USE_SMALL_SPACING)
+					.Add(fNewButton, 0, 0)
+					.Add(fDuplicateButton, 1, 0)
+					.Add(fDeleteButton, 0, 1)
+					.Add(fImportButton, 0, 2)
+					.Add(fExportButton, 1, 2)
+				.End()
+			.End()
+			.AddGroup(B_VERTICAL, B_USE_SMALL_SPACING, 1.0f)
+				.AddGroup(B_HORIZONTAL)
+					.Add(fNameControl)
+					.Add(fEnabledBox)
+				.End()
+				.AddGroup(B_HORIZONTAL)
+					.Add(fRemoteView)
+					.AddGlue()
+					.Add(fForgetRemoteButton)
+				.End()
+				.Add(fButtonList)
+				.AddGrid(B_USE_SMALL_SPACING, B_USE_SMALL_SPACING)
+					.AddTextControl(fLabelControl, 0, 0)
+					.Add(new BStringView("keystroke label", "Keystroke:"), 0, 1)
+					.AddGroup(B_HORIZONTAL, B_USE_SMALL_SPACING, 1, 1)
+						.Add(fKeystrokeView)
+						.Add(fKeyMenuField)
+					.End()
+					.Add(fRepeatBox, 1, 2)
+				.End()
+				.AddGroup(B_HORIZONTAL)
+					.Add(fLearnButton)
+					.Add(fTemplateField)
+					.AddGlue()
+					.Add(fUpButton)
+					.Add(fDownButton)
+					.Add(fRemoveButton)
+				.End()
+			.End()
+		.End()
+		.Add(new BSeparatorView(B_HORIZONTAL))
+		.Add(fStatusView);
+
+	AddCommonFilter(new KeystrokeFilter(this, fKeystrokeView));
+
+	Profile::LoadAll(fProfiles);
+	_UpdateProfileList(0);
+	_UpdateStatus();
+	CenterOnScreen();
+}
+
+
+RemoteWindow::~RemoteWindow()
+{
+	delete fOpenPanel;
+	delete fSavePanel;
+}
+
+
+bool
+RemoteWindow::QuitRequested()
+{
+	_SetLearning(false);
+	be_app->PostMessage(B_QUIT_REQUESTED);
+	return true;
+}
+
+
+void
+RemoteWindow::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgProfileSelected:
+			_UpdateProfile();
+			_Prompt();
+			break;
+
+		case kMsgNewProfile:
+			_NewProfile(NULL);
+			break;
+
+		case kMsgDuplicateProfile:
+			if (_CurrentProfile() != NULL)
+				_NewProfile(_CurrentProfile());
+			break;
+
+		case kMsgDeleteProfile:
+		{
+			Profile* profile = _CurrentProfile();
+			if (profile == NULL)
+				break;
+			BString text;
+			text << "Delete the profile \"" << profile->Name() << "\"?";
+			BAlert* alert = new BAlert("Delete", text, "Cancel", "Delete",
+				NULL, B_WIDTH_AS_USUAL, B_WARNING_ALERT);
+			alert->SetShortcut(0, B_ESCAPE);
+			if (alert->Go() != 1)
+				break;
+			profile->Remove();
+			int32 index = fProfiles.IndexOf(profile);
+			fProfiles.RemoveItem(profile);
+			control_add_on(RemoteControl::kMsgReloadProfiles, NULL);
+			_UpdateProfileList(index > 0 ? index - 1 : 0);
+			break;
+		}
+
+		case kMsgImport:
+			if (fOpenPanel == NULL) {
+				fOpenPanel = new BFilePanel(B_OPEN_PANEL,
+					new BMessenger(this), NULL, B_FILE_NODE, true);
+			}
+			fOpenPanel->Show();
+			break;
+
+		case B_REFS_RECEIVED:
+			_Import(message);
+			break;
+
+		case kMsgExport:
+		{
+			Profile* profile = _CurrentProfile();
+			if (profile == NULL)
+				break;
+			if (fSavePanel == NULL) {
+				fSavePanel = new BFilePanel(B_SAVE_PANEL,
+					new BMessenger(this), NULL, B_FILE_NODE, false);
+			}
+			fSavePanel->SetSaveText(profile->Name());
+			fSavePanel->Show();
+			break;
+		}
+
+		case B_SAVE_REQUESTED:
+			_Export(message);
+			break;
+
+		case kMsgNameChanged:
+		{
+			Profile* profile = _CurrentProfile();
+			if (profile == NULL || profile->Name() == fNameControl->Text())
+				break;
+			BString oldName = profile->Name();
+			BString name = fNameControl->Text();
+			name.Trim();
+			if (name.IsEmpty()) {
+				fNameControl->SetText(oldName);
+				break;
+			}
+			profile->SetName(_UniqueName(name));
+			_Changed(profile, oldName);
+			_UpdateProfileList(fProfiles.IndexOf(profile));
+			break;
+		}
+
+		case kMsgEnabled:
+		{
+			Profile* profile = _CurrentProfile();
+			if (profile == NULL)
+				break;
+			profile->SetEnabled(fEnabledBox->Value() == B_CONTROL_ON);
+			_Changed(profile);
+			_UpdateProfileList(fProfiles.IndexOf(profile));
+			break;
+		}
+
+		case kMsgForgetRemote:
+		{
+			Profile* profile = _CurrentProfile();
+			if (profile == NULL)
+				break;
+			// the buttons stay, to be learned again from another remote
+			profile->SetRemote(0, 0);
+			for (int32 i = 0; i < profile->CountButtons(); i++)
+				profile->ButtonAt(i)->command = kUnlearned;
+			_Changed(profile);
+			_UpdateProfile();
+			break;
+		}
+
+		case kMsgButtonSelected:
+			_UpdateEditor();
+			_Prompt();
+			break;
+
+		case kMsgLabelChanged:
+		{
+			Button* button = _CurrentButton();
+			if (button == NULL || button->label == fLabelControl->Text())
+				break;
+			button->label = fLabelControl->Text();
+			_Changed(_CurrentProfile());
+			_UpdateButtons(_CurrentButtonIndex());
+			break;
+		}
+
+		case kMsgRepeat:
+		{
+			Button* button = _CurrentButton();
+			if (button == NULL)
+				break;
+			button->repeat = fRepeatBox->Value() == B_CONTROL_ON;
+			_Changed(_CurrentProfile());
+			_UpdateButtons(_CurrentButtonIndex());
+			break;
+		}
+
+		case kMsgNamedKey:
+			KeystrokeChanged((uint32)message->GetInt32("key", 0), 0);
+			break;
+
+		case kMsgRemoveButton:
+		{
+			Profile* profile = _CurrentProfile();
+			int32 index = _CurrentButtonIndex();
+			if (profile == NULL || index < 0)
+				break;
+			profile->RemoveButton(index);
+			_Changed(profile);
+			_UpdateButtons(index < profile->CountButtons() ? index
+				: profile->CountButtons() - 1);
+			break;
+		}
+
+		case kMsgMoveUp:
+		case kMsgMoveDown:
+		{
+			Profile* profile = _CurrentProfile();
+			int32 index = _CurrentButtonIndex();
+			int32 to = index + (message->what == kMsgMoveUp ? -1 : 1);
+			if (profile == NULL || index < 0 || to < 0
+				|| to >= profile->CountButtons())
+				break;
+			profile->MoveButton(index, to);
+			_Changed(profile);
+			_UpdateButtons(to);
+			break;
+		}
+
+		case kMsgLearn:
+			_SetLearning(fLearnButton->Value() == B_CONTROL_ON);
+			break;
+
+		case kMsgTemplate:
+			_AddTemplate(message->GetInt32("index", 0));
+			break;
+
+		case RemoteControl::kMsgButtonEvent:
+			_ButtonEvent(message);
+			break;
+
+		default:
+			BWindow::MessageReceived(message);
+	}
+}
+
+
+void
+RemoteWindow::KeystrokeChanged(uint32 key, uint32 modifiers)
+{
+	Button* button = _CurrentButton();
+	if (button == NULL)
+		return;
+	button->key = key;
+	button->modifiers = modifiers;
+	_Changed(_CurrentProfile());
+	_UpdateButtons(_CurrentButtonIndex());
+}
+
+
+Profile*
+RemoteWindow::_CurrentProfile() const
+{
+	return fProfiles.ItemAt(fProfileList->CurrentSelection());
+}
+
+
+int32
+RemoteWindow::_CurrentButtonIndex() const
+{
+	BRow* row = fButtonList->CurrentSelection();
+	return row != NULL ? fButtonList->IndexOf(row) : -1;
+}
+
+
+Button*
+RemoteWindow::_CurrentButton() const
+{
+	Profile* profile = _CurrentProfile();
+	int32 index = _CurrentButtonIndex();
+	return profile != NULL && index >= 0 ? profile->ButtonAt(index) : NULL;
+}
+
+
+void
+RemoteWindow::_UpdateProfileList(int32 select)
+{
+	fProfileList->RemoveItems(0, fProfileList->CountItems());
+	for (int32 i = 0; i < fProfiles.CountItems(); i++) {
+		const Profile* profile = fProfiles.ItemAt(i);
+		BString text = profile->Name();
+		if (!profile->IsEnabled())
+			text << " (off)";
+		fProfileList->AddItem(new BStringItem(text));
+	}
+	if (select >= fProfiles.CountItems())
+		select = fProfiles.CountItems() - 1;
+	fProfileList->Select(select);
+	if (select < 0)
+		_UpdateProfile();
+}
+
+
+void
+RemoteWindow::_UpdateProfile()
+{
+	Profile* profile = _CurrentProfile();
+	bool enabled = profile != NULL;
+	fNameControl->SetText(enabled ? profile->Name().String() : "");
+	fNameControl->SetEnabled(enabled);
+	fEnabledBox->SetValue(enabled && profile->IsEnabled());
+	fEnabledBox->SetEnabled(enabled);
+	fDuplicateButton->SetEnabled(enabled);
+	fDeleteButton->SetEnabled(enabled);
+	fExportButton->SetEnabled(enabled);
+	fTemplateField->SetEnabled(enabled);
+	fForgetRemoteButton->SetEnabled(enabled && profile->HasRemote());
+
+	BString remote;
+	if (profile == NULL)
+		remote = "No profile: press New, then Learn.";
+	else if (!profile->HasRemote())
+		remote = "Remote: not learned yet (press Learn, then a button).";
+	else {
+		char address[16];
+		snprintf(address, sizeof(address), "0x%" B_PRIx32,
+			profile->Address());
+		remote << "Remote: " << Profile::ProtocolName(profile->Protocol())
+			<< ", address " << address;
+	}
+	fRemoteView->SetText(remote);
+	_UpdateButtons(0);
+}
+
+
+void
+RemoteWindow::_UpdateButtons(int32 select)
+{
+	fButtonList->Clear();
+	Profile* profile = _CurrentProfile();
+	for (int32 i = 0; profile != NULL && i < profile->CountButtons(); i++) {
+		const Button* button = profile->ButtonAt(i);
+		BRow* row = new BRow();
+		row->SetField(new BStringField(button->label), kLabelColumn);
+		char code[16] = "—";
+		if (button->command != kUnlearned) {
+			snprintf(code, sizeof(code), "0x%" B_PRIx32, button->command);
+		}
+		row->SetField(new BStringField(code), kCodeColumn);
+		row->SetField(new BStringField(KeystrokeName(button->key,
+			button->modifiers)), kKeystrokeColumn);
+		row->SetField(new BStringField(button->repeat ? "Repeats" : "Once"),
+			kRepeatColumn);
+		fButtonList->AddRow(row);
+	}
+	if (select >= 0 && select < fButtonList->CountRows()) {
+		BRow* row = fButtonList->RowAt(select);
+		fButtonList->AddToSelection(row);
+		fButtonList->SetFocusRow(row);
+		fButtonList->ScrollTo(row);
+	}
+	_UpdateEditor();
+}
+
+
+void
+RemoteWindow::_UpdateEditor()
+{
+	Button* button = _CurrentButton();
+	bool enabled = button != NULL;
+	fLabelControl->SetText(enabled ? button->label.String() : "");
+	fLabelControl->SetEnabled(enabled);
+	fKeystrokeView->SetKeystroke(enabled ? button->key : 0,
+		enabled ? button->modifiers : 0);
+	fKeystrokeView->SetEnabled(enabled);
+	fKeyMenuField->SetEnabled(enabled);
+	fRepeatBox->SetValue(enabled && button->repeat);
+	fRepeatBox->SetEnabled(enabled);
+	fRemoveButton->SetEnabled(enabled);
+	int32 index = _CurrentButtonIndex();
+	Profile* profile = _CurrentProfile();
+	fUpButton->SetEnabled(enabled && index > 0);
+	fDownButton->SetEnabled(enabled && profile != NULL
+		&& index < profile->CountButtons() - 1);
+}
+
+
+void
+RemoteWindow::_UpdateStatus()
+{
+	if (!receiver_present())
+		_SetStatus("No infrared receiver found.");
+	else if (find_input_device(RemoteControl::kDeviceName) == NULL) {
+		_SetStatus("The Remote Control input_server add-on isn't running "
+			"(restart the input_server).");
+	} else if (fLearning)
+		_Prompt();
+	else
+		_SetStatus("Ready. Press Learn to add buttons from your remote.");
+}
+
+
+void
+RemoteWindow::_SetStatus(const char* text)
+{
+	fStatusView->SetText(text);
+}
+
+
+/*!	While learning: what to press next. */
+void
+RemoteWindow::_Prompt()
+{
+	if (!fLearning)
+		return;
+	Profile* profile = _CurrentProfile();
+	Button* button = _CurrentButton();
+	if (profile == NULL)
+		_SetStatus("Learning: select or create a profile first.");
+	else if (button != NULL && button->command == kUnlearned) {
+		BString text;
+		text << "Learning: press the button for \"" << button->label << "\".";
+		_SetStatus(text);
+	} else
+		_SetStatus("Learning: press a button on the remote.");
+}
+
+
+void
+RemoteWindow::_Changed(const Profile* profile, const char* oldName)
+{
+	if (profile == NULL)
+		return;
+	if (oldName != NULL) {
+		Profile old(*profile);
+		old.SetName(oldName);
+		old.Remove();
+	}
+	status_t status = profile->Save();
+	if (status != B_OK) {
+		BString text;
+		text << "Couldn't save the profile: " << strerror(status);
+		_SetStatus(text);
+	}
+	control_add_on(RemoteControl::kMsgReloadProfiles, NULL);
+}
+
+
+void
+RemoteWindow::_NewProfile(const Profile* copy)
+{
+	Profile* profile = new Profile;
+	if (copy != NULL) {
+		*profile = *copy;
+		profile->SetName(_UniqueName(copy->Name()));
+	} else
+		profile->SetName(_UniqueName("New remote"));
+	fProfiles.AddItem(profile);
+	_Changed(profile);
+	_UpdateProfileList(fProfiles.CountItems() - 1);
+	fNameControl->MakeFocus(true);
+}
+
+
+BString
+RemoteWindow::_UniqueName(const char* name) const
+{
+	BString unique(name);
+	for (int32 number = 2; ; number++) {
+		bool taken = false;
+		for (int32 i = 0; i < fProfiles.CountItems() && !taken; i++)
+			taken = fProfiles.ItemAt(i)->Name().ICompare(unique) == 0;
+		if (!taken)
+			return unique;
+		unique = name;
+		unique << " " << number;
+	}
+}
+
+
+void
+RemoteWindow::_ButtonEvent(BMessage* message)
+{
+	uint32 protocol = (uint32)message->GetInt32("protocol", 0);
+	uint32 address = (uint32)message->GetInt32("address", 0);
+	uint32 command = (uint32)message->GetInt32("command", 0);
+	uint32 flags = (uint32)message->GetInt32("flags", 0);
+
+	char text[160];
+	snprintf(text, sizeof(text), "%s, address 0x%" B_PRIx32 ", button 0x%"
+		B_PRIx32 "%s", Profile::ProtocolName(protocol), address, command,
+		(flags & IR_REMOTE_REPEAT) != 0 ? " (held)" : "");
+	if ((flags & IR_REMOTE_REPEAT) != 0)
+		return;
+
+	Profile* profile = _CurrentProfile();
+	if (profile == NULL) {
+		BString status;
+		status << "Received " << text << ". Create a profile to learn it.";
+		_SetStatus(status);
+		return;
+	}
+	if (!profile->HasRemote()) {
+		profile->SetRemote(protocol, address);
+		_UpdateProfile();
+	} else if (!profile->Matches(protocol, address)
+		&& !(Profile::Family(protocol) == Profile::Family(profile->Protocol())
+			&& address == profile->Address())) {
+		BString status;
+		status << "Received " << text << ": another remote than this "
+			"profile's.";
+		_SetStatus(status);
+		return;
+	}
+
+	int32 index = -1;
+	for (int32 i = 0; i < profile->CountButtons(); i++) {
+		if (profile->ButtonAt(i)->command == command) {
+			index = i;
+			break;
+		}
+	}
+	if (index < 0) {
+		Button* selected = _CurrentButton();
+		if (selected != NULL && selected->command == kUnlearned) {
+			selected->command = command;
+			index = _CurrentButtonIndex();
+			// on to the next row still to learn
+			for (int32 i = index + 1; i < profile->CountButtons(); i++) {
+				if (profile->ButtonAt(i)->command == kUnlearned) {
+					index = i;
+					break;
+				}
+			}
+		} else {
+			Button button;
+			button.label << "Button " << profile->CountButtons() + 1;
+			button.command = command;
+			button.key = 0;
+			button.modifiers = 0;
+			button.repeat = false;
+			profile->AddButton(button);
+			index = profile->CountButtons() - 1;
+		}
+		_Changed(profile);
+	}
+	_UpdateButtons(index);
+
+	BString status;
+	status << "Received " << text << ".";
+	_SetStatus(status);
+	Button* next = _CurrentButton();
+	if (next != NULL && next->command == kUnlearned)
+		_Prompt();
+}
+
+
+void
+RemoteWindow::_SetLearning(bool learning)
+{
+	if (learning == fLearning)
+		return;
+	status_t status;
+	if (learning) {
+		BMessage message;
+		message.AddMessenger("messenger", BMessenger(this));
+		status = control_add_on(RemoteControl::kMsgStartLearning, &message);
+	} else
+		status = control_add_on(RemoteControl::kMsgStopLearning, NULL);
+	fLearning = learning && status == B_OK;
+	fLearnButton->SetValue(fLearning ? B_CONTROL_ON : B_CONTROL_OFF);
+	if (learning && status != B_OK)
+		_UpdateStatus();
+	else if (fLearning)
+		_Prompt();
+	else
+		_UpdateStatus();
+}
+
+
+void
+RemoteWindow::_AddTemplate(int32 index)
+{
+	Profile* profile = _CurrentProfile();
+	if (profile == NULL || index < 0 || index >= kTemplateCount)
+		return;
+	const Template& added = kTemplates[index];
+	int32 first = -1;
+	for (int32 i = 0; i < added.count; i++) {
+		Button button;
+		button.label = added.buttons[i].label;
+		button.command = kUnlearned;
+		button.key = added.buttons[i].key;
+		button.modifiers = added.buttons[i].modifiers;
+		button.repeat = added.buttons[i].repeat;
+		if (profile->AddButton(button) != NULL && first < 0)
+			first = profile->CountButtons() - 1;
+	}
+	_Changed(profile);
+	_UpdateButtons(first);
+	if (!fLearning)
+		_SetStatus("Now press Learn, then each button the list asks for.");
+	else
+		_Prompt();
+}
+
+
+void
+RemoteWindow::_Import(BMessage* message)
+{
+	entry_ref ref;
+	for (int32 i = 0; message->FindRef("refs", i, &ref) == B_OK; i++) {
+		BPath path(&ref);
+		Profile* profile = new Profile;
+		if (profile->Load(path.Path()) != B_OK) {
+			delete profile;
+			BString text;
+			text << "\"" << ref.name << "\" is no Remote Control profile.";
+			_SetStatus(text);
+			continue;
+		}
+		profile->SetName(_UniqueName(profile->Name()));
+		fProfiles.AddItem(profile);
+		_Changed(profile);
+		_UpdateProfileList(fProfiles.CountItems() - 1);
+	}
+}
+
+
+void
+RemoteWindow::_Export(BMessage* message)
+{
+	Profile* profile = _CurrentProfile();
+	entry_ref directoryRef;
+	const char* name;
+	if (profile == NULL || message->FindRef("directory", &directoryRef) != B_OK
+		|| message->FindString("name", &name) != B_OK)
+		return;
+	BPath path(&directoryRef);
+	path.Append(name);
+	BMessage archive;
+	profile->Archive(&archive);
+	BFile file(path.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+	status_t status = file.InitCheck();
+	if (status == B_OK)
+		status = archive.Flatten(&file);
+	BString text;
+	if (status == B_OK)
+		text << "Exported to " << path.Path() << ".";
+	else
+		text << "Couldn't export: " << strerror(status);
+	_SetStatus(text);
+}
