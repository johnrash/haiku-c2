diff --git a/src/add-ons/kernel/drivers/input/meson_ir/meson_ir.cpp b/src/add-ons/kernel/drivers/input/meson_ir/meson_ir.cpp
new file mode 100644
index 0000000000..651a4e43e8
--- /dev/null
+++ b/src/add-ons/kernel/drivers/input/meson_ir/meson_ir.cpp
@@ -0,0 +1,812 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * The Amlogic S905's (GXBB) infrared remote control receiver, as
+ * /dev/input/remote/meson_ir/0: decoded button presses
+ * (headers/private/drivers/ir_remote.h) for the input_server add-on
+ * "Remote Control", and the raw pulses for learning unknown remotes.
+ *
+ * The receiver runs in its raw mode: an interrupt at every edge of the
+ * receiver module's output, with the time since the edge before. The
+ * protocols are decoded in software (IRDecoder.cpp): NEC, RC-5, RC-6,
+ * Sony and JVC. A frame that ends with a space only ends when the next
+ * edge would come, so a timer takes the gap after the last edge.
+ *
+ * The receiver runs while the device is open. Each open handle reads the
+ * events at its own pace from one ring; a reader that falls too far behind
+ * loses the oldest.
+ *
+ * Register facts: docs/m24-ir-facts.md.
+ */
+
+
+#include <new>
+#include <stdio.h>
+#include <string.h>
+
+#include <AutoDeleterDrivers.h>
+#include <KernelExport.h>
+#include <arch/int.h>
+#include <bus/FDT.h>
+#include <condition_variable.h>
