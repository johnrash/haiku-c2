diff --git a/src/add-ons/input_server/devices/remote_control/RemoteControlDevice.cpp b/src/add-ons/input_server/devices/remote_control/RemoteControlDevice.cpp
new file mode 100644
index 0000000000..46c1a81548
--- /dev/null
+++ b/src/add-ons/input_server/devices/remote_control/RemoteControlDevice.cpp
@@ -0,0 +1,470 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * input_server device add-on "Remote Control": the buttons of infrared
+ * remotes (/dev/input/remote/...) as keystrokes. Each button press is
+ * looked up in the enabled profiles (RemoteProfile.h): the protocol and
+ * address say which remote, the command which button. Its keystroke goes
+ * out as from a keyboard, through the current keymap, so any application
+ * and the Shortcuts preferences get it; media key codes (0x0c00e9 volume
+ * up and so on) work as the keyboard's do.
+ *
+ * A remote repeats its frame while a button is held: the key stays down
+ * until no repeat came for kRelease, and repeats after kRepeatDelay for
+ * buttons that ask for it. While the Remote Control preferences learn a
+ * remote, presses go to them instead.
+ */
+
+
+#include "RemoteControlDevice.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <new>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <Autolock.h>
+#include <Directory.h>
+#include <Entry.h>
+#include <Path.h>
+
+#include <AutoDeleter.h>
+
+
+using RemoteControl::Button;
+using RemoteControl::Profile;
+
+
+static const char* const kRemoteDirectory = IR_REMOTE_DEVICE_DIRECTORY;
+// the key goes up this long after the last frame of the press: longer than
+// the slowest repeat period (NEC 108 ms, RC-5 114 ms, JVC 50-60 ms)
+static const bigtime_t kRelease = 200000;
+// held buttons that repeat start repeating after this
+static const bigtime_t kRepeatDelay = 400000;
+
+
+class RemoteReceiver {
+public:
+								RemoteReceiver(RemoteControlDevice* device,
+									const char* path, const char* name);
+								~RemoteReceiver();
+
+			input_device_ref*	Ref() { return &fRef; }
+			status_t			Start();
+			void				Stop();
+
+private:
+	friend class RemoteControlDevice;
+
+	static	int32				_Thread(void* data);
+			void				_Run();
+
+			RemoteControlDevice* fDevice;
+			BString				fPath;
+			BString				fName;
+			input_device_ref	fRef;
+			int					fFD;
+			thread_id			fThread;
+			volatile bool		fQuit;
+
+			// the key held down (device lock)
+			bool				fHeld;
+			Button				fHeldButton;
+			bigtime_t			fPressed;
+			bigtime_t			fReleaseAt;
+			int32				fRepeats;
+};
+
+
+RemoteReceiver::RemoteReceiver(RemoteControlDevice* device, const char* path,
+	const char* name)
+	:
+	fDevice(device),
+	fPath(path),
+	fName(name),
+	fFD(-1),
+	fThread(-1),
+	fQuit(false),
+	fHeld(false),
+	fPressed(0),
+	fReleaseAt(0),
+	fRepeats(0)
+{
+	fRef.name = (char*)fName.String();
+	fRef.type = B_KEYBOARD_DEVICE;
+	fRef.cookie = this;
+}
+
+
+RemoteReceiver::~RemoteReceiver()
+{
+	Stop();
+}
+
+
+status_t
+RemoteReceiver::Start()
+{
+	if (fThread >= 0)
+		return B_OK;
+	fFD = open(fPath.String(), O_RDONLY | O_NONBLOCK);
+	if (fFD < 0)
+		return errno;
+	fQuit = false;
+	fThread = spawn_thread(&_Thread, "remote control", B_URGENT_DISPLAY_PRIORITY,
+		this);
+	if (fThread < 0) {
+		close(fFD);
+		fFD = -1;
+		return fThread;
+	}
+	resume_thread(fThread);
+	return B_OK;
+}
+
+
+void
+RemoteReceiver::Stop()
+{
+	if (fThread < 0)
+		return;
+	fQuit = true;
+	status_t result;
+	wait_for_thread(fThread, &result);
+	fThread = -1;
+	close(fFD);
+	fFD = -1;
+	BAutolock locker(fDevice->fLock);
+	fDevice->ReleaseKey(this);
+}
+
+
+/*static*/ int32
+RemoteReceiver::_Thread(void* data)
+{
+	((RemoteReceiver*)data)->_Run();
+	return 0;
+}
+
+
+void
+RemoteReceiver::_Run()
+{
+	while (!fQuit) {
+		// wake for a frame, for a held key's release, and now and then to
+		// see whether to quit
+		bigtime_t timeout = 250000;
+		{
+			BAutolock locker(fDevice->fLock);
+			if (fHeld) {
+				timeout = fReleaseAt - system_time();
+				if (timeout < 0)
+					timeout = 0;
+				if (timeout > 250000)
+					timeout = 250000;
+			}
+		}
+		if (ioctl(fFD, IR_REMOTE_WAIT_FOR_EVENT, &timeout, sizeof(timeout))
+				== 0) {
+			ir_remote_event events[8];
+			ssize_t size = read(fFD, events, sizeof(events));
+			for (ssize_t i = 0;
+					i < size / (ssize_t)sizeof(ir_remote_event); i++) {
+				fDevice->HandleEvent(this, events[i]);
+			}
+		} else if (errno != B_TIMED_OUT && errno != B_INTERRUPTED)
+			snooze(100000);
+
+		BAutolock locker(fDevice->fLock);
+		if (fHeld && system_time() >= fReleaseAt)
+			fDevice->ReleaseKey(this);
+	}
+}
+
+
+//	#pragma mark -
+
+
+RemoteControlDevice::RemoteControlDevice()
+	:
+	fLock("remote control"),
+	fReceivers(2),
+	fProfiles(10)
+{
+	fKeymap.SetToCurrent();
+}
+
+
+RemoteControlDevice::~RemoteControlDevice()
+{
+	fReceivers.MakeEmpty();
+}
+
+
+status_t
+RemoteControlDevice::InitCheck()
+{
+	// /dev/input/remote/<driver>/<n>
+	BDirectory remotes(kRemoteDirectory);
+	if (remotes.InitCheck() != B_OK)
+		return B_ERROR;
+
+	BEntry driverEntry;
+	while (remotes.GetNextEntry(&driverEntry) == B_OK) {
+		BDirectory driver(&driverEntry);
+		BEntry entry;
+		while (driver.InitCheck() == B_OK
+			&& driver.GetNextEntry(&entry) == B_OK) {
+			BPath path;
+			if (entry.GetPath(&path) != B_OK)
+				continue;
+			BString name(RemoteControl::kDeviceName);
+			if (fReceivers.CountItems() > 0)
+				name << " " << fReceivers.CountItems() + 1;
+			RemoteReceiver* receiver = new(std::nothrow) RemoteReceiver(this,
+				path.Path(), name.String());
+			if (receiver == NULL || !fReceivers.AddItem(receiver))
+				delete receiver;
+		}
+	}
+	if (fReceivers.IsEmpty())
+		return B_ERROR;
+
+	input_device_ref** refs = new(std::nothrow)
+		input_device_ref*[fReceivers.CountItems() + 1];
+	if (refs == NULL)
+		return B_NO_MEMORY;
+	ArrayDeleter<input_device_ref*> refsDeleter(refs);
+	for (int32 i = 0; i < fReceivers.CountItems(); i++)
+		refs[i] = fReceivers.ItemAt(i)->Ref();
+	refs[fReceivers.CountItems()] = NULL;
+
+	_LoadProfiles();
+	return RegisterDevices(refs);
+}
+
+
+status_t
+RemoteControlDevice::Start(const char* name, void* cookie)
+{
+	(void)name;
+	return ((RemoteReceiver*)cookie)->Start();
+}
+
+
+status_t
+RemoteControlDevice::Stop(const char* name, void* cookie)
+{
+	(void)name;
+	((RemoteReceiver*)cookie)->Stop();
+	return B_OK;
+}
+
+
+status_t
+RemoteControlDevice::Control(const char* name, void* cookie, uint32 command,
+	BMessage* message)
+{
+	(void)name;
+	(void)cookie;
+	switch (command) {
+		case B_KEY_MAP_CHANGED:
+		{
+			BAutolock locker(fLock);
+			fKeymap.SetToCurrent();
+			return B_OK;
+		}
+
+		case RemoteControl::kMsgReloadProfiles:
+			_LoadProfiles();
+			return B_OK;
+
+		case RemoteControl::kMsgStartLearning:
+		{
+			BMessenger learner;
+			if (message == NULL
+				|| message->FindMessenger("messenger", &learner) != B_OK)
+				return B_BAD_VALUE;
+			BAutolock locker(fLock);
+			fLearner = learner;
+			// no key stays down while learning
+			for (int32 i = 0; i < fReceivers.CountItems(); i++)
+				ReleaseKey(fReceivers.ItemAt(i));
+			return B_OK;
+		}
+
+		case RemoteControl::kMsgStopLearning:
+		{
+			BAutolock locker(fLock);
+			fLearner = BMessenger();
+			return B_OK;
+		}
+	}
+	return B_OK;
+}
+
+
+void
+RemoteControlDevice::HandleEvent(RemoteReceiver* receiver,
+	const ir_remote_event& event)
+{
+	BAutolock locker(fLock);
+
+	if (fLearner.IsValid()) {
+		BMessage message(RemoteControl::kMsgButtonEvent);
+		message.AddInt32("protocol", event.protocol);
+		message.AddInt32("address", event.address);
+		message.AddInt32("command", event.command);
+		message.AddInt32("flags", event.flags);
+		message.AddInt64("when", event.when);
+		if (fLearner.SendMessage(&message, (BHandler*)NULL, 100000)
+				== B_BAD_PORT_ID) {
+			// the preferences quit without saying so
+			fLearner = BMessenger();
+		} else
+			return;
+	}
+
+	const Button* button = NULL;
+	for (int32 i = 0; i < fProfiles.CountItems() && button == NULL; i++) {
+		const Profile* profile = fProfiles.ItemAt(i);
+		if (profile->Matches(event.protocol, event.address))
+			button = profile->FindButton(event.command);
+	}
+
+	bigtime_t now = system_time();
+	bool repeat = (event.flags & IR_REMOTE_REPEAT) != 0;
+	if (repeat && receiver->fHeld && button != NULL
+		&& button->command == receiver->fHeldButton.command
+		&& button->key == receiver->fHeldButton.key) {
+		// still held
+		receiver->fReleaseAt = now + kRelease;
+		if (button->repeat && now - receiver->fPressed >= kRepeatDelay)
+			RepeatKey(receiver);
+		return;
+	}
+
+	// a new press (a repeat without its first frame counts as one)
+	ReleaseKey(receiver);
+	if (button == NULL || button->key == 0)
+		return;
+	receiver->fHeld = true;
+	receiver->fHeldButton = *button;
+	receiver->fPressed = now;
+	receiver->fReleaseAt = now + kRelease;
+	receiver->fRepeats = 1;
+	if (button->modifiers != 0)
+		_ModifiersMessage(0, button->modifiers);
+	_KeyMessage(button->key, button->modifiers, true, 0);
+}
+
+
+/*!	The held key goes up, if there is one. Called with fLock held. */
+void
+RemoteControlDevice::ReleaseKey(RemoteReceiver* receiver)
+{
+	if (!receiver->fHeld)
+		return;
+	receiver->fHeld = false;
+	const Button& button = receiver->fHeldButton;
+	_KeyMessage(button.key, button.modifiers, false, 0);
+	if (button.modifiers != 0)
+		_ModifiersMessage(button.modifiers, 0);
+}
+
+
+/*!	The held key repeats. Called with fLock held. */
+void
+RemoteControlDevice::RepeatKey(RemoteReceiver* receiver)
+{
+	const Button& button = receiver->fHeldButton;
+	_KeyMessage(button.key, button.modifiers, true, ++receiver->fRepeats);
+}
+
+
+void
+RemoteControlDevice::_LoadProfiles()
+{
+	BObjectList<Profile, true> profiles(10);
+	Profile::LoadAll(profiles);
+	BAutolock locker(fLock);
+	fProfiles.MakeEmpty();
+	while (Profile* profile = profiles.RemoveItemAt(0))
+		fProfiles.AddItem(profile);
+}
+
+
+/*!	A key message as the keyboard add-on sends it. Called with fLock held. */
+void
+RemoteControlDevice::_KeyMessage(uint32 key, uint32 modifiers, bool down,
+	int32 repeat)
+{
+	char* string = NULL;
+	char* rawString = NULL;
+	int32 numBytes = 0;
+	int32 rawNumBytes = 0;
+	// the keymap knows the keyboard's keys; media keys have no characters
+	if (key < 128) {
+		fKeymap.GetChars(key, modifiers, 0, &string, &numBytes);
+		fKeymap.GetChars(key, 0, 0, &rawString, &rawNumBytes);
+	}
+	ArrayDeleter<char> stringDeleter(string);
+	ArrayDeleter<char> rawStringDeleter(rawString);
+
+	BMessage* message = new(std::nothrow) BMessage(numBytes > 0
+		? (down ? B_KEY_DOWN : B_KEY_UP)
+		: (down ? B_UNMAPPED_KEY_DOWN : B_UNMAPPED_KEY_UP));
+	if (message == NULL)
+		return;
+
+	uint8 states[16];
+	memset(states, 0, sizeof(states));
+	if (down && key < 128)
+		states[key >> 3] |= 1 << (7 - (key & 7));
+
+	message->AddInt64("when", system_time());
+	message->AddInt32("key", key);
+	message->AddInt32("modifiers", modifiers);
+	message->AddData("states", B_UINT8_TYPE, states, sizeof(states));
+	if (numBytes > 0) {
+		for (int32 i = 0; i < numBytes; i++)
+			message->AddInt8("byte", (int8)string[i]);
+		message->AddData("bytes", B_STRING_TYPE, string, numBytes + 1);
+		if (repeat > 0)
+			message->AddInt32("be:key_repeat", repeat);
+	}
+	if (rawNumBytes > 0)
+		message->AddInt32("raw_char", (uint32)((uint8)rawString[0] & 0x7f));
+	else if (numBytes > 0)
+		message->AddInt32("raw_char", (uint32)((uint8)string[0] & 0x7f));
+
+	if (EnqueueMessage(message) != B_OK)
+		delete message;
+}
+
+
+void
+RemoteControlDevice::_ModifiersMessage(uint32 oldModifiers, uint32 modifiers)
+{
+	BMessage* message = new(std::nothrow) BMessage(B_MODIFIERS_CHANGED);
+	if (message == NULL)
+		return;
+	uint8 states[16];
+	memset(states, 0, sizeof(states));
+	message->AddInt64("when", system_time());
+	message->AddInt32("be:old_modifiers", oldModifiers);
+	message->AddInt32("modifiers", modifiers);
+	message->AddData("states", B_UINT8_TYPE, states, sizeof(states));
+	if (EnqueueMessage(message) != B_OK)
+		delete message;
+}
+
+
+extern "C" BInputServerDevice*
+instantiate_input_device()
+{
+	return new(std::nothrow) RemoteControlDevice();
+}
