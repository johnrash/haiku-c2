diff --git a/src/add-ons/kernel/drivers/input/meson_ir/IRDecoder.cpp b/src/add-ons/kernel/drivers/input/meson_ir/IRDecoder.cpp
new file mode 100644
index 0000000000..8adcfff829
--- /dev/null
+++ b/src/add-ons/kernel/drivers/input/meson_ir/IRDecoder.cpp
@@ -0,0 +1,686 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * Protocol timings: the published descriptions of NEC, Philips RC-5 and
+ * RC-6, Sony SIRC and JVC (docs/m24-ir-facts.md). Receivers stretch marks
+ * and shorten spaces by up to about 100 us, so every range here is wide;
+ * the protocols' frame lengths and bit counts keep them apart.
+ */
+
+
+#include "IRDecoder.h"
+
+#include <string.h>
+
+
+namespace IRRemote {
+
+
+// a repeat (held button) comes within this time of the frame before
+static const uint32 kRepeatWindow = 200000;
+// NEC's repeat code carries no data: marked until the receiver fills it in
+static const uint32 kNECRepeatCode = 0x80000000;
+
+
+static inline bool
+InRange(uint32 value, uint32 low, uint32 high)
+{
+	return value >= low && value <= high;
+}
+
+
+/*!	How many \a unit long half bits \a duration is (Manchester codes): the
+	nearest whole number. The frame's structure tells wrong ones apart.
+*/
+static inline uint32
+Units(uint32 duration, uint32 unit)
+{
+	return (duration + unit / 2) / unit;
+}
+
+
+static inline uint32
+SaturatedAdd(uint32 a, uint32 b)
+{
+	return a + b < a ? ~0u : a + b;
+}
+
+
+//	#pragma mark - NEC
+// 9 ms mark, 4.5 ms space, 32 bits LSB first (address, its inverse or the
+// address' high byte, command, its inverse) of 560 us marks and 560 us (0)
+// or 1690 us (1) spaces, a 560 us stop mark. Held: 9 ms mark, 2.25 ms
+// space, 560 us mark, every 108 ms.
+
+
+void
+NECDecoder::Reset()
+{
+	fState = kIdle;
+	fBits = 0;
+	fCount = 0;
+}
+
+
+bool
+NECDecoder::Feed(bool mark, uint32 duration, ir_remote_event* event)
+{
+	switch (fState) {
+		case kIdle:
+			if (mark && InRange(duration, 6500, 11500))
+				fState = kHeaderSpace;
+			return false;
+
+		case kHeaderSpace:
+			if (!mark && InRange(duration, 3300, 5800)) {
+				fState = kBitMark;
+				fBits = 0;
+				fCount = 0;
+			} else if (!mark && InRange(duration, 1600, 3000))
+				fState = kRepeatMark;
+			else
+				Reset();
+			return false;
+
+		case kBitMark:
+			if (mark && InRange(duration, 200, 1000))
+				fState = kBitSpace;
+			else
+				Reset();
+			return false;
+
+		case kBitSpace:
+			// 560 us for a 0, 1690 us for a 1: split halfway
+			if (mark || !InRange(duration, 200, 2500)) {
+				Reset();
+				return false;
+			}
+			if (duration >= 1125)
+				fBits |= 1u << fCount;
+			fState = ++fCount == 32 ? kStopMark : kBitMark;
+			return false;
+
+		case kStopMark:
+		{
+			bool ok = mark && InRange(duration, 200, 1000);
+			if (ok) {
+				uint32 address = fBits & 0xff;
+				uint32 addressHigh = (fBits >> 8) & 0xff;
+				uint32 command = (fBits >> 16) & 0xff;
+				uint32 inverse = fBits >> 24;
+				event->flags = 0;
+				if ((command ^ inverse) != 0xff) {
+					event->protocol = IR_REMOTE_NEC32;
+					event->address = fBits & 0xffff;
+					event->command = fBits >> 16;
+				} else if ((address ^ addressHigh) == 0xff) {
+					event->protocol = IR_REMOTE_NEC;
+					event->address = address;
+					event->command = command;
+				} else {
+					event->protocol = IR_REMOTE_NEC_EXTENDED;
+					event->address = fBits & 0xffff;
+					event->command = command;
+				}
+			}
+			Reset();
+			return ok;
+		}
+
+		case kRepeatMark:
+		{
+			bool ok = mark && InRange(duration, 200, 1000);
+			if (ok) {
+				event->protocol = IR_REMOTE_NEC;
+				event->address = 0;
+				event->command = 0;
+				event->flags = IR_REMOTE_REPEAT | kNECRepeatCode;
+			}
+			Reset();
+			return ok;
+		}
+	}
+	return false;
+}
+
+
+//	#pragma mark - RC-5
+// Manchester code of 889 us half bits, a 1 being space then mark: 14 bits
+// MSB first, start bit (1), a second start bit (1, or 0 for the 7th
+// command bit of RC-5X), toggle, 5 address and 6 command bits. The first
+// half of the first bit is a space, unseen; the last half may be a space,
+// which only the gap after the frame ends.
+
+
+static const uint32 kRC5Unit = 889;
+static const uint32 kRC5Halves = 28;
+
+
+void
+RC5Decoder::Reset()
+{
+	fCount = 0;
+	fComplete = false;
+}
+
+
+bool
+RC5Decoder::_Add(bool mark, uint32 count)
+{
+	if (fCount + count > kRC5Halves)
+		return false;
+	while (count-- > 0)
+		fHalves[fCount++] = mark ? 1 : 0;
+	return true;
+}
+
+
+bool
+RC5Decoder::_Finish(ir_remote_event* event)
+{
+	uint32 bits = 0;
+	for (uint32 i = 0; i < kRC5Halves; i += 2) {
+		if (fHalves[i] == fHalves[i + 1])
+			return false;
+		bits = (bits << 1) | fHalves[i + 1];
+	}
+	if ((bits & (1u << 13)) == 0)
+		return false;
+
+	bool second = (bits & (1u << 12)) != 0;
+	event->protocol = second ? IR_REMOTE_RC5 : IR_REMOTE_RC5X;
+	event->address = (bits >> 6) & 0x1f;
+	event->command = (bits & 0x3f) | (second ? 0 : 0x40);
+	event->flags = (bits & (1u << 11)) != 0 ? IR_REMOTE_TOGGLE : 0;
+	return true;
+}
+
+
+bool
+RC5Decoder::Feed(bool mark, uint32 duration, ir_remote_event* event)
+{
+	// No header: a frame is only taken between gaps, or the bits of other
+	// protocols' frames could pass for one.
+	bool gap = !mark && duration > kRC5Unit * 9 / 2;
+	if (fCount == 0) {
+		// the start bit's mark half (with the next bit's, if it is a 0),
+		// right after silence
+		uint32 count = mark && fArmed ? Units(duration, kRC5Unit) : 0;
+		if (count == 1 || count == 2) {
+			_Add(false, 1);
+			_Add(true, count);
+		}
+		fArmed = gap;
+		return false;
+	}
+
+	if (gap) {
+		// the gap: it holds the last half bit if that is a space
+		if (fCount == kRC5Halves - 1)
+			_Add(false, 1);
+		bool ok = fCount == kRC5Halves && _Finish(event);
+		Reset();
+		fArmed = true;
+		return ok;
+	}
+	fArmed = false;
+
+	uint32 count = Units(duration, kRC5Unit);
+	if (fComplete || count < 1 || count > 2 || !_Add(mark, count)) {
+		Reset();
+		return false;
+	}
+	// a frame ending with a mark still waits for the gap
+	fComplete = fCount == kRC5Halves;
+	return false;
+}
+
+
+//	#pragma mark - RC-6 mode 0
+// A 2.666 ms leader mark and 889 us space, then Manchester code of 444 us
+// units, a 1 being mark then space: start bit (1), 3 mode bits (0), the
+// trailer bit of double length (the toggle), 8 address and 8 command bits,
+// MSB first.
+
+
+static const uint32 kRC6Unit = 444;
+static const uint32 kRC6Units = 44;
+
+
+void
+RC6Decoder::Reset()
+{
+	fState = kIdle;
+	fCount = 0;
+	fLeaderMark = 0;
+	fUnit = kRC6Unit;
+	fStretch = 0;
+}
+
+
+bool
+RC6Decoder::_Finish(ir_remote_event* event)
+{
+	const uint8* u = fUnits;
+	// start bit 1, mode 000
+	if (u[0] != 1 || u[1] != 0)
+		return false;
+	for (uint32 i = 2; i < 8; i += 2) {
+		if (u[i] != 0 || u[i + 1] != 1)
+			return false;
+	}
+	// trailer: 1 = mark mark space space
+	bool toggle;
+	if (u[8] == 1 && u[9] == 1 && u[10] == 0 && u[11] == 0)
+		toggle = true;
+	else if (u[8] == 0 && u[9] == 0 && u[10] == 1 && u[11] == 1)
+		toggle = false;
+	else
+		return false;
+
+	uint32 bits = 0;
+	for (uint32 i = 12; i < kRC6Units; i += 2) {
+		if (u[i] == u[i + 1])
+			return false;
+		bits = (bits << 1) | u[i];
+	}
+	event->protocol = IR_REMOTE_RC6;
+	event->address = bits >> 8;
+	event->command = bits & 0xff;
+	event->flags = toggle ? IR_REMOTE_TOGGLE : 0;
+	return true;
+}
+
+
+bool
+RC6Decoder::Feed(bool mark, uint32 duration, ir_remote_event* event)
+{
+	switch (fState) {
+		case kIdle:
+			if (mark && InRange(duration, 2000, 3600)) {
+				fLeaderMark = duration;
+				fState = kLeaderSpace;
+			}
+			return false;
+
+		case kLeaderSpace:
+		{
+			// The leader is 6 units of mark and 2 of space, whatever the
+			// receiver adds to marks and takes from spaces: it gives the
+			// remote's actual unit, and that stretch. 444 us units are short
+			// enough for both to matter.
+			if (mark || !InRange(duration, 400, 1600)) {
+				Reset();
+				return false;
+			}
+			fUnit = (fLeaderMark + duration) / 8;
+			fStretch = (int32)fLeaderMark - 6 * (int32)fUnit;
+			if (!InRange(fUnit, 370, 530) || fStretch > (int32)fUnit / 2
+				|| fStretch < -(int32)fUnit / 2) {
+				Reset();
+				return false;
+			}
+			fState = kBody;
+			fCount = 0;
+			return false;
+		}
+
+		case kBody:
+		case kComplete:
+		{
+			int32 corrected = (int32)duration + (mark ? -fStretch : fStretch);
+			if (corrected < 1)
+				corrected = 1;
+			if (!mark && corrected > (int32)fUnit * 7 / 2) {
+				// the gap, which holds a final space unit
+				if (fCount == kRC6Units - 1)
+					fUnits[fCount++] = 0;
+				bool ok = fCount == kRC6Units && _Finish(event);
+				Reset();
+				return ok;
+			}
+			uint32 count = Units(corrected, fUnit);
+			if (fState == kComplete || count < 1 || count > 3
+				|| fCount + count > kRC6Units) {
+				Reset();
+				return false;
+			}
+			while (count-- > 0)
+				fUnits[fCount++] = mark ? 1 : 0;
+			// a frame ending with a mark still waits for the gap
+			if (fCount == kRC6Units)
+				fState = kComplete;
+			return false;
+		}
+	}
+	return false;
+}
+
+
+//	#pragma mark - Sony SIRC
+// A 2.4 ms mark, then bits LSB first of a 600 us space and a 600 us (0) or
+// 1200 us (1) mark: 7 command bits, then 5 (12-bit frames), 8 (15-bit) or
+// 13 (20-bit) address bits. The gap after the last mark ends the frame;
+// a press sends it at least 3 times, every 45 ms.
+
+
+void
+SonyDecoder::Reset()
+{
+	fState = kIdle;
+	fBits = 0;
+	fCount = 0;
+	fHeaderMark = 0;
+	fOneMark = 900;
+}
+
+
+bool
+SonyDecoder::Feed(bool mark, uint32 duration, ir_remote_event* event)
+{
+	switch (fState) {
+		case kIdle:
+			if (mark && InRange(duration, 1800, 3200)) {
+				fHeaderMark = duration;
+				fState = kHeaderSpace;
+			}
+			return false;
+
+		case kHeaderSpace:
+		{
+			// The header is 4 units of mark and 1 of space: it gives the
+			// remote's unit and how much the receiver lengthens marks; a 1
+			// is a 2-unit mark, a 0 a 1-unit one.
+			if (mark || !InRange(duration, 250, 950)) {
+				Reset();
+				return false;
+			}
+			uint32 unit = (fHeaderMark + duration) / 5;
+			int32 stretch = (int32)fHeaderMark - 4 * (int32)unit;
+			if (!InRange(unit, 480, 720) || stretch > (int32)unit / 2
+				|| stretch < -(int32)unit / 2) {
+				Reset();
+				return false;
+			}
+			fOneMark = unit * 3 / 2 + stretch;
+			fState = kBitMark;
+			fBits = 0;
+			fCount = 0;
+			return false;
+		}
+
+		case kBitMark:
+			if (!mark || !InRange(duration, 300, 1800) || fCount == 20) {
+				Reset();
+				return false;
+			}
+			if (duration >= fOneMark)
+				fBits |= 1u << fCount;
+			fCount++;
+			fState = kBitSpace;
+			return false;
+
+		case kBitSpace:
+		{
+			if (!mark && InRange(duration, 250, 950)) {
+				fState = kBitMark;
+				return false;
+			}
+			bool ok = !mark && duration >= 3000
+				&& (fCount == 12 || fCount == 15 || fCount == 20);
+			if (ok) {
+				event->command = fBits & 0x7f;
+				event->flags = 0;
+				if (fCount == 12) {
+					event->protocol = IR_REMOTE_SONY12;
+					event->address = (fBits >> 7) & 0x1f;
+				} else if (fCount == 15) {
+					event->protocol = IR_REMOTE_SONY15;
+					event->address = (fBits >> 7) & 0xff;
+				} else {
+					// 5-bit device and 8 extended bits
+					event->protocol = IR_REMOTE_SONY20;
+					event->address = (fBits >> 7) & 0x1fff;
+				}
+			}
+			Reset();
+			return ok;
+		}
+	}
+	return false;
+}
+
+
+//	#pragma mark - JVC
+// An 8.4 ms mark and 4.2 ms space, 16 bits (8 address, 8 command) of
+// 526 us marks and 526 us (0) or 1574 us (1) spaces, a 526 us stop mark.
+// Held: the frame again without the header, every 50 to 60 ms. Bits are
+// taken LSB first, as most descriptions have it (one has MSB first).
+
+
+void
+JVCDecoder::Reset()
+{
+	fState = kIdle;
+	fRepeat = false;
+	fBits = 0;
+	fCount = 0;
+}
+
+
+void
+JVCDecoder::Elapse(uint32 duration)
+{
+	fSinceFrame = SaturatedAdd(fSinceFrame, duration);
+}
+
+
+bool
+JVCDecoder::Feed(bool mark, uint32 duration, ir_remote_event* event)
+{
+	uint32 sinceFrame = fSinceFrame;
+	Elapse(duration);
+
+	switch (fState) {
+		case kIdle:
+			if (mark && InRange(duration, 6500, 10500)) {
+				fState = kHeaderSpace;
+				fRepeat = false;
+			} else if (mark && InRange(duration, 200, 1000)
+				&& sinceFrame < 100000) {
+				// a repeat: this was the first bit's mark
+				fRepeat = true;
+				fBits = 0;
+				fCount = 0;
+				fState = kBitSpace;
+			}
+			return false;
+
+		case kHeaderSpace:
+			if (!mark && InRange(duration, 3000, 5400)) {
+				fState = kBitMark;
+				fBits = 0;
+				fCount = 0;
+			} else
+				Reset();
+			return false;
+
+		case kBitMark:
+			if (mark && InRange(duration, 200, 1000))
+				fState = fCount == 16 ? kEnd : kBitSpace;
+			else
+				Reset();
+			return false;
+
+		case kBitSpace:
+			// 526 us for a 0, 1574 us for a 1: split halfway
+			if (mark || !InRange(duration, 200, 2400)) {
+				Reset();
+				return false;
+			}
+			if (duration >= 1050)
+				fBits |= 1u << fCount;
+			fCount++;
+			fState = kBitMark;
+			return false;
+
+		case kEnd:
+		{
+			// the gap after the stop mark: not a longer frame's next bit
+			bool ok = !mark && duration >= 3000;
+			if (ok) {
+				event->protocol = IR_REMOTE_JVC;
+				event->address = fBits & 0xff;
+				event->command = fBits >> 8;
+				event->flags = fRepeat ? IR_REMOTE_REPEAT : 0;
+				fSinceFrame = 0;
+			}
+			Reset();
+			return ok;
+		}
+	}
+	return false;
+}
+
+
+//	#pragma mark - Receiver
+
+
+Receiver::Receiver()
+	:
+	fHaveLast(false),
+	fSinceLast(~0u),
+	fPulses(0),
+	fDecodedSinceGap(false),
+	fInGap(true),
+	fFrames(0),
+	fRepeats(0),
+	fUnknown(0)
+{
+	// RC-5, the one without a header, is asked last: when two finish a
+	// frame together, the other is right
+	fDecoders[0] = &fNEC;
+	fDecoders[1] = &fRC6;
+	fDecoders[2] = &fSony;
+	fDecoders[3] = &fJVC;
+	fDecoders[4] = &fRC5;
+	memset(&fLast, 0, sizeof(fLast));
+}
+
+
+void
+Receiver::Reset()
+{
+	for (uint32 i = 0; i < B_COUNT_OF(fDecoders); i++)
+		fDecoders[i]->Reset();
+	fHaveLast = false;
+	fSinceLast = ~0u;
+	fPulses = 0;
+	fDecodedSinceGap = false;
+	fInGap = true;
+}
+
+
+bool
+Receiver::Feed(bool mark, uint32 duration, ir_remote_event* event)
+{
+	fSinceLast = SaturatedAdd(fSinceLast, duration);
+
+	bool decoded = false;
+	if (mark || !fInGap)
+		decoded = _FeedAll(mark, duration, event);
+	else
+		fJVC.Elapse(duration);
+
+	if (mark) {
+		fInGap = false;
+		fPulses++;
+	}
+	bool result = decoded && _Decoded(event);
+
+	if (!mark && duration >= kGap && !fInGap) {
+		// the end of a pulse train
+		if (fPulses >= 4 && !fDecodedSinceGap)
+			fUnknown++;
+		fPulses = 0;
+		fDecodedSinceGap = false;
+		fInGap = true;
+	}
+	return result;
+}
+
+
+bool
+Receiver::Gap(ir_remote_event* event)
+{
+	if (fInGap)
+		return false;
+
+	// as if the space so far were one long space; the edge that ends it
+	// later only adds its time
+	bool result = _FeedAll(false, kGap, event) && _Decoded(event);
+	if (fPulses >= 4 && !fDecodedSinceGap)
+		fUnknown++;
+	fPulses = 0;
+	fDecodedSinceGap = false;
+	fInGap = true;
+	return result;
+}
+
+
+/*!	Every decoder sees every pulse (RC-5 has to see gaps to know where a
+	frame may start); the first in order that finishes a frame wins.
+*/
+bool
+Receiver::_FeedAll(bool mark, uint32 duration, ir_remote_event* event)
+{
+	bool decoded = false;
+	for (uint32 i = 0; i < B_COUNT_OF(fDecoders); i++) {
+		ir_remote_event candidate;
+		if (fDecoders[i]->Feed(mark, duration, &candidate) && !decoded) {
+			*event = candidate;
+			decoded = true;
+		}
+	}
+	return decoded;
+}
+
+
+bool
+Receiver::_Decoded(ir_remote_event* event)
+{
+	for (uint32 i = 0; i < B_COUNT_OF(fDecoders); i++)
+		fDecoders[i]->Reset();
+	fDecodedSinceGap = true;
+
+	bool recent = fHaveLast && fSinceLast < kRepeatWindow;
+	if ((event->flags & kNECRepeatCode) != 0) {
+		// NEC's repeat code: the last NEC frame again
+		if (!recent || (fLast.protocol != IR_REMOTE_NEC
+				&& fLast.protocol != IR_REMOTE_NEC_EXTENDED
+				&& fLast.protocol != IR_REMOTE_NEC32)) {
+			return false;
+		}
+		*event = fLast;
+		event->flags |= IR_REMOTE_REPEAT;
+	} else if (recent && event->protocol == fLast.protocol
+		&& event->address == fLast.address
+		&& event->command == fLast.command
+		&& (event->flags & IR_REMOTE_TOGGLE)
+			== (fLast.flags & IR_REMOTE_TOGGLE)) {
+		// the frame again while the button is held
+		event->flags |= IR_REMOTE_REPEAT;
+	}
+
+	fLast = *event;
+	fHaveLast = true;
+	fSinceLast = 0;
+	fFrames++;
+	if ((event->flags & IR_REMOTE_REPEAT) != 0)
+		fRepeats++;
+	return true;
+}
+
+
+}	// namespace IRRemote
diff --git a/src/add-ons/kernel/drivers/input/meson_ir/IRDecoder.h b/src/add-ons/kernel/drivers/input/meson_ir/IRDecoder.h
new file mode 100644
index 0000000000..d804696468
