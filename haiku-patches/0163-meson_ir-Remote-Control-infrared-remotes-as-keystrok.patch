diff --git a/src/add-ons/input_server/devices/remote_control/RemoteProfile.cpp b/src/add-ons/input_server/devices/remote_control/RemoteProfile.cpp
new file mode 100644
index 0000000000..54d70f9c5f
--- /dev/null
+++ b/src/add-ons/input_server/devices/remote_control/RemoteProfile.cpp
@@ -0,0 +1,295 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "RemoteProfile.h"
+
+#include <new>
+
+#include <Directory.h>
+#include <Entry.h>
+#include <File.h>
+#include <FindDirectory.h>
+#include <Message.h>
+#include <Path.h>
+
+#include <ir_remote.h>
+
+
+namespace RemoteControl {
+
+
+static const uint32 kProfileMessage = 'rcPF';
+static const char* const kDirectoryName = "Remote Control";
+
+
+static int
+CompareProfiles(const Profile* a, const Profile* b)
+{
+	return a->Name().ICompare(b->Name());
+}
+
+
+Profile::Profile()
+	:
+	fEnabled(true),
+	fProtocol(0),
+	fAddress(0),
+	fButtons(20)
+{
+}
+
+
+Profile::Profile(const Profile& other)
+	:
+	fButtons(20)
+{
+	*this = other;
+}
+
+
+Profile&
+Profile::operator=(const Profile& other)
+{
+	if (this == &other)
+		return *this;
+	fName = other.fName;
+	fEnabled = other.fEnabled;
+	fProtocol = other.fProtocol;
+	fAddress = other.fAddress;
+	fButtons.MakeEmpty();
+	for (int32 i = 0; i < other.CountButtons(); i++)
+		AddButton(*other.ButtonAt(i));
+	return *this;
+}
+
+
+status_t
+Profile::Archive(BMessage* archive) const
+{
+	archive->MakeEmpty();
+	archive->what = kProfileMessage;
+	archive->AddString("name", fName);
+	archive->AddBool("enabled", fEnabled);
+	archive->AddInt32("protocol", fProtocol);
+	archive->AddInt32("address", fAddress);
+	for (int32 i = 0; i < CountButtons(); i++) {
+		const Button* button = ButtonAt(i);
+		BMessage buttonArchive;
+		buttonArchive.AddString("label", button->label);
+		buttonArchive.AddInt32("command", button->command);
+		buttonArchive.AddInt32("key", button->key);
+		buttonArchive.AddInt32("modifiers", button->modifiers);
+		buttonArchive.AddBool("repeat", button->repeat);
+		status_t status = archive->AddMessage("button", &buttonArchive);
+		if (status != B_OK)
+			return status;
+	}
+	return B_OK;
+}
+
+
+status_t
+Profile::Unarchive(const BMessage& archive)
+{
+	if (archive.what != kProfileMessage)
+		return B_BAD_DATA;
+	fName = archive.GetString("name", "");
+	fEnabled = archive.GetBool("enabled", true);
+	fProtocol = (uint32)archive.GetInt32("protocol", 0);
+	fAddress = (uint32)archive.GetInt32("address", 0);
+	fButtons.MakeEmpty();
+	BMessage buttonArchive;
+	for (int32 i = 0; archive.FindMessage("button", i, &buttonArchive) == B_OK;
+			i++) {
+		Button button;
+		button.label = buttonArchive.GetString("label", "");
+		button.command = (uint32)buttonArchive.GetInt32("command", 0);
+		button.key = (uint32)buttonArchive.GetInt32("key", 0);
+		button.modifiers = (uint32)buttonArchive.GetInt32("modifiers", 0);
+		button.repeat = buttonArchive.GetBool("repeat", false);
+		AddButton(button);
+	}
+	return fName.IsEmpty() ? B_BAD_DATA : B_OK;
+}
+
+
+status_t
+Profile::Load(const char* path)
+{
+	BFile file(path, B_READ_ONLY);
+	status_t status = file.InitCheck();
+	if (status != B_OK)
+		return status;
+	BMessage archive;
+	status = archive.Unflatten(&file);
+	if (status != B_OK)
+		return status;
+	return Unarchive(archive);
+}
+
+
+status_t
+Profile::GetPath(BPath* path) const
+{
+	status_t status = GetDirectory(path, true);
+	if (status != B_OK)
+		return status;
+	// the name, without what a file name can't have
+	BString fileName(fName);
+	fileName.ReplaceAll('/', '-');
+	if (fileName.IsEmpty() || fileName == "." || fileName == "..")
+		fileName.Prepend("Remote ");
+	return path->Append(fileName);
+}
+
+
+status_t
+Profile::Save() const
+{
+	BPath path;
+	status_t status = GetPath(&path);
+	if (status != B_OK)
+		return status;
+	BMessage archive;
+	status = Archive(&archive);
+	if (status != B_OK)
+		return status;
+	BFile file(path.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+	status = file.InitCheck();
+	if (status != B_OK)
+		return status;
+	return archive.Flatten(&file);
+}
+
+
+status_t
+Profile::Remove() const
+{
+	BPath path;
+	status_t status = GetPath(&path);
+	if (status != B_OK)
+		return status;
+	BEntry entry(path.Path());
+	return entry.Remove();
+}
+
+
+bool
+Profile::Matches(uint32 protocol, uint32 address) const
+{
+	return fEnabled && Family(protocol) == Family(fProtocol)
+		&& address == fAddress;
+}
+
+
+Button*
+Profile::FindButton(uint32 command) const
+{
+	for (int32 i = 0; i < CountButtons(); i++) {
+		if (ButtonAt(i)->command == command)
+			return ButtonAt(i);
+	}
+	return NULL;
+}
+
+
+Button*
+Profile::AddButton(const Button& button)
+{
+	Button* copy = new(std::nothrow) Button(button);
+	if (copy == NULL || !fButtons.AddItem(copy)) {
+		delete copy;
+		return NULL;
+	}
+	return copy;
+}
+
+
+void
+Profile::RemoveButton(int32 index)
+{
+	delete fButtons.RemoveItemAt(index);
+}
+
+
+void
+Profile::MoveButton(int32 from, int32 to)
+{
+	fButtons.MoveItem(from, to);
+}
+
+
+/*static*/ status_t
+Profile::GetDirectory(BPath* path, bool create)
+{
+	status_t status = find_directory(B_USER_SETTINGS_DIRECTORY, path, create);
+	if (status != B_OK)
+		return status;
+	status = path->Append(kDirectoryName);
+	if (status != B_OK || !create)
+		return status;
+	status = create_directory(path->Path(), 0755);
+	return status == B_FILE_EXISTS ? B_OK : status;
+}
+
+
+/*static*/ status_t
+Profile::LoadAll(BObjectList<Profile, true>& profiles)
+{
+	profiles.MakeEmpty();
+	BPath path;
+	status_t status = GetDirectory(&path, false);
+	if (status != B_OK)
+		return status;
+	BDirectory directory(path.Path());
+	if (directory.InitCheck() != B_OK)
+		return B_OK;
+
+	BEntry entry;
+	while (directory.GetNextEntry(&entry, true) == B_OK) {
+		BPath entryPath;
+		if (entry.GetPath(&entryPath) != B_OK)
+			continue;
+		Profile* profile = new(std::nothrow) Profile;
+		if (profile == NULL)
+			return B_NO_MEMORY;
+		if (profile->Load(entryPath.Path()) != B_OK
+			|| !profiles.AddItem(profile)) {
+			delete profile;
+		}
+	}
+	profiles.SortItems(&CompareProfiles);
+	return B_OK;
+}
+
+
+/*static*/ uint32
+Profile::Family(uint32 protocol)
+{
+	return protocol == IR_REMOTE_RC5X ? (uint32)IR_REMOTE_RC5 : protocol;
+}
+
+
+/*static*/ const char*
+Profile::ProtocolName(uint32 protocol)
+{
+	switch (protocol) {
+		case IR_REMOTE_NEC: return "NEC";
+		case IR_REMOTE_NEC_EXTENDED: return "NEC (extended address)";
+		case IR_REMOTE_NEC32: return "NEC (32 bits)";
+		case IR_REMOTE_RC5: return "RC-5";
+		case IR_REMOTE_RC5X: return "RC-5X";
+		case IR_REMOTE_RC6: return "RC-6";
+		case IR_REMOTE_SONY12: return "Sony (12 bits)";
+		case IR_REMOTE_SONY15: return "Sony (15 bits)";
+		case IR_REMOTE_SONY20: return "Sony (20 bits)";
+		case IR_REMOTE_JVC: return "JVC";
+	}
+	return "unknown";
+}
+
+
+}	// namespace RemoteControl
