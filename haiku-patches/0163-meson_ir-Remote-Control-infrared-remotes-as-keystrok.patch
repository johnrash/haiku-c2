diff --git a/headers/private/drivers/ir_remote.h b/headers/private/drivers/ir_remote.h
new file mode 100644
index 0000000000..aea178ea27
--- /dev/null
+++ b/headers/private/drivers/ir_remote.h
@@ -0,0 +1,84 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _IR_REMOTE_H
+#define _IR_REMOTE_H
+
+
+/*!	Infrared remote control receivers (the ODROID-C2's meson_ir): what a
+	read of /dev/input/remote/<driver>/<n> gives, and the ioctls.
+
+	A read returns whole ir_remote_event structures, one per decoded frame,
+	and blocks until there is at least one (or returns B_WOULD_BLOCK with
+	O_NONBLOCK). Pulse trains no decoder knows are only counted.
+*/
+
+
+#include <Drivers.h>
+
+
+#define IR_REMOTE_DEVICE_DIRECTORY	"/dev/input/remote"
+
+
+enum ir_remote_protocol {
+	IR_REMOTE_NEC		= 1,	// 8-bit address and its inverse
+	IR_REMOTE_NEC_EXTENDED,		// 16-bit address
+	IR_REMOTE_NEC32,			// command not followed by its inverse
+	IR_REMOTE_RC5,
+	IR_REMOTE_RC5X,				// 7-bit command (second start bit)
+	IR_REMOTE_RC6,				// mode 0
+	IR_REMOTE_SONY12,
+	IR_REMOTE_SONY15,
+	IR_REMOTE_SONY20,
+	IR_REMOTE_JVC
+};
+
+
+enum {
+	IR_REMOTE_REPEAT	= 0x01,	// the button is held: the same press
+	IR_REMOTE_TOGGLE	= 0x02	// RC-5/RC-6 toggle bit (changes per press)
+};
+
+
+struct ir_remote_event {
+	uint32		protocol;		// ir_remote_protocol
+	uint32		address;		// device/system code
+	uint32		command;		// the button
+	uint32		flags;
+	bigtime_t	when;			// system_time() at the frame's end
+};
+
+
+// a mark (carrier on) or a space, in microseconds
+struct ir_remote_pulse {
+	uint32		duration : 31;
+	uint32		mark : 1;
+};
+
+
+struct ir_remote_stats {
+	uint32		frames;			// decoded
+	uint32		repeats;		// of them
+	uint32		unknown;		// pulse trains no decoder took
+	uint32		edges;			// interrupts
+	uint32		overruns;		// events or pulses lost: nobody read them
+};
+
+
+enum {
+	// ir_remote_stats
+	IR_REMOTE_GET_STATS = B_DEVICE_OP_CODES_END + 0x4952,
+	// the newest raw pulses (ir_remote_pulse[], at most the length given;
+	// the size of what was copied is returned), oldest first, for learning
+	// unknown remotes; collected only while a raw reader asks for them
+	IR_REMOTE_READ_PULSES,
+	// flushes the pulse buffer and starts collecting pulses (bool)
+	IR_REMOTE_COLLECT_PULSES,
+	// waits until this handle has an event to read, at most the given
+	// time (bigtime_t, relative): B_OK, or B_TIMED_OUT
+	IR_REMOTE_WAIT_FOR_EVENT
+};
+
+
+#endif	// _IR_REMOTE_H
