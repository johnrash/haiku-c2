@@ -43,6 +43,26 @@ enum {
 		// meson_gpio_pwm: a claimed pin as a PWM output (pins 11 and 19)
 	MESON_GPIO_GET_PWM,
 		// meson_gpio_pwm: in pin, out duty (the last one set, by any file)
+	MESON_GPIO_SET_PULL,
+		// meson_gpio_pull: the pull of claimed pins (GPIO inputs keep it)
+	MESON_GPIO_SET_PWM_PERIOD,
+		// meson_gpio_pwm_period: a claimed pin as a PWM output with that
+		// period and high time; out: what the hardware makes of them
+	MESON_GPIO_GET_PWM_PERIOD,
+		// meson_gpio_pwm_period: in bit, out the period and high time
+	MESON_GPIO_GET_PIN_INFO,
+		// meson_gpio_pin_info: in index (0 up: every header pin with a SoC
+		// pad); B_BAD_INDEX past the last one. No claim needed.
+	MESON_GPIO_SET_EDGES,
+		// meson_gpio_edges: from now on, record a claimed pin's edges (0:
+		// stop); what was recorded before is dropped. Each edge type of a
+		// pin takes one of the 8 interrupt channels: B_BUSY when they are
+		// taken. Outputs too: the pin's own edges.
+	MESON_GPIO_WAIT_EDGE,
+		// meson_gpio_edge: in bit and timeout; out the oldest recorded edge,
+		// which is removed. B_TIMED_OUT; B_INTERRUPTED (a signal);
+		// B_CANCELED: the recording stopped; B_NOT_ALLOWED: none started.
+		// Doesn't block the file's other calls.
 };
 
 
@@ -58,4 +78,72 @@ struct meson_gpio_pwm {
 };
 
 
+enum {
+	MESON_GPIO_PULL_NONE,
+	MESON_GPIO_PULL_DOWN,
+	MESON_GPIO_PULL_UP,
+};
+
+
+struct meson_gpio_pull {
+	uint32		bits;			// the claimed pins it is for
+	uint32		pull;			// MESON_GPIO_PULL_*
+};
+
+
+struct meson_gpio_pwm_period {
+	uint32		bit;
+	uint32		period;			// nanoseconds: 84 to 349525333
+	uint32		high;			// nanoseconds: 0 (low) to period (high)
+};
+
+
+enum {
+	MESON_GPIO_EDGE_RISING	= 0x01,
+	MESON_GPIO_EDGE_FALLING	= 0x02,
+};
+
+
+struct meson_gpio_edges {
+	uint32		bit;
+	uint32		edges;			// MESON_GPIO_EDGE_*, or both
+};
+
+
+struct meson_gpio_edge {
+	uint32		bit;			// in
+	bigtime_t	timeout;		// in: relative, or B_INFINITE_TIMEOUT
+	uint32		edge;			// MESON_GPIO_EDGE_RISING or _FALLING
+	uint32		level;			// the pin's level when it was recorded
+	bigtime_t	when;			// system_time() then
+	uint32		missed;			// edges lost before it (32 wait at most)
+};
+
+
+enum {
+	MESON_GPIO_PIN_GPIO		= 0x01,		// offered to programs as GPIO
+	MESON_GPIO_PIN_PWM		= 0x02,
+	MESON_GPIO_PIN_UART		= 0x04,
+	MESON_GPIO_PIN_I2C		= 0x08,
+
+	MESON_GPIO_PIN_OUTPUT	= 0x100,	// now: a GPIO output
+	MESON_GPIO_PIN_LEVEL	= 0x200,	// now: high
+	MESON_GPIO_PIN_PULL_UP	= 0x400,
+	MESON_GPIO_PIN_PULL_DOWN = 0x800,
+	MESON_GPIO_PIN_PWM_ON	= 0x1000,	// now: a PWM output
+	MESON_GPIO_PIN_EDGES	= 0x2000,	// now: its edges are recorded
+};
+
+
+struct meson_gpio_pin_info {
+	uint32		index;			// in
+	uint32		pin;			// the header's number
+	char		pad[16];		// "GPIOX_21"
+	char		function[16];	// "GPIO", or the alternate function
+	char		use[32];		// who has it ("program", "I2C A"); "" if free
+	int32		team;			// that user's team, or -1
+	uint32		flags;			// MESON_GPIO_PIN_*
+};
+
+
 #endif	// _MESON_GPIO_H
