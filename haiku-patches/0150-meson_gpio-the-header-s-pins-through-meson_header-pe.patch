+/*!	Stops the pin's PWM slot, if it has one. Only the slot's own enable bit
+	changes: the MISC word is shared with the other slot.
+*/
+void
+MesonGpio::_DisablePwm(uint32 index)
+{
+	const PwmPin* pwm = _PwmPin(index);
+	fPwm[index].active = false;
+	if (pwm == NULL)
+		return;
+	volatile uint32& misc = fPwmRegisters[(kPwmEF + kPwmMisc) / 4];
+	InterruptsLocker locker;
+	misc &= ~(pwm->slotB ? 1u << 1 : 1u << 0);
+}
+
+
+/*!	The pin as a PWM output: the crystal divided by \a divider (1 to 128),
+	a period of \a cycles of that (2 to 65536), high for \a high of them; a
+	constant level when \a high is 0 or \a cycles: the pin as a GPIO output.
+	The slot takes new counts at the end of its period, from a write that
+	changes them. A write that follows another one to the slot too soon is
+	lost, and so is the earlier one, it seems (on the ODROID-C2: right
+	after a clock change, and two count writes in a row, left the old counts
+	running at the new clock for good; rewriting the same counts then
+	didn't help). So writes are a few ticks of the slowest clock apart, and
+	counts the register holds already go in as a value that differs first.
+*/
+status_t
+MesonGpio::_SetPwm(uint32 index, uint32 divider, uint32 cycles, uint32 high)
+{
+	const PwmPin* pwm = _PwmPin(index);
+	if (pwm == NULL)
+		return B_NOT_SUPPORTED;
+	if (divider < 1 || divider > kMaxDivider || cycles < 2
+		|| cycles > kMaxCycles || high > cycles) {
+		return B_BAD_VALUE;
+	}
+
+	if (high == 0 || high == cycles) {
+		_SetOutputLevel(index, high != 0);
+		_SetDirection(index, true);
+	} else {
+		// the slot (crystal, the divider, its clock on, running), then the
+		// counts, then the pin; each phase lasts its count + 1
+		volatile uint32& misc = fPwmRegisters[(kPwmEF + kPwmMisc) / 4];
+		uint32 fields = pwm->slotB
+			? (1u << 23) | (0x7fu << 16) | (3u << 6) | (1u << 1)
+			: (1u << 15) | (0x7fu << 8) | (3u << 4) | (1u << 0);
+		uint32 value = pwm->slotB
+			? (1u << 23) | ((divider - 1) << 16) | (1u << 1)
+			: (1u << 15) | ((divider - 1) << 8) | (1u << 0);
+		bool changed;
+		{
+			InterruptsLocker locker;
+			changed = (misc & fields) != value;
+			misc = (misc & ~fields) | value;
+		}
+		// four ticks of the slowest clock (128 / 24 MHz each)
+		const bigtime_t kSettle = 25;
+		if (changed)
+			spin(kSettle);
+		volatile uint32& counts
+			= fPwmRegisters[(kPwmEF + (pwm->slotB ? 4 : 0)) / 4];
+		uint32 count = ((high - 1) << 16) | (cycles - high - 1);
+		if (counts == count) {
+			counts = count ^ 1;
+			spin(kSettle);
+		}
+		counts = count;
+		spin(kSettle);
+		gHeader->select(index, pwm->function);
+	}
+
+	PwmState& state = fPwm[index];
+	state.active = true;
+	state.period = (uint32)((uint64)cycles * divider * 1000000000 / kCrystal);
+	state.high = (uint32)((uint64)high * divider * 1000000000 / kCrystal);
+	state.duty = (uint8)(((uint64)high * 255 + cycles / 2) / cycles);
+	return B_OK;
+}
+
+
+/*!	A period and high time in nanoseconds: the finest divider that can
+	count the period.
+*/
+status_t
+MesonGpio::_SetPwmPeriod(uint32 index, uint32 period, uint32 high)
+{
+	if (high > period)
+		return B_BAD_VALUE;
+	for (uint32 divider = 1; divider <= kMaxDivider; divider++) {
+		uint64 rate = kCrystal / divider;
+		uint64 cycles = ((uint64)period * rate + 500000000) / 1000000000;
+		if (cycles > kMaxCycles)
+			continue;
+		if (cycles < 2)
+			return B_BAD_VALUE;
+		uint64 highCycles = ((uint64)high * rate + 500000000) / 1000000000;
+		if (highCycles > cycles)
+			highCycles = cycles;
+		return _SetPwm(index, divider, cycles, highCycles);
+	}
+	return B_BAD_VALUE;
+}
+
