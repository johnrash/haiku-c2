+/*!	Stops recording a pin's edges: its channels are parked and free again,
+	and whoever waits for one gets B_CANCELED.
+*/
+void
+MesonGpio::_StopEdges(uint32 index)
+{
+	EdgeRecorder& recorder = fRecorders[index];
+	uint8 channels[2];
+	{
+		InterruptsSpinLocker locker(fEdgeLock);
+		if (recorder.edges == 0)
+			return;
+		for (uint32 type = 0; type < 2; type++) {
+			channels[type] = recorder.channels[type];
+			if (channels[type] != kNoChannel)
+				_SetChannel(channels[type], kNoInput, false);
+			recorder.channels[type] = kNoChannel;
+		}
+		recorder.owner = NULL;
+		recorder.edges = 0;
+		recorder.count = 0;
+		recorder.condition.NotifyAll(B_CANCELED);
+	}
+	for (uint32 type = 0; type < 2; type++) {
+		if (channels[type] == kNoChannel)
+			continue;
+		remove_io_interrupt_handler(kFirstChannelVector + channels[type],
+			&_EdgeInterrupt, &fChannels[channels[type]]);
+		InterruptsSpinLocker locker(fEdgeLock);
+		fChannels[channels[type]].used = false;
+	}
+}
