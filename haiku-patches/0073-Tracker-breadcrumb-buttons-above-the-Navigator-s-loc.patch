+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "BreadcrumbBar.h"
+
+#include <algorithm>
+
+#include <ControlLook.h>
+#include <LayoutUtils.h>
+#include <Looper.h>
+#include <MessageFilter.h>
+#include <Messenger.h>
+#include <TextView.h>
+#include <Window.h>
+
+
+namespace BPrivate {
+
+static const uint32 kMsgCheckTextView = 'BCtv';
+
+
+// BTextView has no hook for scrolling, so after every event that can
+// scroll it the bar is asked to check whether its buttons still line up.
+class TextViewWatcher : public BMessageFilter {
+public:
+	TextViewWatcher(BHandler* bar)
+		:
+		BMessageFilter(B_ANY_DELIVERY, B_ANY_SOURCE),
+		fBar(bar)
+	{
+	}
+
+	virtual filter_result Filter(BMessage* message, BHandler** target)
+	{
+		switch (message->what) {
+			case B_MOUSE_MOVED:
+				if (message->GetInt32("buttons", 0) == 0)
+					break;
+				// fall through
+			case B_KEY_DOWN:
+			case B_MOUSE_DOWN:
+			case B_MOUSE_UP:
+			case B_MOUSE_WHEEL_CHANGED:
+			case B_INPUT_METHOD_EVENT:
+			case B_CUT:
+			case B_PASTE:
+			case B_UNDO:
+			case B_REDO:
+			case B_SELECT_ALL:
+			{
+				// never block the window thread on its own port
+				BMessage check(kMsgCheckTextView);
+				fBar.SendMessage(&check, (BHandler*)NULL, 0);
+				break;
+			}
+		}
+
+		return B_DISPATCH_MESSAGE;
+	}
+
+private:
+	BMessenger fBar;
+};
+
+} // namespace BPrivate
+
+
+//	#pragma mark - BBreadcrumbBar
+
+
+BBreadcrumbBar::BBreadcrumbBar(BTextView* textView, BHandler* target,
+	uint32 command)
+	:
+	BView("breadcrumbs", B_WILL_DRAW | B_FRAME_EVENTS
+		| B_FULL_UPDATE_ON_RESIZE),
+	fTextView(textView),
+	fWatchingTextView(false),
+	fTarget(target),
+	fCommand(command),
+	fTextOrigin(0),
+	fTextLeft(0),
+	fTextRight(0),
+	fHoverSegment(-1),
+	fPressedSegment(-1),
+	fPressedInside(false)
+{
+	fEdges.push_back(0);
+}
+
+
+BBreadcrumbBar::~BBreadcrumbBar()
+{
+}
+
+
+void
+BBreadcrumbBar::SetPath(const char* path)
+{
+	if (path == NULL)
+		path = "";
+	if (fPath == path)
+		return;
+
+	fPath = path;
+
+	// One segment per path component, the slash after a component belongs
+	// to its segment: "/", "boot/", "home/", "Desktop".
+	fStarts.clear();
+	if (fPath.Length() > 0) {
+		fStarts.push_back(0);
+		for (int32 i = 0; i < fPath.Length() - 1; i++) {
+			if (fPath[i] == '/')
+				fStarts.push_back(i + 1);
+		}
+	}
+
+	fHoverSegment = -1;
+	fPressedSegment = -1;
+	fPressedInside = false;
+	HideToolTip();
+
+	_Layout();
+	Invalidate();
+}
+
+
+int32
+BBreadcrumbBar::CountSegments() const
+{
+	return (int32)fStarts.size();
+}
+
+
+BString
+BBreadcrumbBar::SegmentPath(int32 index) const
+{
+	BString path;
+	if (index < 0 || index >= CountSegments())
+		return path;
+
+	if (index == CountSegments() - 1)
+		return fPath;
+
+	// up to the slash ending this segment, but keep the root's slash
+	int32 length = std::max(fStarts[index + 1] - 1, (int32)1);
+	fPath.CopyInto(path, 0, length);
+	return path;
+}
+
+
+BRect
+BBreadcrumbBar::SegmentFrame(int32 index) const
+{
+	if (index < 0 || index >= CountSegments()
+		|| fEdges.size() != fStarts.size() + 1) {
+		return BRect();
+	}
+
+	BRect bounds(Bounds());
+	return BRect(fEdges[index], bounds.top, fEdges[index + 1] - 1,
+		bounds.bottom);
+}
+
+
+void
+BBreadcrumbBar::AttachedToWindow()
+{
+	BView::AttachedToWindow();
+	AdoptParentColors();
+
+	if (fTextView != NULL && !fWatchingTextView) {
+		fTextView->AddFilter(new TextViewWatcher(this));
+		fWatchingTextView = true;
+	}
+}
+
+
+void
+BBreadcrumbBar::Draw(BRect updateRect)
+{
+	// the text view may have scrolled or moved since the last time
+	_Layout();
+
+	rgb_color base = ui_color(B_CONTROL_BACKGROUND_COLOR);
+	rgb_color background = ViewColor();
+
+	for (int32 i = 0; i < CountSegments(); i++) {
+		BRect frame(SegmentFrame(i));
+		if (!frame.IsValid() || !frame.Intersects(updateRect))
+			continue;
+
+		uint32 flags = 0;
+		if (i == fPressedSegment && fPressedInside)
+			flags |= BControlLook::B_ACTIVATED;
+		else if (i == fHoverSegment)
+			flags |= BControlLook::B_HOVER;
+
+		be_control_look->DrawButtonFrame(this, frame, updateRect, 0.0f, base,
+			background, flags);
+		be_control_look->DrawButtonBackground(this, frame, updateRect, 0.0f,
+			base, flags);
+	}
+}
+
+
+void
+BBreadcrumbBar::FrameResized(float width, float height)
+{
+	BView::FrameResized(width, height);
+
+	// the text view may scroll once it got its new size, too
+	if (Looper() != NULL)
+		Looper()->PostMessage(kMsgCheckTextView, this);
+}
+
+
+void
+BBreadcrumbBar::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgCheckTextView:
+			if (_TextViewMoved())
+				Invalidate();
+			break;
+
+		default:
+			BView::MessageReceived(message);
+			break;
+	}
+}
+
+
+void
+BBreadcrumbBar::MouseDown(BPoint where)
+{
+	int32 buttons = B_PRIMARY_MOUSE_BUTTON;
+	if (Window()->CurrentMessage() != NULL) {
+		buttons = Window()->CurrentMessage()->GetInt32("buttons",
+			B_PRIMARY_MOUSE_BUTTON);
+	}
+
+	int32 index = _SegmentAt(where);
+	if (buttons != B_PRIMARY_MOUSE_BUTTON || !_IsClickable(index))
+		return;
+
+	fPressedSegment = index;
+	fPressedInside = true;
+	SetMouseEventMask(B_POINTER_EVENTS, B_NO_POINTER_HISTORY);
+	_InvalidateSegment(index);
+}
+
+
+void
+BBreadcrumbBar::MouseMoved(BPoint where, uint32 transit,
+	const BMessage* dragMessage)
+{
+	int32 index = -1;
+	if (transit != B_EXITED_VIEW && transit != B_OUTSIDE_VIEW)
+		index = _SegmentAt(where);
+
+	if (fPressedSegment >= 0) {
+		bool inside = index == fPressedSegment;
+		if (inside != fPressedInside) {
+			fPressedInside = inside;
+			_InvalidateSegment(fPressedSegment);
+		}
+		return;
+	}
+
+	if (dragMessage != NULL || !_IsClickable(index))
+		index = -1;
+	_SetHoverSegment(index);
+
+	BView::MouseMoved(where, transit, dragMessage);
+}
+
+
+void
+BBreadcrumbBar::MouseUp(BPoint where)
+{
+	if (fPressedSegment < 0)
+		return;
+
+	int32 index = fPressedSegment;
+	bool invoke = fPressedInside && _SegmentAt(where) == index;
+
+	fPressedSegment = -1;
+	fPressedInside = false;
+	_InvalidateSegment(index);
+
+	if (invoke)
+		_Invoke(index);
+}
+
+
+bool
+BBreadcrumbBar::GetToolTipAt(BPoint where, BToolTip** _tip)
+{
+	int32 index = _SegmentAt(where);
+	if (index < 0) {
+		*_tip = NULL;
+		return false;
+	}
+
+	SetToolTip(SegmentPath(index).String());
+	return BView::GetToolTipAt(where, _tip);
+}
+
+
+BSize
+BBreadcrumbBar::MinSize()
+{
+	return BLayoutUtils::ComposeSize(ExplicitMinSize(),
+		BSize(10, _Height() - 1));
+}
+
+
+BSize
+BBreadcrumbBar::MaxSize()
+{
+	return BLayoutUtils::ComposeSize(ExplicitMaxSize(),
+		BSize(B_SIZE_UNLIMITED, _Height() - 1));
+}
+
+
+BSize
+BBreadcrumbBar::PreferredSize()
+{
+	return BLayoutUtils::ComposeSize(ExplicitPreferredSize(),
+		BSize(10, _Height() - 1));
+}
+
+
+void
+BBreadcrumbBar::_TextViewGeometry(float& origin, float& left,
+	float& right) const
+{
+	BRect bounds(Bounds());
+	origin = left = bounds.left;
+	right = bounds.right;
+
+	if (fTextView == NULL || fTextView->Window() == NULL
+		|| fTextView->Window() != Window()) {
+		return;
+	}
+
+	BRect textBounds = ConvertFromScreen(
+		fTextView->ConvertToScreen(fTextView->Bounds()));
+	BPoint textOrigin = ConvertFromScreen(
+		fTextView->ConvertToScreen(fTextView->PointAt(0)));
+
+	origin = textOrigin.x;
+	left = textBounds.left;
+	right = textBounds.right;
+}
+
+
+void
+BBreadcrumbBar::_Layout()
+{
+	_TextViewGeometry(fTextOrigin, fTextLeft, fTextRight);
+
+	BFont font;
+	if (fTextView != NULL)
+		fTextView->GetFontAndColor(0, &font);
+	else
+		GetFont(&font);
+
+	// Each button starts where the text of its component starts; the first
+	// one also covers the space left of the text, the last one the space
+	// right of it. Components scrolled out of sight get no button.
+	BRect bounds(Bounds());
+	int32 count = CountSegments();
+	fEdges.resize(count + 1);
+	fEdges[0] = bounds.left;
+	for (int32 i = 1; i < count; i++) {
+		float x = fTextOrigin + font.StringWidth(fPath.String(), fStarts[i]);
+		if (x < fTextLeft)
+			x = bounds.left;
+		else if (x > fTextRight)
+			x = bounds.right + 1;
+		fEdges[i] = roundf(x);
+	}
+	fEdges[count] = bounds.right + 1;
+}
+
+
+bool
+BBreadcrumbBar::_TextViewMoved() const
+{
+	float origin;
+	float left;
+	float right;
+	_TextViewGeometry(origin, left, right);
+
+	return origin != fTextOrigin || left != fTextLeft || right != fTextRight;
+}
+
+
+int32
+BBreadcrumbBar::_SegmentAt(BPoint where) const
+{
+	if (!Bounds().Contains(where))
+		return -1;
+
+	for (int32 i = 0; i < CountSegments(); i++) {
+		if (SegmentFrame(i).Contains(where))
+			return i;
+	}
+
+	return -1;
+}
+
+
+bool
+BBreadcrumbBar::_IsClickable(int32 index) const
+{
+	// the last segment is the folder that is already shown
+	return index >= 0 && index < CountSegments() - 1;
+}
+
+
+void
+BBreadcrumbBar::_SetHoverSegment(int32 index)
+{
+	if (index == fHoverSegment)
+		return;
+
+	_InvalidateSegment(fHoverSegment);
+	fHoverSegment = index;
+	_InvalidateSegment(fHoverSegment);
+
+	// the tool tip shows the path of the segment below the mouse
+	HideToolTip();
+}
+
+
+void
+BBreadcrumbBar::_InvalidateSegment(int32 index)
+{
+	BRect frame(SegmentFrame(index));
+	if (frame.IsValid())
+		Invalidate(frame);
+}
+
+
+void
+BBreadcrumbBar::_Invoke(int32 index)
+{
+	if (fTarget == NULL || Looper() == NULL)
+		return;
+
+	BMessage message(fCommand);
+	message.AddString("path", SegmentPath(index));
+	if (index + 1 < CountSegments())
+		message.AddString("select", SegmentPath(index + 1));
+
+	Looper()->PostMessage(&message, fTarget);
+}
+
+
+float
+BBreadcrumbBar::_Height()
+{
+	font_height fontHeight;
+	GetFontHeight(&fontHeight);
+
+	return std::max(8.0f,
+		ceilf((fontHeight.ascent + fontHeight.descent) * 0.7f));
+}
