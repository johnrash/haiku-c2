+#ifndef _BREADCRUMB_BAR_H
+#define _BREADCRUMB_BAR_H
+
+
+#include <String.h>
+#include <View.h>
+
+#include <vector>
+
+
+class BTextView;
+
+namespace BPrivate {
+
+// A row of buttons drawn right above a text view that shows a path, one
+// button per path component and lined up with the component's text, like
+// the path buttons of the IRIX file manager. Clicking a button sends the
+// command to the target with the "path" of that folder and the "select"
+// path of the next component, the folder to select in it.
+//
+// The text view must stay alive as long as the bar does.
+
+class BBreadcrumbBar : public BView {
+public:
+								BBreadcrumbBar(BTextView* textView,
+									BHandler* target, uint32 command);
+	virtual						~BBreadcrumbBar();
+
+			void				SetPath(const char* path);
+			const char*			Path() const { return fPath.String(); }
+
+			int32				CountSegments() const;
+			BString				SegmentPath(int32 index) const;
+			BRect				SegmentFrame(int32 index) const;
+
+	virtual	void				AttachedToWindow();
+	virtual	void				Draw(BRect updateRect);
+	virtual	void				FrameResized(float width, float height);
+	virtual	void				MessageReceived(BMessage* message);
+	virtual	void				MouseDown(BPoint where);
+	virtual	void				MouseMoved(BPoint where, uint32 transit,
+									const BMessage* dragMessage);
+	virtual	void				MouseUp(BPoint where);
+	virtual	bool				GetToolTipAt(BPoint where, BToolTip** _tip);
+
+	virtual	BSize				MinSize();
+	virtual	BSize				MaxSize();
+	virtual	BSize				PreferredSize();
+
+private:
+			void				_TextViewGeometry(float& origin, float& left,
+									float& right) const;
+			void				_Layout();
+			bool				_TextViewMoved() const;
+			int32				_SegmentAt(BPoint where) const;
+			bool				_IsClickable(int32 index) const;
+			void				_SetHoverSegment(int32 index);
+			void				_InvalidateSegment(int32 index);
+			void				_Invoke(int32 index);
+			float				_Height();
+
+			BTextView*			fTextView;
+			bool				fWatchingTextView;
+			BHandler*			fTarget;
+			uint32				fCommand;
+
+			BString				fPath;
+			std::vector<int32>	fStarts;
+				// byte offset in fPath where each segment starts
+			std::vector<float>	fEdges;
+				// left edge of each segment and the end of the last one
+
+			float				fTextOrigin;
+			float				fTextLeft;
+			float				fTextRight;
+				// where the text view was at the last _Layout()
+
+			int32				fHoverSegment;
+			int32				fPressedSegment;
+			bool				fPressedInside;
+};
+
+} // namespace BPrivate
+
+using namespace BPrivate;
+
+
+#endif	// _BREADCRUMB_BAR_H
