+void
+BNavigator::GoToBreadcrumb(const BMessage* message, bool option)
+{
+	const char* path;
+	BEntry entry;
+	if (message->FindString("path", &path) != B_OK
+		|| entry.SetTo(path) != B_OK || !entry.IsDirectory()) {
+		return;
+	}
+
+	// select the folder we came from (or its ancestor) in the new location
+	const char* childPath;
+	BNode child;
+	node_ref childNodeRef;
+	const node_ref* nodeRefToSelect = NULL;
+	if (message->FindString("select", &childPath) == B_OK
+		&& child.SetTo(childPath) == B_OK
+		&& child.GetNodeRef(&childNodeRef) == B_OK) {
+		nodeRefToSelect = &childNodeRef;
+	}
+
+	SendNavigationMessage(kActionSet, &entry, option, nodeRefToSelect);
+}
+
+
 void
 BNavigator::SendNavigationMessage(NavigationAction action, BEntry* entry,
-	bool option)
+	bool option, const node_ref* nodeRefToSelect)
 {
 	entry_ref ref;
 
@@ -230,11 +273,9 @@ BNavigator::SendNavigationMessage(NavigationAction action, BEntry* entry,
 		message.AddInt32("action", action);
 
 		// get the node of this folder for selecting it in the new location
-		const node_ref* nodeRef;
-		if (Window() && Window()->TargetModel())
+		const node_ref* nodeRef = nodeRefToSelect;
+		if (nodeRef == NULL && Window() && Window()->TargetModel())
 			nodeRef = Window()->TargetModel()->NodeRef();
-		else
-			nodeRef = NULL;
 
 		// if the option key was held down, open in new window (send message
 		// to be_app) otherwise send message to this window. TTracker
@@ -345,7 +386,12 @@ BNavigator::UpdateLocation(const Model* newmodel, int32 action)
 	SetActionEnabled(kNavigatorCommandForward, fForwHistory.CountItems() > 0);
 	SetActionEnabled(kNavigatorCommandBackward, fBackHistory.CountItems() > 1);
 
-	// Avoid loss of selection and cursor position
-	if (action != kActionLocation)
+	// Avoid loss of selection and cursor position, but show the normalized
+	// path the breadcrumb buttons line up with
+	if (action != kActionLocation
+		|| strcmp(fLocation->Text(), fPath.Path()) != 0) {
 		fLocation->SetText(fPath.Path());
+	}
+
+	fBreadcrumbs->SetPath(fPath.Path());
 }
