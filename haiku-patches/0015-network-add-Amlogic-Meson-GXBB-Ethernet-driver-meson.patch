+
+static status_t
+register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "Amlogic Meson GXBB Ethernet" } },
+		{ NULL }
+	};
+
+	return gDeviceManager->register_node(parent, DRIVER_MODULE_NAME, attrs,
+		NULL, NULL);
+}
+
+
+static status_t
+init_driver(device_node* node, void** _cookie)
+{
+	DeviceNodePutter<&gDeviceManager> fdtNode(
+		gDeviceManager->get_parent_node(node));
+
+	fdt_device_module_info* fdtModule;
+	fdt_device* fdtDevice;
+	if (gDeviceManager->get_driver(fdtNode.Get(),
+			(driver_module_info**)&fdtModule, (void**)&fdtDevice) != B_OK) {
+		return B_ERROR;
+	}
+	if (!fdt_device_enabled(fdtModule, fdtDevice))
+		return B_DEVICE_NOT_FOUND;
+
+	// The MAC sits directly in "soc" (identity "ranges"): its reg is the
+	// CPU physical address.
+	uint64 registers;
+	uint64 length;
+	if (!fdtModule->get_reg(fdtDevice, 0, &registers, &length))
+		return B_ERROR;
+
+	uint64 irq = 0;
+	if (!fdtModule->get_interrupt(fdtDevice, 0, NULL, &irq))
+		irq = 0;
+
+	int macLength;
+	const uint8* dtMacAddress = (const uint8*)fdtModule->get_prop(fdtDevice,
+		"local-mac-address", &macLength);
+	if (macLength != 6)
+		dtMacAddress = NULL;
+
+	MesonDwmac* device = new(std::nothrow) MesonDwmac(node);
+	if (device == NULL)
+		return B_NO_MEMORY;
+
+	status_t status = device->Init(registers, length, (int32)irq,
+		dtMacAddress);
+	if (status != B_OK) {
+		delete device;
+		return status;
+	}
+
+	*_cookie = device;
+	return B_OK;
+}
