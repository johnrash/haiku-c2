-/*static*/ int
+/*static*/ /*!	Leaves one entry for each network name in \a networks, a scan's results,
+	and returns how many there are: a network often comes through several
+	access points and bands, each a result of its own. The entry kept is the
+	one the device is associated with, if any, or else the strongest. Hidden
+	networks, which have no name, are left out.
+*/
+/*static*/ uint32
+WirelessNetworkMenuItem::MergeNetworks(wireless_network* networks,
+	uint32 count, const std::set<BNetworkAddress>& associated)
+{
+	uint32 kept = 0;
+	for (uint32 i = 0; i < count; i++) {
+		const wireless_network network = networks[i];
+		if (network.name[0] == '\0')
+			continue;
+
+		uint32 index = 0;
+		while (index < kept && strncmp(networks[index].name, network.name,
+				sizeof(network.name)) != 0) {
+			index++;
+		}
+		if (index == kept) {
+			networks[kept++] = network;
+			continue;
+		}
+
+		bool isAssociated
+			= associated.find(network.address) != associated.end();
+		bool keptIsAssociated
+			= associated.find(networks[index].address) != associated.end();
+		if ((isAssociated && !keptIsAssociated)
+			|| (isAssociated == keptIsAssociated
+				&& network.signal_strength > networks[index].signal_strength)) {
+			networks[index] = network;
+		}
+	}
+	return kept;
+}
