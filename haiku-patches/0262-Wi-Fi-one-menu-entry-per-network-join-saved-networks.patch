+void
+AutoconfigLooper::_AutoJoin()
+{
+	if ((fLastMediaStatus & IFM_ACTIVE) != 0 || system_time() < fNextAutoJoin)
+		return;
+
+	fNextAutoJoin = system_time() + (kAutoJoinInterval
+		<< min_c(fAutoJoinAttempts, kMaxAutoJoinBackOff));
+	fAutoJoinAttempts++;
+
+	// The net_server leaves a device alone that was asked to join a network
+	// only moments ago, so this doesn't interfere with a join in progress
+	// (whose scans end up here as well).
+	BMessage message(kMsgAutoJoinNetwork);
+	message.AddString("device", fDevice);
+	fTarget.SendMessage(&message);
