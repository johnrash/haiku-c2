 src/system/boot/arch/arm64/Jamfile            |   1 +
 src/system/boot/platform/efi/dtb.cpp          |   2 +
 src/system/kernel/arch/arm64/Jamfile          |   1 +
 .../kernel/arch/arm64/arch_debug_console.cpp  |   5 +
 .../kernel/arch/arm64/arch_uart_meson.cpp     | 122 ++++++++++++++++++
 6 files changed, 173 insertions(+)
 create mode 100644 headers/private/kernel/arch/arm64/arch_uart_meson.h
 create mode 100644 src/system/kernel/arch/arm64/arch_uart_meson.cpp

diff --git a/headers/private/kernel/arch/arm64/arch_uart_meson.h b/headers/private/kernel/arch/arm64/arch_uart_meson.h
