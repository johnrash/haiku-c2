--- /dev/null
+++ b/headers/private/kernel/arch/arm64/arch_uart_meson.h
@@ -0,0 +1,42 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef __DEV_UART_MESON_H
+#define __DEV_UART_MESON_H
+
+
+#include <arch/generic/debug_uart.h>
+
+
+#define UART_KIND_MESON "meson"
+
+
+// Amlogic Meson GX UART (S905 uart_AO and the EE UARTs). Baud rate, framing
+// and pin setup are left as the firmware (U-Boot) configured them.
+class ArchUARTMeson : public DebugUART {
+public:
+						ArchUARTMeson(addr_t base, int64 clock);
+						~ArchUARTMeson();
+
+			void		InitPort(uint32 baud);
+
+			void		Enable();
+			void		Disable();
+
+			int			PutChar(char c);
+			int			GetChar(bool wait);
+
+			void		FlushTx();
+			void		FlushRx();
+
+private:
+			void		Out32(int reg, uint32 data);
+			uint32		In32(int reg);
+};
+
+
+ArchUARTMeson* arch_get_uart_meson(addr_t base, int64 clock);
+
+
+#endif
