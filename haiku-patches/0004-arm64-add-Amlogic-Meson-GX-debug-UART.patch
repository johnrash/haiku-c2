diff --git a/src/system/kernel/arch/arm64/arch_uart_meson.cpp b/src/system/kernel/arch/arm64/arch_uart_meson.cpp
new file mode 100644
index 0000000000..baede70f5f
--- /dev/null
+++ b/src/system/kernel/arch/arm64/arch_uart_meson.cpp
@@ -0,0 +1,122 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+#include <arch/generic/debug_uart.h>
+#include <arch/arm64/arch_uart_meson.h>
+#include <new>
+
+
+#define MESON_WFIFO		0x00	// Transmit FIFO
+#define MESON_RFIFO		0x04	// Receive FIFO
+#define MESON_CONTROL	0x08	// Control
+#define MESON_STATUS	0x0c	// Status
+
+#define STATUS_RX_EMPTY	(1 << 20)	// Receive FIFO empty
+#define STATUS_TX_FULL	(1 << 21)	// Transmit FIFO full
+#define STATUS_TX_EMPTY	(1 << 22)	// Transmit FIFO empty
+
+
+ArchUARTMeson::ArchUARTMeson(addr_t base, int64 clock)
+	:
+	DebugUART(base, clock)
+{
+}
+
+
+ArchUARTMeson::~ArchUARTMeson()
+{
+}
+
+
+void
+ArchUARTMeson::Out32(int reg, uint32 data)
+{
+	*(volatile uint32*)(Base() + reg) = data;
+}
+
+
+uint32
+ArchUARTMeson::In32(int reg)
+{
+	return *(volatile uint32*)(Base() + reg);
+}
+
+
+void
+ArchUARTMeson::InitPort(uint32 baud)
+{
+	// Keep the firmware's baud rate divider and line settings.
+}
+
+
+void
+ArchUARTMeson::Enable()
+{
+	DebugUART::Enable();
+}
+
+
+void
+ArchUARTMeson::Disable()
+{
+	DebugUART::Disable();
+}
+
+
+int
+ArchUARTMeson::PutChar(char c)
+{
+	if (Enabled()) {
+		while ((In32(MESON_STATUS) & STATUS_TX_FULL) != 0)
+			;
+
+		Out32(MESON_WFIFO, (uint8)c);
+		return 0;
+	}
+
+	return -1;
+}
+
+
+int
+ArchUARTMeson::GetChar(bool wait)
+{
+	if (Enabled()) {
+		while (wait && (In32(MESON_STATUS) & STATUS_RX_EMPTY) != 0)
+			;
+
+		if ((In32(MESON_STATUS) & STATUS_RX_EMPTY) != 0)
+			return -1;
+
+		return In32(MESON_RFIFO) & 0xff;
+	}
+
+	return -1;
+}
+
+
+void
+ArchUARTMeson::FlushTx()
+{
+	while ((In32(MESON_STATUS) & STATUS_TX_EMPTY) == 0)
+		;
+}
+
+
+void
+ArchUARTMeson::FlushRx()
+{
+	while ((In32(MESON_STATUS) & STATUS_RX_EMPTY) == 0)
+		In32(MESON_RFIFO);
+}
+
+
+ArchUARTMeson*
+arch_get_uart_meson(addr_t base, int64 clock)
+{
+	static char buffer[sizeof(ArchUARTMeson)];
+	ArchUARTMeson* uart = new(buffer) ArchUARTMeson(base, clock);
+	return uart;
+}
