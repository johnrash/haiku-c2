+}
+
+
+static status_t
+device_control(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	MesonHdmi* device = (MesonHdmi*)cookie;
+	switch (op) {
+		case B_GET_ACCELERANT_SIGNATURE:
+			return user_strlcpy((char*)buffer, MESON_HDMI_ACCELERANT_NAME,
+				B_FILE_NAME_LENGTH) < 0 ? B_BAD_ADDRESS : B_OK;
+
+		case MESON_HDMI_GET_SHARED_INFO:
+		{
+			area_id area = device->SharedArea();
+			return user_memcpy(buffer, &area, sizeof(area_id));
+		}
+
+		case MESON_HDMI_CLONE_FRAME_BUFFER:
+		{
+			void* address;
+			area_id area = vm_clone_area(B_CURRENT_TEAM,
+				"meson_hdmi frame buffer", &address, B_ANY_ADDRESS,
+				B_READ_AREA | B_WRITE_AREA, REGION_NO_PRIVATE_MAP,
+				device->FrameBufferArea(), true);
+			if (area < 0)
+				return area;
+			return _user_get_area_info(area, (area_info*)buffer);
+		}
+
+		case MESON_HDMI_SET_DISPLAY_MODE:
+		{
+			display_mode mode;
+			if (user_memcpy(&mode, buffer, sizeof(mode)) != B_OK)
+				return B_BAD_ADDRESS;
+			return device->SetDisplayMode(mode);
+		}
+
+		case MESON_HDMI_GET_DEVICE_NAME:
+			return user_strlcpy((char*)buffer, "graphics/meson_hdmi/0",
+				B_PATH_NAME_LENGTH) < 0 ? B_BAD_ADDRESS : B_OK;
+	}
+	return B_DEV_INVALID_IOCTL;
+}
