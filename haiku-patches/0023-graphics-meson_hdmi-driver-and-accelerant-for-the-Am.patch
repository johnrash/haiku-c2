+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef MESON_HDMI_INFO_H
+#define MESON_HDMI_INFO_H
+
+
+#include <Accelerant.h>
+#include <Drivers.h>
+
+
+#define MESON_HDMI_ACCELERANT_NAME	"meson_hdmi.accelerant"
+#define MESON_HDMI_MAX_MODES		8
+#define MESON_HDMI_EDID_SIZE		256
+
+
+// ioctls of graphics/meson_hdmi/0
+enum {
+	MESON_HDMI_GET_SHARED_INFO = B_DEVICE_OP_CODES_END + 1,
+		// area_id of the shared info
+	MESON_HDMI_CLONE_FRAME_BUFFER,
+		// clones the frame buffer into the calling team; area_info
+	MESON_HDMI_SET_DISPLAY_MODE,
+		// display_mode; must be one of the modes in the shared info
+	MESON_HDMI_GET_DEVICE_NAME,
+		// char[B_PATH_NAME_LENGTH], for clone accelerants
+};
+
+
+struct meson_hdmi_shared_info {
+	display_mode	current_mode;
+	uint32			bytes_per_row;
+
+	uint32			mode_count;
+	display_mode	modes[MESON_HDMI_MAX_MODES];
+	uint32			preferred_mode;		// index into modes
+
+	uint32			edid_size;			// 0: no EDID
+	uint8			edid[MESON_HDMI_EDID_SIZE];
+		// raw: the base block and the first extension
+};
+
+
+#endif	// MESON_HDMI_INFO_H
