+
+static int
+dump_meson_hdmi(int argc, char** argv)
+{
+	if (sDevice == NULL) {
+		kprintf("meson_hdmi: no device\n");
+		return 0;
+	}
+	if (argc > 1 && strcmp(argv[1], "restore") == 0) {
+		sDevice->RestoreBootMode();
+		kprintf("meson_hdmi: boot mode restored (U-Boot's frame buffer)\n");
+		return 0;
+	}
+	sDevice->DumpState();
+	return 0;
+}
+
+
+//	#pragma mark - driver module
+
+
+static float
+supports_device(device_node* parent)
+{
+	const char* bus;
+	if (gDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false)
+			!= B_OK || strcmp(bus, "fdt") != 0) {
+		return 0.0f;
+	}
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(parent, "fdt/compatible", &compatible,
+			false) != B_OK
+		|| strcmp(compatible, "amlogic,meson-gxbb-vpu") != 0) {
+		return 0.0f;
+	}
+	return 0.8f;
+}
+
+
+static status_t
+register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "Amlogic Meson GXBB HDMI" } },
+		{ NULL }
+	};
+	return gDeviceManager->register_node(parent, DRIVER_MODULE_NAME, attrs,
+		NULL, NULL);
+}
+
+
+static status_t
+init_driver(device_node* node, void** _cookie)
+{
+	MesonHdmi* device = new(std::nothrow) MesonHdmi(node);
+	if (device == NULL)
+		return B_NO_MEMORY;
+	status_t status = device->Init();
+	if (status != B_OK) {
+		delete device;
+		return status;
+	}
+	sDevice = device;
+	add_debugger_command("meson_hdmi", &dump_meson_hdmi,
+		"Show the Meson HDMI display state; \"restore\": U-Boot's mode");
+	*_cookie = device;
+	return B_OK;
+}
+
+
+static void
+uninit_driver(void* cookie)
+{
+	remove_debugger_command("meson_hdmi", &dump_meson_hdmi);
+	sDevice = NULL;
+	delete (MesonHdmi*)cookie;
+}
+
+
+static status_t
+register_child_devices(void* cookie)
+{
+	MesonHdmi* device = (MesonHdmi*)cookie;
+	if (!device->Publish())
+		return B_OK;
+	return gDeviceManager->publish_device(device->Node(),
+		"graphics/meson_hdmi/0", DEVICE_MODULE_NAME);
+}
