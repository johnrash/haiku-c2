diff --git a/src/add-ons/accelerants/meson_hdmi/accelerant.cpp b/src/add-ons/accelerants/meson_hdmi/accelerant.cpp
new file mode 100644
index 0000000000..3a41e8d09e
--- /dev/null
+++ b/src/add-ons/accelerants/meson_hdmi/accelerant.cpp
@@ -0,0 +1,289 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+/*!	Accelerant for the meson_hdmi driver (Amlogic Meson GXBB HDMI). The
+	kernel driver owns the hardware: it builds the mode list from the
+	modes it can set and the EDID, and sets modes. This side only clones
+	the shared info and the frame buffer and passes requests on.
+*/
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+#include <Accelerant.h>
+#include <OS.h>
+#include <edid.h>
+
+#include "meson_hdmi_info.h"
+
+
+struct accelerant_info {
+	int						device;
+	bool					is_clone;
+	area_id					shared_area;
+	meson_hdmi_shared_info*	shared;
+	area_id					frame_buffer_area;
+	uint8*					frame_buffer;
+	size_t					frame_buffer_size;
+};
+
+static accelerant_info sInfo = { -1, false, -1, NULL, -1, NULL, 0 };
+
+
+static status_t
+init_common(int device, bool isClone)
+{
+	sInfo.device = device;
+	sInfo.is_clone = isClone;
+
+	area_id sharedArea;
+	if (ioctl(device, MESON_HDMI_GET_SHARED_INFO, &sharedArea,
+			sizeof(sharedArea)) != 0) {
+		return B_ERROR;
+	}
+	sInfo.shared_area = clone_area("meson_hdmi shared info",
+		(void**)&sInfo.shared, B_ANY_ADDRESS, B_READ_AREA, sharedArea);
+	if (sInfo.shared_area < 0)
+		return sInfo.shared_area;
+
+	area_info info;
+	if (ioctl(device, MESON_HDMI_CLONE_FRAME_BUFFER, &info, sizeof(info))
+			!= 0) {
+		delete_area(sInfo.shared_area);
+		return B_ERROR;
+	}
+	sInfo.frame_buffer_area = info.area;
+	sInfo.frame_buffer = (uint8*)info.address;
+	sInfo.frame_buffer_size = info.size;
+	return B_OK;
+}
+
+
+static status_t
+meson_init_accelerant(int device)
+{
+	return init_common(device, false);
+}
+
+
+static void
+meson_uninit_accelerant(void)
+{
+	delete_area(sInfo.frame_buffer_area);
+	delete_area(sInfo.shared_area);
+	if (sInfo.is_clone)
+		close(sInfo.device);
+	sInfo.shared = NULL;
+}
+
+
+static ssize_t
+meson_accelerant_clone_info_size(void)
+{
+	return B_PATH_NAME_LENGTH;
+}
+
+
+static void
+meson_get_accelerant_clone_info(void* data)
+{
+	ioctl(sInfo.device, MESON_HDMI_GET_DEVICE_NAME, data, B_PATH_NAME_LENGTH);
+}
+
+
+static status_t
+meson_clone_accelerant(void* data)
+{
+	char path[B_PATH_NAME_LENGTH];
+	snprintf(path, sizeof(path), "/dev/%s", (const char*)data);
+	int device = open(path, B_READ_WRITE);
+	if (device < 0)
+		return errno;
+	status_t status = init_common(device, true);
+	if (status != B_OK)
+		close(device);
+	return status;
+}
+
+
+static status_t
+meson_get_accelerant_device_info(accelerant_device_info* info)
+{
+	info->version = B_ACCELERANT_VERSION;
+	strcpy(info->name, "Amlogic Meson GXBB HDMI");
+	strcpy(info->chipset, "S905");
+	strcpy(info->serial_no, "");
+	info->memory = sInfo.frame_buffer_size;
+	info->dac_speed = 0;
+	return B_OK;
+}
+
+
+static sem_id
+meson_accelerant_retrace_semaphore(void)
+{
+	return B_ERROR;
+}
+
+
+static uint32
+meson_accelerant_mode_count(void)
+{
+	return sInfo.shared->mode_count;
+}
+
+
+static status_t
+meson_get_mode_list(display_mode* modes)
+{
+	memcpy(modes, sInfo.shared->modes,
+		sInfo.shared->mode_count * sizeof(display_mode));
+	return B_OK;
+}
+
+
+static uint32
+refresh_rate(const display_mode& mode)
+{
+	uint32 total = (uint32)mode.timing.h_total * mode.timing.v_total;
+	return total == 0 ? 0 : mode.timing.pixel_clock * 1000 / total;
+}
+
+
+/*!	Picks the listed mode with the requested size whose refresh rate is
+	closest to the requested one.
+*/
+static status_t
+meson_propose_display_mode(display_mode* target, const display_mode* low,
+	const display_mode* high)
+{
+	const display_mode* best = NULL;
+	uint32 wanted = refresh_rate(*target);
+	for (uint32 i = 0; i < sInfo.shared->mode_count; i++) {
+		const display_mode& mode = sInfo.shared->modes[i];
+		if (mode.timing.h_display != target->timing.h_display
+			|| mode.timing.v_display != target->timing.v_display) {
+			continue;
+		}
+		if (best == NULL || abs((int32)refresh_rate(mode) - (int32)wanted)
+				< abs((int32)refresh_rate(*best) - (int32)wanted)) {
+			best = &mode;
+		}
+	}
+	if (best == NULL)
+		return B_BAD_VALUE;
+	*target = *best;
+	return B_OK;
+}
+
+
+static status_t
+meson_set_display_mode(display_mode* mode)
+{
+	if (ioctl(sInfo.device, MESON_HDMI_SET_DISPLAY_MODE, mode,
+			sizeof(display_mode)) != 0) {
+		return errno;
+	}
+	return B_OK;
+}
+
+
+static status_t
+meson_get_display_mode(display_mode* mode)
+{
+	*mode = sInfo.shared->current_mode;
+	return B_OK;
+}
+
+
+static status_t
+meson_get_preferred_display_mode(display_mode* mode)
+{
+	if (sInfo.shared->mode_count == 0)
+		return B_ERROR;
+	*mode = sInfo.shared->modes[sInfo.shared->preferred_mode];
+	return B_OK;
+}
+
+
+static status_t
+meson_get_edid_info(void* info, size_t size, uint32* _version)
+{
+	if (sInfo.shared->edid_size < 128)
+		return B_ERROR;
+	if (size < sizeof(edid1_info))
+		return B_BUFFER_OVERFLOW;
+	edid_decode((edid1_info*)info, (const edid1_raw*)sInfo.shared->edid);
+	*_version = EDID_VERSION_1;
+	return B_OK;
+}
+
+
+static status_t
+meson_get_frame_buffer_config(frame_buffer_config* config)
+{
+	config->frame_buffer = sInfo.frame_buffer;
+	config->frame_buffer_dma = NULL;
+	config->bytes_per_row = sInfo.shared->bytes_per_row;
+	return B_OK;
+}
+
+
+static status_t
+meson_get_pixel_clock_limits(display_mode* mode, uint32* _low, uint32* _high)
+{
+	uint32 total = (uint32)mode->timing.h_total * mode->timing.v_total;
+	*_low = total * 24 / 1000;		// 24 Hz
+	*_high = 148500;
+	return *_low <= *_high ? B_OK : B_ERROR;
+}
+
+
+extern "C" void*
+get_accelerant_hook(uint32 feature, void* data)
+{
+	switch (feature) {
+		case B_INIT_ACCELERANT:
+			return (void*)meson_init_accelerant;
+		case B_UNINIT_ACCELERANT:
+			return (void*)meson_uninit_accelerant;
+		case B_CLONE_ACCELERANT:
+			return (void*)meson_clone_accelerant;
+		case B_ACCELERANT_CLONE_INFO_SIZE:
+			return (void*)meson_accelerant_clone_info_size;
+		case B_GET_ACCELERANT_CLONE_INFO:
+			return (void*)meson_get_accelerant_clone_info;
+		case B_GET_ACCELERANT_DEVICE_INFO:
+			return (void*)meson_get_accelerant_device_info;
+		case B_ACCELERANT_RETRACE_SEMAPHORE:
+			return (void*)meson_accelerant_retrace_semaphore;
+
+		case B_ACCELERANT_MODE_COUNT:
+			return (void*)meson_accelerant_mode_count;
+		case B_GET_MODE_LIST:
+			return (void*)meson_get_mode_list;
+		case B_PROPOSE_DISPLAY_MODE:
+			return (void*)meson_propose_display_mode;
+		case B_SET_DISPLAY_MODE:
+			return (void*)meson_set_display_mode;
+		case B_GET_DISPLAY_MODE:
+			return (void*)meson_get_display_mode;
+		case B_GET_PREFERRED_DISPLAY_MODE:
+			return (void*)meson_get_preferred_display_mode;
+		case B_GET_EDID_INFO:
+			return (void*)meson_get_edid_info;
+		case B_GET_FRAME_BUFFER_CONFIG:
+			return (void*)meson_get_frame_buffer_config;
+		case B_GET_PIXEL_CLOCK_LIMITS:
+			return (void*)meson_get_pixel_clock_limits;
+	}
+	return NULL;
+}
