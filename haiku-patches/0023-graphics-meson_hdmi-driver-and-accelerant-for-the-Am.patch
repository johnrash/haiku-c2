+status_t
+MesonHdmi::Init()
+{
+	void* address;
+	fVpuArea = map_physical_memory("meson_hdmi vpu", kVpuBase, kVpuSize,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		&address);
+	if (fVpuArea < 0)
+		return fVpuArea;
+	fVpu = (volatile uint32*)address;
+	fHhiArea = map_physical_memory("meson_hdmi hhi", kHhiBase, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		&address);
+	if (fHhiArea < 0)
+		return fHhiArea;
+	fHhi = (volatile uint32*)address;
+	fHdmiTxArea = map_physical_memory("meson_hdmi hdmitx", kHdmiTxBase,
+		B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	if (fHdmiTxArea < 0)
+		return fHdmiTxArea;
+	fHdmiTx = (volatile uint32*)address;
+	fDmcArea = map_physical_memory("meson_hdmi dmc", kDmcBase, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		&address);
+	if (fDmcArea < 0)
+		return fDmcArea;
+	fDmc = (volatile uint32*)address;
+
+	void* settings = load_driver_settings("meson_hdmi");
+	if (settings != NULL) {
+		fPublish = get_driver_boolean_parameter(settings, "mode_setting",
+			true, true);
+		unload_driver_settings(settings);
+	}
+
+	frame_buffer_boot_info* boot = (frame_buffer_boot_info*)get_boot_item(
+		FRAME_BUFFER_BOOT_INFO, NULL);
+	if (boot != NULL) {
+		fBootWidth = boot->width;
+		fBootHeight = boot->height;
+		fBootBytesPerRow = boot->bytes_per_row;
+		fBootFrameBuffer = boot->physical_frame_buffer;
+	}
+	INFO("controller %02x.%02x, product %02x%02x; HPD %s; boot mode %"
+		B_PRIu32 "x%" B_PRIu32 ", %" B_PRIu32 " bytes per row, frame buffer %#"
+		B_PRIxPHYSADDR "\n", _DwRead(DW_DESIGN_ID), _DwRead(DW_REVISION_ID),
+		_DwRead(DW_PRODUCT_ID0), _DwRead(DW_PRODUCT_ID1),
+		(_TopRead(HDMITX_TOP_STAT0) & 1) != 0 ? "high" : "low",
+		fBootWidth, fBootHeight, fBootBytesPerRow, fBootFrameBuffer);
+
+	_CheckBootMode();
+	_ReadEdid();
+	if (!fPublish) {
+		INFO("mode setting off in the driver settings\n");
+		return B_OK;
+	}
+	if (fBootWidth == 0) {
+		INFO("no boot frame buffer, nothing to take over\n");
+		fPublish = false;
+		return B_OK;
+	}
+
+	_SaveBootState();
+	status_t status = _AllocateFrameBuffer();
+	if (status != B_OK)
+		return status;
+
+	fSharedArea = create_area("meson_hdmi shared info", (void**)&fShared,
+		B_ANY_KERNEL_ADDRESS,
+		(sizeof(meson_hdmi_shared_info) + B_PAGE_SIZE - 1) & ~(B_PAGE_SIZE - 1),
+		B_FULL_LOCK, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA
+			| B_CLONEABLE_AREA);
+	if (fSharedArea < 0)
+		return fSharedArea;
+	memset(fShared, 0, sizeof(meson_hdmi_shared_info));
+	fShared->edid_size = fEdidSize;
+	memcpy(fShared->edid, fEdid, fEdidSize);
+	_BuildModeList();
+
+	// until app_server sets a mode, the boot mode is current (in U-Boot's
+	// frame buffer)
+	for (uint32 i = 0; i < fShared->mode_count; i++) {
+		if (fShared->modes[i].virtual_width == fBootWidth
+			&& fShared->modes[i].virtual_height == fBootHeight) {
+			fShared->current_mode = fShared->modes[i];
+			break;
+		}
+	}
+	fShared->bytes_per_row = fBootBytesPerRow;
+	return B_OK;
+}
+
+
+/*!	One buffer for the largest mode, allocated while memory is still
+	unfragmented. The VPU does not snoop caches: the pages are written
+	back and invalidated through their cached alias, then used only
+	through a write-combining mapping.
+*/
+status_t
+MesonHdmi::_AllocateFrameBuffer()
+{
+	fFrameBufferSize = (kMaxWidth * kMaxHeight * 4 + B_PAGE_SIZE - 1)
+		& ~(B_PAGE_SIZE - 1);
+	void* pages;
+	fFrameBufferArea = create_area("meson_hdmi frame buffer pages", &pages,
+		B_ANY_KERNEL_ADDRESS, fFrameBufferSize, B_32_BIT_CONTIGUOUS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+	if (fFrameBufferArea < 0)
+		return fFrameBufferArea;
+	physical_entry entry;
+	get_memory_map(pages, B_PAGE_SIZE, &entry, 1);
+	fFrameBufferPhysical = entry.address;
+
+	uint64 ctr;
+	asm volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	const addr_t lineSize = 4 << ((ctr >> 16) & 0xf);
+	for (addr_t line = KERNEL_PMAP_BASE + fFrameBufferPhysical;
+			line < KERNEL_PMAP_BASE + fFrameBufferPhysical + fFrameBufferSize;
+			line += lineSize) {
+		asm volatile("dc civac, %0" : : "r"(line) : "memory");
+	}
+	asm volatile("dsb sy" : : : "memory");
+
+	fFrameBufferMapArea = map_physical_memory("meson_hdmi frame buffer",
+		fFrameBufferPhysical, fFrameBufferSize, B_ANY_KERNEL_ADDRESS,
+		B_READ_AREA | B_WRITE_AREA, (void**)&fFrameBuffer);
+	if (fFrameBufferMapArea < 0)
+		return fFrameBufferMapArea;
+	vm_set_area_memory_type(fFrameBufferMapArea, fFrameBufferPhysical,
+		B_WRITE_COMBINING_MEMORY);
+	memset(fFrameBuffer, 0, fFrameBufferSize);
+	INFO("frame buffer %#" B_PRIxPHYSADDR ", %" B_PRIuSIZE " bytes\n",
+		fFrameBufferPhysical, fFrameBufferSize);
+	return B_OK;
+}
+
+
+/*!	The modes of kModes that the EDID lists (as a detailed timing or a CTA
+	video code); all of them without an EDID.
+*/
+void
+MesonHdmi::_BuildModeList()
+{
+	fShared->mode_count = 0;
+	fShared->preferred_mode = 0;
+	for (size_t i = 0; i < B_COUNT_OF(kModes); i++) {
+		if (fEdidSize > 0 && !_EdidLists(kModes[i]))
+			continue;
+		uint32 index = fShared->mode_count++;
+		mode_to_display_mode(kModes[i], fShared->modes[index]);
+		if (kModes[i].vic == kPreferredVic
+			|| (kModes[i].hActive == fBootWidth
+				&& kModes[i].vActive == fBootHeight
+				&& kModes[fShared->preferred_mode].vic != kPreferredVic)) {
+			fShared->preferred_mode = index;
+		}
+		INFO("mode %ux%u, %" B_PRIu32 " kHz (VIC %u)\n", kModes[i].hActive,
+			kModes[i].vActive, kModes[i].pixelClock, kModes[i].vic);
+	}
+}
+
+
+static bool
+dtd_matches(const uint8* dtd, const meson_mode& mode)
+{
+	uint32 clock = dtd[0] | (dtd[1] << 8);		// 10 kHz units
+	uint32 hActive = dtd[2] | ((dtd[4] & 0xf0) << 4);
+	uint32 vActive = dtd[5] | ((dtd[7] & 0xf0) << 4);
+	return clock == mode.pixelClock / 10 && hActive == mode.hActive
+		&& vActive == mode.vActive;
+}
