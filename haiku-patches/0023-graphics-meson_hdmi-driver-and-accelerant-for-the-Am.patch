+
+bool
+MesonHdmi::_EdidLists(const meson_mode& mode)
+{
+	// detailed timings of the base block (descriptors with a zero clock
+	// are monitor descriptors)
+	for (uint32 offset = 54; offset <= 108; offset += 18) {
+		if (dtd_matches(fEdid + offset, mode))
+			return true;
+	}
+	if (fEdidSize < 256 || fEdid[128] != 0x02)
+		return false;
+
+	// CTA-861 extension: data blocks from byte 4, detailed timings from
+	// the offset in byte 2
+	const uint8* cta = fEdid + 128;
+	uint32 dtdOffset = cta[2];
+	if (dtdOffset < 4 || dtdOffset > 127)
+		return false;
+	for (uint32 i = 4; i < dtdOffset;) {
+		uint8 header = cta[i];
+		uint32 length = header & 0x1f;
+		if ((header >> 5) == 2) {	// video data block
+			for (uint32 j = 1; j <= length && i + j < dtdOffset; j++) {
+				uint8 vic = cta[i + j];
+				if (vic >= 129 && vic <= 192)
+					vic &= 0x7f;	// "native" flag
+				if (vic == mode.vic)
+					return true;
+			}
+		}
+		i += length + 1;
+	}
+	for (uint32 offset = dtdOffset; offset + 18 <= 127; offset += 18) {
+		if (cta[offset] == 0 && cta[offset + 1] == 0)
+			break;
+		if (dtd_matches(cta + offset, mode))
+			return true;
+	}
+	return false;
+}
+
+
+void
+MesonHdmi::_SaveBootState()
+{
+	fBootVpuCount = 0;
+	for (size_t i = 0; i < B_COUNT_OF(kSavedVpuWords); i++) {
+		fBootVpu[fBootVpuCount].word = kSavedVpuWords[i];
+		fBootVpu[fBootVpuCount].value = _Vpu(kSavedVpuWords[i]);
+		fBootVpuCount++;
+	}
+	fBootPllCntl2 = _Hhi(HHI_HDMI_PLL_CNTL2);
+	for (size_t i = 0; i < B_COUNT_OF(kSavedComposer); i++)
+		fBootComposer[i] = _DwRead(kSavedComposer[i]);
+	fBootStateSaved = true;
+}
+
+
+void
+MesonHdmi::_SetCanvas(phys_addr_t address, uint32 bytesPerRow, uint32 height)
+{
+	uint32 width = (bytesPerRow + 7) / 8;
+	fDmc[DMC_CAV_LUT_DATAL / 4] = ((address + 7) / 8) | (width << 29);
+	fDmc[DMC_CAV_LUT_DATAH / 4] = (width >> 3) | (height << 9);
+	fDmc[DMC_CAV_LUT_ADDR / 4] = CANVAS_LUT_WRITE | kOsdCanvas;
+	(void)fDmc[DMC_CAV_LUT_DATAH / 4];	// flush
+}
+
+
+void
+MesonHdmi::_ResetPhy()
+{
+	// PHY_CNTL1 bit 0 is the soft reset; three pulses, as at power-up
+	uint32 control = _Hhi(HHI_HDMI_PHY_CNTL1) & ~0xfu;
+	for (int32 i = 0; i < 3; i++) {
+		_SetHhi(HHI_HDMI_PHY_CNTL1, control | 0xf);
+		spin(2000);
+		_SetHhi(HHI_HDMI_PHY_CNTL1, control | 0xe);
+		spin(2000);
+	}
+}
+
+
+status_t
+MesonHdmi::_WaitForPllLock()
+{
+	for (int32 i = 0; i < 100; i++) {
+		if ((_Hhi(HHI_HDMI_PLL_CNTL) & HDMI_PLL_LOCK) != 0)
+			return B_OK;
+		spin(100);
+	}
+	return B_TIMED_OUT;
+}
+
+
+/*!	Blanks, programs a mode from kModes and shows \a frameBuffer in it. */
+status_t
+MesonHdmi::_ProgramMode(const meson_mode& mode, phys_addr_t frameBuffer,
+	uint32 bytesPerRow)
+{
+	encp_timing timing;
+	compute_encp(mode, timing);
+
+	_SetVpu(VIU_OSD1_CTRL_STAT, _Vpu(VIU_OSD1_CTRL_STAT) & ~OSD_ENABLE);
+	_SetVpu(ENCP_VIDEO_EN, 0);
+
+	uint32 od2 = mode.pixelClock == 148500 ? 0 : 1;
+	uint32 cntl2 = _Hhi(HHI_HDMI_PLL_CNTL2);
+	if ((cntl2 & HDMI_PLL_OD2_MASK) != (od2 << HDMI_PLL_OD2_SHIFT)) {
+		_SetHhi(HHI_HDMI_PLL_CNTL2, (cntl2 & ~HDMI_PLL_OD2_MASK)
+			| (od2 << HDMI_PLL_OD2_SHIFT));
+	}
+	if (_WaitForPllLock() != B_OK) {
+		INFO("HDMI PLL does not lock\n");
+		return B_ERROR;
+	}
+
+	_SetVpu(ENCP_VIDEO_MAX_PXCNT, timing.maxPixel);
+	_SetVpu(ENCP_VIDEO_MAX_LNCNT, timing.maxLine);
+	_SetVpu(ENCP_VIDEO_HAVON_BEGIN, timing.havonBegin);
+	_SetVpu(ENCP_VIDEO_HAVON_END, timing.havonEnd);
+	_SetVpu(ENCP_VIDEO_VAVON_BLINE, timing.vavonBegin);
+	_SetVpu(ENCP_VIDEO_VAVON_ELINE, timing.vavonEnd);
+	_SetVpu(ENCP_VIDEO_HSO_BEGIN, 0);
+	_SetVpu(ENCP_VIDEO_HSO_END, timing.hsoEnd);
+	_SetVpu(ENCP_VIDEO_VSO_BEGIN, 30);
+	_SetVpu(ENCP_VIDEO_VSO_END, 50);
+	_SetVpu(ENCP_VIDEO_VSO_BLINE, 0);
+	_SetVpu(ENCP_VIDEO_VSO_ELINE, timing.vsoEnd);
+	_SetVpu(ENCP_DE_H_BEGIN, timing.deHBegin);
+	_SetVpu(ENCP_DE_H_END, timing.deHEnd);
+	_SetVpu(ENCP_DE_V_BEGIN_EVEN, timing.deVBegin);
+	_SetVpu(ENCP_DE_V_END_EVEN, timing.deVEnd);
+	_SetVpu(ENCP_DVI_HSO_BEGIN, timing.dviHsoBegin);
+	_SetVpu(ENCP_DVI_HSO_END, timing.dviHsoEnd);
+	_SetVpu(ENCP_DVI_VSO_BLINE_EVN, timing.dviVsoBegin);
+	_SetVpu(ENCP_DVI_VSO_ELINE_EVN, timing.dviVsoEnd);
+	_SetVpu(ENCP_DVI_VSO_BEGIN_EVN, timing.dviHsoBegin);
+	_SetVpu(ENCP_DVI_VSO_END_EVN, timing.dviHsoBegin);
+
+	uint32 hBlank = mode.hFront + mode.hSync + mode.hBack;
+	uint32 vBlank = mode.vFront + mode.vSync + mode.vBack;
+	uint8 videoConfig = (_DwRead(DW_FC_INVIDCONF)
+			& ~(FC_INVIDCONF_VSYNC_HIGH | FC_INVIDCONF_HSYNC_HIGH))
+		| (mode.vSyncPositive ? FC_INVIDCONF_VSYNC_HIGH : 0)
+		| (mode.hSyncPositive ? FC_INVIDCONF_HSYNC_HIGH : 0);
+	_DwWrite(DW_FC_INVIDCONF, videoConfig);
+	_DwWrite(DW_FC_INHACTV0, mode.hActive & 0xff);
+	_DwWrite(DW_FC_INHACTV1, mode.hActive >> 8);
+	_DwWrite(DW_FC_INHBLANK0, hBlank & 0xff);
+	_DwWrite(DW_FC_INHBLANK1, hBlank >> 8);
+	_DwWrite(DW_FC_INVACTV0, mode.vActive & 0xff);
+	_DwWrite(DW_FC_INVACTV1, mode.vActive >> 8);
+	_DwWrite(DW_FC_INVBLANK, vBlank);
+	_DwWrite(DW_FC_HSYNCINDELAY0, mode.hFront & 0xff);
+	_DwWrite(DW_FC_HSYNCINDELAY1, mode.hFront >> 8);
+	_DwWrite(DW_FC_HSYNCINWIDTH0, mode.hSync & 0xff);
+	_DwWrite(DW_FC_HSYNCINWIDTH1, mode.hSync >> 8);
+	_DwWrite(DW_FC_VSYNCINDELAY, mode.vFront);
+	_DwWrite(DW_FC_VSYNCINWIDTH, mode.vSync);
+	// TMDS soft reset, then the video configuration again: some controller
+	// versions stall the frame composer after a reset otherwise
+	_DwWrite(DW_MC_SWRSTZ, (uint8)~MC_SWRSTZ_TMDS);
+	for (int32 i = 0; i < 4; i++)
+		_DwWrite(DW_FC_INVIDCONF, videoConfig);
+
+	_ResetPhy();
+	_SetVpu(ENCP_VIDEO_EN, 1);
+
+	_SetCanvas(frameBuffer, bytesPerRow, mode.vActive);
+	_SetVpu(VIU_OSD1_BLK0_CFG_W1, (uint32)(mode.hActive - 1) << 16);
+	_SetVpu(VIU_OSD1_BLK0_CFG_W2, (uint32)(mode.vActive - 1) << 16);
+	_SetVpu(VIU_OSD1_BLK0_CFG_W3, (uint32)(mode.hActive - 1) << 16);
+	_SetVpu(VIU_OSD1_BLK0_CFG_W4, (uint32)(mode.vActive - 1) << 16);
+	_SetVpu(VPP_POSTBLEND_H_SIZE, mode.hActive);
+	_SetVpu(VIU_OSD1_CTRL_STAT, _Vpu(VIU_OSD1_CTRL_STAT) | OSD_ENABLE);
+
+	if ((_TopRead(HDMITX_TOP_STAT0) & 1) == 0)
+		INFO("HPD low after the mode set\n");
+	return B_OK;
+}
+
+
+status_t
+MesonHdmi::SetDisplayMode(const display_mode& displayMode)
+{
+	const meson_mode* mode = NULL;
+	for (size_t i = 0; i < B_COUNT_OF(kModes); i++) {
+		if (display_mode_matches(displayMode, kModes[i])) {
+			mode = &kModes[i];
+			break;
+		}
+	}
+	if (mode == NULL || displayMode.space != B_RGB32)
+		return B_BAD_VALUE;
+
+	MutexLocker locker(fModeLock);
+	uint32 bytesPerRow = mode->hActive * 4;
+	memset(fFrameBuffer, 0, bytesPerRow * mode->vActive);
+	status_t status = _ProgramMode(*mode, fFrameBufferPhysical, bytesPerRow);
+	if (status != B_OK) {
+		RestoreBootMode();
+		return status;
+	}
+
+	mode_to_display_mode(*mode, fShared->current_mode);
+	fShared->bytes_per_row = bytesPerRow;
+	frame_buffer_update((addr_t)fFrameBuffer, mode->hActive, mode->vActive,
+		32, bytesPerRow);
+	INFO("mode %ux%u, %" B_PRIu32 " kHz\n", mode->hActive, mode->vActive,
+		mode->pixelClock);
+	return B_OK;
+}
+
+
+/*!	Puts U-Boot's registers and frame buffer back; works from KDL too. */
+void
+MesonHdmi::RestoreBootMode()
+{
+	if (!fBootStateSaved)
+		return;
+	_SetVpu(VIU_OSD1_CTRL_STAT, _Vpu(VIU_OSD1_CTRL_STAT) & ~OSD_ENABLE);
+	_SetVpu(ENCP_VIDEO_EN, 0);
+	_SetHhi(HHI_HDMI_PLL_CNTL2, fBootPllCntl2);
+	_WaitForPllLock();
+	for (uint32 i = 0; i < fBootVpuCount; i++) {
+		if (fBootVpu[i].word != VIU_OSD1_CTRL_STAT)
+			_SetVpu(fBootVpu[i].word, fBootVpu[i].value);
+	}
+	for (size_t i = 0; i < B_COUNT_OF(kSavedComposer); i++)
+		_DwWrite(kSavedComposer[i], fBootComposer[i]);
+	_DwWrite(DW_MC_SWRSTZ, (uint8)~MC_SWRSTZ_TMDS);
+	for (int32 i = 0; i < 4; i++)
+		_DwWrite(DW_FC_INVIDCONF, fBootComposer[0]);
+	_ResetPhy();
+	_SetVpu(ENCP_VIDEO_EN, 1);
+	_SetCanvas(fBootFrameBuffer, fBootBytesPerRow, fBootHeight);
+	_SetVpu(VIU_OSD1_CTRL_STAT, fBootVpu[0].value);
+}
+
+
+/*!	The ports take an address, then data. On GXBB the address has to be
+	written twice, and the data read twice (the first read returns stale
+	data). One spinlock covers both ports.
+*/
+uint32
+MesonHdmi::_TopRead(uint32 reg)
+{
+	InterruptsSpinLocker locker(fPortLock);
+	fHdmiTx[HDMITX_TOP_ADDR / 4] = reg;
+	fHdmiTx[HDMITX_TOP_ADDR / 4] = reg;
+	uint32 value = fHdmiTx[HDMITX_TOP_DATA / 4];
+	value = fHdmiTx[HDMITX_TOP_DATA / 4];
+	return value;
+}
+
+
+uint8
+MesonHdmi::_DwRead(uint32 reg)
+{
+	InterruptsSpinLocker locker(fPortLock);
+	fHdmiTx[HDMITX_DWC_ADDR / 4] = reg;
+	fHdmiTx[HDMITX_DWC_ADDR / 4] = reg;
+	uint32 value = fHdmiTx[HDMITX_DWC_DATA / 4];
+	value = fHdmiTx[HDMITX_DWC_DATA / 4];
+	return value & 0xff;
+}
+
+
+void
+MesonHdmi::_DwWrite(uint32 reg, uint8 value)
+{
+	InterruptsSpinLocker locker(fPortLock);
+	fHdmiTx[HDMITX_DWC_ADDR / 4] = reg;
+	fHdmiTx[HDMITX_DWC_ADDR / 4] = reg;
+	fHdmiTx[HDMITX_DWC_DATA / 4] = value;
+}
+
+
+/*!	One 128-byte EDID block over DDC, a byte per I2C operation; blocks 2
+	and up go through the E-DDC segment pointer.
+*/
+status_t
+MesonHdmi::_ReadEdidBlock(uint32 block, uint8* data)
+{
+	uint8 segment = block / 2;
+	for (uint32 i = 0; i < 128; i++) {
+		_DwWrite(DW_I2CM_SLAVE, 0x50);
+		_DwWrite(DW_I2CM_ADDRESS, (block % 2) * 128 + i);
+		_DwWrite(DW_IH_I2CM_STAT0, IH_I2CM_STAT0_ERROR | IH_I2CM_STAT0_DONE);
+		if (segment != 0) {
+			_DwWrite(DW_I2CM_SEGADDR, 0x30);
+			_DwWrite(DW_I2CM_SEGPTR, segment);
+			_DwWrite(DW_I2CM_OPERATION, I2CM_OPERATION_READ_EXT);
+		} else
+			_DwWrite(DW_I2CM_OPERATION, I2CM_OPERATION_READ);
+
+		bigtime_t deadline = system_time() + 10000;
+		uint8 status;
+		while (((status = _DwRead(DW_IH_I2CM_STAT0))
+				& (IH_I2CM_STAT0_ERROR | IH_I2CM_STAT0_DONE)) == 0) {
+			if (system_time() > deadline)
+				return B_TIMED_OUT;
+			spin(20);
+		}
+		_DwWrite(DW_IH_I2CM_STAT0, IH_I2CM_STAT0_ERROR | IH_I2CM_STAT0_DONE);
+		if ((status & IH_I2CM_STAT0_ERROR) != 0)
+			return B_IO_ERROR;
+		data[i] = _DwRead(DW_I2CM_DATAI);
+	}
+
+	uint8 sum = 0;
+	for (uint32 i = 0; i < 128; i++)
+		sum += data[i];
+	return sum == 0 ? B_OK : B_BAD_DATA;
+}
+
+
+/*!	The capture dongle serves a half-initialized EDID right after power-up:
+	accept it only when two reads agree.
+*/
+status_t
+MesonHdmi::_ReadEdid()
+{
+	uint8 first[256];
+	uint8 second[256];
+	status_t status = B_ERROR;
+	for (int32 attempt = 0; attempt < 5; attempt++) {
+		if (attempt > 0)
+			snooze(500000);
+		status = _ReadEdidBlock(0, first);
+		if (status == B_OK)
+			status = _ReadEdidBlock(0, second);
+		if (status != B_OK || memcmp(first, second, 128) != 0) {
+			INFO("EDID read %" B_PRId32 ": %s\n", attempt,
+				status != B_OK ? strerror(status) : "two reads differ");
+			continue;
+		}
+		break;
+	}
+	if (status != B_OK)
+		return status;
+
+	fEdidSize = 128;
+	memcpy(fEdid, first, 128);
+	if (first[126] > 0 && _ReadEdidBlock(1, fEdid + 128) == B_OK)
+		fEdidSize = 256;
+
+	INFO("EDID: %" B_PRIu32 " bytes, %u extension(s)\n", fEdidSize, first[126]);
+	for (uint32 offset = 0; offset < fEdidSize; offset += 32) {
+		char line[32 * 2 + 1];
+		for (uint32 i = 0; i < 32; i++)
+			snprintf(line + i * 2, 3, "%02x", fEdid[offset + i]);
+		INFO("EDID %03" B_PRIx32 ": %s\n", offset, line);
+	}
+	return B_OK;
+}
+
+
+/*!	Compares what U-Boot left in the registers with the values computed for
+	its mode, so the register model can be trusted before anything is
+	written.
+*/
+void
+MesonHdmi::_CheckBootMode()
+{
+	const meson_mode* mode = NULL;
+	for (size_t i = 0; i < B_COUNT_OF(kModes); i++) {
+		if (kModes[i].hActive == fBootWidth && kModes[i].vActive == fBootHeight
+			&& kModes[i].pixelClock == 74250) {
+			mode = &kModes[i];
+			break;
+		}
+	}
+	if (mode == NULL) {
+		INFO("boot mode not in the table, nothing to compare\n");
+		return;
+	}
+
+	encp_timing timing;
+	compute_encp(*mode, timing);
+	struct {
+		const char*	name;
+		uint32		word;
+		uint32		expected;
+	} checks[] = {
+		{ "MAX_PXCNT", ENCP_VIDEO_MAX_PXCNT, timing.maxPixel },
+		{ "MAX_LNCNT", ENCP_VIDEO_MAX_LNCNT, timing.maxLine },
+		{ "HAVON_BEGIN", ENCP_VIDEO_HAVON_BEGIN, timing.havonBegin },
+		{ "HAVON_END", ENCP_VIDEO_HAVON_END, timing.havonEnd },
+		{ "VAVON_BLINE", ENCP_VIDEO_VAVON_BLINE, timing.vavonBegin },
+		{ "VAVON_ELINE", ENCP_VIDEO_VAVON_ELINE, timing.vavonEnd },
+		{ "HSO_END", ENCP_VIDEO_HSO_END, timing.hsoEnd },
+		{ "VSO_ELINE", ENCP_VIDEO_VSO_ELINE, timing.vsoEnd },
+		{ "DE_H_BEGIN", ENCP_DE_H_BEGIN, timing.deHBegin },
+		{ "DE_H_END", ENCP_DE_H_END, timing.deHEnd },
+		{ "DE_V_BEGIN", ENCP_DE_V_BEGIN_EVEN, timing.deVBegin },
+		{ "DE_V_END", ENCP_DE_V_END_EVEN, timing.deVEnd },
+		{ "DVI_HSO_BEGIN", ENCP_DVI_HSO_BEGIN, timing.dviHsoBegin },
+		{ "DVI_HSO_END", ENCP_DVI_HSO_END, timing.dviHsoEnd },
+		{ "DVI_VSO_BLINE", ENCP_DVI_VSO_BLINE_EVN, timing.dviVsoBegin },
+		{ "DVI_VSO_ELINE", ENCP_DVI_VSO_ELINE_EVN, timing.dviVsoEnd },
+	};
+	int32 mismatches = 0;
+	for (size_t i = 0; i < B_COUNT_OF(checks); i++) {
+		uint32 live = _Vpu(checks[i].word);
+		if (live != checks[i].expected) {
+			INFO("ENCP %s: live %" B_PRIu32 ", computed %" B_PRIu32 "\n",
+				checks[i].name, live, checks[i].expected);
+			mismatches++;
+		}
+	}
+
+	uint32 hBlank = mode->hFront + mode->hSync + mode->hBack;
+	uint32 vBlank = mode->vFront + mode->vSync + mode->vBack;
+	struct {
+		const char*	name;
+		uint32		live;
+		uint32		expected;
+	} composer[] = {
+		{ "INHACTV", _DwRead16(DW_FC_INHACTV0), mode->hActive },
+		{ "INHBLANK", _DwRead16(DW_FC_INHBLANK0), hBlank },
+		{ "INVACTV", _DwRead16(DW_FC_INVACTV0), mode->vActive },
+		{ "INVBLANK", _DwRead(DW_FC_INVBLANK), vBlank },
+		{ "HSYNCINDELAY", _DwRead16(DW_FC_HSYNCINDELAY0), mode->hFront },
+		{ "HSYNCINWIDTH", _DwRead16(DW_FC_HSYNCINWIDTH0), mode->hSync },
+		{ "VSYNCINDELAY", _DwRead(DW_FC_VSYNCINDELAY), mode->vFront },
+		{ "VSYNCINWIDTH", _DwRead(DW_FC_VSYNCINWIDTH), mode->vSync },
+	};
+	for (size_t i = 0; i < B_COUNT_OF(composer); i++) {
+		if (composer[i].live != composer[i].expected) {
+			INFO("FC %s: live %" B_PRIu32 ", computed %" B_PRIu32 "\n",
+				composer[i].name, composer[i].live, composer[i].expected);
+			mismatches++;
+		}
+	}
+	INFO("boot mode %ux%u: %" B_PRId32 " register(s) differ from the "
+		"computed values\n", mode->hActive, mode->vActive, mismatches);
+}
+
+
+void
+MesonHdmi::DumpState()
+{
+	kprintf("meson_hdmi: boot mode %" B_PRIu32 "x%" B_PRIu32 ", frame buffer %#"
+		B_PRIxPHYSADDR "\n", fBootWidth, fBootHeight, fBootFrameBuffer);
+	kprintf("  HPD %" B_PRIu32 ", FC_INVIDCONF %#x\n",
+		_TopRead(HDMITX_TOP_STAT0) & 1, _DwRead(DW_FC_INVIDCONF));
+	kprintf("  HDMI PLL %#" B_PRIx32 " %#" B_PRIx32 ", VID_PLL_DIV %#" B_PRIx32
+		", VID_CLK_DIV %#" B_PRIx32 ", VID_CLK_CNTL %#" B_PRIx32 "/%#" B_PRIx32
+		", HDMI_CLK %#" B_PRIx32 "\n", _Hhi(HHI_HDMI_PLL_CNTL),
+		_Hhi(HHI_HDMI_PLL_CNTL2), _Hhi(HHI_VID_PLL_CLK_DIV),
+		_Hhi(HHI_VID_CLK_DIV), _Hhi(HHI_VID_CLK_CNTL), _Hhi(HHI_VID_CLK_CNTL2),
+		_Hhi(HHI_HDMI_CLK_CNTL));
+	kprintf("  PHY %#" B_PRIx32 " %#" B_PRIx32 " %#" B_PRIx32 "\n",
+		_Hhi(HHI_HDMI_PHY_CNTL0), _Hhi(HHI_HDMI_PHY_CNTL1),
+		_Hhi(HHI_HDMI_PHY_CNTL3));
+	kprintf("  OSD1 ctrl %#" B_PRIx32 "/%#" B_PRIx32 ", W0 %#" B_PRIx32 ", W1 %#"
+		B_PRIx32 ", W2 %#" B_PRIx32 ", W3 %#" B_PRIx32 ", W4 %#" B_PRIx32 "\n",
+		_Vpu(VIU_OSD1_CTRL_STAT), _Vpu(VIU_OSD1_CTRL_STAT2),
+		_Vpu(VIU_OSD1_BLK0_CFG_W0), _Vpu(VIU_OSD1_BLK0_CFG_W1),
+		_Vpu(VIU_OSD1_BLK0_CFG_W2), _Vpu(VIU_OSD1_BLK0_CFG_W3),
+		_Vpu(VIU_OSD1_BLK0_CFG_W4));
+	kprintf("  VPP postblend %" B_PRIu32 ", misc %#" B_PRIx32 ", scaler %#"
+		B_PRIx32 "/%#" B_PRIx32 "/%#" B_PRIx32 "\n",
+		_Vpu(VPP_POSTBLEND_H_SIZE), _Vpu(VPP_MISC), _Vpu(VPP_OSD_SC_CTRL0),
+		_Vpu(VPP_OSD_VSC_CTRL0), _Vpu(VPP_OSD_HSC_CTRL0));
+	kprintf("  ENCP en %" B_PRIu32 ", mode %#" B_PRIx32 "/%#" B_PRIx32
+		", DVI setting %#" B_PRIx32 ", HDMI setting %#" B_PRIx32 ", mux %#"
+		B_PRIx32 "\n", _Vpu(ENCP_VIDEO_EN), _Vpu(ENCP_VIDEO_MODE),
+		_Vpu(ENCP_VIDEO_MODE_ADV), _Vpu(VENC_DVI_SETTING),
+		_Vpu(VPU_HDMI_SETTING), _Vpu(VPU_VIU_VENC_MUX_CTRL));
+	kprintf("  ENCP px %" B_PRIu32 " ln %" B_PRIu32 ", havon %" B_PRIu32 "-%"
+		B_PRIu32 ", vavon %" B_PRIu32 "-%" B_PRIu32 ", hso %" B_PRIu32 "-%"
+		B_PRIu32 ", vso %" B_PRIu32 "-%" B_PRIu32 " lines %" B_PRIu32 "-%"
+		B_PRIu32 "\n", _Vpu(ENCP_VIDEO_MAX_PXCNT), _Vpu(ENCP_VIDEO_MAX_LNCNT),
+		_Vpu(ENCP_VIDEO_HAVON_BEGIN), _Vpu(ENCP_VIDEO_HAVON_END),
+		_Vpu(ENCP_VIDEO_VAVON_BLINE), _Vpu(ENCP_VIDEO_VAVON_ELINE),
+		_Vpu(ENCP_VIDEO_HSO_BEGIN), _Vpu(ENCP_VIDEO_HSO_END),
+		_Vpu(ENCP_VIDEO_VSO_BEGIN), _Vpu(ENCP_VIDEO_VSO_END),
+		_Vpu(ENCP_VIDEO_VSO_BLINE), _Vpu(ENCP_VIDEO_VSO_ELINE));
+	kprintf("  DE h %" B_PRIu32 "-%" B_PRIu32 " v %" B_PRIu32 "-%" B_PRIu32
+		", DVI hso %" B_PRIu32 "-%" B_PRIu32 " vso lines %" B_PRIu32 "-%"
+		B_PRIu32 " begin/end %" B_PRIu32 "/%" B_PRIu32 "\n",
+		_Vpu(ENCP_DE_H_BEGIN), _Vpu(ENCP_DE_H_END), _Vpu(ENCP_DE_V_BEGIN_EVEN),
+		_Vpu(ENCP_DE_V_END_EVEN), _Vpu(ENCP_DVI_HSO_BEGIN),
+		_Vpu(ENCP_DVI_HSO_END), _Vpu(ENCP_DVI_VSO_BLINE_EVN),
+		_Vpu(ENCP_DVI_VSO_ELINE_EVN), _Vpu(ENCP_DVI_VSO_BEGIN_EVN),
+		_Vpu(ENCP_DVI_VSO_END_EVN));
+}
