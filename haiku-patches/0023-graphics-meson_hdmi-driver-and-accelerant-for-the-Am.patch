diff --git a/src/add-ons/kernel/drivers/graphics/meson_hdmi/meson_hdmi.cpp b/src/add-ons/kernel/drivers/graphics/meson_hdmi/meson_hdmi.cpp
new file mode 100644
index 0000000000..613ba69d91
--- /dev/null
+++ b/src/add-ons/kernel/drivers/graphics/meson_hdmi/meson_hdmi.cpp
@@ -0,0 +1,1360 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+/*!	HDMI display on the Amlogic Meson GXBB (S905, ODROID-C2).
+
+	U-Boot's video driver leaves the whole pipeline running (power domain,
+	clocks, resets, pin mux, the HDMI controller and PHY setup), and it
+	survives ExitBootServices. This driver therefore only changes what
+	depends on the mode: the frame buffer canvas, the OSD1 window, the ENCP
+	timing generator, the HDMI PLL post-divider and the DesignWare frame
+	composer. It never resets or powers down these blocks.
+
+	At attach it logs the controller IDs and how U-Boot's live registers
+	compare with the values computed for its mode, reads the EDID over the
+	controller's DDC master, and saves every register it may write, so the
+	boot mode can be restored (on a failed mode set, or with the KDL command
+	"meson_hdmi restore"). Modes: 1280x720@60, 1920x1080@30 and @60, as far
+	as the EDID lists them; all three run from U-Boot's PLL setting with
+	only the OD2 post-divider changed. "mode_setting off" in the driver
+	settings (~/config/settings/kernel/drivers/meson_hdmi) keeps the device
+	unpublished, so app_server stays on the "framebuffer" driver.
+
+	Sources: the S905 and S905X datasheets (VPU, ENCP, HHI, HDMI TX top),
+	NetBSD's dw_hdmi (BSD-2) for the DesignWare controller, and register
+	facts listed in docs/m6-hdmi-design.md of the port's project folder.
+*/
+
+
+#include <new>
+#include <stdio.h>
+#include <string.h>
+
+#include <KernelExport.h>
+#include <boot_item.h>
+#include <debug.h>
+#include <device_manager.h>
+#include <driver_settings.h>
+#include <drivers/bus/FDT.h>
+#include <frame_buffer_console.h>
+#include <graphic_driver.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+#include <vm/vm.h>
+#include <arch/arm64/arch_kernel.h>
+
+#include "meson_hdmi_info.h"
+
+
+#define DRIVER_MODULE_NAME	"drivers/graphics/meson_hdmi/driver_v1"
+#define DEVICE_MODULE_NAME	"drivers/graphics/meson_hdmi/device_v1"
+
+#define INFO(x...)			dprintf("meson_hdmi: " x)
+
+
+// GXBB addresses (meson-gx.dtsi; this driver only matches GXBB)
+static const phys_addr_t kVpuBase = 0xd0100000;
+static const size_t kVpuSize = 0x10000;		// registers used: words < 0x2800
+static const phys_addr_t kHhiBase = 0xc883c000;
+static const phys_addr_t kHdmiTxBase = 0xc883a000;
+static const phys_addr_t kDmcBase = 0xc8838000;
+
+static const uint32 kMaxWidth = 1920;
+static const uint32 kMaxHeight = 1080;
+static const uint32 kOsdCanvas = 0x4e;		// U-Boot's OSD1 canvas
+
+// VPU registers (word numbers; byte offset = word * 4)
+enum {
+	VIU_OSD1_CTRL_STAT			= 0x1a10,
+	VIU_OSD1_BLK0_CFG_W4		= 0x1a13,
+	VIU_OSD1_BLK0_CFG_W0		= 0x1a1b,
+	VIU_OSD1_BLK0_CFG_W1		= 0x1a1c,
+	VIU_OSD1_BLK0_CFG_W2		= 0x1a1d,
+	VIU_OSD1_BLK0_CFG_W3		= 0x1a1e,
+	VIU_OSD1_CTRL_STAT2			= 0x1a2d,
+	VENC_DVI_SETTING			= 0x1b62,
+	ENCP_VIDEO_EN				= 0x1b80,
+	ENCP_VIDEO_MODE				= 0x1b8d,
+	ENCP_VIDEO_MODE_ADV			= 0x1b8e,
+	ENCP_VIDEO_MAX_PXCNT		= 0x1b97,
+	ENCP_VIDEO_HAVON_END		= 0x1ba3,
+	ENCP_VIDEO_HAVON_BEGIN		= 0x1ba4,
+	ENCP_VIDEO_VAVON_BLINE		= 0x1ba6,
+	ENCP_VIDEO_HSO_BEGIN		= 0x1ba7,
+	ENCP_VIDEO_HSO_END			= 0x1ba8,
+	ENCP_VIDEO_VSO_BEGIN		= 0x1ba9,
+	ENCP_VIDEO_VSO_END			= 0x1baa,
+	ENCP_VIDEO_VSO_BLINE		= 0x1bab,
+	ENCP_VIDEO_VSO_ELINE		= 0x1bac,
+	ENCP_VIDEO_MAX_LNCNT		= 0x1bae,
+	ENCP_VIDEO_VAVON_ELINE		= 0x1baf,
+	ENCP_DVI_HSO_BEGIN			= 0x1c30,
+	ENCP_DVI_HSO_END			= 0x1c31,
+	ENCP_DVI_VSO_BLINE_EVN		= 0x1c32,
+	ENCP_DVI_VSO_ELINE_EVN		= 0x1c34,
+	ENCP_DVI_VSO_BEGIN_EVN		= 0x1c36,
+	ENCP_DVI_VSO_END_EVN		= 0x1c38,
+	ENCP_DE_H_BEGIN				= 0x1c3a,
+	ENCP_DE_H_END				= 0x1c3b,
+	ENCP_DE_V_BEGIN_EVEN		= 0x1c3c,
+	ENCP_DE_V_END_EVEN			= 0x1c3d,
+	VPP_POSTBLEND_H_SIZE		= 0x1d21,
+	VPP_MISC					= 0x1d26,
+	VPP_OSD_VSC_CTRL0			= 0x1dc2,
+	VPP_OSD_HSC_CTRL0			= 0x1dc5,
+	VPP_OSD_SC_CTRL0			= 0x1dc8,
+	VPU_VIU_VENC_MUX_CTRL		= 0x271a,
+	VPU_HDMI_SETTING			= 0x271b,
+};
+
+#define OSD_ENABLE					(1 << 21)	// VIU_OSD1_CTRL_STAT
+
+// HHI registers (byte offsets)
+enum {
+	HHI_VID_CLK_DIV				= 0x164,
+	HHI_VID_CLK_CNTL			= 0x17c,
+	HHI_VID_CLK_CNTL2			= 0x194,
+	HHI_VID_PLL_CLK_DIV			= 0x1a0,
+	HHI_HDMI_CLK_CNTL			= 0x1cc,
+	HHI_HDMI_PLL_CNTL			= 0x320,
+	HHI_HDMI_PLL_CNTL2			= 0x324,
+	HHI_HDMI_PHY_CNTL0			= 0x3a0,
+	HHI_HDMI_PHY_CNTL1			= 0x3a4,
+	HHI_HDMI_PHY_CNTL3			= 0x3ac,
+};
+
+#define HDMI_PLL_LOCK				(1u << 31)	// HHI_HDMI_PLL_CNTL
+#define HDMI_PLL_OD2_SHIFT			22			// HHI_HDMI_PLL_CNTL2
+#define HDMI_PLL_OD2_MASK			(3 << HDMI_PLL_OD2_SHIFT)
+
+// DMC canvas lookup table (byte offsets)
+enum {
+	DMC_CAV_LUT_DATAL			= 0x48,
+	DMC_CAV_LUT_DATAH			= 0x4c,
+	DMC_CAV_LUT_ADDR			= 0x50,
+};
+
+#define CANVAS_LUT_WRITE			(1 << 9)
+
+// HDMI TX: indirect ports to the Amlogic "top" glue and the DesignWare core
+enum {
+	HDMITX_TOP_ADDR				= 0x00,
+	HDMITX_TOP_DATA				= 0x04,
+	HDMITX_DWC_ADDR				= 0x10,
+	HDMITX_DWC_DATA				= 0x14,
+
+	HDMITX_TOP_STAT0			= 0x0e,	// bit 0: filtered HPD
+};
+
+// DesignWare HDMI TX registers (8 bits wide through the port)
+enum {
+	DW_DESIGN_ID				= 0x0000,
+	DW_REVISION_ID				= 0x0001,
+	DW_PRODUCT_ID0				= 0x0002,
+	DW_PRODUCT_ID1				= 0x0003,
+	DW_IH_I2CM_STAT0			= 0x0105,
+	DW_FC_INVIDCONF				= 0x1000,
+	DW_FC_INHACTV0				= 0x1001,
+	DW_FC_INHACTV1				= 0x1002,
+	DW_FC_INHBLANK0				= 0x1003,
+	DW_FC_INHBLANK1				= 0x1004,
+	DW_FC_INVACTV0				= 0x1005,
+	DW_FC_INVACTV1				= 0x1006,
+	DW_FC_INVBLANK				= 0x1007,
+	DW_FC_HSYNCINDELAY0			= 0x1008,
+	DW_FC_HSYNCINDELAY1			= 0x1009,
+	DW_FC_HSYNCINWIDTH0			= 0x100a,
+	DW_FC_HSYNCINWIDTH1			= 0x100b,
+	DW_FC_VSYNCINDELAY			= 0x100c,
+	DW_FC_VSYNCINWIDTH			= 0x100d,
+	DW_MC_SWRSTZ				= 0x4002,
+	DW_I2CM_SLAVE				= 0x7e00,
+	DW_I2CM_ADDRESS				= 0x7e01,
+	DW_I2CM_DATAI				= 0x7e03,
+	DW_I2CM_OPERATION			= 0x7e04,
+	DW_I2CM_SEGADDR				= 0x7e08,
+	DW_I2CM_SEGPTR				= 0x7e0a,
+};
+
+#define I2CM_OPERATION_READ			(1 << 0)
+#define I2CM_OPERATION_READ_EXT		(1 << 1)
+#define IH_I2CM_STAT0_ERROR			(1 << 0)
+#define IH_I2CM_STAT0_DONE			(1 << 1)
+#define FC_INVIDCONF_VSYNC_HIGH		(1 << 6)
+#define FC_INVIDCONF_HSYNC_HIGH		(1 << 5)
+#define MC_SWRSTZ_TMDS				(1 << 1)	// active low
+
+
+/*!	A mode as CEA-861 describes it; the register values follow from it. */
+struct meson_mode {
+	uint32	pixelClock;		// kHz
+	uint16	hActive, hFront, hSync, hBack;
+	uint16	vActive, vFront, vSync, vBack;
+	bool	hSyncPositive, vSyncPositive;
+	uint8	vic;			// CEA-861 video identification code
+};
+
+// U-Boot's HDMI PLL runs the VCO at 5940 MHz: OD2 /2 gives a 74.25 MHz
+// pixel clock, /1 148.5 MHz. These modes need nothing else from the clock
+// tree.
+static const meson_mode kModes[] = {
+	{ 74250, 1280, 110, 40, 220, 720, 5, 5, 20, true, true, 4 },
+	{ 74250, 1920, 88, 44, 148, 1080, 4, 5, 36, true, true, 34 },
+	{ 148500, 1920, 88, 44, 148, 1080, 4, 5, 36, true, true, 16 },
+};
+static const uint8 kPreferredVic = 16;
+
+
+static void
+mode_to_display_mode(const meson_mode& mode, display_mode& displayMode)
+{
+	memset(&displayMode, 0, sizeof(displayMode));
+	display_timing& timing = displayMode.timing;
+	timing.pixel_clock = mode.pixelClock;
+	timing.h_display = mode.hActive;
+	timing.h_sync_start = mode.hActive + mode.hFront;
+	timing.h_sync_end = timing.h_sync_start + mode.hSync;
+	timing.h_total = timing.h_sync_end + mode.hBack;
+	timing.v_display = mode.vActive;
+	timing.v_sync_start = mode.vActive + mode.vFront;
+	timing.v_sync_end = timing.v_sync_start + mode.vSync;
+	timing.v_total = timing.v_sync_end + mode.vBack;
+	timing.flags = (mode.hSyncPositive ? B_POSITIVE_HSYNC : 0)
+		| (mode.vSyncPositive ? B_POSITIVE_VSYNC : 0);
+	displayMode.space = B_RGB32;
+	displayMode.virtual_width = mode.hActive;
+	displayMode.virtual_height = mode.vActive;
+	displayMode.flags = B_8_BIT_DAC;
+}
+
+
+static bool
+display_mode_matches(const display_mode& displayMode, const meson_mode& mode)
+{
+	const display_timing& timing = displayMode.timing;
+	return timing.h_display == mode.hActive
+		&& timing.v_display == mode.vActive
+		&& timing.h_total == mode.hActive + mode.hFront + mode.hSync
+			+ mode.hBack
+		&& timing.v_total == mode.vActive + mode.vFront + mode.vSync
+			+ mode.vBack
+		&& timing.pixel_clock >= mode.pixelClock - 100
+		&& timing.pixel_clock <= mode.pixelClock + 100;
+}
+
+
+struct encp_timing {
+	uint32	maxPixel, maxLine;
+	uint32	havonBegin, havonEnd, vavonBegin, vavonEnd;
+	uint32	hsoEnd, vsoEnd;
+	uint32	deHBegin, deHEnd, deVBegin, deVEnd;
+	uint32	dviHsoBegin, dviHsoEnd, dviVsoBegin, dviVsoEnd;
+};
+
+
+/*!	The ENCP timing generator for a progressive mode. The DE window starts
+	two pixels after the active video (encoder latency); the HDMI syncs
+	follow DE by the front porch.
+*/
+static void
+compute_encp(const meson_mode& mode, encp_timing& timing)
+{
+	uint32 hTotal = mode.hActive + mode.hFront + mode.hSync + mode.hBack;
+	uint32 vTotal = mode.vActive + mode.vFront + mode.vSync + mode.vBack;
+	timing.maxPixel = hTotal - 1;
+	timing.maxLine = vTotal - 1;
+	timing.havonBegin = mode.hSync + mode.hBack;
+	timing.havonEnd = timing.havonBegin + mode.hActive - 1;
+	timing.vavonBegin = mode.vSync + mode.vBack;
+	timing.vavonEnd = timing.vavonBegin + mode.vActive - 1;
+	timing.hsoEnd = mode.hSync;
+	timing.vsoEnd = mode.vSync;
+	timing.deHBegin = timing.havonBegin + 2;
+	timing.deHEnd = timing.deHBegin + mode.hActive;
+	timing.deVBegin = timing.vavonBegin;
+	timing.deVEnd = timing.deVBegin + mode.vActive;
+	timing.dviHsoBegin = (timing.deHEnd + mode.hFront) % hTotal;
+	timing.dviHsoEnd = (timing.dviHsoBegin + mode.hSync) % hTotal;
+	timing.dviVsoBegin = (timing.deVEnd + mode.vFront) % vTotal;
+	timing.dviVsoEnd = timing.dviVsoBegin + mode.vSync;
+}
