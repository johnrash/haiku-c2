+++ b/src/add-ons/media/media-add-ons/multi_audio/MultiAudioAddOn.h
@@ -6,6 +6,7 @@
 #define MULTI_AUDIO_ADDON_H
 
 
+#include <Locker.h>
 #include <MediaDefs.h>
 #include <MediaAddOn.h>
 #include <Message.h>
@@ -30,14 +31,21 @@ public:
 							int32* _internalID, bool* _hasMore);
 
 private:
+			class DeviceWatcher;
+
 			status_t	_RecursiveScan(const char* path, BEntry* rootEntry = NULL,
 							uint32 depth = 0);
+			bool		_HasDevice(const char* path) const;
+			void		_DevicesChanged();
 			void		_SaveSettings();
 			void		_LoadSettings();
 
 private:
 	status_t 		fInitStatus;
+	BLocker			fLock;
 	BList			fDevices;
+		// only added to, so that a flavor's index stays its device's
+	DeviceWatcher*	fWatcher;
 
 	BMessage		fSettings;
 		// loaded from settings directory
diff --git a/src/add-ons/media/media-add-ons/multi_audio/MultiAudioDevice.h b/src/add-ons/media/media-add-ons/multi_audio/MultiAudioDevice.h
index bde5537607..f00c233242 100644
--- a/src/add-ons/media/media-add-ons/multi_audio/MultiAudioDevice.h
+++ b/src/add-ons/media/media-add-ons/multi_audio/MultiAudioDevice.h
@@ -20,6 +20,7 @@ public:
 						~MultiAudioDevice();
 
 	status_t			InitCheck() const;
+	const char*			Path() const { return fPath; }
 
 	const multi_description& Description() const { return fDescription; }
 	const multi_format_info& FormatInfo() const { return fFormatInfo; }
