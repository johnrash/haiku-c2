From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Fri, 30 Oct 2026 18:09:08 -0400
Subject: [PATCH 129/342] media: decoder priorities; the next decoder when one
 can't set up

A decoder add-on may export int32 media_decoder_priority: higher ones come
first among a directory's decoders for a format (hardware decoders before
FFmpeg). MediaExtractor::CreateDecoder() tries the decoders for the format
in turn until one's Setup() succeeds (the TODO there), each with the format
as the reader gave it: a hardware decoder that is in use leaves the stream
to the next one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 headers/private/media/PluginManager.h |  3 +-
 src/kits/media/AddOnManager.cpp       | 51 +++++++++++++++++-----
 src/kits/media/AddOnManager.h         |  8 ++--
 src/kits/media/MediaExtractor.cpp     | 62 +++++++++++++++------------
 src/kits/media/PluginManager.cpp      | 11 +++--
 5 files changed, 89 insertions(+), 46 deletions(-)

diff --git a/headers/private/media/PluginManager.h b/headers/private/media/PluginManager.h
index 7b863b7928..bba987568e 100644
--- a/headers/private/media/PluginManager.h
+++ b/headers/private/media/PluginManager.h
@@ -38,7 +38,8 @@ public:
 			void				DestroyReader(Reader* reader);
 
 			status_t			CreateDecoder(Decoder** decoder,
-									const media_format& format);
+									const media_format& format,
+									int32 index = 0);
 			status_t			CreateDecoder(Decoder** decoder,
 									const media_codec_info& mci);
 			status_t			GetDecoderInfo(Decoder* decoder,
diff --git a/src/kits/media/AddOnManager.cpp b/src/kits/media/AddOnManager.cpp
index 8ef6228005..89cd309858 100644
--- a/src/kits/media/AddOnManager.cpp
+++ b/src/kits/media/AddOnManager.cpp
@@ -14,6 +14,9 @@
 #include <stdio.h>
 #include <string.h>
 
+#include <algorithm>
+#include <vector>
+
 #include <Architecture.h>
 #include <AutoDeleter.h>
 #include <Autolock.h>
@@ -86,9 +89,13 @@ AddOnManager::GetInstance()
 }
 
 
+/*!	The decoder for \a format, or with \a index > 0, the next ones: for a
+	caller whose first choice can't decode the stream after all (a hardware
+	decoder that is in use, for one).
+*/
 status_t
 AddOnManager::GetDecoderForFormat(entry_ref* _decoderRef,
-	const media_format& format)
+	const media_format& format, int32 index)
 {
 	if ((format.type == B_MEDIA_ENCODED_VIDEO
 			|| format.type == B_MEDIA_ENCODED_AUDIO
@@ -122,7 +129,7 @@ AddOnManager::GetDecoderForFormat(entry_ref* _decoderRef,
 	BPath path;
 	for (uint i = 0; i < directoryCount; i++) {
 		path.SetTo(directories[i]);
-		if (_FindDecoder(format, path, _decoderRef))
+		if (_FindDecoder(format, path, _decoderRef, index))
 			return B_OK;
 	}
 
@@ -366,8 +373,16 @@ AddOnManager::_RegisterAddOn(const entry_ref& ref)
 		_RegisterReader(reader, ref);
 
 	DecoderPlugin* decoder = dynamic_cast<DecoderPlugin*>(plugin);
-	if (decoder != NULL)
-		_RegisterDecoder(decoder, ref);
+	if (decoder != NULL) {
+		// Optional: decoders with a higher priority are tried first, those
+		// of hardware before those of software.
+		int32* priority;
+		if (get_image_symbol(loader.Image(), "media_decoder_priority",
+				B_SYMBOL_TYPE_DATA, (void**)&priority) != B_OK) {
+			priority = NULL;
+		}
+		_RegisterDecoder(decoder, ref, priority != NULL ? *priority : 0);
+	}
 
 	WriterPlugin* writer = dynamic_cast<WriterPlugin*>(plugin);
 	if (writer != NULL)
@@ -464,7 +479,8 @@ AddOnManager::_RegisterReader(ReaderPlugin* reader, const entry_ref& ref)
 
 
 void
-AddOnManager::_RegisterDecoder(DecoderPlugin* plugin, const entry_ref& ref)
+AddOnManager::_RegisterDecoder(DecoderPlugin* plugin, const entry_ref& ref,
+	int32 priority)
 {
 	BAutolock locker(fLock);
 
@@ -478,6 +494,7 @@ AddOnManager::_RegisterDecoder(DecoderPlugin* plugin, const entry_ref& ref)
 
 	decoder_info info;
 	info.ref = ref;
+	info.priority = priority;
 
 	media_format* formats = 0;
 	size_t count = 0;
@@ -597,7 +614,7 @@ AddOnManager::_RegisterStreamer(StreamerPlugin* streamer, const entry_ref& ref)
 
 bool
 AddOnManager::_FindDecoder(const media_format& format, const BPath& path,
-	entry_ref* _decoderRef)
+	entry_ref* _decoderRef, int32& index)
 {
 	node_ref nref;
 	BDirectory directory;
@@ -606,6 +623,9 @@ AddOnManager::_FindDecoder(const media_format& format, const BPath& path,
 		return false;
 	}
 
+	// the matching decoders of this directory: highest priority first, in
+	// the order they were found otherwise
+	std::vector<decoder_info*> matching;
 	decoder_info* info;
 	for (fDecoderList.Rewind(); fDecoderList.GetNext(&info);) {
 		if (info->ref.directory != nref.node)
@@ -614,13 +634,22 @@ AddOnManager::_FindDecoder(const media_format& format, const BPath& path,
 		media_format* decoderFormat;
 		for (info->formats.Rewind(); info->formats.GetNext(&decoderFormat);) {
 			// check if the decoder matches the supplied format
-			if (!decoderFormat->Matches(&format))
-				continue;
-
-			*_decoderRef = info->ref;
-			return true;
+			if (decoderFormat->Matches(&format)) {
+				matching.push_back(info);
+				break;
+			}
 		}
 	}
+	std::stable_sort(matching.begin(), matching.end(),
+		[](const decoder_info* a, const decoder_info* b) {
+			return a->priority > b->priority;
+		});
+
+	if (index < (int32)matching.size()) {
+		*_decoderRef = matching[index]->ref;
+		return true;
+	}
+	index -= matching.size();
 	return false;
 }
 
