+									entry_ref* _decoderRef, int32& index);
 
 			bool				_FindEncoder(const media_format& format,
 									const BPath& path,
@@ -103,6 +104,7 @@ private:
 			struct decoder_info {
 				entry_ref			ref;
 				List<media_format>	formats;
+				int32				priority;
 			};
 			struct encoder_info {
 				entry_ref			ref;
diff --git a/src/kits/media/MediaExtractor.cpp b/src/kits/media/MediaExtractor.cpp
index b17491c07b..6b928d89a4 100644
--- a/src/kits/media/MediaExtractor.cpp
+++ b/src/kits/media/MediaExtractor.cpp
@@ -344,42 +344,50 @@ MediaExtractor::CreateDecoder(int32 stream, Decoder** _decoder,
 		return status;
 	}
 
-	// TODO: Here we should work out a way so that if there is a setup
-	// failure we can try the next decoder
-	Decoder* decoder;
-	status = gPluginManager.CreateDecoder(&decoder,
-		fStreamInfo[stream].encodedFormat);
-	if (status != B_OK) {
+	// The decoders for the format in turn, until one can decode the stream
+	// (a hardware decoder may be in use already). Each gets the format as
+	// the reader gave it.
+	const media_format encodedFormat = fStreamInfo[stream].encodedFormat;
+	Decoder* decoder = NULL;
+	status_t setupStatus = B_OK;
+	for (int32 index = 0; ; index++) {
+		fStreamInfo[stream].encodedFormat = encodedFormat;
+		status = gPluginManager.CreateDecoder(&decoder,
+			fStreamInfo[stream].encodedFormat, index);
+		if (status != B_OK) {
 #if DEBUG
-		char formatString[256];
-		string_for_format(fStreamInfo[stream].encodedFormat, formatString,
-			sizeof(formatString));
+			char formatString[256];
+			string_for_format(fStreamInfo[stream].encodedFormat, formatString,
+				sizeof(formatString));
 
-		ERROR("MediaExtractor::CreateDecoder gPluginManager.CreateDecoder "
-			"failed for stream %" B_PRId32 ", format: %s: %s\n", stream,
-			formatString, strerror(status));
+			ERROR("MediaExtractor::CreateDecoder gPluginManager.CreateDecoder "
+				"failed for stream %" B_PRId32 ", format: %s: %s\n", stream,
+				formatString, strerror(status));
 #endif
-		return status;
-	}
+			return index == 0 ? status : setupStatus;
+		}
 
-	ChunkProvider* chunkProvider
-		= new(std::nothrow) MediaExtractorChunkProvider(this, stream);
-	if (chunkProvider == NULL) {
-		gPluginManager.DestroyDecoder(decoder);
-		ERROR("MediaExtractor::CreateDecoder can't create chunk provider "
-			"for stream %" B_PRId32 "\n", stream);
-		return B_NO_MEMORY;
-	}
+		ChunkProvider* chunkProvider
+			= new(std::nothrow) MediaExtractorChunkProvider(this, stream);
+		if (chunkProvider == NULL) {
+			gPluginManager.DestroyDecoder(decoder);
+			ERROR("MediaExtractor::CreateDecoder can't create chunk provider "
+				"for stream %" B_PRId32 "\n", stream);
+			return B_NO_MEMORY;
+		}
 
-	decoder->SetChunkProvider(chunkProvider);
+		decoder->SetChunkProvider(chunkProvider);
 
-	status = decoder->Setup(&fStreamInfo[stream].encodedFormat,
-		fStreamInfo[stream].infoBuffer, fStreamInfo[stream].infoBufferSize);
-	if (status != B_OK) {
+		status = decoder->Setup(&fStreamInfo[stream].encodedFormat,
+			fStreamInfo[stream].infoBuffer,
+			fStreamInfo[stream].infoBufferSize);
+		if (status == B_OK)
+			break;
+
+		setupStatus = status;
 		gPluginManager.DestroyDecoder(decoder);
 		ERROR("MediaExtractor::CreateDecoder Setup failed for stream %" B_PRId32
 			": %s\n", stream, strerror(status));
-		return status;
 	}
 
 	status = gPluginManager.GetDecoderInfo(decoder, codecInfo);
diff --git a/src/kits/media/PluginManager.cpp b/src/kits/media/PluginManager.cpp
index 28141358be..fab36d1747 100644
--- a/src/kits/media/PluginManager.cpp
+++ b/src/kits/media/PluginManager.cpp
@@ -293,17 +293,20 @@ PluginManager::DestroyReader(Reader* reader)
 
 
 status_t
-PluginManager::CreateDecoder(Decoder** _decoder, const media_format& format)
+PluginManager::CreateDecoder(Decoder** _decoder, const media_format& format,
+	int32 index)
 {
 	TRACE("PluginManager::CreateDecoder enter\n");
 
 	// get decoder for this format
 	entry_ref ref;
 	status_t ret = AddOnManager::GetInstance()->GetDecoderForFormat(
-		&ref, format);
+		&ref, format, index);
 	if (ret != B_OK) {
-		printf("PluginManager::CreateDecoder: can't get decoder for format: "
-			"%s\n", strerror(ret));
+		if (index == 0) {
+			printf("PluginManager::CreateDecoder: can't get decoder for "
+				"format: %s\n", strerror(ret));
+		}
 		return ret;
 	}
 
