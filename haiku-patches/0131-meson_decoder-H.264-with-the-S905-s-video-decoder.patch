+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef H264_H
+#define H264_H
+
+
+#include <SupportDefs.h>
+
+
+/*!	What the decoder needs to know of an H.264 stream before decoding it:
+	from its first sequence parameter set.
+*/
+struct h264_sequence {
+	uint32	profile;			// profile_idc
+	uint32	level;				// level_idc
+	uint32	chroma_format;		// 1: 4:2:0
+	uint32	bit_depth;			// luma and chroma: 8
+	bool	frame_only;			// no fields
+	uint32	coded_width;		// in pixels, a multiple of 16
+	uint32	coded_height;
+	uint32	width;				// after cropping
+	uint32	height;
+	uint32	reference_frames;	// max_num_ref_frames
+};
+
+
+bool	h264_parse_sequence(const uint8* nal, size_t size,
+			h264_sequence& sequence);
+			// nal: from its header byte, without the start code
+
+
+/*!	The parameter sets of an MP4/Matroska "avcC" record as Annex B NAL units
+	(each after 00 00 00 01), and the length of the length prefix of the
+	stream's NAL units. Returns false if \a data is not an avcC record.
+*/
+bool	h264_parse_avcc(const uint8* data, size_t size, uint8* annexB,
+			size_t* _annexBSize, size_t annexBCapacity,
+			uint32* _lengthSize);
+
+/*!	A chunk whose NAL units each come after a big endian length of
+	\a lengthSize bytes, as Annex B. Returns the bytes written to \a out, or
+	0 if the chunk is malformed or doesn't fit.
+*/
+size_t	h264_lengths_to_annexb(const uint8* chunk, size_t size,
+			uint32 lengthSize, uint8* out, size_t capacity);
+
+/*!	The first sequence parameter set in Annex B data. */
+const uint8* h264_find_sps(const uint8* data, size_t size, size_t* _nalSize);
+
+
+#endif	// H264_H
