+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "nv12_neon.h"
+
+// The build includes GCC's headers like its own, with -Werror.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wsign-compare"
+#pragma GCC diagnostic ignored "-Wmissing-braces"
+#include <arm_neon.h>
+#pragma GCC diagnostic pop
+
+
+/*!	NV12 (a Y plane, then Cb and Cr interleaved at half the height) to
+	packed 4:2:2 Y0 Cb Y1 Cr (B_YCbCr422), what the video overlay takes. Each
+	chroma row serves two rows, as in the FFmpeg plugin's conversion from
+	planar 4:2:0. 32 pixels at a time, the rest one pair at a time.
+*/
+void
+nv12_to_ycbcr422_neon(const uint8_t* luma, const uint8_t* chroma,
+	size_t sourceBytesPerRow, uint8_t* out, size_t outBytesPerRow,
+	uint32_t width, uint32_t height)
+{
+	for (uint32_t y = 0; y < height; y++) {
+		const uint8_t* lumaRow = luma + (size_t)y * sourceBytesPerRow;
+		const uint8_t* chromaRow = chroma + (size_t)(y / 2) * sourceBytesPerRow;
+		uint8_t* pixel = out + (size_t)y * outBytesPerRow;
+
+		uint32_t x = 0;
+		for (; x + 32 <= width; x += 32) {
+			uint8x16x2_t lumaPairs = vld2q_u8(lumaRow + x);
+			uint8x16x2_t chromaPairs = vld2q_u8(chromaRow + x);
+			uint8x16x4_t packed;
+			packed.val[0] = lumaPairs.val[0];
+			packed.val[1] = chromaPairs.val[0];
+			packed.val[2] = lumaPairs.val[1];
+			packed.val[3] = chromaPairs.val[1];
+			vst4q_u8(pixel + 2 * x, packed);
+		}
+		for (; x + 1 < width; x += 2) {
+			pixel[2 * x] = lumaRow[x];
+			pixel[2 * x + 1] = chromaRow[x];
+			pixel[2 * x + 2] = lumaRow[x + 1];
+			pixel[2 * x + 3] = chromaRow[x + 1];
+		}
+	}
+}
