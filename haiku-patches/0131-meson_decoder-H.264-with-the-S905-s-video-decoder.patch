+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef MESON_VDEC_DECODER_H
+#define MESON_VDEC_DECODER_H
+
+
+#include <MediaFormats.h>
+#include <OS.h>
+
+#include <meson_vdec.h>
+
+#include "DecoderPlugin.h"
+#include "H264.h"
+
+
+struct SwsContext;
+
+
+class MesonVdecDecoder : public Decoder {
+public:
+								MesonVdecDecoder();
+	virtual						~MesonVdecDecoder();
+
+	virtual	void				GetCodecInfo(media_codec_info* codecInfo);
+	virtual	status_t			Setup(media_format* ioEncodedFormat,
+									const void* infoBuffer, size_t infoSize);
+	virtual	status_t			NegotiateOutputFormat(
+									media_format* ioDecodedFormat);
+	virtual	status_t			SeekedTo(int64 frame, bigtime_t time);
+	virtual	status_t			Decode(void* buffer, int64* frameCount,
+									media_header* mediaHeader,
+									media_decode_info* info);
+
+private:
+			status_t			_LoadFirmware();
+			status_t			_StartSession();
+			void				_StopSession();
+			status_t			_NextFrame();
+			status_t			_FeedChunk();
+			status_t			_Write(const uint8* data, size_t size,
+									uint32* _offset);
+			const uint8*		_MapFrames(area_id frames);
+			void				_UnmapFrames();
+			void				_ReleaseFrame();
+			status_t			_Convert(void* buffer);
+			void				_FillHeader(media_header* header);
+
+			void				_AddTime(uint32 offset, bigtime_t time);
+			bigtime_t			_TakeTime(uint32 offset);
+
+private:
+			int					fDevice;
+			uint32				fCodec;			// MESON_VDEC_*
+			uint8*				fFirmware;
+			size_t				fFirmwareSize;
+			media_format		fInputFormat;
+			h264_sequence		fSequence;
+
+			// the parameter sets of an MP4 stream ("avcC"), as Annex B, for
+			// the start of each session; the length of its NAL lengths (0:
+			// the stream is Annex B already)
+			uint8*				fHeaders;
+			size_t				fHeadersSize;
+			uint32				fLengthSize;
+			uint8*				fConverted;
+			size_t				fConvertedSize;
+
+			bool				fRunning;
+			bool				fHeadersSent;
+			bool				fInputEnded;
+			bool				fEndSent;
+			bool				fOutputEnded;
+			// our clones of the driver's frame areas
+			struct mapping {
+				area_id			source;
+				area_id			clone;
+				const uint8*	address;
+			};
+	static	const uint32		kMaxMappings = 32;
+			mapping				fMappings[kMaxMappings];
+			uint32				fMappingCount;
+
+			// the frame taken from the driver, not yet given back
+			meson_vdec_frame	fFrame;
+			bool				fHaveFrame;
+			uint32				fChunksInFlight;
+				// written, their frames not taken yet
+
+			// the chunks written whose frames weren't taken: where in the
+			// stream they start, and their start times. A frame takes the
+			// last chunk that starts at or before its picture.
+			struct chunk_time {
+				uint32			offset;
+				bigtime_t		time;
+			};
+			chunk_time*			fTimes;
+			uint32				fTimeCount;
+			uint32				fTimeCapacity;
+
+			color_space			fOutputColorSpace;
+			uint32				fOutputBytesPerRow;
+			SwsContext*			fSwsContext;
+			uint32				fFrameNumber;
+			float				fFieldRate;
+};
+
+
+#endif	// MESON_VDEC_DECODER_H
diff --git a/src/add-ons/media/plugins/meson_decoder/MesonVdecPlugin.cpp b/src/add-ons/media/plugins/meson_decoder/MesonVdecPlugin.cpp
new file mode 100644
index 0000000000..f1ac4cf219
--- /dev/null
+++ b/src/add-ons/media/plugins/meson_decoder/MesonVdecPlugin.cpp
@@ -0,0 +1,81 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * meson_decoder: a decoder plugin for the S905's video decoder (PLAN.md M26).
+ * It takes the streams FFmpeg's reader describes as H.264, and comes first
+ * among the decoders (media_decoder_priority).
+ */
+
+
+#include <new>
+
+#include <MediaFormats.h>
+
+extern "C" {
+#include "libavcodec/codec_id.h"
+}
+
+#include "DecoderPlugin.h"
+#include "MesonVdecDecoder.h"
+
+
+class MesonVdecPlugin : public DecoderPlugin {
+public:
+	virtual	Decoder*			NewDecoder(uint index);
+	virtual	status_t			GetSupportedFormats(media_format** _formats,
+									size_t* _count);
+};
+
+
+static media_format sFormats[1];
+
+
+Decoder*
+MesonVdecPlugin::NewDecoder(uint index)
+{
+	return new(std::nothrow) MesonVdecDecoder();
+}
+
+
+status_t
+MesonVdecPlugin::GetSupportedFormats(media_format** _formats, size_t* _count)
+{
+	BMediaFormats mediaFormats;
+	if (mediaFormats.InitCheck() != B_OK)
+		return B_ERROR;
+
+	// as AVFormatReader describes them
+	media_format_description description;
+	memset(&description, 0, sizeof(description));
+	description.family = B_MISC_FORMAT_FAMILY;
+	description.u.misc.file_format = 'ffmp';
+	description.u.misc.codec = AV_CODEC_ID_H264;
+
+	media_format format;
+	format.type = B_MEDIA_ENCODED_VIDEO;
+	format.require_flags = 0;
+	format.deny_flags = B_MEDIA_MAUI_UNDEFINED_FLAGS;
+	if (mediaFormats.MakeFormatFor(&description, 1, &format) != B_OK)
+		return B_ERROR;
+	sFormats[0] = format;
+
+	*_formats = sFormats;
+	*_count = 1;
+	return B_OK;
+}
+
+
+extern "C" {
+
+// before the software decoders (AddOnManager)
+int32 media_decoder_priority = 100;
+
+}
+
+
+MediaPlugin*
+instantiate_plugin()
+{
+	return new(std::nothrow) MesonVdecPlugin;
+}
