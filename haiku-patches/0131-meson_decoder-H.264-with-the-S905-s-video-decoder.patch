diff --git a/src/add-ons/media/plugins/meson_decoder/H264.cpp b/src/add-ons/media/plugins/meson_decoder/H264.cpp
new file mode 100644
index 0000000000..dfeef92992
--- /dev/null
+++ b/src/add-ons/media/plugins/meson_decoder/H264.cpp
@@ -0,0 +1,297 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * The little of H.264's syntax (ITU-T H.264, 7.3.2.1.1) and of its MP4
+ * storage (ISO/IEC 14496-15, the AVCDecoderConfigurationRecord) the
+ * hardware decoder's plugin needs.
+ */
+
+
+#include "H264.h"
+
+#include <string.h>
+
+
+namespace {
+
+
+/*!	Reads the bits of a NAL unit's payload, skipping the emulation
+	prevention bytes (00 00 03 -> 00 00).
+*/
+class BitReader {
+public:
+	BitReader(const uint8* data, size_t size)
+		:
+		fData(data),
+		fSize(size),
+		fPosition(0),
+		fBit(0),
+		fZeros(0),
+		fError(false)
+	{
+	}
+
+	bool Error() const { return fError; }
+
+	uint32 Bit()
+	{
+		if (fBit == 0 && !_NextByte())
+			return 0;
+		uint32 bit = (fByte >> (7 - fBit)) & 1;
+		fBit = (fBit + 1) % 8;
+		return bit;
+	}
+
+	uint32 Bits(uint32 count)
+	{
+		uint32 value = 0;
+		while (count-- > 0)
+			value = (value << 1) | Bit();
+		return value;
+	}
+
+	uint32 UnsignedGolomb()
+	{
+		uint32 zeros = 0;
+		while (Bit() == 0) {
+			if (fError || ++zeros > 31) {
+				fError = true;
+				return 0;
+			}
+		}
+		return ((1u << zeros) - 1) + Bits(zeros);
+	}
+
+	int32 SignedGolomb()
+	{
+		uint32 value = UnsignedGolomb();
+		return (value & 1) != 0 ? (int32)((value + 1) / 2)
+			: -(int32)(value / 2);
+	}
+
+private:
+	bool _NextByte()
+	{
+		while (fPosition < fSize) {
+			uint8 byte = fData[fPosition++];
+			if (fZeros >= 2 && byte == 3) {
+				fZeros = 0;
+				continue;
+			}
+			fZeros = byte == 0 ? fZeros + 1 : 0;
+			fByte = byte;
+			return true;
+		}
+		fError = true;
+		return false;
+	}
+
+	const uint8*	fData;
+	size_t			fSize;
+	size_t			fPosition;
+	uint32			fBit;
+	uint32			fZeros;
+	uint8			fByte;
+	bool			fError;
+};
+
+
+void
+skip_scaling_list(BitReader& reader, uint32 size)
+{
+	int32 last = 8;
+	int32 next = 8;
+	for (uint32 i = 0; i < size; i++) {
+		if (next != 0) {
+			int32 delta = reader.SignedGolomb();
+			next = (last + delta + 256) % 256;
+		}
+		if (next != 0)
+			last = next;
+	}
+}
+
+
+inline uint32
+read_be(const uint8* data, uint32 length)
+{
+	uint32 value = 0;
+	for (uint32 i = 0; i < length; i++)
+		value = (value << 8) | data[i];
+	return value;
+}
+
+
+}	// namespace
+
+
+bool
+h264_parse_sequence(const uint8* nal, size_t size, h264_sequence& sequence)
+{
+	if (size < 4 || (nal[0] & 0x1f) != 7)
+		return false;
+
+	BitReader reader(nal + 1, size - 1);
+	memset(&sequence, 0, sizeof(sequence));
+	sequence.profile = reader.Bits(8);
+	reader.Bits(8);		// the constraint flags
+	sequence.level = reader.Bits(8);
+	reader.UnsignedGolomb();	// seq_parameter_set_id
+	sequence.chroma_format = 1;
+	sequence.bit_depth = 8;
+	switch (sequence.profile) {
+		case 100: case 110: case 122: case 244: case 44: case 83: case 86:
+		case 118: case 128: case 138: case 139: case 134: case 135:
+		{
+			sequence.chroma_format = reader.UnsignedGolomb();
+			if (sequence.chroma_format == 3)
+				reader.Bit();	// separate_colour_plane_flag
+			uint32 lumaDepth = reader.UnsignedGolomb() + 8;
+			uint32 chromaDepth = reader.UnsignedGolomb() + 8;
+			sequence.bit_depth = lumaDepth == chromaDepth ? lumaDepth : 0;
+			reader.Bit();	// qpprime_y_zero_transform_bypass_flag
+			if (reader.Bit()) {
+				// seq_scaling_matrix_present_flag
+				uint32 lists = sequence.chroma_format != 3 ? 8 : 12;
+				for (uint32 i = 0; i < lists; i++) {
+					if (reader.Bit())
+						skip_scaling_list(reader, i < 6 ? 16 : 64);
+				}
+			}
+			break;
+		}
+	}
+	reader.UnsignedGolomb();	// log2_max_frame_num_minus4
+	uint32 orderType = reader.UnsignedGolomb();
+	if (orderType == 0)
+		reader.UnsignedGolomb();	// log2_max_pic_order_cnt_lsb_minus4
+	else if (orderType == 1) {
+		reader.Bit();	// delta_pic_order_always_zero_flag
+		reader.SignedGolomb();
+		reader.SignedGolomb();
+		uint32 cycle = reader.UnsignedGolomb();
+		if (cycle > 255)
+			return false;
+		for (uint32 i = 0; i < cycle; i++)
+			reader.SignedGolomb();
+	}
+	sequence.reference_frames = reader.UnsignedGolomb();
+	reader.Bit();	// gaps_in_frame_num_value_allowed_flag
+	uint32 widthInMbs = reader.UnsignedGolomb() + 1;
+	uint32 heightInMapUnits = reader.UnsignedGolomb() + 1;
+	sequence.frame_only = reader.Bit() != 0;
+	if (!sequence.frame_only)
+		reader.Bit();	// mb_adaptive_frame_field_flag
+	reader.Bit();	// direct_8x8_inference_flag
+	sequence.coded_width = widthInMbs * 16;
+	sequence.coded_height = (sequence.frame_only ? 1 : 2) * heightInMapUnits
+		* 16;
+	sequence.width = sequence.coded_width;
+	sequence.height = sequence.coded_height;
+	if (reader.Bit()) {
+		// frame_cropping_flag: in chroma samples (in luma samples without
+		// chroma), and of field rows in field coding
+		uint32 left = reader.UnsignedGolomb();
+		uint32 right = reader.UnsignedGolomb();
+		uint32 top = reader.UnsignedGolomb();
+		uint32 bottom = reader.UnsignedGolomb();
+		uint32 unitX = sequence.chroma_format == 0
+			|| sequence.chroma_format == 3 ? 1 : 2;
+		uint32 unitY = (sequence.chroma_format == 1 ? 2 : 1)
+			* (sequence.frame_only ? 1 : 2);
+		uint32 cropX = (left + right) * unitX;
+		uint32 cropY = (top + bottom) * unitY;
+		if (cropX >= sequence.coded_width || cropY >= sequence.coded_height)
+			return false;
+		sequence.width -= cropX;
+		sequence.height -= cropY;
+	}
+	return !reader.Error() && widthInMbs <= 512 && heightInMapUnits <= 512;
+}
+
+
+bool
+h264_parse_avcc(const uint8* data, size_t size, uint8* annexB,
+	size_t* _annexBSize, size_t annexBCapacity, uint32* _lengthSize)
+{
+	// version 1, profile, compatibility, level, 6 bits set and the length
+	// size - 1, 3 bits set and the SPS count
+	if (size < 7 || data[0] != 1)
+		return false;
+	*_lengthSize = (data[4] & 3) + 1;
+
+	size_t position = 5;
+	size_t written = 0;
+	for (uint32 type = 0; type < 2; type++) {
+		// the sequence parameter sets, then the picture parameter sets
+		if (position >= size)
+			return false;
+		uint32 count = type == 0 ? data[position] & 0x1f : data[position];
+		position++;
+		for (uint32 i = 0; i < count; i++) {
+			if (position + 2 > size)
+				return false;
+			uint32 length = read_be(data + position, 2);
+			position += 2;
+			if (position + length > size
+				|| written + 4 + length > annexBCapacity) {
+				return false;
+			}
+			static const uint8 kStartCode[4] = { 0, 0, 0, 1 };
+			memcpy(annexB + written, kStartCode, 4);
+			memcpy(annexB + written + 4, data + position, length);
+			written += 4 + length;
+			position += length;
+		}
+	}
+	*_annexBSize = written;
+	return true;
+}
+
+
+size_t
+h264_lengths_to_annexb(const uint8* chunk, size_t size, uint32 lengthSize,
+	uint8* out, size_t capacity)
+{
+	size_t position = 0;
+	size_t written = 0;
+	while (position + lengthSize <= size) {
+		uint32 length = read_be(chunk + position, lengthSize);
+		position += lengthSize;
+		if (length > size - position || written + 4 + length > capacity)
+			return 0;
+		out[written++] = 0;
+		out[written++] = 0;
+		out[written++] = 0;
+		out[written++] = 1;
+		memcpy(out + written, chunk + position, length);
+		written += length;
+		position += length;
+	}
+	return written;
+}
+
+
+const uint8*
+h264_find_sps(const uint8* data, size_t size, size_t* _nalSize)
+{
+	for (size_t i = 0; i + 3 < size; i++) {
+		if (data[i] != 0 || data[i + 1] != 0 || data[i + 2] != 1
+			|| (data[i + 3] & 0x1f) != 7) {
+			continue;
+		}
+		const uint8* nal = data + i + 3;
+		size_t end = i + 3;
+		while (end + 2 < size
+			&& !(data[end] == 0 && data[end + 1] == 0
+				&& (data[end + 2] == 1 || data[end + 2] == 0))) {
+			end++;
+		}
+		if (end + 2 >= size)
+			end = size;
+		*_nalSize = data + end - nal;
+		return nal;
+	}
+	return NULL;
+}
