+}
diff --git a/src/add-ons/media/plugins/meson_decoder/MesonVdecDecoder.cpp b/src/add-ons/media/plugins/meson_decoder/MesonVdecDecoder.cpp
new file mode 100644
index 0000000000..e0c3047a0a
--- /dev/null
+++ b/src/add-ons/media/plugins/meson_decoder/MesonVdecDecoder.cpp
@@ -0,0 +1,621 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * Decodes H.264 with the S905's video decoder, through the meson_vdec
+ * driver (headers/private/drivers/meson_vdec.h): the chunks go to the
+ * driver as an Annex B stream, the decoded NV12 frames come back in display
+ * order and are written to the caller's buffer as B_YCbCr422 (for the video
+ * overlay) or B_RGB32.
+ *
+ * Setup() fails when the decoder is in use, the firmware is missing or the
+ * stream is one the hardware can't decode (beyond 1920x1088, 4:2:2, 10
+ * bits, fields): the Media Kit then takes the next decoder (FFmpeg's).
+ */
+
+
+#include "MesonVdecDecoder.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <new>
+
+#include <FindDirectory.h>
+
+extern "C" {
+#include "libavcodec/codec_id.h"
+#include "libswscale/swscale.h"
+}
+
+#include "nv12_neon.h"
+
+
+//#define TRACE_MESON_VDEC
+#ifdef TRACE_MESON_VDEC
+#	define TRACE(x...)	printf("meson_vdec: " x)
+#else
+#	define TRACE(x...)
+#endif
+#define ERROR(x...)		fprintf(stderr, "meson_vdec: " x)
+
+
+static const char* kFirmwarePath = "firmware/meson/vdec/gxbb_h264.bin";
+	// in the system data directory
+static const uint32 kMaxInFlight = 24;
+	// chunks written ahead of the frames taken
+static const bigtime_t kFrameTimeout = 1000000;
+
+
+MesonVdecDecoder::MesonVdecDecoder()
+	:
+	fDevice(-1),
+	fCodec(MESON_VDEC_H264),
+	fFirmware(NULL),
+	fFirmwareSize(0),
+	fHeaders(NULL),
+	fHeadersSize(0),
+	fLengthSize(0),
+	fConverted(NULL),
+	fConvertedSize(0),
+	fRunning(false),
+	fHeadersSent(false),
+	fInputEnded(false),
+	fEndSent(false),
+	fOutputEnded(false),
+	fMappingCount(0),
+	fHaveFrame(false),
+	fChunksInFlight(0),
+	fTimes(NULL),
+	fTimeCount(0),
+	fTimeCapacity(0),
+	fOutputColorSpace(B_RGB32),
+	fOutputBytesPerRow(0),
+	fSwsContext(NULL),
+	fFrameNumber(0),
+	fFieldRate(0)
+{
+	memset(&fSequence, 0, sizeof(fSequence));
+	memset(&fFrame, 0, sizeof(fFrame));
+}
+
+
+MesonVdecDecoder::~MesonVdecDecoder()
+{
+	_StopSession();
+	if (fDevice >= 0)
+		close(fDevice);
+	if (fSwsContext != NULL)
+		sws_freeContext(fSwsContext);
+	free(fFirmware);
+	free(fHeaders);
+	free(fConverted);
+	free(fTimes);
+}
+
+
+void
+MesonVdecDecoder::GetCodecInfo(media_codec_info* info)
+{
+	strlcpy(info->short_name, "meson_vdec", sizeof(info->short_name));
+	strlcpy(info->pretty_name, "H.264 (Amlogic S905 video decoder)",
+		sizeof(info->pretty_name));
+	info->id = 0;
+	info->sub_id = AV_CODEC_ID_H264;
+}
+
+
+status_t
+MesonVdecDecoder::Setup(media_format* ioEncodedFormat, const void* infoBuffer,
+	size_t infoSize)
+{
+	if (ioEncodedFormat->type != B_MEDIA_ENCODED_VIDEO)
+		return B_MEDIA_BAD_FORMAT;
+	BMediaFormats formats;
+	media_format_description description;
+	if (formats.GetCodeFor(*ioEncodedFormat, B_MISC_FORMAT_FAMILY,
+			&description) != B_OK
+		|| description.u.misc.file_format != 'ffmp'
+		|| description.u.misc.codec != AV_CODEC_ID_H264) {
+		return B_MEDIA_BAD_FORMAT;
+	}
+	fInputFormat = *ioEncodedFormat;
+	fFieldRate = ioEncodedFormat->u.encoded_video.output.field_rate;
+
+	// the parameter sets: an avcC record (MP4, Matroska) or Annex B (the
+	// stream itself has them then too)
+	const uint8* info = (const uint8*)infoBuffer;
+	free(fHeaders);
+	fHeadersSize = infoSize * 2 + 64;
+	fHeaders = (uint8*)malloc(fHeadersSize);
+	if (fHeaders == NULL)
+		return B_NO_MEMORY;
+	if (infoSize > 0 && info[0] == 1) {
+		if (!h264_parse_avcc(info, infoSize, fHeaders, &fHeadersSize,
+				fHeadersSize, &fLengthSize)) {
+			ERROR("bad avcC record\n");
+			return B_MEDIA_BAD_FORMAT;
+		}
+	} else {
+		memcpy(fHeaders, info, infoSize);
+		fHeadersSize = infoSize;
+		fLengthSize = 0;
+	}
+
+	size_t spsSize;
+	const uint8* sps = h264_find_sps(fHeaders, fHeadersSize, &spsSize);
+	if (sps == NULL || !h264_parse_sequence(sps, spsSize, fSequence)) {
+		TRACE("no sequence parameter set before the stream\n");
+		return B_MEDIA_BAD_FORMAT;
+	}
+	TRACE("profile %" B_PRIu32 ", level %" B_PRIu32 ", %" B_PRIu32 "x%"
+		B_PRIu32 " (coded %" B_PRIu32 "x%" B_PRIu32 "), %" B_PRIu32
+		" reference frames\n", fSequence.profile, fSequence.level,
+		fSequence.width, fSequence.height, fSequence.coded_width,
+		fSequence.coded_height, fSequence.reference_frames);
+	bool profileOkay = fSequence.profile == 66 || fSequence.profile == 77
+		|| fSequence.profile == 100;
+	if (!profileOkay || fSequence.chroma_format != 1
+		|| fSequence.bit_depth != 8 || !fSequence.frame_only
+		|| fSequence.coded_width > 1920 || fSequence.coded_height > 1088) {
+		TRACE("not for the hardware: profile %" B_PRIu32 ", chroma %" B_PRIu32
+			", %" B_PRIu32 " bits%s\n", fSequence.profile,
+			fSequence.chroma_format, fSequence.bit_depth,
+			fSequence.frame_only ? "" : ", fields");
+		return B_MEDIA_BAD_FORMAT;
+	}
+
+	status_t status = _LoadFirmware();
+	if (status != B_OK)
+		return status;
+
+	// one session at a time: if another one has the decoder, the next
+	// decoder plugin gets the stream
+	fDevice = open(MESON_VDEC_DEVICE, O_RDWR | O_CLOEXEC);
+	if (fDevice < 0) {
+		TRACE("%s: %s\n", MESON_VDEC_DEVICE, strerror(errno));
+		return errno == EBUSY ? B_BUSY : B_MEDIA_BAD_FORMAT;
+	}
+	return B_OK;
+}
+
+
+status_t
+MesonVdecDecoder::_LoadFirmware()
+{
+	char path[B_PATH_NAME_LENGTH];
+	if (find_directory(B_SYSTEM_DATA_DIRECTORY, -1, false, path,
+			sizeof(path)) != B_OK) {
+		return B_ENTRY_NOT_FOUND;
+	}
+	strlcat(path, "/", sizeof(path));
+	strlcat(path, kFirmwarePath, sizeof(path));
+
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		TRACE("%s: %s\n", path, strerror(errno));
+		return B_ENTRY_NOT_FOUND;
+	}
+	struct stat st;
+	if (fstat(fd, &st) != 0 || st.st_size <= 0 || st.st_size > 256 * 1024) {
+		close(fd);
+		return B_BAD_DATA;
+	}
+	free(fFirmware);
+	fFirmware = (uint8*)malloc(st.st_size);
+	if (fFirmware == NULL) {
+		close(fd);
+		return B_NO_MEMORY;
+	}
+	fFirmwareSize = st.st_size;
+	ssize_t bytesRead = read(fd, fFirmware, fFirmwareSize);
+	close(fd);
+	return bytesRead == (ssize_t)fFirmwareSize ? B_OK : B_IO_ERROR;
+}
+
+
+status_t
+MesonVdecDecoder::_StartSession()
+{
+	meson_vdec_start start;
+	memset(&start, 0, sizeof(start));
+	start.codec = fCodec;
+	start.firmware = fFirmware;
+	start.firmware_size = fFirmwareSize;
+	start.width = fSequence.width;
+	start.height = fSequence.height;
+	if (ioctl(fDevice, MESON_VDEC_START, &start, sizeof(start)) != 0) {
+		ERROR("start: %s\n", strerror(errno));
+		return errno;
+	}
+	fRunning = true;
+	fHeadersSent = false;
+	fInputEnded = false;
+	fEndSent = false;
+	fOutputEnded = false;
+	fHaveFrame = false;
+	fChunksInFlight = 0;
+	fTimeCount = 0;
+	return B_OK;
+}
+
+
+void
+MesonVdecDecoder::_StopSession()
+{
+	if (!fRunning)
+		return;
+	ioctl(fDevice, MESON_VDEC_STOP, NULL, 0);
+	fRunning = false;
+	fHaveFrame = false;
+	_UnmapFrames();
+}
+
+
+/*!	Our clone of a frame area of the driver's (H.264: one per frame, which
+	the driver may replace when the stream changes).
+*/
+const uint8*
+MesonVdecDecoder::_MapFrames(area_id frames)
+{
+	for (uint32 i = 0; i < fMappingCount; i++) {
+		if (fMappings[i].source == frames)
+			return fMappings[i].address;
+	}
+	if (fMappingCount == kMaxMappings)
+		_UnmapFrames();
+	mapping& entry = fMappings[fMappingCount];
+	void* address;
+	entry.clone = clone_area("meson_vdec frame", &address, B_ANY_ADDRESS,
+		B_READ_AREA, frames);
+	if (entry.clone < 0) {
+		ERROR("clone_area: %s\n", strerror(entry.clone));
+		return NULL;
+	}
+	entry.source = frames;
+	entry.address = (const uint8*)address;
+	fMappingCount++;
+	return entry.address;
+}
+
+
+void
+MesonVdecDecoder::_UnmapFrames()
+{
+	for (uint32 i = 0; i < fMappingCount; i++)
+		delete_area(fMappings[i].clone);
+	fMappingCount = 0;
+}
+
+
+status_t
+MesonVdecDecoder::_Write(const uint8* data, size_t size, uint32* _offset)
+{
+	meson_vdec_write write;
+	write.data = data;
+	write.size = size;
+	write.offset = 0;
+	if (ioctl(fDevice, MESON_VDEC_WRITE, &write, sizeof(write)) != 0) {
+		ERROR("write of %" B_PRIuSIZE " bytes: %s\n", size, strerror(errno));
+		return errno;
+	}
+	*_offset = write.offset;
+	return B_OK;
+}
+
+
+/*!	Writes the next chunk to the decoder as Annex B, one picture per write
+	(at the start of a session, after the parameter sets).
+*/
+status_t
+MesonVdecDecoder::_FeedChunk()
+{
+	const void* chunk;
+	size_t size;
+	media_header header;
+	status_t status = GetNextChunk(&chunk, &size, &header);
+	if (status == B_LAST_BUFFER_ERROR) {
+		fInputEnded = true;
+		return B_OK;
+	}
+	if (status != B_OK)
+		return status;
+
+	size_t headers = fHeadersSent ? 0 : fHeadersSize;
+	size_t capacity = headers + (fLengthSize > 0 ? 4 * size + 64 : size);
+	if (fConvertedSize < capacity) {
+		uint8* converted = (uint8*)realloc(fConverted, capacity);
+		if (converted == NULL)
+			return B_NO_MEMORY;
+		fConverted = converted;
+		fConvertedSize = capacity;
+	}
+	memcpy(fConverted, fHeaders, headers);
+	if (fLengthSize > 0) {
+		size = h264_lengths_to_annexb((const uint8*)chunk, size, fLengthSize,
+			fConverted + headers, fConvertedSize - headers);
+		if (size == 0) {
+			ERROR("malformed chunk\n");
+			return B_OK;
+		}
+	} else
+		memcpy(fConverted + headers, chunk, size);
+	if (headers + size == 0)
+		return B_OK;
+
+	uint32 offset;
+	status = _Write(fConverted, headers + size, &offset);
+	if (status != B_OK)
+		return status;
+	fHeadersSent = true;
+	_AddTime(offset, header.start_time);
+	fChunksInFlight++;
+	return B_OK;
+}
+
+
+/*!	Takes the next decoded frame from the driver into fFrame, writing the
+	stream to the decoder until there is one.
+*/
+status_t
+MesonVdecDecoder::_NextFrame()
+{
+	if (fHaveFrame)
+		return B_OK;
+	if (fOutputEnded)
+		return B_LAST_BUFFER_ERROR;
+	if (!fRunning) {
+		status_t status = _StartSession();
+		if (status != B_OK)
+			return status;
+	}
+
+	while (true) {
+		// wait for a frame only when there is nothing more to write
+		bool full = fChunksInFlight >= kMaxInFlight;
+		meson_vdec_frame frame;
+		memset(&frame, 0, sizeof(frame));
+		frame.timeout = fInputEnded || full ? kFrameTimeout : 0;
+		if (ioctl(fDevice, MESON_VDEC_GET_FRAME, &frame, sizeof(frame))
+				== 0) {
+			if ((frame.flags & MESON_VDEC_FRAME_END_OF_STREAM) != 0) {
+				fOutputEnded = true;
+				return B_LAST_BUFFER_ERROR;
+			}
+			if (_MapFrames(frame.frames) == NULL)
+				return B_NO_MEMORY;
+			fFrame = frame;
+			fHaveFrame = true;
+			if (fChunksInFlight > 0)
+				fChunksInFlight--;
+			return B_OK;
+		}
+		status_t error = errno;
+		if (error != B_TIMED_OUT && error != B_WOULD_BLOCK) {
+			ERROR("frame: %s\n", strerror(error));
+			return error;
+		}
+
+		if (fInputEnded) {
+			if (fEndSent) {
+				ERROR("no end of the stream\n");
+				return B_LAST_BUFFER_ERROR;
+			}
+			if (ioctl(fDevice, MESON_VDEC_END_OF_STREAM, NULL, 0) != 0)
+				return errno;
+			fEndSent = true;
+			continue;
+		}
+		if (full) {
+			// chunks without a picture of their own: write on
+			ERROR("no frame after %" B_PRIu32 " chunks\n", fChunksInFlight);
+			fChunksInFlight = kMaxInFlight - 1;
+			continue;
+		}
+		status_t status = _FeedChunk();
+		if (status != B_OK)
+			return status;
+	}
+}
+
+
+void
+MesonVdecDecoder::_ReleaseFrame()
+{
+	if (!fHaveFrame)
+		return;
+	ioctl(fDevice, MESON_VDEC_RECYCLE_FRAME, &fFrame.index,
+		sizeof(fFrame.index));
+	fHaveFrame = false;
+}
+
+
+void
+MesonVdecDecoder::_AddTime(uint32 offset, bigtime_t time)
+{
+	if (fTimeCount >= 4 * kMaxInFlight) {
+		// chunks that had no picture of their own: drop the oldest
+		memmove(fTimes, fTimes + 1, (fTimeCount - 1) * sizeof(chunk_time));
+		fTimeCount--;
+	}
+	if (fTimeCount == fTimeCapacity) {
+		uint32 capacity = fTimeCapacity > 0 ? fTimeCapacity * 2 : 64;
+		chunk_time* times = (chunk_time*)realloc(fTimes,
+			capacity * sizeof(chunk_time));
+		if (times == NULL)
+			return;
+		fTimes = times;
+		fTimeCapacity = capacity;
+	}
+	fTimes[fTimeCount].offset = offset;
+	fTimes[fTimeCount].time = time;
+	fTimeCount++;
+}
+
+
+/*!	The start time of the frame whose picture is at \a offset in the
+	stream: of the last chunk written at or before it (they are in stream
+	order here). Without one, the earliest: the frames come in display
+	order.
+*/
+bigtime_t
+MesonVdecDecoder::_TakeTime(uint32 offset)
+{
+	if (fTimeCount == 0)
+		return -1;
+	int32 found = -1;
+	for (uint32 i = 0; i < fTimeCount; i++) {
+		if ((int32)(fTimes[i].offset - offset) <= 0)
+			found = i;
+		else
+			break;
+	}
+	if (found < 0) {
+		found = 0;
+		for (uint32 i = 1; i < fTimeCount; i++) {
+			if (fTimes[i].time < fTimes[found].time)
+				found = i;
+		}
+	}
+	bigtime_t time = fTimes[found].time;
+	memmove(fTimes + found, fTimes + found + 1,
+		(fTimeCount - found - 1) * sizeof(chunk_time));
+	fTimeCount--;
+	return time;
+}
+
+
+status_t
+MesonVdecDecoder::NegotiateOutputFormat(media_format* ioDecodedFormat)
+{
+	if (fDevice < 0)
+		return B_NO_INIT;
+
+	fOutputColorSpace
+		= ioDecodedFormat->u.raw_video.display.format == B_YCbCr422
+			? B_YCbCr422 : B_RGB32;
+	uint32 bytesPerRow = fOutputColorSpace == B_YCbCr422
+		? (fSequence.width + 1) / 2 * 4 : fSequence.width * 4;
+	if (ioDecodedFormat->u.raw_video.display.bytes_per_row > bytesPerRow)
+		bytesPerRow = ioDecodedFormat->u.raw_video.display.bytes_per_row;
+	fOutputBytesPerRow = bytesPerRow;
+
+	// the first frame, as the FFmpeg plugin does: whether the decoder can
+	// decode the stream at all
+	status_t status = _NextFrame();
+	if (status != B_OK && status != B_LAST_BUFFER_ERROR) {
+		ERROR("no first frame: %s\n", strerror(status));
+		return status;
+	}
+
+	ioDecodedFormat->type = B_MEDIA_RAW_VIDEO;
+	ioDecodedFormat->require_flags = 0;
+	ioDecodedFormat->deny_flags = B_MEDIA_MAUI_UNDEFINED_FLAGS;
+	ioDecodedFormat->u.raw_video = fInputFormat.u.encoded_video.output;
+	ioDecodedFormat->u.raw_video.interlace = 1;
+	ioDecodedFormat->u.raw_video.first_active = 0;
+	ioDecodedFormat->u.raw_video.last_active = fSequence.height - 1;
+	if (fFieldRate > 0 && fFieldRate < 70)
+		ioDecodedFormat->u.raw_video.field_rate = fFieldRate;
+	ioDecodedFormat->u.raw_video.display.format = fOutputColorSpace;
+	ioDecodedFormat->u.raw_video.display.line_width = fSequence.width;
+	ioDecodedFormat->u.raw_video.display.line_count = fSequence.height;
+	ioDecodedFormat->u.raw_video.display.bytes_per_row = fOutputBytesPerRow;
+	ioDecodedFormat->u.raw_video.display.pixel_offset = 0;
+	ioDecodedFormat->u.raw_video.display.line_offset = 0;
+	ioDecodedFormat->u.raw_video.display.flags = 0;
+	return B_OK;
+}
+
+
+status_t
+MesonVdecDecoder::SeekedTo(int64 frame, bigtime_t time)
+{
+	// The decoder can't drop what it holds: a new session, which starts
+	// with the parameter sets again.
+	_ReleaseFrame();
+	_StopSession();
+	fFrameNumber = frame;
+	return B_OK;
+}
+
+
+status_t
+MesonVdecDecoder::_Convert(void* buffer)
+{
+	const uint8* base = _MapFrames(fFrame.frames);
+	if (base == NULL)
+		return B_NO_MEMORY;
+	base += fFrame.offset;
+	const uint8* luma = base;
+	const uint8* chroma = base + fFrame.chroma_offset;
+	uint32 width = min_c(fFrame.width, fSequence.width);
+	uint32 height = min_c(fFrame.height, fSequence.height);
+
+	if (fOutputColorSpace == B_YCbCr422) {
+		nv12_to_ycbcr422_neon(luma, chroma, fFrame.bytes_per_row,
+			(uint8*)buffer, fOutputBytesPerRow, width, height);
+		return B_OK;
+	}
+
+	fSwsContext = sws_getCachedContext(fSwsContext, width, height,
+		AV_PIX_FMT_NV12, width, height, AV_PIX_FMT_BGRA, SWS_POINT, NULL,
+		NULL, NULL);
+	if (fSwsContext == NULL)
+		return B_NO_MEMORY;
+	const uint8* sourcePlanes[4] = { luma, chroma, NULL, NULL };
+	int sourceStrides[4] = { (int)fFrame.bytes_per_row,
+		(int)fFrame.bytes_per_row, 0, 0 };
+	uint8* targetPlanes[4] = { (uint8*)buffer, NULL, NULL, NULL };
+	int targetStrides[4] = { (int)fOutputBytesPerRow, 0, 0, 0 };
+	sws_scale(fSwsContext, sourcePlanes, sourceStrides, 0, height,
+		targetPlanes, targetStrides);
+	return B_OK;
+}
+
+
+void
+MesonVdecDecoder::_FillHeader(media_header* header)
+{
+	memset(header, 0, sizeof(*header));
+	header->type = B_MEDIA_RAW_VIDEO;
+	header->start_time = _TakeTime(fFrame.stream_offset);
+	header->size_used = (size_t)fOutputBytesPerRow * fSequence.height;
+	header->u.raw_video.display_line_width = fSequence.width;
+	header->u.raw_video.display_line_count = fSequence.height;
+	header->u.raw_video.bytes_per_row = fOutputBytesPerRow;
+	header->u.raw_video.field_gamma = 1.0;
+	header->u.raw_video.field_sequence = fFrameNumber;
+	header->u.raw_video.first_active_line = 1;
+	header->u.raw_video.line_count = fSequence.height;
+	header->u.raw_video.pixel_width_aspect
+		= fInputFormat.u.encoded_video.output.pixel_width_aspect;
+	header->u.raw_video.pixel_height_aspect
+		= fInputFormat.u.encoded_video.output.pixel_height_aspect;
+}
+
+
+status_t
+MesonVdecDecoder::Decode(void* buffer, int64* frameCount,
+	media_header* mediaHeader, media_decode_info* info)
+{
+	if (fDevice < 0)
+		return B_NO_INIT;
+	status_t status = _NextFrame();
+	if (status != B_OK)
+		return status;
+
+	status = _Convert(buffer);
+	_FillHeader(mediaHeader);
+	_ReleaseFrame();
+	if (status != B_OK)
+		return status;
+	*frameCount = 1;
+	fFrameNumber++;
+	return B_OK;
+}
