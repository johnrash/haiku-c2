+/*!	The loaded glyph is a colour picture (FT_PIXEL_MODE_BGRA, premultiplied):
+	keeps it scaled by \a scale, with its metrics, as glyph_data_color.
+*/
+bool
+FontEngine::_PrepareColorGlyph(double scale)
+{
+	const FT_GlyphSlot slot = fFace->glyph;
+	const FT_Bitmap& bitmap = slot->bitmap;
+	if (bitmap.width == 0 || bitmap.rows == 0)
+		return false;
+
+	if (bitmap.rows * scale > kMaxColorGlyphHeight)
+		scale = (double)kMaxColorGlyphHeight / bitmap.rows;
+	int width = (int)round(bitmap.width * scale);
+	int height = (int)round(bitmap.rows * scale);
+	width = width < 1 ? 1 : width;
+	height = height < 1 ? 1 : height;
+	int left = (int)round(slot->bitmap_left * scale);
+	int top = (int)round(slot->bitmap_top * scale);
+
+	size_t size = (size_t)width * height * 4;
+	if (size > fColorDataCapacity) {
+		uint8* data = (uint8*)realloc(fColorData, size);
+		if (data == NULL)
+			return false;
+		fColorData = data;
+		fColorDataCapacity = size;
+	}
+	// with an "up" flow (a negative pitch), the buffer starts at the bottom
+	const uint8* topRow = bitmap.buffer;
+	if (bitmap.pitch < 0)
+		topRow -= (ssize_t)bitmap.pitch * (bitmap.rows - 1);
+	if (!scale_bgra(topRow, bitmap.width, bitmap.rows, bitmap.pitch,
+			fColorData, width, height)) {
+		return false;
+	}
+
+	fAdvanceX = int26p6_to_dbl(slot->advance.x) * scale;
+	fAdvanceY = int26p6_to_dbl(slot->advance.y) * scale;
+	if (fHinting) {
+		fAdvanceX = round(fAdvanceX);
+		fAdvanceY = round(fAdvanceY);
+	}
+	// a bitmap font has no unscaled advances (PrepareGlyph())
+	fPreciseAdvanceX = fSize > 0 ? fAdvanceX / fSize : 0;
+	fPreciseAdvanceY = fSize > 0 ? fAdvanceY / fSize : 0;
+	fInsetLeft = left;
+	fInsetRight = left + width - fAdvanceX;
+
+	fBounds.x1 = left;
+	fBounds.y1 = kFlipY ? -top : top - height + 1;
+	fBounds.x2 = left + width - 1;
+	fBounds.y2 = fBounds.y1 + height - 1;
+	fDataSize = size;
+	fDataType = glyph_data_color;
+	return true;
+}
