+/*!	The source pixels and their weights for each target pixel along one axis,
+	scaling <sourceSize> pixels to <targetSize>: a tent filter as wide as a
+	target pixel, so that shrinking averages all the source pixels a target
+	pixel covers, and growing interpolates between the nearest two.
+	\a _first and \a _weights get <targetSize> rows of <_taps> entries.
+*/
+static bool
+tent_weights(int sourceSize, int targetSize, int*& _first, float*& _weights,
+	int& _taps)
+{
+	double step = (double)sourceSize / targetSize;
+	double support = step > 1.0 ? step : 1.0;
+	int taps = (int)ceil(support) * 2 + 1;
+	int* first = new(std::nothrow) int[targetSize];
+	float* weights = new(std::nothrow) float[targetSize * taps];
+	if (first == NULL || weights == NULL) {
+		delete[] first;
+		delete[] weights;
+		return false;
+	}
+
+	for (int t = 0; t < targetSize; t++) {
+		double center = (t + 0.5) * step - 0.5;
+		int start = (int)ceil(center - support);
+		if (start < 0)
+			start = 0;
+		if (start > sourceSize - taps)
+			start = sourceSize > taps ? sourceSize - taps : 0;
+		first[t] = start;
+		float* row = weights + t * taps;
+		double sum = 0;
+		for (int i = 0; i < taps; i++) {
+			double weight = 0;
+			if (start + i < sourceSize) {
+				weight = 1.0 - fabs(start + i - center) / support;
+				if (weight < 0)
+					weight = 0;
+			}
+			row[i] = weight;
+			sum += weight;
+		}
+		if (sum <= 0) {
+			// a target pixel beyond the source's last: take the nearest
+			int nearest = (int)floor(center + 0.5);
+			nearest = nearest < start ? start : nearest;
+			nearest = nearest > sourceSize - 1 ? sourceSize - 1 : nearest;
+			row[nearest - start] = 1;
+			sum = 1;
+		}
+		for (int i = 0; i < taps; i++)
+			row[i] /= sum;
+	}
+
+	_first = first;
+	_weights = weights;
+	_taps = taps;
+	return true;
+}
+
+
+/*!	Scales premultiplied B_RGBA32 pixels (\a source the top row,
+	\a sourcePitch bytes from a row to the next) to \a target, rows of
+	\a targetWidth pixels without gaps.
+*/
+static bool
+scale_bgra(const uint8* source, int sourceWidth, int sourceHeight,
+	int sourcePitch, uint8* target, int targetWidth, int targetHeight)
+{
+	int* firstX;
+	float* weightsX;
+	int tapsX;
+	if (!tent_weights(sourceWidth, targetWidth, firstX, weightsX, tapsX))
+		return false;
+	ArrayDeleter<int> firstXDeleter(firstX);
+	ArrayDeleter<float> weightsXDeleter(weightsX);
+
+	int* firstY;
+	float* weightsY;
+	int tapsY;
+	if (!tent_weights(sourceHeight, targetHeight, firstY, weightsY, tapsY))
+		return false;
+	ArrayDeleter<int> firstYDeleter(firstY);
+	ArrayDeleter<float> weightsYDeleter(weightsY);
+
+	// across first: every source row, at the target's width
+	float* rows = new(std::nothrow) float[(size_t)sourceHeight * targetWidth
+		* 4];
+	if (rows == NULL)
+		return false;
+	ArrayDeleter<float> rowsDeleter(rows);
+
+	for (int y = 0; y < sourceHeight; y++) {
+		const uint8* sourceRow = source + (ssize_t)y * sourcePitch;
+		float* row = rows + (size_t)y * targetWidth * 4;
+		for (int x = 0; x < targetWidth; x++) {
+			const uint8* pixel = sourceRow + firstX[x] * 4;
+			const float* weight = weightsX + x * tapsX;
+			float b = 0, g = 0, r = 0, a = 0;
+			for (int i = 0; i < tapsX; i++, pixel += 4) {
+				if (weight[i] == 0)
+					continue;
+				b += pixel[0] * weight[i];
+				g += pixel[1] * weight[i];
+				r += pixel[2] * weight[i];
+				a += pixel[3] * weight[i];
+			}
+			row[x * 4] = b;
+			row[x * 4 + 1] = g;
+			row[x * 4 + 2] = r;
+			row[x * 4 + 3] = a;
+		}
+	}
+
+	// then down
+	for (int y = 0; y < targetHeight; y++) {
+		const float* weight = weightsY + y * tapsY;
+		uint8* targetRow = target + (size_t)y * targetWidth * 4;
+		for (int x = 0; x < targetWidth * 4; x++) {
+			const float* value = rows + (size_t)firstY[y] * targetWidth * 4 + x;
+			float sum = 0;
+			for (int i = 0; i < tapsY; i++, value += targetWidth * 4) {
+				if (weight[i] != 0)
+					sum += *value * weight[i];
+			}
+			int rounded = (int)(sum + 0.5f);
+			targetRow[x] = rounded > 255 ? 255 : rounded < 0 ? 0 : rounded;
+		}
+	}
+	return true;
+}
