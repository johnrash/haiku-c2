+/*!	Whether a character looks like an emoji (in colour) unless a variation
+	selector says otherwise: Unicode's Emoji_Presentation characters below
+	U+1F000 (emoji-data.txt), and everything from U+1F000 on that a colour
+	font has. (Some of the latter are text by default, such as U+1F321
+	THERMOMETER, but the black and white glyphs come from fonts of symbols
+	and the colour ones are what one expects.)
+*/
+inline bool
+GlyphLayoutEngine::IsEmojiPresentation(uint32 charCode)
+{
+	if (charCode >= 0x1f000)
+		return true;
+	if (charCode < 0x231a || charCode > 0x2b55)
+		return false;
+
+	static const uint16 kRanges[][2] = {
+		{ 0x231a, 0x231b }, { 0x23e9, 0x23ec }, { 0x23f0, 0x23f0 },
+		{ 0x23f3, 0x23f3 }, { 0x25fd, 0x25fe }, { 0x2614, 0x2615 },
+		{ 0x2648, 0x2653 }, { 0x267f, 0x267f }, { 0x2693, 0x2693 },
+		{ 0x26a1, 0x26a1 }, { 0x26aa, 0x26ab }, { 0x26bd, 0x26be },
+		{ 0x26c4, 0x26c5 }, { 0x26ce, 0x26ce }, { 0x26d4, 0x26d4 },
+		{ 0x26ea, 0x26ea }, { 0x26f2, 0x26f3 }, { 0x26f5, 0x26f5 },
+		{ 0x26fa, 0x26fa }, { 0x26fd, 0x26fd }, { 0x2705, 0x2705 },
+		{ 0x270a, 0x270b }, { 0x2728, 0x2728 }, { 0x274c, 0x274c },
+		{ 0x274e, 0x274e }, { 0x2753, 0x2755 }, { 0x2757, 0x2757 },
+		{ 0x2795, 0x2797 }, { 0x27b0, 0x27b0 }, { 0x27bf, 0x27bf },
+		{ 0x2b1b, 0x2b1c }, { 0x2b50, 0x2b50 }, { 0x2b55, 0x2b55 },
+	};
+	for (size_t i = 0; i < B_COUNT_OF(kRanges); i++) {
+		if (charCode < kRanges[i][0])
+			return false;
+		if (charCode <= kRanges[i][1])
+			return true;
+	}
+	return false;
+}
