+/*!	Blends a row of a colour glyph's premultiplied pixels over the
+	destination's, for renderer_region::for_each_clipped_hspan().
+*/
+class ColorSpanBlender {
+public:
+	ColorSpanBlender(pixfmt& pixelFormat, const uint8* pixels,
+			const uint8* covers, uint8 opacity)
+		:
+		fPixelFormat(pixelFormat),
+		fPixels(pixels),
+		fCovers(covers),
+		fOpacity(opacity)
+	{
+	}
+
+	void operator()(int x, int y, int length, int skip)
+	{
+		uint8* target = fPixelFormat.row_ptr(y) + x * 4;
+		const uint8* source = fPixels + skip * 4;
+		const uint8* covers = fCovers != NULL ? fCovers + skip : NULL;
+		for (; length > 0; length--, target += 4, source += 4) {
+			uint32 cover = covers != NULL ? *covers++ : fOpacity;
+			uint32 alpha = source[3];
+			if (alpha == 0 || cover == 0)
+				continue;
+			if (cover == 255 && alpha == 255) {
+				target[0] = source[0];
+				target[1] = source[1];
+				target[2] = source[2];
+				target[3] = 255;
+				continue;
+			}
+			uint32 blue = source[0];
+			uint32 green = source[1];
+			uint32 red = source[2];
+			if (cover != 255) {
+				blue = _Divide255(blue * cover);
+				green = _Divide255(green * cover);
+				red = _Divide255(red * cover);
+				alpha = _Divide255(alpha * cover);
+			}
+			uint32 rest = 255 - alpha;
+			target[0] = blue + _Divide255(target[0] * rest);
+			target[1] = green + _Divide255(target[1] * rest);
+			target[2] = red + _Divide255(target[2] * rest);
+			target[3] = alpha + _Divide255(target[3] * rest);
+		}
+	}
+
+private:
+	static inline uint32 _Divide255(uint32 value)
+	{
+		return ((value + 128) * 257) >> 16;
+	}
+
+	pixfmt&			fPixelFormat;
+	const uint8*	fPixels;
+	const uint8*	fCovers;
+	uint8			fOpacity;
+};
+
+
+/*!	Draws a colour glyph (an emoji's picture), its top left pixel at
+	\a left, \a top, through the clipping region and the alpha mask. The
+	painting modes blend its pixels over the destination's (B_OP_ALPHA with
+	the high colour's alpha); the others draw its shape, as a glyph's.
+*/
+void
+AGGTextRenderer::_DrawColorGlyph(const GlyphCache* glyph, int left, int top)
+{
+	const agg::rect_i& r = glyph->bounds;
+	int width = r.x2 - r.x1 + 1;
+	int height = r.y2 - r.y1 + 1;
+	if (width <= 0 || height <= 0)
+		return;
+
+	uint8 opacity = 255;
+	bool paint = true;
+	switch (fDrawingMode) {
+		case B_OP_COPY:
+		case B_OP_OVER:
+			break;
+		case B_OP_ALPHA:
+			opacity = fSolidRenderer.color().a;
+			break;
+		default:
+			paint = false;
+			break;
+	}
+	if (!paint)
+		fColorCovers.resize(width);
+
+	for (int row = 0; row < height; row++) {
+		int y = top + row;
+		const uint8* pixels = glyph->data + (size_t)row * width * 4;
+		const uint8* covers = NULL;
+		if (fMaskedScanline != NULL) {
+			fMaskedScanline->reset(left, left + width - 1);
+			fMaskedScanline->add_span(left, width, opacity);
+			fMaskedScanline->finalize(y);
+			covers = fMaskedScanline->begin()->covers;
+		}
+
+		if (paint) {
+			ColorSpanBlender blender(fBaseRenderer.ren(), pixels, covers,
+				opacity);
+			fBaseRenderer.for_each_clipped_hspan(left, y, width, blender);
+		} else {
+			uint8* shape = fColorCovers.data();
+			for (int i = 0; i < width; i++) {
+				uint32 cover = covers != NULL ? covers[i] : opacity;
+				shape[i] = (pixels[i * 4 + 3] * cover + 127) / 255;
+			}
+			fBaseRenderer.blend_solid_hspan(left, y, width,
+				fSolidRenderer.color(), shape);
+		}
+	}
+}
+
+
 BRect
 AGGTextRenderer::RenderString(const char* string, uint32 length,
 	const BPoint& baseLine, const BRect& clippingFrame, bool dryRun,
