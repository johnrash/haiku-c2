+		//--------------------------------------------------------------------
+		// Calls function(x, y, len, skip) for each part of the span inside
+		// the clipping region, in the base renderer's coordinates; skip:
+		// the span's pixels before the part.
+		template<class Function>
+		void for_each_clipped_hspan(int x, int y, int len, Function& function)
+		{
+			translate_to_base_ren(x, y);
+
+			first_clip_box();
+			do
+			{
+				if (y < m_ren.ymin() || y > m_ren.ymax())
+					continue;
+				int x1 = x > m_ren.xmin() ? x : m_ren.xmin();
+				int x2 = x + len - 1;
+				if (x2 > m_ren.xmax())
+					x2 = m_ren.xmax();
+				if (x1 <= x2)
+					function(x1, y, x2 - x1 + 1, x1 - x);
+			}
+			while(next_clip_box());
+		}
+
 		//--------------------------------------------------------------------
 		void blend_solid_hspan(int x, int y, int len,
 							   const color_type& c, const cover_type* covers)
