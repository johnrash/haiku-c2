diff --git a/src/servers/app/drawing/Painter/bitmap_painter/painter_bilinear_scale_neon.c b/src/servers/app/drawing/Painter/bitmap_painter/painter_bilinear_scale_neon.c
new file mode 100644
index 0000000000..13efd7f8d8
--- /dev/null
+++ b/src/servers/app/drawing/Painter/bitmap_painter/painter_bilinear_scale_neon.c
@@ -0,0 +1,69 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+// The build includes GCC's headers like its own, with -Werror.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wsign-compare"
+#pragma GCC diagnostic ignored "-Wmissing-braces"
+#include <arm_neon.h>
+#pragma GCC diagnostic pop
+
+#include <SupportDefs.h>
+
+
+void bilinear_scale_xloop_neon(const uint8* src, void* dst, void* xWeights,
+	uint32 xmin, uint32 xmax, uint32 wTop, uint32 srcBPR);
+
+
+// as BitmapPainterPrivate::FilterInfo
+typedef struct {
+	uint16	index;	// byte offset of the left pixel in the source row
+	uint16	weight;	// of the left pixel, 0-255
+} FilterWeight;
+
+
+/*!	One row of bilinear scaling for 32 bit pixels, as
+	BilinearDefault::DrawToClipRect() computes it for the pixels that need
+	both neighbours (and as painter_bilinear_scale.nasm on x86, which also
+	writes the fourth byte): for each channel
+	((left * wLeft + right * wRight) * wTop
+		+ (bottomLeft * wLeft + bottomRight * wRight) * wBottom) >> 16.
+*/
+void
+bilinear_scale_xloop_neon(const uint8* src, void* dst, void* xWeights,
+	uint32 xmin, uint32 xmax, uint32 wTop, uint32 srcBPR)
+{
+	const FilterWeight* weights = (const FilterWeight*)xWeights;
+	uint32* d = (uint32*)dst;
+	const uint16 wBottom = 255 - wTop;
+
+	for (uint32 x = xmin; x <= xmax; x++) {
+		const uint8* s = src + weights[x].index;
+		const uint32 wLeft = weights[x].weight;
+		const uint32 wRight = 255 - wLeft;
+
+		// left and right pixel of both rows
+		uint8x8_t top = vld1_u8(s);
+		uint8x8_t bottom = vld1_u8(s + srcBPR);
+		// wLeft for the left pixel's bytes, wRight for the right one's
+		uint8x8_t w = vcreate_u8((uint64)(wRight * 0x01010101u) << 32
+			| wLeft * 0x01010101u);
+
+		uint16x8_t topProducts = vmull_u8(top, w);
+		uint16x8_t bottomProducts = vmull_u8(bottom, w);
+		uint16x4_t topSum = vadd_u16(vget_low_u16(topProducts),
+			vget_high_u16(topProducts));
+		uint16x4_t bottomSum = vadd_u16(vget_low_u16(bottomProducts),
+			vget_high_u16(bottomProducts));
+
+		uint32x4_t sum = vmull_n_u16(topSum, wTop);
+		sum = vmlal_n_u16(sum, bottomSum, wBottom);
+		uint16x4_t result = vshrn_n_u32(sum, 16);
+		uint8x8_t bytes = vmovn_u16(vcombine_u16(result, result));
+		vst1_lane_u32(d, vreinterpret_u32_u8(bytes), 0);
+		d++;
+	}
+}
