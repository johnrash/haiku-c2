From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Thu, 29 Oct 2026 02:13:16 -0400
Subject: [PATCH 044/342] app_server: Advanced SIMD bilinear scaling on arm64

The bilinear row loop that x86 has in MMX/SSE assembly
(bilinear_scale_xloop_mmxsse), in C with arm_neon.h intrinsics: same
arithmetic, so the results equal the default C version's. arm64 always
takes the SIMD path for 32 bit copies, like x86 with MMX and SSE, so it
also replaces the low filter ratio version at scales 1.5, 2, 2.5 and 3
(which rounds pixels on the source grid differently).

1280x720 to 1600x900 on the ODROID-C2: 41.5 -> 33.1 ms, the same result
byte for byte; 1919x1079: 58.9 -> 46.0 ms.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/servers/app/drawing/Painter/Jamfile       |  2 +
 .../bitmap_painter/DrawBitmapBilinear.h       | 23 +++++--
 .../painter_bilinear_scale_neon.c             | 69 +++++++++++++++++++
 3 files changed, 89 insertions(+), 5 deletions(-)
 create mode 100644 src/servers/app/drawing/Painter/bitmap_painter/painter_bilinear_scale_neon.c

diff --git a/src/servers/app/drawing/Painter/Jamfile b/src/servers/app/drawing/Painter/Jamfile
index 1a39071a18..5a159ee5ad 100644
--- a/src/servers/app/drawing/Painter/Jamfile
+++ b/src/servers/app/drawing/Painter/Jamfile
@@ -16,6 +16,8 @@ SEARCH_SOURCE += [ FDirName $(SUBDIR) bitmap_painter ] ;
 local PAINTER_ARCH_SOURCES ;
 if $(TARGET_ARCH) = x86 {
 	PAINTER_ARCH_SOURCES = painter_bilinear_scale.nasm ;
+} else if $(TARGET_ARCH) = arm64 {
+	PAINTER_ARCH_SOURCES = painter_bilinear_scale_neon.c ;
 }
 
 Includes [ FGristFiles AGGTextRenderer.cpp BitmapPainter.cpp Painter.cpp ]
diff --git a/src/servers/app/drawing/Painter/bitmap_painter/DrawBitmapBilinear.h b/src/servers/app/drawing/Painter/bitmap_painter/DrawBitmapBilinear.h
index 6c4f42e6cf..ea866d473c 100644
--- a/src/servers/app/drawing/Painter/bitmap_painter/DrawBitmapBilinear.h
+++ b/src/servers/app/drawing/Painter/bitmap_painter/DrawBitmapBilinear.h
@@ -17,8 +17,17 @@
 extern "C" {
 	void bilinear_scale_xloop_mmxsse(const uint8* src, void* dst,
 		void* xWeights, uint32 xmin, uint32 xmax, uint32 wTop, uint32 srcBPR);
+	void bilinear_scale_xloop_neon(const uint8* src, void* dst,
+		void* xWeights, uint32 xmin, uint32 xmax, uint32 wTop, uint32 srcBPR);
 }
 
+#if defined(__i386__)
+#	define BILINEAR_SCALE_XLOOP	bilinear_scale_xloop_mmxsse
+#elif defined(__aarch64__)
+	// Advanced SIMD is part of every AArch64 CPU
+#	define BILINEAR_SCALE_XLOOP	bilinear_scale_xloop_neon
+#endif
+
 
 extern uint32 gSIMDFlags;
 
@@ -406,7 +415,7 @@ struct BilinearLowFilterRatio :
 };
 
 
-#ifdef __i386__
+#ifdef BILINEAR_SCALE_XLOOP
 
 struct BilinearSimd : DrawBitmapBilinearOptimized<BilinearSimd> {
 	void DrawToClipRect(int32 xIndexL, int32 xIndexR, int32 y1, int32 y2)
@@ -433,7 +442,7 @@ struct BilinearSimd : DrawBitmapBilinearOptimized<BilinearSimd> {
 			// buffer handle for destination to be incremented per
 			// pixel
 			uint8* d = fDestination;
-			bilinear_scale_xloop_mmxsse(src, fDestination, fWeightsX, xIndexL,
+			BILINEAR_SCALE_XLOOP(src, fDestination, fWeightsX, xIndexL,
 				xIndexMax, wTop, fSourceBytesPerRow);
 			// increase pointer by processed pixels
 			d += (xIndexMax - xIndexL + 1) * 4;
@@ -476,7 +485,7 @@ struct BilinearSimd : DrawBitmapBilinearOptimized<BilinearSimd> {
 	}
 };
 
-#endif	// __i386__
+#endif	// BILINEAR_SCALE_XLOOP
 
 
 template<class ColorType, class DrawMode>
@@ -599,8 +608,12 @@ struct DrawBitmapBilinear {
 
 		if (typeid(ColorType) == typeid(ColorTypeRgb)
 			&& typeid(DrawMode) == typeid(DrawModeCopy)) {
+#if defined(__aarch64__)
+			if (true)
+#else
