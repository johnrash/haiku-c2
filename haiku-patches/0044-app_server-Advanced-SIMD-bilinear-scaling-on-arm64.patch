 			if ((gSIMDFlags & neededSIMDFlags) == neededSIMDFlags)
+#endif
 				codeSelect = kUseSIMDVersion;
 			else {
 				if (scaleX == scaleY && (scaleX == 1.5 || scaleX == 2.0
@@ -627,7 +640,7 @@ struct DrawBitmapBilinear {
 				break;
 			}
 
-#ifdef __i386__
+#ifdef BILINEAR_SCALE_XLOOP
 			case kUseSIMDVersion:
 			{
 				BilinearSimd bilinearPainter;
@@ -635,7 +648,7 @@ struct DrawBitmapBilinear {
 					filterData);
 				break;
 			}
-#endif	// __i386__
+#endif	// BILINEAR_SCALE_XLOOP
 		}
 
