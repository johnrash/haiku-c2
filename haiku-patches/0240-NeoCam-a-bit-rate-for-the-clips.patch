From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Sun, 1 Nov 2026 18:38:35 -0500
Subject: [PATCH 240/342] NeoCam: a bit rate for the clips

"Clip bit rate" in the Capture tab: Auto (the encoder's constant
quality, as before) or 1, 2, 4, 8 or 16 Mbit/s, which VideoRecorder asks
the video encoder for (encode_parameters' avg_field_size).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/apps/codycam/VideoRecorder.cpp   | 12 ++++++++-
 src/apps/codycam/VideoRecorder.h     |  3 ++-
 src/apps/neocam/CameraConsumer.cpp   |  4 +--
 src/apps/neocam/CameraConsumer.h     |  3 ++-
 src/apps/neocam/CameraController.cpp |  3 ++-
 src/apps/neocam/CameraController.h   |  3 ++-
 src/apps/neocam/MainWindow.cpp       | 37 +++++++++++++++++++++++++---
 src/apps/neocam/MainWindow.h         |  1 +
 8 files changed, 56 insertions(+), 10 deletions(-)

diff --git a/src/apps/codycam/VideoRecorder.cpp b/src/apps/codycam/VideoRecorder.cpp
index 75da0d42a3..d2fc5480a9 100644
--- a/src/apps/codycam/VideoRecorder.cpp
+++ b/src/apps/codycam/VideoRecorder.cpp
@@ -69,7 +69,8 @@ VideoRecorder::~VideoRecorder()
 
 status_t
 VideoRecorder::Start(const char* path, uint32 width, uint32 height,
-	uint32 bytesPerRow, float frameRate, const media_multi_audio_format* audio)
+	uint32 bytesPerRow, float frameRate, const media_multi_audio_format* audio,
+	int32 bitRate)
 {
 	if (fFile != NULL)
 		return EALREADY;
@@ -138,6 +139,15 @@ VideoRecorder::Start(const char* path, uint32 width, uint32 height,
 		}
 		if (status == B_OK) {
 			fCodecName = codec.short_name;
+			if (bitRate > 0) {
+				// as bytes a picture
+				encode_parameters parameters;
+				memset(&parameters, 0, sizeof(parameters));
+				fTrack->GetEncodeParameters(&parameters);
+				parameters.avg_field_size
+					= (int32)(bitRate / 8 / frameRate);
+				fTrack->SetEncodeParameters(&parameters);
+			}
 			break;
 		}
 		delete fFile;
diff --git a/src/apps/codycam/VideoRecorder.h b/src/apps/codycam/VideoRecorder.h
index 511b24347e..3469d5ed10 100644
--- a/src/apps/codycam/VideoRecorder.h
+++ b/src/apps/codycam/VideoRecorder.h
@@ -37,7 +37,8 @@ public:
 									uint32 height, uint32 bytesPerRow,
 									float frameRate,
 									const media_multi_audio_format* audio
-										= NULL);
+										= NULL,
+									int32 bitRate = 0);
 			void				AddFrame(const void* bits, bigtime_t when);
 			void				AddAudio(const void* data, size_t size);
 									// in the format Start() was given;
diff --git a/src/apps/neocam/CameraConsumer.cpp b/src/apps/neocam/CameraConsumer.cpp
index 40145f49be..01faf81061 100644
--- a/src/apps/neocam/CameraConsumer.cpp
+++ b/src/apps/neocam/CameraConsumer.cpp
@@ -85,7 +85,7 @@ CameraConsumer::TakeStill(const char* trigger)
 
 status_t
 CameraConsumer::StartRecording(const char* path, float frameRate,
-	const media_multi_audio_format* audio)
+	const media_multi_audio_format* audio, int32 bitRate)
 {
 	BAutolock _(fLock);
 	if (fRecorder != NULL)
@@ -95,7 +95,7 @@ CameraConsumer::StartRecording(const char* path, float frameRate,
 
 	VideoRecorder* recorder = new VideoRecorder();
 	status_t status = recorder->Start(path, Width(), Height(),
-		fBitmaps[0]->BytesPerRow(), frameRate, audio);
+		fBitmaps[0]->BytesPerRow(), frameRate, audio, bitRate);
 	if (status != B_OK) {
 		delete recorder;
 		return status;
diff --git a/src/apps/neocam/CameraConsumer.h b/src/apps/neocam/CameraConsumer.h
index ff55b0f8cb..6df6e781c0 100644
