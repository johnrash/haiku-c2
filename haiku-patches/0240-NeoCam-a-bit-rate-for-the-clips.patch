 					if (sound)
diff --git a/src/apps/neocam/CameraController.h b/src/apps/neocam/CameraController.h
index 0ebe621b05..bef3b9ed9b 100644
--- a/src/apps/neocam/CameraController.h
+++ b/src/apps/neocam/CameraController.h
@@ -37,7 +37,8 @@ public:
 										// "quiet" (the sender waits)
 		kMsgGetWeb			= 'gweb',	// the window gets kMsgCameraWeb
 		kMsgTakeStill		= 'ctst',	// "trigger"
-		kMsgStartRecording	= 'cstr',	// "path", "fps", "trigger", "sound";
+		kMsgStartRecording	= 'cstr',	// "path", "fps", "trigger", "sound",
+										// "bit rate";
 										// the window hears how it went
 		kMsgStopRecording	= 'cstp',	// the clip goes to the capture
 										// manager
diff --git a/src/apps/neocam/MainWindow.cpp b/src/apps/neocam/MainWindow.cpp
index 320a40e918..4753900f21 100644
--- a/src/apps/neocam/MainWindow.cpp
+++ b/src/apps/neocam/MainWindow.cpp
@@ -58,6 +58,8 @@ static const bigtime_t kPulseInterval = 250000;
 // second (MPEG-4 on four Cortex-A53 cores: 1920x1080 at 15 frames a second)
 static const float kEncodePixelsPerSecond = 32e6f;
 static const float kClipRates[] = { 30, 25, 20, 15, 10, 5, 2, 1 };
+// Mbit/s; "Auto" is the encoder's own quality, whatever the size
+static const int32 kClipBitRates[] = { 1, 2, 4, 8, 16 };
 
 
 enum {
@@ -585,6 +587,23 @@ MainWindow::_CaptureTab()
 	BMenuField* rateField = new BMenuField("rate",
 		B_TRANSLATE("Clip frame rate:"), fClipRateMenu);
 
+	fClipBitRateMenu = new BPopUpMenu(B_TRANSLATE("Auto"));
+	BMessage* bitRate = new BMessage(kMsgSettingChanged);
+	bitRate->AddInt32("bit rate", 0);
+	fClipBitRateMenu->AddItem(new BMenuItem(
+		B_TRANSLATE("Auto (constant quality)"), bitRate));
+	for (size_t i = 0; i < B_COUNT_OF(kClipBitRates); i++) {
+		BString label;
+		label.SetToFormat(B_TRANSLATE("%" B_PRId32 " Mbit/s"),
+			kClipBitRates[i]);
+		bitRate = new BMessage(kMsgSettingChanged);
+		bitRate->AddInt32("bit rate", kClipBitRates[i] * 1000000);
+		fClipBitRateMenu->AddItem(new BMenuItem(label, bitRate));
+	}
+	fClipBitRateMenu->ItemAt(0)->SetMarked(true);
+	BMenuField* bitRateField = new BMenuField("bit rate",
+		B_TRANSLATE("Clip bit rate:"), fClipBitRateMenu);
+
 	fSoundBox = new BCheckBox("sound",
 		B_TRANSLATE("Record sound (from the audio input)"),
 		new BMessage(kMsgSettingChanged));
@@ -605,9 +624,10 @@ MainWindow::_CaptureTab()
 			.AddGlue()
 		.End()
 		.AddMenuField(rateField, 0, 2)
-		.Add(fSoundBox, 1, 3)
-		.Add(codec, 1, 4)
-		.AddGlue(0, 5, 2);
+		.AddMenuField(bitRateField, 0, 3)
+		.Add(fSoundBox, 1, 4)
+		.Add(codec, 1, 5)
+		.AddGlue(0, 6, 2);
 	return view;
 }
 
@@ -820,6 +840,11 @@ MainWindow::_ApplySettings(const BMessage& settings)
 		if (item->Message()->GetFloat("fps", -1) == rate)
 			item->SetMarked(true);
 	}
+	int32 bitRate = settings.GetInt32("clip bit rate", 0);
+	for (int32 i = 0; BMenuItem* item = fClipBitRateMenu->ItemAt(i); i++) {
+		if (item->Message()->GetInt32("bit rate", -1) == bitRate)
+			item->SetMarked(true);
+	}
 
 	fScheduleBox->SetValue(settings.GetBool("schedule", false));
 	fScheduleEvery->SetValue(settings.GetInt32("schedule every", 5));
@@ -868,6 +893,9 @@ MainWindow::GetSettings(BMessage& settings)
 	item = fClipRateMenu->FindMarked();
 	settings.AddFloat("clip fps",
 		item != NULL ? item->Message()->GetFloat("fps", 0) : 0);
+	item = fClipBitRateMenu->FindMarked();
+	settings.AddInt32("clip bit rate",
+		item != NULL ? item->Message()->GetInt32("bit rate", 0) : 0);
 
 	settings.AddBool("schedule", fScheduleBox->Value() == B_CONTROL_ON);
 	settings.AddInt32("schedule every", fScheduleEvery->Value());
@@ -963,6 +991,9 @@ MainWindow::_StartClip(const char* trigger)
 	BMessage start(CameraController::kMsgStartRecording);
 	start.AddString("path", path);
 	start.AddFloat("fps", _ClipFrameRate());
+	BMenuItem* bitRateItem = fClipBitRateMenu->FindMarked();
+	start.AddInt32("bit rate", bitRateItem != NULL
+		? bitRateItem->Message()->GetInt32("bit rate", 0) : 0);
 	start.AddString("trigger", trigger);
 	start.AddBool("sound", fSoundBox->Value() == B_CONTROL_ON);
 	BMessenger(fController).SendMessage(&start);
