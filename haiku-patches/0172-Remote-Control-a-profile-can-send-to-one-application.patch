+
+/*!	The application a profile's commands go to: its target (started when
+	it isn't running and start is set: the press itself is then lost), or
+	the active application. Called with fLock held.
+*/
+bool
+RemoteControlDevice::_TargetApp(const BString& target, bool start,
+	BMessenger& app)
+{
+	if (target.IsEmpty()) {
+		app_info info;
+		if (be_roster->GetActiveAppInfo(&info) != B_OK)
+			return false;
+		app = BMessenger(NULL, info.team);
+		return app.IsValid();
+	}
+	app = BMessenger(target.String());
+	if (app.IsValid())
+		return true;
+	if (start)
+		be_roster->Launch(target.String());
+	return false;
+}
+
+
+/*!	The window of the target application that keystrokes go to: its first,
+	as hey's "Window 0", asked for once while the application runs. The
+	messenger targets the window's preferred handler (its focus view), as
+	keys from the keyboard do. Called with fLock held.
+*/
+bool
+RemoteControlDevice::_TargetWindow(const BString& target, bool start,
+	BMessenger& window)
+{
+	BMessenger app;
+	if (!_TargetApp(target, start, app))
+		return false;
+	if (fWindow.IsValid() && fWindowTeam == app.Team()) {
+		window = fWindow;
+		return true;
+	}
+
+	BMessage query(B_GET_PROPERTY);
+	query.AddSpecifier("Messenger");
+	query.AddSpecifier("Window", (int32)0);
+	BMessage reply;
+	BMessenger handler;
+	if (app.SendMessage(&query, &reply, kWindowQueryTimeout,
+			kWindowQueryTimeout) != B_OK
+		|| reply.FindMessenger("result", &handler) != B_OK)
+		return false;
+	BMessenger::Private privateHandler(handler);
+	BMessenger::Private(fWindow).SetTo(privateHandler.Team(),
+		privateHandler.Port(), B_PREFERRED_TOKEN);
+	fWindowTeam = app.Team();
+	window = fWindow;
+	return window.IsValid();
+}
+
+
+/*!	Sends a button's command, without waiting for it or its reply. Called
+	with fLock held.
+*/
+void
+RemoteControlDevice::_SendScript(const BString& target, bool start,
+	const BString& script)
+{
+	BMessage message;
+	if (RemoteControl::ParseScript(script, message) != B_OK)
+		return;
+			// the preferences don't save commands they can't read
+	BMessenger app;
+	if (_TargetApp(target, start, app))
+		app.SendMessage(&message, BMessenger(), 0);
 }
 
 
