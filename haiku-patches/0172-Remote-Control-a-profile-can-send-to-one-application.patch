+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef SCRIPT_COMMAND_H
+#define SCRIPT_COMMAND_H
+
+
+#include <String.h>
+
+
+class BMessage;
+
+
+namespace RemoteControl {
+
+
+/*!	A scripting command written as for hey, made into the message to send
+	to an application:
+		Bply of Window 0
+		do TogglePlaying of Window 0
+		set Volume of Window 0 to 0.5
+		set Seek of Window 0 to int64(5000000)
+		Bscn of Window 0 with direction=int32(1)
+	A verb (do, get, set, count, create, delete) and the property, or a
+	message code of four characters; then "of" and more specifiers (a
+	property, with an index or a "name"); then "to" and the value; then
+	"with" and fields, joined by "and". Values are numbers (int32, float
+	with a point), true and false, "strings", or typed: int8() int16()
+	int32() int64() float() double() bool() string(). On failure, error
+	says what is wrong.
+*/
+status_t ParseScript(const char* text, BMessage& message,
+	BString* error = NULL);
+
+
+}	// namespace RemoteControl
+
+
+#endif	// SCRIPT_COMMAND_H
