diff --git a/src/add-ons/input_server/devices/remote_control/ScriptCommand.cpp b/src/add-ons/input_server/devices/remote_control/ScriptCommand.cpp
new file mode 100644
index 0000000000..2c8555ec0a
--- /dev/null
+++ b/src/add-ons/input_server/devices/remote_control/ScriptCommand.cpp
@@ -0,0 +1,336 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "ScriptCommand.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <AppDefs.h>
+#include <Message.h>
+#include <ObjectList.h>
+
+
+namespace RemoteControl {
+
+
+namespace {
+
+
+struct Verb {
+	const char*	name;
+	uint32		what;
+};
+
+const Verb kVerbs[] = {
+	{ "do", B_EXECUTE_PROPERTY },
+	{ "get", B_GET_PROPERTY },
+	{ "set", B_SET_PROPERTY },
+	{ "count", B_COUNT_PROPERTIES },
+	{ "create", B_CREATE_PROPERTY },
+	{ "delete", B_DELETE_PROPERTY }
+};
+
+
+/*!	The words of a command: runs of characters between white space, where
+	a "quoted part" may hold spaces. The quotes stay; Unquote() removes
+	them.
+*/
+status_t
+Split(const char* text, BObjectList<BString, true>& words, BString* error)
+{
+	const char* c = text;
+	while (true) {
+		while (isspace((uint8)*c))
+			c++;
+		if (*c == '\0')
+			return B_OK;
+		BString* word = new BString;
+		words.AddItem(word);
+		while (*c != '\0' && !isspace((uint8)*c)) {
+			if (*c != '"') {
+				*word << *c++;
+				continue;
+			}
+			*word << *c++;
+			while (*c != '\0' && *c != '"') {
+				if (*c == '\\' && c[1] != '\0')
+					*word << *c++;
+				*word << *c++;
+			}
+			if (*c != '"') {
+				if (error != NULL)
+					*error = "a quote is not closed";
+				return B_BAD_VALUE;
+			}
+			*word << *c++;
+		}
+	}
+}
+
+
+bool
+IsQuoted(const BString& word)
+{
+	return word.Length() >= 2 && word[0] == '"'
+		&& word[word.Length() - 1] == '"';
+}
+
+
+BString
+Unquote(const BString& word)
+{
+	if (!IsQuoted(word))
+		return word;
+	BString text;
+	for (int32 i = 1; i < word.Length() - 1; i++) {
+		if (word[i] == '\\' && i + 1 < word.Length() - 1)
+			i++;
+		text << word[i];
+	}
+	return text;
+}
+
+
+bool
+IsKeyword(const BString& word)
+{
+	return word.ICompare("of") == 0 || word.ICompare("to") == 0
+		|| word.ICompare("with") == 0 || word.ICompare("and") == 0;
+}
+
+
+bool
+ParseInteger(const BString& text, int64& value)
+{
+	if (text.IsEmpty())
+		return false;
+	char* end;
+	errno = 0;
+	value = strtoll(text.String(), &end, 0);
+	return *end == '\0' && errno == 0;
+}
+
+
+bool
+ParseReal(const BString& text, double& value)
+{
+	if (text.IsEmpty())
+		return false;
+	char* end;
+	errno = 0;
+	value = strtod(text.String(), &end);
+	return *end == '\0' && errno == 0;
+}
+
+
+/*!	Adds a value written in the command to the message as field. */
+status_t
+AddValue(BMessage& message, const char* field, const BString& word,
+	BString* error)
+{
+	if (IsQuoted(word))
+		return message.AddString(field, Unquote(word));
+
+	// typed: int32(5)
+	int32 open = word.FindFirst('(');
+	if (open > 0 && word[word.Length() - 1] == ')') {
+		BString type;
+		word.CopyInto(type, 0, open);
+		BString text;
+		word.CopyInto(text, open + 1, word.Length() - open - 2);
+		text = Unquote(text);
+		int64 integer;
+		double real;
+		if (type == "string")
+			return message.AddString(field, text);
+		if (type == "bool") {
+			if (text == "true" || text == "1")
+				return message.AddBool(field, true);
+			if (text == "false" || text == "0")
+				return message.AddBool(field, false);
+		} else if (type == "int8" && ParseInteger(text, integer)
+			&& integer >= INT8_MIN && integer <= INT8_MAX) {
+			return message.AddInt8(field, (int8)integer);
+		} else if (type == "int16" && ParseInteger(text, integer)
+			&& integer >= INT16_MIN && integer <= INT16_MAX) {
+			return message.AddInt16(field, (int16)integer);
+		} else if (type == "int32" && ParseInteger(text, integer)
+			&& integer >= INT32_MIN && integer <= INT32_MAX) {
+			return message.AddInt32(field, (int32)integer);
+		} else if (type == "int64" && ParseInteger(text, integer)) {
+			return message.AddInt64(field, integer);
+		} else if (type == "float" && ParseReal(text, real)) {
+			return message.AddFloat(field, (float)real);
+		} else if (type == "double" && ParseReal(text, real)) {
+			return message.AddDouble(field, real);
+		}
+		if (error != NULL) {
+			*error = "not a value: ";
+			*error << word;
+		}
+		return B_BAD_VALUE;
+	}
+
+	if (word == "true" || word == "false")
+		return message.AddBool(field, word == "true");
+	int64 integer;
+	if (ParseInteger(word, integer)) {
+		if (integer >= INT32_MIN && integer <= INT32_MAX)
+			return message.AddInt32(field, (int32)integer);
+		return message.AddInt64(field, integer);
+	}
+	double real;
+	if (ParseReal(word, real))
+		return message.AddFloat(field, (float)real);
+	return message.AddString(field, word);
+}
+
+
+}	// namespace
+
+
+status_t
+ParseScript(const char* text, BMessage& message, BString* error)
+{
+	message.MakeEmpty();
+	BObjectList<BString, true> words(8);
+	status_t status = Split(text, words, error);
+	if (status != B_OK)
+		return status;
+	if (words.IsEmpty()) {
+		if (error != NULL)
+			*error = "the command is empty";
+		return B_BAD_VALUE;
+	}
+
+	int32 index = 0;
+	const BString& first = *words.ItemAt(index++);
+	bool isVerb = false;
+	for (size_t i = 0; i < sizeof(kVerbs) / sizeof(kVerbs[0]); i++) {
+		if (first.ICompare(kVerbs[i].name) == 0) {
+			message.what = kVerbs[i].what;
+			isVerb = true;
+		}
+	}
+	if (!isVerb) {
+		// a message code: Bply, or 'Bply'
+		BString code(first);
+		if (code.Length() == 6 && code[0] == '\'' && code[5] == '\'')
+			code.Remove(5, 1).Remove(0, 1);
+		if (code.Length() != 4) {
+			if (error != NULL) {
+				*error = "\"";
+				*error << first << "\" is neither a verb (do, get, set, count, "
+					"create, delete) nor a code of four characters";
+			}
+			return B_BAD_VALUE;
+		}
+		message.what = (uint32)(uint8)code[0] << 24
+			| (uint32)(uint8)code[1] << 16 | (uint32)(uint8)code[2] << 8
+			| (uint8)code[3];
+	}
+
+	// the specifiers: after a verb its property comes first; after a code,
+	// they start with "of". The last one written is resolved first.
+	bool wantSpecifier = isVerb;
+	while (index < words.CountItems()) {
+		const BString& word = *words.ItemAt(index);
+		if (!wantSpecifier) {
+			if (word.ICompare("of") != 0)
+				break;
+			wantSpecifier = true;
+			index++;
+			continue;
+		}
+		if (IsKeyword(word) || IsQuoted(word)) {
+			if (error != NULL) {
+				*error = "a property is missing before \"";
+				*error << word << "\"";
+			}
+			return B_BAD_VALUE;
+		}
+		BString property(word);
+		index++;
+		int64 number;
+		if (index < words.CountItems()
+			&& ParseInteger(*words.ItemAt(index), number)
+			&& number >= 0 && number <= INT32_MAX) {
+			message.AddSpecifier(property, (int32)number);
+			index++;
+		} else if (index < words.CountItems()
+			&& IsQuoted(*words.ItemAt(index))) {
+			message.AddSpecifier(property, Unquote(*words.ItemAt(index)));
+			index++;
+		} else
+			message.AddSpecifier(property);
+		wantSpecifier = false;
+	}
+	if (wantSpecifier) {
+		if (error != NULL)
+			*error = "a property is missing at the end";
+		return B_BAD_VALUE;
+	}
+
+	if (index < words.CountItems()
+		&& words.ItemAt(index)->ICompare("to") == 0) {
+		if (++index >= words.CountItems()) {
+			if (error != NULL)
+				*error = "the value after \"to\" is missing";
+			return B_BAD_VALUE;
+		}
+		status = AddValue(message, "data", *words.ItemAt(index++), error);
+		if (status != B_OK)
+			return status;
+	}
+
+	if (index < words.CountItems()
+		&& words.ItemAt(index)->ICompare("with") == 0) {
+		index++;
+		while (true) {
+			if (index >= words.CountItems()) {
+				if (error != NULL)
+					*error = "a field is missing after \"with\" or \"and\"";
+				return B_BAD_VALUE;
+			}
+			const BString& field = *words.ItemAt(index++);
+			int32 equals = field.FindFirst('=');
+			if (equals <= 0) {
+				if (error != NULL) {
+					*error = "\"";
+					*error << field << "\" is not name=value";
+				}
+				return B_BAD_VALUE;
+			}
+			BString name;
+			field.CopyInto(name, 0, equals);
+			BString value;
+			field.CopyInto(value, equals + 1, field.Length() - equals - 1);
+			status = AddValue(message, name, value, error);
+			if (status != B_OK)
+				return status;
+			if (index >= words.CountItems()
+				|| words.ItemAt(index)->ICompare("and") != 0)
+				break;
+			index++;
+		}
+	}
+
+	if (index < words.CountItems()) {
+		if (error != NULL) {
+			*error = "\"";
+			*error << *words.ItemAt(index) << "\" is not understood here";
+		}
+		return B_BAD_VALUE;
+	}
+	return B_OK;
+}
+
+
+}	// namespace RemoteControl
