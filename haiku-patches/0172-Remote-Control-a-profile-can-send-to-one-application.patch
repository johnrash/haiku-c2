+
+/*!	The first button of the enabled profiles for the event, and its
+	profile.
+*/
+const Button*
+RemoteControlDevice::_FindButton(const ir_remote_event& event,
+	const Profile** _profile) const
+{
+	for (int32 i = 0; i < fProfiles.CountItems(); i++) {
+		const Profile* profile = fProfiles.ItemAt(i);
+		if (!profile->Matches(event.protocol, event.address))
+			continue;
+		const Button* button = profile->FindButton(event.command);
+		if (button != NULL) {
+			*_profile = profile;
+			return button;
+		}
+	}
+	return NULL;
+}
+
+
+/*!	What the held button does when it goes down (repeat 0), repeats, or goes
+	up. Called with fLock held.
+*/
+void
+RemoteControlDevice::_Press(RemoteReceiver* receiver, bool down, int32 repeat)
 {
 	const Button& button = receiver->fHeldButton;
-	_KeyMessage(button.key, button.modifiers, true, ++receiver->fRepeats);
+	switch (receiver->fHeldAction) {
+		case kKeystroke:
+			if (down && repeat == 0 && button.modifiers != 0)
+				_ModifiersMessage(0, button.modifiers);
+			_KeyMessage(button.key, button.modifiers, down, repeat);
+			if (!down && button.modifiers != 0)
+				_ModifiersMessage(button.modifiers, 0);
+			break;
+
+		case kWindowKey:
+		{
+			// only the first press starts the target
+			BMessenger window;
+			if (!_TargetWindow(receiver->fHeldTarget,
+					down && repeat == 0 && receiver->fHeldStartsTarget,
+					window))
+				break;
+			BMessage* message = _MakeKeyMessage(button.key, button.modifiers,
+				down, repeat);
+			if (message != NULL) {
+				window.SendMessage(message, BMessenger(), 0);
+				delete message;
+			}
+			break;
+		}
+
+		case kCommand:
+			if (down) {
+				_SendScript(receiver->fHeldTarget,
+					repeat == 0 && receiver->fHeldStartsTarget,
+					button.script);
+			}
+			break;
+	}
+}
