+		item->SetMarked(targets[i].second.ICompare(current) == 0);
+		menu->AddItem(item);
+	}
+	menu->SetTargetForItems(this);
+	fTargetField->SetEnabled(profile != NULL);
+	fStartTargetBox->SetValue(profile != NULL && profile->StartsTarget());
+	fStartTargetBox->SetEnabled(profile != NULL && profile->HasTarget());
+	_UpdateEditor();
