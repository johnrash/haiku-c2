 /*
- * TODO (phase 2): IQ calibration.  rtw88 (rtw8822b_do_iqk()) sends the
- * H2C_PKT_IQK packet (clear = 0, segment_iqk = 0), polls RF_DTXLOK of
- * path A until it reads 0xabcde (up to 300 x 20 ms), writes 0 back and
- * reads REG_IQKFAILMSK.  It runs before the first transmission on a
- * new channel (rtw_chip_prepare_tx(), i.e. before association) and from
- * power tracking when the thermal delta exceeds iqk_threshold (8).
+ * rtw8822b_do_iqk(): firmware IQ calibration.  rtw_fw_do_iqk() starts
+ * it (clear = 0, segment_iqk = 0); the firmware writes 0xabcde to RF
+ * register 0x08 of path A when it is done.  The delays drop the driver
+ * lock (USB), so this may take a while without blocking the system.
+ */
+void
+r22b_do_iqk(struct rtwn_softc *sc)
+{
+	uint32_t rf_reg;
+	int counter, reload, fail_mask;
+
+	r22b_fw_do_iqk(sc, 0, 0);
+
+	for (counter = 0; counter < 300; counter++) {
+		rf_reg = r22b_rf_read(sc, R22B_RF_PATH_A, R22B_RF_DTXLOK);
+		if (rf_reg == 0xabcde)
+			break;
+		rtwn_delay(sc, 20000);	/* msleep(20) */
+	}
+	r22b_rf_write(sc, R22B_RF_PATH_A, R22B_RF_DTXLOK, 0x0);
+
+	reload = r22b_read32_mask(sc, R22B_REG_IQKFAILMSK, R22B_BIT(16));
+	fail_mask = r22b_read32_mask(sc, R22B_REG_IQKFAILMSK,
+	    R22B_GENMASK(7, 0));
+
+	/* rtw88 only logs this at debug level. */
+	if (counter == 300)
+		device_printf(sc->sc_dev, "IQK did not finish\n");
+	RTWN_DPRINTF(sc, RTWN_DEBUG_CALIB,
+	    "iqk counter=%d reload=%d n_iqk_fail(mask)=0x%02x\n",
+	    counter, reload, fail_mask);
+}
+
+/*
+ * When to run the IQK.  rtw88 marks every channel change outside a scan
+ * as needing calibration (rtw_set_channel(): need_rfk) and calibrates
+ * in rtw_chip_prepare_tx(), i.e. before authenticating; power tracking
+ * recalibrates when the temperature moved by iqk_threshold.  Here the
+ * IQK runs once per primary channel when rtwn is running and not
+ * scanning: in practice when net80211 tunes to the BSS channel to join
+ * (r22b_set_chan()), with r22b_set_media_status() as a fallback, and
+ * "force" again for the temperature trigger (r22b_iq_calib()).  The
+ * record is cleared at power on and when the last station leaves.
+ * 2.4 and 5 GHz channel numbers do not overlap, so the primary channel
+ * number identifies the channel.
+ */
+void
+r22b_iqk_check(struct rtwn_softc *sc, int force)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct r22b_softc *rs = sc->sc_priv;
+
+	if ((sc->sc_flags & (RTWN_RUNNING | RTWN_FW_LOADED)) !=
+	    (RTWN_RUNNING | RTWN_FW_LOADED))
+		return;
+	if (ic->ic_flags & IEEE80211_F_SCAN)
+		return;
+	if (!force && rs->iqk_chan == rs->cur_pri_chan)
+		return;
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_CALIB, "%s: IQK on channel %u%s\n",
+	    __func__, rs->cur_pri_chan, force ? " (temperature)" : "");
+
+	r22b_do_iqk(sc);
+	rs->iqk_chan = rs->cur_pri_chan;
+}
+
+/*
+ * sc_iq_calib: rtwn_temp_calib() calls it when the thermal meter moved
+ * by more than sc->temp_delta from the last calibration, which is
+ * rtw_phy_pwrtrack_need_iqk() (delta >= iqk_threshold).  Only while
+ * associated, like rtw88's power tracking.
  */
 void
 r22b_iq_calib(struct rtwn_softc *sc)
 {
-	RTWN_DPRINTF(sc, RTWN_DEBUG_CALIB, "%s: not implemented\n",
-	    __func__);
+	struct r22b_softc *rs = sc->sc_priv;
+
+	if (rs->nsta > 0)
+		r22b_iqk_check(sc, 1);
 }
diff --git a/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_ra.c b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_ra.c
new file mode 100644
index 0000000000..9038ecc5f7
--- /dev/null
+++ b/src/add-ons/kernel/drivers/network/wlan/realtekwifi/dev/rtwn/rtl8822b/r22b_ra.c
@@ -0,0 +1,845 @@
+/*-
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Copyright(c) 2018-2019  Realtek Corporation
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ *
+ * Derived from Linux's rtw88 driver (v7.0), used under its BSD-3-Clause option;
+ * see LICENSE.rtw88 in this directory.
+ */
+
+/*
+ * RTL8822B station state: firmware rate adaptation (H2C RA info, RSSI
+ * monitor, C2H rate reports), media status, the response rate set and
+ * the port registers written on association.
+ *
+ * rtwn calls sc_set_media_status from its command queue when a node gets
+ * a MAC id (rtwn_newassoc(): id | RTWN_MACID_VALID, in station mode when
+ * net80211 enters RUN) and when the node is freed (rtwn_node_free():
+ * plain id).  That is rtw88's rtw_sta_add() / rtw_sta_remove() plus the
+ * station part of rtw_ops_bss_info_changed(BSS_CHANGED_ASSOC).
+ *
+ * sc_set_rssi runs every 2 seconds from rtwn's calibration callout while
+ * sc_ratectl is RTWN_RATECTL_FW, the period of rtw88's watchdog; it does
+ * what rtw_phy_dynamic_mechanism() does for rate adaptation: the RSSI
+ * monitor H2C for every station, the RA info update every fourth run and
+ * the RRSR update.
+ *
+ * Sources (rtw88 v7.0): main.c (rtw_sta_add, rtw_sta_remove,
+ * rtw_update_sta_info, get_rate_id, get_vht_ra_mask, rtw_rate_mask_rssi,
+ * rtw_rate_mask_recover, rtw_vif_assoc_changed, rtw_vif_port_config),
+ * fw.c (rtw_fw_send_ra_info, rtw_fw_send_rssi_info,
+ * rtw_fw_media_status_report, rtw_fw_default_port,
+ * rtw_fw_ra_report_handle, rtw_fw_ra_report_iter), phy.c
+ * (rtw_phy_get_rssi_level, rtw_phy_stat_rssi, rtw_phy_ra_info_update,
+ * rtw_phy_get_rrsr_mask, rtw_phy_rrsr_update), tx.c
+ * (get_highest_ht_tx_rate, get_highest_vht_tx_rate,
+ * rtw_tx_data_pkt_info_update), mac80211.c (rtw_ops_bss_info_changed,
+ * rtw_vif_port[]).
+ */
+
+#include <sys/cdefs.h>
+#include "opt_wlan.h"
+
+#include <sys/param.h>
+#include <sys/lock.h>
+#include <sys/mutex.h>
+#include <sys/mbuf.h>
+#include <sys/kernel.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+#include <sys/malloc.h>
+#include <sys/queue.h>
+#include <sys/taskqueue.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/linker.h>
+
+#include <net/if.h>
+#include <net/ethernet.h>
+#include <net/if_media.h>
+
+#include <net80211/ieee80211_var.h>
+#include <net80211/ieee80211_radiotap.h>
+#include <net80211/ieee80211_ht.h>
+#include <net80211/ieee80211_vht.h>
+
+#include <dev/rtwn/if_rtwnreg.h>
+#include <dev/rtwn/if_rtwnvar.h>
+
+#include <dev/rtwn/if_rtwn_debug.h>
+#include <dev/rtwn/if_rtwn_ridx.h>
+
+#include <dev/rtwn/rtl8822b/r22b.h>
+#include <dev/rtwn/rtl8822b/r22b_fw_cmd.h>
+#include <dev/rtwn/rtl8822b/r22b_priv.h>
+#include <dev/rtwn/rtl8822b/r22b_reg.h>
+#include <dev/rtwn/rtl8822b/r22b_tx_desc.h>
+#include <dev/rtwn/rtl8822b/r22b_var.h>
+
+/* rtw88 main.c */
+#define R22B_RA_MASK_CCK_RATES		0x0000fULL
+#define R22B_RA_MASK_OFDM_RATES		0x00ff0ULL
+#define R22B_RA_MASK_HT_RATES_1SS	(0xff000ULL << 0)
+#define R22B_RA_MASK_HT_RATES_2SS	(0xff000ULL << 8)
+#define R22B_RA_MASK_HT_RATES_3SS	(0xff000ULL << 16)
+#define R22B_RA_MASK_HT_RATES		(R22B_RA_MASK_HT_RATES_1SS | \
+					 R22B_RA_MASK_HT_RATES_2SS | \
+					 R22B_RA_MASK_HT_RATES_3SS)
+#define R22B_RA_MASK_VHT_RATES_1SS	(0x3ff000ULL << 0)
+#define R22B_RA_MASK_VHT_RATES_2SS	(0x3ff000ULL << 10)
+#define R22B_RA_MASK_VHT_RATES_3SS	(0x3ff000ULL << 20)
+#define R22B_RA_MASK_VHT_RATES		(R22B_RA_MASK_VHT_RATES_1SS | \
+					 R22B_RA_MASK_VHT_RATES_2SS | \
+					 R22B_RA_MASK_VHT_RATES_3SS)
+#define R22B_RA_MASK_CCK_IN_BG		0x00005ULL
+#define R22B_RA_MASK_CCK_IN_HT		0x00005ULL
+#define R22B_RA_MASK_CCK_IN_VHT		0x00005ULL
+#define R22B_RA_MASK_OFDM_IN_VHT	0x00010ULL
+#define R22B_RA_MASK_OFDM_IN_HT_2G	0x00010ULL
+#define R22B_RA_MASK_OFDM_IN_HT_5G	0x00030ULL
+
+/* IEEE80211_VHT_MCS_SUPPORT_0_* */
+#define R22B_VHT_MCS_0_7		0
+#define R22B_VHT_MCS_0_8		1
+#define R22B_VHT_MCS_0_9		2
+
+/*
+ * Bit of a legacy rate (500 kb/s units) in the RA mask and in rtw88's
+ * supp_rates bitmaps: the hardware rate index, i.e. rtwn's ridx.
+ */
+static int
+r22b_legacy_rate_bit(uint8_t rate)
+{
+	switch (rate & IEEE80211_RATE_VAL) {
+	case 2:		return (RTWN_RIDX_CCK1);
+	case 4:		return (RTWN_RIDX_CCK2);
+	case 11:	return (RTWN_RIDX_CCK55);
+	case 22:	return (RTWN_RIDX_CCK11);
+	case 12:	return (RTWN_RIDX_OFDM6);
+	case 18:	return (RTWN_RIDX_OFDM9);
+	case 24:	return (RTWN_RIDX_OFDM12);
+	case 36:	return (RTWN_RIDX_OFDM18);
+	case 48:	return (RTWN_RIDX_OFDM24);
+	case 72:	return (RTWN_RIDX_OFDM36);
+	case 96:	return (RTWN_RIDX_OFDM48);
+	case 108:	return (RTWN_RIDX_OFDM54);
+	default:	return (-1);
+	}
+}
+
+/* get_vht_ra_mask(): from the station's VHT Rx MCS map */
+static uint64_t
+r22b_get_vht_ra_mask(uint16_t mcs_map)
+{
+	uint64_t ra_mask = 0;
+	int i, nss;
+
+	/* 4SS, every two bits for MCS7/8/9 */
+	for (i = 0, nss = 12; i < 4; i++, mcs_map >>= 2, nss += 10) {
+		switch (mcs_map & 0x3) {
+		case R22B_VHT_MCS_0_9:
+			ra_mask |= 0x3ffULL << nss;
+			break;
+		case R22B_VHT_MCS_0_8:
+			ra_mask |= 0x1ffULL << nss;
+			break;
+		case R22B_VHT_MCS_0_7:
+			ra_mask |= 0x0ffULL << nss;
+			break;
+		default:
+			break;
+		}
+	}
+
+	return (ra_mask);
+}
+
+/*
+ * get_rate_id().  The 8822B has at most two spatial streams, so the 3SS
+ * and 4SS rate ids are not needed; like rtw88, a wireless set that is
+ * not listed (CCK | OFDM | HT | VHT, i.e. VHT on 2.4 GHz) gives 0.
+ */
+static uint8_t
+r22b_get_rate_id(uint8_t wireless_set, uint8_t bw_mode, uint8_t tx_num)
+{
+	switch (wireless_set) {
+	case R22B_WIRELESS_CCK:
+		return (R22B_RATEID_B_20M);
+	case R22B_WIRELESS_OFDM:
+		return (R22B_RATEID_G);
+	case R22B_WIRELESS_CCK | R22B_WIRELESS_OFDM:
+		return (R22B_RATEID_BG);
+	case R22B_WIRELESS_OFDM | R22B_WIRELESS_HT:
+		return (tx_num == 1 ? R22B_RATEID_GN_N1SS :
+		    R22B_RATEID_GN_N2SS);
+	case R22B_WIRELESS_CCK | R22B_WIRELESS_OFDM | R22B_WIRELESS_HT:
+		if (bw_mode == R22B_CHANNEL_WIDTH_40)
+			return (tx_num == 1 ? R22B_RATEID_BGN_40M_1SS :
+			    R22B_RATEID_BGN_40M_2SS);
+		return (tx_num == 1 ? R22B_RATEID_BGN_20M_1SS :
+		    R22B_RATEID_BGN_20M_2SS);
+	case R22B_WIRELESS_OFDM | R22B_WIRELESS_VHT:
+		return (tx_num == 1 ? R22B_RATEID_ARFR1_AC_1SS :
+		    R22B_RATEID_ARFR0_AC_2SS);
+	case R22B_WIRELESS_CCK | R22B_WIRELESS_OFDM | R22B_WIRELESS_VHT:
+		if (bw_mode >= R22B_CHANNEL_WIDTH_80)
+			return (tx_num == 1 ? R22B_RATEID_ARFR1_AC_1SS :
+			    R22B_RATEID_ARFR0_AC_2SS);
+		return (tx_num == 1 ? R22B_RATEID_ARFR2_AC_2G_1SS :
+		    R22B_RATEID_ARFR3_AC_2G_2SS);
+	default:
+		return (0);
+	}
+}
+
+/* rtw_rate_mask_rssi() */
+static uint64_t
+r22b_rate_mask_rssi(uint8_t rssi_level, uint8_t wireless_set)
+{
+	if (wireless_set == R22B_WIRELESS_CCK)
+		return (0xffffffffffffffffULL);
+
+	switch (rssi_level) {
+	case 0:
+		return (0xffffffffffffffffULL);
+	case 1:
+		return (0xfffffffffffffff0ULL);
+	case 2:
+		return (0xffffffffffffefe0ULL);
+	case 3:
+		return (0xffffffffffffcfc0ULL);
+	case 4:
+		return (0xffffffffffff8f80ULL);
+	default:
+		return (0xffffffffffff0f00ULL);
+	}
+}
+
+/* rtw_rate_mask_recover() */
+static uint64_t
+r22b_rate_mask_recover(uint64_t ra_mask, uint64_t ra_mask_bak)
+{
+	const uint64_t legacy = R22B_RA_MASK_CCK_RATES |
+	    R22B_RA_MASK_OFDM_RATES;
+
+	if ((ra_mask & ~legacy) == 0)
+		ra_mask |= (ra_mask_bak & ~legacy);
+
+	if (ra_mask == 0)
+		ra_mask |= (ra_mask_bak & legacy);
+
+	return (ra_mask);
+}
+
+/* get_highest_vht_tx_rate(); rtw88 reads the station's Tx MCS map */
+static uint8_t
+r22b_highest_vht_rate(struct rtwn_softc *sc, uint16_t tx_mcs_map)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint8_t base;
+
+	if (rs->rf_path_num == 1)
+		base = R22B_DESC_RATEVHT1SS_MCS0;
+	else {
+		base = R22B_DESC_RATEVHT2SS_MCS0;
+		tx_mcs_map >>= 2;
+	}
+
+	switch (tx_mcs_map & 0x3) {
+	case R22B_VHT_MCS_0_7:
+		return (base + 7);
+	case R22B_VHT_MCS_0_8:
+		return (base + 8);
+	default:
+		return (base + 9);
+	}
+}
+
+/*
+ * rtw_update_sta_info() without the configured rate mask (net80211 has
+ * no per-station rate mask; a fixed rate goes through rtwn's
+ * ucastrate / force_rate instead).  Also computes the initial data rate
+ * rtw_tx_data_pkt_info_update() puts into the Tx descriptor.
+ *
+ * Called with the node table lock held ("ni" is node_list[id]).
+ */
+static void
+r22b_update_sta_info(struct rtwn_softc *sc, struct r22b_sta_info *si,
+    struct ieee80211_node *ni)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct ieee80211vap *vap = ni->ni_vap;
+	struct r22b_softc *rs = sc->sc_priv;
+	struct ieee80211_channel *c;
+	uint64_t ra_mask = 0, ra_mask_bak, legacy = 0, ht_mask = 0;
+	uint8_t wireless_set, bw_mode, stbc_en = 0, ldpc_en = 0, tx_num = 1;
+	uint8_t init_rate;
+	int is_vht, is_ht, is5g, sgi, bit, i;
+
+	c = (ni->ni_chan != IEEE80211_CHAN_ANYC) ? ni->ni_chan :
+	    ic->ic_curchan;
+	is5g = (c != NULL && c != IEEE80211_CHAN_ANYC &&
+	    IEEE80211_IS_CHAN_5GHZ(c));
+	is_vht = (ni->ni_flags & IEEE80211_NODE_VHT) != 0;
+	is_ht = (ni->ni_flags & IEEE80211_NODE_HT) != 0;	/* ht_supported */
+
+	/* Legacy rates (sta->supp_rates[band]). */
+	for (i = 0; i < ni->ni_rates.rs_nrates; i++) {
+		bit = r22b_legacy_rate_bit(ni->ni_rates.rs_rates[i]);
+		if (bit >= 0)
+			legacy |= 1ULL << bit;
+	}
+
+	/* HT MCS set (sta->ht_cap.mcs.rx_mask). */
+	for (i = 0; i < ni->ni_htrates.rs_nrates; i++) {
+		bit = ni->ni_htrates.rs_rates[i] & IEEE80211_RATE_VAL;
+		if (bit < 32)
+			ht_mask |= 1ULL << (12 + bit);
+	}
+
+	if (is_vht) {
+		ra_mask |= r22b_get_vht_ra_mask(ni->ni_vht_mcsinfo.rx_mcs_map);
+		if (ni->ni_vhtcap & IEEE80211_VHTCAP_RXSTBC_MASK)
+			stbc_en = R22B_VHT_STBC_EN;
+		if (ni->ni_vhtcap & IEEE80211_VHTCAP_RXLDPC)
+			ldpc_en = R22B_VHT_LDPC_EN;
+	} else if (is_ht) {
+		ra_mask |= ht_mask;
+		if (ni->ni_htcap & IEEE80211_HTCAP_RXSTBC)
+			stbc_en = R22B_HT_STBC_EN;
+		if (ni->ni_htcap & IEEE80211_HTCAP_LDPC)
+			ldpc_en = R22B_HT_LDPC_EN;
+	}
+
+	if (rs->rf_path_num == 1) {
+		ra_mask &= R22B_RA_MASK_VHT_RATES_1SS |
+		    R22B_RA_MASK_HT_RATES_1SS;
+	} else {
+		ra_mask &= R22B_RA_MASK_VHT_RATES_2SS |
+		    R22B_RA_MASK_HT_RATES_2SS | R22B_RA_MASK_VHT_RATES_1SS |
+		    R22B_RA_MASK_HT_RATES_1SS;
+	}
+
+	if (is5g) {
+		ra_mask |= legacy & R22B_RA_MASK_OFDM_RATES;
+		ra_mask_bak = ra_mask;
+		if (is_vht) {
+			ra_mask &= R22B_RA_MASK_VHT_RATES |
+			    R22B_RA_MASK_OFDM_IN_VHT;
+			wireless_set = R22B_WIRELESS_OFDM | R22B_WIRELESS_VHT;
+		} else if (is_ht) {
+			ra_mask &= R22B_RA_MASK_HT_RATES |
+			    R22B_RA_MASK_OFDM_IN_HT_5G;
+			wireless_set = R22B_WIRELESS_OFDM | R22B_WIRELESS_HT;
+		} else
+			wireless_set = R22B_WIRELESS_OFDM;
+		rs->rrsr_val_init = R22B_RRSR_INIT_5G;
+	} else {
+		ra_mask |= legacy;
+		ra_mask_bak = ra_mask;
+		if (is_vht) {
+			ra_mask &= R22B_RA_MASK_VHT_RATES |
+			    R22B_RA_MASK_CCK_IN_VHT | R22B_RA_MASK_OFDM_IN_VHT;
+			wireless_set = R22B_WIRELESS_CCK | R22B_WIRELESS_OFDM |
+			    R22B_WIRELESS_HT | R22B_WIRELESS_VHT;
+		} else if (is_ht) {
+			ra_mask &= R22B_RA_MASK_HT_RATES |
+			    R22B_RA_MASK_CCK_IN_HT | R22B_RA_MASK_OFDM_IN_HT_2G;
+			wireless_set = R22B_WIRELESS_CCK | R22B_WIRELESS_OFDM |
+			    R22B_WIRELESS_HT;
+		} else if (legacy <= 0xf) {
+			wireless_set = R22B_WIRELESS_CCK;
+		} else {
+			ra_mask &= R22B_RA_MASK_OFDM_RATES |
+			    R22B_RA_MASK_CCK_IN_BG;
+			wireless_set = R22B_WIRELESS_CCK | R22B_WIRELESS_OFDM;
+		}
+		rs->rrsr_val_init = R22B_RRSR_INIT_2G;
+	}
+
+	/* sta->bandwidth: what both sides and the BSS channel allow. */
+	if (is_vht && ieee80211_vht_check_tx_bw(ni, NET80211_STA_RX_BW_80)) {
+		bw_mode = R22B_CHANNEL_WIDTH_80;
+		sgi = (ni->ni_vhtcap & IEEE80211_VHTCAP_SHORT_GI_80) &&
+		    (vap->iv_vht_cap.vht_cap_info &
+		     IEEE80211_VHTCAP_SHORT_GI_80);
+	} else if (is_ht && (ieee80211_ht_check_tx_ht40(ni) ||
+	    (is_vht && ieee80211_vht_check_tx_bw(ni,
+	     NET80211_STA_RX_BW_40)))) {
+		bw_mode = R22B_CHANNEL_WIDTH_40;
+		sgi = (ni->ni_htcap & IEEE80211_HTCAP_SHORTGI40) &&
+		    (vap->iv_flags_ht & IEEE80211_FHT_SHORTGI40);
+	} else {
+		bw_mode = R22B_CHANNEL_WIDTH_20;
+		sgi = is_ht && ieee80211_ht_check_tx_shortgi_20(ni);
+	}
+
+	/* efuse->hw_cap.nss, not the station's stream count */
+	if (is_vht || is_ht)
+		tx_num = rs->rf_path_num;
+
+	ra_mask &= r22b_rate_mask_rssi(si->rssi_level, wireless_set);
+	ra_mask = r22b_rate_mask_recover(ra_mask, ra_mask_bak);
+
+	/* rtw_tx_data_pkt_info_update(): initial ("highest") data rate */
+	if (is_vht)
+		init_rate = r22b_highest_vht_rate(sc,
+		    ni->ni_vht_mcsinfo.tx_mcs_map);
+	else if (is_ht) {
+		init_rate = (rs->rf_path_num == 2 &&
+		    (ht_mask & R22B_RA_MASK_HT_RATES_2SS) != 0) ?
+		    R22B_DESC_RATEMCS15 : R22B_DESC_RATEMCS7;
+	} else if (!is5g && legacy <= 0xf)
+		init_rate = R22B_DESC_RATE11M;
+	else
+		init_rate = R22B_DESC_RATE54M;
+
+	si->is_5g = is5g;
+	si->bw_mode = bw_mode;
+	si->stbc_en = stbc_en;
+	si->ldpc_en = ldpc_en;
+	si->sgi_enable = sgi ? 1 : 0;
+	si->vht_enable = is_vht ? 1 : 0;
+	si->ra_mask = ra_mask;
+	si->rate_id = r22b_get_rate_id(wireless_set, bw_mode, tx_num);
+	si->init_rate = init_rate;
+}
+
+/* rtw_fw_send_ra_info(); the 8822B takes a 32-bit mask (no RA_INFO_HI) */
+static void
+r22b_fw_send_ra_info(struct rtwn_softc *sc, int macid,
+    struct r22b_sta_info *si, int reset_ra_mask)
+{
+	uint8_t h2c[8] = { 0 };
+
+	r22b_h2c_set(h2c, 0, R22B_H2C_CMD_ID, R22B_H2C_CMD_RA_INFO);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_MACID, macid);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_RATE_ID, si->rate_id);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_INIT_RA_LVL, si->init_ra_lv);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_SGI_EN, si->sgi_enable);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_BW_MODE, si->bw_mode);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_LDPC, si->ldpc_en != 0);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_NO_UPDATE, !reset_ra_mask);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_VHT_EN, si->vht_enable);
+	r22b_h2c_set(h2c, 0, R22B_RA_INFO_DIS_PT, 1);
+	r22b_h2c_set(h2c, 1, R22B_RA_INFO_RA_MASK, (uint32_t)si->ra_mask);
+
+	si->init_ra_lv = 0;
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_RA,
+	    "%s: macid %d, rate id %u, bw %u, sgi %u, vht %u, ldpc %u, "
+	    "mask 0x%08x%s\n", __func__, macid, si->rate_id, si->bw_mode,
+	    si->sgi_enable, si->vht_enable, si->ldpc_en,
+	    (uint32_t)si->ra_mask, reset_ra_mask ? " (reset)" : "");
+
+	(void)r22b_fw_cmd(sc, h2c);
+}
+
+/* rtw_fw_send_rssi_info() */
+static void
+r22b_fw_send_rssi_info(struct rtwn_softc *sc, int macid,
+    const struct r22b_sta_info *si, uint8_t rssi)
+{
+	uint8_t h2c[8] = { 0 };
+
+	r22b_h2c_set(h2c, 0, R22B_H2C_CMD_ID, R22B_H2C_CMD_RSSI_MONITOR);
+	r22b_h2c_set(h2c, 0, R22B_RSSI_INFO_MACID, macid);
+	r22b_h2c_set(h2c, 0, R22B_RSSI_INFO_RSSI, rssi);
+	r22b_h2c_set(h2c, 1, R22B_RSSI_INFO_STBC, si->stbc_en != 0);
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_RSSI, "%s: macid %d, rssi %u, level %u\n",
+	    __func__, macid, rssi, si->rssi_level);
+
+	(void)r22b_fw_cmd(sc, h2c);
+}
+
+/* rtw_fw_media_status_report() */
+static void
+r22b_fw_media_status_report(struct rtwn_softc *sc, int macid, int connect)
+{
+	uint8_t h2c[8] = { 0 };
+
+	r22b_h2c_set(h2c, 0, R22B_H2C_CMD_ID, R22B_H2C_CMD_MEDIA_STATUS_RPT);
+	r22b_h2c_set(h2c, 0, R22B_MEDIA_STATUS_OP_MODE, connect != 0);
+	r22b_h2c_set(h2c, 0, R22B_MEDIA_STATUS_MACID, macid);
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_STATE, "%s: macid %d %s\n", __func__,
+	    macid, connect ? "connected" : "disconnected");
+
+	(void)r22b_fw_cmd(sc, h2c);
+}
+
+/* rtw_fw_default_port() (H2C_CMD_DEFAULT_PORT, mailbox command) */
+static void
+r22b_fw_default_port(struct rtwn_softc *sc, int port, int macid)
+{
+	uint8_t h2c[8] = { 0 };
+
+	r22b_h2c_set(h2c, 0, R22B_H2C_CMD_ID, R22B_H2C_CMD_DEFAULT_PORT);
+	r22b_h2c_set(h2c, 0, R22B_DEFAULT_PORT_PORTID, port);
+	r22b_h2c_set(h2c, 0, R22B_DEFAULT_PORT_MACID, macid);
+
+	(void)r22b_fw_cmd(sc, h2c);
+}
+
+/* rtw_phy_get_rssi_level() */
+static uint8_t
+r22b_get_rssi_level(uint8_t old_level, uint8_t rssi)
+{
+	uint8_t table[] = { 20, 34, 38, 42, 46, 50, 100 };
+	u_int i;
+
+	/* RA_FLOOR_UP_GAP */
+	for (i = 0; i < nitems(table); i++) {
+		if (i >= old_level)
+			table[i] += 3;
+	}
+
+	for (i = 0; i < nitems(table); i++) {
+		if (rssi < table[i])
+			return (i);
+	}
+
+	return (0);
+}
+
+/* rtw_phy_get_rrsr_mask() */
+static uint32_t
+r22b_get_rrsr_mask(uint8_t rate_idx)
+{
+	uint8_t rate_order = rate_idx;
+
+	if (rate_idx >= R22B_DESC_RATEVHT4SS_MCS0)
+		rate_order -= R22B_DESC_RATEVHT4SS_MCS0;
+	else if (rate_idx >= R22B_DESC_RATEVHT3SS_MCS0)
+		rate_order -= R22B_DESC_RATEVHT3SS_MCS0;
+	else if (rate_idx >= R22B_DESC_RATEVHT2SS_MCS0)
+		rate_order -= R22B_DESC_RATEVHT2SS_MCS0;
+	else if (rate_idx >= R22B_DESC_RATEVHT1SS_MCS0)
+		rate_order -= R22B_DESC_RATEVHT1SS_MCS0;
+	else if (rate_idx >= R22B_DESC_RATEMCS24)
+		rate_order -= R22B_DESC_RATEMCS24;
+	else if (rate_idx >= R22B_DESC_RATEMCS16)
+		rate_order -= R22B_DESC_RATEMCS16;
+	else if (rate_idx >= R22B_DESC_RATEMCS8)
+		rate_order -= R22B_DESC_RATEMCS8;
+	else if (rate_idx >= R22B_DESC_RATEMCS0)
+		rate_order -= R22B_DESC_RATEMCS0;
+	else if (rate_idx >= R22B_DESC_RATE6M)
+		rate_order -= R22B_DESC_RATE6M;
+	else
+		rate_order -= R22B_DESC_RATE1M;
+
+	if (rate_idx >= R22B_DESC_RATEMCS0 || rate_order == 0)
+		rate_order++;
+
+	/* GENMASK(rate_order + RRSR_RATE_ORDER_CCK_LEN - 1, 0) */
+	return ((2U << (rate_order + R22B_RRSR_RATE_ORDER_CCK_LEN - 1)) - 1);
+}
+
+/*
+ * rtw_phy_rrsr_update(): response rates up to the slowest station's
+ * current rate.  Unlike rtw88 this is only written while a station is
+ * connected (rtw88 writes rrsr_val_init, 0 until the first association,
+ * from its watchdog all the time).
+ */
+static void
+r22b_rrsr_update(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t mask, mask_min;
+	int id;
+
+	if (rs->nsta == 0)
+		return;
+
+	mask_min = R22B_RRSR_RATE_ORDER_MAX;
+	for (id = 0; id < R22B_MACID_NUM; id++) {
+		if (!rs->sta[id].valid)
+			continue;
+		mask = r22b_get_rrsr_mask(rs->sta[id].ra_rate);
+		if (mask < mask_min)
+			mask_min = mask;
+	}
+
+	rtwn_write_4(sc, R22B_REG_RRSR, rs->rrsr_val_init & mask_min);
+}
+
+/*
+ * Association registers.  rtwn_run() (and rtwn_scan_end() through
+ * rtwn_calc_basicrates()) write registers the 92C-family way:
+ *
+ *	R92C_BCN_PSR_RPT (0x6a8)	0xc000 | AID
+ *	R92C_WMAC_TRXPTCL_CTL (0x668)	bit 17 for a short preamble
+ *	R92C_RRSR (0x440)		basic rates of the BSS
+ *	R92C_INIRTS_RATE_SEL (0x480)	lowest basic rate
+ *
+ * rtw88's rtw_vif_port_config() only writes the AID into bits 10:0 of
+ * 0x6a8, the RRSR comes from rtw_phy_rrsr_update() and the other two are
+ * not written at all.  Make the registers match rtw88: the bits rtw88
+ * does not own get the value they had after initialization (saved by
+ * r22b_post_init()).  The MSR (network type), BSSID, beacon interval,
+ * BCN_CTRL, slot time and EDCA registers rtwn writes are the same
+ * registers and values as rtw88's (rtw_vif_port[0], rtw_conf_tx()).
+ *
+ * "aid" < 0: only the registers rtwn_scan_end() rewrites.
+ */
+void
+r22b_assoc_regs(struct rtwn_softc *sc, int aid)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	uint32_t val;
+
+	if (aid >= 0) {
+		rtwn_write_2(sc, R22B_REG_BCN_PSR_RPT,
+		    (rs->saved_bcn_psr_rpt & ~R22B_BIT_MASK_PORT0_AID) |
+		    (aid & R22B_BIT_MASK_PORT0_AID));
+
+		val = rtwn_read_4(sc, R22B_REG_WMAC_TRXPTCL_CTL);
+		val = (val & ~R22B_BIT_RTWN_SHPRE) | rs->saved_shpre;
+		rtwn_write_4(sc, R22B_REG_WMAC_TRXPTCL_CTL, val);
+	}
+
+	rtwn_write_1(sc, R22B_REG_INIRTS_RATE_SEL, rs->saved_inirts_rate_sel);
+	r22b_rrsr_update(sc);
+}
+
+/* rtw_fw_ra_report_iter(): tell net80211 the rate the firmware uses */
+static void
+r22b_set_node_txrate(struct ieee80211_node *ni, uint8_t rate)
+{
+	uint8_t idx;
+
+	if (rate < R22B_DESC_RATEMCS0)
+		ieee80211_node_set_txrate_dot11rate(ni, ridx2rate[rate]);
+	else if (rate < R22B_DESC_RATEVHT1SS_MCS0) {
+		ieee80211_node_set_txrate_ht_mcsrate(ni,
+		    rate - R22B_DESC_RATEMCS0);
+	} else {
+		idx = rate - R22B_DESC_RATEVHT1SS_MCS0;
+		ieee80211_node_set_txrate_vht_rate(ni, idx / 10 + 1, idx % 10);
+	}
+}
+
+/*
+ * C2H_RA_RPT (rtw_fw_ra_report_handle()): "payload" and "len" are the
+ * C2H payload after the id and sequence bytes.  Called from the Rx path.
+ */
+void
+r22b_handle_ra_report(struct rtwn_softc *sc, const uint8_t *payload,
+    int len)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	struct r22b_sta_info *si;
+	struct ieee80211_node *ni;
+	uint8_t rate, macid;
+
+	if (len < R22B_C2H_RA_RPT_SIZE) {
+		device_printf(sc->sc_dev,
+		    "invalid ra report c2h length %d\n", len);
+		return;
+	}
+
+	rate = payload[R22B_C2H_RA_RPT_RATE_SGI] & R22B_C2H_RA_RPT_RATE;
+	macid = payload[R22B_C2H_RA_RPT_MACID];
+	if (macid >= R22B_MACID_NUM || rate >= R22B_RATE_MAX)
+		return;
+
+	si = &rs->sta[macid];
+	if (!si->valid)
+		return;
+
+	si->ra_rate = rate;
+	si->ra_sgi = (payload[R22B_C2H_RA_RPT_RATE_SGI] &
+	    R22B_C2H_RA_RPT_SGI) != 0;
+	si->ra_bw = payload[R22B_C2H_RA_RPT_BW];
+
+	RTWN_DPRINTF(sc, RTWN_DEBUG_RA,
+	    "%s: macid %u, rate 0x%02x, sgi %u, bw %u\n", __func__, macid,
+	    rate, si->ra_sgi, si->ra_bw);
+
+	RTWN_NT_LOCK(sc);
+	ni = sc->node_list[macid];
+	if (ni != NULL)
+		r22b_set_node_txrate(ni, rate);
+	RTWN_NT_UNLOCK(sc);
+}
+
+/*
+ * sc_set_media_status: rtw_sta_add() / rtw_sta_remove() and the station
+ * part of rtw_ops_bss_info_changed(BSS_CHANGED_ASSOC).  "macid" is the
+ * node id, with RTWN_MACID_VALID set for a new station.
+ */
+void
+r22b_set_media_status(struct rtwn_softc *sc, int macid)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	struct r22b_sta_info *si;
+	struct ieee80211_node *ni;
+	struct ieee80211vap *vap;
+	int id, connect, aid, port, was_valid;
+
+	RTWN_ASSERT_LOCKED(sc);
+
+	connect = (macid & RTWN_MACID_VALID) != 0;
+	id = macid & ~RTWN_MACID_VALID;
+	if (id < 0 || id >= R22B_MACID_NUM)
+		return;
+	si = &rs->sta[id];
+	was_valid = si->valid;
+
+	if (!connect) {
+		si->valid = 0;
+		if (was_valid && rs->nsta > 0)
+			rs->nsta--;
+
+		/* rtw_sta_remove() */
+		r22b_fw_media_status_report(sc, id, 0);
+
+		if (rs->nsta == 0) {
+			/* rtw_vif_assoc_changed(): AID 0 */
+			r22b_assoc_regs_reset(sc);
+			/* Calibrate again for the next association. */
+			rs->iqk_chan = 0;
+		}
+		return;
+	}
+
+	aid = -1;
+	port = 0;
+	RTWN_NT_LOCK(sc);
+	ni = sc->node_list[id];
+	if (ni == NULL) {
+		/* Already gone again. */
+		RTWN_NT_UNLOCK(sc);
+		return;
+	}
+	/* rtw_sta_add() */
+	memset(si, 0, sizeof(*si));
+	si->init_ra_lv = 1;
+	r22b_update_sta_info(sc, si, ni);
+	vap = ni->ni_vap;
+	if (vap->iv_opmode == IEEE80211_M_STA) {
+		aid = IEEE80211_NODE_AID(ni);
+		port = RTWN_VAP(vap)->id;
+	}
+	RTWN_NT_UNLOCK(sc);
+
+	si->valid = 1;
+	if (!was_valid)
+		rs->nsta++;
+
+	r22b_fw_send_ra_info(sc, id, si, 1);
+	r22b_fw_media_status_report(sc, id, 1);
+
+	if (aid >= 0) {
+		/* rtw_vif_port_config(PORT_SET_AID), rtw_phy_rrsr_update() */
+		r22b_assoc_regs(sc, aid);
+		/* rtw_fw_default_port() */
+		r22b_fw_default_port(sc, port, id);
+	}
+
+	/*
+	 * rtw_chip_prepare_tx(): normally the IQK already ran when net80211
+	 * tuned to the BSS channel (r22b_set_chan()); this only catches the
+	 * case where that did not happen.
+	 */
+	r22b_iqk_check(sc, 0);
+}
+
+/* rtw_vif_assoc_changed(NULL) + rtw_vif_port_config(PORT_SET_AID) */
+void
+r22b_assoc_regs_reset(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	rtwn_write_2(sc, R22B_REG_BCN_PSR_RPT,
+	    rs->saved_bcn_psr_rpt & ~R22B_BIT_MASK_PORT0_AID);
+}
+
+/*
+ * sc_set_rssi, every 2 seconds while associated (rtwn_calib_cb()):
+ * rtw_phy_stat_rssi() (RSSI level and RSSI monitor H2C per station),
+ * rtw_phy_ra_info_update() (every fourth run) and rtw_phy_rrsr_update().
+ * The RSSI is rtwn's per-node average (avg_pwdb), the same 0..100 scale
+ * as rtw88's ewma of pkt_stat->rssi.
+ *
+ * Not sent: H2C_CMD_WL_PHY_INFO (rtw_fw_update_wl_phy_info(), throughput,
+ * Rx rate and EVM statistics rtwn does not collect).
+ */
+void
+r22b_set_rssi(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+	struct r22b_sta_info *si;
+	struct ieee80211_node *ni;
+	int id, pwdb, update, found;
+
+	RTWN_ASSERT_LOCKED(sc);
+
+	if (rs->nsta == 0)
+		return;
+
+	/* rtw_phy_ra_info_update(): "if (rtwdev->watch_dog_cnt & 0x3)" */
+	update = (rs->ra_tick & 0x3) == 0;
+	rs->ra_tick++;
+
+	for (id = 0; id < R22B_MACID_NUM; id++) {
+		si = &rs->sta[id];
+		if (!si->valid)
+			continue;
+
+		RTWN_NT_LOCK(sc);
+		ni = sc->node_list[id];
+		found = (ni != NULL);
+		pwdb = found ? RTWN_NODE(ni)->avg_pwdb : -1;
+		RTWN_NT_UNLOCK(sc);
+		if (!found)
+			continue;
+
+		if (pwdb < 0)
+			pwdb = 0;	/* no samples yet (ewma_rssi starts at 0) */
+		else if (pwdb > 100)
+			pwdb = 100;
+
+		si->rssi_level = r22b_get_rssi_level(si->rssi_level, pwdb);
+		r22b_fw_send_rssi_info(sc, id, si, pwdb);
+	}
+
+	if (update) {
+		for (id = 0; id < R22B_MACID_NUM; id++) {
+			si = &rs->sta[id];
+			if (!si->valid)
+				continue;
+
+			RTWN_NT_LOCK(sc);
+			ni = sc->node_list[id];
+			found = (ni != NULL);
+			if (found)
+				r22b_update_sta_info(sc, si, ni);
+			RTWN_NT_UNLOCK(sc);
+
+			if (found)
+				r22b_fw_send_ra_info(sc, id, si, 0);
+		}
+	}
+
+	r22b_rrsr_update(sc);
+}
+
+/*
+ * Forget all stations (power on): the firmware starts without any, and
+ * rtwn hands out ids again.
+ */
+void
+r22b_ra_reset(struct rtwn_softc *sc)
+{
+	struct r22b_softc *rs = sc->sc_priv;
+
+	memset(rs->sta, 0, sizeof(rs->sta));
+	rs->nsta = 0;
+	rs->ra_tick = 0;
+	rs->rrsr_val_init = 0;
+	rs->iqk_chan = 0;
+}
