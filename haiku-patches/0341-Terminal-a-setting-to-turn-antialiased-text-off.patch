diff --git a/src/apps/terminal/TermView.cpp b/src/apps/terminal/TermView.cpp
index e09e7cae15..7a440bae66 100644
--- a/src/apps/terminal/TermView.cpp
+++ b/src/apps/terminal/TermView.cpp
@@ -784,6 +784,15 @@ TermView::SetTermFont(const BFont *font)
 
 	fHalfFont.SetSpacing(B_FIXED_SPACING);
 
+	// antialiased text, unless the settings turn it off
+	bool antialiased = PrefHandler::Default() == NULL
+		|| PrefHandler::Default()->getBool(PREF_TEXT_ANTIALIASING);
+	uint32 flags = fHalfFont.Flags() & ~B_DISABLE_ANTIALIASING;
+	if (!antialiased)
+		flags |= B_DISABLE_ANTIALIASING;
+	fHalfFont.SetFlags(flags);
+	fBoldFont.SetFlags(flags);
+
 	// calculate half font's max width
 	// Not Bounding, check only A-Z (For case of fHalfFont is KanjiFont.)
 	for (int c = 0x20; c <= 0x7e; c++) {
