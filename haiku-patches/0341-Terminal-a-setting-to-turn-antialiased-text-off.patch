From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Sun, 8 Nov 2026 17:33:24 -0500
Subject: [PATCH 341/342] Terminal: a setting to turn antialiased text off

"Antialiased text" in the Settings window, beside "Allow bold text",
on by default and saved with the other settings ("Antialiased text" in
~/config/settings/Terminal/Default). Off, TermView gives its fonts
B_DISABLE_ANTIALIASING; open windows change at once.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/apps/terminal/AppearPrefView.cpp | 16 ++++++++++++++++
 src/apps/terminal/AppearPrefView.h   |  2 ++
 src/apps/terminal/PrefHandler.cpp    |  1 +
 src/apps/terminal/TermConst.h        |  1 +
 src/apps/terminal/TermView.cpp       |  9 +++++++++
 src/apps/terminal/TermWindow.cpp     |  1 +
 6 files changed, 30 insertions(+)

diff --git a/src/apps/terminal/AppearPrefView.cpp b/src/apps/terminal/AppearPrefView.cpp
index b7a99cf9c7..e510f6543f 100644
--- a/src/apps/terminal/AppearPrefView.cpp
+++ b/src/apps/terminal/AppearPrefView.cpp
@@ -52,6 +52,10 @@ AppearancePrefView::AppearancePrefView(const char* name,
 		B_TRANSLATE("Allow bold text"),
 			new BMessage(MSG_ALLOW_BOLD_CHANGED));
 
+	fTextAntialiasing = new BCheckBox(
+		B_TRANSLATE("Antialiased text"),
+			new BMessage(MSG_TEXT_ANTIALIASING_CHANGED));
+
 	fUseOptionAsMetaKey = new BCheckBox(
 		B_TRANSLATE("Use left Option as Meta key"),
 			new BMessage(MSG_USE_OPTION_AS_META_CHANGED));
@@ -115,6 +119,7 @@ AppearancePrefView::AppearancePrefView(const char* name,
 		.AddGlue()
 		.Add(fBlinkCursor)
 		.Add(fAllowBold)
+		.Add(fTextAntialiasing)
 		.Add(fUseOptionAsMetaKey)
 		.Add(fWarnOnExit);
 
@@ -138,6 +143,7 @@ AppearancePrefView::Revert()
 
 	fBlinkCursor->SetValue(pref->getBool(PREF_BLINK_CURSOR));
 	fAllowBold->SetValue(pref->getBool(PREF_ALLOW_BOLD));
+	fTextAntialiasing->SetValue(pref->getBool(PREF_TEXT_ANTIALIASING));
 	fUseOptionAsMetaKey->SetValue(pref->getBool(PREF_USE_OPTION_AS_META));
 	fWarnOnExit->SetValue(pref->getBool(PREF_WARN_ON_EXIT));
 
@@ -159,6 +165,7 @@ AppearancePrefView::AttachedToWindow()
 	fWindowTitle->SetTarget(this);
 	fBlinkCursor->SetTarget(this);
 	fAllowBold->SetTarget(this);
+	fTextAntialiasing->SetTarget(this);
 	fUseOptionAsMetaKey->SetTarget(this);
 	fWarnOnExit->SetTarget(this);
 
@@ -250,6 +257,15 @@ AppearancePrefView::MessageReceived(BMessage* msg)
 			}
 			break;
 
+		case MSG_TEXT_ANTIALIASING_CHANGED:
+			if (PrefHandler::Default()->getBool(PREF_TEXT_ANTIALIASING)
+				!= fTextAntialiasing->Value()) {
+					PrefHandler::Default()->setBool(PREF_TEXT_ANTIALIASING,
+						fTextAntialiasing->Value());
+					modified = true;
+			}
+			break;
+
 		case MSG_USE_OPTION_AS_META_CHANGED:
 			if (PrefHandler::Default()->getBool(PREF_USE_OPTION_AS_META)
 				!= fUseOptionAsMetaKey->Value()) {
