+/*!	Runs the head transfer's current packet on a high speed stream's channel
+	in the next microframe: all its transactions (HCCHAR.MC). Called with
+	fIsoLock held.
+*/
+void
+DWC2::_IsoStartHighSpeed(dwc2_iso_stream* stream)
+{
+	dwc2_iso_transfer* entry = stream->queue.Head();
+	Pipe* pipe = stream->pipe;
+	uint32 maxPacket = pipe->MaxPacketSize();
+	uint32 offset = entry->slot * stream->slotSize
+		+ stream->packet * entry->stride;
+	// whole packets for IN, whatever the request: the stride holds them
+	uint32 size = maxPacket * stream->mult;
+	uint32 pid = stream->mult == 3 ? PID_DATA2
+		: stream->mult == 2 ? PID_DATA1 : PID_DATA0;
+
+	// the next microframe: the channel waits for one of its parity; if the
+	// microframe changes meanwhile, it runs in that one at once
+	uint32 frame = (_Read(kHfnum) + 1) & 0x3fff;
+	if (stream->targetFrame != UINT32_MAX)
+		stream->stats.missed += (frame - stream->targetFrame - 1) & 0x3fff;
+	stream->targetFrame = frame;
+	stream->size = size;
+
+	uint32 character = maxPacket
+		| ((pipe->EndpointAddress() & 0xf) << HCCHAR_EPNUM_SHIFT)
+		| (stream->in ? HCCHAR_EPDIR_IN : 0)
+		| (EPTYPE_ISOCHRONOUS << HCCHAR_EPTYPE_SHIFT)
+		| (stream->mult << HCCHAR_MC_SHIFT)
+		| ((uint32)pipe->DeviceAddress() << HCCHAR_DEVADDR_SHIFT)
+		| ((frame & 1) != 0 ? HCCHAR_ODDFRM : 0);
+
+	uint32 channel = stream->channel;
+	_Write(HC_SPLT(channel), 0);
+	_Write(HC_INT(channel), HCINT_ALL);
+	_Write(HC_INTMSK(channel), HCINT_CHHLTD);
+	_Write(HC_TSIZ(channel), size | (stream->mult << HCTSIZ_PKTCNT_SHIFT)
+		| (pid << HCTSIZ_PID_SHIFT));
+	_Write(HC_DMA(channel), (uint32)(stream->bouncePhysical + offset));
+	asm volatile("dsb sy" : : : "memory");
+	_Write(HC_CHAR(channel), character | HCCHAR_CHENA);
+	stream->running = true;
+}
