From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Wed, 28 Oct 2026 00:20:14 -0400
Subject: [PATCH 006/342] mmc_disk: attach to MMC/eMMC cards

- accept CARD_TYPE_MMC and CARD_TYPE_MMC_EXTENDED_CAPACITY devices
- keep the card type and use it, not the CSD version, to choose between
  ACMD6 (SD) and CMD6 SWITCH (MMC) for the 4-bit bus switch; eMMC CSDs
  are below version 3 too, so SD commands were sent to them
- read MMC CSDs with the version 1.0 field layout (CSD_STRUCTURE 3 on eMMC
  means "see EXT_CSD") instead of rejecting them
- eMMC is not removable

The capacity still comes from the CSD, which is a placeholder on cards
over 2 GB; reading SEC_COUNT from EXT_CSD is a TODO.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../kernel/drivers/disk/mmc/mmc_disk.cpp      | 30 ++++++++++++-------
 .../kernel/drivers/disk/mmc/mmc_disk.h        |  2 ++
 2 files changed, 22 insertions(+), 10 deletions(-)

diff --git a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
index bf48fc34d3..ec7964f220 100644
--- a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
+++ b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.cpp
@@ -54,18 +54,20 @@ struct mmc_disk_csd {
 
 	uint8 structure_version() { return bits[1] >> 54; }
 	uint8 read_bl_len() { return (bits[1] >> 8) & 0xF; }
-	uint32 c_size()
+	// MMC/eMMC cards always use the version 1.0 layout for these fields
+	// (their CSD_STRUCTURE 3 means "see EXT_CSD").
+	uint32 c_size(bool mmc)
 	{
-		if (structure_version() == 0)
+		if (mmc || structure_version() == 0)
 			return ((bits[0] >> 54) & 0x3FF) | ((bits[1] & 0x3) << 10);
 		if (structure_version() == 1)
 			return (bits[0] >> 40) & 0x3FFFFF;
 		return ((bits[0] >> 40) & 0xFFFFFF) | ((bits[1] & 0xF) << 24);
 	}
 
-	uint8 c_size_mult()
+	uint8 c_size_mult(bool mmc)
 	{
-		if (structure_version() == 0)
+		if (mmc || structure_version() == 0)
 			return (bits[0] >> 39) & 0x7;
 		// In later versions this field is not present in the structure and a
 		// fixed value is used.
@@ -101,6 +103,9 @@ mmc_disk_supports_device(device_node* parent)
 		TRACE("SD card found, parent: %p\n", parent);
 	else if (deviceType == CARD_TYPE_SDHC)
 		TRACE("SDHC card found, parent: %p\n", parent);
+	else if (deviceType == CARD_TYPE_MMC
+		|| deviceType == CARD_TYPE_MMC_EXTENDED_CAPACITY)
+		TRACE("MMC/eMMC card found, parent: %p\n", parent);
 	else if (deviceType == CARD_TYPE_SDIO) {
 		// Ignore silently, since it is not mass storage and should be handled by other drivers
 		return 0.0;
@@ -164,17 +169,21 @@ mmc_block_get_geometry(mmc_disk_driver_info* info, device_geometry* geometry)
 
 	TRACE("CSD: %" PRIx64 " %" PRIx64 "\n", csd.bits[0], csd.bits[1]);
 
-	if (csd.structure_version() >= 3) {
+	bool isMMC = info->type == CARD_TYPE_MMC
+		|| info->type == CARD_TYPE_MMC_EXTENDED_CAPACITY;
+	if (!isMMC && csd.structure_version() >= 3) {
 		TRACE("unknown CSD version %d\n", csd.structure_version());
 		return B_NOT_SUPPORTED;
 	}
 
 	geometry->bytes_per_sector = 1 << csd.read_bl_len();
-	geometry->sectors_per_track = csd.c_size() + 1;
-	geometry->cylinder_count = 1 << (csd.c_size_mult() + 2);
+	geometry->sectors_per_track = csd.c_size(isMMC) + 1;
+	geometry->cylinder_count = 1 << (csd.c_size_mult(isMMC) + 2);
 	geometry->head_count = 1;
 	geometry->device_type = B_DISK;
-	geometry->removable = true; // TODO detect eMMC which isn't
+	// TODO: cards over 2 GB (all eMMC "extended capacity" parts) report a
+	// placeholder size in the CSD; the real one is SEC_COUNT in EXT_CSD.
+	geometry->removable = !isMMC;
 	geometry->read_only = false; // TODO check write protect switch?
 	geometry->write_once = false;
 
@@ -184,8 +193,7 @@ mmc_block_get_geometry(mmc_disk_driver_info* info, device_geometry* geometry)
 	uint32_t cardStatus = 0;
 	status_t status = B_OK;
 
-	// TODO have the card type at hand instead of using the csd version here
-	if (csd.structure_version() < 3) {
+	if (!isMMC) {
 		const uint32 k4BitMode = 2;
 		info->mmc->execute_command(info->parent, info->parentCookie, info->rca,
 			SD_APP_CMD, info->rca << 16, &cardStatus);
@@ -269,6 +277,8 @@ mmc_disk_init_driver(device_node* node, void** cookie)
 		return B_BAD_DATA;
 	}
 
+	info->type = deviceType;
+
 	// SD and MMC cards use byte offsets for IO commands, later ones (SDHC,
 	// SDXC, ...) use sectors.
 	if (deviceType == CARD_TYPE_SD || deviceType == CARD_TYPE_MMC)
diff --git a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.h b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.h
index c17e052c4a..ea73a99b96 100644
--- a/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.h
+++ b/src/add-ons/kernel/drivers/disk/mmc/mmc_disk.h
@@ -33,6 +33,8 @@ typedef struct {
 	void* parentCookie;
 	mmc_device_interface* mmc;
 	uint16_t rca;
+	uint8_t type;
+		// card_type of the card
 	uint32_t flags;
 
 	device_geometry geometry;
