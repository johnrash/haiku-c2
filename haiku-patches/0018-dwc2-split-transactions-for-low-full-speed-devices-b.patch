+									uint32 size, uint32 packets, uint32 pid,
+									uint32 offset, bool in, uint32* status,
+									uint32* transferSize);
 			void				_HaltChannel();
 
 			status_t			_CopyToBounce(Transfer* transfer, uint32 offset,
