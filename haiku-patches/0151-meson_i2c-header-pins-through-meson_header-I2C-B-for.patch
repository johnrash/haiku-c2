+/*!	A program opens the bus: the first one takes the pins. */
+status_t
+MesonI2c::Open()
+{
+	RecursiveLocker locker(fLock);
+	if (fOpenCount == 0) {
+		status_t status = _SelectPins(true);
+		if (status != B_OK)
+			return status;
+		// the first token list after the pins are muxed doesn't finish
+		_Stop();
+	}
+	fOpenCount++;
+	return B_OK;
+}
+
+
+/*!	A program's file is done: the last one gives the pins back. */
+void
+MesonI2c::Free()
+{
+	RecursiveLocker locker(fLock);
+	if (--fOpenCount == 0)
+		_SelectPins(false);
+}
