+#ifndef _MESON_I2C_H
+#define _MESON_I2C_H
+
+
+#include <Drivers.h>
+
+
+/*!	The ODROID-C2 header's I2C bus for programs (meson_i2c): I2C B on pins
+	27 (SDA) and 28 (SCL), 3.3 V, with 1 kOhm pull-ups on the board, at
+	100 kHz. The first open file takes the two pins from GPIO (B_BUSY while
+	a program has one), the last one closed gives them back. Until then
+	the bus manager's bus_raw device can't use the bus either. libdevice's
+	BI2CDevice is the interface programs use.
+*/
+
+
+#define MESON_I2C_HEADER_DEVICE	"/dev/bus/i2c/header"
+
+enum {
+	MESON_I2C_TRANSFER = B_DEVICE_OP_CODES_END + 0x4932,
+		// meson_i2c_transfer: a start, the address, the bytes to write,
+		// then (both given) a repeated start and the bytes to read, a stop.
+		// Neither: only the address, to see whether a device answers.
+		// B_DEV_NOT_READY: no acknowledge; B_TIMED_OUT
+};
+
+#define MESON_I2C_MAX_TRANSFER	4096
+
+
+struct meson_i2c_transfer {
+	uint32		address;		// 7 bits: 0x08 to 0x77
+	const void*	write;
+	size_t		writeLength;
+	void*		read;
+	size_t		readLength;
+};
+
+
+#endif	// _MESON_I2C_H
