+status_t
+MesonI2c::Transfer(void* userBuffer)
+{
+	meson_i2c_transfer transfer;
+	if (user_memcpy(&transfer, userBuffer, sizeof(transfer)) != B_OK)
+		return B_BAD_ADDRESS;
+	if (transfer.address < 0x08 || transfer.address > 0x77
+		|| transfer.writeLength > MESON_I2C_MAX_TRANSFER
+		|| transfer.readLength > MESON_I2C_MAX_TRANSFER
+		|| (transfer.writeLength > 0 && transfer.write == NULL)
+		|| (transfer.readLength > 0 && transfer.read == NULL)) {
+		return B_BAD_VALUE;
+	}
+	uint8* buffer = NULL;
+	size_t length = transfer.writeLength + transfer.readLength;
+	if (length > 0) {
+		buffer = (uint8*)malloc(length);
+		if (buffer == NULL)
+			return B_NO_MEMORY;
+	}
+	MemoryDeleter deleter(buffer);
+	uint8* written = buffer;
+	uint8* read = buffer + transfer.writeLength;
+	if (transfer.writeLength > 0 && user_memcpy(written, transfer.write,
+			transfer.writeLength) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+
+	status_t status;
+	if (transfer.readLength > 0) {
+		status = ExecCommand(I2C_OP_READ_STOP, transfer.address, written,
+			transfer.writeLength, read, transfer.readLength);
+	} else {
+		status = ExecCommand(I2C_OP_WRITE_STOP, transfer.address, written,
+			transfer.writeLength, NULL, 0);
+	}
+	if (status != B_OK)
+		return status;
+	if (transfer.readLength > 0
+		&& user_memcpy(transfer.read, read, transfer.readLength) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	return B_OK;
+}
