+/*!	Claims the controller's header pins and selects its function on them
+	(\a select), or gives them back as GPIO. All or none.
+*/
+status_t
+MesonI2c::_SelectPins(bool select)
+{
+	const HeaderPins* header = NULL;
+	for (size_t i = 0; i < B_COUNT_OF(kHeaderPins); i++) {
+		if (kHeaderPins[i].controller == fBase)
+			header = &kHeaderPins[i];
+	}
+	if (header == NULL)
+		return B_OK;
+	int32 indexes[2];
+	for (size_t j = 0; j < B_COUNT_OF(header->pins); j++) {
+		indexes[j] = gHeader->find_pin(header->pins[j]);
+		if (indexes[j] < 0)
+			return B_ERROR;
+	}
+	if (!select) {
+		for (size_t j = 0; j < B_COUNT_OF(indexes); j++) {
+			gHeader->select(indexes[j], NULL);
+			gHeader->release(indexes[j], this);
+		}
+		return B_OK;
+	}
+	for (size_t j = 0; j < B_COUNT_OF(indexes); j++) {
+		if (gHeader->claim(indexes[j], this, header->function) != B_OK) {
+			INFO("%s: header pin %s is not available\n", header->function,
+				header->pins[j]);
+			for (size_t k = 0; k < j; k++)
+				gHeader->release(indexes[k], this);
+			return B_BUSY;
+		}
+	}
+	for (size_t j = 0; j < B_COUNT_OF(indexes); j++)
+		gHeader->select(indexes[j], header->function);
+	return B_OK;
+}
