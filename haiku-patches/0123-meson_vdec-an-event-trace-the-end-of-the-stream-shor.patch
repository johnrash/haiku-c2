From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Fri, 30 Oct 2026 17:32:11 -0400
Subject: [PATCH 123/342] meson_vdec: an event trace; the end of the stream
 shortens a waiting GET_FRAME

The trace keeps the last 64 frame reports, hand-backs and parser
submissions, printed when a session ends and by the KDL command.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../drivers/video/meson_vdec/meson_vdec.cpp   | 68 ++++++++++++++++++-
 1 file changed, 66 insertions(+), 2 deletions(-)

diff --git a/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec.cpp b/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec.cpp
index 0043bacbdd..1914ff9dfa 100644
--- a/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec.cpp
+++ b/src/add-ons/kernel/drivers/video/meson_vdec/meson_vdec.cpp
@@ -323,6 +323,19 @@ private:
 				// bit per frame: with the caller
 			bool				fFatal;
 
+			// the last events, for finding what the firmware does
+			struct trace_entry {
+				bigtime_t		time;
+				char			what;	// 'R'eport, 'B'ack, 'S'ubmit, 'E'nd
+				uint32			a, b, c, d;
+			};
+	static	const uint32		kTraceSize = 64;
+			trace_entry			fTrace[kTraceSize];
+			uint32				fTraceCount;
+			void				_Trace(char what, uint32 a, uint32 b = 0,
+									uint32 c = 0, uint32 d = 0);
+			void				_DumpTrace(bool debugger);
+
 			// counters, for the KDL command
 			uint32				fVdecInterrupts;
 			uint32				fParserInterrupts;
@@ -367,6 +380,7 @@ MesonVdec::MesonVdec(device_node* node)
 	fQueueCount(0),
 	fHeld(0),
 	fFatal(false),
+	fTraceCount(0),
 	fVdecInterrupts(0),
 	fParserInterrupts(0),
 	fFramesDecoded(0),
@@ -456,6 +470,43 @@ MesonVdec::Init(phys_addr_t dos, phys_addr_t parser, int32 vdecIrq,
 }
 
 
+//	#pragma mark - trace
+
+
+void
+MesonVdec::_Trace(char what, uint32 a, uint32 b, uint32 c, uint32 d)
+{
+	trace_entry& entry = fTrace[fTraceCount++ % kTraceSize];
+	entry.time = system_time();
+	entry.what = what;
+	entry.a = a;
+	entry.b = b;
+	entry.c = c;
+	entry.d = d;
+}
+
+
+void
+MesonVdec::_DumpTrace(bool debugger)
+{
+	uint32 count = min_c(fTraceCount, kTraceSize);
+	bigtime_t base = count > 0
+		? fTrace[(fTraceCount - count) % kTraceSize].time : 0;
+	for (uint32 i = fTraceCount - count; i < fTraceCount; i++) {
+		const trace_entry& entry = fTrace[i % kTraceSize];
+		char line[128];
+		snprintf(line, sizeof(line), "  %8" B_PRIdBIGTIME " us %c %#" B_PRIx32
+			" %#" B_PRIx32 " %#" B_PRIx32 " %#" B_PRIx32 "\n",
+			entry.time - base, entry.what, entry.a, entry.b, entry.c,
+			entry.d);
+		if (debugger)
+			kprintf("%s", line);
+		else
+			dprintf("meson_vdec: %s", line);
+	}
+}
+
+
 //	#pragma mark - interrupts
 
 
@@ -477,6 +528,8 @@ MesonVdec::_CheckDecoder()
 	uint32 report = _Dos(AV_SCRATCH_9);
 	if (report == 0)
 		return false;
+	_Trace('R', report, _Dos(AV_SCRATCH_5), _Dos(AV_SCRATCH_D),
+		_Dos(AV_SCRATCH_E));
 	if ((report & BUFFEROUT_SKIP) == BUFFEROUT_SKIP) {
 		fFramesSkipped++;
 	} else {
@@ -834,6 +887,7 @@ MesonVdec::_Stop()
 			" skipped, %" B_PRIu32 " buffers submitted, %" B_PRIu32
 			" parser timeouts\n", fFramesDecoded, fFramesSkipped, fSubmitted,
 			fParserTimeouts);
+		_DumpTrace(false);
 	}
 	_FreeBuffer(fFirmware);
 	_FreeBuffer(fVififo);
@@ -877,6 +931,8 @@ MesonVdec::_Submit(size_t payload, bool marker)
 	_SetParser(PARSER_FETCH_CMD,
 		PARSER_FETCH_ENDIAN_64 | (length + kMarkerSize));
 	fSubmitted++;
+	_Trace(marker ? 'S' : 'E', payload, _Parser(PARSER_VIDEO_WP),
+		_Dos(VLD_MEM_VIFIFO_LEVEL));
 
 	bigtime_t timeout = system_time() + (marker ? 1000000 : 200000);
 	while (true) {
@@ -966,9 +1022,15 @@ MesonVdec::_GetFrame(meson_vdec_frame& frame)
 		return B_NOT_ALLOWED;
 
 	// after the end of the stream, a pause in the output is its end
-	bigtime_t timeout = system_time()
-		+ (fEndOfStream ? min_c(frame.timeout, 300000) : frame.timeout);
+	bigtime_t start = system_time();
+	bool endOfStream = fEndOfStream;
+	bigtime_t timeout = start
+		+ (endOfStream ? min_c(frame.timeout, 300000) : frame.timeout);
 	while (true) {
+		if (!endOfStream && fEndOfStream) {
+			endOfStream = true;
+			timeout = min_c(timeout, system_time() + 300000);
+		}
 		if (acquire_sem_etc(fFrameSem, 1, B_RELATIVE_TIMEOUT | B_CAN_INTERRUPT,
 				kPollInterval) == B_OK) {
 			break;
@@ -1037,6 +1099,7 @@ MesonVdec::_Recycle(uint32 index)
 	}
 	InterruptsSpinLocker locker(fStateLock);
 	fHeld &= ~(1 << index);
+	_Trace('B', index + 1, _Dos(AV_SCRATCH_E));
 	locker.Unlock();
 	_SetDos(AV_SCRATCH_8, index + 1);
 	return B_OK;
@@ -1146,6 +1209,7 @@ MesonVdec::Dump()
 		", held %#" B_PRIx32 "%s\n", fRunning ? "running" : "stopped",
 		fWidth, fHeight, fFramesDecoded, fFramesSkipped, fQueueCount, fHeld,
 		fFatal ? ", fatal error" : "");
+	_DumpTrace(true);
 	kprintf("  interrupts: decoder %" B_PRIu32 ", parser %" B_PRIu32
 		"; %" B_PRIu32 " buffers submitted, %" B_PRIu32 " parser timeouts\n",
 		fVdecInterrupts, fParserInterrupts, fSubmitted, fParserTimeouts);
