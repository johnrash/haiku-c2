@@ -1262,6 +1282,43 @@ MesonHdmi::_DetailedTimings(const uint8** timings, uint32 maxCount)
 }
 
 
+/*!	The HDMI vendor-specific data block of the CTA-861 extension (IEEE OUI
+	00-0C-03): its payload after the header, and its length; 0 if none.
+*/
+uint32
+MesonHdmi::_HdmiVendorBlock(const uint8** _payload)
+{
+	const uint8* cta = _CtaExtension();
+	if (cta == NULL)
+		return 0;
+	uint32 dtdOffset = cta[2];
+	for (uint32 i = 4; i < dtdOffset;) {
+		uint8 header = cta[i];
+		uint32 length = header & 0x1f;
+		if ((header >> 5) == 3 && length >= 5 && i + length < dtdOffset
+			&& cta[i + 1] == 0x03 && cta[i + 2] == 0x0c
+			&& cta[i + 3] == 0x00) {
+			*_payload = cta + i + 1;
+			return length;
+		}
+		i += length + 1;
+	}
+	return 0;
+}
+
+
+/*!	The display's highest TMDS clock in kHz, from its HDMI vendor block (in
+	5 MHz steps); 0 if it doesn't say.
+*/
+uint32
+MesonHdmi::_MaxTmdsClock()
+{
+	const uint8* hdmi;
+	uint32 length = _HdmiVendorBlock(&hdmi);
+	return length >= 7 ? hdmi[6] * 5000 : 0;
+}
+
+
 bool
 MesonHdmi::_EdidLists(const meson_mode& mode)
 {
@@ -1284,6 +1341,30 @@ MesonHdmi::_EdidLists(const meson_mode& mode)
 		}
 	}
 
+	// HDMI 1.4's 4K modes, which many displays list only as HDMI VICs in
+	// the vendor block: after the latencies, if any, when the "HDMI video
+	// present" flag is set
+	const uint8* hdmi;
+	uint32 hdmiLength = _HdmiVendorBlock(&hdmi);
+	if (hdmiLength >= 8 && (hdmi[7] & 0x20) != 0) {
+		uint32 index = 8;
+		if ((hdmi[7] & 0x80) != 0)
+			index += 2;
+		if ((hdmi[7] & 0x40) != 0)
+			index += 2;
+		if (index + 1 < hdmiLength) {
+			uint32 vicCount = hdmi[index + 1] >> 5;
+			for (uint32 j = 0; j < vicCount && index + 2 + j < hdmiLength;
+					j++) {
+				uint8 hdmiVic = hdmi[index + 2 + j];
+				if (hdmiVic < B_COUNT_OF(kHdmiVics)
+					&& kHdmiVics[hdmiVic] == mode.vic && mode.vic != 0) {
+					return true;
+				}
+			}
+		}
+	}
+
 	const uint8* timings[16];
 	uint32 count = _DetailedTimings(timings, B_COUNT_OF(timings));
 	for (uint32 i = 0; i < count; i++) {
@@ -1306,6 +1387,8 @@ MesonHdmi::_SaveBootState()
 	}
 	fBootPllCntl = _Hhi(HHI_HDMI_PLL_CNTL);
 	fBootPllCntl2 = _Hhi(HHI_HDMI_PLL_CNTL2);
+	fBootPhyCntl0 = _Hhi(HHI_HDMI_PHY_CNTL0);
+	fBootPhyCntl3 = _Hhi(HHI_HDMI_PHY_CNTL3);
 	for (size_t i = 0; i < B_COUNT_OF(kSavedComposer); i++)
 		fBootComposer[i] = _DwRead(kSavedComposer[i]);
 	fBootStateSaved = true;
@@ -1655,6 +1738,14 @@ MesonHdmi::_ProgramMode(const meson_mode& mode, phys_addr_t frameBuffer,
 	for (int32 i = 0; i < 4; i++)
 		_DwWrite(DW_FC_INVIDCONF, videoConfig);
 
+	// the PHY's band for the TMDS rate (U-Boot's values for GXBB)
+	if (mode.pixelClock >= kPhyHighBand) {
+		_SetHhi(HHI_HDMI_PHY_CNTL0, 0x33634283);
+		_SetHhi(HHI_HDMI_PHY_CNTL3, 0xb000115b);
+	} else {
+		_SetHhi(HHI_HDMI_PHY_CNTL0, 0x33632122);
+		_SetHhi(HHI_HDMI_PHY_CNTL3, 0x2000115b);
+	}
 	_ResetPhy();
 	_SetVpu(ENCP_VIDEO_EN, 1);
 
@@ -1814,6 +1905,10 @@ MesonHdmi::RestoreBootMode()
 	_DwWrite(DW_MC_SWRSTZ, (uint8)~MC_SWRSTZ_TMDS);
 	for (int32 i = 0; i < 4; i++)
 		_DwWrite(DW_FC_INVIDCONF, fBootComposer[0]);
+	if (fBootPhyCntl0 != 0) {
+		_SetHhi(HHI_HDMI_PHY_CNTL0, fBootPhyCntl0);
+		_SetHhi(HHI_HDMI_PHY_CNTL3, fBootPhyCntl3);
+	}
 	_ResetPhy();
 	_SetVpu(ENCP_VIDEO_EN, 1);
 	_SetCanvas(fBootFrameBuffer, fBootBytesPerRow, fBootHeight);
