From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Fri, 30 Oct 2026 22:35:08 -0400
Subject: [PATCH 141/342] interface kit, app_server: B_NV12

A color space for planar 4:2:0 video as decoders give it: the Y plane,
then the CbCr plane (Cb Cr pairs, one for each 2x2 pixels) with the same
bytes per row, BytesPerRow() * height bytes in. Bitmaps of it can't be
drawn; it is for overlays. BBitmap and app_server's ServerBitmap count
the CbCr plane in the bitmap's size (BPrivate::get_bits_length()).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 headers/os/interface/GraphicsDefs.h          |  5 +++++
 headers/private/interface/InterfacePrivate.h |  2 ++
 src/build/libbe/interface/Bitmap.cpp         |  1 +
 src/build/libbe/interface/GraphicsDefs.cpp   |  1 +
 src/kits/interface/Bitmap.cpp                | 22 ++++++++++++++++++--
 src/kits/interface/GraphicsDefs.cpp          |  1 +
 src/servers/app/ServerBitmap.h               |  6 +++++-
 7 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/headers/os/interface/GraphicsDefs.h b/headers/os/interface/GraphicsDefs.h
index b9209b30a6..dd1b767829 100644
--- a/headers/os/interface/GraphicsDefs.h
+++ b/headers/os/interface/GraphicsDefs.h
@@ -222,6 +222,11 @@ typedef enum {
 	B_YCbCr420			= 0x4004,	// Non-interlaced only
 		// on even scan lines: Cb0  Y0  Y1  Cb2 Y2  Y3
 		// on odd scan lines:  Cr0  Y0  Y1  Cr2 Y2  Y3
+	B_NV12				= 0x4010,	// planar 4:2:0, two planes:
+		// the Y plane (one byte a pixel), then, BytesPerRow() * height
+		// bytes in, the CbCr plane (Cb0 Cr0 Cb2 Cr2 ..., one pair for
+		// each 2x2 pixels, (height + 1) / 2 rows) with the same
+		// BytesPerRow(); for overlays (haiku-odroid-c2 port)
 
 	// Extrema points are:
 	//  Y 0 - 207 (absolute)
diff --git a/headers/private/interface/InterfacePrivate.h b/headers/private/interface/InterfacePrivate.h
index bdff9c23bc..78d0a4b733 100644
--- a/headers/private/interface/InterfacePrivate.h
+++ b/headers/private/interface/InterfacePrivate.h
@@ -22,6 +22,8 @@ namespace BPrivate {
 bool		get_mode_parameter(uint32 mode, int32& width, int32& height,
 				uint32& colorSpace);
 int32		get_bytes_per_row(color_space colorSpace, int32 width);
+int64		get_bits_length(color_space colorSpace, int32 bytesPerRow,
+				int32 height);
 
 void		get_workspaces_layout(uint32* _columns, uint32* _rows);
 void		set_workspaces_layout(uint32 columns, uint32 rows);
diff --git a/src/build/libbe/interface/Bitmap.cpp b/src/build/libbe/interface/Bitmap.cpp
index 6b50313938..be1d554b6f 100644
--- a/src/build/libbe/interface/Bitmap.cpp
+++ b/src/build/libbe/interface/Bitmap.cpp
@@ -82,6 +82,7 @@ get_raw_bytes_per_row(color_space colorSpace, int32 width)
 			bpr = 2 * width;
 			break;
 		case B_CMAP8: case B_GRAY8:
+		case B_NV12:
 			bpr = width;
 			break;
 		case B_GRAY1:
diff --git a/src/build/libbe/interface/GraphicsDefs.cpp b/src/build/libbe/interface/GraphicsDefs.cpp
index a5817fb9a8..8995f70592 100644
--- a/src/build/libbe/interface/GraphicsDefs.cpp
+++ b/src/build/libbe/interface/GraphicsDefs.cpp
@@ -168,6 +168,7 @@ bitmaps_support_space(color_space space, uint32 *supportFlags)
 		case B_RGB16_BIG:	case B_RGB15_BIG:	case B_RGBA15_BIG:
 		case B_CMAP8:		case B_GRAY8:		case B_GRAY1:
 		case B_YCbCr422: case B_YCbCr411: case B_YCbCr444: case B_YCbCr420:
+		case B_NV12:
 		case B_YUV422: case B_YUV411: case B_YUV444: case B_YUV420:
 		case B_UVL24: case B_UVL32: case B_UVLA32:
 		case B_LAB24: case B_LAB32: case B_LABA32:
diff --git a/src/kits/interface/Bitmap.cpp b/src/kits/interface/Bitmap.cpp
index 04b6ba8a75..cf4e6b3675 100644
--- a/src/kits/interface/Bitmap.cpp
+++ b/src/kits/interface/Bitmap.cpp
@@ -114,6 +114,8 @@ get_raw_bytes_per_row(color_space colorSpace, int32 width)
 			bpr = 2 * width;
 			break;
 		case B_CMAP8: case B_GRAY8:
+		case B_NV12:
+			// NV12: the Y plane's rows; the CbCr plane's are as long
 			bpr = width;
 			break;
 		case B_GRAY1:
@@ -161,6 +163,20 @@ get_bytes_per_row(color_space colorSpace, int32 width)
 	return bpr;
 }
 
+
+/*!	rief Returns the size of a bitmap's data:  height rows of
+		    bytesPerRow bytes, and for a planar color space its other
+		   planes too.
+*/
+int64
+get_bits_length(color_space colorSpace, int32 bytesPerRow, int32 height)
+{
+	int64 length = (int64)bytesPerRow * height;
+	if (colorSpace == B_NV12)
+		length += (int64)bytesPerRow * ((height + 1) / 2);
+	return length;
+}
+
 }	// namespace BPrivate
 
 
@@ -1084,7 +1100,8 @@ BBitmap::_InitObject(BRect bounds, color_space colorSpace, uint32 flags,
 	// allocate the bitmap buffer
 	if (error == B_OK) {
 		// TODO: Let the app_server return the size when it allocated the bitmap
-		size_t size = bytesPerRow * (bounds.IntegerHeight() + 1);
+		size_t size = get_bits_length(colorSpace, bytesPerRow,
+			bounds.IntegerHeight() + 1);
 
 		if ((flags & B_BITMAP_NO_SERVER_LINK) != 0) {
 			fBasePointer = (uint8*)malloc(size);
@@ -1175,7 +1192,8 @@ BBitmap::_InitObject(BRect bounds, color_space colorSpace, uint32 flags,
 						// structure bytes per row might be modified to match
 						// hardware constraints
 						link.Read<int32>(&bytesPerRow);
-						size = bytesPerRow * (bounds.IntegerHeight() + 1);
+						size = get_bits_length(colorSpace, bytesPerRow,
+							bounds.IntegerHeight() + 1);
 					}
 
 					if (fServerArea >= B_OK) {
diff --git a/src/kits/interface/GraphicsDefs.cpp b/src/kits/interface/GraphicsDefs.cpp
index 82c832b262..c65248aedf 100644
--- a/src/kits/interface/GraphicsDefs.cpp
+++ b/src/kits/interface/GraphicsDefs.cpp
@@ -234,6 +234,7 @@ bitmaps_support_space(color_space space, uint32 *supportFlags)
 		case B_RGB48: case B_RGB48_BIG:
 		case B_RGB30: case B_RGB30_BIG:
 		case B_YCbCr422: case B_YCbCr411: case B_YCbCr444: case B_YCbCr420:
+		case B_NV12:
 		case B_YUV422: case B_YUV411: case B_YUV444: case B_YUV420:
 		case B_UVL24: case B_UVL32: case B_UVLA32:
 		case B_LAB24: case B_LAB32: case B_LABA32:
diff --git a/src/servers/app/ServerBitmap.h b/src/servers/app/ServerBitmap.h
index ab04bc8c7b..363048c4b5 100644
--- a/src/servers/app/ServerBitmap.h
+++ b/src/servers/app/ServerBitmap.h
@@ -127,7 +127,11 @@ public:
 uint32
 ServerBitmap::BitsLength() const
 {
-	int64 length = fBytesPerRow * fHeight;
+	int64 length = (int64)fBytesPerRow * fHeight;
+	if (fSpace == B_NV12) {
+		// the CbCr plane after the Y plane (BPrivate::get_bits_length())
+		length += (int64)fBytesPerRow * ((fHeight + 1) / 2);
+	}
 	return (length > 0 && length <= UINT32_MAX) ? (uint32)length : 0;
 }
 
