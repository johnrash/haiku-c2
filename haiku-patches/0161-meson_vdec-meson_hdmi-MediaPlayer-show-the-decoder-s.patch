+/*!	The decoder frame an NV12 overlay buffer names instead of holding the
+	picture (meson_vdec_frame_reference, written by meson_decoder): its
+	physical address, rows and CbCr plane. Only a frame in an area of
+	meson_vdec's (the kernel's, named "meson_vdec frame"), contiguous, and as
+	large as what the overlay shows; anything else is the buffer's own
+	picture.
+*/
+status_t
+MesonHdmi::_ResolveFrameReference(const overlay_buffer_info& info,
+	const meson_hdmi_overlay_config& config, phys_addr_t& _physical,
+	uint32& _bytesPerRow, uint32& _chromaOffset)
+{
+	area_info bufferArea;
+	if (get_area_info(info.mapArea, &bufferArea) != B_OK
+		|| bufferArea.size < sizeof(meson_vdec_frame_reference)) {
+		return B_BAD_VALUE;
+	}
+	meson_vdec_frame_reference reference;
+	memcpy(&reference, bufferArea.address, sizeof(reference));
+	if (reference.magic != MESON_VDEC_FRAME_REFERENCE_MAGIC
+		|| reference.check != meson_vdec_frame_reference_check(&reference)) {
+		return B_NAME_NOT_FOUND;
+	}
+	if (reference.width < config.width || reference.height < config.height
+		|| reference.bytes_per_row < reference.width
+		|| reference.bytes_per_row % 8 != 0
+		|| reference.chroma_offset
+			< (uint64)reference.bytes_per_row * config.height
+		|| reference.chroma_offset % 8 != 0 || reference.offset % 8 != 0) {
+		return B_BAD_VALUE;
+	}
+
+	area_info frameArea;
+	if (get_area_info(reference.frames, &frameArea) != B_OK
+		|| frameArea.team != B_SYSTEM_TEAM
+		|| strncmp(frameArea.name, "meson_vdec frame", 16) != 0) {
+		return B_NOT_ALLOWED;
+	}
+	uint64 length = reference.chroma_offset
+		+ (uint64)reference.bytes_per_row * ((config.height + 1) / 2);
+	if (reference.offset > frameArea.size
+		|| length > frameArea.size - reference.offset) {
+		return B_BAD_VALUE;
+	}
+	physical_entry entry;
+	if (get_memory_map((uint8*)frameArea.address + reference.offset, length,
+			&entry, 1) != B_OK || entry.size < length) {
+		return B_BAD_VALUE;
+	}
+	_physical = entry.address;
+	_bytesPerRow = reference.bytes_per_row;
+	_chromaOffset = reference.chroma_offset;
+	return B_OK;
+}
+
