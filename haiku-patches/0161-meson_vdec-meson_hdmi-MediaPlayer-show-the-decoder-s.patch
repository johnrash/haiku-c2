diff --git a/headers/private/drivers/meson_vdec.h b/headers/private/drivers/meson_vdec.h
index a627cae4e8..b6766fd783 100644
--- a/headers/private/drivers/meson_vdec.h
+++ b/headers/private/drivers/meson_vdec.h
@@ -83,4 +83,35 @@ struct meson_vdec_frame {
 };
 
 
+/*!	A reference to a decoded frame, written by meson_decoder into a
+	meson_hdmi overlay buffer instead of the picture (see the media kit's
+	private VideoFrameReference.h): the video overlay then shows the frame
+	from the decoder's memory, without a copy. meson_hdmi takes it only for
+	a frame area of meson_vdec's (owned by the kernel, named "meson_vdec
+	frame", physically contiguous).
+*/
+#define MESON_VDEC_FRAME_REFERENCE_MAGIC	0x4d564652	// 'MVFR'
+
+struct meson_vdec_frame_reference {
+	uint32			magic;			// MESON_VDEC_FRAME_REFERENCE_MAGIC
+	uint32			check;			// meson_vdec_frame_reference_check()
+	area_id			frames;			// as meson_vdec_frame's
+	uint32			bytes_per_row;
+	uint64			offset;
+	uint32			chroma_offset;
+	uint32			width;
+	uint32			height;
+	uint32			_reserved;
+};
+
+
+static inline uint32
+meson_vdec_frame_reference_check(const struct meson_vdec_frame_reference* r)
+{
+	return r->magic ^ (uint32)r->frames ^ r->bytes_per_row
+		^ (uint32)r->offset ^ (uint32)(r->offset >> 32) ^ r->chroma_offset
+		^ (r->width << 16) ^ r->height ^ 0x5a5a5a5a;
+}
+
+
 #endif	// _MESON_VDEC_H
