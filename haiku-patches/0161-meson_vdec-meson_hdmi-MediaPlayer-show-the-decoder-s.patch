+/*!	Writes a reference to fFrame into \a buffer (B_NV12 only), and keeps the
+	frame until the buffer comes again: shown in place by the overlay.
+*/
+bool
+MesonVdecDecoder::_WriteReference(void* buffer)
+{
+	if (fReferenceCount == kMaxReferences || fFrame.frames < 0
+		|| fFrame.width < fWidth || fFrame.height < fHeight) {
+		return false;
+	}
+	meson_vdec_frame_reference reference;
+	memset(&reference, 0, sizeof(reference));
+	reference.magic = MESON_VDEC_FRAME_REFERENCE_MAGIC;
+	reference.frames = fFrame.frames;
+	reference.bytes_per_row = fFrame.bytes_per_row;
+	reference.offset = fFrame.offset;
+	reference.chroma_offset = fFrame.chroma_offset;
+	reference.width = fFrame.width;
+	reference.height = fFrame.height;
+	reference.check = meson_vdec_frame_reference_check(&reference);
+	memcpy(buffer, &reference, sizeof(reference));
+	// out of the write combining buffer before the overlay reads it
+	__sync_synchronize();
+
+	fReferences[fReferenceCount].buffer = buffer;
+	fReferences[fReferenceCount].index = fFrame.index;
+	fReferenceCount++;
+	fHaveFrame = false;
+	return true;
+}
+
+
+/*!	The buffer comes again: the frame it showed goes back to the driver. */
+void
+MesonVdecDecoder::_ReleaseReference(const void* buffer)
+{
+	for (uint32 i = 0; i < fReferenceCount; i++) {
+		if (fReferences[i].buffer != buffer)
+			continue;
+		if (fRunning) {
+			ioctl(fDevice, MESON_VDEC_RECYCLE_FRAME, &fReferences[i].index,
+				sizeof(fReferences[i].index));
+		}
+		fReferences[i] = fReferences[--fReferenceCount];
+		return;
+	}
+}
+
+
+void
+MesonVdecDecoder::_ReleaseReferences()
+{
+	for (uint32 i = 0; fRunning && i < fReferenceCount; i++) {
+		ioctl(fDevice, MESON_VDEC_RECYCLE_FRAME, &fReferences[i].index,
+			sizeof(fReferences[i].index));
+	}
+	fReferenceCount = 0;
+}
