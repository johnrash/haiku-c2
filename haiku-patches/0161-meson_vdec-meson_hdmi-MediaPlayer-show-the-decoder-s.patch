@@ -0,0 +1,29 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _VIDEO_FRAME_REFERENCE_H
+#define _VIDEO_FRAME_REFERENCE_H
+
+
+#include <SupportDefs.h>
+
+
+/*!	A request a reader passes to a video decoder with a frame
+	(media_decode_info::codec_data): the decoder may write a reference to
+	its own decoded frame into the buffer instead of the picture, if the
+	graphics driver shows such references (the ODROID-C2's meson_hdmi with
+	meson_decoder's frames). For a buffer that only the video overlay
+	shows: an overlay bitmap shared with the decoder. The decoder keeps
+	the frame until it is given the same buffer again.
+*/
+#define B_VIDEO_FRAME_REFERENCE_REQUEST	'vfrq'
+
+struct video_frame_reference_request {
+	uint32		magic;		// B_VIDEO_FRAME_REFERENCE_REQUEST
+	bool		allowed;	// in: a reference may go into this buffer
+	bool		written;	// out: the buffer holds a reference
+};
+
+
+#endif	// _VIDEO_FRAME_REFERENCE_H
