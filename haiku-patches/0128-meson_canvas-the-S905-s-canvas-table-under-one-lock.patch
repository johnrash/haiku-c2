 	fPublish(true),
 	fAudio(NULL),
 	fFrameBufferArea(-1),
@@ -826,6 +832,8 @@ MesonHdmi::~MesonHdmi()
 		delete_area(fHdmiTxArea);
 	if (fDmcArea >= 0)
 		delete_area(fDmcArea);
+	if (fCanvas != NULL)
+		put_module(MESON_CANVAS_MODULE_NAME);
 	if (fSharedArea >= 0)
 		delete_area(fSharedArea);
 	// the frame buffer stays: the kernel console may still draw into it
@@ -861,6 +869,8 @@ MesonHdmi::Init()
 	if (fDmcArea < 0)
 		return fDmcArea;
 	fDmc = (volatile uint32*)address;
+	if (get_module(MESON_CANVAS_MODULE_NAME, (module_info**)&fCanvas) != B_OK)
+		fCanvas = NULL;
 
 	void* settings = load_driver_settings("meson_hdmi");
 	if (settings != NULL) {
@@ -1283,6 +1293,10 @@ void
 MesonHdmi::_WriteCanvas(uint32 index, phys_addr_t address, uint32 bytesPerRow,
 	uint32 height, uint32 endian)
 {
+	if (fCanvas != NULL) {
+		fCanvas->write(index, address, bytesPerRow, height, endian);
+		return;
+	}
 	uint32 width = (bytesPerRow + 7) / 8;
 	fDmc[DMC_CAV_LUT_DATAL / 4] = ((address + 7) / 8) | (width << 29);
 	fDmc[DMC_CAV_LUT_DATAH / 4] = (width >> 3) | (height << 9)
