--- /dev/null
+++ b/src/add-ons/kernel/generic/meson_canvas/meson_canvas.cpp
@@ -0,0 +1,89 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * meson_canvas: writes the S905's canvas lookup table for meson_hdmi and
+ * meson_vdec under one lock (headers/private/drivers/meson_canvas.h).
+ */
+
+
+#include <KernelExport.h>
+
+#include <meson_canvas.h>
+
+
+static const phys_addr_t kDmcBase = 0xc8838000;
+
+// DMC (byte offsets)
+enum {
+	DMC_CAV_LUT_DATAL			= 0x48,
+	DMC_CAV_LUT_DATAH			= 0x4c,
+	DMC_CAV_LUT_ADDR			= 0x50,
+};
+#define CANVAS_LUT_WRITE			(1 << 9)
+#define CANVAS_ENDIAN_SHIFT			26
+
+
+static area_id sDmcArea = -1;
+static volatile uint32* sDmc;
+static spinlock sLock = B_SPINLOCK_INITIALIZER;
+
+
+static void
+canvas_write(uint32 index, phys_addr_t address, uint32 bytesPerRow,
+	uint32 height, uint32 endian)
+{
+	uint32 width = (bytesPerRow + 7) / 8;
+	cpu_status state = disable_interrupts();
+	acquire_spinlock(&sLock);
+	sDmc[DMC_CAV_LUT_DATAL / 4] = ((address + 7) / 8) | (width << 29);
+	sDmc[DMC_CAV_LUT_DATAH / 4] = (width >> 3) | (height << 9)
+		| (endian << CANVAS_ENDIAN_SHIFT);
+	sDmc[DMC_CAV_LUT_ADDR / 4] = CANVAS_LUT_WRITE | (index & 0xff);
+	(void)sDmc[DMC_CAV_LUT_DATAH / 4];
+		// the write has reached the table before the next one starts
+	release_spinlock(&sLock);
+	restore_interrupts(state);
+}
+
+
+static status_t
+std_ops(int32 op, ...)
+{
+	switch (op) {
+		case B_MODULE_INIT:
+		{
+			void* address;
+			sDmcArea = map_physical_memory("meson_canvas dmc", kDmcBase,
+				B_PAGE_SIZE, B_ANY_KERNEL_ADDRESS,
+				B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+			if (sDmcArea < 0)
+				return sDmcArea;
+			sDmc = (volatile uint32*)address;
+			return B_OK;
+		}
+
+		case B_MODULE_UNINIT:
+			delete_area(sDmcArea);
+			sDmcArea = -1;
+			sDmc = NULL;
+			return B_OK;
+	}
+	return B_ERROR;
+}
+
+
+static meson_canvas_module_info sMesonCanvasModule = {
+	{
+		MESON_CANVAS_MODULE_NAME,
+		0,
+		std_ops
+	},
+	canvas_write
+};
+
+
+module_info* modules[] = {
+	(module_info*)&sMesonCanvasModule,
+	NULL
+};
