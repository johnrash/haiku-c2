+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _MESON_CANVAS_H
+#define _MESON_CANVAS_H
+
+
+#include <module.h>
+
+
+/*!	The Amlogic S905's canvas lookup table (in the DMC): the video blocks
+	address their pictures by a canvas index, an entry giving the address,
+	the row length, the height and the byte order. An entry is written
+	through three registers in turn, so the drivers that use canvases write
+	them through this module, which does it under one lock.
+
+	The indexes in use: 0x4e (the frame buffer, U-Boot's choice) and 0x60,
+	0x61 (the video layer) by meson_hdmi; 0x80-0xbf by meson_vdec.
+*/
+
+#define MESON_CANVAS_MODULE_NAME	"generic/meson_canvas/v1"
+
+#define MESON_CANVAS_SWAP_64		7	// byte order within 64 bits
+
+typedef struct meson_canvas_module_info {
+	module_info	info;
+
+	void		(*write)(uint32 index, phys_addr_t address,
+					uint32 bytesPerRow, uint32 height, uint32 endian);
+		// address and bytesPerRow: multiples of 8
+} meson_canvas_module_info;
+
+
+#endif	// _MESON_CANVAS_H
