+/*!	Writes back and invalidates the CPU's lines of \a count pages, by
+	physical runs.
+*/
+static void
+clean_pages(const phys_addr_t* pages, uint32 count)
+{
+	uint32 first = 0;
+	for (uint32 i = 1; i <= count; i++) {
+		if (i < count && pages[i] == pages[i - 1] + B_PAGE_SIZE)
+			continue;
+		flush_cache_range(pages[first], (size_t)(i - first) * B_PAGE_SIZE);
+		first = i;
+	}
+}
+
+
+/*!	A buffer's memory and the buffer itself: once its pages are unmapped
+	and its addresses free, or were never had.
+*/
+static void
+free_buffer(mali_buffer* buffer)
+{
+	if (buffer->area >= 0)
+		delete_area(buffer->area);
+			// clones in userland keep the pages until they go
+	for (uint32 i = 0; i < buffer->heapAreaCount; i++)
+		delete_area(buffer->heapAreas[i]);
+	free(buffer->pages);
+	delete buffer;
+}
