+/*!	Memory for the buffer's pages from \c backedPages up to \a count: its
+	first area, or a heap's next one. Zeroed and written back from the
+	CPU's cache; not mapped for the GPU yet.
+*/
+status_t
+MesonMali::_BackPages(mali_buffer* buffer, uint32 count, uint32 protection)
+{
+	uint32 first = buffer->backedPages;
+	if (first > 0 && buffer->heapAreaCount == kMaxHeapAreas)
+		return B_NO_MEMORY;
+
+	// all of the C2's memory is below 4 GB, as the GPU's MMU needs
+	size_t size = (size_t)(count - first) * B_PAGE_SIZE;
+	void* address;
+	area_id area = create_area(
+		buffer->heap ? "meson_mali heap" : "meson_mali buffer", &address,
+		B_ANY_KERNEL_ADDRESS, size, B_FULL_LOCK,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA | protection);
+	if (area < 0)
+		return area;
+	for (uint32 i = first; i < count; i++) {
+		physical_entry entry;
+		get_memory_map((uint8*)address + (i - first) * B_PAGE_SIZE,
+			B_PAGE_SIZE, &entry, 1);
+		buffer->pages[i] = entry.address;
+	}
+	memset(address, 0, size);
+	clean_pages(buffer->pages + first, count - first);
+
+	if (first == 0)
+		buffer->area = area;
+	else
+		buffer->heapAreas[buffer->heapAreaCount++] = area;
+	buffer->backedPages = count;
+	return B_OK;
+}
+
+
+/*!	Doubles a heap buffer's memory, up to its size, mapped right after
+	what it had. From the job thread, while the GP waits for it.
+*/
+status_t
+MesonMali::_GrowHeap(mali_buffer* buffer)
+{
+	uint32 first = buffer->backedPages;
+	if (first == buffer->pageCount)
+		return B_DEVICE_FULL;
+	status_t status = _BackPages(buffer,
+		min_c(first * 2, buffer->pageCount), 0);
+	if (status != B_OK)
+		return status;
+
+	MutexLocker locker(fLock);
+	status = _MapPages(buffer, first, buffer->backedPages);
+	if (status != B_OK)
+		buffer->backedPages = first;
+			// the area goes with the buffer
+	return status;
+}
+
