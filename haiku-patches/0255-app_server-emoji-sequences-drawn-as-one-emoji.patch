+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef EMOJI_SEQUENCES_H
+#define EMOJI_SEQUENCES_H
+
+
+#include <Locker.h>
+#include <SupportDefs.h>
+
+
+/*!	Emoji sequences drawn as one glyph: flags (two regional indicators), ZWJ
+	sequences (a family, a profession), skin tones, keycaps, tag sequences
+	(England's flag). The app_server lays text out a character at a time;
+	for these the colour emoji font has ligatures in its GSUB table (the
+	'ccmp' feature), which are applied here as a shaper would, from the
+	font file's cmap and GSUB, read once. Variation selectors are left out
+	of the matching, as the font has no glyph for them.
+*/
+class EmojiSequences {
+public:
+	static	const int32			kMaxLength = 16;
+		// code points of a sequence, variation selectors included
+
+	static	EmojiSequences*		Default();
+
+	/*!	The sequence that may start with \a first: what follows it at
+		\a next (up to \a end) and joins it. Returns its length (code points
+		in \a codes, \a first included), 0 if nothing joins it.
+	*/
+	static	int32				Collect(uint32 first, const char* next,
+									const char* end, uint32* codes);
+
+	/*!	The colour font's glyph the longest sequence at the start of
+		\a codes becomes, and how many code points it takes (2 or more,
+		trailing variation selectors included); false if none does.
+	*/
+			bool				Match(const uint32* codes, int32 count,
+									uint32* _glyph, int32* _used);
+
+private:
+								EmojiSequences();
+
+			bool				_Load();
+			bool				_LoadTables(int fd);
+			uint32				_GlyphFor(uint32 code) const;
+			int32				_Coverage(uint32 offset, uint32 glyph) const;
+			bool				_ApplyLigature(uint32 subtable,
+									uint32* glyphs, int32* ends,
+									int32& count, int32 position) const;
+			uint16				_U16(uint32 offset) const;
+			uint32				_U32(uint32 offset) const;
+
+			BLocker				fLock;
+			int32				fLoaded;	// atomic: the tables were read
+			bool				fUsable;
+			uint32*				fGroups;
+				// cmap format 12: start, end, first glyph
+			uint32				fGroupCount;
+			uint8*				fGsub;
+			uint32				fGsubSize;
+			uint32*				fSubtables;
+				// the ligature subtables of 'ccmp', in lookup order
+				// (offsets in fGsub)
+			uint32*				fSubtableLookup;
+				// each one's lookup (the subtables of a lookup are tried
+				// in turn at a position)
+			uint32				fSubtableCount;
+};
+
+
+#endif	// EMOJI_SEQUENCES_H
diff --git a/src/servers/app/font/FontCacheEntry.cpp b/src/servers/app/font/FontCacheEntry.cpp
index 3550d45fd7..3a1704ddba 100644
--- a/src/servers/app/font/FontCacheEntry.cpp
+++ b/src/servers/app/font/FontCacheEntry.cpp
@@ -312,6 +312,25 @@ FontCacheEntry::CreateGlyph(uint32 glyphCode, FontCacheEntry* fallbackEntry,
 	if (glyph != NULL)
 		return glyph;
 
+	if ((glyphCode & kGlyphCodeGlyphIndex) != 0) {
+		// an emoji sequence's ligature: a glyph of the colour font, the
+		// fallback's or our own, by its index
+		FontEngine* engine = fallbackEntry != NULL
+			? &fallbackEntry->fEngine : &fEngine;
+		if (!engine->IsColorFont()
+			|| !engine->PrepareGlyph(glyphCode & kGlyphCodeIndex)) {
+			return NULL;
+		}
+		glyph = fGlyphCache->CacheGlyph(glyphCode, engine->DataSize(),
+			engine->DataType(), engine->Bounds(), engine->AdvanceX(),
+			engine->AdvanceY(), engine->PreciseAdvanceX(),
+			engine->PreciseAdvanceY(), engine->InsetLeft(),
+			engine->InsetRight());
+		if (glyph != NULL)
+			engine->WriteGlyphTo(glyph->data);
+		return glyph;
+	}
+
 	uint32 charCode = glyphCode & kGlyphCodeCharacter;
 	FontEngine* engine = &fEngine;
 	uint32 glyphIndex = 0;
diff --git a/src/servers/app/font/FontCacheEntry.h b/src/servers/app/font/FontCacheEntry.h
index 7c60b422b4..899841e1c6 100644
--- a/src/servers/app/font/FontCacheEntry.h
+++ b/src/servers/app/font/FontCacheEntry.h
@@ -88,7 +88,11 @@ struct GlyphCache {
 enum {
 	kGlyphCodeCharacter	= 0x001fffff,
 	kGlyphCodeEmoji		= 0x00200000,	// colour (U+FE0F)
