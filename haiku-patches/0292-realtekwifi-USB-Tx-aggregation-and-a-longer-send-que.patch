 #endif
 }
 
+/* The frames of the transfer that has ended, all of them with one status. */
+static void
+rtwn_usb_tx_done(struct rtwn_usb_softc *uc, int qid, int status)
+{
+	struct rtwn_data *data;
+	int count;
+
+	data = STAILQ_FIRST(&uc->uc_tx_active[qid]);
+	for (count = data->agg_num; count > 0 && data != NULL; count--) {
+		STAILQ_REMOVE_HEAD(&uc->uc_tx_active[qid], next);
+		rtwn_usb_txeof(uc, data, status);
+		data = STAILQ_FIRST(&uc->uc_tx_active[qid]);
+	}
+}
+
+/*
+ * USB Tx aggregation (rtw_usb_tx_agg_skb()): the data frames waiting behind
+ * this one go into its transfer, each at the next multiple of 8 bytes, and the
+ * first descriptor gives their number.
+ */
+static void
+rtwn_usb_tx_agg(struct rtwn_usb_softc *uc, struct rtwn_data *head, int qid)
+{
+	struct rtwn_tx_desc_common *txd;
+	struct rtwn_data *data;
+	int offset;
+
+	head->agg_num = 1;
+	if (!head->agg_ok)
+		return;
+
+	while (head->agg_num < uc->tx_agg_frames) {
+		data = STAILQ_FIRST(&uc->uc_tx_pending[qid]);
+		if (data == NULL || !data->agg_ok)
+			break;
+		offset = roundup2(head->buflen, 8);
+		if (offset + data->buflen > RTWN_USB_TXBUFSZ)
+			break;
+		memcpy(head->buf + offset, data->buf, data->buflen);
+		head->buflen = offset + data->buflen;
+		head->agg_num++;
+		STAILQ_REMOVE_HEAD(&uc->uc_tx_pending[qid], next);
+		STAILQ_INSERT_TAIL(&uc->uc_tx_active[qid], data, next);
+	}
+
+	if (head->agg_num > 1) {
+		txd = (struct rtwn_tx_desc_common *)head->buf;
+		txd->usb_agg_num = head->agg_num;
+		rtwn_usb_tx_checksum(txd);
+	}
+}
