+/*!	Stops the firmware, with the session's thread gone: it is let finish
+	the slice it decodes first (as Amlogic's Android driver does, for up to
+	200 ms), or until it has come to a standstill, without the rest of the
+	slice in the stream (20 ms without a CTB decoded). Stopped in the middle
+	of a picture, and reset or powered down right after, the block hung the
+	whole system now and then: its writes to memory were cut off,
+	presumably.
+*/
 void
 MesonVdec::_StopHevcProcessor()
 {
 	_SetDos(HEVC_ASSIST_MBOX1_MASK, 0);
+	bigtime_t now = system_time();
+	bigtime_t timeout = now + 200000;
+	bigtime_t lastMove = now;
+	uint32 lastCtb = _Dos(HEVC_PARSER_LCU_START);
+	while ((_Dos(HEVC_DEC_STATUS_REG) & 0xff) == HEVC_STATUS_DECODE_SLICE) {
+		snooze(500);
+		now = system_time();
+		uint32 ctb = _Dos(HEVC_PARSER_LCU_START);
+		if (ctb != lastCtb) {
+			lastCtb = ctb;
+			lastMove = now;
+		} else if (now - lastMove > 20000)
+			break;
+		if (now > timeout) {
+			INFO("HEVC stop: the slice is not decoded after 200 ms (CTB %#"
+				B_PRIx32 ")\n", ctb);
+			break;
+		}
+	}
 	_SetDos(HEVC_MPSR, 0);
 	_SetDos(HEVC_CPSR, 0);
 	// what the processor's DMA still does
@@ -278,9 +324,11 @@ MesonVdec::_StopHevcProcessor()
 		spin(10);
 	}
 	_SetDos(HEVC_STREAM_CONTROL, 0);
-	_SetDos(DOS_SW_RESET3, 0x000ed918);
-	spin(10);
-	_SetDos(DOS_SW_RESET3, 0);
+	if (fFatal || fDecodeErrors > 0 || fBadPictures > 0) {
+		INFO("HEVC session ended: %" B_PRIu32 " reports, %" B_PRIu32
+			" slices decoded, %" B_PRIu32 " skipped\n", fHevcReports,
+			fHevcSlices, fHevcSkipped);
+	}
 }
 
 
