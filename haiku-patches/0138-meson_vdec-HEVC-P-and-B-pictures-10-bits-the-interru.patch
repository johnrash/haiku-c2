+/*static*/ status_t
+MesonVdec::_HevcThread(void* data)
+{
+	MesonVdec* device = (MesonVdec*)data;
+	while (device->fRunning) {
+		acquire_sem_etc(device->fSetupSem, 1, B_RELATIVE_TIMEOUT,
+			kPollInterval);
+		if (!device->fRunning)
+			break;
+		device->_PollHevc();
+	}
+	return B_OK;
+}
+
+
+/*!	The mailbox interrupt: the firmware has something to report. */
+bool
+MesonVdec::_HevcInterrupt()
+{
+	if (!fRunning)
+		return false;
+	_SetDos(HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	release_sem_etc(fSetupSem, 1, B_DO_NOT_RESCHEDULE);
+	return true;
+}
