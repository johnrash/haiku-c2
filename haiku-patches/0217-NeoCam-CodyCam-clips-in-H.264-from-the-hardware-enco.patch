+/*!	Writes the frames it is given (B_RGB32) into a Matroska file at a
+	constant frame rate: a frame that came late is written again
 	for the frames it missed, one that came early is left out, so that the
 	video plays at the speed it was taken, also when the camera lowers its
-	rate in low light. Encoding runs in a thread of its own; AddFrame() only
-	copies the frame. An encoder that can't keep up leaves time out of the
+	rate in low light. The video is H.264 where the S905's encoder can take
+	it (meson_encoder), else MPEG-4. Encoding runs in a thread of its own;
+	AddFrame() only copies the frame. An encoder that can't keep up leaves time out of the
 	video rather than falling ever further behind.
 */
 class VideoRecorder {
@@ -36,6 +37,11 @@ public:
 
 			bool				IsRecording() const { return fFile != NULL; }
 			const char*			Path() const { return fPath.String(); }
+			const char*			CodecName() const
+									{ return fCodecName.String(); }
+
+	static	bool				CanEncodeInHardware();
+									// H.264 by the S905's encoder
 			bigtime_t			Duration() const;
 
 private:
@@ -46,6 +52,7 @@ private:
 			BMediaFile*			fFile;
 			BMediaTrack*		fTrack;
 			BString				fPath;
+			BString				fCodecName;
 			size_t				fFrameSize;
 			float				fFrameRate;
 
