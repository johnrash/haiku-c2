--- a/src/apps/codycam/VideoRecorder.cpp
+++ b/src/apps/codycam/VideoRecorder.cpp
@@ -19,7 +19,8 @@
 
 
 static const char* kFileType = "video/x-matroska";
-static const char* kCodecName = "mpeg4";
+// the S905's H.264 encoder (meson_encoder) where there is one, else FFmpeg's
+static const char* kCodecNames[] = { "h264", "mpeg4" };
 
 
 VideoRecorder::VideoRecorder()
@@ -83,31 +84,47 @@ VideoRecorder::Start(const char* path, uint32 width, uint32 height,
 	inFormat.u.raw_video.display.line_count = height;
 	inFormat.u.raw_video.display.bytes_per_row = bytesPerRow;
 
-	media_format outFormat;
-	media_codec_info codec;
-	cookie = 0;
-	found = false;
-	while (get_next_encoder(&cookie, &fileFormat, &inFormat, &outFormat,
-			&codec) == B_OK) {
-		if (strcmp(codec.short_name, kCodecName) == 0) {
-			found = true;
-			break;
-		}
-	}
-	if (!found)
-		return B_MEDIA_BAD_FORMAT;
-
 	entry_ref ref;
 	status_t status = get_ref_for_path(path, &ref);
 	if (status != B_OK)
 		return status;
 
-	fFile = new BMediaFile(&ref, &fileFormat);
-	status = fFile->InitCheck();
-	if (status == B_OK) {
-		fTrack = fFile->CreateTrack(&inFormat, &codec);
-		if (fTrack == NULL)
-			status = B_MEDIA_BAD_FORMAT;
+	// the first codec that sets up (the hardware's may be busy, or have no
+	// microcode)
+	status = B_MEDIA_BAD_FORMAT;
+	for (size_t i = 0; i < sizeof(kCodecNames) / sizeof(kCodecNames[0]);
+			i++) {
+		media_format outFormat;
+		media_codec_info codec;
+		cookie = 0;
+		found = false;
+		while (get_next_encoder(&cookie, &fileFormat, &inFormat, &outFormat,
+				&codec) == B_OK) {
+			if (strcmp(codec.short_name, kCodecNames[i]) == 0) {
+				found = true;
+				break;
+			}
+		}
+		if (!found)
+			continue;
+
+		fFile = new BMediaFile(&ref, &fileFormat);
+		status = fFile->InitCheck();
+		if (status == B_OK) {
+			fTrack = fFile->CreateTrack(&inFormat, &codec);
+			if (fTrack == NULL)
+				status = B_MEDIA_BAD_FORMAT;
+			else if ((status = fTrack->InitCheck()) != B_OK) {
+				fFile->ReleaseTrack(fTrack);
+				fTrack = NULL;
+			}
+		}
+		if (status == B_OK) {
+			fCodecName = codec.short_name;
+			break;
+		}
+		delete fFile;
+		fFile = NULL;
 	}
 	if (status == B_OK)
 		status = fFile->CommitHeader();
@@ -252,6 +269,38 @@ VideoRecorder::_Thread()
 }
 
 
+/*!	Whether there is a hardware H.264 encoder to use: the device, and the
+	encoder plugin (which needs its microcode to set up).
+*/
+/*static*/ bool
+VideoRecorder::CanEncodeInHardware()
+{
+	if (!BEntry("/dev/video/meson_venc/0").Exists())
+		return false;
+	media_file_format fileFormat;
+	media_format inFormat;
+	inFormat.type = B_MEDIA_RAW_VIDEO;
+	inFormat.u.raw_video = media_raw_video_format::wildcard;
+	media_format outFormat;
+	media_codec_info codec;
+	int32 cookie = 0;
+	while (get_next_file_format(&cookie, &fileFormat) == B_OK) {
+		if ((fileFormat.capabilities & media_file_format::B_WRITABLE) == 0
+			|| strcmp(fileFormat.mime_type, kFileType) != 0) {
+			continue;
+		}
+		int32 encoderCookie = 0;
+		while (get_next_encoder(&encoderCookie, &fileFormat, &inFormat,
+				&outFormat, &codec) == B_OK) {
+			if (strcmp(codec.short_name, kCodecNames[0]) == 0)
+				return true;
+		}
+		break;
+	}
+	return false;
+}
+
+
 void
 VideoRecorder::_Cleanup()
 {
