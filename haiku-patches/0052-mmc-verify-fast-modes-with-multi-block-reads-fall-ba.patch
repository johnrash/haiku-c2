+static const uint32 kSdDefaultSpeed = 25000;	// kHz
 	// per I/O operation: 64 pages cover the 511 blocks of one command
 static const uint32 kXtalRate = 24000000;
 static const uint32 kFclkDiv2Rate = 1000000000;
@@ -184,7 +188,7 @@ dcache_maintain(phys_addr_t physical, size_t length, bool invalidate)
