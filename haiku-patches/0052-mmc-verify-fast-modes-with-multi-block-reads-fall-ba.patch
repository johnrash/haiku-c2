+				chunk / kBlockSize, write);
+			if (command == SD_READ_MULTIPLE_BLOCKS
+				|| command == SD_WRITE_MULTIPLE_BLOCKS) {
+				status_t stopStatus = _Execute(SD_STOP_TRANSMISSION, 0,
+					&response, 0, 0, false);
+				if (status == B_OK)
+					status = stopStatus;
+			}
+			// once more at a safe speed, if this was a fast one
+			if (status == B_OK || !_SlowDown())
+				break;
 		}
 		if (status != B_OK) {
 			ERROR("%s of %" B_PRIuGENADDR " bytes at %" B_PRIdOFF
@@ -1097,19 +1149,18 @@ supports_device(device_node* parent)
