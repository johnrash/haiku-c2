 class MesonMmc {
@@ -225,6 +229,7 @@ private:
 									generic_size_t& vecOffset,
 									generic_size_t length);
 			status_t			_ApplyClock();
+			bool				_SlowDown();
 			bool				_TestRead();
 			bool				_IsMmc() const;
 			response_type		_ResponseType(uint8 command,
@@ -420,8 +425,50 @@ MesonMmc::SetClock(uint32 kilohertz)
 	if (kilohertz == 0)
 		return B_BAD_VALUE;
 	MutexLocker locker(fLock);
+	bool sdHighSpeed = !_IsMmc() && kilohertz > kSdDefaultSpeed;
+	if (sdHighSpeed && !driver_setting_enabled("sd_high_speed")) {
+		fClockKilohertz = kSdDefaultSpeed;
+		_ApplyClock();
+		return B_NOT_ALLOWED;
+	}
 	fClockKilohertz = kilohertz;
-	return _ApplyClock();
+	status_t status = _ApplyClock();
+	if (status != B_OK || !sdHighSpeed)
+		return status;
+
+	// SD high speed: only with clean multi-block reads at it
+	if (!_TestRead()) {
+		ERROR("%#" B_PRIxPHYSADDR ": SD: test reads at %" B_PRIu32 " kHz "
+			"failed, back to %" B_PRIu32 " kHz\n", fPhysicalBase, kilohertz,
+			kSdDefaultSpeed);
+		fClockKilohertz = kSdDefaultSpeed;
+		_ApplyClock();
+		return B_ERROR;
+	}
+	return B_OK;
+}
+
+
+/*!	After a failed transfer in a fast mode: SD back to its default speed,
+	eMMC DDR down to half the clock. True if there was something to slow
+	down (and the transfer should be retried).
+*/
+bool
+MesonMmc::_SlowDown()
+{
+	uint32 slower;
+	if (_IsMmc())
+		slower = fDDR && fClockKilohertz > 26000 ? 26000 : 0;
+	else
+		slower = fClockKilohertz > kSdDefaultSpeed ? kSdDefaultSpeed : 0;
+	if (slower == 0)
+		return false;
+	ERROR("%#" B_PRIxPHYSADDR ": transfer errors at %" B_PRIu32 " kHz%s, "
+		"slowing down to %" B_PRIu32 " kHz\n", fPhysicalBase,
+		fClockKilohertz, fDDR ? " DDR" : "", slower);
+	fClockKilohertz = slower;
+	_ApplyClock();
+	return true;
 }
 
 
