+/*!	The semaphore released when another display is connected, owned by the
+	calling team (userland can't acquire the kernel's semaphores): one, for
+	app_server; a new one if its team is gone.
+*/
+status_t
+MesonHdmi::DisplayChangeSemaphore(sem_id* _semaphore)
+{
+	MutexLocker locker(fModeLock);
+	sem_info info;
+	if (fDisplayChangeSem < 0
+		|| get_sem_info(fDisplayChangeSem, &info) != B_OK) {
+		sem_id semaphore = create_sem(0, "meson_hdmi display change");
+		if (semaphore < 0)
+			return semaphore;
+		thread_info threadInfo;
+		if (get_thread_info(find_thread(NULL), &threadInfo) != B_OK
+			|| set_sem_owner(semaphore, threadInfo.team) != B_OK) {
+			delete_sem(semaphore);
+			return B_ERROR;
+		}
+		fDisplayChangeSem = semaphore;
+	}
+	*_semaphore = fDisplayChangeSem;
+	return B_OK;
+}
+
+
 /*!	Puts U-Boot's registers and frame buffer back; works from KDL too. */
 void
 MesonHdmi::RestoreBootMode()
@@ -2794,6 +2830,15 @@ device_control(void* cookie, uint32 op, void* buffer, size_t length)
 				return B_BAD_ADDRESS;
 			return device->SetDpmsMode(mode);
 		}
+
+		case MESON_HDMI_GET_DISPLAY_CHANGE_SEMAPHORE:
+		{
+			sem_id semaphore;
+			status_t status = device->DisplayChangeSemaphore(&semaphore);
+			if (status != B_OK)
+				return status;
+			return user_memcpy(buffer, &semaphore, sizeof(semaphore));
+		}
 	}
 	return B_DEV_INVALID_IOCTL;
 }
