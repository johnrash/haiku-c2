+/*!	Watches for another display being connected, if the accelerant can tell
+	(B_ACCELERANT_DISPLAY_CHANGE_SEMAPHORE): the mode list is read again,
+	and the desktop picks a mode for the display.
+*/
+void
+AccelerantHWInterface::_StartDisplayChangeWatcher()
+{
+	accelerant_display_change_semaphore displayChangeSemaphore
+		= (accelerant_display_change_semaphore)fAccelerantHook(
+			B_ACCELERANT_DISPLAY_CHANGE_SEMAPHORE, NULL);
+	if (displayChangeSemaphore == NULL)
+		return;
+	fDisplayChangeSemaphore = displayChangeSemaphore();
+	if (fDisplayChangeSemaphore < 0)
+		return;
+	fDisplayChangeThread = spawn_thread(&_DisplayChangeWatcher,
+		"display change watcher", B_NORMAL_PRIORITY, this);
+	if (fDisplayChangeThread >= 0)
+		resume_thread(fDisplayChangeThread);
+}
+
+
+/*static*/ status_t
+AccelerantHWInterface::_DisplayChangeWatcher(void* data)
+{
+	AccelerantHWInterface* interface = (AccelerantHWInterface*)data;
+	while (true) {
+		status_t status = acquire_sem(interface->fDisplayChangeSemaphore);
+		if (status == B_INTERRUPTED)
+			continue;
+		if (status != B_OK)
+			break;
+
+		{
+			AutoWriteLocker locker(interface);
+			delete[] interface->fModeList;
+			interface->fModeList = NULL;
+			interface->fModeCount = 0;
+			interface->_UpdateModeList();
+		}
+		interface->_NotifyDisplayChanged();
+	}
+	return B_OK;
+}
+
+
 status_t
 AccelerantHWInterface::Shutdown()
 {
+	if (fDisplayChangeThread >= 0) {
+		// the semaphore is ours: deleting it ends the watcher
+		delete_sem(fDisplayChangeSemaphore);
+		status_t result;
+		wait_for_thread(fDisplayChangeThread, &result);
+		fDisplayChangeThread = -1;
+		fDisplayChangeSemaphore = -1;
+	}
+
 	if (fAccelerantHook != NULL) {
 		uninit_accelerant uninitAccelerant
 			= (uninit_accelerant)fAccelerantHook(B_UNINIT_ACCELERANT, NULL);
