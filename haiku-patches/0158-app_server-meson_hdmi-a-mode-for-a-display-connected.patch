+/*!	Released by the driver when another display is connected; the mode list
+	and EDID in the shared info are the new display's then.
+*/
+static sem_id
+meson_accelerant_display_change_semaphore(void)
+{
+	sem_id semaphore;
+	if (ioctl(sInfo.device, MESON_HDMI_GET_DISPLAY_CHANGE_SEMAPHORE,
+			&semaphore, sizeof(semaphore)) != 0) {
+		return B_ERROR;
+	}
+	return semaphore;
+}
