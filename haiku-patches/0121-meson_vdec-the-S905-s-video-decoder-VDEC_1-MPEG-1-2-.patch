+	AV_SCRATCH_B				= 0x272c,	// workspace + 5 KB
+	AV_SCRATCH_C				= 0x2730,	// error count
+	AV_SCRATCH_D				= 0x2734,	// the frame's stream offset
+	AV_SCRATCH_E				= 0x2738,	// waiting for a frame?
+	AV_SCRATCH_F				= 0x273c,	// 1: fatal error
+	MPEG1_2_REG					= 0x3004,
+	PIC_HEAD_INFO				= 0x300c,
+	POWER_CTL_VLD				= 0x3020,
+	M4_CONTROL_REG				= 0x30a4,
