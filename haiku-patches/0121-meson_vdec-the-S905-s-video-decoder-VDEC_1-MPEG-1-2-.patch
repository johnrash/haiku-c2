+	ASSIST_MBOX1_MASK			= 0x01d8,
+	MPSR						= 0x0c04,
+	CPSR						= 0x0c84,
+	IMEM_DMA_CTRL				= 0x0d00,
+	IMEM_DMA_ADR				= 0x0d04,
+	IMEM_DMA_COUNT				= 0x0d08,
+	PSCALE_CTRL					= 0x2444,
+	GCLK_EN						= 0x260c,
+	MDEC_PIC_DC_CTRL			= 0x2638,
+	AV_SCRATCH_0				= 0x2700,	// to _7: the frames' canvases
+	AV_SCRATCH_4				= 0x2710,	// later: sequence info
+	AV_SCRATCH_5				= 0x2714,	// later: picture info
+	AV_SCRATCH_6				= 0x2718,	// later: the width
+	AV_SCRATCH_7				= 0x271c,	// later: the height
+	AV_SCRATCH_8				= 0x2720,	// frame handed back
+	AV_SCRATCH_9				= 0x2724,	// frame decoded
