+	VLD_MEM_VIFIFO_LEVEL		= 0x311c,
+	VLD_MEM_VIFIFO_BUF_CNTL		= 0x3120,
+	VLD_MEM_VIFIFO_WRAP_COUNT	= 0x3144,
+	DOS_SW_RESET0				= 0xfc00,
+	DOS_GCLK_EN0				= 0xfc04,
+	DOS_GEN_CTRL0				= 0xfc08,
+	DOS_MEM_PD_VDEC				= 0xfcc0,
+	DOS_VDEC_MCRCC_STALL_CTRL	= 0xfd00,
