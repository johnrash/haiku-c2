+#define IMEM_DMA_BUSY				(1 << 15)
+#define MDEC_PIC_DC_NV12			(1 << 17)
+#define MDEC_PIC_DC_BIT31			(1u << 31)
+#define VIFIFO_CONTROL_INIT			(1 << 0)
+#define VIFIFO_CONTROL_RUN			0x00110406
+	// FIFO count 0x11, fill on level, empty and fill enable
+#define VIFIFO_BUF_CNTL_INIT		(1 << 0)
+#define VIFIFO_BUF_CNTL_MANUAL		(1 << 1)
+#define BUFFEROUT_SKIP				0x00fe0000
+#define PIC_INFO_PROGRESSIVE		(1 << 15)
+
+// ESPARSER (byte offsets from its base)
+enum {
+	PARSER_CONTROL				= 0x00,
+	PARSER_FETCH_ADDR			= 0x04,
+	PARSER_FETCH_CMD			= 0x08,
+	PARSER_CONFIG				= 0x14,
+	PFIFO_WR_PTR				= 0x18,
+	PFIFO_RD_PTR				= 0x1c,
+	PARSER_SEARCH_PATTERN		= 0x24,
+	PARSER_SEARCH_MASK			= 0x28,
+	PARSER_INT_ENABLE			= 0x2c,
+	PARSER_INT_STATUS			= 0x30,
+	PARSER_ES_CONTROL			= 0x5c,
+	PARSER_VIDEO_START_PTR		= 0x80,
+	PARSER_VIDEO_END_PTR		= 0x84,
+	PARSER_VIDEO_WP				= 0x88,
+	PARSER_VIDEO_HOLE			= 0x90,
+};
+#define PARSER_START_SEARCH			0x03
+#define PARSER_START_WRITE_SEARCH	0x23	// with the pack size at bit 8
+#define PARSER_FETCH_ENDIAN_64		(7 << 27)
+#define PARSER_INT_START_CODE		(1 << 0)
+#define PARSER_INT_HOST_START_CODE	(1 << 8)
