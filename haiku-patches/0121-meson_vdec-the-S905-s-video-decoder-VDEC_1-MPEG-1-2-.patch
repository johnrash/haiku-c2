+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _MESON_VDEC_H
+#define _MESON_VDEC_H
+
+
+#include <Drivers.h>
+
+
+/*!	The Amlogic S905's (Meson GXBB) video decoder, /dev/video/meson_vdec/0.
+	One session at a time: start it with the codec's firmware, write the
+	compressed stream (an elementary stream: MPEG-1/2 so far), take the
+	decoded frames in display order and give each back when done with it.
+	The frames are NV12 (a Y plane, then interleaved Cb and Cr at half the
+	height) in one area the caller clones; their contents are valid from
+	GET_FRAME until RECYCLE_FRAME.
+*/
+
+#define MESON_VDEC_DEVICE		"/dev/video/meson_vdec/0"
+
+enum {
+	MESON_VDEC_START = B_DEVICE_OP_CODES_END + 1,
+		// meson_vdec_start
+	MESON_VDEC_WRITE,
+		// meson_vdec_write: returns once the decoder took the data
+	MESON_VDEC_GET_FRAME,
+		// meson_vdec_frame: waits for the next decoded frame
+	MESON_VDEC_RECYCLE_FRAME,
+		// uint32: the index of a frame GET_FRAME gave
+	MESON_VDEC_END_OF_STREAM,
+		// no data: the stream ends, the decoder hands out what it holds
+	MESON_VDEC_STOP,
+		// no data: ends the session (closing the device does too)
+};
+
+enum {
+	MESON_VDEC_MPEG12 = 1,
+};
+
+struct meson_vdec_start {
+	uint32			codec;			// in: MESON_VDEC_*
+	const void*		firmware;		// in: the codec's firmware image
+	size_t			firmware_size;	// in
+	uint32			width;			// in: the picture's, from the stream
+	uint32			height;			// in
+	uint32			frame_count;	// out: frames in the area
+	size_t			frame_size;		// out: bytes per frame
+	area_id			frames;			// out: all frames, one after the other
+};
+
+struct meson_vdec_write {
+	const void*		data;
+	size_t			size;
+};
+
+#define MESON_VDEC_FRAME_END_OF_STREAM	0x1
+	// no frame: the stream ended and every frame was handed out
+
+struct meson_vdec_frame {
+	bigtime_t		timeout;		// in: relative
+	uint32			index;			// out: which frame of the area
+	uint32			flags;			// out: MESON_VDEC_FRAME_*
+	uint32			width;			// out: the picture's
+	uint32			height;
+	uint32			bytes_per_row;	// out: of Y and of CbCr
+	uint32			chroma_offset;	// out: CbCr, from the frame's start
+};
+
+
+#endif	// _MESON_VDEC_H
