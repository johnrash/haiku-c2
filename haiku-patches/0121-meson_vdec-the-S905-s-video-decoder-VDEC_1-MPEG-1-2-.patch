+static status_t
+map_registers(const char* name, phys_addr_t base, size_t size, area_id& area,
+	volatile uint32*& registers)
+{
+	phys_addr_t page = base & ~(phys_addr_t)(B_PAGE_SIZE - 1);
+	size_t mapSize = ROUNDUP(base + size - page, B_PAGE_SIZE);
+	void* address;
+	area = map_physical_memory(name, page, mapSize, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	if (area < 0)
+		return area;
+	registers = (volatile uint32*)((addr_t)address + (base - page));
+	return B_OK;
+}
+
+
+status_t
+MesonVdec::Init(phys_addr_t dos, phys_addr_t parser, int32 vdecIrq,
+	int32 parserIrq)
+{
+	status_t status;
+	if ((status = map_registers("meson_vdec dos", dos, 0x10000, fDosArea,
+			fDos)) != B_OK
+		|| (status = map_registers("meson_vdec parser", parser, 0xe4,
+			fParserArea, fParser)) != B_OK
+		|| (status = map_registers("meson_vdec ao", kAoBase, B_PAGE_SIZE,
+			fAoArea, fAo)) != B_OK
+		|| (status = map_registers("meson_vdec hhi", kHhiBase, B_PAGE_SIZE,
+			fHhiArea, fHhi)) != B_OK
+		|| (status = map_registers("meson_vdec reset", kResetBase,
+			B_PAGE_SIZE, fResetArea, fReset)) != B_OK
+		|| (status = map_registers("meson_vdec dmc", kDmcBase, B_PAGE_SIZE,
+			fDmcArea, fDmc)) != B_OK) {
+		return status;
+	}
+
+	fFrameSem = create_sem(0, "meson_vdec frames");
+	fParserSem = create_sem(0, "meson_vdec parser");
+	if (fFrameSem < 0 || fParserSem < 0)
+		return B_NO_MORE_SEMS;
+
+	// interrupts are masked at the source until a session starts
+	if (vdecIrq > 0 && install_io_interrupt_handler(vdecIrq,
+			&_VdecInterrupt, this, 0) == B_OK) {
+		fVdecIrq = vdecIrq;
+	}
+	if (parserIrq > 0 && install_io_interrupt_handler(parserIrq,
+			&_ParserInterrupt, this, 0) == B_OK) {
+		fParserIrq = parserIrq;
+	}
+	INFO("DOS %#" B_PRIxPHYSADDR ", parser %#" B_PRIxPHYSADDR
+		", interrupts %" B_PRId32 " and %" B_PRId32 "\n", dos, parser,
+		fVdecIrq, fParserIrq);
+	return B_OK;
+}
+
+
+//	#pragma mark - interrupts
+
+
+/*!	Takes a frame the firmware reported, or its fatal error. Called with
+	fStateLock held, from the interrupt or from a waiting thread.
+*/
+bool
+MesonVdec::_CheckDecoder()
+{
+	if (!fRunning)
+		return false;
+	_SetDos(ASSIST_MBOX1_CLR_REG, 1);
+	if (_Dos(AV_SCRATCH_F) == 1) {
+		if (!fFatal)
+			release_sem_etc(fFrameSem, 1, B_DO_NOT_RESCHEDULE);
+		fFatal = true;
+		return true;
+	}
+	uint32 report = _Dos(AV_SCRATCH_9);
+	if (report == 0)
+		return false;
+	if ((report & BUFFEROUT_SKIP) == BUFFEROUT_SKIP) {
+		fFramesSkipped++;
+	} else {
+		uint32 index = ((report & 0xf) - 1) & (kFrameCount - 1);
+		if (fQueueCount < kFrameCount) {
+			uint32 slot = (fQueueHead + fQueueCount) % kFrameCount;
+			fQueue[slot] = index;
+			fQueueInfo[slot] = _Dos(AV_SCRATCH_5);
+			fQueueCount++;
+			fFramesDecoded++;
+			release_sem_etc(fFrameSem, 1, B_DO_NOT_RESCHEDULE);
+		}
+	}
+	_SetDos(AV_SCRATCH_9, 0);
+	return true;
+}
+
+
+/*!	Whether the parser found the marker after the data it was given (all of
+	it is in the VIFIFO then). Called with fStateLock held.
+*/
+bool
+MesonVdec::_CheckParser()
+{
+	uint32 status = _Parser(PARSER_INT_STATUS);
+	if (status == 0)
+		return false;
+	_SetParser(PARSER_INT_STATUS, status);
+	if ((status & PARSER_INT_START_CODE) == 0)
+		return false;
+	_SetParser(PFIFO_RD_PTR, 0);
+	_SetParser(PFIFO_WR_PTR, 0);
+	release_sem_etc(fParserSem, 1, B_DO_NOT_RESCHEDULE);
+	return true;
+}
+
+
+/*static*/ int32
+MesonVdec::_VdecInterrupt(void* data)
+{
+	MesonVdec* device = (MesonVdec*)data;
+	SpinLocker locker(device->fStateLock);
+	device->fVdecInterrupts++;
+	return device->_CheckDecoder() ? B_HANDLED_INTERRUPT
+		: B_UNHANDLED_INTERRUPT;
+}
+
+
+/*static*/ int32
+MesonVdec::_ParserInterrupt(void* data)
+{
+	MesonVdec* device = (MesonVdec*)data;
+	SpinLocker locker(device->fStateLock);
+	device->fParserInterrupts++;
+	return device->_CheckParser() ? B_HANDLED_INTERRUPT
+		: B_UNHANDLED_INTERRUPT;
+}
+
+
+//	#pragma mark - buffers
+
+
+/*!	Physically contiguous memory below 4 GB, cleared and its cache lines
+	written back. With \a userReadable, other teams can clone it to read.
+*/
+status_t
+MesonVdec::_AllocateBuffer(const char* name, size_t size, dma_buffer& buffer,
+	bool userReadable)
+{
+	size = ROUNDUP(size, B_PAGE_SIZE);
+	void* address;
+	buffer.area = create_area(name, &address, B_ANY_KERNEL_ADDRESS, size,
+		B_32_BIT_CONTIGUOUS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA
+			| (userReadable ? B_READ_AREA | B_CLONEABLE_AREA : 0));
+	if (buffer.area < 0)
+		return buffer.area;
+	physical_entry entry;
+	get_memory_map(address, B_PAGE_SIZE, &entry, 1);
+	buffer.address = (uint8*)address;
+	buffer.physical = entry.address;
+	buffer.size = size;
+	memset(address, 0, size);
+	flush_cache_range(buffer.physical, size);
+	return B_OK;
+}
+
+
+void
+MesonVdec::_FreeBuffer(dma_buffer& buffer)
+{
+	if (buffer.area >= 0)
+		delete_area(buffer.area);
+	buffer = dma_buffer();
+}
+
+
+void
+MesonVdec::_WriteCanvas(uint32 index, phys_addr_t address,
+	uint32 bytesPerRow, uint32 height)
+{
+	uint32 width = bytesPerRow / 8;
+	fDmc[DMC_CAV_LUT_DATAL / 4] = (address / 8) | (width << 29);
+	fDmc[DMC_CAV_LUT_DATAH / 4] = (width >> 3) | (height << 9)
+		| (CANVAS_SWAP_64 << CANVAS_ENDIAN_SHIFT);
+	fDmc[DMC_CAV_LUT_ADDR / 4] = CANVAS_LUT_WRITE | index;
+	(void)fDmc[DMC_CAV_LUT_DATAH / 4];
+}
+
+
+//	#pragma mark - hardware sequences
+
+
+void
+MesonVdec::_PowerUp()
+{
+	fHhi[HHI_GCLK_MPEG1 / 4] |= GCLK_MPEG1_DOS_PARSER;
+	fHhi[HHI_GCLK_MPEG0 / 4] |= GCLK_MPEG0_DOS;
+	uint32 clock = fHhi[HHI_VDEC_CLK_CNTL / 4]
+		& ~(VDEC_CLK_SOURCE_MASK | VDEC_CLK_DIVIDER_MASK | VDEC_CLK_GATE);
+	fHhi[HHI_VDEC_CLK_CNTL / 4]
+		= clock | (VDEC_CLK_SOURCE_FCLK_DIV3 << VDEC_CLK_SOURCE_SHIFT);
+	fHhi[HHI_VDEC_CLK_CNTL / 4] |= VDEC_CLK_GATE;
+
+	fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] &= ~AO_SLEEP_VDEC1;
+	spin(20);
+
+	_SetDos(DOS_SW_RESET0, 0xfffffffc);
+	_SetDos(DOS_SW_RESET0, 0);
+	_SetDos(DOS_GCLK_EN0, 0x3ff);
+	_SetDos(DOS_MEM_PD_VDEC, 0);
+	fAo[AO_RTI_GEN_PWR_ISO0 / 4] &= ~AO_ISO_VDEC1;
+	_SetDos(DOS_VDEC_MCRCC_STALL_CTRL, 0);
+	_SetDos(GCLK_EN, 0x3ff);
+	_SetDos(MDEC_PIC_DC_CTRL, _Dos(MDEC_PIC_DC_CTRL) & ~MDEC_PIC_DC_BIT31);
+}
+
+
+void
+MesonVdec::_PowerDown()
+{
+	_SetDos(MPSR, 0);
+	_SetDos(CPSR, 0);
+	_SetDos(ASSIST_MBOX1_MASK, 0);
+	_SetDos(DOS_SW_RESET0, (1 << 12) | (1 << 11));
+	_SetDos(DOS_SW_RESET0, 0);
+	(void)_Dos(DOS_SW_RESET0);
+	fAo[AO_RTI_GEN_PWR_ISO0 / 4] |= AO_ISO_VDEC1;
+	_SetDos(DOS_MEM_PD_VDEC, 0xffffffff);
+	fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] |= AO_SLEEP_VDEC1;
+	fHhi[HHI_VDEC_CLK_CNTL / 4] &= ~VDEC_CLK_GATE;
+	fHhi[HHI_GCLK_MPEG0 / 4] &= ~GCLK_MPEG0_DOS;
+	fHhi[HHI_GCLK_MPEG1 / 4] &= ~GCLK_MPEG1_DOS_PARSER;
+}
+
+
+void
+MesonVdec::_SetupVififo()
+{
+	uint32 start = fVififo.physical;
+	uint32 end = start + fVififo.size - 8;
+	_SetDos(VLD_MEM_VIFIFO_CONTROL, 0);
+	_SetDos(VLD_MEM_VIFIFO_WRAP_COUNT, 0);
+	_SetDos(POWER_CTL_VLD, 1 << 4);
+	_SetDos(VLD_MEM_VIFIFO_START_PTR, start);
+	_SetDos(VLD_MEM_VIFIFO_CURR_PTR, start);
+	_SetDos(VLD_MEM_VIFIFO_END_PTR, end);
+	_SetDos(VLD_MEM_VIFIFO_CONTROL,
+		_Dos(VLD_MEM_VIFIFO_CONTROL) | VIFIFO_CONTROL_INIT);
+	_SetDos(VLD_MEM_VIFIFO_CONTROL,
+		_Dos(VLD_MEM_VIFIFO_CONTROL) & ~VIFIFO_CONTROL_INIT);
+	_SetDos(VLD_MEM_VIFIFO_BUF_CNTL, VIFIFO_BUF_CNTL_MANUAL);
+	_SetDos(VLD_MEM_VIFIFO_WP, start);
+	_SetDos(VLD_MEM_VIFIFO_BUF_CNTL,
+		_Dos(VLD_MEM_VIFIFO_BUF_CNTL) | VIFIFO_BUF_CNTL_INIT);
+	_SetDos(VLD_MEM_VIFIFO_BUF_CNTL,
+		_Dos(VLD_MEM_VIFIFO_BUF_CNTL) & ~VIFIFO_BUF_CNTL_INIT);
+	_SetDos(VLD_MEM_VIFIFO_CONTROL,
+		_Dos(VLD_MEM_VIFIFO_CONTROL) | VIFIFO_CONTROL_RUN);
+}
+
+
+status_t
+MesonVdec::_LoadFirmware(const void* userFirmware)
+{
+	if (!IS_USER_ADDRESS(userFirmware)
+		|| user_memcpy(fFirmware.address, userFirmware, kFirmwareSize)
+			!= B_OK) {
+		return B_BAD_ADDRESS;
+	}
+	flush_cache_range(fFirmware.physical, kFirmwareSize);
+
+	_SetDos(MPSR, 0);
+	_SetDos(CPSR, 0);
+	_SetDos(MDEC_PIC_DC_CTRL, _Dos(MDEC_PIC_DC_CTRL) & ~MDEC_PIC_DC_BIT31);
+	_SetDos(IMEM_DMA_ADR, fFirmware.physical);
+	_SetDos(IMEM_DMA_COUNT, kFirmwareSize / 4);
+	_SetDos(IMEM_DMA_CTRL, 0x00078000);
+	bigtime_t timeout = system_time() + 10000;
+	while ((_Dos(IMEM_DMA_CTRL) & IMEM_DMA_BUSY) != 0) {
+		if (system_time() > timeout) {
+			INFO("firmware DMA does not finish\n");
+			return B_TIMED_OUT;
+		}
+	}
+	return B_OK;
+}
+
+
+/*!	The MPEG-1/2 firmware's registers: the frames' canvases, the workspace,
+	the picture size.
+*/
+void
+MesonVdec::_StartCodec()
+{
+	for (uint32 i = 0; i < kFrameCount; i++) {
+		phys_addr_t frame = fFrames.physical + i * fFrameSize;
+		uint32 luma = kFirstCanvas + 2 * i;
+		uint32 chroma = luma + 1;
+		_WriteCanvas(luma, frame, fBytesPerRow, align_up(fHeight, 32));
+		_WriteCanvas(chroma, frame + fLumaSize, fBytesPerRow,
+			align_up(fHeight, 32) / 2);
+		_SetDos(AV_SCRATCH_0 + 4 * i, luma | (chroma << 8) | (chroma << 16));
+	}
+	_SetDos(POWER_CTL_VLD, 1 << 4);
+	_SetDos(AV_SCRATCH_B, fWorkspace.physical + kWorkspaceOffset);
+	_SetDos(MPEG1_2_REG, 0);
+	_SetDos(PSCALE_CTRL, 0);
+	_SetDos(PIC_HEAD_INFO, 0x380);
+	_SetDos(M4_CONTROL_REG, 0);
+	_SetDos(AV_SCRATCH_8, 0);
+	_SetDos(AV_SCRATCH_9, 0);
+	_SetDos(AV_SCRATCH_A, (fWidth << 16) | fHeight);
+	_SetDos(AV_SCRATCH_C, 0);
+	_SetDos(AV_SCRATCH_F, 0);
+	_SetDos(AV_SCRATCH_E, 0);
+}
+
+
+void
+MesonVdec::_InitParser()
+{
+	fReset[RESET1 / 4] = RESET1_PARSER;
+	_SetParser(PARSER_CONFIG, 0x000a1010);
+	_SetParser(PFIFO_RD_PTR, 0);
+	_SetParser(PFIFO_WR_PTR, 0);
+	_SetParser(PARSER_SEARCH_PATTERN, 0x00000100);
+	_SetParser(PARSER_SEARCH_MASK, 0xffffff00);
+	_SetParser(PARSER_CONFIG, 0x000a1810);
+	_SetParser(PARSER_CONTROL, PARSER_START_SEARCH);
+	_SetParser(PARSER_VIDEO_START_PTR, fVififo.physical);
+	_SetParser(PARSER_VIDEO_END_PTR, fVififo.physical + fVififo.size - 8);
+	_SetParser(PARSER_ES_CONTROL, _Parser(PARSER_ES_CONTROL) & ~1u);
+	_SetDos(DOS_GEN_CTRL0, 0);
+	_SetDos(VLD_MEM_VIFIFO_BUF_CNTL, 1);
+	_SetDos(VLD_MEM_VIFIFO_BUF_CNTL, _Dos(VLD_MEM_VIFIFO_BUF_CNTL) & ~1u);
+	_SetParser(PARSER_INT_STATUS, 0xffff);
+	_SetParser(PARSER_INT_ENABLE, PARSER_INT_HOST_START_CODE);
+}
+
+
+//	#pragma mark - session
+
+
+status_t
+MesonVdec::_Start(meson_vdec_start& start, const void* userFirmware)
+{
+	if (fRunning)
+		return B_BUSY;
+	if (start.codec != MESON_VDEC_MPEG12
+		|| start.firmware_size != kFirmwareSize
+		|| start.width < 16 || start.width > kMaxWidth
+		|| start.height < 16 || start.height > kMaxHeight) {
+		return B_BAD_VALUE;
+	}
+
+	fWidth = start.width;
+	fHeight = start.height;
+	fBytesPerRow = align_up(fWidth, 32);
+	fLumaSize = align_up(fBytesPerRow * align_up(fHeight, 32), 64 * 1024);
+	fFrameSize = ROUNDUP(fLumaSize + fLumaSize / 2, B_PAGE_SIZE);
+
+	status_t status;
+	if ((status = _AllocateBuffer("meson_vdec firmware", kFirmwareSize,
+			fFirmware, false)) != B_OK
+		|| (status = _AllocateBuffer("meson_vdec vififo", kVififoSize,
+			fVififo, false)) != B_OK
+		|| (status = _AllocateBuffer("meson_vdec workspace", kWorkspaceSize,
+			fWorkspace, false)) != B_OK
+		|| (status = _AllocateBuffer("meson_vdec input",
+			kInputSize + kMinimumFetch + kMarkerSize, fInput, false)) != B_OK
+		|| (status = _AllocateBuffer("meson_vdec frames",
+			kFrameCount * fFrameSize, fFrames, true)) != B_OK) {
+		INFO("no memory for a session: %s\n", strerror(status));
+		_Stop();
+		return status;
+	}
+
+	{
+		InterruptsSpinLocker locker(fStateLock);
+		fQueueHead = 0;
+		fQueueCount = 0;
+		fHeld = 0;
+		fFatal = false;
+		fEndOfStream = false;
+	}
+	int32 count;
+	if (get_sem_count(fFrameSem, &count) == B_OK && count > 0)
+		acquire_sem_etc(fFrameSem, count, 0, 0);
+	if (get_sem_count(fParserSem, &count) == B_OK && count > 0)
+		acquire_sem_etc(fParserSem, count, 0, 0);
+
+	_PowerUp();
+	_SetupVififo();
+	status = _LoadFirmware(userFirmware);
+	if (status != B_OK) {
+		_PowerDown();
+		_Stop();
+		return status;
+	}
+	_StartCodec();
+	_SetDos(ASSIST_MBOX1_CLR_REG, 1);
+	_SetDos(ASSIST_MBOX1_MASK, 1);
+	_SetDos(MDEC_PIC_DC_CTRL, _Dos(MDEC_PIC_DC_CTRL) | MDEC_PIC_DC_NV12);
+	fRunning = true;
+	_SetDos(MPSR, 1);
+	spin(20);
+	_InitParser();
+
+	start.frame_count = kFrameCount;
+	start.frame_size = fFrameSize;
+	start.frames = fFrames.area;
+	INFO("session: MPEG-1/2 %" B_PRIu32 "x%" B_PRIu32 ", frames of %"
+		B_PRIuSIZE " bytes at %#" B_PRIxPHYSADDR ", VIFIFO at %#"
+		B_PRIxPHYSADDR "\n", fWidth, fHeight, fFrameSize, fFrames.physical,
+		fVififo.physical);
+	return B_OK;
+}
+
+
+void
+MesonVdec::_Stop()
+{
+	if (fRunning) {
+		// the firmware may still be writing; wait until it is quiet
+		snooze(50000);
+		InterruptsSpinLocker locker(fStateLock);
+		fRunning = false;
+		locker.Unlock();
+		_PowerDown();
+		INFO("session ended: %" B_PRIu32 " frames decoded, %" B_PRIu32
+			" skipped, %" B_PRIu32 " buffers submitted, %" B_PRIu32
+			" parser timeouts\n", fFramesDecoded, fFramesSkipped, fSubmitted,
+			fParserTimeouts);
+	}
+	_FreeBuffer(fFirmware);
+	_FreeBuffer(fVififo);
+	_FreeBuffer(fWorkspace);
+	_FreeBuffer(fInput);
+	_FreeBuffer(fFrames);
+}
+
+
+/*!	Hands the first \a payload bytes of fInput to the parser and waits until
+	they are in the VIFIFO. With \a marker, the data is padded to the
+	parser's minimum and followed by the 00 00 01 FF marker whose start code
+	the parser reports; without (the end of the stream), the wait may end
+	without it.
+*/
+status_t
+MesonVdec::_Submit(size_t payload, bool marker)
+{
+	size_t length = payload;
+	if (marker) {
+		if (length < kMinimumFetch) {
+			memset(fInput.address + length, 0, kMinimumFetch - length);
+			length = kMinimumFetch;
+		}
+		uint8* trailer = fInput.address + length;
+		memset(trailer, 0, kMarkerSize);
+		trailer[2] = 0x01;
+		trailer[3] = 0xff;
+	} else
+		memset(fInput.address + length, 0, kMarkerSize);
+	flush_cache_range(fInput.physical, length + kMarkerSize);
+
+	int32 count;
+	if (get_sem_count(fParserSem, &count) == B_OK && count > 0)
+		acquire_sem_etc(fParserSem, count, 0, 0);
+
+	_SetParser(PFIFO_RD_PTR, 0);
+	_SetParser(PFIFO_WR_PTR, 0);
+	_SetParser(PARSER_CONTROL, (length << 8) | PARSER_START_WRITE_SEARCH);
+	_SetParser(PARSER_FETCH_ADDR, fInput.physical);
+	_SetParser(PARSER_FETCH_CMD,
+		PARSER_FETCH_ENDIAN_64 | (length + kMarkerSize));
+	fSubmitted++;
+
+	bigtime_t timeout = system_time() + (marker ? 1000000 : 200000);
+	while (true) {
+		if (acquire_sem_etc(fParserSem, 1, B_RELATIVE_TIMEOUT, kPollInterval)
+				== B_OK) {
+			return B_OK;
+		}
+		InterruptsSpinLocker locker(fStateLock);
+		bool done = _CheckParser();
+		locker.Unlock();
+		if (done) {
+			acquire_sem_etc(fParserSem, 1, B_RELATIVE_TIMEOUT, 0);
+			return B_OK;
+		}
+		if (system_time() > timeout)
+			break;
+	}
+	_SetParser(PARSER_FETCH_CMD, 0);
+	if (marker) {
+		fParserTimeouts++;
+		INFO("parser timeout: control %#" B_PRIx32 ", status %#" B_PRIx32
+			", video WP %#" B_PRIx32 ", VIFIFO level %" B_PRIu32 "\n",
+			_Parser(PARSER_CONTROL), _Parser(PARSER_INT_STATUS),
+			_Parser(PARSER_VIDEO_WP), _Dos(VLD_MEM_VIFIFO_LEVEL));
+	}
+	return marker ? B_TIMED_OUT : B_OK;
+}
+
+
+status_t
+MesonVdec::_Write(const uint8* userData, size_t size)
+{
+	if (!fRunning)
+		return B_NOT_ALLOWED;
+	if (!IS_USER_ADDRESS(userData))
+		return B_BAD_ADDRESS;
+
+	while (size > 0) {
+		size_t piece = size < kInputSize ? size : kInputSize;
+
+		// room in the VIFIFO: decoding frees it, which needs the caller to
+		// take frames meanwhile
+		bigtime_t timeout = system_time() + 5000000;
+		while (true) {
+			size_t used = _Dos(VLD_MEM_VIFIFO_LEVEL)
+				+ _Parser(PARSER_VIDEO_HOLE) + kVififoMargin;
+			if (used < fVififo.size && fVififo.size - used >= piece)
+				break;
+			if (fFatal)
+				return B_ERROR;
+			if (system_time() > timeout)
+				return B_TIMED_OUT;
+			snooze(kPollInterval);
+		}
+
+		if (user_memcpy(fInput.address, userData, piece) != B_OK)
+			return B_BAD_ADDRESS;
+		status_t status = _Submit(piece, true);
+		if (status != B_OK)
+			return status;
+		userData += piece;
+		size -= piece;
+	}
+	return B_OK;
+}
+
+
+/*!	A sequence end code, for the firmware to put out the frames it holds. */
+status_t
+MesonVdec::_EndOfStream()
+{
+	if (!fRunning)
+		return B_NOT_ALLOWED;
+	memset(fInput.address, 0, 1024);
+	fInput.address[2] = 0x01;
+	fInput.address[3] = 0xb7;
+	_Submit(1024, false);
+	fEndOfStream = true;
+	return B_OK;
+}
+
+
+status_t
+MesonVdec::_GetFrame(meson_vdec_frame& frame)
+{
+	if (!fRunning)
+		return B_NOT_ALLOWED;
+
+	// after the end of the stream, a pause in the output is its end
+	bigtime_t timeout = system_time()
+		+ (fEndOfStream ? min_c(frame.timeout, 300000) : frame.timeout);
+	while (true) {
+		if (acquire_sem_etc(fFrameSem, 1, B_RELATIVE_TIMEOUT | B_CAN_INTERRUPT,
+				kPollInterval) == B_OK) {
+			break;
+		}
+		InterruptsSpinLocker locker(fStateLock);
+		bool reported = _CheckDecoder();
+		locker.Unlock();
+		if (reported)
+			continue;
+		if (system_time() > timeout) {
+			if (fEndOfStream) {
+				memset(&frame, 0, sizeof(frame));
+				frame.flags = MESON_VDEC_FRAME_END_OF_STREAM;
+				return B_OK;
+			}
+			return B_TIMED_OUT;
+		}
+	}
+
+	InterruptsSpinLocker locker(fStateLock);
+	if (fFatal) {
+		locker.Unlock();
+		INFO("the firmware reports a fatal error\n");
+		return B_ERROR;
+	}
+	if (fQueueCount == 0)
+		return B_ERROR;
+	uint32 index = fQueue[fQueueHead];
+	fQueueHead = (fQueueHead + 1) % kFrameCount;
+	fQueueCount--;
+	fHeld |= 1 << index;
+	locker.Unlock();
+
+	flush_cache_range(fFrames.physical + index * fFrameSize, fFrameSize);
+	memset(&frame, 0, sizeof(frame));
+	frame.index = index;
+	frame.width = fWidth;
+	frame.height = fHeight;
+	frame.bytes_per_row = fBytesPerRow;
+	frame.chroma_offset = fLumaSize;
+	return B_OK;
+}
+
+
+/*!	Gives a frame back to the firmware: one at a time, once it took the
+	last.
+*/
+status_t
+MesonVdec::_Recycle(uint32 index)
+{
+	if (!fRunning)
+		return B_NOT_ALLOWED;
+	{
+		InterruptsSpinLocker locker(fStateLock);
+		if (index >= kFrameCount || (fHeld & (1 << index)) == 0)
+			return B_BAD_VALUE;
+	}
+	bigtime_t timeout = system_time() + 500000;
+	while (_Dos(AV_SCRATCH_8) != 0) {
+		if (system_time() > timeout) {
+			INFO("the firmware does not take frame %" B_PRIu32 " back\n",
+				index);
+			return B_TIMED_OUT;
+		}
+		snooze(500);
+	}
+	InterruptsSpinLocker locker(fStateLock);
+	fHeld &= ~(1 << index);
+	locker.Unlock();
+	_SetDos(AV_SCRATCH_8, index + 1);
+	return B_OK;
+}
+
+
+//	#pragma mark - device
+
+
+status_t
+MesonVdec::Open()
+{
+	MutexLocker locker(fLock);
+	if (fOpen)
+		return B_BUSY;
+	fOpen = true;
+	return B_OK;
+}
+
+
+void
+MesonVdec::Close()
+{
+	MutexLocker locker(fLock);
+	if (fRunning || fFrames.area >= 0)
+		_Stop();
+	fOpen = false;
+}
+
+
+status_t
+MesonVdec::Control(uint32 op, void* buffer, size_t length)
+{
+	switch (op) {
+		case MESON_VDEC_START:
+		{
+			meson_vdec_start start;
+			if (length < sizeof(start) || !IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&start, buffer, sizeof(start)) != B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			MutexLocker locker(fLock);
+			status_t status = _Start(start, start.firmware);
+			if (status != B_OK)
+				return status;
+			return user_memcpy(buffer, &start, sizeof(start));
+		}
+
+		case MESON_VDEC_WRITE:
+		{
+			meson_vdec_write write;
+			if (length < sizeof(write) || !IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&write, buffer, sizeof(write)) != B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			MutexLocker locker(fLock);
+			return _Write((const uint8*)write.data, write.size);
+		}
+
+		case MESON_VDEC_END_OF_STREAM:
+		{
+			MutexLocker locker(fLock);
+			return _EndOfStream();
+		}
+
+		case MESON_VDEC_GET_FRAME:
+		{
+			// not under fLock: the caller takes frames while a WRITE waits
+			// for room
+			meson_vdec_frame frame;
+			if (length < sizeof(frame) || !IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&frame, buffer, sizeof(frame)) != B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			status_t status = _GetFrame(frame);
+			if (status != B_OK)
+				return status;
+			return user_memcpy(buffer, &frame, sizeof(frame));
+		}
+
+		case MESON_VDEC_RECYCLE_FRAME:
+		{
+			uint32 index;
+			if (length < sizeof(index) || !IS_USER_ADDRESS(buffer)
+				|| user_memcpy(&index, buffer, sizeof(index)) != B_OK) {
+				return B_BAD_ADDRESS;
+			}
+			return _Recycle(index);
+		}
+
+		case MESON_VDEC_STOP:
+		{
+			MutexLocker locker(fLock);
+			_Stop();
+			return B_OK;
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+void
+MesonVdec::Dump()
+{
+	kprintf("meson_vdec: %s, %" B_PRIu32 "x%" B_PRIu32 ", %" B_PRIu32
+		" frames decoded, %" B_PRIu32 " skipped, queue %" B_PRIu32
+		", held %#" B_PRIx32 "%s\n", fRunning ? "running" : "stopped",
+		fWidth, fHeight, fFramesDecoded, fFramesSkipped, fQueueCount, fHeld,
+		fFatal ? ", fatal error" : "");
+	kprintf("  interrupts: decoder %" B_PRIu32 ", parser %" B_PRIu32
+		"; %" B_PRIu32 " buffers submitted, %" B_PRIu32 " parser timeouts\n",
+		fVdecInterrupts, fParserInterrupts, fSubmitted, fParserTimeouts);
+	if (!fRunning)
+		return;
+	kprintf("  MPSR %#" B_PRIx32 ", scratch 4-9 %#" B_PRIx32 " %#" B_PRIx32
+		" %" B_PRIu32 " %" B_PRIu32 " %#" B_PRIx32 " %#" B_PRIx32
+		", C %" B_PRIu32 ", D %#" B_PRIx32 ", E %#" B_PRIx32 ", F %#"
+		B_PRIx32 "\n", _Dos(MPSR), _Dos(AV_SCRATCH_4), _Dos(AV_SCRATCH_5),
+		_Dos(AV_SCRATCH_6), _Dos(AV_SCRATCH_7), _Dos(AV_SCRATCH_8),
+		_Dos(AV_SCRATCH_9), _Dos(AV_SCRATCH_C), _Dos(AV_SCRATCH_D),
+		_Dos(AV_SCRATCH_E), _Dos(AV_SCRATCH_F));
+	kprintf("  VIFIFO: start %#" B_PRIx32 ", WP %#" B_PRIx32 ", RP %#"
+		B_PRIx32 ", level %" B_PRIu32 ", control %#" B_PRIx32 ", buf %#"
+		B_PRIx32 "\n", _Dos(VLD_MEM_VIFIFO_START_PTR),
+		_Dos(VLD_MEM_VIFIFO_WP), _Dos(VLD_MEM_VIFIFO_RP),
+		_Dos(VLD_MEM_VIFIFO_LEVEL), _Dos(VLD_MEM_VIFIFO_CONTROL),
+		_Dos(VLD_MEM_VIFIFO_BUF_CNTL));
+	kprintf("  parser: control %#" B_PRIx32 ", status %#" B_PRIx32
+		", video WP %#" B_PRIx32 ", hole %" B_PRIu32 "\n",
+		_Parser(PARSER_CONTROL), _Parser(PARSER_INT_STATUS),
+		_Parser(PARSER_VIDEO_WP), _Parser(PARSER_VIDEO_HOLE));
+}
+
+
+static int
+dump_meson_vdec(int argc, char** argv)
+{
+	if (sDevice == NULL)
+		kprintf("meson_vdec: no device\n");
+	else
+		sDevice->Dump();
+	return 0;
+}
