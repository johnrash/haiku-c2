+device_manager_info* gDeviceManager;
+
+
+/*!	Writes back and invalidates the cache lines of a physical range through
+	the kernel's cached map of all memory: before the device reads what the
+	CPU wrote, and before the CPU reads what the device wrote.
+*/
+static void
+flush_cache_range(phys_addr_t physical, size_t size)
+{
+	uint64 ctr;
+	asm volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	const addr_t lineSize = 4 << ((ctr >> 16) & 0xf);
+	addr_t start = (KERNEL_PMAP_BASE + physical) & ~(lineSize - 1);
+	for (addr_t line = start; line < KERNEL_PMAP_BASE + physical + size;
+			line += lineSize) {
+		asm volatile("dc civac, %0" : : "r"(line) : "memory");
+	}
+	asm volatile("dsb sy" : : : "memory");
+}
+
+
+static inline uint32
+align_up(uint32 value, uint32 alignment)
+{
+	return (value + alignment - 1) & ~(alignment - 1);
+}
