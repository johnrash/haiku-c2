+#define VDEC_CLK_SOURCE_SHIFT		9
+#define VDEC_CLK_SOURCE_MASK		(3 << VDEC_CLK_SOURCE_SHIFT)
+#define VDEC_CLK_SOURCE_FCLK_DIV3	1			// 666.67 MHz
