+static const size_t kVififoSize = 8 * 1024 * 1024;
+static const size_t kWorkspaceSize = 128 * 1024;
+static const uint32 kWorkspaceOffset = 0x1400;
+	// the firmware takes the address 5 KB in
+static const size_t kInputSize = 256 * 1024;
+	// one parser fetch; plus the padding and the marker
+static const uint32 kMinimumFetch = 4096;
+static const uint32 kMarkerSize = 512;
+static const size_t kVififoMargin = 6 * 1024;
+	// the parser's own FIFO
+static const uint32 kFrameCount = 8;
+static const uint32 kMaxWidth = 1920;
+static const uint32 kMaxHeight = 1088;
+static const bigtime_t kPollInterval = 2000;
