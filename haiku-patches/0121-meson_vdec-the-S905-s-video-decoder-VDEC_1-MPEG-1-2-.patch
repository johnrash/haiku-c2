+
+MesonVdec::~MesonVdec()
+{
+	if (fRunning)
+		_Stop();
+	if (fVdecIrq >= 0)
+		remove_io_interrupt_handler(fVdecIrq, &_VdecInterrupt, this);
+	if (fParserIrq >= 0)
+		remove_io_interrupt_handler(fParserIrq, &_ParserInterrupt, this);
+	delete_sem(fFrameSem);
+	delete_sem(fParserSem);
+	area_id areas[] = { fDosArea, fParserArea, fAoArea, fHhiArea, fResetArea,
+		fDmcArea };
+	for (size_t i = 0; i < B_COUNT_OF(areas); i++) {
+		if (areas[i] >= 0)
+			delete_area(areas[i]);
+	}
+	mutex_destroy(&fLock);
+}
