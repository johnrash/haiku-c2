+//	#pragma mark - driver module
+
+
+static bool
+fdt_device_enabled(fdt_device_module_info* module, fdt_device* device)
+{
+	int length;
+	const char* status = (const char*)module->get_prop(device, "status",
+		&length);
+	return status == NULL || strcmp(status, "okay") == 0
+		|| strcmp(status, "ok") == 0;
+}
+
+
+static float
+supports_device(device_node* parent)
+{
+	const char* bus;
+	const char* compatible;
+	if (gDeviceManager->get_attr_string(parent, B_DEVICE_BUS, &bus, false)
+			!= B_OK || strcmp(bus, "fdt") != 0
+		|| gDeviceManager->get_attr_string(parent, "fdt/compatible",
+			&compatible, false) != B_OK
+		|| strcmp(compatible, "amlogic,gxbb-vdec") != 0) {
+		return 0.0f;
+	}
+	return 0.8f;
+}
+
+
+static status_t
+register_device(device_node* parent)
+{
+	device_attr attrs[] = {
+		{ B_DEVICE_PRETTY_NAME, B_STRING_TYPE,
+			{ .string = "Amlogic Meson GXBB video decoder" } },
+		{ NULL }
+	};
+	return gDeviceManager->register_node(parent, DRIVER_MODULE_NAME, attrs,
+		NULL, NULL);
+}
+
+
+static status_t
+init_driver(device_node* node, void** _cookie)
+{
+	DeviceNodePutter<&gDeviceManager> fdtNode(
+		gDeviceManager->get_parent_node(node));
+	fdt_device_module_info* fdtModule;
+	fdt_device* fdtDevice;
+	if (gDeviceManager->get_driver(fdtNode.Get(),
+			(driver_module_info**)&fdtModule, (void**)&fdtDevice) != B_OK) {
+		return B_ERROR;
+	}
+	if (!fdt_device_enabled(fdtModule, fdtDevice))
+		return B_DEVICE_NOT_FOUND;
+
+	// the node sits in "soc", whose ranges are the identity
+	uint64 dos;
+	uint64 parser;
+	uint64 length;
+	if (!fdtModule->get_reg(fdtDevice, 0, &dos, &length)
+		|| !fdtModule->get_reg(fdtDevice, 1, &parser, &length)) {
+		return B_ERROR;
+	}
+	uint64 vdecIrq = 0;
+	uint64 parserIrq = 0;
+	fdtModule->get_interrupt(fdtDevice, 0, NULL, &vdecIrq);
+	fdtModule->get_interrupt(fdtDevice, 1, NULL, &parserIrq);
+
+	MesonVdec* device = new(std::nothrow) MesonVdec(node);
+	if (device == NULL)
+		return B_NO_MEMORY;
+	status_t status = device->Init(dos, parser, (int32)vdecIrq,
+		(int32)parserIrq);
+	if (status != B_OK) {
+		delete device;
+		return status;
+	}
+	sDevice = device;
+	add_debugger_command("meson_vdec", &dump_meson_vdec,
+		"Shows the video decoder's state");
+	*_cookie = device;
+	return B_OK;
+}
+
+
+static void
+uninit_driver(void* cookie)
+{
+	remove_debugger_command("meson_vdec", &dump_meson_vdec);
+	sDevice = NULL;
+	delete (MesonVdec*)cookie;
+}
