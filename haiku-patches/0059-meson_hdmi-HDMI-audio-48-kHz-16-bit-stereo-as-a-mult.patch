+
+//	#pragma mark - multi_audio
+
+
+status_t
+MesonHdmiAudio::GetDescription(multi_description* data)
+{
+	data->interface_version = B_CURRENT_INTERFACE_VERSION;
+	data->interface_minimum = B_CURRENT_INTERFACE_VERSION;
+	strlcpy(data->friendly_name, "HDMI", sizeof(data->friendly_name));
+	strlcpy(data->vendor_info, "Amlogic", sizeof(data->vendor_info));
+
+	data->output_channel_count = 2;
+	data->output_bus_channel_count = 2;
+	data->input_channel_count = 0;
+	data->input_bus_channel_count = 0;
+	data->aux_bus_channel_count = 0;
+	if (data->request_channel_count >= (int32)B_COUNT_OF(sChannels))
+		memcpy(data->channels, sChannels, sizeof(sChannels));
+
+	data->output_rates = B_SR_48000;
+	data->input_rates = B_SR_48000;
+	data->max_cvsr_rate = 0;
+	data->min_cvsr_rate = 0;
+	data->output_formats = B_FMT_16BIT;
+	data->input_formats = B_FMT_16BIT;
+	data->lock_sources = B_MULTI_LOCK_INTERNAL;
+	data->timecode_sources = 0;
+	data->interface_flags = B_MULTI_INTERFACE_PLAYBACK;
+	data->start_latency = 30000;
+	strlcpy(data->control_panel, "", sizeof(data->control_panel));
+	return B_OK;
+}
+
+
+status_t
+MesonHdmiAudio::GetEnabledChannels(multi_channel_enable* data)
+{
+	B_SET_CHANNEL(data->enable_bits, 0, true);
+	B_SET_CHANNEL(data->enable_bits, 1, true);
+	data->lock_source = B_MULTI_LOCK_INTERNAL;
+	return B_OK;
+}
+
+
+status_t
+MesonHdmiAudio::GetGlobalFormat(multi_format_info* data)
+{
+	data->output_latency = 0;
+	data->input_latency = 0;
+	data->timecode_kind = 0;
+	data->output.rate = B_SR_48000;
+	data->output.cvsr = kRate;
+	data->output.format = B_FMT_16BIT;
+	data->input.rate = B_SR_48000;
+	data->input.cvsr = kRate;
+	data->input.format = B_FMT_16BIT;
+	return B_OK;
+}
+
+
+/*!	The buffers are the ring itself, mapped into the caller (the opener). */
+status_t
+MesonHdmiAudio::GetBuffers(multi_buffer_list* data)
+{
+	MutexLocker locker(fLock);
+	if (fClientArea < 0) {
+		fClientArea = vm_map_physical_memory(team_get_current_team_id(),
+			"meson_hdmi audio buffers", (void**)&fClientRing, B_ANY_ADDRESS,
+			kRingSize, B_READ_AREA | B_WRITE_AREA, fRingPhysical, false);
+		if (fClientArea < 0)
+			return fClientArea;
+		vm_set_area_memory_type(fClientArea, fRingPhysical,
+			B_WRITE_COMBINING_MEMORY);
+	}
+
+	data->flags = B_MULTI_BUFFER_PLAYBACK;
+	data->return_playback_buffers = kBufferCount;
+	data->return_playback_channels = 2;
+	data->return_playback_buffer_size = kBufferFrames;
+	data->return_record_buffers = 0;
+	data->return_record_channels = 0;
+	data->return_record_buffer_size = 0;
+
+	for (uint32 i = 0; i < kBufferCount; i++) {
+		buffer_desc descs[2];
+		for (uint32 channel = 0; channel < 2; channel++) {
+			descs[channel].base = (char*)fClientRing + i * kBufferSize
+				+ channel * 2;
+			descs[channel].stride = kFrameSize;
+		}
+		if (!IS_USER_ADDRESS(data->playback_buffers[i])
+			|| user_memcpy(data->playback_buffers[i], descs, sizeof(descs))
+				!= B_OK) {
+			return B_BAD_ADDRESS;
+		}
+	}
+	return B_OK;
+}
+
+
+/*!	Waits until the DMA has finished a buffer; the client then fills the
+	one before the cycle reported (MultiAudioNode), which is that one.
+*/
+status_t
+MesonHdmiAudio::BufferExchange(multi_buffer_info* userData)
+{
+	multi_buffer_info data;
+	if (!IS_USER_ADDRESS(userData)
+		|| user_memcpy(&data, userData, sizeof(data)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+
+	// the buffers are the client's: what it wrote before plays first
+	MutexLocker locker(fLock);
+	if (!fRunning)
+		_Start();
+	locker.Unlock();
+
+	status_t status = acquire_sem_etc(fBufferSem, 1,
+		B_CAN_INTERRUPT | B_RELATIVE_TIMEOUT, 1000000);
+	if (status == B_TIMED_OUT)
+		INFO("no buffer done in 1 s, DMA at %#" B_PRIx32 "\n",
+			fAiu[AIU_MEM_I2S_RD_PTR]);
+	if (status != B_OK)
+		return status;
+
+	InterruptsSpinLocker stateLocker(fStateLock);
+	data.played_real_time = fBufferTime;
+	data.played_frames_count = fFramesPlayed;
+	data.playback_buffer_cycle = fPlaying;
+	stateLocker.Unlock();
+
+	if (user_memcpy(userData, &data, sizeof(data)) != B_OK)
+		return B_BAD_ADDRESS;
+	return B_OK;
+}
+
+
+status_t
+MesonHdmiAudio::ForceStop()
+{
+	MutexLocker locker(fLock);
+	if (fRunning)
+		_Stop();
+	return B_OK;
+}
