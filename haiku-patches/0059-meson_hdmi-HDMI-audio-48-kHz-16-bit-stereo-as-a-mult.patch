+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+/*!	HDMI audio on the Amlogic Meson GXBB (S905, ODROID-C2): 48 kHz, 16-bit
+	stereo PCM, published as a multi_audio device next to the display.
+
+	The path: a ring buffer in memory, read by the AIU's I2S DMA
+	(AIU_MEM_I2S_*), the AIU's I2S encoder, the HDMI TX's I2S input
+	(AIU_HDMI_CLK_DATA_CTRL), the DesignWare controller's audio sampler and
+	frame composer, which send the samples in audio sample packets.
+
+	Clocks: MPLL2, fed by the 2 GHz fixed PLL, runs at 294.912 MHz;
+	cts_amclk is that /24, 12.288 MHz (256 fs); the I2S bit clock aoclk is
+	cts_amclk /4 (64 fs, 32 bits per channel), which the controller also
+	gets as its audio master clock (it measured CTS 148501 for 148.5 MHz
+	with "64 fs", twice that with "128 fs"). The controller measures CTS
+	itself against the TMDS clock; N is 6144, as for every 48 kHz mode with
+	a whole kHz pixel clock (CEA-861: 74.25 and 148.5 MHz).
+
+	Found on the board with an HDMI capture stick (tools/hdmi-audio-check.py
+	in the port's project folder): the I2S core encodes 24-bit samples, and
+	a 16-bit one has to be moved to the top (source descriptor "MSB
+	position" 2), else the controller got its upper byte as the lower one;
+	the channels come out swapped unless the encoder swaps them back. The
+	encoder has to be released and reset while the DMA has filled its FIFO
+	(else the channel order changes), and the controller's I2S part reset
+	once the I2S clock runs steadily: reset too early it measures a wrong
+	CTS, and the sink plays at a wrong rate.
+
+	The ring holds two buffers the client writes directly, through a write
+	combining mapping (the DMA does not snoop the CPU caches). A periodic
+	timer watches the DMA's read pointer and ends a buffer exchange when it
+	passes into the other buffer (the GIC driver sets all SPIs to level,
+	and the AIU's interrupt is an edge).
+
+	Sources: the S905 datasheet (AIU registers, ch. 31.4; HHI_AUD_CLK_CNTL
+	and the MPLL, ch. 22), the S905X datasheet (HDMITX TOP, ch. 27.4),
+	NetBSD's dw_hdmi.c (BSD-2) for the controller's audio registers. Facts
+	only, from Linux: cts_amclk's mux values (1-3: MPLL0-2), the I2S source
+	descriptor's split mode bit and the irq block unit (256 bytes).
+*/
+
+
+#include "meson_hdmi_audio.h"
+
+#include <new>
+#include <stdio.h>
+#include <string.h>
+
+#include <team.h>
+#include <util/AutoLock.h>
+#include <vm/vm.h>
+#include <arch/arm64/arch_kernel.h>
+
+
+#define INFO(x...)				dprintf("meson_hdmi: audio: " x)
+
+
+static const phys_addr_t kAiuPage = 0xc1105000;
+static const uint32 kAiuOffset = 0x400;		// AIU at 0xc1105400
+
+// AIU registers (word numbers)
+enum {
+	AIU_I2S_MUTE_SWAP			= 0x0c,
+	AIU_I2S_SOURCE_DESC			= 0x0d,
+	AIU_I2S_DAC_CFG				= 0x10,
+	AIU_I2S_SYNC				= 0x11,
+	AIU_I2S_MISC				= 0x12,
+	AIU_I2S_OUT_CFG				= 0x13,
+	AIU_RST_SOFT				= 0x15,
+	AIU_CLK_CTRL				= 0x16,
+	AIU_CLK_CTRL_MORE			= 0x19,
+	AIU_CODEC_DAC_LRCLK_CTRL	= 0x28,
+	AIU_HDMI_CLK_DATA_CTRL		= 0x2a,
+	AIU_MEM_I2S_START_PTR		= 0x60,
+	AIU_MEM_I2S_RD_PTR			= 0x61,
+	AIU_MEM_I2S_END_PTR			= 0x62,
+	AIU_MEM_I2S_MASKS			= 0x63,
+	AIU_MEM_I2S_CONTROL			= 0x64,
+	AIU_MEM_I2S_LEVEL			= 0x75,
+	AIU_MEM_I2S_BUF_CNTL		= 0x76,
+};
+
+#define I2S_SOURCE_DESC_SPLIT		(1 << 11)
+#define I2S_SOURCE_DESC_MSB_POSITION(n)	((n) << 3)
+#define I2S_DAC_CFG_MSB_FIRST		(1 << 2)	// size 0: 16-bit words
+#define I2S_MUTE_SWAP_CH01			(3 << 0)	// right, left
+#define I2S_MISC_HOLD				(1 << 2)
+#define I2S_MISC_FORCE_LEFT_RIGHT	(1 << 4)
+#define RST_SOFT_I2S_FAST			(1 << 0)
+#define CLK_CTRL_I2S_DIV_EN			(1 << 0)
+#define CLK_CTRL_AOCLK_INVERT		(1 << 6)
+#define CLK_CTRL_ALRCLK_INVERT		(1 << 7)
+#define CLK_CTRL_ALRCLK_SKEW_I2S	(1 << 8)	// changes before the msb
+#define CLK_CTRL_PLL_SOURCE			(1 << 10)
+#define CLK_CTRL_MORE_HDMI_AOCLKX2	(1 << 6)
+#define CLK_CTRL_MORE_I2S_DIV(n)	((n) - 1)
+#define HDMI_DATA_AIU_I2S			(2 << 4)
+#define HDMI_CLK_AIU				(2 << 0)
+#define MEM_CONTROL_INIT			(1 << 0)
+#define MEM_CONTROL_FILL_EN			(1 << 1)
+#define MEM_CONTROL_EMPTY_EN		(1 << 2)
+#define MEM_CONTROL_ENDIAN(n)		((n) << 3)
+#define MEM_CONTROL_16BIT			(1 << 6)
+#define MEM_CONTROL_BUSY			(1 << 7)
+#define MEM_MASKS_IRQ_BLOCK(n)		((n) << 16)	// 256 byte units
+#define MEM_BUF_CNTL_INIT			(1 << 0)
+static const uint32 kDmaBlock = 256;
+	// the DMA's end pointer is the start of the last block
+
+// HHI (byte offsets)
+enum {
+	HHI_AUD_CLK_CNTL			= 0x178,
+	HHI_MPLL_CNTL9				= 0x2a0,	// MP2
+};
+
+#define AUD_CLK_DIV(n)				((n) - 1)
+#define AUD_CLK_EN					(1 << 8)
+#define AUD_CLK_SRC_MPLL2			(3 << 9)
+#define MPLL_SDM(n)					(n)
+#define MPLL_EN_DDS					(1 << 14)
+#define MPLL_SDM_EN					(1 << 15)
+#define MPLL_N(n)					((n) << 16)
+
+// HDMI TX top
+enum {
+	HDMITX_TOP_CLK_CNTL			= 0x01,
+};
+#define TOP_CLK_I2S_EN				(1 << 3)
+
+// DesignWare HDMI TX (8 bit registers)
+enum {
+	DW_FC_AUDICONF0				= 0x1025,
+	DW_FC_AUDICONF1				= 0x1026,
+	DW_FC_AUDICONF2				= 0x1027,
+	DW_FC_AUDICONF3				= 0x1028,
+	DW_FC_AUDSCONF				= 0x1063,
+	DW_AUD_CONF0				= 0x3100,
+	DW_AUD_CONF1				= 0x3101,
+	DW_AUD_N1					= 0x3200,
+	DW_AUD_N2					= 0x3201,
+	DW_AUD_N3					= 0x3202,
+	DW_AUD_CTS1					= 0x3203,
+	DW_AUD_CTS2					= 0x3204,
+	DW_AUD_CTS3					= 0x3205,
+	DW_AUD_INPUTCLKFS			= 0x3206,
+	DW_MC_CLKDIS				= 0x4001,
+	DW_MC_SWRSTZ				= 0x4002,
+	DW_FC_INVIDCONF				= 0x1000,
+};
+
+#define AUD_CONF0_FIFO_RESET		(1 << 7)
+#define AUD_CONF0_I2S_SELECT		(1 << 5)
+#define AUD_CONF0_I2S_IN0			(1 << 0)
+#define AUD_INPUTCLKFS_64FS			4
+#define FC_AUDICONF0_2CH			(1 << 4)
+#define MC_CLKDIS_AUDCLK			(1 << 3)
+#define MC_SWRSTZ_I2S				(1 << 3)	// active low
+
+static const uint32 kN = 6144;
+
+static const uint32 kRate = 48000;
+static const uint32 kFrameSize = 4;			// 16-bit stereo
+static const uint32 kBufferFrames = 1024;
+static const uint32 kBufferCount = 2;
+static const uint32 kBufferSize = kBufferFrames * kFrameSize;
+static const uint32 kRingSize = kBufferSize * kBufferCount;
+static const bigtime_t kPollInterval = 2000;
+static const uint32 kDmaEndian = 0;
+
+static multi_channel_info sChannels[] = {
+	{ 0, B_MULTI_OUTPUT_CHANNEL, B_CHANNEL_LEFT | B_CHANNEL_STEREO_BUS, 0 },
+	{ 1, B_MULTI_OUTPUT_CHANNEL, B_CHANNEL_RIGHT | B_CHANNEL_STEREO_BUS, 0 },
+	{ 2, B_MULTI_OUTPUT_BUS, B_CHANNEL_LEFT | B_CHANNEL_STEREO_BUS,
+		B_CHANNEL_MINI_JACK_STEREO },
+	{ 3, B_MULTI_OUTPUT_BUS, B_CHANNEL_RIGHT | B_CHANNEL_STEREO_BUS,
+		B_CHANNEL_MINI_JACK_STEREO },
+};
+
+
+static void
+dcache_flush(phys_addr_t physical, size_t length)
+{
+	// all RAM is mapped at KERNEL_PMAP_BASE as normal write-back memory
+	uint64 ctr;
+	asm volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	const addr_t lineSize = 4 << ((ctr >> 16) & 0xf);
+	addr_t end = KERNEL_PMAP_BASE + physical + length;
+	for (addr_t address = (KERNEL_PMAP_BASE + physical) & ~(lineSize - 1);
+			address < end; address += lineSize) {
+		asm volatile("dc civac, %0" : : "r"(address) : "memory");
+	}
+	asm volatile("dsb sy" : : : "memory");
+}
+
+
+MesonHdmiAudio::MesonHdmiAudio(MesonHdmiRegisters* registers)
+	:
+	fRegisters(registers),
+	fAiuArea(-1),
+	fAiu(NULL),
+	fRingArea(-1),
+	fRingMapArea(-1),
+	fRing(NULL),
+	fRingPhysical(0),
+	fClientArea(-1),
+	fClientRing(NULL),
+	fBufferSem(-1),
+	fOpen(false),
+	fRunning(false),
+	fPlaying(0),
+	fFramesPlayed(0),
+	fBufferTime(0)
+{
+	mutex_init(&fLock, "meson_hdmi audio");
+	B_INITIALIZE_SPINLOCK(&fStateLock);
+	memset(&fTimer, 0, sizeof(fTimer));
+	fTimer.user_data = this;
+}
+
+
+MesonHdmiAudio::~MesonHdmiAudio()
+{
+	if (fRunning)
+		_Stop();
+	_DeleteClientArea();
+	if (fBufferSem >= 0)
+		delete_sem(fBufferSem);
+	if (fRingMapArea >= 0)
+		delete_area(fRingMapArea);
+	if (fRingArea >= 0)
+		delete_area(fRingArea);
+	if (fAiuArea >= 0)
+		delete_area(fAiuArea);
+	mutex_destroy(&fLock);
+}
+
+
+status_t
+MesonHdmiAudio::Init()
+{
+	void* address;
+	fAiuArea = map_physical_memory("meson_hdmi aiu", kAiuPage, B_PAGE_SIZE,
+		B_ANY_KERNEL_ADDRESS, B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA,
+		&address);
+	if (fAiuArea < 0)
+		return fAiuArea;
+	fAiu = (volatile uint32*)((uint8*)address + kAiuOffset);
+
+	// the ring: contiguous pages below 4 GiB (the DMA pointers are 32 bits),
+	// used only through a write combining mapping
+	void* pages;
+	fRingArea = create_area("meson_hdmi audio pages", &pages,
+		B_ANY_KERNEL_ADDRESS, kRingSize, B_32_BIT_CONTIGUOUS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+	if (fRingArea < 0)
+		return fRingArea;
+	physical_entry entry;
+	get_memory_map(pages, B_PAGE_SIZE, &entry, 1);
+	fRingPhysical = entry.address;
+	dcache_flush(fRingPhysical, kRingSize);
+
+	fRingMapArea = map_physical_memory("meson_hdmi audio ring", fRingPhysical,
+		kRingSize, B_ANY_KERNEL_ADDRESS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, (void**)&fRing);
+	if (fRingMapArea < 0)
+		return fRingMapArea;
+	vm_set_area_memory_type(fRingMapArea, fRingPhysical,
+		B_WRITE_COMBINING_MEMORY);
+	memset(fRing, 0, kRingSize);
+
+	fBufferSem = create_sem(0, "meson_hdmi audio buffer");
+	if (fBufferSem < 0)
+		return fBufferSem;
+
+	_SetupClocks();
+
+	INFO("ring at %#" B_PRIxPHYSADDR ", AIU_HDMI_CLK_DATA_CTRL %#" B_PRIx32
+		", HHI_AUD_CLK_CNTL %#" B_PRIx32 ", MPLL2 %#" B_PRIx32 "\n",
+		fRingPhysical, fAiu[AIU_HDMI_CLK_DATA_CTRL],
+		fRegisters->HhiRead(HHI_AUD_CLK_CNTL),
+		fRegisters->HhiRead(HHI_MPLL_CNTL9));
+	return B_OK;
+}
+
+
+//	#pragma mark - hardware
+
+
+/*!	MPLL2 at 294.912 MHz (2000 / (6 + 12807 / 16384), 0.8 ppm high), then
+	cts_amclk = MPLL2 / 24 = 12.288 MHz. MPLL2 is unused otherwise; the
+	clock is gated while it changes (S905 datasheet, HHI_AUD_CLK_CNTL).
+	Set up once, at attach: right after it changes, the controller measures
+	a wrong CTS for a while.
+*/
+void
+MesonHdmiAudio::_SetupClocks()
+{
+	const uint32 mpll = MPLL_N(6) | MPLL_SDM_EN | MPLL_EN_DDS | MPLL_SDM(12807);
+	uint32 audio = fRegisters->HhiRead(HHI_AUD_CLK_CNTL);
+	uint32 wanted = (audio & ~0x7ffu) | AUD_CLK_SRC_MPLL2 | AUD_CLK_DIV(24)
+		| AUD_CLK_EN;
+	if (fRegisters->HhiRead(HHI_MPLL_CNTL9) == mpll && audio == wanted)
+		return;
+
+	fRegisters->HhiWrite(HHI_AUD_CLK_CNTL, audio & ~AUD_CLK_EN);
+	fRegisters->HhiWrite(HHI_MPLL_CNTL9, mpll);
+	spin(1000);
+	fRegisters->HhiWrite(HHI_AUD_CLK_CNTL, wanted & ~AUD_CLK_EN);
+	fRegisters->HhiWrite(HHI_AUD_CLK_CNTL, wanted);
+}
+
+
+/*!	The I2S encoder: 2 channels of 16 bits from memory (split mode), sent
+	as standard I2S (64 bit clocks per frame, 16-bit words MSB first; the
+	SoC changes data on the rising edge, so both clocks are inverted);
+	aoclk = cts_amclk / 4. Its clock and data go to the HDMI TX. The encoder
+	stays on hold until the DMA starts.
+*/
+void
+MesonHdmiAudio::_SetupAiu()
+{
+	fAiu[AIU_I2S_MISC] = I2S_MISC_HOLD;
+	fAiu[AIU_CLK_CTRL] &= ~CLK_CTRL_I2S_DIV_EN;
+
+	fAiu[AIU_I2S_SOURCE_DESC] = I2S_SOURCE_DESC_SPLIT
+		| I2S_SOURCE_DESC_MSB_POSITION(2);
+	fAiu[AIU_I2S_DAC_CFG] = I2S_DAC_CFG_MSB_FIRST;
+	fAiu[AIU_I2S_MUTE_SWAP] = I2S_MUTE_SWAP_CH01;
+	fAiu[AIU_I2S_OUT_CFG] = 0;
+	fAiu[AIU_CODEC_DAC_LRCLK_CTRL] = 64 - 1;
+
+	fAiu[AIU_CLK_CTRL_MORE] = (fAiu[AIU_CLK_CTRL_MORE] & ~0x7fu)
+		| CLK_CTRL_MORE_HDMI_AOCLKX2 | CLK_CTRL_MORE_I2S_DIV(4);
+	fAiu[AIU_CLK_CTRL] = (fAiu[AIU_CLK_CTRL] & ~0x7ffu) | CLK_CTRL_PLL_SOURCE
+		| CLK_CTRL_AOCLK_INVERT | CLK_CTRL_ALRCLK_INVERT
+		| CLK_CTRL_ALRCLK_SKEW_I2S;
+	fAiu[AIU_CLK_CTRL] |= CLK_CTRL_I2S_DIV_EN;
+
+	fAiu[AIU_HDMI_CLK_DATA_CTRL] = HDMI_DATA_AIU_I2S | HDMI_CLK_AIU;
+}
+
+
+/*!	The controller's audio sampler: I2S input 0, 16 bits, master clock
+	64 fs; N = 6144 with CTS measured; the audio infoframe says 2 channels.
+	The I2S part is reset after the I2S clock has run for a while (50 ms;
+	about 130 ms worked when tried by hand, the first 40 did not), and again
+	if the CTS it then measures does not match the pixel clock (for N = 6144
+	at 48 kHz, CTS is the pixel clock in kHz).
+*/
+void
+MesonHdmiAudio::_SetupHdmi(bool debugger)
+{
+	fRegisters->TopWrite(HDMITX_TOP_CLK_CNTL,
+		fRegisters->TopRead(HDMITX_TOP_CLK_CNTL) | TOP_CLK_I2S_EN);
+
+	fRegisters->DwWrite(DW_MC_CLKDIS,
+		fRegisters->DwRead(DW_MC_CLKDIS) & ~MC_CLKDIS_AUDCLK);
+
+	fRegisters->DwWrite(DW_AUD_CONF0, AUD_CONF0_I2S_SELECT | AUD_CONF0_I2S_IN0);
+	fRegisters->DwWrite(DW_AUD_CONF1, 16);
+	fRegisters->DwWrite(DW_AUD_INPUTCLKFS, AUD_INPUTCLKFS_64FS);
+
+	fRegisters->DwWrite(DW_AUD_CTS1, 0);
+	fRegisters->DwWrite(DW_AUD_CTS2, 0);
+	fRegisters->DwWrite(DW_AUD_CTS3, 0);
+	fRegisters->DwWrite(DW_AUD_N1, kN & 0xff);
+	fRegisters->DwWrite(DW_AUD_N2, (kN >> 8) & 0xff);
+	fRegisters->DwWrite(DW_AUD_N3, (kN >> 16) & 0xff);
+
+	fRegisters->DwWrite(DW_FC_AUDSCONF, 0);		// layout 0: 2 channels
+	fRegisters->DwWrite(DW_FC_AUDICONF0, FC_AUDICONF0_2CH);
+	fRegisters->DwWrite(DW_FC_AUDICONF1, 0);
+	fRegisters->DwWrite(DW_FC_AUDICONF2, 0);
+	fRegisters->DwWrite(DW_FC_AUDICONF3, 0);
+
+	// the measurement takes a while to settle after a reset; an unknown
+	// pixel clock (no mode set yet) accepts the second one
+	uint32 expected = fRegisters->PixelClock();
+	uint32 cts = 0;
+	int32 resets = 0;
+	if (debugger)
+		spin(50000);
+	else
+		snooze(50000);
+	while (resets < 10) {
+		fRegisters->DwWrite(DW_AUD_CONF0, AUD_CONF0_FIFO_RESET
+			| AUD_CONF0_I2S_SELECT | AUD_CONF0_I2S_IN0);
+		fRegisters->DwWrite(DW_MC_SWRSTZ, (uint8)~MC_SWRSTZ_I2S);
+		resets++;
+		if (debugger)
+			spin(50000);
+		else
+			snooze(50000);
+		cts = _Cts();
+		if (expected != 0 ? cts > expected * 99 / 100
+				&& cts < expected * 101 / 100
+			: resets > 1 && cts != 0x10000) {
+			break;
+		}
+	}
+	if (debugger) {
+		kprintf("meson_hdmi: audio: CTS %" B_PRIu32 " for a %" B_PRIu32
+			" kHz pixel clock (%" B_PRId32 " sampler reset(s))\n", cts,
+			expected, resets);
+	} else {
+		INFO("started: CTS %" B_PRIu32 " for a %" B_PRIu32 " kHz pixel clock"
+			" (%" B_PRId32 " sampler reset(s))\n", cts, expected, resets);
+	}
+}
+
+
+uint32
+MesonHdmiAudio::_Cts()
+{
+	return fRegisters->DwRead(DW_AUD_CTS1)
+		| (fRegisters->DwRead(DW_AUD_CTS2) << 8)
+		| ((fRegisters->DwRead(DW_AUD_CTS3) & 0xf) << 16);
+}
+
+
+/*!	The DMA reads the ring over and over: 64-bit words, 16-bit samples.
+	The order: pointers, then the init pulses (as the vendor driver does,
+	per Linux), then the DMA on with the encoder on hold.
+*/
+void
+MesonHdmiAudio::_StartDma()
+{
+	fAiu[AIU_MEM_I2S_CONTROL] = 0;
+	for (int32 i = 0; i < 1000 && (fAiu[AIU_MEM_I2S_CONTROL]
+			& MEM_CONTROL_BUSY) != 0; i++) {
+		spin(10);
+	}
+	fAiu[AIU_I2S_MISC] = I2S_MISC_HOLD;
+
+	fAiu[AIU_MEM_I2S_START_PTR] = (uint32)fRingPhysical;
+	fAiu[AIU_MEM_I2S_RD_PTR] = (uint32)fRingPhysical;
+	fAiu[AIU_MEM_I2S_END_PTR] = (uint32)fRingPhysical + kRingSize - kDmaBlock;
+	fAiu[AIU_MEM_I2S_MASKS] = MEM_MASKS_IRQ_BLOCK(kBufferSize / kDmaBlock)
+		| 0xffff;
+
+	uint32 control = MEM_CONTROL_16BIT | MEM_CONTROL_ENDIAN(kDmaEndian);
+	fAiu[AIU_MEM_I2S_CONTROL] = control | MEM_CONTROL_INIT;
+	fAiu[AIU_MEM_I2S_CONTROL] = control;
+	fAiu[AIU_MEM_I2S_BUF_CNTL] = MEM_BUF_CNTL_INIT;
+	fAiu[AIU_MEM_I2S_BUF_CNTL] = 0;
+
+	// the DMA fills the encoder's FIFO while it is on hold; then the encoder
+	// starts from the first sample
+	fAiu[AIU_I2S_MISC] = I2S_MISC_FORCE_LEFT_RIGHT | I2S_MISC_HOLD;
+	fAiu[AIU_MEM_I2S_CONTROL] = control | MEM_CONTROL_FILL_EN
+		| MEM_CONTROL_EMPTY_EN;
+	spin(2000);
+	fAiu[AIU_I2S_MISC] = I2S_MISC_FORCE_LEFT_RIGHT;
+	fAiu[AIU_RST_SOFT] = RST_SOFT_I2S_FAST;
+	(void)fAiu[AIU_I2S_SYNC];
+}
+
+
+void
+MesonHdmiAudio::_StopDma()
+{
+	fAiu[AIU_MEM_I2S_CONTROL] &= ~(MEM_CONTROL_FILL_EN | MEM_CONTROL_EMPTY_EN);
+}
+
+
+void
+MesonHdmiAudio::_Start()
+{
+	_SetupClocks();
+	_SetupAiu();
+
+	// the poll timer does not run yet: no lock needed around the start
+	fPlaying = 0;
+	fFramesPlayed = 0;
+	fBufferTime = system_time();
+	_StartDma();
+	_SetupHdmi(false);
+
+	InterruptsSpinLocker locker(fStateLock);
+	fRunning = true;
+	locker.Unlock();
+
+	add_timer(&fTimer, &_Poll, kPollInterval, B_PERIODIC_TIMER);
+}
+
+
+void
+MesonHdmiAudio::_Stop()
+{
+	cancel_timer(&fTimer);
+	InterruptsSpinLocker locker(fStateLock);
+	_StopDma();
+	fRunning = false;
+	locker.Unlock();
+	// a waiting exchange returns
+	release_sem_etc(fBufferSem, 1, B_DO_NOT_RESCHEDULE);
+}
+
+
+/*!	Every 2 ms while playing: has the DMA moved on to the other buffer?
+	The buffer's start time is estimated from how far into it the DMA is
+	(it reads ahead of the output by its FIFO, a steady offset).
+*/
+/*static*/ int32
+MesonHdmiAudio::_Poll(timer* timer)
+{
+	MesonHdmiAudio* self = (MesonHdmiAudio*)timer->user_data;
+	SpinLocker locker(self->fStateLock);
+	if (!self->fRunning)
+		return B_HANDLED_INTERRUPT;
+
+	uint32 offset = self->fAiu[AIU_MEM_I2S_RD_PTR] - (uint32)self->fRingPhysical;
+	if (offset >= kRingSize)
+		return B_HANDLED_INTERRUPT;
+	uint32 playing = offset / kBufferSize;
+	if (playing == self->fPlaying)
+		return B_HANDLED_INTERRUPT;
+
+	self->fPlaying = playing;
+	self->fFramesPlayed += kBufferFrames;
+	self->fBufferTime = system_time()
+		- (bigtime_t)(offset % kBufferSize) / kFrameSize * 1000000 / kRate;
+	locker.Unlock();
+	release_sem_etc(self->fBufferSem, 1, B_DO_NOT_RESCHEDULE);
+	return B_INVOKE_SCHEDULER;
+}
+
+
+/*!	The controller measures CTS when its I2S part is reset, against the
+	pixel clock of that moment: after a mode set, playing audio needs a new
+	measurement.
+*/
+void
+MesonHdmiAudio::ModeChanged()
+{
+	MutexLocker locker(fLock);
+	if (fRunning)
+		_SetupHdmi(false);
+}
