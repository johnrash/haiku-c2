+
+//	#pragma mark - kernel debugger
+
+
+/*!	Fills the ring with two tones that repeat seamlessly in it (19 and 43
+	periods per ring: 445.3 Hz left, 1007.8 Hz right, at -12 dBFS) and
+	starts playing it, for checking the output without a client.
+*/
+void
+MesonHdmiAudio::StartTone()
+{
+	int16* samples = (int16*)fRing;
+	uint32 frames = kRingSize / kFrameSize;
+	for (uint32 i = 0; i < frames; i++) {
+		// a sine from a parabola, good enough for a test tone
+		int32 phases[2] = { (int32)(i * 19 % frames), (int32)(i * 43 % frames) };
+		for (int c = 0; c < 2; c++) {
+			// x in [-1, 1) over one period
+			int64 x = (int64)phases[c] * 2 * 32768 / frames - 32768;
+			int64 y = 4 * x * (32768 - (x < 0 ? -x : x)) / 32768;
+				// -32768..32768, a sine shaped arch per half period
+			samples[i * 2 + c] = (int16)(-y / 4);
+		}
+	}
+	if (fRunning) {
+		kprintf("meson_hdmi: a client is playing\n");
+		return;
+	}
+	// no timer: nothing waits for buffers
+	_SetupClocks();
+	_SetupAiu();
+	_StartDma();
+	_SetupHdmi(true);
+	kprintf("meson_hdmi: test tone playing (445.3 Hz left, 1007.8 Hz"
+		" right)\n");
+}
+
+
+void
+MesonHdmiAudio::StopTone()
+{
+	if (!fRunning)
+		_StopDma();
+}
