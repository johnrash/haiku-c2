+
+status_t
+MesonHdmiAudio::Open()
+{
+	MutexLocker locker(fLock);
+	if (fOpen)
+		return B_BUSY;
+	fOpen = true;
+	return B_OK;
+}
+
+
+status_t
+MesonHdmiAudio::Close()
+{
+	MutexLocker locker(fLock);
+	if (fRunning)
+		_Stop();
+	_DeleteClientArea();
+	fOpen = false;
+	return B_OK;
+}
