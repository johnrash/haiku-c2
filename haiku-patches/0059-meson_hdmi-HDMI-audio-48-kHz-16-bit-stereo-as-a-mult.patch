+#ifndef MESON_HDMI_AUDIO_H
+#define MESON_HDMI_AUDIO_H
+
+
+#include <KernelExport.h>
+#include <lock.h>
+
+#include <hmulti_audio.h>
+
+
+/*!	What the audio part needs from the display driver: the HDMI TX ports
+	(one lock covers them) and the HHI clock registers.
+*/
+class MesonHdmiRegisters {
+public:
+	virtual						~MesonHdmiRegisters() {}
+
+	virtual	uint32				TopRead(uint32 reg) = 0;
+	virtual	void				TopWrite(uint32 reg, uint32 value) = 0;
+	virtual	uint8				DwRead(uint32 reg) = 0;
+	virtual	void				DwWrite(uint32 reg, uint8 value) = 0;
+	virtual	uint32				HhiRead(uint32 offset) = 0;
+	virtual	void				HhiWrite(uint32 offset, uint32 value) = 0;
+	virtual	uint32				PixelClock() = 0;	// kHz, 0: unknown
+};
+
+
+class MesonHdmiAudio {
+public:
+								MesonHdmiAudio(MesonHdmiRegisters* registers);
+								~MesonHdmiAudio();
+
+			status_t			Init();
+
+			// the published device (one opener at a time)
+			status_t			Open();
+			status_t			Close();
+			status_t			Control(uint32 op, void* arg, size_t length);
+
+			// the display driver: a new mode, a new pixel clock
+			void				ModeChanged();
+
+			// the kernel debugger: a test tone, register access
+			void				Dump();
+			void				StartTone();
+			void				StopTone();
+			uint32				ReadAiu(uint32 word)
+									{ return fAiu[word]; }
+			void				WriteAiu(uint32 word, uint32 value)
+									{ fAiu[word] = value; }
+
+			// multi_audio, through the drivers' generic dispatcher
+			status_t			GetDescription(multi_description* data);
+			status_t			GetEnabledChannels(multi_channel_enable* data);
+			status_t			GetGlobalFormat(multi_format_info* data);
+			status_t			GetBuffers(multi_buffer_list* data);
+			status_t			BufferExchange(multi_buffer_info* data);
+			status_t			ForceStop();
+
+private:
+			void				_SetupClocks();
+			void				_SetupAiu();
+			void				_SetupHdmi(bool debugger);
+			uint32				_Cts();
+			void				_StartDma();
+			void				_StopDma();
+			void				_Start();
+			void				_Stop();
+			void				_DeleteClientArea();
+	static	int32				_Poll(timer* timer);
+
+private:
+			MesonHdmiRegisters*	fRegisters;
+			area_id				fAiuArea;
+			volatile uint32*	fAiu;
+
+			area_id				fRingArea;		// the pages
+			area_id				fRingMapArea;	// kernel, write combining
+			uint8*				fRing;
+			phys_addr_t			fRingPhysical;
+			area_id				fClientArea;	// the opener's mapping
+			uint8*				fClientRing;
+
+			mutex				fLock;			// open, start, stop
+			spinlock			fStateLock;		// the poll timer's state
+			timer				fTimer;
+			sem_id				fBufferSem;
+			bool				fOpen;
+			bool				fRunning;
+			uint32				fPlaying;		// buffer the DMA reads
+			int64				fFramesPlayed;
+			bigtime_t			fBufferTime;	// when it began
+};
+
+
+#endif	// MESON_HDMI_AUDIO_H
