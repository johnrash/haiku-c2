+
+void
+MesonHdmiAudio::Dump()
+{
+	kprintf("meson_hdmi audio: %s, ring %#" B_PRIxPHYSADDR ", DMA read %#"
+		B_PRIx32 " level %#" B_PRIx32 " control %#" B_PRIx32 ", %" B_PRId64
+		" frames played\n", fRunning ? "running" : "stopped", fRingPhysical,
+		fAiu[AIU_MEM_I2S_RD_PTR], fAiu[AIU_MEM_I2S_LEVEL],
+		fAiu[AIU_MEM_I2S_CONTROL], fFramesPlayed);
+	kprintf("  HHI_AUD_CLK_CNTL %#" B_PRIx32 ", MPLL2 %#" B_PRIx32 "\n",
+		fRegisters->HhiRead(HHI_AUD_CLK_CNTL),
+		fRegisters->HhiRead(HHI_MPLL_CNTL9));
+	kprintf("  AIU: clk_ctrl %#" B_PRIx32 " more %#" B_PRIx32 ", source_desc %#"
+		B_PRIx32 ", dac_cfg %#" B_PRIx32 ", misc %#" B_PRIx32 ", hdmi %#"
+		B_PRIx32 "\n", fAiu[AIU_CLK_CTRL], fAiu[AIU_CLK_CTRL_MORE],
+		fAiu[AIU_I2S_SOURCE_DESC], fAiu[AIU_I2S_DAC_CFG], fAiu[AIU_I2S_MISC],
+		fAiu[AIU_HDMI_CLK_DATA_CTRL]);
+	kprintf("  TOP_CLK_CNTL %#" B_PRIx32 "; DW: FC_INVIDCONF %#x, MC_CLKDIS"
+		" %#x, AUD_CONF0 %#x CONF1 %#x INPUTCLKFS %#x, N %#x%02x%02x, CTS"
+		" %#x%02x%02x\n", fRegisters->TopRead(HDMITX_TOP_CLK_CNTL),
+		fRegisters->DwRead(DW_FC_INVIDCONF), fRegisters->DwRead(DW_MC_CLKDIS),
+		fRegisters->DwRead(DW_AUD_CONF0), fRegisters->DwRead(DW_AUD_CONF1),
+		fRegisters->DwRead(DW_AUD_INPUTCLKFS), fRegisters->DwRead(DW_AUD_N3),
+		fRegisters->DwRead(DW_AUD_N2), fRegisters->DwRead(DW_AUD_N1),
+		fRegisters->DwRead(DW_AUD_CTS3), fRegisters->DwRead(DW_AUD_CTS2),
+		fRegisters->DwRead(DW_AUD_CTS1));
+}
