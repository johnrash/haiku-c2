@@ -57,6 +57,7 @@ public:
 			status_t			GetDescription(multi_description* data);
 			status_t			GetEnabledChannels(multi_channel_enable* data);
 			status_t			GetGlobalFormat(multi_format_info* data);
+			status_t			SetGlobalFormat(multi_format_info* data);
 			status_t			GetBuffers(multi_buffer_list* data);
 			status_t			BufferExchange(multi_buffer_info* data);
 			status_t			ForceStop();
@@ -94,6 +95,7 @@ private:
 			uint32				fPlaying;		// buffer the DMA reads
 			int64				fFramesPlayed;
 			bigtime_t			fBufferTime;	// when it began
+			const struct audio_rate* fRate;
 };
 
 
