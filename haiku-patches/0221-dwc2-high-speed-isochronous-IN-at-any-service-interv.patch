 src/add-ons/kernel/busses/usb/dwc2.h          | 23 +++--
 .../kernel/busses/usb/dwc2_isochronous.cpp    | 94 +++++++++++++++----
 3 files changed, 94 insertions(+), 27 deletions(-)

