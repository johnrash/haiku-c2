+static bool
+IsLineBreak(const char* text, int32 offset)
+{
+	// after spaces and punctuation that separates words in file names,
+	// or before an opening bracket
+	return strchr(" -_.,;", text[offset - 1]) != NULL
+		|| text[offset] == '(' || text[offset] == '[';
+}
