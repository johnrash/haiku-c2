+float
+WidgetAttributeText::WrapString(BString* firstLine, BString* secondLine,
+	const char* text, int32 length, const BPoseView* view, float width)
+{
+	secondLine->Truncate(0);
+
+	float textWidth = view->StringWidth(text, length);
+	if (textWidth <= width || length < 2) {
+		firstLine->SetTo(text, length);
+		return textWidth;
+	}
+
+	// where the characters start
+	BStackOrHeapArray<int32, B_FILE_NAME_LENGTH + 1> starts(length + 1);
+	if (!starts.IsValid())
+		return TruncString(firstLine, text, length, view, width);
+
+	int32 count = 0;
+	for (int32 i = 0; i < length; i++) {
+		if ((text[i] & 0xc0) != 0x80)
+			starts[count++] = i;
+	}
+	starts[count] = length;
+
+	// the most characters that fit on the first line: all of them don't
+	BString prefix;
+	int32 fit = 1;
+	int32 tooMany = count;
+	while (tooMany - fit > 1) {
+		int32 middle = (fit + tooMany) / 2;
+		prefix.SetTo(text, starts[middle]);
+		if (view->StringWidth(prefix.String(), prefix.Length()) <= width)
+			fit = middle;
+		else
+			tooMany = middle;
+	}
+
+	// break between words if that keeps at least half of the line
+	int32 breakAt = starts[fit];
+	for (int32 i = fit; i > fit / 2 && i > 0; i--) {
+		if (IsLineBreak(text, starts[i])) {
+			breakAt = starts[i];
+			break;
+		}
+	}
+
+	int32 firstLength = breakAt;
+	while (firstLength > 1 && text[firstLength - 1] == ' ')
+		firstLength--;
+	firstLine->SetTo(text, firstLength);
+	float firstWidth = view->StringWidth(firstLine->String(),
+		firstLine->Length());
+
+	while (breakAt < length && text[breakAt] == ' ')
+		breakAt++;
+	if (breakAt == length)
+		return firstWidth;
+
+	BString rest(text + breakAt, length - breakAt);
+	float secondWidth = TruncString(secondLine, rest.String(), rest.Length(),
+		view, width, B_TRUNCATE_MIDDLE);
+
+	return std::max(firstWidth, secondWidth);
+}
