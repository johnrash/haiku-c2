diff --git a/headers/os/device/DigitalPin.h b/headers/os/device/DigitalPin.h
new file mode 100644
index 0000000000..c99d6e267f
--- /dev/null
+++ b/headers/os/device/DigitalPin.h
@@ -0,0 +1,109 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef	_DIGITAL_PIN_H
+#define	_DIGITAL_PIN_H
+
+
+#include <BeBuild.h>
+#include <OS.h>
+#include <SupportDefs.h>
+
+
+class BMessenger;
+
+
+/*!	One GPIO pin of the ODROID-C2's 40-pin header, in the manner of the
+	BeBox GeekPort's BDigitalPort: "Pin7" (the header's numbering) or the
+	SoC's name ("GPIOX_21"). The pins are 3.3 V, and not 5 V tolerant.
+
+	Edges: from the first WaitForEdge() (or StartWatching()) on, the pin's
+	edges of that kind are recorded, so a loop of waits misses none (up to
+	32 wait; older ones are lost, and "missed" says how many). They are
+	interrupts: 8 hardware channels for the whole header, an edge kind of a
+	pin takes one (B_ANY_EDGE two), B_BUSY when they are taken. An output
+	sees its own edges.
+*/
+
+
+enum pin_pull {
+	B_PIN_PULL_NONE = 0,
+	B_PIN_PULL_DOWN,
+	B_PIN_PULL_UP
+};
+
+enum pin_edge {
+	B_PIN_RISING_EDGE = 1,
+	B_PIN_FALLING_EDGE = 2,
+	B_PIN_ANY_EDGE = 3
+};
+
+enum {
+	B_DIGITAL_PIN_CHANGED = 'DPch'
+		// StartWatching()'s messages: "pin" (int32, the header's number),
+		// "edge" (int32, B_PIN_RISING_EDGE or B_PIN_FALLING_EDGE), "level"
+		// (bool, just after it), "when" (int64, system_time()), and
+		// "missed" (int32) when edges were lost before this one
+};
+
+
+class BDigitalPin {
+public:
+							BDigitalPin();
+	virtual					~BDigitalPin();
+
+			status_t		Open(const char* name);
+								// as an input, its pull as it was
+			void			Close();
+								// the pin becomes an input
+			bool			IsOpen() const;
+
+			status_t		SetAsInput();
+			status_t		SetAsOutput(bool level);
+								// the level first: no glitch
+			bool			IsInput() const;
+			bool			IsOutput() const;
+			status_t		SetPull(pin_pull pull);
+
+			status_t		Read(bool* level);
+								// inputs and outputs
+			status_t		Write(bool level);
+								// B_NOT_ALLOWED on an input
+
+			status_t		WaitForEdge(pin_edge edge,
+								bigtime_t timeout = B_INFINITE_TIMEOUT,
+								bool* _level = NULL,
+								bigtime_t* _when = NULL);
+								// B_TIMED_OUT; B_INTERRUPTED (a
+								// signal); B_BUSY while watching
+			status_t		StartWatching(BMessenger target,
+								pin_edge edge = B_PIN_ANY_EDGE);
+								// B_DIGITAL_PIN_CHANGED for each edge,
+								// from a thread of its own
+			status_t		StopWatching();
+
+			int32			CountDevices();
+			status_t		GetDeviceName(int32 index, char* name,
+								size_t bufSize = B_OS_NAME_LENGTH);
+
+private:
+			status_t		_RecordEdges(pin_edge edge);
+	static	status_t		_Watch(void* data);
+
+	virtual	void			_ReservedDigitalPin1();
+	virtual	void			_ReservedDigitalPin2();
+	virtual	void			_ReservedDigitalPin3();
+
+			int				fFd;
+			bool			fIsInput;
+			int32			fPin;
+			thread_id		fWatcher;
+			BMessenger*		fTarget;
+			uint32			fRecordedEdges;
+	volatile bool			fStopWatching;
+			uint32			_reserved[4];
+};
+
+
+#endif // _DIGITAL_PIN_H
diff --git a/headers/os/device/GeekPort.h b/headers/os/device/GeekPort.h
new file mode 100644
index 0000000000..2cc35ed525
--- /dev/null
+++ b/headers/os/device/GeekPort.h
@@ -0,0 +1,56 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef	_GEEK_PORT_H
+#define	_GEEK_PORT_H
+
+
+#include <BeBuild.h>
+#include <OS.h>
+#include <SupportDefs.h>
+
+
+/*!	The ODROID-C2's 40-pin header, this port's GeekPort: what each pin is,
+	what it can do, and what it is doing. The pins are used through
+	BDigitalPort, BDigitalPin, BA2D, BD2A, BPWM, BSerialPort ("header") and
+	BI2CDevice.
+*/
+
+
+enum geekport_pin_capability {
+	B_GEEKPORT_GPIO		= 0x01,
+	B_GEEKPORT_PWM		= 0x02,
+	B_GEEKPORT_UART		= 0x04,
+	B_GEEKPORT_I2C		= 0x08,
+	B_GEEKPORT_ANALOG	= 0x10,		// an A/D input, 0 to 1.8 V
+	B_GEEKPORT_POWER	= 0x20,		// 5 V, 3.3 V or the 1.8 V reference
+	B_GEEKPORT_GROUND	= 0x40
+};
+
+
+struct geekport_pin_info {
+	int32			pin;			// 1 to 40
+	char			name[16];		// "GPIOX_21", "3.3V", "GND", "ADC.AIN0"
+	uint32			capabilities;	// geekport_pin_capability
+	char			function[16];	// now: "input", "output", "PWM",
+									// "I2C A", "UART A", "analog", "power",
+									// "ground"
+	char			user[32];		// who has it: "" (free), "program",
+									// "I2C A" (the kernel), ...
+	team_id			team;			// a program's team, or -1
+	uint32			_reserved[4];
+};
+
+
+class BGeekPort {
+public:
+	static	int32			CountPins();
+	static	status_t		GetPinInfo(int32 pin, geekport_pin_info* info);
+
+private:
+							BGeekPort();
+};
+
+
+#endif // _GEEK_PORT_H
diff --git a/headers/os/device/PWM.h b/headers/os/device/PWM.h
new file mode 100644
index 0000000000..e0fcb000ee
--- /dev/null
+++ b/headers/os/device/PWM.h
@@ -0,0 +1,67 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef	_PWM_H
+#define	_PWM_H
+
+
+#include <BeBuild.h>
+#include <OS.h>
+#include <SupportDefs.h>
+
+
+/*!	A PWM output of the ODROID-C2's 40-pin header, with a period and pulse
+	width of your choosing (BD2A drives the same outputs as D/A channels):
+	"PWM1" on pin 11, "PWM2" on pin 19, 3.3 V. Periods from about 84 ns to
+	0.35 s (3 Hz); at 50 Hz (servos) the pulse width moves in steps of
+	about 0.33 us. Closing stops the output, the pin low: a motor or servo
+	shouldn't run on after its program.
+*/
+class BPWM {
+public:
+							BPWM();
+	virtual					~BPWM();
+
+			status_t		Open(const char* name);
+								// stopped, the pin low
+			void			Close();
+			bool			IsOpen() const;
+
+			status_t		SetPeriod(uint32 nanoseconds);
+			status_t		SetFrequency(float hertz);
+			status_t		SetPulseWidth(uint32 nanoseconds);
+			status_t		SetDutyCycle(float fraction);
+								// 0 to 1, kept when the period changes
+			uint32			Period() const;
+			uint32			PulseWidth() const;
+								// what the hardware makes of them
+			float			DutyCycle() const;
+
+			status_t		Start();
+			status_t		Stop();
+								// the pin low
+			bool			IsRunning() const;
+
+			int32			CountDevices();
+			status_t		GetDeviceName(int32 index, char* name,
+								size_t bufSize = B_OS_NAME_LENGTH);
+
+private:
+			status_t		_Apply();
+
+	virtual	void			_ReservedPWM1();
+	virtual	void			_ReservedPWM2();
+	virtual	void			_ReservedPWM3();
+
+			int				fFd;
+			uint32			fPeriod;
+			uint32			fPulseWidth;
+			float			fDutyCycle;
+			bool			fKeepDutyCycle;
+			bool			fRunning;
+			uint32			_reserved[4];
+};
+
+
+#endif // _PWM_H
diff --git a/src/kits/device/DigitalPin.cpp b/src/kits/device/DigitalPin.cpp
new file mode 100644
index 0000000000..75fc026d9c
--- /dev/null
+++ b/src/kits/device/DigitalPin.cpp
@@ -0,0 +1,430 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * One GPIO pin of the ODROID-C2's 40-pin header, through meson_gpio
+ * (headers/private/drivers/meson_gpio.h): "Pin7" or "GPIOX_21". Elsewhere
+ * Open() fails.
+ */
+
+
+#include <DigitalPin.h>
+
+#include <new>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+
+#include <Message.h>
+#include <Messenger.h>
+
+#include <meson_gpio.h>
+
+
+namespace {
+
+/*!	The header pin \a name ("Pin7", "7", "GPIOX_21") is, or 0. */
+int32
+find_pin(int fd, const char* name)
+{
+	if (name == NULL)
+		return 0;
+	const char* number = strncasecmp(name, "pin", 3) == 0 ? name + 3 : name;
+	char* end;
+	long value = strtol(number, &end, 10);
+	bool isNumber = *number != '\0' && *end == '\0';
+	meson_gpio_pin_info info;
+	for (info.index = 0; ioctl(fd, MESON_GPIO_GET_PIN_INFO, &info,
+			sizeof(info)) == 0; info.index++) {
+		if ((info.flags & MESON_GPIO_PIN_GPIO) == 0)
+			continue;
+		if ((isNumber && (long)info.pin == value)
+			|| strcasecmp(info.pad, name) == 0) {
+			return info.pin;
+		}
+	}
+	return 0;
+}
+
+}	// namespace
+
+
+BDigitalPin::BDigitalPin()
+	:
+	fFd(-1),
+	fIsInput(true),
+	fPin(0),
+	fWatcher(-1),
+	fTarget(NULL),
+	fRecordedEdges(0),
+	fStopWatching(false)
+{
+}
+
+
+BDigitalPin::~BDigitalPin()
+{
+	Close();
+}
+
+
+/*!	Opens a pin as an input, its pull as it was. Returns B_OK, or an error
+	(B_BUSY: someone else has the pin).
+*/
+status_t
+BDigitalPin::Open(const char* name)
+{
+	Close();
+	int fd = open(MESON_GPIO_DEVICE, O_RDWR | O_CLOEXEC);
+	if (fd < 0)
+		return B_ERROR;
+	int32 pin = find_pin(fd, name);
+	if (pin == 0) {
+		close(fd);
+		return B_ENTRY_NOT_FOUND;
+	}
+	meson_gpio_pins pins;
+	pins.count = 1;
+	pins.pins[0] = pin;
+	if (ioctl(fd, MESON_GPIO_CLAIM, &pins, sizeof(pins)) != 0) {
+		status_t status = errno;
+		close(fd);
+		return status;
+	}
+	uint32 outputs = 0;
+	if (ioctl(fd, MESON_GPIO_SET_OUTPUTS, &outputs, sizeof(outputs)) != 0) {
+		close(fd);
+		return B_ERROR;
+	}
+	fFd = fd;
+	fPin = pin;
+	fIsInput = true;
+	return B_OK;
+}
+
+
+/*!	Closes the pin; it becomes an input. */
+void
+BDigitalPin::Close()
+{
+	StopWatching();
+	if (fFd >= 0)
+		close(fFd);
+	fFd = -1;
+	fPin = 0;
+	fIsInput = true;
+	fRecordedEdges = 0;
+}
+
+
+bool
+BDigitalPin::IsOpen() const
+{
+	return fFd >= 0;
+}
+
+
+status_t
+BDigitalPin::SetAsInput()
+{
+	uint32 outputs = 0;
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (ioctl(fFd, MESON_GPIO_SET_OUTPUTS, &outputs, sizeof(outputs)) != 0)
+		return errno;
+	fIsInput = true;
+	return B_OK;
+}
+
+
+/*!	The pin as an output at \a level: the level is set first. */
+status_t
+BDigitalPin::SetAsOutput(bool level)
+{
+	uint32 levels = level ? 1 : 0;
+	uint32 outputs = 1;
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (ioctl(fFd, MESON_GPIO_WRITE, &levels, sizeof(levels)) != 0
+		|| ioctl(fFd, MESON_GPIO_SET_OUTPUTS, &outputs, sizeof(outputs))
+			!= 0) {
+		return errno;
+	}
+	fIsInput = false;
+	return B_OK;
+}
+
+
+bool
+BDigitalPin::IsInput() const
+{
+	return fFd >= 0 && fIsInput;
+}
+
+
+bool
+BDigitalPin::IsOutput() const
+{
+	return fFd >= 0 && !fIsInput;
+}
+
+
+status_t
+BDigitalPin::SetPull(pin_pull pull)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	meson_gpio_pull request;
+	request.bits = 1;
+	switch (pull) {
+		case B_PIN_PULL_NONE:
+			request.pull = MESON_GPIO_PULL_NONE;
+			break;
+		case B_PIN_PULL_DOWN:
+			request.pull = MESON_GPIO_PULL_DOWN;
+			break;
+		case B_PIN_PULL_UP:
+			request.pull = MESON_GPIO_PULL_UP;
+			break;
+		default:
+			return B_BAD_VALUE;
+	}
+	if (ioctl(fFd, MESON_GPIO_SET_PULL, &request, sizeof(request)) != 0)
+		return errno;
+	return B_OK;
+}
+
+
+/*!	The level on the pin, input or output. */
+status_t
+BDigitalPin::Read(bool* level)
+{
+	uint32 levels;
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (level == NULL)
+		return B_BAD_VALUE;
+	if (ioctl(fFd, MESON_GPIO_READ, &levels, sizeof(levels)) != 0)
+		return errno;
+	*level = (levels & 1) != 0;
+	return B_OK;
+}
+
+
+/*!	Drives \a level on an output; B_NOT_ALLOWED on an input. */
+status_t
+BDigitalPin::Write(bool level)
+{
+	uint32 levels = level ? 1 : 0;
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (fIsInput)
+		return B_NOT_ALLOWED;
+	if (ioctl(fFd, MESON_GPIO_WRITE, &levels, sizeof(levels)) != 0)
+		return errno;
+	return B_OK;
+}
+
+
+/*!	The oldest edge of that kind recorded since the first wait for it
+	(another kind starts again): its level just after it, and when it came.
+*/
+status_t
+BDigitalPin::WaitForEdge(pin_edge edge, bigtime_t timeout, bool* _level,
+	bigtime_t* _when)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (fWatcher >= 0)
+		return B_BUSY;
+	status_t status = _RecordEdges(edge);
+	if (status != B_OK)
+		return status;
+	meson_gpio_edge event;
+	event.bit = 0;
+	event.timeout = timeout;
+	if (ioctl(fFd, MESON_GPIO_WAIT_EDGE, &event, sizeof(event)) != 0)
+		return errno;
+	if (_level != NULL)
+		*_level = event.level != 0;
+	if (_when != NULL)
+		*_when = event.when;
+	return B_OK;
+}
+
+
+/*!	Sends \a target a B_DIGITAL_PIN_CHANGED message for each edge of that
+	kind, until StopWatching() or Close().
+*/
+status_t
+BDigitalPin::StartWatching(BMessenger target, pin_edge edge)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (!target.IsValid())
+		return B_BAD_VALUE;
+	StopWatching();
+	status_t status = _RecordEdges(edge);
+	if (status != B_OK)
+		return status;
+	fTarget = new(std::nothrow) BMessenger(target);
+	if (fTarget == NULL)
+		return B_NO_MEMORY;
+	fStopWatching = false;
+	char name[B_OS_NAME_LENGTH];
+	snprintf(name, sizeof(name), "pin %" B_PRId32 " watcher", fPin);
+	fWatcher = spawn_thread(&_Watch, name, B_DISPLAY_PRIORITY, this);
+	if (fWatcher < 0) {
+		status = fWatcher;
+		fWatcher = -1;
+		delete fTarget;
+		fTarget = NULL;
+		return status;
+	}
+	resume_thread(fWatcher);
+	return B_OK;
+}
+
+
+status_t
+BDigitalPin::StopWatching()
+{
+	if (fWatcher < 0)
+		return B_OK;
+	fStopWatching = true;
+	// the end of the recording ends the thread's wait
+	meson_gpio_edges edges;
+	edges.bit = 0;
+	edges.edges = 0;
+	ioctl(fFd, MESON_GPIO_SET_EDGES, &edges, sizeof(edges));
+	fRecordedEdges = 0;
+	status_t result;
+	wait_for_thread(fWatcher, &result);
+	fWatcher = -1;
+	delete fTarget;
+	fTarget = NULL;
+	return B_OK;
+}
+
+
+/*!	The pins this class can open (whether free or not). */
+int32
+BDigitalPin::CountDevices()
+{
+	int fd = open(MESON_GPIO_DEVICE, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return 0;
+	int32 count = 0;
+	meson_gpio_pin_info info;
+	for (info.index = 0; ioctl(fd, MESON_GPIO_GET_PIN_INFO, &info,
+			sizeof(info)) == 0; info.index++) {
+		if ((info.flags & MESON_GPIO_PIN_GPIO) != 0)
+			count++;
+	}
+	close(fd);
+	return count;
+}
+
+
+/*!	The name of a pin this class can open: "Pin7". */
+status_t
+BDigitalPin::GetDeviceName(int32 index, char* name, size_t bufSize)
+{
+	if (name == NULL || index < 0)
+		return B_BAD_VALUE;
+	int fd = open(MESON_GPIO_DEVICE, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return B_ERROR;
+	status_t status = B_BAD_INDEX;
+	meson_gpio_pin_info info;
+	for (info.index = 0; ioctl(fd, MESON_GPIO_GET_PIN_INFO, &info,
+			sizeof(info)) == 0; info.index++) {
+		if ((info.flags & MESON_GPIO_PIN_GPIO) == 0 || index-- > 0)
+			continue;
+		snprintf(name, bufSize, "Pin%" B_PRIu32, info.pin);
+		status = B_OK;
+		break;
+	}
+	close(fd);
+	return status;
+}
+
+
+/*!	The driver records \a edge from now on, unless it does already: the
+	pin_edge values are its MESON_GPIO_EDGE_* bits.
+*/
+status_t
+BDigitalPin::_RecordEdges(pin_edge edge)
+{
+	if (edge < B_PIN_RISING_EDGE || edge > B_PIN_ANY_EDGE)
+		return B_BAD_VALUE;
+	if (fRecordedEdges == (uint32)edge)
+		return B_OK;
+	meson_gpio_edges edges;
+	edges.bit = 0;
+	edges.edges = edge;
+	fRecordedEdges = 0;
+	if (ioctl(fFd, MESON_GPIO_SET_EDGES, &edges, sizeof(edges)) != 0)
+		return errno;
+	fRecordedEdges = edge;
+	return B_OK;
+}
+
+
+/*static*/ status_t
+BDigitalPin::_Watch(void* data)
+{
+	BDigitalPin* pin = (BDigitalPin*)data;
+	while (!pin->fStopWatching) {
+		meson_gpio_edge event;
+		event.bit = 0;
+		event.timeout = B_INFINITE_TIMEOUT;
+		if (ioctl(pin->fFd, MESON_GPIO_WAIT_EDGE, &event, sizeof(event))
+				!= 0) {
+			if (errno == B_INTERRUPTED)
+				continue;
+			break;
+		}
+		BMessage message(B_DIGITAL_PIN_CHANGED);
+		message.AddInt32("pin", pin->fPin);
+		message.AddInt32("edge", event.edge == MESON_GPIO_EDGE_RISING
+			? B_PIN_RISING_EDGE : B_PIN_FALLING_EDGE);
+		message.AddBool("level", event.level != 0);
+		message.AddInt64("when", event.when);
+		if (event.missed > 0)
+			message.AddInt32("missed", event.missed);
+		// in steps, so that a target that waits in StopWatching() with a
+		// full port doesn't wait for good
+		status_t status;
+		do {
+			status = pin->fTarget->SendMessage(&message, (BHandler*)NULL,
+				100000);
+		} while (status == B_TIMED_OUT && !pin->fStopWatching);
+		if (status == B_BAD_PORT_ID)
+			break;
+	}
+	return B_OK;
+}
+
+
+void
+BDigitalPin::_ReservedDigitalPin1()
+{
