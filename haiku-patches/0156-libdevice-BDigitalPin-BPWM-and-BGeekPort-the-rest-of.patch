diff --git a/src/kits/device/GeekPort.cpp b/src/kits/device/GeekPort.cpp
new file mode 100644
index 0000000000..521fe5a924
--- /dev/null
+++ b/src/kits/device/GeekPort.cpp
@@ -0,0 +1,116 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * The ODROID-C2's 40-pin header (J2, board revision 0.2, as Hardkernel's
+ * wiki lists it): the fixed pins here, the SoC's pins from meson_gpio
+ * (headers/private/drivers/meson_gpio.h). Elsewhere there are no pins.
+ */
+
+
+#include <GeekPort.h>
+
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <meson_gpio.h>
+
+
+namespace {
+
+struct fixed_pin {
+	int32		pin;
+	const char*	name;
+	uint32		capabilities;
+	const char*	function;
+};
+
+const fixed_pin kFixedPins[] = {
+	{ 1, "3.3V", B_GEEKPORT_POWER, "power" },
+	{ 2, "5V", B_GEEKPORT_POWER, "power" },
+	{ 4, "5V", B_GEEKPORT_POWER, "power" },
+	{ 6, "GND", B_GEEKPORT_GROUND, "ground" },
+	{ 9, "GND", B_GEEKPORT_GROUND, "ground" },
+	{ 14, "GND", B_GEEKPORT_GROUND, "ground" },
+	{ 17, "3.3V", B_GEEKPORT_POWER, "power" },
+	{ 20, "GND", B_GEEKPORT_GROUND, "ground" },
+	{ 25, "GND", B_GEEKPORT_GROUND, "ground" },
+	{ 30, "GND", B_GEEKPORT_GROUND, "ground" },
+	{ 34, "GND", B_GEEKPORT_GROUND, "ground" },
+	{ 37, "ADC.AIN1", B_GEEKPORT_ANALOG, "analog" },
+	{ 38, "1.8V REF", B_GEEKPORT_POWER, "power" },
+	{ 39, "GND", B_GEEKPORT_GROUND, "ground" },
+	{ 40, "ADC.AIN0", B_GEEKPORT_ANALOG, "analog" },
+};
+
+const int32 kPinCount = 40;
+
+}	// namespace
+
+
+int32
+BGeekPort::CountPins()
+{
+	return access(MESON_GPIO_DEVICE, F_OK) == 0 ? kPinCount : 0;
+}
+
+
+status_t
+BGeekPort::GetPinInfo(int32 pin, geekport_pin_info* info)
+{
+	if (info == NULL)
+		return B_BAD_VALUE;
+	if (pin < 1 || pin > kPinCount || CountPins() == 0)
+		return B_BAD_INDEX;
+	memset(info, 0, sizeof(*info));
+	info->pin = pin;
+	info->team = -1;
+
+	for (size_t i = 0; i < B_COUNT_OF(kFixedPins); i++) {
+		if (kFixedPins[i].pin != pin)
+			continue;
+		strlcpy(info->name, kFixedPins[i].name, sizeof(info->name));
+		info->capabilities = kFixedPins[i].capabilities;
+		strlcpy(info->function, kFixedPins[i].function,
+			sizeof(info->function));
+		return B_OK;
+	}
+
+	int fd = open(MESON_GPIO_DEVICE, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return B_ERROR;
+	status_t status = B_BAD_INDEX;
+	meson_gpio_pin_info pinInfo;
+	for (pinInfo.index = 0; ioctl(fd, MESON_GPIO_GET_PIN_INFO, &pinInfo,
+			sizeof(pinInfo)) == 0; pinInfo.index++) {
+		if ((int32)pinInfo.pin != pin)
+			continue;
+		strlcpy(info->name, pinInfo.pad, sizeof(info->name));
+		if ((pinInfo.flags & MESON_GPIO_PIN_GPIO) != 0)
+			info->capabilities |= B_GEEKPORT_GPIO;
+		if ((pinInfo.flags & MESON_GPIO_PIN_PWM) != 0)
+			info->capabilities |= B_GEEKPORT_PWM;
+		if ((pinInfo.flags & MESON_GPIO_PIN_UART) != 0)
+			info->capabilities |= B_GEEKPORT_UART;
+		if ((pinInfo.flags & MESON_GPIO_PIN_I2C) != 0)
+			info->capabilities |= B_GEEKPORT_I2C;
+		if (strcmp(pinInfo.function, "GPIO") == 0) {
+			strlcpy(info->function,
+				(pinInfo.flags & MESON_GPIO_PIN_OUTPUT) != 0
+					? "output" : "input", sizeof(info->function));
+		} else if (strncmp(pinInfo.function, "PWM", 3) == 0)
+			strlcpy(info->function, "PWM", sizeof(info->function));
+		else {
+			strlcpy(info->function, pinInfo.function,
+				sizeof(info->function));
+		}
+		strlcpy(info->user, pinInfo.use, sizeof(info->user));
+		info->team = pinInfo.team;
+		status = B_OK;
+		break;
+	}
+	close(fd);
+	return status;
+}
