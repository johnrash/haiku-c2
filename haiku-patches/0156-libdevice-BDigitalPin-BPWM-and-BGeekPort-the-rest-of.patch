diff --git a/src/kits/device/PWM.cpp b/src/kits/device/PWM.cpp
new file mode 100644
index 0000000000..7927488a30
--- /dev/null
+++ b/src/kits/device/PWM.cpp
@@ -0,0 +1,279 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * A PWM output of the ODROID-C2's 40-pin header, through meson_gpio
+ * (headers/private/drivers/meson_gpio.h): "PWM1" on pin 11, "PWM2" on pin
+ * 19. Elsewhere Open() fails.
+ */
+
+
+#include <PWM.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <strings.h>
+#include <unistd.h>
+
+#include <meson_gpio.h>
+
+
+namespace {
+
+struct pwm_channel {
+	const char*	name;
+	uint8		pin;
+};
+
+const pwm_channel kChannels[] = {
+	{ "PWM1", 11 },
+	{ "PWM2", 19 },
+};
+
+const uint32 kDefaultPeriod = 1000000;		// 1 kHz
+
+}	// namespace
+
+
+BPWM::BPWM()
+	:
+	fFd(-1),
+	fPeriod(kDefaultPeriod),
+	fPulseWidth(0),
+	fDutyCycle(0),
+	fKeepDutyCycle(true),
+	fRunning(false)
+{
+}
+
+
+BPWM::~BPWM()
+{
+	Close();
+}
+
+
+/*!	Opens "PWM1" or "PWM2", stopped (the pin low), with a period of 1 ms.
+	Returns B_OK, or an error (B_BUSY: someone else has the pin).
+*/
+status_t
+BPWM::Open(const char* name)
+{
+	Close();
+	if (name == NULL)
+		return B_BAD_VALUE;
+	for (size_t i = 0; i < B_COUNT_OF(kChannels); i++) {
+		if (strcasecmp(name, kChannels[i].name) != 0)
+			continue;
+		int fd = open(MESON_GPIO_DEVICE, O_RDWR | O_CLOEXEC);
+		if (fd < 0)
+			return B_ERROR;
+		meson_gpio_pins pins;
+		pins.count = 1;
+		pins.pins[0] = kChannels[i].pin;
+		if (ioctl(fd, MESON_GPIO_CLAIM, &pins, sizeof(pins)) != 0) {
+			status_t status = errno;
+			close(fd);
+			return status;
+		}
+		fFd = fd;
+		fPeriod = kDefaultPeriod;
+		fPulseWidth = 0;
+		fDutyCycle = 0;
+		fKeepDutyCycle = true;
+		fRunning = false;
+		return Stop();
+	}
+	return B_ENTRY_NOT_FOUND;
+}
+
+
+/*!	Stops the output (the pin low) and closes the channel. */
+void
+BPWM::Close()
+{
+	if (fFd < 0)
+		return;
+	Stop();
+	close(fFd);
+	fFd = -1;
+}
+
+
+bool
+BPWM::IsOpen() const
+{
+	return fFd >= 0;
+}
+
+
+/*!	The hardware's period and pulse width for what was asked, while the
+	output runs; else the pin low.
+*/
+status_t
+BPWM::_Apply()
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	meson_gpio_pwm_period period;
+	period.bit = 0;
+	period.period = fPeriod;
+	period.high = fRunning ? fPulseWidth : 0;
+	if (ioctl(fFd, MESON_GPIO_SET_PWM_PERIOD, &period, sizeof(period)) != 0)
+		return errno;
+	fPeriod = period.period;
+	if (fRunning)
+		fPulseWidth = period.high;
+	return B_OK;
+}
+
+
+status_t
+BPWM::SetPeriod(uint32 nanoseconds)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (nanoseconds == 0)
+		return B_BAD_VALUE;
+	uint32 oldPeriod = fPeriod;
+	uint32 oldPulseWidth = fPulseWidth;
+	fPeriod = nanoseconds;
+	if (fKeepDutyCycle)
+		fPulseWidth = (uint32)(fDutyCycle * fPeriod + 0.5f);
+	else if (fPulseWidth > fPeriod)
+		fPulseWidth = fPeriod;
+	status_t status = _Apply();
+	if (status != B_OK) {
+		fPeriod = oldPeriod;
+		fPulseWidth = oldPulseWidth;
+		_Apply();
+	}
+	return status;
+}
+
+
+status_t
+BPWM::SetFrequency(float hertz)
+{
+	if (hertz <= 0)
+		return B_BAD_VALUE;
+	return SetPeriod((uint32)(1000000000.0f / hertz + 0.5f));
+}
+
+
+status_t
+BPWM::SetPulseWidth(uint32 nanoseconds)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (nanoseconds > fPeriod)
+		return B_BAD_VALUE;
+	fPulseWidth = nanoseconds;
+	fDutyCycle = (float)nanoseconds / fPeriod;
+	fKeepDutyCycle = false;
+	return _Apply();
+}
+
+
+status_t
+BPWM::SetDutyCycle(float fraction)
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	if (fraction < 0 || fraction > 1)
+		return B_BAD_VALUE;
+	fDutyCycle = fraction;
+	fKeepDutyCycle = true;
+	fPulseWidth = (uint32)(fraction * fPeriod + 0.5f);
+	return _Apply();
+}
+
+
+uint32
+BPWM::Period() const
+{
+	return fPeriod;
+}
+
+
+uint32
+BPWM::PulseWidth() const
+{
+	return fPulseWidth;
+}
+
+
+float
+BPWM::DutyCycle() const
+{
+	return fPeriod > 0 ? (float)fPulseWidth / fPeriod : 0;
+}
+
+
+status_t
+BPWM::Start()
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	fRunning = true;
+	status_t status = _Apply();
+	if (status != B_OK)
+		fRunning = false;
+	return status;
+}
+
+
+/*!	Stops the output: the pin low. */
+status_t
+BPWM::Stop()
+{
+	if (fFd < 0)
+		return B_NO_INIT;
+	fRunning = false;
+	return _Apply();
+}
+
+
+bool
+BPWM::IsRunning() const
+{
+	return fFd >= 0 && fRunning;
+}
+
+
+int32
+BPWM::CountDevices()
+{
+	return B_COUNT_OF(kChannels);
+}
+
+
+status_t
+BPWM::GetDeviceName(int32 index, char* name, size_t bufSize)
+{
+	if (name == NULL || index < 0)
+		return B_BAD_VALUE;
+	if (index >= (int32)B_COUNT_OF(kChannels))
+		return B_BAD_INDEX;
+	strlcpy(name, kChannels[index].name, bufSize);
+	return B_OK;
+}
+
