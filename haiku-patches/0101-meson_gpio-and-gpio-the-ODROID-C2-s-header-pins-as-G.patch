+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * gpio: the board's header pins as GPIO, through /dev/misc/gpio (the
+ * ODROID-C2's meson_gpio driver).
+ */
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+
+static const char* kDevice = "/dev/misc/gpio";
+
+
+static void
+usage(int status)
+{
+	fprintf(stderr,
+		"usage: gpio                          the header's GPIO pins\n"
+		"       gpio <pin>                    one pin\n"
+		"       gpio <pin> out 0|1            an output at that level\n"
+		"       gpio <pin> in [up|down|none]  an input, with that pull\n"
+		"       gpio <pin> release            the pin as it was before\n"
+		"<pin> is the header pin number or the SoC pin's name (GPIOX_21).\n");
+	exit(status);
+}
+
+
+static int
+list(const char* pin)
+{
+	int fd = open(kDevice, O_RDONLY);
+	if (fd < 0) {
+		fprintf(stderr, "gpio: %s: %s\n", kDevice, strerror(errno));
+		return 1;
+	}
+	char text[4096];
+	ssize_t length = read(fd, text, sizeof(text) - 1);
+	close(fd);
+	if (length < 0) {
+		fprintf(stderr, "gpio: reading %s: %s\n", kDevice, strerror(errno));
+		return 1;
+	}
+	text[length] = '\0';
+
+	bool found = pin == NULL;
+	char* save;
+	bool first = true;
+	for (char* line = strtok_r(text, "\n", &save); line != NULL;
+			line = strtok_r(NULL, "\n", &save), first = false) {
+		if (pin == NULL || first) {
+			puts(line);
+			continue;
+		}
+		// "<pin>  <name>  ..."
+		char number[16], name[32];
+		if (sscanf(line, "%15s %31s", number, name) == 2
+			&& (strcmp(number, pin) == 0 || strcasecmp(name, pin) == 0)) {
+			puts(line);
+			found = true;
+		}
+	}
+	if (!found) {
+		fprintf(stderr, "gpio: no header pin \"%s\"\n", pin);
+		return 1;
+	}
+	return 0;
+}
+
+
+int
+main(int argc, char** argv)
+{
+	if (argc > 1 && (strcmp(argv[1], "-h") == 0
+			|| strcmp(argv[1], "--help") == 0)) {
+		usage(0);
+	}
+	if (argc <= 2)
+		return list(argc == 2 ? argv[1] : NULL);
+	if (argc > 4)
+		usage(1);
+
+	char command[128];
+	snprintf(command, sizeof(command), "%s %s%s%s\n", argv[1], argv[2],
+		argc > 3 ? " " : "", argc > 3 ? argv[3] : "");
+	int fd = open(kDevice, O_WRONLY);
+	if (fd < 0) {
+		fprintf(stderr, "gpio: %s: %s\n", kDevice, strerror(errno));
+		return 1;
+	}
+	if (write(fd, command, strlen(command)) < 0) {
+		int error = errno;
+		close(fd);
+		fprintf(stderr, "gpio: %s", strerror(error));
+		if (error == EBUSY)
+			fprintf(stderr, " (the pin's I2C function is in use)");
+		else if (error == ENOENT)
+			fprintf(stderr, " (no such header pin)");
+		else if (error == EINVAL)
+			fprintf(stderr, " (see gpio --help)");
+		fprintf(stderr, "\n");
+		return 1;
+	}
+	close(fd);
+	return list(argv[1]);
+}
