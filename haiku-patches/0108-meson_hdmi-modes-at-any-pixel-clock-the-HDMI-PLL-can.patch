+static uint32
+mode_h_total(const meson_mode& mode)
+{
+	return mode.hActive + mode.hFront + mode.hSync + mode.hBack;
+}
+
+
+static uint32
+mode_v_total(const meson_mode& mode)
+{
+	return mode.vActive + mode.vFront + mode.vSync + mode.vBack;
+}
+
+
+static uint32
+mode_refresh(const meson_mode& mode)
+{
+	uint32 frame = mode_h_total(mode) * mode_v_total(mode);
+	return (mode.pixelClock * 1000 + frame / 2) / frame;
+}
+
+
+/*!	The same picture: equal sizes and totals, clocks within 0.5% (so that
+	VIC 1's 25.2 MHz is DMT's 25.175 MHz).
+*/
+static bool
+same_timing(const meson_mode& a, const meson_mode& b)
+{
+	uint32 difference = a.pixelClock > b.pixelClock
+		? a.pixelClock - b.pixelClock : b.pixelClock - a.pixelClock;
+	return a.hActive == b.hActive && a.vActive == b.vActive
+		&& mode_h_total(a) == mode_h_total(b)
+		&& mode_v_total(a) == mode_v_total(b)
+		&& difference * 200 <= a.pixelClock;
+}
+
+
+/*!	What the PLL, the encoder and the frame composer can make: a progressive
+	mode in the frame buffer, with blanking the composer's registers hold.
+*/
+static bool
+mode_is_valid(const meson_mode& mode)
+{
+	return mode.pixelClock >= kMinPixelClock
+		&& mode.pixelClock < kMaxPixelClock
+		&& mode.hActive >= 320 && mode.hActive <= kMaxWidth
+		&& mode.vActive >= 200 && mode.vActive <= kMaxHeight
+		&& mode.hFront > 0 && mode.hSync > 0 && mode.hBack > 0
+		&& mode.vFront > 0 && mode.vSync > 0 && mode.vBack > 0
+		&& mode.hFront + mode.hSync + mode.hBack < 4096
+		&& mode.vFront + mode.vSync + mode.vBack < 256
+		&& mode.vSync < 64;
+}
+
+
+struct hdmi_pll {
+	uint32	m;
+	uint32	frac;
+	uint32	od1, od2;		// register codes: log2 of the divider
+};
+
+
+/*!	The PLL setting for a pixel clock: the highest VCO the dividers allow,
+	which is U-Boot's 5940 MHz for 74.25 and 148.5 MHz.
+*/
+static bool
+compute_hdmi_pll(uint32 pixelClock, hdmi_pll& pll)
+{
+	for (int32 log2Divider = 6; log2Divider >= 0; log2Divider--) {
+		uint64 vco = (uint64)pixelClock * 10 << log2Divider;		// kHz
+		uint32 m = vco / 48000;
+		uint32 frac = ((vco % 48000) * 4096 + 24000) / 48000;
+		if (frac == 4096) {
+			m++;
+			frac = 0;
+		}
+		if (m < kHdmiPllMinM || m > kHdmiPllMaxM)
+			continue;
+		pll.m = m;
+		pll.frac = frac;
+		// OD1 up to /4 first, as U-Boot has it; OD2 the rest
+		pll.od1 = log2Divider > 5 ? log2Divider - 3 : min_c(log2Divider, 2);
+			// 64 is /8 twice
+		pll.od2 = log2Divider - pll.od1;
+		return true;
+	}
+	return false;
+}
