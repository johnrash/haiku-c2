+/*!	Adds a mode to the list unless the hardware can't make it or the list
+	has its timing already.
+*/
+void
+MesonHdmi::_AddMode(const meson_mode& mode)
+{
+	hdmi_pll pll;
+	if (!mode_is_valid(mode) || !compute_hdmi_pll(mode.pixelClock, pll))
+		return;
+	for (uint32 i = 0; i < fModeCount; i++) {
+		if (same_timing(fModes[i], mode))
+			return;
+	}
+	if (fModeCount == MESON_HDMI_MAX_MODES) {
+		INFO("mode list full, %ux%u left out\n", mode.hActive, mode.vActive);
+		return;
+	}
+	fModes[fModeCount++] = mode;
+}
