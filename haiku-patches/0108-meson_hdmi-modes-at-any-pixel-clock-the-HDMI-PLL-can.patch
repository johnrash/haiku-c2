+static bool
+display_mode_to_mode(const display_mode& displayMode, meson_mode& mode)
+{
+	const display_timing& timing = displayMode.timing;
+	if (timing.h_sync_start <= timing.h_display
+		|| timing.h_sync_end <= timing.h_sync_start
+		|| timing.h_total <= timing.h_sync_end
+		|| timing.v_sync_start <= timing.v_display
+		|| timing.v_sync_end <= timing.v_sync_start
+		|| timing.v_total <= timing.v_sync_end
+		|| (timing.flags & B_TIMING_INTERLACED) != 0) {
+		return false;
+	}
+	mode.pixelClock = timing.pixel_clock;
+	mode.hActive = timing.h_display;
+	mode.hFront = timing.h_sync_start - timing.h_display;
+	mode.hSync = timing.h_sync_end - timing.h_sync_start;
+	mode.hBack = timing.h_total - timing.h_sync_end;
+	mode.vActive = timing.v_display;
+	mode.vFront = timing.v_sync_start - timing.v_display;
+	mode.vSync = timing.v_sync_end - timing.v_sync_start;
+	mode.vBack = timing.v_total - timing.v_sync_end;
+	mode.hSyncPositive = (timing.flags & B_POSITIVE_HSYNC) != 0;
+	mode.vSyncPositive = (timing.flags & B_POSITIVE_VSYNC) != 0;
+	mode.vic = 0;
+	hdmi_pll pll;
+	return mode_is_valid(mode) && compute_hdmi_pll(mode.pixelClock, pll);
+}
