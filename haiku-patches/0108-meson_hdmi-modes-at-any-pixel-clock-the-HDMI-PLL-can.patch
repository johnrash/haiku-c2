+/*!	The DMT or CEA mode a standard timing (two bytes) names, if any. */
+static const meson_mode*
+standard_timing_mode(const uint8* timing, bool squareIsZero)
+{
+	if (timing[0] <= 0x01)
+		return NULL;		// unused (0x01 0x01)
+	uint32 width = (timing[0] + 31) * 8;
+	uint32 height;
+	switch (timing[1] >> 6) {
+		case 0:
+			// 16:10 since EDID 1.3, 1:1 before
+			height = squareIsZero ? width : width * 10 / 16;
+			break;
+		case 1:
+			height = width * 3 / 4;
+			break;
+		case 2:
+			height = width * 4 / 5;
+			break;
+		default:
+			height = width * 9 / 16;
+			break;
+	}
+	uint32 refresh = (timing[1] & 0x3f) + 60;
+	for (size_t i = 0; i < B_COUNT_OF(kDmtModes); i++) {
+		const meson_mode& mode = kDmtModes[i].mode;
+		if (mode.hActive == width && mode.vActive == height
+			&& mode_refresh(mode) == refresh) {
+			return &mode;
+		}
+	}
+	for (size_t i = 0; i < B_COUNT_OF(kModes); i++) {
+		if (kModes[i].hActive == width && kModes[i].vActive == height
+			&& mode_refresh(kModes[i]) == refresh) {
+			return &kModes[i];
+		}
+	}
+	return NULL;
+}
