+/*!	A detailed timing descriptor as a mode; false for an interlaced one. */
+static bool
+dtd_to_mode(const uint8* dtd, meson_mode& mode)
+{
+	if ((dtd[17] & 0x80) != 0)
+		return false;
+	uint32 hBlank = dtd[3] | ((dtd[4] & 0x0f) << 8);
+	uint32 vBlank = dtd[6] | ((dtd[7] & 0x0f) << 8);
+	mode.pixelClock = (dtd[0] | (dtd[1] << 8)) * 10;
+	mode.hActive = dtd[2] | ((dtd[4] & 0xf0) << 4);
+	mode.vActive = dtd[5] | ((dtd[7] & 0xf0) << 4);
+	mode.hFront = dtd[8] | ((dtd[11] & 0xc0) << 2);
+	mode.hSync = dtd[9] | ((dtd[11] & 0x30) << 4);
+	mode.vFront = (dtd[10] >> 4) | ((dtd[11] & 0x0c) << 2);
+	mode.vSync = (dtd[10] & 0x0f) | ((dtd[11] & 0x03) << 4);
+	if (hBlank <= (uint32)mode.hFront + mode.hSync
+		|| vBlank <= (uint32)mode.vFront + mode.vSync) {
+		return false;
+	}
+	mode.hBack = hBlank - mode.hFront - mode.hSync;
+	mode.vBack = vBlank - mode.vFront - mode.vSync;
+	// digital separate syncs: bit 2 is the vertical, bit 1 the horizontal
+	// polarity
+	mode.vSyncPositive = (dtd[17] & 0x1c) == 0x1c;
+	mode.hSyncPositive = (dtd[17] & 0x02) != 0;
+	mode.vic = 0;
+	return true;
+}
