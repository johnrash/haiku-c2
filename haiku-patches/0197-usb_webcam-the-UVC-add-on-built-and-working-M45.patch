+/*!	Frames from UVC payload transfers (one Write() each: a header, then
+	data): a frame ends where the header's frame ID (FID) toggles or at its
+	end-of-frame bit (EOF). Frames with the error bit (ERR) or, for an
+	uncompressed format, the wrong size are dropped, as is the first,
+	partial one. Only the newest frame waits to be taken: a consumer slower
+	than the camera gets the latest picture, not an old one.
+*/
 class UVCDeframer : public CamDeframer {
 public:
 								UVCDeframer(CamDevice *device);
@@ -19,11 +26,23 @@ public:
 					// write from usb transfers
 	virtual ssize_t				Write(const void *buffer, size_t size);
 
+			void				Start(size_t frameSize);
+				// a new stream: frames of \a frameSize bytes, 0 any size
+
+			int32				Frames() const { return fFrameCount; }
+			int32				Dropped() const { return fDropped; }
+
 private:
-	void						_PrintBuffer(const void* buffer, size_t size);
+			void				_EndFrame();
 
 	int32						fFrameCount;
+	int32						fDropped;
 	int32						fID;
+		// the last payload's FID; -1: none yet
+	bool						fSynced;
+		// a frame began after the stream started
+	bool						fBad;
+	size_t						fFrameSize;
 	BMallocIO					fInputBuffer;
 };
 
