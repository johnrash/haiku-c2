+/*!	YUY2 (bytes Y0 U Y1 V, two pixels) into B_RGB32, ITU-R BT.601 with the
+	studio range (Y 16-235), the matrix the C920's color matching descriptor
+	names (SMPTE 170M).
+*/
+void
+UVCCamDevice::_ConvertYUY2(uint32* destination, const uint8* source,
+	int32 width, int32 height)
+{
+	for (int32 i = 0; i < width * height / 2; i++) {
+		int32 u = source[1] - 128;
+		int32 v = source[3] - 128;
+		int32 red = 409 * v + 128;
+		int32 green = -100 * u - 208 * v + 128;
+		int32 blue = 516 * u + 128;
+		for (int32 k = 0; k < 2; k++) {
+			int32 y = 298 * (source[k * 2] - 16);
+			int32 r = (y + red) >> 8;
+			int32 g = (y + green) >> 8;
+			int32 b = (y + blue) >> 8;
+			r = r < 0 ? 0 : r > 255 ? 255 : r;
+			g = g < 0 ? 0 : g > 255 ? 255 : g;
+			b = b < 0 ? 0 : b > 255 ? 255 : b;
+			*destination++ = 0xff000000 | (r << 16) | (g << 8) | b;
+		}
+		source += 4;
+	}
+}
 
 
