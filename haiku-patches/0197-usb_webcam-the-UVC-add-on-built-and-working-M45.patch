+void
+UVCDeframer::Start(size_t frameSize)
+{
+	BAutolock locker(fLocker);
+	fFrameSize = frameSize;
+	fID = -1;
+	fSynced = false;
+	fBad = false;
+	fInputBuffer.SetSize(0);
+	fInputBuffer.Seek(0, SEEK_SET);
+	CamFrame* frame;
+	while ((frame = (CamFrame*)fFrames.RemoveItem((int32)0)) != NULL)
+		delete frame;
+	while (acquire_sem_etc(fFrameSem, 1, B_RELATIVE_TIMEOUT, 0) == B_OK)
+		;
