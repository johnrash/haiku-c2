+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ *
+ * meson_mali's buffers, the GPU's address space, lima's ioctls and the job
+ * thread (PLAN.md M43 stage 3; docs/m43-mali-facts.md §3-5,
+ * docs/m43-mesa-lima-haiku.md §1.8).
+ *
+ * This first version keeps it simple:
+ * - one address space for every open file, the one the MMUs hold;
+ * - one job at a time, in the order they were submitted, GP and PP alike:
+ *   that orders a PP job after the GP job whose output it reads, as lima
+ *   expects, without fences on the buffers;
+ * - buffers are cached for the CPU (userland clones their areas): their
+ *   lines are written back and invalidated before a job, and those of the
+ *   buffers it writes again after it;
+ * - sync objects hold the sequence number of the job they wait for;
+ * - no heap buffers that grow (the driver says version 1.0).
+ */
+
+
+#include <new>
+#include <stdlib.h>
+#include <string.h>
+
+#include <kernel.h>
+#include <util/AutoLock.h>
+#include <vm/vm.h>
+
+#include "meson_mali_private.h"
+
+
+static const uint32 kMaxSubmitBuffers = 1024;
+static const uint32 kMaxWaitHandles = 64;
+
+
+//	#pragma mark - buffers and the address space
+
+
+status_t
+MesonMali::_CreateBuffer(size_t size, mali_buffer** _buffer)
+{
+	size = ROUNDUP(size, B_PAGE_SIZE);
+	mali_buffer* buffer = new(std::nothrow) mali_buffer;
+	if (buffer == NULL)
+		return B_NO_MEMORY;
+	memset(buffer, 0, sizeof(*buffer));
+	buffer->refCount = 1;
+	buffer->size = size;
+	buffer->pageCount = size / B_PAGE_SIZE;
+	buffer->pages = (phys_addr_t*)malloc(buffer->pageCount
+		* sizeof(phys_addr_t));
+	if (buffer->pages == NULL) {
+		delete buffer;
+		return B_NO_MEMORY;
+	}
+
+	// all of the C2's memory is below 4 GB, as the GPU's MMU needs
+	void* address;
+	buffer->area = create_area("meson_mali buffer", &address,
+		B_ANY_KERNEL_ADDRESS, size, B_FULL_LOCK,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA | B_READ_AREA | B_WRITE_AREA
+			| B_CLONEABLE_AREA);
+	if (buffer->area < 0) {
+		status_t status = buffer->area;
+		free(buffer->pages);
+		delete buffer;
+		return status;
+	}
+	for (uint32 i = 0; i < buffer->pageCount; i++) {
+		physical_entry entry;
+		get_memory_map((uint8*)address + i * B_PAGE_SIZE, B_PAGE_SIZE,
+			&entry, 1);
+		buffer->pages[i] = entry.address;
+	}
+	memset(address, 0, size);
+	_CleanBuffer(buffer);
+
+	MutexLocker locker(fLock);
+	status_t status = _AllocateAddress(size, &buffer->va);
+	if (status == B_OK)
+		status = _MapPages(buffer);
+	if (status != B_OK) {
+		delete_area(buffer->area);
+		free(buffer->pages);
+		delete buffer;
+		return status;
+	}
+	*_buffer = buffer;
+	return B_OK;
+}
+
+
+void
+MesonMali::_AcquireBuffer(mali_buffer* buffer)
+{
+	atomic_add(&buffer->refCount, 1);
+}
+
+
+void
+MesonMali::_ReleaseBuffer(mali_buffer* buffer)
+{
+	if (atomic_add(&buffer->refCount, -1) != 1)
+		return;
+	MutexLocker locker(fLock);
+	_UnmapPages(buffer);
+	_FreeAddress(buffer->va, buffer->size);
+	locker.Unlock();
+	delete_area(buffer->area);
+		// clones in userland keep the pages until they go
+	free(buffer->pages);
+	delete buffer;
+}
+
+
+/*!	Writes back and invalidates the CPU's lines of the buffer: before a job
+	(what the CPU wrote reaches memory) and after one that wrote it (what
+	the CPU reads next comes from memory). By physical runs.
+*/
+void
+MesonMali::_CleanBuffer(mali_buffer* buffer)
+{
+	uint32 first = 0;
+	for (uint32 i = 1; i <= buffer->pageCount; i++) {
+		if (i < buffer->pageCount
+			&& buffer->pages[i] == buffer->pages[i - 1] + B_PAGE_SIZE) {
+			continue;
+		}
+		flush_cache_range(buffer->pages[first],
+			(size_t)(i - first) * B_PAGE_SIZE);
+		first = i;
+	}
+}
+
+
+/*!	The lowest free range of GPU addresses for \a size bytes, between
+	kFirstBufferAddress and the DLBU page. With fLock held.
+*/
+status_t
+MesonMali::_AllocateAddress(size_t size, uint32* _address)
+{
+	uint64 start = kFirstBufferAddress;
+	uint32 index = 0;
+	for (; index < fRangeCount; index++) {
+		if (fRanges[index].start >= start + size)
+			break;
+		start = (uint64)fRanges[index].start + fRanges[index].size;
+	}
+	if (start + size > kDlbuAddress)
+		return B_NO_MEMORY;
+
+	if (fRangeCount == fRangeSlots) {
+		uint32 slots = fRangeSlots > 0 ? fRangeSlots * 2 : 64;
+		address_range* ranges = (address_range*)realloc(fRanges,
+			slots * sizeof(address_range));
+		if (ranges == NULL)
+			return B_NO_MEMORY;
+		fRanges = ranges;
+		fRangeSlots = slots;
+	}
+	memmove(fRanges + index + 1, fRanges + index,
+		(fRangeCount - index) * sizeof(address_range));
+	fRanges[index].start = (uint32)start;
+	fRanges[index].size = (uint32)size;
+	fRangeCount++;
+	*_address = (uint32)start;
+	return B_OK;
+}
+
+
+void
+MesonMali::_FreeAddress(uint32 address, size_t size)
+{
+	for (uint32 i = 0; i < fRangeCount; i++) {
+		if (fRanges[i].start != address)
+			continue;
+		memmove(fRanges + i, fRanges + i + 1,
+			(fRangeCount - i - 1) * sizeof(address_range));
+		fRangeCount--;
+		return;
+	}
+}
+
+
+/*!	The buffer's pages into the page tables at its address (page tables
+	made as needed). The MMUs forget old translations when the next job
+	starts. With fLock held.
+*/
+status_t
+MesonMali::_MapPages(mali_buffer* buffer)
+{
+	uint32 i = 0;
+	while (i < buffer->pageCount) {
+		uint32 address = buffer->va + i * B_PAGE_SIZE;
+		uint32 directoryIndex = address >> 22;
+		dma_buffer& table = fPageTables[directoryIndex];
+		if (table.area < 0) {
+			status_t status = _AllocatePage("meson_mali page table", table);
+			if (status != B_OK)
+				return status;
+			fPageDirectory.address[directoryIndex]
+				= (uint32)table.physical | kPageDirectoryPresent;
+			flush_cache_range(fPageDirectory.physical + directoryIndex * 4,
+				4);
+		}
+		uint32 first = (address >> 12) & 0x3ff;
+		uint32 entry = first;
+		for (; entry < 1024 && i < buffer->pageCount; entry++, i++)
+			table.address[entry] = (uint32)buffer->pages[i] | kPageFlags;
+		flush_cache_range(table.physical + first * 4, (entry - first) * 4);
+	}
+	return B_OK;
+}
+
+
+void
+MesonMali::_UnmapPages(mali_buffer* buffer)
+{
+	uint32 i = 0;
+	while (i < buffer->pageCount) {
+		uint32 address = buffer->va + i * B_PAGE_SIZE;
+		dma_buffer& table = fPageTables[address >> 22];
+		uint32 first = (address >> 12) & 0x3ff;
+		uint32 entry = first;
+		for (; entry < 1024 && i < buffer->pageCount; entry++, i++) {
+			if (table.area >= 0)
+				table.address[entry] = 0;
+		}
+		if (table.area >= 0) {
+			flush_cache_range(table.physical + first * 4,
+				(entry - first) * 4);
+		}
+	}
+}
+
+
+//	#pragma mark - files
+
+
+status_t
+MesonMali::OpenFile(mali_file** _file)
+{
+	mali_file* file = new(std::nothrow) mali_file;
+	if (file == NULL)
+		return B_NO_MEMORY;
+	memset(file, 0, sizeof(*file));
+	mutex_init(&file->lock, "meson_mali file");
+	*_file = file;
+	return B_OK;
+}
+
+
+void
+MesonMali::FreeFile(mali_file* file)
+{
+	for (uint32 i = 0; i < file->bufferSlots; i++) {
+		if (file->buffers[i] != NULL)
+			_ReleaseBuffer(file->buffers[i]);
+	}
+	free(file->buffers);
+	free(file->syncobjs);
+	free(file->syncobjsUsed);
+	mutex_destroy(&file->lock);
+	delete file;
+}
+
+
+/*!	The buffer of \a handle with a reference, or NULL. */
+mali_buffer*
+MesonMali::_LookUp(mali_file* file, uint32 handle)
+{
+	MutexLocker locker(file->lock);
+	if (handle == 0 || handle > file->bufferSlots
+		|| file->buffers[handle - 1] == NULL) {
+		return NULL;
+	}
+	mali_buffer* buffer = file->buffers[handle - 1];
+	_AcquireBuffer(buffer);
+	return buffer;
+}
+
+
+status_t
+MesonMali::Control(mali_file* file, uint32 op, void* buffer, size_t length)
+{
+	switch (op) {
+		case MALI_IOCTL_GET_PARAM:
+			return _GetParam(buffer);
+		case MALI_IOCTL_GEM_CREATE:
+			return _GemCreate(file, buffer);
+		case MALI_IOCTL_GEM_INFO:
+			return _GemInfo(file, buffer);
+		case MALI_IOCTL_GEM_CLOSE:
+			return _GemClose(file, buffer);
+		case MALI_IOCTL_GEM_SUBMIT:
+			return _GemSubmit(file, buffer);
+		case MALI_IOCTL_GEM_WAIT:
+			return _GemWait(file, buffer);
+		case MALI_IOCTL_SYNCOBJ_CREATE:
+			return _SyncobjCreate(file, buffer);
+		case MALI_IOCTL_SYNCOBJ_DESTROY:
+			return _SyncobjDestroy(file, buffer);
+		case MALI_IOCTL_SYNCOBJ_WAIT:
+			return _SyncobjWait(file, buffer);
+
+		case MALI_IOCTL_CTX_CREATE:
+		{
+			mali_ctx_create context;
+			MutexLocker locker(file->lock);
+			context.id = file->nextContext++;
+			context._pad = 0;
+			locker.Unlock();
+			return user_memcpy(buffer, &context, sizeof(context));
+		}
+		case MALI_IOCTL_CTX_FREE:
+		{
+			mali_ctx_free context;
+			if (user_memcpy(&context, buffer, sizeof(context)) != B_OK)
+				return B_BAD_ADDRESS;
+			MutexLocker locker(file->lock);
+			return context._pad == 0 && context.id < file->nextContext
+				? B_OK : B_BAD_VALUE;
+		}
+	}
+	return B_DEV_INVALID_IOCTL;
+}
+
+
+status_t
+MesonMali::_GetParam(void* buffer)
+{
+	mali_get_param param;
+	if (user_memcpy(&param, buffer, sizeof(param)) != B_OK)
+		return B_BAD_ADDRESS;
+	if (param.pad != 0)
+		return B_BAD_VALUE;
+	switch (param.param) {
+		case MALI_PARAM_GPU_ID:
+			param.value = MALI_GPU_ID_MALI450;
+			break;
+		case MALI_PARAM_NUM_PP:
+			param.value = kPpCount;
+			break;
+		case MALI_PARAM_GP_VERSION:
+			param.value = fGpVersion;
+			break;
+		case MALI_PARAM_PP_VERSION:
+			param.value = fPpVersion[0];
+			break;
+		default:
+			return B_BAD_VALUE;
+	}
+	return user_memcpy(buffer, &param, sizeof(param));
+}
+
+
+status_t
+MesonMali::_GemCreate(mali_file* file, void* buffer)
+{
+	mali_gem_create create;
+	if (user_memcpy(&create, buffer, sizeof(create)) != B_OK)
+		return B_BAD_ADDRESS;
+	// a heap buffer is backed in full: they don't grow here
+	if (create.pad != 0 || (create.flags & ~MALI_BO_FLAG_HEAP) != 0
+		|| create.size == 0) {
+		return B_BAD_VALUE;
+	}
+
+	mali_buffer* object;
+	status_t status = _CreateBuffer(create.size, &object);
+	if (status != B_OK)
+		return status;
+
+	MutexLocker locker(file->lock);
+	uint32 slot = 0;
+	while (slot < file->bufferSlots && file->buffers[slot] != NULL)
+		slot++;
+	if (slot == file->bufferSlots) {
+		uint32 slots = file->bufferSlots > 0 ? file->bufferSlots * 2 : 64;
+		mali_buffer** buffers = (mali_buffer**)realloc(file->buffers,
+			slots * sizeof(mali_buffer*));
+		if (buffers == NULL) {
+			locker.Unlock();
+			_ReleaseBuffer(object);
+			return B_NO_MEMORY;
+		}
+		memset(buffers + file->bufferSlots, 0,
+			(slots - file->bufferSlots) * sizeof(mali_buffer*));
+		file->buffers = buffers;
+		file->bufferSlots = slots;
+	}
+	file->buffers[slot] = object;
+	locker.Unlock();
+
+	create.handle = slot + 1;
+	create.size = object->size;
+	return user_memcpy(buffer, &create, sizeof(create));
+}
+
+
+status_t
+MesonMali::_GemInfo(mali_file* file, void* buffer)
+{
+	mali_gem_info info;
+	if (user_memcpy(&info, buffer, sizeof(info)) != B_OK)
+		return B_BAD_ADDRESS;
+	mali_buffer* object = _LookUp(file, info.handle);
+	if (object == NULL)
+		return B_ENTRY_NOT_FOUND;
+	info.va = object->va;
+	info.offset = (uint64)object->area;
+	_ReleaseBuffer(object);
+	return user_memcpy(buffer, &info, sizeof(info));
+}
+
+
+status_t
+MesonMali::_GemClose(mali_file* file, void* buffer)
+{
+	mali_gem_close close;
+	if (user_memcpy(&close, buffer, sizeof(close)) != B_OK)
+		return B_BAD_ADDRESS;
+	MutexLocker locker(file->lock);
+	if (close.handle == 0 || close.handle > file->bufferSlots
+		|| file->buffers[close.handle - 1] == NULL) {
+		return B_BAD_VALUE;
+	}
+	mali_buffer* object = file->buffers[close.handle - 1];
+	file->buffers[close.handle - 1] = NULL;
+	locker.Unlock();
+	// a job that still uses it holds a reference of its own
+	_ReleaseBuffer(object);
+	return B_OK;
+}
+
+
+status_t
+MesonMali::_SyncobjCreate(mali_file* file, void* buffer)
+{
+	mali_syncobj_create create;
+	if (user_memcpy(&create, buffer, sizeof(create)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	MutexLocker locker(file->lock);
+	uint32 slot = 0;
+	while (slot < file->syncobjSlots && file->syncobjsUsed[slot])
+		slot++;
+	if (slot == file->syncobjSlots) {
+		uint32 slots = file->syncobjSlots > 0 ? file->syncobjSlots * 2 : 16;
+		uint64* syncobjs = (uint64*)realloc(file->syncobjs,
+			slots * sizeof(uint64));
+		if (syncobjs == NULL)
+			return B_NO_MEMORY;
+		file->syncobjs = syncobjs;
+		bool* used = (bool*)realloc(file->syncobjsUsed, slots * sizeof(bool));
+		if (used == NULL)
+			return B_NO_MEMORY;
+		memset(used + file->syncobjSlots, 0, slots - file->syncobjSlots);
+		file->syncobjsUsed = used;
+		file->syncobjSlots = slots;
+	}
+	// without a job yet, it counts as signalled
+	file->syncobjs[slot] = 0;
+	file->syncobjsUsed[slot] = true;
+	locker.Unlock();
+
+	create.handle = slot + 1;
+	return user_memcpy(buffer, &create, sizeof(create));
+}
+
+
+status_t
+MesonMali::_SyncobjDestroy(mali_file* file, void* buffer)
+{
+	mali_syncobj_destroy destroy;
+	if (user_memcpy(&destroy, buffer, sizeof(destroy)) != B_OK)
+		return B_BAD_ADDRESS;
+	MutexLocker locker(file->lock);
+	if (destroy.handle == 0 || destroy.handle > file->syncobjSlots
+		|| !file->syncobjsUsed[destroy.handle - 1]) {
+		return B_BAD_VALUE;
+	}
+	file->syncobjsUsed[destroy.handle - 1] = false;
+	return B_OK;
+}
+
+
+status_t
+MesonMali::_SyncobjWait(mali_file* file, void* buffer)
+{
+	mali_syncobj_wait wait;
+	if (user_memcpy(&wait, buffer, sizeof(wait)) != B_OK)
+		return B_BAD_ADDRESS;
+	if (wait.count_handles == 0 || wait.count_handles > kMaxWaitHandles)
+		return B_BAD_VALUE;
+	uint32 handles[kMaxWaitHandles];
+	if (user_memcpy(handles, (void*)(addr_t)wait.handles,
+			wait.count_handles * sizeof(uint32)) != B_OK) {
+		return B_BAD_ADDRESS;
+	}
+
+	// The jobs finish in order: waiting for all is waiting for the last;
+	// for one, for the first.
+	bool all = (wait.flags & MALI_SYNCOBJ_WAIT_ALL) != 0;
+	uint64 target = all ? 0 : UINT64_MAX;
+	uint32 first = 0;
+	MutexLocker locker(file->lock);
+	for (uint32 i = 0; i < wait.count_handles; i++) {
+		uint32 handle = handles[i];
+		if (handle == 0 || handle > file->syncobjSlots
+			|| !file->syncobjsUsed[handle - 1]) {
+			return B_ENTRY_NOT_FOUND;
+		}
+		uint64 sequence = file->syncobjs[handle - 1];
+		if (all ? sequence > target : sequence < target) {
+			target = sequence;
+			first = i;
+		}
+	}
+	locker.Unlock();
+
+	status_t status = _WaitFor(target, wait.timeout_nsec,
+		wait.timeout_nsec <= 0);
+	if (status == B_BUSY)
+		status = B_TIMED_OUT;
+	if (status != B_OK)
+		return status;
+	if (!all) {
+		wait.first_signaled = first;
+		return user_memcpy(buffer, &wait, sizeof(wait));
+	}
+	return B_OK;
+}
+
+
+status_t
+MesonMali::_GemWait(mali_file* file, void* buffer)
+{
+	mali_gem_wait wait;
+	if (user_memcpy(&wait, buffer, sizeof(wait)) != B_OK)
+		return B_BAD_ADDRESS;
+	if ((wait.op & ~(MALI_GEM_WAIT_READ | MALI_GEM_WAIT_WRITE)) != 0)
+		return B_BAD_VALUE;
+	if (wait.op == 0)
+		return B_OK;
+	mali_buffer* object = _LookUp(file, wait.handle);
+	if (object == NULL)
+		return B_BAD_VALUE;
+
+	MutexLocker locker(fQueueLock);
+	// to read: the jobs that write it; to write: all that use it
+	uint64 target = object->lastWrite;
+	if ((wait.op & MALI_GEM_WAIT_WRITE) != 0)
+		target = max_c(target, object->lastRead);
+	locker.Unlock();
+	_ReleaseBuffer(object);
+
+	return _WaitFor(target, wait.timeout_ns,
+		wait.timeout_ns <= (int64)system_time() * 1000);
+}
+
+
+/*!	Waits until the job with \a sequence (and all before) finished, until
+	\a timeoutNs (absolute, monotonic: system_time() in nanoseconds;
+	INT64_MAX: forever). A poll returns B_BUSY instead of B_TIMED_OUT.
+*/
+status_t
+MesonMali::_WaitFor(uint64 sequence, int64 timeoutNs, bool poll)
+{
+	bigtime_t deadline = timeoutNs == INT64_MAX
+		? B_INFINITE_TIMEOUT : timeoutNs / 1000;
+	MutexLocker locker(fQueueLock);
+	while (fCompleted < sequence) {
+		if (poll || (deadline != B_INFINITE_TIMEOUT
+				&& deadline <= system_time())) {
+			return poll ? B_BUSY : B_TIMED_OUT;
+		}
+		ConditionVariableEntry entry;
+		fCompletion.Add(&entry);
+		locker.Unlock();
+		status_t status = entry.Wait(B_CAN_INTERRUPT
+			| (deadline != B_INFINITE_TIMEOUT ? B_ABSOLUTE_TIMEOUT : 0),
+			deadline);
+		locker.Lock();
+		if (status == B_INTERRUPTED)
+			return B_INTERRUPTED;
+	}
+	return B_OK;
+}
+
+
+//	#pragma mark - jobs
+
+
+status_t
+MesonMali::_GemSubmit(mali_file* file, void* buffer)
+{
+	mali_gem_submit submit;
+	if (user_memcpy(&submit, buffer, sizeof(submit)) != B_OK)
+		return B_BAD_ADDRESS;
+	if (submit.pipe > MALI_PIPE_PP || submit.nr_bos == 0
+		|| submit.nr_bos > kMaxSubmitBuffers
+		|| (submit.flags & ~MALI_SUBMIT_FLAG_EXPLICIT_FENCE) != 0
+		|| submit.frame_size != (submit.pipe == MALI_PIPE_GP
+			? sizeof(mali_gp_frame) : sizeof(mali_m450_pp_frame))) {
+		return B_BAD_VALUE;
+	}
+
+	mali_task* task = new(std::nothrow) mali_task;
+	if (task == NULL)
+		return B_NO_MEMORY;
+	memset(task, 0, sizeof(*task));
+	task->pipe = submit.pipe;
+	mali_gem_submit_bo* objects = (mali_gem_submit_bo*)malloc(submit.nr_bos
+		* sizeof(mali_gem_submit_bo));
+	task->buffers = (mali_buffer**)calloc(submit.nr_bos,
+		sizeof(mali_buffer*));
+	task->bufferFlags = (uint32*)malloc(submit.nr_bos * sizeof(uint32));
+	status_t status = B_OK;
+	if (objects == NULL || task->buffers == NULL || task->bufferFlags == NULL)
+		status = B_NO_MEMORY;
+	else if (user_memcpy(&task->frame, (void*)(addr_t)submit.frame,
+			submit.frame_size) != B_OK
+		|| user_memcpy(objects, (void*)(addr_t)submit.bos,
+			submit.nr_bos * sizeof(mali_gem_submit_bo)) != B_OK) {
+		status = B_BAD_ADDRESS;
+	}
+
+	// the frame
+	if (status == B_OK && submit.pipe == MALI_PIPE_GP) {
+		const uint32* frame = task->frame.gp.frame;
+		if (frame[0] > frame[1] || frame[2] > frame[3] || frame[4] > frame[5]
+			|| (frame[0] == frame[1] && frame[2] == frame[3])) {
+			status = B_BAD_VALUE;
+		}
+	} else if (status == B_OK) {
+		if (task->frame.pp.num_pp == 0 || task->frame.pp.num_pp > kPpCount
+			|| task->frame.pp._pad != 0) {
+			status = B_BAD_VALUE;
+		}
+	}
+
+	// the sync object, and the buffers with a reference each
+	if (status == B_OK) {
+		MutexLocker locker(file->lock);
+		if (submit.out_sync != 0 && (submit.out_sync > file->syncobjSlots
+				|| !file->syncobjsUsed[submit.out_sync - 1])) {
+			status = B_ENTRY_NOT_FOUND;
+		}
+	}
+	for (uint32 i = 0; status == B_OK && i < submit.nr_bos; i++) {
+		task->buffers[i] = _LookUp(file, objects[i].handle);
+		if (task->buffers[i] == NULL)
+			status = B_ENTRY_NOT_FOUND;
+		task->bufferFlags[i] = objects[i].flags;
+		task->bufferCount = i + 1;
+	}
+	free(objects);
+	if (status != B_OK) {
+		_FreeTask(task);
+		return status;
+	}
+
+	// queued in order; the in_sync objects are signalled by then
+	MutexLocker queueLocker(fQueueLock);
+	task->sequence = fNextSequence++;
+	for (uint32 i = 0; i < task->bufferCount; i++) {
+		if ((task->bufferFlags[i] & MALI_SUBMIT_BO_WRITE) != 0)
+			task->buffers[i]->lastWrite = task->sequence;
+		else
+			task->buffers[i]->lastRead = task->sequence;
+	}
+	if (fQueueTail != NULL)
+		fQueueTail->next = task;
+	else
+		fQueueHead = task;
+	fQueueTail = task;
+	uint64 sequence = task->sequence;
+	fQueueCondition.NotifyOne();
+	queueLocker.Unlock();
+
+	if (submit.out_sync != 0) {
+		MutexLocker locker(file->lock);
+		if (submit.out_sync <= file->syncobjSlots
+			&& file->syncobjsUsed[submit.out_sync - 1]) {
+			file->syncobjs[submit.out_sync - 1] = sequence;
+		}
+	}
+	return B_OK;
+}
+
+
+void
+MesonMali::_FreeTask(mali_task* task)
+{
+	for (uint32 i = 0; i < task->bufferCount; i++) {
+		if (task->buffers[i] != NULL)
+			_ReleaseBuffer(task->buffers[i]);
+	}
+	free(task->buffers);
+	free(task->bufferFlags);
+	delete task;
+}
+
+
+/*static*/ status_t
+MesonMali::_JobThread(void* data)
+{
+	MesonMali* device = (MesonMali*)data;
+	MutexLocker locker(device->fQueueLock);
+	while (true) {
+		while (device->fQueueHead == NULL && !device->fQuit) {
+			ConditionVariableEntry entry;
+			device->fQueueCondition.Add(&entry);
+			locker.Unlock();
+			entry.Wait();
+			locker.Lock();
+		}
+		mali_task* task = device->fQueueHead;
+		if (task == NULL)
+			break;
+		device->fQueueHead = task->next;
+		if (device->fQueueHead == NULL)
+			device->fQueueTail = NULL;
+		locker.Unlock();
+
+		if (!device->fQuit)
+			device->_RunTask(task);
+
+		locker.Lock();
+		device->fCompleted = task->sequence;
+		device->fCompletion.NotifyAll();
+		locker.Unlock();
+		device->_FreeTask(task);
+		locker.Lock();
+	}
+	return B_OK;
+}
+
+
+void
+MesonMali::_RunTask(mali_task* task)
+{
+	for (uint32 i = 0; i < task->bufferCount; i++)
+		_CleanBuffer(task->buffers[i]);
+
+	bool done = task->pipe == MALI_PIPE_GP ? _RunGp(task) : _RunPp(task);
+	fJobs++;
+	if (!done)
+		fFailedJobs++;
+
+	for (uint32 i = 0; i < task->bufferCount; i++) {
+		if ((task->bufferFlags[i] & MALI_SUBMIT_BO_WRITE) != 0)
+			_CleanBuffer(task->buffers[i]);
+	}
+}
+
+
+bool
+MesonMali::_RunGp(mali_task* task)
+{
+	const uint32* frame = task->frame.gp.frame;
+	uint32 command = 0;
+	if (frame[0] != frame[1])
+		command |= kGpStartVs;
+	if (frame[2] != frame[3])
+		command |= kGpStartPlbu;
+
+	_FlushL2(kGpL2);
+	_ZapMmu(kGpMmu);
+	_ResetGp();
+	while (acquire_sem_etc(fJobDone, 1, B_RELATIVE_TIMEOUT, 0) == B_OK)
+		;
+
+	InterruptsSpinLocker locker(fJobLock);
+	fJobError = 0;
+	fRunningPipe = MALI_PIPE_GP;
+	for (uint32 i = 0; i < 6; i++)
+		_Write(kGp + i * 4, frame[i]);
+	_Write(kGp + GP_CMD, kGpUpdatePlbuAlloc);
+	_Write(kGp + GP_CMD, command);
+	locker.Unlock();
+
+	status_t status = acquire_sem_etc(fJobDone, 1, B_RELATIVE_TIMEOUT,
+		kJobTimeout);
+	locker.Lock();
+	uint32 error = fJobError;
+	fRunningPipe = -1;
+	locker.Unlock();
+	if (status == B_OK && error == 0)
+		return true;
+
+	INFO("GP job %" B_PRIu64 ": %s, error %#" B_PRIx32 ", status %#" B_PRIx32
+		", raw %#" B_PRIx32 ", MMU status %#" B_PRIx32 " fault at %#" B_PRIx32
+		"\n", task->sequence, status == B_OK ? "failed" : "timed out", error,
+		_Read(kGp + GP_STATUS), _Read(kGp + GP_INT_RAWSTAT),
+		_Read(kGpMmu + MMU_STATUS), _Read(kGpMmu + MMU_PAGE_FAULT_ADDR));
+	_HardResetGp();
+	_RecoverMmu(kGpMmu);
+	return false;
+}
+
+
+bool
+MesonMali::_RunPp(mali_task* task)
+{
+	mali_m450_pp_frame& frame = task->frame.pp;
+	uint32 count = frame.num_pp;
+	uint32 mask = (1u << count) - 1;
+
+	_FlushL2(kPpL2);
+	for (uint32 i = 0; i < kPpCount; i++)
+		_ZapMmu(kPpMmu[i]);
+	for (uint32 i = 0; i < count; i++) {
+		if (_ResetPp(i) != B_OK)
+			INFO("PP%" B_PRIu32 ": no soft reset\n", i);
+	}
+	while (acquire_sem_etc(fJobDone, 1, B_RELATIVE_TIMEOUT, 0) == B_OK)
+		;
+
+	// the load balancer hands out the tile lists, or each PP has its own
+	if (frame.use_dlbu != 0) {
+		_Write(kDlbu + DLBU_PP_ENABLE_MASK, mask);
+		frame.frame[0] = kDlbuAddress;
+		for (uint32 i = 0; i < 4; i++)
+			_Write(kDlbu + DLBU_TLLIST_VBASEADDR + i * 4, frame.dlbu_regs[i]);
+	} else
+		_Write(kDlbu + DLBU_PP_ENABLE_MASK, 0);
+	_Write(kBcast + BCAST_BROADCAST_MASK,
+		(_Read(kBcast + BCAST_BROADCAST_MASK) & 0xffff0000) | mask);
+
+	for (uint32 i = 0; i < 23; i++)
+		_Write(kPpBroadcast + PP_FRAME + i * 4, frame.frame[i]);
+	for (uint32 unit = 0; unit < 3; unit++) {
+		for (uint32 i = 0; i < 12; i++) {
+			_Write(kPpBroadcast + PP_WB0 + unit * 0x100 + i * 4,
+				frame.wb[unit * 12 + i]);
+		}
+	}
+	for (uint32 i = 0; i < count; i++) {
+		_Write(kPp[i] + PP_STACK, frame.fragment_stack_address[i]);
+		if (frame.use_dlbu == 0)
+			_Write(kPp[i] + PP_FRAME, frame.plbu_array_address[i]);
+	}
+
+	InterruptsSpinLocker locker(fJobLock);
+	fJobError = 0;
+	fPpCount = count;
+	fPpPending = count;
+	fPpDone = 0;
+	fRunningPipe = MALI_PIPE_PP;
+	_Write(kPpBroadcast + PP_CTRL, kPpStartRendering);
+	locker.Unlock();
+
+	status_t status = acquire_sem_etc(fJobDone, 1, B_RELATIVE_TIMEOUT,
+		kJobTimeout);
+	locker.Lock();
+	uint32 error = fJobError;
+	fRunningPipe = -1;
+	locker.Unlock();
+	if (status == B_OK && error == 0)
+		return true;
+
+	INFO("PP job %" B_PRIu64 ": %s, error %#" B_PRIx32 ", %" B_PRIu32
+		" of %" B_PRIu32 " PPs done; PP0 status %#" B_PRIx32 " raw %#"
+		B_PRIx32 ", MMU0 status %#" B_PRIx32 " fault at %#" B_PRIx32 "\n",
+		task->sequence, status == B_OK ? "failed" : "timed out", error,
+		count - fPpPending, count, _Read(kPp[0] + PP_STATUS),
+		_Read(kPp[0] + PP_INT_RAWSTAT), _Read(kPpMmu[0] + MMU_STATUS),
+		_Read(kPpMmu[0] + MMU_PAGE_FAULT_ADDR));
+	for (uint32 i = 0; i < kPpCount; i++)
+		_HardResetPp(i);
+	_Write(kBcast + BCAST_BROADCAST_MASK, ((1 << kPpCount) - 1) << 16);
+	_Write(kBcast + BCAST_INTERRUPT_MASK, (1 << kPpCount) - 1);
+	for (uint32 i = 0; i < kPpCount; i++)
+		_RecoverMmu(kPpMmu[i]);
+	return false;
+}
