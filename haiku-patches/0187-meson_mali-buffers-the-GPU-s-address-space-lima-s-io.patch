+#ifndef MESON_MALI_PRIVATE_H
+#define MESON_MALI_PRIVATE_H
+
+
+#include <KernelExport.h>
+#include <condition_variable.h>
+#include <device_manager.h>
+#include <lock.h>
+
+#include <meson_mali.h>
+
+
+#define INFO(x...)	dprintf("meson_mali: " x)
+
+
+// the blocks, from the GPU's base (Mali-450)
+static const uint32 kGp = 0x00000;
+static const uint32 kPpL2 = 0x01000;
+static const uint32 kPmu = 0x02000;
+static const uint32 kGpMmu = 0x03000;
+static const uint32 kPpMmu[] = { 0x04000, 0x05000, 0x06000 };
+static const uint32 kPp[] = { 0x08000, 0x0a000, 0x0c000 };
+static const uint32 kGpL2 = 0x10000;
+static const uint32 kBcast = 0x13000;
+static const uint32 kDlbu = 0x14000;
+static const uint32 kPpBroadcast = 0x16000;
+static const size_t kWindowSize = 0x40000;
+static const uint32 kPpCount = 3;
+
+// GP
+enum {
+	GP_CMD				= 0x20,
+	GP_INT_RAWSTAT		= 0x24,
+	GP_INT_CLEAR		= 0x28,
+	GP_INT_MASK			= 0x2c,
+	GP_INT_STAT			= 0x30,
+	GP_PERF_CNT_0_LIMIT	= 0x54,
+	GP_STATUS			= 0x68,
+	GP_VERSION			= 0x6c,
+};
+static const uint32 kGpStartVs = 1 << 0;
+static const uint32 kGpStartPlbu = 1 << 1;
+static const uint32 kGpUpdatePlbuAlloc = 1 << 4;
+static const uint32 kGpHardReset = 1 << 5;
+static const uint32 kGpStopBus = 1 << 9;
+static const uint32 kGpSoftReset = 1 << 10;
+static const uint32 kGpVsEnd = 1 << 0;
+static const uint32 kGpPlbuEnd = 1 << 1;
+static const uint32 kGpPlbuOutOfMemory = 1 << 2;
+static const uint32 kGpResetCompleted = 1 << 19;
+static const uint32 kGpInterruptsAll = 0x00787fff;
+static const uint32 kGpInterruptsError = 0x00706e44;
+static const uint32 kGpInterruptsUsed = 0x00706e47;
+static const uint32 kGpStatusVsActive = 1 << 1;
+static const uint32 kGpStatusBusStopped = 1 << 2;
+static const uint32 kGpStatusPlbuActive = 1 << 3;
+
+// PP
+enum {
+	PP_FRAME			= 0x0000,
+	PP_STACK			= 0x0030,
+	PP_WB0				= 0x0100,
+	PP_VERSION			= 0x1000,
+	PP_STATUS			= 0x1008,
+	PP_CTRL				= 0x100c,
+	PP_INT_RAWSTAT		= 0x1020,
+	PP_INT_CLEAR		= 0x1024,
+	PP_INT_MASK			= 0x1028,
+	PP_INT_STATUS		= 0x102c,
+	PP_PERF_CNT_0_LIMIT	= 0x1088,
+};
+static const uint32 kPpStopBus = 1 << 0;
+static const uint32 kPpForceReset = 1 << 5;
+static const uint32 kPpStartRendering = 1 << 6;
+static const uint32 kPpSoftReset = 1 << 7;
+static const uint32 kPpResetCompleted = 1 << 12;
+static const uint32 kPpInterruptsAll = 0x1fff;
+static const uint32 kPpInterruptsError = 0x0f18;
+static const uint32 kPpInterruptsUsed = 0x0f19;
+static const uint32 kPpStatusRendering = 1 << 0;
+static const uint32 kPpStatusBusStopped = 1 << 4;
+
+// MMU
+enum {
+	MMU_DTE_ADDR		= 0x00,
+	MMU_STATUS			= 0x04,
+	MMU_COMMAND			= 0x08,
+	MMU_PAGE_FAULT_ADDR	= 0x0c,
+	MMU_INT_RAWSTAT		= 0x14,
+	MMU_INT_CLEAR		= 0x18,
+	MMU_INT_MASK		= 0x1c,
+	MMU_INT_STATUS		= 0x20,
+};
+enum {
+	MMU_ENABLE_PAGING	= 0,
+	MMU_ENABLE_STALL	= 2,
+	MMU_DISABLE_STALL	= 3,
+	MMU_ZAP_CACHE		= 4,
+	MMU_HARD_RESET		= 6,
+};
+static const uint32 kMmuPagingEnabled = 1 << 0;
+static const uint32 kMmuPageFaultActive = 1 << 1;
+static const uint32 kMmuStallActive = 1 << 2;
+static const uint32 kMmuInterrupts = 0x3;
+	// page fault, read bus error
+
+// L2 cache
+enum {
+	L2_SIZE				= 0x04,
+	L2_STATUS			= 0x08,
+	L2_COMMAND			= 0x10,
+	L2_MAX_READS		= 0x18,
+	L2_ENABLE			= 0x1c,
+};
+
+// PMU: STATUS has a bit per domain, 1 = off
+enum {
+	PMU_POWER_UP		= 0x00,
+	PMU_STATUS			= 0x08,
+	PMU_INT_MASK		= 0x0c,
+	PMU_INT_RAWSTAT		= 0x10,
+	PMU_INT_CLEAR		= 0x18,
+	PMU_SW_DELAY		= 0x1c,
+};
+static const uint32 kPmuDomains = 0x7;
+	// GP, PP0, PP1-PP3
+
+// DLBU, BCAST
+enum {
+	DLBU_MASTER_TLLIST_PHYS_ADDR	= 0x00,
+	DLBU_MASTER_TLLIST_VADDR		= 0x04,
+	DLBU_TLLIST_VBASEADDR			= 0x08,
+	DLBU_PP_ENABLE_MASK				= 0x18,
+	BCAST_BROADCAST_MASK			= 0x00,
+	BCAST_INTERRUPT_MASK			= 0x04,
+};
+
+// page tables: two levels of 4 KiB; the DLBU page at a fixed address
+static const uint32 kPageDirectoryPresent = 0x1;
+static const uint32 kPageFlags = 0x1df;
+static const uint32 kDlbuAddress = 0xfff00000;
+static const uint32 kFirstBufferAddress = 0x00100000;
+	// buffers between it and the DLBU page (VA 0 stays unused)
+
+static const bigtime_t kJobTimeout = 10000000;
+
+
+enum {
+	kIrqGp, kIrqGpMmu, kIrqPp, kIrqPmu, kIrqPp0, kIrqPpMmu0, kIrqPp1,
+	kIrqPpMmu1, kIrqPp2, kIrqPpMmu2, kIrqCount
+};
+extern const char* const kInterruptNames[kIrqCount];
+
+
+void flush_cache_range(phys_addr_t physical, size_t size);
+	// meson_mali.cpp: writes back and invalidates the CPU's lines
+
+
+struct dma_buffer {
+	area_id		area;
+	uint32*		address;
+	phys_addr_t	physical;
+
+	dma_buffer() : area(-1), address(NULL), physical(0) {}
+};
+
+
+class MesonMali;
+
+struct interrupt_line {
+	MesonMali*	device;
+	int32		index;		// kIrq*
+	int32		vector;
+	int32		count;
+};
+
+
+/*!	A buffer (a GEM object): an area of its own, cloneable so that
+	userland can map it; its pages mapped at \c va for the GPU.
+*/
+struct mali_buffer {
+	int32		refCount;
+	area_id		area;
+	size_t		size;
+	uint32		pageCount;
+	phys_addr_t* pages;
+	uint32		va;
+	uint64		lastRead;	// the last tasks that use it (sequence numbers)
+	uint64		lastWrite;
+};
+
+
+/*!	An open file: its buffer handles, sync objects and contexts. */
+struct mali_file {
+	mutex			lock;
+	mali_buffer**	buffers;	// handle - 1
+	uint32			bufferSlots;
+	uint64*			syncobjs;	// handle - 1: sequence number, 0 = done
+	bool*			syncobjsUsed;
+	uint32			syncobjSlots;
+	uint32			nextContext;
+};
+
+
+/*!	A job for one pipe, queued until the job thread runs it. */
+struct mali_task {
+	mali_task*		next;
+	uint32			pipe;
+	union {
+		mali_gp_frame		gp;
+		mali_m450_pp_frame	pp;
+	} frame;
+	uint32			bufferCount;
+	mali_buffer**	buffers;
+	uint32*			bufferFlags;
+	uint64			sequence;
+};
+
+
+class MesonMali {
+public:
+								MesonMali(device_node* node);
+								~MesonMali();
+
+			status_t			Init(phys_addr_t base,
+									const int32* interrupts);
+			device_node*		Node() const { return fNode; }
+			void				Dump();
+
+			// files and their ioctls (meson_mali_jobs.cpp)
+			status_t			OpenFile(mali_file** _file);
+			void				FreeFile(mali_file* file);
+			status_t			Control(mali_file* file, uint32 op,
+									void* buffer, size_t length);
+
+private:
+			uint32				_Read(uint32 offset) const
+									{ return fRegisters[offset / 4]; }
+			void				_Write(uint32 offset, uint32 value)
+									{ fRegisters[offset / 4] = value; }
+			uint32				_Hhi(uint32 offset) const
+									{ return fHhi[offset / 4]; }
+			void				_SetHhi(uint32 offset, uint32 value)
+									{ fHhi[offset / 4] = value; }
+
+			bool				_Poll(uint32 offset, uint32 mask,
+									uint32 value, bigtime_t timeout,
+									bigtime_t interval = 0) const;
+			void				_SetClock();
+			uint32				_ClockRate() const;
+			status_t			_PowerUp();
+			void				_InitL2(uint32 base, const char* name);
+			void				_FlushL2(uint32 base);
+			status_t			_ResetGp();
+			status_t			_ResetPp(uint32 index);
+			void				_HardResetGp();
+			void				_HardResetPp(uint32 index);
+			status_t			_InitMmu(uint32 base, const char* name);
+			void				_ZapMmu(uint32 base);
+			void				_RecoverMmu(uint32 base);
+			status_t			_AllocatePage(const char* name,
+									dma_buffer& buffer);
+			void				_FreePage(dma_buffer& buffer);
+			void				_InstallInterrupts(const int32* vectors);
+			void				_TestInterrupts();
+
+	static	int32				_Interrupt(void* data);
+			int32				_HandleInterrupt(interrupt_line& line);
+			int32				_GpJobInterrupt();
+			int32				_PpJobInterrupt();
+
+			// buffers and the GPU's address space (meson_mali_jobs.cpp)
+			status_t			_CreateBuffer(size_t size,
+									mali_buffer** _buffer);
+			void				_AcquireBuffer(mali_buffer* buffer);
+			void				_ReleaseBuffer(mali_buffer* buffer);
+			status_t			_AllocateAddress(size_t size,
+									uint32* _address);
+			void				_FreeAddress(uint32 address, size_t size);
+			status_t			_MapPages(mali_buffer* buffer);
+			void				_UnmapPages(mali_buffer* buffer);
+			void				_CleanBuffer(mali_buffer* buffer);
+
+			mali_buffer*		_LookUp(mali_file* file, uint32 handle);
+			status_t			_GetParam(void* buffer);
+			status_t			_GemCreate(mali_file* file, void* buffer);
+			status_t			_GemInfo(mali_file* file, void* buffer);
+			status_t			_GemClose(mali_file* file, void* buffer);
+			status_t			_GemSubmit(mali_file* file, void* buffer);
+			status_t			_GemWait(mali_file* file, void* buffer);
+			status_t			_SyncobjCreate(mali_file* file,
+									void* buffer);
+			status_t			_SyncobjDestroy(mali_file* file,
+									void* buffer);
+			status_t			_SyncobjWait(mali_file* file, void* buffer);
+			status_t			_WaitFor(uint64 sequence, int64 timeoutNs,
+									bool poll);
+
+			// the job thread
+	static	status_t			_JobThread(void* data);
+			void				_RunTask(mali_task* task);
+			bool				_RunGp(mali_task* task);
+			bool				_RunPp(mali_task* task);
+			void				_FreeTask(mali_task* task);
+
+			device_node*		fNode;
+			area_id				fArea;
+			volatile uint32*	fRegisters;
+			area_id				fHhiArea;
+			volatile uint32*	fHhi;
+			phys_addr_t			fBase;
+			dma_buffer			fPageDirectory;
+			dma_buffer			fPageTables[1024];
+			dma_buffer			fDlbuPage;
+			interrupt_line		fLines[kIrqCount];
+			uint32				fGpVersion;
+			uint32				fPpVersion[kPpCount];
+
+			// buffers and addresses: under fLock
+			mutex				fLock;
+			struct address_range {
+				uint32			start;
+				uint32			size;
+			};
+			address_range*		fRanges;		// in use, sorted
+			uint32				fRangeCount;
+			uint32				fRangeSlots;
+
+			// the queue and the sequence numbers: under fQueueLock
+			mutex				fQueueLock;
+			ConditionVariable	fQueueCondition;
+			ConditionVariable	fCompletion;
+			mali_task*			fQueueHead;
+			mali_task*			fQueueTail;
+			uint64				fNextSequence;
+			uint64				fCompleted;
+			thread_id			fJobThread;
+			bool				fQuit;
+
+			// the running job: under fJobLock (also from interrupts)
+			spinlock			fJobLock;
+			sem_id				fJobDone;
+			int32				fRunningPipe;	// -1: none
+			uint32				fJobError;
+			uint32				fPpPending;
+			uint32				fPpDone;
+			uint32				fPpCount;		// of the running job
+			uint32				fJobs;
+			uint32				fFailedJobs;
+};
