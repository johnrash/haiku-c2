+/*!	The GP's interrupt while it runs a job: an error ends it; else it is
+	done when a list ended and neither unit is still active. With fJobLock
+	held.
+*/
+int32
+MesonMali::_GpJobInterrupt()
+{
+	uint32 status = _Read(kGp + GP_INT_STAT);
+	if (status == 0)
+		return B_UNHANDLED_INTERRUPT;
+	uint32 state = _Read(kGp + GP_STATUS);
+	bool done = false;
+	if ((status & kGpInterruptsError) != 0) {
+		fJobError = status;
+		_Write(kGp + GP_INT_MASK, 0);
+		done = true;
+	} else if ((status & (kGpVsEnd | kGpPlbuEnd)) != 0
+		&& (state & (kGpStatusVsActive | kGpStatusPlbuActive)) == 0) {
+		done = true;
+	}
+	_Write(kGp + GP_INT_CLEAR, status);
+	if (done) {
+		fRunningPipe = -1;
+		release_sem_etc(fJobDone, 1, B_DO_NOT_RESCHEDULE);
+	}
+	return B_HANDLED_INTERRUPT;
+}
+
+
+/*!	The PPs' broadcast interrupt while they run a job: each PP is done
+	when it reports (an error ends it too) or has stopped rendering; the
+	job, when all are. With fJobLock held.
+*/
+int32
+MesonMali::_PpJobInterrupt()
+{
+	bool handled = false;
+	for (uint32 i = 0; i < fPpCount; i++) {
+		if ((fPpDone & (1u << i)) != 0)
+			continue;
+		uint32 base = kPp[i];
+		uint32 state = _Read(base + PP_STATUS);
+		uint32 status = _Read(base + PP_INT_STATUS);
+		if (status != 0) {
+			if ((status & kPpInterruptsError) != 0) {
+				fJobError = status;
+				_Write(base + PP_INT_MASK, 0);
+			}
+			_Write(base + PP_INT_CLEAR, status);
+			handled = true;
+		} else if ((state & kPpStatusRendering) != 0)
+			continue;
+		fPpDone |= 1u << i;
+		fPpPending--;
+	}
+	if (fPpPending == 0 && fRunningPipe == MALI_PIPE_PP) {
+		fRunningPipe = -1;
+		release_sem_etc(fJobDone, 1, B_DO_NOT_RESCHEDULE);
+		handled = true;
+	}
+	return handled ? B_HANDLED_INTERRUPT : B_UNHANDLED_INTERRUPT;
+}
