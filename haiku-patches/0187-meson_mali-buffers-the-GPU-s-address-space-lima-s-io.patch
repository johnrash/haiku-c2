+void
+MesonMali::_FlushL2(uint32 base)
+{
+	_Write(base + L2_COMMAND, 1);
+	if (!_Poll(base + L2_STATUS, 1, 0, 1000))
+		INFO("L2 %#" B_PRIx32 ": still busy after a flush\n", base);
+}
+
+
+/*!	After an error or a timeout: the bus stopped, then a hard reset. */
+void
+MesonMali::_HardResetGp()
+{
+	_Write(kGp + GP_PERF_CNT_0_LIMIT, 0xc0ffe000);
+	_Write(kGp + GP_INT_MASK, 0);
+	_Write(kGp + GP_CMD, kGpStopBus);
+	if (!_Poll(kGp + GP_STATUS, kGpStatusBusStopped, kGpStatusBusStopped,
+			100, 5)) {
+		INFO("GP: the bus doesn't stop\n");
+	}
+	_Write(kGp + GP_CMD, kGpHardReset);
+	bigtime_t deadline = system_time() + 100;
+	while (true) {
+		_Write(kGp + GP_PERF_CNT_0_LIMIT, 0xc01a0000);
+		if (_Read(kGp + GP_PERF_CNT_0_LIMIT) == 0xc01a0000)
+			break;
+		if (system_time() > deadline) {
+			INFO("GP: no hard reset\n");
+			break;
+		}
+		spin(5);
+	}
+	_Write(kGp + GP_PERF_CNT_0_LIMIT, 0);
+	_Write(kGp + GP_INT_CLEAR, kGpInterruptsAll);
+	_Write(kGp + GP_INT_MASK, kGpInterruptsUsed);
+}
+
+
+void
+MesonMali::_HardResetPp(uint32 index)
+{
+	uint32 base = kPp[index];
+	_Write(base + PP_PERF_CNT_0_LIMIT, 0xc0ffe000);
+	_Write(base + PP_INT_MASK, 0);
+	_Write(base + PP_CTRL, kPpStopBus);
+	if (!_Poll(base + PP_STATUS, kPpStatusBusStopped, kPpStatusBusStopped,
+			100, 5)) {
+		INFO("PP%" B_PRIu32 ": the bus doesn't stop\n", index);
+	}
+	_Write(base + PP_CTRL, kPpForceReset);
+	bigtime_t deadline = system_time() + 100;
+	while (true) {
+		_Write(base + PP_PERF_CNT_0_LIMIT, 0xc01a0000);
+		if (_Read(base + PP_PERF_CNT_0_LIMIT) == 0xc01a0000)
+			break;
+		if (system_time() > deadline) {
+			INFO("PP%" B_PRIu32 ": no hard reset\n", index);
+			break;
+		}
+		spin(5);
+	}
+	_Write(base + PP_PERF_CNT_0_LIMIT, 0);
+	_Write(base + PP_INT_CLEAR, kPpInterruptsAll);
+	_Write(base + PP_INT_MASK, kPpInterruptsUsed);
+}
+
+
+/*!	The MMU forgets its translations (the page tables changed): stalled,
+	the TLB zapped, going again.
+*/
+void
+MesonMali::_ZapMmu(uint32 base)
+{
+	_Write(base + MMU_COMMAND, MMU_ENABLE_STALL);
+	if (!_Poll(base + MMU_STATUS, kMmuStallActive, kMmuStallActive, 100))
+		INFO("MMU %#" B_PRIx32 ": no stall\n", base);
+	_Write(base + MMU_COMMAND, MMU_ZAP_CACHE);
+	_Write(base + MMU_COMMAND, MMU_DISABLE_STALL);
+	if (!_Poll(base + MMU_STATUS, kMmuStallActive, 0, 100))
+		INFO("MMU %#" B_PRIx32 ": still stalled\n", base);
+}
+
+
+/*!	After a page fault: a hard reset and the address space again. */
+void
+MesonMali::_RecoverMmu(uint32 base)
+{
+	if ((_Read(base + MMU_STATUS) & kMmuPageFaultActive) == 0) {
+		_Write(base + MMU_INT_MASK, kMmuInterrupts);
+		return;
+	}
+	_Write(base + MMU_INT_MASK, 0);
+	_Write(base + MMU_DTE_ADDR, 0xcafebabe);
+	_Write(base + MMU_COMMAND, MMU_HARD_RESET);
+	if (!_Poll(base + MMU_DTE_ADDR, ~0u, 0, 100))
+		INFO("MMU %#" B_PRIx32 ": no hard reset\n", base);
+	_Write(base + MMU_INT_CLEAR, kMmuInterrupts);
+	_Write(base + MMU_INT_MASK, kMmuInterrupts);
+	_Write(base + MMU_DTE_ADDR, (uint32)fPageDirectory.physical);
+	_Write(base + MMU_COMMAND, MMU_ENABLE_PAGING);
+	if (!_Poll(base + MMU_STATUS, kMmuPagingEnabled, kMmuPagingEnabled, 100))
+		INFO("MMU %#" B_PRIx32 ": paging not enabled\n", base);
+}
