+#ifndef _MESON_MALI_H
+#define _MESON_MALI_H
+
+
+/*!	The interface of meson_mali, the Mali-450 driver (PLAN.md M43): the one
+	Mesa's lima driver uses on Linux, with the same ioctl request values and
+	structure layouts, so that a small libdrm stand-in can pass lima's calls
+	through (docs/m43-mali-facts.md §5, docs/m43-mesa-lima-haiku.md §1).
+	Differences: a buffer's "offset" (MALI_IOCTL_GEM_INFO) is the area_id
+	of the buffer, to be cloned instead of mmap()ed; sync objects can't be
+	exported or imported as files; there are no global names or prime
+	handles.
+*/
+
+
+#include <SupportDefs.h>
+
+
+#define MESON_MALI_DEVICE			"/dev/misc/mali/0"
+
+// ioctl requests (Linux's encoding of the DRM ioctls)
+#define MALI_IOCTL_GEM_CLOSE		0x40086409
+#define MALI_IOCTL_SYNCOBJ_CREATE	0xc00864bf
+#define MALI_IOCTL_SYNCOBJ_DESTROY	0xc00864c0
+#define MALI_IOCTL_SYNCOBJ_WAIT		0xc02064c3
+#define MALI_IOCTL_GET_PARAM		0xc0106440
+#define MALI_IOCTL_GEM_CREATE		0xc0106441
+#define MALI_IOCTL_GEM_INFO			0xc0106442
+#define MALI_IOCTL_GEM_SUBMIT		0x40306443
+#define MALI_IOCTL_GEM_WAIT			0x40106444
+#define MALI_IOCTL_CTX_CREATE		0x80086445
+#define MALI_IOCTL_CTX_FREE			0x40086446
+
+enum {
+	MALI_PARAM_GPU_ID = 0,
+	MALI_PARAM_NUM_PP,
+	MALI_PARAM_GP_VERSION,
+	MALI_PARAM_PP_VERSION
+};
+#define MALI_GPU_ID_MALI450			2
+
+#define MALI_BO_FLAG_HEAP			0x1
+#define MALI_SUBMIT_BO_READ			0x1
+#define MALI_SUBMIT_BO_WRITE		0x2
+#define MALI_SUBMIT_FLAG_EXPLICIT_FENCE	0x1
+#define MALI_PIPE_GP				0
+#define MALI_PIPE_PP				1
+#define MALI_GEM_WAIT_READ			0x1
+#define MALI_GEM_WAIT_WRITE			0x2
+#define MALI_SYNCOBJ_CREATE_SIGNALED	0x1
+#define MALI_SYNCOBJ_WAIT_ALL		0x1
+
+typedef struct mali_gem_close {
+	uint32		handle;
+	uint32		pad;
+} mali_gem_close;
+
+typedef struct mali_syncobj_create {
+	uint32		handle;		// out
+	uint32		flags;
+} mali_syncobj_create;
+
+typedef struct mali_syncobj_destroy {
+	uint32		handle;
+	uint32		pad;
+} mali_syncobj_destroy;
+
+typedef struct mali_syncobj_wait {
+	uint64		handles;		// a uint32 array
+	int64		timeout_nsec;	// absolute, monotonic clock
+	uint32		count_handles;
+	uint32		flags;
+	uint32		first_signaled;
+	uint32		pad;
+} mali_syncobj_wait;
+
+typedef struct mali_get_param {
+	uint32		param;
+	uint32		pad;
+	uint64		value;			// out
+} mali_get_param;
+
+typedef struct mali_gem_create {
+	uint32		size;
+	uint32		flags;
+	uint32		handle;			// out
+	uint32		pad;
+} mali_gem_create;
+
+typedef struct mali_gem_info {
+	uint32		handle;
+	uint32		va;				// out: the GPU's address
+	uint64		offset;			// out: the area_id to clone
+} mali_gem_info;
+
+typedef struct mali_gem_submit_bo {
+	uint32		handle;
+	uint32		flags;			// MALI_SUBMIT_BO_*
+} mali_gem_submit_bo;
+
+typedef struct mali_gp_frame {
+	uint32		frame[6];
+} mali_gp_frame;
+
+typedef struct mali_m450_pp_frame {
+	uint32		frame[23];
+	uint32		num_pp;
+	uint32		wb[36];
+	uint32		use_dlbu;
+	uint32		_pad;
+	union {
+		uint32	plbu_array_address[8];
+		uint32	dlbu_regs[4];
+	};
+	uint32		fragment_stack_address[8];
+} mali_m450_pp_frame;
+
+typedef struct mali_gem_submit {
+	uint32		ctx;
+	uint32		pipe;			// MALI_PIPE_*
+	uint32		nr_bos;
+	uint32		frame_size;
+	uint64		bos;			// a mali_gem_submit_bo array
+	uint64		frame;			// a mali_gp_frame or mali_m450_pp_frame
+	uint32		flags;
+	uint32		out_sync;
+	uint32		in_sync[2];
+} mali_gem_submit;
+
+typedef struct mali_gem_wait {
+	uint32		handle;
+	uint32		op;				// MALI_GEM_WAIT_*
+	int64		timeout_ns;		// absolute, monotonic clock
+} mali_gem_wait;
+
+typedef struct mali_ctx_create {
+	uint32		id;				// out
+	uint32		_pad;
+} mali_ctx_create;
+
+typedef struct mali_ctx_free {
+	uint32		id;
+	uint32		_pad;
+} mali_ctx_free;
+
+
+#endif	// _MESON_MALI_H
