new file mode 100644
index 0000000000..70bbfd7476
--- /dev/null
+++ b/src/apps/codycam/VideoRecorder.cpp
@@ -0,0 +1,261 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "VideoRecorder.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <Autolock.h>
+#include <Entry.h>
+#include <MediaFile.h>
+#include <MediaFormats.h>
+#include <MediaTrack.h>
+#include <NodeInfo.h>
+
+
+static const char* kFileType = "video/x-matroska";
+static const char* kCodecName = "mpeg4";
+
+
+VideoRecorder::VideoRecorder()
+	:
+	fFile(NULL),
+	fTrack(NULL),
+	fFrameSize(0),
+	fFrameRate(30),
+	fLock("video recorder"),
+	fFrameSem(-1),
+	fThread(-1),
+	fQuit(false),
+	fPending(NULL),
+	fPendingTime(0),
+	fHasPending(false),
+	fWorking(NULL),
+	fFirstTime(-1),
+	fFramesWritten(0),
+	fError(B_OK)
+{
+}
+
+
+VideoRecorder::~VideoRecorder()
+{
+	Stop();
+}
+
+
+status_t
+VideoRecorder::Start(const char* path, uint32 width, uint32 height,
+	uint32 bytesPerRow, float frameRate)
+{
+	if (fFile != NULL)
+		return EALREADY;
+	if (frameRate <= 0)
+		frameRate = 30;
+
+	media_file_format fileFormat;
+	int32 cookie = 0;
+	bool found = false;
+	while (get_next_file_format(&cookie, &fileFormat) == B_OK) {
+		if ((fileFormat.capabilities & media_file_format::B_WRITABLE) != 0
+			&& strcmp(fileFormat.mime_type, kFileType) == 0) {
+			found = true;
+			break;
+		}
+	}
+	if (!found)
+		return B_MEDIA_NO_HANDLER;
+
+	media_format inFormat;
+	inFormat.type = B_MEDIA_RAW_VIDEO;
+	inFormat.u.raw_video = media_raw_video_format::wildcard;
+	inFormat.u.raw_video.field_rate = frameRate;
+	inFormat.u.raw_video.interlace = 1;
+	inFormat.u.raw_video.pixel_width_aspect = 1;
+	inFormat.u.raw_video.pixel_height_aspect = 1;
+	inFormat.u.raw_video.display.format = B_RGB32;
+	inFormat.u.raw_video.display.line_width = width;
+	inFormat.u.raw_video.display.line_count = height;
+	inFormat.u.raw_video.display.bytes_per_row = bytesPerRow;
+
+	media_format outFormat;
+	media_codec_info codec;
+	cookie = 0;
+	found = false;
+	while (get_next_encoder(&cookie, &fileFormat, &inFormat, &outFormat,
+			&codec) == B_OK) {
+		if (strcmp(codec.short_name, kCodecName) == 0) {
+			found = true;
+			break;
+		}
+	}
+	if (!found)
+		return B_MEDIA_BAD_FORMAT;
+
+	entry_ref ref;
+	status_t status = get_ref_for_path(path, &ref);
+	if (status != B_OK)
+		return status;
+
+	fFile = new BMediaFile(&ref, &fileFormat);
+	status = fFile->InitCheck();
+	if (status == B_OK) {
+		fTrack = fFile->CreateTrack(&inFormat, &codec);
+		if (fTrack == NULL)
+			status = B_MEDIA_BAD_FORMAT;
+	}
+	if (status == B_OK)
+		status = fFile->CommitHeader();
+
+	fFrameSize = (size_t)bytesPerRow * height;
+	fPending = (uint8*)malloc(fFrameSize);
+	fWorking = (uint8*)malloc(fFrameSize);
+	if (status == B_OK && (fPending == NULL || fWorking == NULL))
+		status = B_NO_MEMORY;
+	if (status == B_OK) {
+		fFrameSem = create_sem(0, "recorder frame");
+		if (fFrameSem < 0)
+			status = fFrameSem;
+	}
+	if (status != B_OK) {
+		_Cleanup();
+		return status;
+	}
+
+	BNode node(&ref);
+	BNodeInfo(&node).SetType(kFileType);
+
+	fPath = path;
+	fFrameRate = frameRate;
+	fHasPending = false;
+	fFirstTime = -1;
+	fFramesWritten = 0;
+	fError = B_OK;
+	fQuit = false;
+	fThread = spawn_thread(_ThreadEntry, "video recorder", B_NORMAL_PRIORITY,
+		this);
+	if (fThread < 0) {
+		status = fThread;
+		_Cleanup();
+		return status;
+	}
+	resume_thread(fThread);
+	return B_OK;
+}
+
+
+void
+VideoRecorder::AddFrame(const void* bits, bigtime_t when)
+{
+	if (fFile == NULL)
+		return;
+
+	fLock.Lock();
+	memcpy(fPending, bits, fFrameSize);
+	fPendingTime = when;
+	bool wake = !fHasPending;
+	fHasPending = true;
+	fLock.Unlock();
+
+	if (wake)
+		release_sem(fFrameSem);
+}
+
+
+/*!	Writes what is left and closes the file. */
+status_t
+VideoRecorder::Stop()
+{
+	if (fFile == NULL)
+		return B_OK;
+
+	fQuit = true;
+	release_sem(fFrameSem);
+	status_t result;
+	wait_for_thread(fThread, &result);
+	fThread = -1;
+
+	fTrack->Flush();
+	status_t status = fError;
+	_Cleanup();
+	return status;
+}
+
+
+bigtime_t
+VideoRecorder::Duration() const
+{
+	return (bigtime_t)(fFramesWritten * 1000000.0 / fFrameRate);
+}
+
+
+status_t
+VideoRecorder::_ThreadEntry(void* data)
+{
+	((VideoRecorder*)data)->_Thread();
+	return B_OK;
+}
+
+
+void
+VideoRecorder::_Thread()
+{
+	// at most this many copies of one frame (a camera that stopped)
+	const int64 kMaxRepeat = (int64)(fFrameRate * 10);
+
+	while (acquire_sem(fFrameSem) == B_OK) {
+		fLock.Lock();
+		bool hasFrame = fHasPending;
+		bigtime_t when = fPendingTime;
+		if (hasFrame) {
+			uint8* swap = fPending;
+			fPending = fWorking;
+			fWorking = swap;
+			fHasPending = false;
+		}
+		fLock.Unlock();
+
+		if (hasFrame && fError == B_OK) {
+			if (fFirstTime < 0)
+				fFirstTime = when;
+			// the frame stands for the time from its own until the next
+			int64 target = llround((when - fFirstTime) * fFrameRate
+				/ 1000000.0) + 1;
+			if (target - fFramesWritten > kMaxRepeat)
+				target = fFramesWritten + kMaxRepeat;
+			while (fFramesWritten < target && fError == B_OK) {
+				fError = fTrack->WriteFrames(fWorking, 1,
+					fFramesWritten == 0 ? B_MEDIA_KEY_FRAME : 0);
+				fFramesWritten++;
+			}
+		}
+
+		if (fQuit)
+			break;
+	}
+}
+
+
+void
+VideoRecorder::_Cleanup()
+{
+	if (fFile != NULL) {
+		fFile->CloseFile();
+		delete fFile;
+		fFile = NULL;
+	}
+	fTrack = NULL;
+	if (fFrameSem >= 0) {
+		delete_sem(fFrameSem);
+		fFrameSem = -1;
+	}
+	free(fPending);
+	fPending = NULL;
+	free(fWorking);
+	fWorking = NULL;
+}
