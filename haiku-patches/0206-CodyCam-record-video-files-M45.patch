+ * Distributed under the terms of the MIT License.
+ */
+#ifndef VIDEO_RECORDER_H
+#define VIDEO_RECORDER_H
+
+
+#include <Locker.h>
+#include <OS.h>
+#include <String.h>
+
+
+class BMediaFile;
+class BMediaTrack;
+
+
+/*!	Writes the frames it is given (B_RGB32) into a Matroska file as MPEG-4
+	video at a constant frame rate: a frame that came late is written again
+	for the frames it missed, one that came early is left out, so that the
+	video plays at the speed it was taken, also when the camera lowers its
+	rate in low light. Encoding runs in a thread of its own; AddFrame() only
+	copies the frame.
+*/
+class VideoRecorder {
+public:
+								VideoRecorder();
+								~VideoRecorder();
+
+			status_t			Start(const char* path, uint32 width,
+									uint32 height, uint32 bytesPerRow,
+									float frameRate);
+			void				AddFrame(const void* bits, bigtime_t when);
