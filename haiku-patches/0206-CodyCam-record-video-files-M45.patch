+/*!	Starts or ends recording the video into a Matroska file (MPEG-4) in
+	the Videos folder in the home folder, named for the time it began.
+*/
+void
+CodyCam::_ToggleRecording()
+{
+	if (fVideoConsumer == NULL || fWindow == NULL)
+		return;
+
+	if (fVideoConsumer->IsRecording()) {
+		BString path;
+		bigtime_t duration = 0;
+		status_t status = fVideoConsumer->StopRecording(&path, &duration);
+		BString text;
+		if (status == B_OK) {
+			int32 seconds = (int32)(duration / 1000000);
+			text = B_TRANSLATE("Saved %path% (%minutes%:%seconds%)");
+			text.ReplaceFirst("%path%", path);
+			BString minutes;
+			minutes << seconds / 60;
+			BString secondsText;
+			secondsText.SetToFormat("%02" B_PRId32, seconds % 60);
+			text.ReplaceFirst("%minutes%", minutes);
+			text.ReplaceFirst("%seconds%", secondsText);
+		} else {
+			text = B_TRANSLATE("Error recording the video: %error%");
+			text.ReplaceFirst("%error%", strerror(status));
+		}
+		fWindow->RecordingChanged(false, text.String());
+		return;
+	}
+
+	BPath path;
+	status_t status = find_directory(B_USER_DIRECTORY, &path);
+	if (status == B_OK)
+		status = path.Append("Videos");
+	if (status == B_OK) {
+		create_directory(path.Path(), 0755);
+		char name[64];
+		time_t now = time(NULL);
+		strftime(name, sizeof(name), "CodyCam %Y-%m-%d %H-%M-%S.mkv",
+			localtime(&now));
+		status = path.Append(name);
+	}
+	if (status == B_OK)
+		status = fVideoConsumer->StartRecording(path.Path());
+
+	BString text;
+	if (status == B_OK) {
+		text = B_TRANSLATE("Recording to %path%");
+		text.ReplaceFirst("%path%", path.Path());
+	} else {
+		text = B_TRANSLATE("Cannot record the video: %error%");
+		text.ReplaceFirst("%error%", strerror(status));
+	}
+	fWindow->RecordingChanged(status == B_OK, text.String());
+}
