+/*!	Starts recording what arrives into a video file at \a path (Matroska,
+	MPEG-4), in the size and frame rate of the connection.
+*/
+status_t
+VideoConsumer::StartRecording(const char* path)
+{
+	BAutolock locker(fRecorderLock);
+	if (fRecorder != NULL)
+		return EALREADY;
+	if (!fConnectionActive || fFtpBitmap == NULL)
+		return B_NO_INIT;
+	if (fFtpBitmap->ColorSpace() != B_RGB32)
+		return B_MEDIA_BAD_FORMAT;
+
+	float frameRate = fIn.format.u.raw_video.field_rate;
+	BRect bounds = fFtpBitmap->Bounds();
+	VideoRecorder* recorder = new VideoRecorder;
+	status_t status = recorder->Start(path, bounds.IntegerWidth() + 1,
+		bounds.IntegerHeight() + 1, fFtpBitmap->BytesPerRow(),
+		frameRate > 0 ? frameRate : 30);
+	if (status != B_OK) {
+		delete recorder;
+		return status;
+	}
+	fRecorder = recorder;
+	return B_OK;
+}
+
+
+/*!	Ends a recording and closes its file. */
+status_t
+VideoConsumer::StopRecording(BString* _path, bigtime_t* _duration)
+{
+	fRecorderLock.Lock();
+	VideoRecorder* recorder = fRecorder;
+	fRecorder = NULL;
+	fRecorderLock.Unlock();
+	if (recorder == NULL)
+		return B_NO_INIT;
+
+	status_t status = recorder->Stop();
+	if (_path != NULL)
+		*_path = recorder->Path();
+	if (_duration != NULL)
+		*_duration = recorder->Duration();
+	delete recorder;
+	return status;
+}
+
+
+bool
+VideoConsumer::IsRecording()
+{
+	BAutolock locker(fRecorderLock);
+	return fRecorder != NULL;
+}
