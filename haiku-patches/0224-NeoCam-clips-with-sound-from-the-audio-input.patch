+
+
+/*!	The sound for a clip: the default audio input (a webcam's microphone,
+	say) through a BMediaRecorder, its buffers handed to the camera node's
+	recording. Used from the camera controller's thread.
+*/
+class AudioCapture {
+public:
+								AudioCapture();
+								~AudioCapture();
+
+			status_t			Connect(media_multi_audio_format& _format);
+			status_t			Start(CameraConsumer* consumer);
+			void				Stop();
+
+private:
+	static	void				_Record(void* cookie, bigtime_t timestamp,
+									void* data, size_t size,
+									const media_format& format);
+
+			BMediaRecorder*		fRecorder;
+};
+
