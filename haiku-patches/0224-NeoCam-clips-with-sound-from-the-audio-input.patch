+/*!	Sound in the format \a audio, as AAC (or, without that encoder, FLAC). */
+void
+VideoRecorder::_AddAudioTrack(const media_file_format& fileFormat,
+	const media_multi_audio_format& audio)
+{
+	media_format inFormat;
+	inFormat.type = B_MEDIA_RAW_AUDIO;
+	inFormat.u.raw_audio = audio;
+	size_t sampleSize = audio.format & media_raw_audio_format::B_AUDIO_SIZE_MASK;
+	if (sampleSize == 0 || audio.channel_count == 0)
+		return;
+
+	static const char* kAudioCodecs[] = { "aac", "flac" };
+	for (size_t i = 0; i < sizeof(kAudioCodecs) / sizeof(kAudioCodecs[0]);
+			i++) {
+		media_format outFormat;
+		media_codec_info codec;
+		int32 cookie = 0;
+		media_file_format format = fileFormat;
+		while (get_next_encoder(&cookie, &format, &inFormat, &outFormat,
+				&codec) == B_OK) {
+			if (strcmp(codec.short_name, kAudioCodecs[i]) != 0)
+				continue;
+			BMediaTrack* track = fFile->CreateTrack(&inFormat, &codec);
+			if (track == NULL)
+				break;
+			if (track->InitCheck() != B_OK) {
+				fFile->ReleaseTrack(track);
+				break;
+			}
+			fAudioFrameSize = sampleSize * audio.channel_count;
+			fAudioTrack = track;
+			return;
+		}
+	}
+}
+
+
+void
+VideoRecorder::AddAudio(const void* data, size_t size)
+{
+	BAutolock _(fAudioLock);
+	// from the first picture on, so that both start together
+	if (fAudioTrack == NULL || fFramesWritten == 0 || fAudioFrameSize == 0)
+		return;
+	fAudioTrack->WriteFrames(data, size / fAudioFrameSize);
+}
+
