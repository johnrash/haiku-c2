+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "AudioCapture.h"
+
+#include <MediaRecorder.h>
+#include <MediaRoster.h>
+
+#include "CameraConsumer.h"
+
+
+AudioCapture::AudioCapture()
+	:
+	fRecorder(NULL)
+{
+}
+
+
+AudioCapture::~AudioCapture()
+{
+	Stop();
+}
+
+
+/*!	Connects to the default audio input; its format is what the clip's
+	sound track gets.
+*/
+status_t
+AudioCapture::Connect(media_multi_audio_format& _format)
+{
+	Stop();
+
+	BMediaRoster* roster = BMediaRoster::Roster();
+	if (roster == NULL)
+		return B_ERROR;
+	media_node input;
+	status_t status = roster->GetAudioInput(&input);
+	if (status != B_OK)
+		return status;
+
+	media_output output;
+	int32 count = 0;
+	status = roster->GetFreeOutputsFor(input, &output, 1, &count,
+		B_MEDIA_RAW_AUDIO);
+	roster->ReleaseNode(input);
+	if (status != B_OK || count < 1)
+		return B_BUSY;
+
+	fRecorder = new BMediaRecorder("NeoCam sound", B_MEDIA_RAW_AUDIO);
+	status = fRecorder->InitCheck();
+	if (status == B_OK) {
+		media_format format;
+		format.type = B_MEDIA_RAW_AUDIO;
+		format.u.raw_audio = output.format.u.raw_audio;
+		fRecorder->SetAcceptedFormat(format);
+		status = fRecorder->Connect(output.node, &output, &format);
+	}
+	if (status != B_OK) {
+		delete fRecorder;
+		fRecorder = NULL;
+		return status;
+	}
+	_format = fRecorder->Format().u.raw_audio;
+	return B_OK;
+}
+
+
+status_t
+AudioCapture::Start(CameraConsumer* consumer)
+{
+	if (fRecorder == NULL)
+		return B_NO_INIT;
+	fRecorder->SetHooks(&_Record, NULL, consumer);
+	return fRecorder->Start();
+}
+
+
+void
+AudioCapture::Stop()
+{
+	if (fRecorder == NULL)
+		return;
+	fRecorder->Stop(true);
+	fRecorder->SetHooks(NULL, NULL, NULL);
+	fRecorder->Disconnect();
+	delete fRecorder;
+	fRecorder = NULL;
+}
+
+
+/*static*/ void
+AudioCapture::_Record(void* cookie, bigtime_t timestamp, void* data,
+	size_t size, const media_format& format)
+{
+	((CameraConsumer*)cookie)->AddAudio(data, size);
+}
