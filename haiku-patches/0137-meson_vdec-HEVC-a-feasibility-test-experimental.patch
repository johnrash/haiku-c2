+//	#pragma mark - power, firmware, start
+
+
+void
+MesonVdec::_PowerUpHevc()
+{
+	fHhi[HHI_GCLK_MPEG1 / 4] |= GCLK_MPEG1_DOS_PARSER;
+	fHhi[HHI_GCLK_MPEG0 / 4] |= GCLK_MPEG0_DOS;
+
+	// HHI_VDEC2_CLK_CNTL's upper half: fclk/3, 666.7 MHz
+	uint32 clock = fHhi[HHI_VDEC2_CLK_CNTL / 4] & ~(0x7fu << 16)
+		& ~(3u << 25) & ~(1u << 24);
+	fHhi[HHI_VDEC2_CLK_CNTL / 4] = clock | (1u << 25);
+	fHhi[HHI_VDEC2_CLK_CNTL / 4] |= 1u << 24;
+
+	fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] &= ~AO_SLEEP_HEVC;
+	spin(20);
+	_SetDos(DOS_SW_RESET3, 0xffffffff);
+	spin(10);
+	_SetDos(DOS_SW_RESET3, 0);
+	_SetDos(DOS_GCLK_EN3, 0xffffffff);
+	_SetDos(DOS_MEM_PD_HEVC, 0);
+	fAo[AO_RTI_GEN_PWR_ISO0 / 4] &= ~AO_ISO_HEVC;
+	_SetDos(DOS_SW_RESET3, 0xffffffff);
+	spin(10);
+	_SetDos(DOS_SW_RESET3, 0);
+	_SetDos(DOS_SW_RESET3, 0x000ed918);
+	spin(10);
+	_SetDos(DOS_SW_RESET3, 0);
+}
+
+
+void
+MesonVdec::_StopHevcProcessor()
+{
+	_SetDos(HEVC_ASSIST_MBOX1_MASK, 0);
+	_SetDos(HEVC_MPSR, 0);
+	_SetDos(HEVC_CPSR, 0);
+	// what the processor's DMA still does
+	for (int32 i = 0; i < 1000; i++) {
+		if ((_Dos(HEVC_IMEM_DMA_CTRL) & (1 << 15)) == 0
+			&& (_Dos(HEVC_LMEM_DMA_CTRL) & (1 << 15)) == 0) {
+			break;
+		}
+		spin(10);
+	}
+	_SetDos(HEVC_STREAM_CONTROL, 0);
+	_SetDos(DOS_SW_RESET3, 0x000ed918);
+	spin(10);
+	_SetDos(DOS_SW_RESET3, 0);
+}
