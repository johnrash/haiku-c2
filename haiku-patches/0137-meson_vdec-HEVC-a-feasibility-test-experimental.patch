+
+void
+MesonVdec::_PowerDownHevc()
+{
+	fAo[AO_RTI_GEN_PWR_ISO0 / 4] |= AO_ISO_HEVC;
+	_SetDos(DOS_MEM_PD_HEVC, 0xffffffff);
+	fAo[AO_RTI_GEN_PWR_SLEEP0 / 4] |= AO_SLEEP_HEVC;
+	fHhi[HHI_VDEC2_CLK_CNTL / 4] &= ~(1u << 24);
+	_SetDos(DOS_GEN_CTRL0, 0);
+	fHhi[HHI_GCLK_MPEG0 / 4] &= ~GCLK_MPEG0_DOS;
+	fHhi[HHI_GCLK_MPEG1 / 4] &= ~GCLK_MPEG1_DOS_PARSER;
+}
+
+
+/*!	The codec start: the workspace, the shifter and parser, the scratch
+	registers the firmware reads at its start (it moves some of them: they
+	are written once).
+*/
+void
+MesonVdec::_StartHevcCodec()
+{
+	phys_addr_t work = fWorkspace.physical;
+	_SetDos(HEVCD_IPP_LINEBUFF_BASE, work + kWorkIpp);
+	_SetDos(HEVC_RPM_BUFFER, work + kWorkRpm);
+	_SetDos(HEVC_SHORT_TERM_RPS, work + kWorkShortTermRps);
+	_SetDos(HEVC_VPS_BUFFER, work + kWorkVps);
+	_SetDos(HEVC_SPS_BUFFER, work + kWorkSps);
+	_SetDos(HEVC_PPS_BUFFER, work + kWorkPps);
+	_SetDos(HEVC_SAO_UP, work + kWorkSaoUp);
+	_SetDos(HEVC_STREAM_SWAP_BUFFER, work + kWorkSwap);
+	_SetDos(HEVC_STREAM_SWAP_BUFFER2, work + kWorkSwap2);
+	_SetDos(HEVC_SCALELUT, work + kWorkScaleLut);
+	_SetDos(HEVC_DBLK_CFG4, work + kWorkDeblockParameters);
+	_SetDos(HEVC_DBLK_CFG5, work + kWorkDeblockData);
+	_SetDos(HEVC_LMEM_DUMP_ADR, work + kWorkLmem);
+
+	_SetDos(HEVC_STREAM_CONTROL, _Dos(HEVC_STREAM_CONTROL) | 1);
+	_SetDos(HEVC_PARSER_INT_CONTROL,
+		(_Dos(HEVC_PARSER_INT_CONTROL) & 0x03fffff7) | 0x69400091);
+	_SetDos(HEVC_SHIFT_STATUS, _Dos(HEVC_SHIFT_STATUS) | 3);
+	_SetDos(HEVC_SHIFT_CONTROL, 0xe5);
+	_SetDos(HEVC_CABAC_CONTROL, 1);
+	_SetDos(HEVC_PARSER_CORE_CONTROL, 1);
+	_SetDos(HEVC_DEC_STATUS_REG, 0);
+	_SetDos(HEVC_IQIT_SCALELUT_WR_ADDR, 0);
+	for (int32 i = 0; i < 1024; i++)
+		_SetDos(HEVC_IQIT_SCALELUT_DATA, 0);
+	_SetDos(HEVC_DECODE_SIZE, fHevcVendor ? 0xffffffff : 0);
+	_SetDos(HEVC_PARSER_CMD_WRITE, 1 << 16);
+	for (size_t i = 0; i < B_COUNT_OF(kParserCommands); i++)
+		_SetDos(HEVC_PARSER_CMD_WRITE, kParserCommands[i]);
+	_SetDos(HEVC_PARSER_CMD_SKIP_0, 0x0000090b);
+	_SetDos(HEVC_PARSER_CMD_SKIP_1, 0x1b14140f);
+	_SetDos(HEVC_PARSER_CMD_SKIP_2, 0x001b1910);
+	_SetDos(HEVC_PARSER_IF_CONTROL, 0x25);
+	_SetDos(HEVCD_IPP_TOP_CNTL, 1);
+	_SetDos(HEVCD_IPP_TOP_CNTL, 2);
+	_SetDos(HEVC_WAIT_FLAG, 1);
+	_SetDos(HEVC_ASSIST_MBOX1_CLR_REG, 1);
+	_SetDos(HEVC_ASSIST_MBOX1_MASK, 0);
+		// the waits poll the status
+	_SetDos(HEVC_PSCALE_CTRL, 0);
+	_SetDos(HEVC_NAL_SEARCH_CTL, fHevcVendor ? 0x8 : 0xc);
+	_SetDos(HEVC_DECODE_STOP_POS, 0);
+	if (fHevcVendor) {
+		_SetDos(HEVC_AUX_ADR, 0);
+		_SetDos(HEVC_AUX_DATA_SIZE, 0);
+	} else {
+		_SetDos(HEVC_DECODE_MODE, 0);
+		_SetDos(HEVC_DECODE_MODE2, 0);
+		_SetDos(HEVC_AUX_ADR, fAux.physical);
+		_SetDos(HEVC_AUX_DATA_SIZE, (kHevcAuxSize / 16) << 16);
+	}
+}
+
+
+/*!	The stream parser as for VDEC_1, its output going to the HEVC block's
+	stream buffer (the VIFIFO's memory) instead.
+*/
+void
+MesonVdec::_InitHevcParser()
+{
+	fReset[RESET1 / 4] = RESET1_PARSER;
+	_SetParser(PARSER_CONFIG, 0x000a1010);
+	_SetParser(PFIFO_RD_PTR, 0);
+	_SetParser(PFIFO_WR_PTR, 0);
+	_SetParser(PARSER_SEARCH_PATTERN, 0x00000100);
+	_SetParser(PARSER_SEARCH_MASK, 0xffffff00);
+	_SetParser(PARSER_CONFIG, 0x000a1810);
+	_SetParser(PARSER_CONTROL, PARSER_START_SEARCH);
+	_SetParser(PARSER_VIDEO_START_PTR, fVififo.physical);
+	_SetParser(PARSER_VIDEO_END_PTR, fVififo.physical + fVififo.size - 8);
+	_SetParser(PARSER_ES_CONTROL, _Parser(PARSER_ES_CONTROL) & ~1u);
+	_SetDos(DOS_GEN_CTRL0, 3 << 1);
+	_SetDos(HEVC_STREAM_CONTROL, _Dos(HEVC_STREAM_CONTROL) | (1 << 3));
+	_SetDos(HEVC_STREAM_CONTROL, _Dos(HEVC_STREAM_CONTROL) | 1);
+	_SetDos(HEVC_STREAM_FIFO_CTL, _Dos(HEVC_STREAM_FIFO_CTL) | (1u << 29));
+	_SetParser(PARSER_INT_STATUS, 0xffff);
+	_SetParser(PARSER_INT_ENABLE, PARSER_INT_HOST_START_CODE);
+}
+
+
+status_t
+MesonVdec::_StartHevc(meson_vdec_start& start, const void* userFirmware)
+{
+	if (start.firmware_size != kFirmwareSize || !IS_USER_ADDRESS(userFirmware))
+		return B_BAD_VALUE;
+
+	fCodec = start.codec;
+	fHevcVendor = start.codec == MESON_VDEC_HEVC_VENDOR;
+	fWidth = fHeight = 0;
+	status_t status;
+	if ((status = _KeepBuffer("meson_vdec firmware", kFirmwareSize,
+			fFirmware, false, false)) != B_OK
+		|| (status = _KeepBuffer("meson_vdec vififo", kVififoSize,
+			fVififo, false, false)) != B_OK
+		|| (status = _KeepBuffer("meson_vdec workspace", kHevcWorkspaceSize,
+			fWorkspace, false, true)) != B_OK
+		|| (status = _KeepBuffer("meson_vdec input",
+			kInputSize + kMinimumFetch + kMarkerSize, fInput, false, false))
+				!= B_OK
+		|| (status = _KeepBuffer("meson_vdec aux", kHevcAuxSize, fAux, false,
+			true)) != B_OK) {
+		INFO("no memory for an HEVC session: %s\n", strerror(status));
+		_Stop();
+		return status;
+	}
+	if (user_memcpy(fFirmware.address, userFirmware, kFirmwareSize) != B_OK) {
+		_Stop();
+		return B_BAD_ADDRESS;
+	}
+	flush_cache_range(fFirmware.physical, kFirmwareSize);
+
+	{
+		InterruptsSpinLocker locker(fStateLock);
+		fQueueHead = 0;
+		fQueueCount = 0;
+		fHeld = 0;
+		fFatal = false;
+		fLastReport = 0;
+		fEndOfStream = false;
+		fStreamBytes = 0;
+		fEndOffset = 0;
+		fFrameCount = 0;
+		fDecodeErrors = 0;
+		fBadPictures = 0;
+	}
+	fHevcPicture = -1;
+	fHevcEnded = false;
+	fHevcLastStatus = 0;
+	fHevcLastChange = system_time();
+	fHevcSlices = 0;
+	fHevcSkipped = 0;
+	fHevcReports = 0;
+	int32 count;
+	if (get_sem_count(fFrameSem, &count) == B_OK && count > 0)
+		acquire_sem_etc(fFrameSem, count, 0, 0);
+	if (get_sem_count(fParserSem, &count) == B_OK && count > 0)
+		acquire_sem_etc(fParserSem, count, 0, 0);
+
+	_PowerUpHevc();
+	uint32 version = _Dos(HEVC_PARSER_VERSION);
+	uint32 startCode = _Dos(HEVC_SHIFT_STARTCODE);
+	uint32 emulateCode = _Dos(HEVC_SHIFT_EMULATECODE);
+	INFO("HEVC block: parser version %#" B_PRIx32 ", start code %#" B_PRIx32
+		", emulation code %#" B_PRIx32 " (%s firmware)\n", version, startCode,
+		emulateCode, fHevcVendor ? "vendor" : "linux-firmware");
+
+	// the stream buffer
+	_SetDos(HEVC_STREAM_CONTROL, _Dos(HEVC_STREAM_CONTROL) & ~1u);
+	_SetDos(HEVC_STREAM_START_ADDR, fVififo.physical);
+	_SetDos(HEVC_STREAM_END_ADDR, fVififo.physical + fVififo.size);
+	_SetDos(HEVC_STREAM_RD_PTR, fVififo.physical);
+	_SetDos(HEVC_STREAM_WR_PTR, fVififo.physical);
+
+	// the firmware
+	_SetDos(HEVC_MPSR, 0);
+	_SetDos(HEVC_CPSR, 0);
+	_SetDos(HEVC_IMEM_DMA_ADR, fFirmware.physical);
+	_SetDos(HEVC_IMEM_DMA_COUNT, kFirmwareSize / 4);
+	_SetDos(HEVC_IMEM_DMA_CTRL, 0x00078000);
+	bigtime_t timeout = system_time() + 100000;
+	while ((_Dos(HEVC_IMEM_DMA_CTRL) & (1 << 15)) != 0) {
+		if (system_time() > timeout) {
+			INFO("HEVC firmware DMA does not finish\n");
+			_PowerDownHevc();
+			_Stop();
+			return B_TIMED_OUT;
+		}
+	}
+
+	_StartHevcCodec();
+	fRunning = true;
+	(void)_Dos(DOS_SW_RESET3);
+	_SetDos(DOS_SW_RESET3, (1 << 12) | (1 << 11));
+	_SetDos(DOS_SW_RESET3, 0);
+	(void)_Dos(DOS_SW_RESET3);
+	_SetDos(HEVC_MPSR, 1);
+	spin(20);
+	_InitHevcParser();
+
+	start.frame_count = 0;
+	start.frame_size = 0;
+	start.frames = -1;
+	INFO("HEVC session: byte count %" B_PRIu32 ", status %#" B_PRIx32 "\n",
+		_Dos(HEVC_SHIFT_BYTE_COUNT), _Dos(HEVC_DEC_STATUS_REG));
+	return B_OK;
+}
+
+
+//	#pragma mark - decoding
+
+
+/*!	A parameter of the last slice header, by gxl_hevc.bin's numbering. The
+	firmware stores each group of four 16-bit values in reverse order.
+*/
+uint32
+MesonVdec::_Rpm(uint32 index) const
+{
+	if (fHevcVendor && index >= RPM_MISC_FLAG0)
+		index -= 8;
+	return fRpm[(index & ~3u) + 3 - (index & 3)];
+}
+
+
+/*!	The frames, once the first slice header gives the picture's size: each
+	one area with the Y plane, the CbCr plane and the motion vectors, every
+	part 64 KB aligned (the GXBB's reference table keeps only address bits
+	31:16); and the reference table pointing at them.
+*/
+status_t
+MesonVdec::_SetupHevcFrames()
+{
+	uint32 width = _Rpm(RPM_WIDTH);
+	uint32 height = _Rpm(RPM_HEIGHT);
+	uint32 log2Ctb = _Rpm(RPM_LOG2_MIN_CB) + 3 + _Rpm(RPM_LOG2_DIFF_CB);
+	if (width < 16 || height < 16 || width > kMaxWidth || height > kMaxHeight
+		|| log2Ctb < 4 || log2Ctb > 6) {
+		INFO("HEVC stream of %" B_PRIu32 "x%" B_PRIu32 ", CTB %" B_PRIu32
+			": not decoded\n", width, height, 1u << log2Ctb);
+		return B_BAD_VALUE;
+	}
+	fHevcCodedWidth = width;
+	fHevcCodedHeight = height;
+	fHevcLog2Ctb = log2Ctb;
+	uint32 ctb = 1 << log2Ctb;
+	fHevcCtbColumns = (width + ctb - 1) / ctb;
+	fHevcCtbRows = (height + ctb - 1) / ctb;
+	fHevcMvUnit = log2Ctb == 6 ? 0x200 : log2Ctb == 5 ? 0x80 : 0x20;
+
+	uint32 bytesPerRow = align_up(width, 32);
+	uint32 lumaSize = align_up(bytesPerRow * align_up(height, 32), 64 * 1024);
+	uint32 chromaSize = align_up(lumaSize / 2, 64 * 1024);
+	uint32 mvSize = align_up(fHevcCtbColumns * fHevcCtbRows * fHevcMvUnit,
+		64 * 1024);
+	size_t frameSize = lumaSize + chromaSize + mvSize;
+
+	_FreeH264Frames();
+	for (uint32 i = 0; i < kHevcFrames; i++) {
+		char name[32];
+		snprintf(name, sizeof(name), "meson_vdec frame %" B_PRIu32, i);
+		status_t status = _AllocateBuffer(name, frameSize, fFrameBuffers[i],
+			true);
+		if (status != B_OK) {
+			_FreeH264Frames();
+			return status;
+		}
+	}
+	fFrameBuffersAllocated = kHevcFrames;
+	fFrameSize = frameSize;
+	fHevcMvOffset = lumaSize + chromaSize;
+
+	// the display size: the conformance window is in chroma samples
+	uint32 cropX = 0;
+	uint32 cropY = 0;
+	if (_Rpm(RPM_CONFORMANCE) != 0) {
+		cropX = 2 * (_Rpm(RPM_CONF_LEFT) + _Rpm(RPM_CONF_RIGHT));
+		cropY = 2 * (_Rpm(RPM_CONF_TOP) + _Rpm(RPM_CONF_BOTTOM));
+	}
+	{
+		InterruptsSpinLocker locker(fStateLock);
+		fFrameCount = kHevcFrames;
+		fWidth = width > cropX ? width - cropX : width;
+		fHeight = height > cropY ? height - cropY : height;
+		fBytesPerRow = bytesPerRow;
+		fLumaSize = lumaSize;
+	}
+
+	// the reference table: Y in slot 2k, CbCr in 2k + 1; the slots of
+	// pictures that don't exist show the first one
+	_SetDos(HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 0);
+	for (uint32 slot = 0; slot < kHevcTableSlots; slot++) {
+		uint32 frame = slot / 2 < kHevcFrames ? slot / 2 : 0;
+		phys_addr_t address = fFrameBuffers[frame].physical
+			+ ((slot & 1) != 0 ? lumaSize : 0);
+		_SetDos(HEVCD_MPP_ANC2AXI_TBL_CMD_ADDR,
+			(uint32)address | (slot << 8) | 1);
+	}
+	_SetDos(HEVCD_MPP_ANC2AXI_TBL_CONF_ADDR, 1);
+	_SetDos(HEVCD_MPP_ANC_CANVAS_ACCCONFIG_ADDR, 1);
+	for (int32 i = 0; i < 32; i++)
+		_SetDos(HEVCD_MPP_ANC_CANVAS_DATA_ADDR, 0);
+	_SetDos(HEVCD_MPP_DECOMP_CTL1, 0x80000000);
+		// references as two NV12 planes, no compression
+
+	INFO("HEVC %" B_PRIu32 "x%" B_PRIu32 " (coded %" B_PRIu32 "x%" B_PRIu32
+		"), CTB %" B_PRIu32 ", %" B_PRIu32 "-bit: %" B_PRIu32 " frames of %"
+		B_PRIuSIZE " bytes\n", fWidth, fHeight, width, height, ctb,
+		(_Rpm(RPM_BIT_DEPTH) & 0xf) + 8, kHevcFrames, frameSize);
+	return B_OK;
+}
+
+
+/*!	The picture being decoded is complete: to the caller. */
+void
+MesonVdec::_FinishHevcPicture()
+{
+	if (fHevcPicture < 0)
+		return;
+	uint32 lcu = _Dos(HEVC_PARSER_LCU_START) & 0xffffff;
+	uint32 last = fHevcCtbColumns * fHevcCtbRows - 1;
+	_Trace('F', fHevcPicture, lcu, last);
+	if (lcu != last)
+		fBadPictures++;
+	InterruptsSpinLocker locker(fStateLock);
+	fLastReport = system_time();
+	_QueueFrame(fHevcPicture, lcu == last ? 0 : H264_STATUS_ERROR,
+		fHevcPictureOffset);
+	fHevcPicture = -1;
+}
+
+
+/*!	A free frame for a new picture: not with the caller, not waiting for
+	it. Intra pictures only so far: no references to keep.
+*/
+int32
+MesonVdec::_FreeHevcFrame()
+{
+	InterruptsSpinLocker locker(fStateLock);
+	uint32 busy = fHeld;
+	for (uint32 i = 0; i < fQueueCount; i++)
+		busy |= 1u << fQueue[(fQueueHead + i) % kMaxFrames];
+	for (uint32 i = 0; i < fFrameCount; i++) {
+		if ((busy & (1u << i)) == 0)
+			return i;
+	}
+	return -1;
+}
+
+
+/*!	Status 8: a slice segment header was parsed. Programs the slice's
+	decoding (intra slices) or skips it. Returns false if it must wait for
+	a free frame.
+*/
+bool
+MesonVdec::_HevcSlice()
+{
+	flush_cache_range(fWorkspace.physical + kWorkRpm, sizeof(fRpm));
+	memcpy(fRpm, fWorkspace.address + kWorkRpm, sizeof(fRpm));
+	uint32 sliceType = _Rpm(RPM_SLICE_TYPE);
+	uint32 address = _Rpm(RPM_SLICE_ADDRESS);
+	bool newPicture = address == 0;
+	uint32 nalType = _Rpm(RPM_NAL_TYPE);
+	fHevcReports++;
+	_Trace('H', sliceType | (nalType << 8) | (address << 16),
+		_Rpm(RPM_WIDTH) | (_Rpm(RPM_HEIGHT) << 16), _Rpm(RPM_POC_LSB),
+		_Dos(HEVC_SHIFT_BYTE_COUNT));
+	if (fHevcReports == 1) {
+		INFO("HEVC slice: type %" B_PRIu32 ", NAL %" B_PRIu32 ", address %"
+			B_PRIu32 ", %" B_PRIu32 "x%" B_PRIu32 ", CTB log2 %" B_PRIu32
+			"+3+%" B_PRIu32 ", POC lsb %" B_PRIu32 ", first %" B_PRIu32
+			", bit depth %#" B_PRIx32 ", chroma %" B_PRIu32 ", conformance %"
+			B_PRIu32 " (%" B_PRIu32 " %" B_PRIu32 " %" B_PRIu32 " %" B_PRIu32
+			"), byte count %" B_PRIu32 "\n", sliceType, nalType, address,
+			_Rpm(RPM_WIDTH), _Rpm(RPM_HEIGHT), _Rpm(RPM_LOG2_MIN_CB),
+			_Rpm(RPM_LOG2_DIFF_CB), _Rpm(RPM_POC_LSB), _Rpm(RPM_FIRST_SLICE),
+			_Rpm(RPM_BIT_DEPTH), _Rpm(RPM_CHROMA_FORMAT),
+			_Rpm(RPM_CONFORMANCE), _Rpm(RPM_CONF_LEFT), _Rpm(RPM_CONF_RIGHT),
+			_Rpm(RPM_CONF_TOP), _Rpm(RPM_CONF_BOTTOM),
+			_Dos(HEVC_SHIFT_BYTE_COUNT));
+	}
+
+	if (newPicture)
+		_FinishHevcPicture();
+
+	if (fFrameCount == 0 && newPicture && _SetupHevcFrames() != B_OK) {
+		fFatal = true;
+		release_sem_etc(fFrameSem, 1, 0);
+		return true;
+	}
+	bool decode = fFrameCount > 0 && sliceType == 2
+		&& _Rpm(RPM_BIT_DEPTH) == 0 && (newPicture || fHevcPicture >= 0);
+	if (decode && newPicture) {
+		int32 frame = _FreeHevcFrame();
+		if (frame < 0)
+			return false;
+		fHevcPicture = frame;
+		fHevcPictureOffset = _Dos(HEVC_SHIFT_BYTE_COUNT);
+	}
+	if (!decode) {
+		fHevcSkipped++;
+		_SetDos(HEVC_WAIT_FLAG, _Dos(HEVC_WAIT_FLAG) & ~2u);
+		_SetDos(HEVC_DEC_STATUS_REG, HEVC_STATUS_DONE);
+		_SetDos(HEVC_MCPU_INTR_REQ, 4);
+		return true;
+	}
+
+	uint32 width = fHevcCodedWidth;
+	uint32 height = fHevcCodedHeight;
+	uint32 log2Ctb = fHevcLog2Ctb;
+	uint32 ctbCount = fHevcCtbColumns * fHevcCtbRows;
+	phys_addr_t frame = fFrameBuffers[fHevcPicture].physical;
+	phys_addr_t luma = frame;
+	phys_addr_t chroma = frame + fLumaSize;
+	phys_addr_t mv = frame + fHevcMvOffset;
+	bool dependent = _Rpm(RPM_DEPENDENT_SLICE) != 0;
+
+	// no references: no reference lists, no reference cache
+	_SetDos(HEVCD_MCRCC_CTL1, 0);
+
+	// motion prediction, intra slices included (the MVs are written)
+	(void)_Dos(HEVC_MPRED_CURR_LCU);
+	_SetDos(HEVC_MPRED_MV_WR_START_ADDR, mv);
+	_SetDos(HEVC_MPRED_MV_RD_START_ADDR, mv);
+	if (newPicture) {
+		_SetDos(HEVC_MPRED_ABV_START_ADDR,
+			fWorkspace.physical + kWorkMpredAbove);
+		_SetDos(HEVC_MPRED_MV_WPTR, mv);
+		_SetDos(HEVC_MPRED_MV_RPTR, mv);
+	} else if (!dependent)
+		_SetDos(HEVC_MPRED_MV_RPTR, mv + address * fHevcMvUnit);
+	_SetDos(HEVC_MPRED_MV_RD_END_ADDR, mv + ctbCount * fHevcMvUnit);
+	_SetDos(HEVC_MPRED_MV_WR_ROW_JUMP, 0);
+	_SetDos(HEVC_MPRED_MV_RD_ROW_JUMP, 0);
+	_SetDos(HEVC_MPRED_TILE_START, 0);
+	_SetDos(HEVC_MPRED_TILE_SIZE_LCU,
+		fHevcCtbColumns | (fHevcCtbRows << 16));
+	_SetDos(HEVC_MPRED_PIC_SIZE, width | (height << 16));
+	_SetDos(HEVC_MPRED_PIC_SIZE_LCU,
+		(fHevcCtbColumns - 1) | ((fHevcCtbRows - 1) << 16));
+	_SetDos(HEVC_MPRED_REF_NUM, 0);
+	_SetDos(HEVC_MPRED_REF_EN_L0, 0);
+	_SetDos(HEVC_MPRED_REF_EN_L1, 0);
+	bool idr = nalType == 19 || nalType == 20;
+	_SetDos(HEVC_MPRED_CUR_POC, idr ? 0 : _Rpm(RPM_POC_LSB));
+	_SetDos(HEVC_MPRED_COL_POC, 0x80000000);
+	for (int32 i = 0; i < 16; i++) {
+		_SetDos(HEVC_MPRED_L0_REF00_POC + 4 * i, 0);
+		_SetDos(HEVC_MPRED_L1_REF00_POC + 4 * i, 0);
+	}
+	_SetDos(HEVC_MPRED_CTRL0, 2 | (newPicture ? (1 << 2) | (1 << 3) : 0)
+		| (dependent ? 1 << 4 : 0) | ((_Rpm(RPM_TMVP) & 1) << 5) | (1 << 6)
+		| ((_Rpm(RPM_COL_FROM_L0) & 1) << 7) | (1 << 9) | (1 << 10)
+		| (1 << 13) | (log2Ctb << 16) | (3 << 20)
+		| ((_Rpm(RPM_PARALLEL_MERGE) & 0xf) << 24));
+	_SetDos(HEVC_MPRED_CTRL1, ((5 - _Rpm(RPM_FIVE_MINUS_MERGE)) & 0xf)
+		| (2 << 4) | (3 << 8) | (5 << 12) | (36 << 16));
+
+	// SAO, deblocking and where the picture goes
+	uint32 misc = _Rpm(RPM_MISC_FLAG0);
+	_SetDos(HEVC_SAO_CTRL0, (_Dos(HEVC_SAO_CTRL0) & ~0xfu) | log2Ctb);
+	_SetDos(HEVC_SAO_PIC_SIZE, width | (height << 16));
+	_SetDos(HEVC_SAO_PIC_SIZE_LCU,
+		(fHevcCtbColumns - 1) | ((fHevcCtbRows - 1) << 16));
+	_SetDos(HEVC_SAO_Y_START_ADDR, luma);
+	_SetDos(HEVC_SAO_Y_WPTR, luma);
+	_SetDos(HEVC_SAO_C_START_ADDR, chroma);
+	_SetDos(HEVC_SAO_C_WPTR, chroma);
+	_SetDos(HEVC_SAO_Y_LENGTH, fLumaSize);
+	_SetDos(HEVC_SAO_C_LENGTH, fLumaSize / 2);
+	if (newPicture) {
+		_SetDos(HEVC_DBLK_CFG2, width | (height << 16));
+		uint32 cfg1 = ((_Rpm(RPM_PPS_CB_QP) & 0x1f) << 4)
+			| ((_Rpm(RPM_PPS_CR_QP) & 0x1f) << 9)
+			| (log2Ctb == 6 ? 0 : log2Ctb == 5 ? 1 : 2);
+		if ((misc & MISC_PCM_ENABLED) != 0
+			&& (misc & MISC_PCM_LOOP_FILTER_DISABLED) != 0) {
+			cfg1 |= 1 << 3;
+		}
+		_SetDos(HEVC_DBLK_CFG1, cfg1);
+	}
+	_SetDos(HEVC_SAO_CTRL1, (_Dos(HEVC_SAO_CTRL1) & ~0x3ff3u) | 0xff0 | 1);
+		// NV12 byte order; no compressed copy
+	_SetDos(HEVC_SAO_CTRL5, _Dos(HEVC_SAO_CTRL5) & ~(0xffu << 16));
+	_SetDos(HEVCD_IPP_AXIIF_CONFIG, (_Dos(HEVCD_IPP_AXIIF_CONFIG) & ~0x30u)
+		| 0xf);
+
+	bool slice = (misc & MISC_DEBLOCK_OVERRIDE_ENABLED) != 0
+		&& (misc & MISC_DEBLOCK_OVERRIDE) != 0;
+	bool deblockOff = slice ? (misc & MISC_SLICE_DEBLOCK_DISABLED) != 0
+		: (misc & MISC_PPS_DEBLOCK_DISABLED) != 0;
+	uint32 cfg9 = deblockOff ? 1 << 2 : 0;
+	if (!deblockOff) {
+		uint32 beta = _Rpm(slice ? RPM_SLICE_BETA : RPM_PPS_BETA);
+		uint32 tc = _Rpm(slice ? RPM_SLICE_TC : RPM_PPS_TC);
+		cfg9 |= ((beta & 0xf) << 3) | ((tc & 0xf) << 7);
+	}
+	bool across = (misc & MISC_PPS_ACROSS_SLICES) != 0;
+	if (across && ((misc & (MISC_SAO_LUMA | MISC_SAO_CHROMA)) != 0
+			|| !deblockOff)) {
+		across = (misc & MISC_SLICE_ACROSS_SLICES) != 0;
+	}
+	if (across)
+		cfg9 |= 1 << 1;
+	_SetDos(HEVC_DBLK_CFG9, cfg9);
+	_SetDos(HEVC_SAO_CTRL0, (_Dos(HEVC_SAO_CTRL0) & ~(3u << 8))
+		| (across ? 1 << 9 : 0));
+
+	uint32 saoUnit = (log2Ctb == 4 ? 9 : log2Ctb == 5 ? 14 : 24) << 4;
+	_SetDos(HEVC_SAO_MEM_UNIT, saoUnit);
+	_SetDos(HEVC_SAO_ABV, fWorkspace.physical + kWorkSaoAbove);
+	_SetDos(HEVC_SAO_VB_SIZE, (saoUnit + 0x20) * fHevcCtbRows);
+	_SetDos(HEVC_SAO_VB, fWorkspace.physical + kWorkSaoVb);
+
+	if (!fHevcVendor)
+		_SetDos(HEVC_DECODE_SIZE, 0);
+	fHevcSlices++;
+	asm volatile("dsb sy" : : : "memory");
+	_SetDos(HEVC_WAIT_FLAG, _Dos(HEVC_WAIT_FLAG) | 2);
+	_SetDos(HEVC_DEC_STATUS_REG, HEVC_STATUS_DECODE_SLICE);
+	_SetDos(HEVC_MCPU_INTR_REQ, 4);
+	return true;
+}
+
+
+/*!	Looks at the HEVC firmware's status and answers it. Called by the
+	waits, without fStateLock (it may allocate the frames).
+*/
+void
+MesonVdec::_PollHevc()
+{
+	if (!fRunning || fFatal || fHevcEnded)
+		return;
+	uint32 status = _Dos(HEVC_DEC_STATUS_REG) & 0xff;
+	bigtime_t now = system_time();
+	if (status != fHevcLastStatus) {
+		fHevcLastStatus = status;
+		fHevcLastChange = now;
+	}
+
+	switch (status) {
+		case HEVC_STATUS_SLICE_HEADER:
+			if (_HevcSlice())
+				fHevcLastStatus = 0;
+			return;
+
+		case HEVC_STATUS_NAL_FOUND:
+		case HEVC_STATUS_SEARCH_EMPTY:
+		case HEVC_STATUS_PICTURE_DONE:
+			// it looks for the next picture: the last one is complete; at
+			// the end of the stream, that was all
+			_Trace('E', status, _Dos(HEVC_DECODE_MODE),
+				_Dos(HEVC_SHIFT_BYTE_COUNT));
+			if (status == HEVC_STATUS_NAL_FOUND
+				|| (fEndOfStream && status == HEVC_STATUS_SEARCH_EMPTY)) {
+				_FinishHevcPicture();
+				if (fEndOfStream)
+					fHevcEnded = true;
+			}
+			if (status != HEVC_STATUS_SEARCH_EMPTY) {
+				_SetDos(HEVC_WAIT_FLAG, _Dos(HEVC_WAIT_FLAG) & ~2u);
+				_SetDos(HEVC_DEC_STATUS_REG, HEVC_STATUS_DONE);
+				_SetDos(HEVC_MCPU_INTR_REQ, 4);
+				fHevcLastStatus = 0;
+			}
+			return;
+
+		case HEVC_STATUS_PICTURE_ERROR:
+			fDecodeErrors++;
+			return;
+	}
+
+	// at the end of the stream, a quiet firmware that reached the last
+	// CTB has decoded all
+	if (fEndOfStream && now - fHevcLastChange > 100000) {
+		_Trace('Q', status, _Dos(HEVC_PARSER_LCU_START),
+			_Dos(HEVC_SHIFT_BYTE_COUNT));
+		_FinishHevcPicture();
+		fHevcEnded = true;
+	}
+}
+
+
+status_t
+MesonVdec::_EndOfStreamHevc()
+{
+	memset(fInput.address, 0, kMinimumFetch);
+	memcpy(fInput.address, kHevcEndOfStream, sizeof(kHevcEndOfStream));
+	{
+		InterruptsSpinLocker locker(fStateLock);
+		fEndOffset = fStreamBytes;
+		fEndOfStream = true;
+	}
+	fHevcLastChange = system_time();
+	return _Submit(kMinimumFetch, true);
+}
+
+
+void
+MesonVdec::_DumpHevc()
+{
+	kprintf("  HEVC: status %#" B_PRIx32 ", wait %#" B_PRIx32 ", byte count %"
+		B_PRIu32 ", LCU %#" B_PRIx32 ", stream level %" B_PRIu32 ", RD %#"
+		B_PRIx32 ", WR %#" B_PRIx32 ", MPSR %#" B_PRIx32 "; %" B_PRIu32
+		" reports, %" B_PRIu32 " slices decoded, %" B_PRIu32 " skipped\n",
+		_Dos(HEVC_DEC_STATUS_REG), _Dos(HEVC_WAIT_FLAG),
+		_Dos(HEVC_SHIFT_BYTE_COUNT), _Dos(HEVC_PARSER_LCU_START),
+		_Dos(HEVC_STREAM_LEVEL), _Dos(HEVC_STREAM_RD_PTR),
+		_Dos(HEVC_STREAM_WR_PTR), _Dos(HEVC_MPSR), fHevcReports, fHevcSlices,
+		fHevcSkipped);
+}
+
+
+uint32
+MesonVdec::_StreamLevel()
+{
+	return _IsHevc() ? _Dos(HEVC_STREAM_LEVEL) : _Dos(VLD_MEM_VIFIFO_LEVEL);
+}
