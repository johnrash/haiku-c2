+									const void* userFirmware);
+			void				_PowerUpHevc();
+			void				_PowerDownHevc();
+			void				_StopHevcProcessor();
+			void				_StartHevcCodec();
+			void				_InitHevcParser();
+			void				_PollHevc();
+			bool				_HevcSlice();
+			status_t			_SetupHevcFrames();
+			void				_FinishHevcPicture();
+			int32				_FreeHevcFrame();
+			status_t			_EndOfStreamHevc();
+			uint32				_Rpm(uint32 index) const;
+			void				_DumpHevc();
+			uint32				_StreamLevel();
+			void				_InitParser();
+			void				_WriteCanvas(uint32 index,
+									phys_addr_t address, uint32 bytesPerRow,
+									uint32 height);
+
+			status_t			_AllocateBuffer(const char* name, size_t size,
+									dma_buffer& buffer, bool userReadable);
+			void				_FreeBuffer(dma_buffer& buffer);
+
+			uint32				_Dos(uint32 offset)
+									{ return fDos[offset / 4]; }
+			void				_SetDos(uint32 offset, uint32 value)
+									{ fDos[offset / 4] = value; }
+			uint32				_Parser(uint32 offset)
+									{ return fParser[offset / 4]; }
+			void				_SetParser(uint32 offset, uint32 value)
+									{ fParser[offset / 4] = value; }
+
+private:
+			device_node*		fNode;
+			area_id				fDosArea;
+			area_id				fParserArea;
+			area_id				fAoArea;
+			area_id				fHhiArea;
+			area_id				fResetArea;
+			volatile uint32*	fDos;
+			volatile uint32*	fParser;
+			volatile uint32*	fAo;
+			volatile uint32*	fHhi;
+			volatile uint32*	fReset;
+			int32				fVdecIrq;
+			int32				fParserIrq;
+
+			mutex				fLock;
+				// one session, its calls one at a time (but GET_FRAME)
+			spinlock			fStateLock;
+				// the frame queue, the interrupt handlers
+			bool				fOpen;
+			bool				fRunning;
+			bool				fEndOfStream;
+			bool				fWarmedUp;
+
+			dma_buffer			fFirmware;
+			dma_buffer			fVififo;
+			dma_buffer			fWorkspace;
+			dma_buffer			fInput;
+			dma_buffer			fFrames;
+			uint32				fCodec;
+			uint32				fWidth;
+			uint32				fHeight;
+			uint32				fBytesPerRow;
+			uint32				fLumaSize;
+			size_t				fFrameSize;
+			uint32				fFrameCount;
+			uint32				fStreamBytes;
+				// written to the VIFIFO this session: the offsets the
+				// H.264 firmware gives its frames count from its start
+			uint32				fEndOffset;
+
+			// H.264: the extension of the firmware, the firmware's own
+			// memory, and the frames (one area each) and their motion
+			// vectors, which the firmware asks for
+			dma_buffer			fExtension;
+			dma_buffer			fSei;
+			dma_buffer			fMotionVectors;
+			dma_buffer			fFrameBuffers[kMaxFrames];
+			uint32				fFrameBuffersAllocated;
+			thread_id			fSetupThread;
+			sem_id				fSetupSem;
+			bool				fSetupPending;
+				// its command 1 waits for the setup thread
+			bool				fEndReached;
+				// the command 1 is the end of the stream's picture's: the
+				// firmware put out all frames before and stopped
+			uint32				fSetupInfo[4];
+				// AV_SCRATCH_1, 2, 3 and 6 of the command
+			uint32				fLastSetupInfo;
+
+			// HEVC
+			bool				fHevcVendor;
+			dma_buffer			fAux;
+			uint16				fRpm[128];
+			int32				fHevcPicture;
+				// the frame being decoded, or -1
+			uint32				fHevcPictureOffset;
+			uint32				fHevcCodedWidth;
+			uint32				fHevcCodedHeight;
+			uint32				fHevcLog2Ctb;
+			uint32				fHevcCtbColumns;
+			uint32				fHevcCtbRows;
+			uint32				fHevcMvUnit;
+			size_t				fHevcMvOffset;
+			bool				fHevcEnded;
+			uint32				fHevcLastStatus;
+			bigtime_t			fHevcLastChange;
+			uint32				fHevcReports;
+			uint32				fHevcSlices;
+			uint32				fHevcSkipped;
+			uint32				fDecodeErrors;
+			uint32				fBadPictures;
+
+			sem_id				fFrameSem;
+			sem_id				fParserSem;
+			uint32				fQueue[kMaxFrames];
+			uint32				fQueueInfo[kMaxFrames];
+			uint32				fQueueOffset[kMaxFrames];
+			uint32				fQueueHead;
+			uint32				fQueueCount;
+			uint32				fHeld;
+				// bit per frame: with the caller
+			uint32				fBack[kMaxFrames];
+			uint32				fBackHead;
+			uint32				fBackCount;
+				// H.264: frames given back, for the firmware's two places
+			bigtime_t			fLastReport;
+			bool				fFatal;
+
+			// the last events, for finding what the firmware does
+			struct trace_entry {
+				bigtime_t		time;
+				char			what;	// 'R'eport, 'B'ack, 'S'ubmit, 'E'nd
+				uint32			a, b, c, d;
+			};
+	static	const uint32		kTraceSize = 64;
+			trace_entry			fTrace[kTraceSize];
+			uint32				fTraceCount;
+			void				_Trace(char what, uint32 a, uint32 b = 0,
+									uint32 c = 0, uint32 d = 0);
+			void				_DumpTrace(bool debugger);
+
+			// counters, for the KDL command
+			uint32				fVdecInterrupts;
+			uint32				fParserInterrupts;
+			uint32				fFramesDecoded;
+			uint32				fFramesSkipped;
+			uint32				fSubmitted;
+			uint32				fParserTimeouts;
+};
