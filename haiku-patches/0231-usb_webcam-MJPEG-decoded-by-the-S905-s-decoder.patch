+/*!	The S905's decoder for the MJPEG frames (meson_vdec, with
+	linux-firmware's gxl_mjpeg.bin from the meson_vdec_firmware package),
+	if it can be had: it does one session at a time (a video player may
+	have it), and the firmware may not be installed. libjpeg-turbo decodes
+	them then.
+*/
+status_t
+UVCCamDevice::_StartHardwareDecoder()
+{
+#ifdef HARDWARE_MJPEG
+	BStringList paths;
+	if (BPathFinder::FindPaths(B_FIND_PATH_DATA_DIRECTORY,
+			kMjpegFirmwarePath, B_FIND_PATH_EXISTING_ONLY, paths) != B_OK
+		|| paths.IsEmpty()) {
+		return B_ENTRY_NOT_FOUND;
+	}
+	BFile file(paths.StringAt(0), B_READ_ONLY);
+	off_t size;
+	if (file.InitCheck() != B_OK || file.GetSize(&size) != B_OK || size <= 0
+		|| size > 64 * 1024) {
+		return B_BAD_DATA;
+	}
+	uint8* firmware = (uint8*)malloc(size);
+	if (firmware == NULL)
+		return B_NO_MEMORY;
+	if (file.Read(firmware, size) != size) {
+		free(firmware);
+		return B_IO_ERROR;
+	}
+
+	int device = open(MESON_VDEC_DEVICE, O_RDWR);
+	if (device < 0) {
+		free(firmware);
+		return errno;
+	}
+	meson_vdec_start start = {};
+	start.codec = MESON_VDEC_MJPEG;
+	start.firmware = firmware;
+	start.firmware_size = size;
+	start.width = fStreamWidth;
+	start.height = fStreamHeight;
+	status_t status = ioctl(device, MESON_VDEC_START, &start, sizeof(start))
+		== 0 ? B_OK : errno;
+	free(firmware);
+	if (status == B_OK) {
+		fHardwareFrames = clone_area("UVC MJPEG frames",
+			(void**)&fHardwareFramesBase, B_ANY_ADDRESS, B_READ_AREA,
+			start.frames);
+		if (fHardwareFrames < 0)
+			status = fHardwareFrames;
+	}
+	if (status != B_OK) {
+		// closing ends the session
+		close(device);
+		fHardwareFrames = -1;
+		return status;
+	}
+	fHardwareDecoder = device;
+	printf("UVCCamDevice: %" B_PRId32 "x%" B_PRId32 " MJPEG decoded by the "
+		"S905's decoder\n", fStreamWidth, fStreamHeight);
+	return B_OK;
+#else
+	return B_NOT_SUPPORTED;
+#endif
+}
+
+
+void
+UVCCamDevice::_StopHardwareDecoder()
+{
+#ifdef HARDWARE_MJPEG
+	if (fHardwareDecoder < 0)
+		return;
+	ioctl(fHardwareDecoder, MESON_VDEC_STOP, NULL, 0);
+	if (fHardwareFrames >= 0)
+		delete_area(fHardwareFrames);
+	fHardwareFrames = -1;
+	fHardwareFramesBase = NULL;
+	close(fHardwareDecoder);
+	fHardwareDecoder = -1;
+#endif
+}
+
+
+/*static*/ status_t
+UVCCamDevice::_HardwareDecoderEntry(void* data)
+{
+	return ((UVCCamDevice*)data)->_HardwareDecoderThread();
+}
