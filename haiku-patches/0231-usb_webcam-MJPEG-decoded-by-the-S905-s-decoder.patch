+/*!	Decoder \a index's buffer becomes the ready one, unless a newer frame
+	got there first.
+*/
+void
+UVCCamDevice::_PublishDecoded(int32 index, int32 sequence, bigtime_t stamp)
+{
+	fDecodeLock.Lock();
+	bool wake = false;
+	if (sequence > fNewestDecoded) {
+		fNewestDecoded = sequence;
+		uint8* swap = fReadyBuffer;
+		fReadyBuffer = fDecodeBuffers[index];
+		fDecodeBuffers[index] = swap;
+		fReadyStamp = stamp;
+		wake = !fReadyPending;
+		fReadyPending = true;
+	}
+	fDecodeLock.Unlock();
+	if (wake)
+		release_sem(fDecodedSem);
+}
