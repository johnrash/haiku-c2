index 0000000000..59f3119d51
--- /dev/null
+++ b/src/add-ons/media/media-add-ons/usb_webcam/addons/uvc/i420_neon.c
@@ -0,0 +1,130 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "i420_neon.h"
+
+// The build includes GCC's headers like its own, with -Werror.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wsign-compare"
+#pragma GCC diagnostic ignored "-Wmissing-braces"
+#include <arm_neon.h>
+#pragma GCC diagnostic pop
+
+
+// JPEG's YCbCr (BT.601, full range), in 8.8 fixed point
+#define RED_CR		359		// 1.402
+#define GREEN_CB	-88		// -0.344136
+#define GREEN_CR	-183	// -0.714136
+#define BLUE_CB		454		// 1.772
+
+
+static inline uint8_t
+clamp(int32_t value)
+{
+	return value < 0 ? 0 : value > 255 ? 255 : (uint8_t)value;
+}
+
+
+static void
+convert_pixel(uint8_t* out, int32_t y, int32_t red, int32_t green,
+	int32_t blue)
+{
+	y <<= 8;
+	out[0] = clamp((y + blue) >> 8);
+	out[1] = clamp((y + green) >> 8);
+	out[2] = clamp((y + red) >> 8);
+	out[3] = 255;
+}
+
+
+/*!	A row pair (or the last row) of planar 4:2:0 YCbCr to B_RGB32 (B G R A
+	in memory), 16 pixels at a time.
+*/
+static void
+convert_rows(uint8_t* out0, uint8_t* out1, const uint8_t* luma0,
+	const uint8_t* luma1, const uint8_t* cb, const uint8_t* cr,
+	uint32_t width)
+{
+	const int16x8_t kChromaBias = vdupq_n_s16(128);
+	const int32x4_t kRound = vdupq_n_s32(128);
+	uint32_t x = 0;
+	for (; x + 16 <= width; x += 16) {
+		int16x8_t u = vsubq_s16(vreinterpretq_s16_u16(
+			vmovl_u8(vld1_u8(cb + x / 2))), kChromaBias);
+		int16x8_t v = vsubq_s16(vreinterpretq_s16_u16(
+			vmovl_u8(vld1_u8(cr + x / 2))), kChromaBias);
+		int32x4_t redLow = vmlal_n_s16(kRound, vget_low_s16(v), RED_CR);
+		int32x4_t redHigh = vmlal_n_s16(kRound, vget_high_s16(v), RED_CR);
+		int32x4_t greenLow = vmlal_n_s16(vmlal_n_s16(kRound,
+			vget_low_s16(u), GREEN_CB), vget_low_s16(v), GREEN_CR);
+		int32x4_t greenHigh = vmlal_n_s16(vmlal_n_s16(kRound,
+			vget_high_s16(u), GREEN_CB), vget_high_s16(v), GREEN_CR);
+		int32x4_t blueLow = vmlal_n_s16(kRound, vget_low_s16(u), BLUE_CB);
+		int32x4_t blueHigh = vmlal_n_s16(kRound, vget_high_s16(u), BLUE_CB);
+
+		for (int row = 0; row < 2; row++) {
+			const uint8_t* luma = row == 0 ? luma0 : luma1;
+			uint8_t* out = row == 0 ? out0 : out1;
+			if (luma == NULL)
+				break;
+			// even and odd pixels, which share a chroma sample
+			uint8x8x2_t pixels = vld2_u8(luma + x);
+			uint8x8_t red[2], green[2], blue[2];
+			for (int k = 0; k < 2; k++) {
+				int16x8_t y = vreinterpretq_s16_u16(vmovl_u8(pixels.val[k]));
+				int32x4_t yLow = vshll_n_s16(vget_low_s16(y), 8);
+				int32x4_t yHigh = vshll_n_s16(vget_high_s16(y), 8);
+				red[k] = vqmovun_s16(vcombine_s16(
+					vshrn_n_s32(vaddq_s32(yLow, redLow), 8),
+					vshrn_n_s32(vaddq_s32(yHigh, redHigh), 8)));
+				green[k] = vqmovun_s16(vcombine_s16(
+					vshrn_n_s32(vaddq_s32(yLow, greenLow), 8),
+					vshrn_n_s32(vaddq_s32(yHigh, greenHigh), 8)));
+				blue[k] = vqmovun_s16(vcombine_s16(
+					vshrn_n_s32(vaddq_s32(yLow, blueLow), 8),
+					vshrn_n_s32(vaddq_s32(yHigh, blueHigh), 8)));
+			}
+			uint8x8x2_t r = vzip_u8(red[0], red[1]);
+			uint8x8x2_t g = vzip_u8(green[0], green[1]);
+			uint8x8x2_t b = vzip_u8(blue[0], blue[1]);
+			uint8x16x4_t result;
+			result.val[0] = vcombine_u8(b.val[0], b.val[1]);
+			result.val[1] = vcombine_u8(g.val[0], g.val[1]);
+			result.val[2] = vcombine_u8(r.val[0], r.val[1]);
+			result.val[3] = vdupq_n_u8(255);
+			vst4q_u8(out + x * 4, result);
+		}
+	}
+
+	for (; x < width; x++) {
+		int32_t u = cb[x / 2] - 128;
+		int32_t v = cr[x / 2] - 128;
+		int32_t red = 128 + RED_CR * v;
+		int32_t green = 128 + GREEN_CB * u + GREEN_CR * v;
+		int32_t blue = 128 + BLUE_CB * u;
+		convert_pixel(out0 + x * 4, luma0[x], red, green, blue);
+		if (luma1 != NULL)
+			convert_pixel(out1 + x * 4, luma1[x], red, green, blue);
+	}
+}
+
+
+void
+i420_to_rgb32_neon(uint8_t* destination, size_t destinationBytesPerRow,
+	const uint8_t* luma, size_t lumaBytesPerRow, const uint8_t* cb,
+	const uint8_t* cr, size_t chromaBytesPerRow, uint32_t width,
+	uint32_t height)
+{
+	for (uint32_t y = 0; y < height; y += 2) {
+		bool pair = y + 1 < height;
+		convert_rows(destination + y * destinationBytesPerRow,
+			pair ? destination + (y + 1) * destinationBytesPerRow : NULL,
+			luma + y * lumaBytesPerRow,
+			pair ? luma + (y + 1) * lumaBytesPerRow : NULL,
+			cb + (y / 2) * chromaBytesPerRow, cr + (y / 2) * chromaBytesPerRow,
+			width);
+	}
+}
