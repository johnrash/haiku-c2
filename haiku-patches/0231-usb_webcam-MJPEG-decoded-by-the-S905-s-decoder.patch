+
+/*!	Whether \a data is a whole JPEG picture of the stream's size: from SOI to
+	EOI. A picture cut short (its end lost with an isochronous packet) would
+	make the S905's decoder decode the next one into it, and lose that.
+*/
+bool
+UVCCamDevice::_IsWholePicture(const uint8* data, size_t length) const
+{
+	if (length < 4 || data[0] != 0xff || data[1] != 0xd8)
+		return false;
+	// the end, perhaps followed by padding
+	bool ended = false;
+	for (size_t i = length - 2; i + 32 >= length && i > 2; i--) {
+		if (data[i] == 0xff && data[i + 1] == 0xd9) {
+			ended = true;
+			break;
+		}
+	}
+	if (!ended)
+		return false;
+
+	size_t position = 2;
+	while (position + 9 < length && data[position] == 0xff) {
+		uint8 marker = data[position + 1];
+		size_t segment = (data[position + 2] << 8) | data[position + 3];
+		if (marker == 0xc0 || marker == 0xc1) {
+			int32 height = (data[position + 5] << 8) | data[position + 6];
+			int32 width = (data[position + 7] << 8) | data[position + 8];
+			return width == fStreamWidth && height == fStreamHeight;
+		}
+		if (marker == 0xda)
+			break;
+		position += 2 + segment;
+	}
+	return false;
+}
+
+
+/*!	The decoder thread with the S905's decoder: each whole picture goes to
+	it, and while it decodes one, the frame of the one before becomes
+	B_RGB32 (NEON) in the first decoder buffer: about 21 and 10 ms a
+	1920x1080 frame, which keeps up with 30 frames a second without a core
+	(libjpeg-turbo took two).
+*/
+status_t
+UVCCamDevice::_HardwareDecoderThread()
+{
+#ifdef HARDWARE_MJPEG
+	meson_vdec_frame previous;
+	bool havePrevious = false;
+	int32 previousSequence = 0;
+	bigtime_t previousStamp = 0;
+	while (fDecoding) {
+		CamFrame* frame = NULL;
+		bigtime_t stamp = 0;
+		int32 sequence = 0;
+		if (fDeframer->WaitFrame(100000) == B_OK) {
+			fDecodeLock.Lock();
+			if (fDeframer->GetFrame(&frame, &stamp) != B_OK)
+				frame = NULL;
+			sequence = ++fFramesTaken;
+			fDecodeLock.Unlock();
+		}
+
+		bool written = false;
+		if (frame != NULL) {
+			const uint8* data = (const uint8*)frame->Buffer();
+			size_t length = frame->BufferLength();
+			if (_IsWholePicture(data, length)) {
+				meson_vdec_write write = {};
+				write.data = data;
+				write.size = length;
+				written = ioctl(fHardwareDecoder, MESON_VDEC_WRITE, &write,
+					sizeof(write)) == 0;
+			}
+			delete frame;
+		}
+
+		// the frame before, while the decoder decodes this one
+		if (havePrevious) {
+			const uint8* base = fHardwareFramesBase + previous.offset;
+			i420_to_rgb32_neon(fDecodeBuffers[0], fStreamWidth * 4, base,
+				previous.bytes_per_row, base + previous.chroma_offset,
+				base + previous.cr_offset, previous.bytes_per_row / 2,
+				fStreamWidth, fStreamHeight);
+			uint32 index = previous.index;
+			ioctl(fHardwareDecoder, MESON_VDEC_RECYCLE_FRAME, &index,
+				sizeof(index));
+			havePrevious = false;
+			_PublishDecoded(0, previousSequence, previousStamp);
+		}
+		if (!written)
+			continue;
+
+		// its frame, and any that came late before it (the newest counts)
+		meson_vdec_frame decoded = {};
+		decoded.timeout = 200000;
+		while (ioctl(fHardwareDecoder, MESON_VDEC_GET_FRAME, &decoded,
+				sizeof(decoded)) == 0) {
+			if ((decoded.flags & (MESON_VDEC_FRAME_END_OF_STREAM
+					| MESON_VDEC_FRAME_GIVE_BACK)) != 0
+				|| decoded.cr_offset == 0) {
+				break;
+			}
+			if (havePrevious) {
+				uint32 index = previous.index;
+				ioctl(fHardwareDecoder, MESON_VDEC_RECYCLE_FRAME, &index,
+					sizeof(index));
+			}
+			previous = decoded;
+			havePrevious = true;
+			previousSequence = sequence;
+			previousStamp = stamp;
+			decoded.timeout = 0;
+		}
+	}
+	if (havePrevious) {
+		uint32 index = previous.index;
+		ioctl(fHardwareDecoder, MESON_VDEC_RECYCLE_FRAME, &index,
+			sizeof(index));
+	}
+	return B_OK;
+#else
+	return B_NOT_SUPPORTED;
+#endif
+}
