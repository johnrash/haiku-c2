+/*!	Display power management: anything but B_DPMS_ON stops the encoder and
+	switches the PHY's TMDS output off, so that the display sees no signal and
+	can go to sleep (what the screen saver's "Turn off screen" asks for).
+	B_DPMS_ON gives the PHY its setting back and programs the mode again, as
+	a mode switch does.
+*/
+status_t
+MesonHdmi::SetDpmsMode(uint32 mode)
+{
+	if (mode != B_DPMS_ON && mode != B_DPMS_STAND_BY
+		&& mode != B_DPMS_SUSPEND && mode != B_DPMS_OFF) {
+		return B_BAD_VALUE;
+	}
+
+	MutexLocker locker(fModeLock);
+	bool on = mode == B_DPMS_ON;
+	if (on == (fShared->dpms_mode == B_DPMS_ON)) {
+		fShared->dpms_mode = mode;
+		return B_OK;
+	}
+
+	if (!on) {
+		fPhyControl0 = _Hhi(HHI_HDMI_PHY_CNTL0);
+		_SetVpu(ENCP_VIDEO_EN, 0);
+		_SetHhi(HHI_HDMI_PHY_CNTL0, 0);
+		INFO("display off (DPMS %" B_PRIu32 ")\n", mode);
+	} else {
+		_SetHhi(HHI_HDMI_PHY_CNTL0, fPhyControl0);
+		if (fMode != NULL) {
+			status_t status = _ProgramMode(*fMode, fFrameBufferPhysical,
+				fShared->bytes_per_row);
+			if (status != B_OK)
+				return status;
+		} else {
+			// U-Boot's mode: everything but the encoder is still set
+			_ResetPhy();
+			_SetVpu(ENCP_VIDEO_EN, 1);
+		}
+		INFO("display on\n");
+	}
+	fShared->dpms_mode = mode;
+	return B_OK;
+}
+
+
 /*!	Puts U-Boot's registers and frame buffer back; works from KDL too. */
 void
 MesonHdmi::RestoreBootMode()
 {
 	if (!fBootStateSaved)
 		return;
+	fMode = NULL;
 	_SetVpu(VIU_OSD1_CTRL_STAT, _Vpu(VIU_OSD1_CTRL_STAT) & ~OSD_ENABLE);
 	_SetVpu(ENCP_VIDEO_EN, 0);
 	_SetHhi(HHI_HDMI_PLL_CNTL2, fBootPllCntl2);
@@ -1982,6 +2041,13 @@ device_control(void* cookie, uint32 op, void* buffer, size_t length)
 				return B_BAD_ADDRESS;
 			return device->ConfigureOverlay(config);
 		}
+		case MESON_HDMI_SET_DPMS_MODE:
+		{
+			uint32 mode;
+			if (user_memcpy(&mode, buffer, sizeof(mode)) != B_OK)
+				return B_BAD_ADDRESS;
+			return device->SetDpmsMode(mode);
+		}
 	}
 	return B_DEV_INVALID_IOCTL;
 }
