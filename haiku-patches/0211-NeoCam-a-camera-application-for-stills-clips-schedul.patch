+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef CAMERA_CONSUMER_H
+#define CAMERA_CONSUMER_H
+
+
+#include <BufferConsumer.h>
+#include <Locker.h>
+#include <MediaEventLooper.h>
+#include <Messenger.h>
+#include <StringList.h>
+
+#include "MotionDetector.h"
+
+
+class BBitmap;
+class BBufferGroup;
+class BWindow;
+class PreviewView;
+class VideoRecorder;
+
+
+/*!	NeoCam's media node: the camera's frames (B_RGB32) arrive in bitmaps of
+	its own, are shown in the preview, go to a recording, to motion
+	detection, and a copy of one to the capture manager for a still. The
+	requests come from other threads, under its lock.
+*/
+class CameraConsumer : public BMediaEventLooper, public BBufferConsumer {
+public:
+								CameraConsumer(PreviewView* view,
+									const BMessenger& window,
+									const BMessenger& captureManager);
+	virtual						~CameraConsumer();
+
+			void				TakeStill(const char* trigger);
+			status_t			StartRecording(const char* path,
+									float frameRate);
+			VideoRecorder*		DetachRecorder();
+									// the caller stops and deletes it
+			bool				IsRecording();
+			void				SetMotionDetection(bool enabled,
+									int32 sensitivity, bool showCells);
+
+			uint32				Width() const;
+			uint32				Height() const;
+
+	// BMediaNode
+	virtual	BMediaAddOn*		AddOn(int32* _internalID) const;
+
+protected:
+	virtual	void				NodeRegistered();
+	virtual	status_t			HandleMessage(int32 message, const void* data,
+									size_t size);
+
+	// BMediaEventLooper
+	virtual	void				HandleEvent(const media_timed_event* event,
+									bigtime_t lateness, bool realTimeEvent);
+
+	// BBufferConsumer
+	virtual	status_t			AcceptFormat(const media_destination& where,
+									media_format* format);
+	virtual	status_t			GetNextInput(int32* cookie,
+									media_input* _input);
+	virtual	void				DisposeInputCookie(int32 cookie);
+	virtual	void				BufferReceived(BBuffer* buffer);
+	virtual	void				ProducerDataStatus(
+									const media_destination& forWhom,
+									int32 status, bigtime_t atPerformanceTime);
+	virtual	status_t			GetLatencyFor(const media_destination& forWhom,
+									bigtime_t* _latency,
+									media_node_id* _timeSource);
+	virtual	status_t			Connected(const media_source& producer,
+									const media_destination& where,
+									const media_format& format,
+									media_input* _input);
+	virtual	void				Disconnected(const media_source& producer,
+									const media_destination& where);
+	virtual	status_t			FormatChanged(const media_source& producer,
+									const media_destination& consumer,
+									int32 changeTag,
+									const media_format& format);
+
+private:
+			status_t			_CreateBuffers(const media_format& format);
+			void				_DeleteBuffers();
+			void				_HandleFrame(BBuffer* buffer,
+									bigtime_t lateness);
+
+private:
+	enum {
+		kBufferCount = 3
+	};
+
+			PreviewView*		fView;
+			BWindow*			fWindow;
+			BMessenger			fWindowMessenger;
+			BMessenger			fCaptureManager;
+
+			media_input			fInput;
+			bool				fConnected;
+			BBufferGroup*		fBuffers;
+			BBitmap*			fBitmaps[kBufferCount];
+			BBuffer*			fBufferMap[kBufferCount];
+
+			BLocker				fLock;
+				// for what follows
+			BStringList			fStillTriggers;
+			VideoRecorder*		fRecorder;
+			bool				fMotionEnabled;
+			bool				fShowMotion;
+			bool				fMotion;
+				// the last analysis found motion
+			MotionDetector		fDetector;
+
+			// in the node's thread only
+			bigtime_t			fLastAnalysis;
+			bigtime_t			fStatsStart;
+			int32				fStatsFrames;
+};
+
+
+#endif	// CAMERA_CONSUMER_H
