+#ifndef UPLOADER_H
+#define UPLOADER_H
+
+
+#include <String.h>
+
+#include "NeoCam.h"
+
+
+struct UploadTarget {
+			upload_kind			kind;
+			BString				server;		// host or host:port
+			BString				user;
+			BString				password;
+			BString				folder;		// on the server; made if missing
+			bool				passive;	// FTP
+			BString				askPassProgram;
+				// SFTP: NeoCam's own path (it answers ssh's password prompt)
+};
+
+
+/*!	Puts a file on a server, by FTP (NeoCam's own client) or SFTP (the sftp
+	command in batch mode, the password through SSH_ASKPASS). On failure
+	\a error says what went wrong. Blocks; several seconds at most when the
+	server doesn't answer.
+*/
+status_t upload_file(const UploadTarget& target, const char* localPath,
+	const char* remoteName, BString& error);
+
+
+#endif	// UPLOADER_H
