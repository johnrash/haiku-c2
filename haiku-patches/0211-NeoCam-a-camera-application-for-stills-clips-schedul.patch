+
+void
+MainWindow::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgSnapshot:
+			_TakeStill(kTriggerManual);
+			break;
+
+		case kMsgRecord:
+			if (fRecording || fRecordingPending)
+				_StopClip();
+			else
+				_StartClip(kTriggerClip);
+			break;
+
+		case kMsgFrameSize:
+		{
+			int32 index = message->GetInt32("index", -1);
+			if (index < 0 || index >= fSizeCount || index == fCurrentSize)
+				break;
+			fWantedWidth = fSizes[index].width;
+			fWantedHeight = fSizes[index].height;
+			fConnected = false;
+			_UpdateControls();
+			fPreview->SetMessage(B_TRANSLATE("Changing the frame size"
+				B_UTF8_ELLIPSIS));
+			BMessage connect(CameraController::kMsgConnect);
+			connect.AddUInt32("width", fWantedWidth);
+			connect.AddUInt32("height", fWantedHeight);
+			BMessenger(fController).SendMessage(&connect);
+			break;
+		}
+
+		case kMsgReconnect:
+		{
+			fConnected = false;
+			_UpdateControls();
+			fPreview->SetMessage(B_TRANSLATE("Connecting to the camera"
+				B_UTF8_ELLIPSIS));
+			BMessage connect(CameraController::kMsgConnect);
+			connect.AddUInt32("width", fWantedWidth);
+			connect.AddUInt32("height", fWantedHeight);
+			BMessenger(fController).SendMessage(&connect);
+			break;
+		}
+
+		case kMsgCameraSettings:
+			_ShowCameraSettings();
+			break;
+
+		case kMsgOpenFolder:
+			_OpenFolder();
+			break;
+
+		case kMsgChooseFolder:
+			if (fFolderPanel == NULL) {
+				BMessenger target(this);
+				BMessage chosen(kMsgFolderChosen);
+				fFolderPanel = new BFilePanel(B_OPEN_PANEL, &target, NULL,
+					B_DIRECTORY_NODE, false, &chosen);
+				fFolderPanel->Window()->SetTitle(
+					B_TRANSLATE("NeoCam: Capture folder"));
+			}
+			fFolderPanel->Show();
+			break;
+
+		case kMsgFolderChosen:
+		{
+			entry_ref ref;
+			if (message->FindRef("refs", &ref) == B_OK) {
+				fFolderControl->SetText(BPath(&ref).Path());
+				_SendDestination();
+			}
+			break;
+		}
+
+		case kMsgStillFormat:
+		case kMsgUploadChanged:
+			_UpdateControls();
+			_SendDestination();
+			break;
+
+		case kMsgSettingChanged:
+			_UpdateClipRateLabel();
+			_SendDestination();
+			break;
+
+		case kMsgScheduleSetting:
+			_ScheduleChanged();
+			break;
+
+		case kMsgMotionSetting:
+			_UpdateControls();
+			_SendMotion();
+			break;
+
+		case kMsgTestUpload:
+			_SendDestination();
+			BMessenger(fCaptureManager).SendMessage(kMsgUploadTest);
+			break;
+
+		case kMsgAbout:
+		{
+			BAboutWindow* about = new BAboutWindow(
+				B_TRANSLATE_SYSTEM_NAME("NeoCam"), kAppSignature);
+			about->AddCopyright(2026, "haiku-odroid-c2 port authors");
+			about->AddDescription(B_TRANSLATE("Stills and video clips from "
+				"a camera, at any of its frame sizes: when you ask, on a "
+				"schedule or when something moves; saved here or uploaded "
+				"by FTP or SFTP."));
+			about->Show();
+			break;
+		}
+
+		case kMsgPulse:
+			_Pulse();
+			break;
+
+		case kMsgCameraReady:
+			_CameraReady(message);
+			break;
+
+		case kMsgCameraFailed:
+			_CameraFailed(message);
+			break;
+
+		case kMsgRecordingStarted:
+			_RecordingStarted(message);
+			break;
+
+		case kMsgFrameStats:
+		{
+			if (!fConnected || fCurrentSize < 0)
+				break;
+			BString text;
+			text.SetToFormat("%" B_PRIu32 " × %" B_PRIu32 ", %.1f fps",
+				fSizes[fCurrentSize].width, fSizes[fCurrentSize].height,
+				message->GetFloat("fps", 0));
+			fInfoView->SetText(text);
+			break;
+		}
+
+		case kMsgMotionLevel:
+			_Motion(message);
+			break;
+
+		case kMsgCaptureStatus:
+			_SetStatus(message->GetString("text", ""),
+				message->GetBool("error", false));
+			break;
+
+		default:
+			BWindow::MessageReceived(message);
+	}
+}
