+	settings.AddBool("motion", fMotionBox->Value() == B_CONTROL_ON);
+	settings.AddInt32("motion sensitivity", fSensitivity->Value());
+	settings.AddBool("motion clip", fMotionClip->Value() == B_CONTROL_ON);
+	settings.AddInt32("motion wait", fMotionWait->Value());
+	settings.AddBool("motion show", fShowMotionBox->Value() == B_CONTROL_ON);
