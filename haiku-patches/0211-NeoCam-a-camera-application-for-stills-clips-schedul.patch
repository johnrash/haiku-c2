+#include "CameraConsumer.h"
+#include "NeoCam.h"
+#include "PreviewView.h"
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "CameraController"
+
+
+// a camera that appears is connected to after this
+static const bigtime_t kSettleDelay = 1500000;
+
+
+CameraController::CameraController(PreviewView* view,
+	const BMessenger& window, const BMessenger& captureManager)
+	:
+	BLooper("camera controller"),
+	fView(view),
+	fWindow(window),
+	fCaptureManager(captureManager),
+	fRoster(NULL),
+	fHasProducer(false),
+	fConsumer(NULL),
+	fConnected(false),
+	fWatching(false),
+	fSizeCount(0),
+	fWantedWidth(0),
+	fWantedHeight(0),
+	fMotionEnabled(false),
+	fMotionSensitivity(50),
+	fShowMotion(false)
+{
+}
+
+
+CameraController::~CameraController()
+{
+	_Disconnect(true);
+}
+
+
+void
+CameraController::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgConnect:
+		{
+			uint32 width = message->GetUInt32("width", fWantedWidth);
+			uint32 height = message->GetUInt32("height", fWantedHeight);
+			fWantedWidth = width;
+			fWantedHeight = height;
+			// a recording is finished first (it has the old size)
+			_FinishRecording(NULL);
+			_Disconnect(false);
+			status_t status = _Connect(width, height);
+			if (status != B_OK)
+				_Disconnect(false);
+			break;
+		}
+
+		case kMsgDisconnect:
+			_FinishRecording(NULL);
+			_Disconnect(true);
+			if (fRoster != NULL && fWatching) {
+				fRoster->StopWatching(BMessenger(this));
+				fWatching = false;
+			}
+			message->SendReply(B_OK);
+			break;
+
+		case kMsgGetWeb:
+		{
+			BParameterWeb* web = NULL;
+			if (fRoster != NULL && fHasProducer)
+				fRoster->GetParameterWebFor(fProducer, &web);
+			BMessage reply(B_REPLY);
+			reply.AddPointer("web", web);
+			reply.AddData("node", B_RAW_TYPE, &fProducer, sizeof(fProducer));
+			message->SendReply(&reply);
+			break;
+		}
+
+		case kMsgTakeStill:
+			if (fConsumer != NULL && fConnected)
+				fConsumer->TakeStill(message->GetString("trigger", ""));
+			break;
+
+		case kMsgStartRecording:
+		{
+			status_t status = B_NO_INIT;
+			const char* trigger = message->GetString("trigger", kTriggerClip);
+			if (fConsumer != NULL && fConnected) {
+				status = fConsumer->StartRecording(
+					message->GetString("path", ""),
+					message->GetFloat("fps", 30));
+				if (status == B_OK)
+					fClipTrigger = trigger;
+			}
+			BMessage started(kMsgRecordingStarted);
+			started.AddInt32("status", status);
+			started.AddString("path", message->GetString("path", ""));
+			started.AddString("trigger", trigger);
+			fWindow.SendMessage(&started);
+			break;
+		}
+
+		case kMsgStopRecording:
+			_FinishRecording(message->GetString("trigger", NULL));
+			break;
+
+		case kMsgSetMotion:
+			fMotionEnabled = message->GetBool("enabled", false);
+			fMotionSensitivity = message->GetInt32("sensitivity", 50);
+			fShowMotion = message->GetBool("show", false);
+			if (fConsumer != NULL) {
+				fConsumer->SetMotionDetection(fMotionEnabled,
+					fMotionSensitivity, fShowMotion);
+			}
+			break;
+
+		case B_MEDIA_NODE_CREATED:
+		case B_MEDIA_DEFAULT_CHANGED:
+			// a camera that was plugged in: try it once it settled
+			if (!fConnected) {
+				BMessage connect(kMsgConnect);
+				BMessageRunner::StartSending(BMessenger(this), &connect,
+					kSettleDelay, 1);
+			}
+			break;
+
+		default:
+			BLooper::MessageReceived(message);
+	}
+}
+
+
+status_t
+CameraController::_Connect(uint32 width, uint32 height)
+{
+	status_t status = B_OK;
+	if (fRoster == NULL) {
+		fRoster = BMediaRoster::Roster(&status);
+		if (fRoster == NULL) {
+			_Failed(B_TRANSLATE("The media services aren't running."),
+				status);
+			return status;
+		}
+	}
+	if (!fWatching) {
+		fWatching = fRoster->StartWatching(BMessenger(this),
+			B_MEDIA_NODE_CREATED | B_MEDIA_DEFAULT_CHANGED) == B_OK;
+	}
+
+	status = fRoster->GetVideoInput(&fProducer);
+	if (status != B_OK) {
+		_Failed(B_TRANSLATE("No camera found. NeoCam connects to one when "
+			"it is plugged in."), status);
+		return status;
+	}
+	fHasProducer = true;
+
+	status = _QueryFrameSizes();
+	if (status != B_OK || fSizeCount == 0) {
+		_Failed(B_TRANSLATE("The camera doesn't say which frame sizes it "
+			"has."), status);
+		return B_ERROR;
+	}
+	int32 chosen = _ChooseSize(width, height);
+
+	status = fRoster->GetTimeSource(&fTimeSource);
+	if (status != B_OK) {
+		_Failed(B_TRANSLATE("No time source."), status);
+		return status;
+	}
+
+	if (fConsumer == NULL) {
+		fConsumer = new CameraConsumer(fView, fWindow, fCaptureManager);
+		status = fRoster->RegisterNode(fConsumer);
+		if (status != B_OK) {
+			fConsumer->Release();
+			fConsumer = NULL;
+			_Failed(B_TRANSLATE("NeoCam's media node couldn't be "
+				"registered."), status);
+			return status;
+		}
+		fConsumer->SetMotionDetection(fMotionEnabled, fMotionSensitivity,
+			fShowMotion);
+	}
+
+	int32 count = 0;
+	status = fRoster->GetFreeOutputsFor(fProducer, &fOutput, 1, &count,
+		B_MEDIA_RAW_VIDEO);
+	if (status != B_OK || count < 1) {
+		_Failed(B_TRANSLATE("The camera is in use by another application."),
+			B_BUSY);
+		return B_BUSY;
+	}
+	count = 0;
+	status = fRoster->GetFreeInputsFor(fConsumer->Node(), &fInput, 1, &count,
+		B_MEDIA_RAW_VIDEO);
+	if (status != B_OK || count < 1) {
+		_Failed(B_TRANSLATE("NeoCam's media node has no free input."),
+			B_ERROR);
+		return B_ERROR;
+	}
+
+	media_format format;
+	format.type = B_MEDIA_RAW_VIDEO;
+	format.u.raw_video = media_raw_video_format::wildcard;
+	format.u.raw_video.display.format = B_RGB32;
+	format.u.raw_video.display.line_width = fSizes[chosen].width;
+	format.u.raw_video.display.line_count = fSizes[chosen].height;
+	format.u.raw_video.display.bytes_per_row = fSizes[chosen].width * 4;
+	status = fRoster->Connect(fOutput.source, fInput.destination, &format,
+		&fOutput, &fInput);
+	if (status != B_OK) {
+		_Failed(B_TRANSLATE("The camera couldn't be connected."), status);
+		return status;
+	}
+	fConnected = true;
+
+	fRoster->SetTimeSourceFor(fProducer.node, fTimeSource.node);
+	fRoster->SetTimeSourceFor(fConsumer->ID(), fTimeSource.node);
+
+	bigtime_t latency = 0;
+	fRoster->GetLatencyFor(fProducer, &latency);
+	fRoster->SetProducerRunModeDelay(fProducer, latency);
+	bigtime_t initialLatency = 0;
+	fRoster->GetInitialLatencyFor(fProducer, &initialLatency);
+	initialLatency += estimate_max_scheduling_latency();
+
+	BTimeSource* timeSource = fRoster->MakeTimeSourceFor(fProducer);
+	if (timeSource == NULL) {
+		_Failed(B_TRANSLATE("No time source."), B_ERROR);
+		return B_ERROR;
+	}
+	bigtime_t real = BTimeSource::RealTime();
+	if (!timeSource->IsRunning()) {
+		// without a sound card nothing starts the system time source
+		fRoster->StartTimeSource(fTimeSource, real);
+		fRoster->SeekTimeSource(fTimeSource, 0, real);
+	}
+	bigtime_t performance = timeSource->PerformanceTimeFor(real + latency
+		+ initialLatency);
+	timeSource->Release();
+
+	status = fRoster->StartNode(fProducer, performance);
+	if (status == B_OK)
+		status = fRoster->StartNode(fConsumer->Node(), performance);
+	if (status != B_OK) {
+		_Failed(B_TRANSLATE("The camera couldn't be started."), status);
+		return status;
+	}
+
+	live_node_info info;
+	BMessage ready(kMsgCameraReady);
+	if (fRoster->GetLiveNodeInfo(fProducer, &info) == B_OK)
+		ready.AddString("name", info.name);
+	for (int32 i = 0; i < fSizeCount; i++) {
+		ready.AddUInt32("width", fSizes[i].width);
+		ready.AddUInt32("height", fSizes[i].height);
+		ready.AddFloat("fps", fSizes[i].frame_rate);
+		ready.AddBool("compressed",
+			(fSizes[i].flags & VIDEO_FRAME_SIZE_COMPRESSED) != 0);
+	}
+	ready.AddInt32("current", chosen);
+	fWindow.SendMessage(&ready);
+	return B_OK;
+}
+
+
+void
+CameraController::_Disconnect(bool releaseConsumer)
+{
+	if (fConsumer != NULL) {
+		if (fConnected) {
+			fRoster->StopNode(fConsumer->Node(), 0, true);
+			fRoster->Disconnect(fOutput.node.node, fOutput.source,
+				fInput.node.node, fInput.destination);
+			fConnected = false;
+		}
+		if (releaseConsumer) {
+			// the node goes with its last reference
+			fRoster->ReleaseNode(fConsumer->Node());
+			fConsumer = NULL;
+		}
+	}
+	if (fHasProducer) {
+		fRoster->ReleaseNode(fProducer);
+		fHasProducer = false;
+	}
+}
+
+
+/*!	A recording ends: its file is finished (and uploaded) by the capture
+	manager, which has a thread for the wait.
+*/
+void
+CameraController::_FinishRecording(const char* trigger)
+{
+	if (fConsumer == NULL)
+		return;
+	VideoRecorder* recorder = fConsumer->DetachRecorder();
+	if (recorder == NULL)
+		return;
+
+	BMessage message(kMsgFinishClip);
+	message.AddPointer("recorder", recorder);
+	message.AddString("trigger", trigger != NULL ? trigger
+		: fClipTrigger.String());
+	fCaptureManager.SendMessage(&message);
+}
+
+
+status_t
+CameraController::_QueryFrameSizes()
+{
+	fSizeCount = 0;
+	port_id replyPort = create_port(1, "frame sizes reply");
+	if (replyPort < 0)
+		return replyPort;
+
+	video_frame_sizes_request request;
+	request.reply_port = replyPort;
+	status_t status = write_port_etc(fProducer.port,
+		VIDEO_FRAME_SIZES_REQUEST, &request, sizeof(request),
+		B_RELATIVE_TIMEOUT, 1000000);
+
+	video_frame_sizes_reply* reply = NULL;
+	if (status == B_OK) {
+		reply = new video_frame_sizes_reply;
+		int32 code;
+		ssize_t size = read_port_etc(replyPort, &code, reply, sizeof(*reply),
+			B_RELATIVE_TIMEOUT, 2000000);
+		if (size < 0)
+			status = size;
+		else if (code != VIDEO_FRAME_SIZES_REPLY
+			|| size < (ssize_t)offsetof(video_frame_sizes_reply, sizes))
+			status = B_BAD_DATA;
+		else
+			status = reply->status;
+	}
+	delete_port(replyPort);
+
+	if (status == B_OK) {
+		for (int32 i = 0; i < reply->count && i < VIDEO_FRAME_SIZES_MAX; i++)
+			fSizes[fSizeCount++] = reply->sizes[i];
+	} else {
+		// a producer that doesn't answer: what it suggests (0x0 is the
+		// wildcard)
+		fSizes[0].width = 0;
+		fSizes[0].height = 0;
+		fSizes[0].frame_rate = 0;
+		fSizes[0].flags = 0;
+		fSizeCount = 1;
+		status = B_OK;
+	}
+	delete reply;
+	return status;
+}
+
+
+/*!	The size asked for, else 1280x720, else the largest below it, else the
+	smallest.
+*/
+int32
+CameraController::_ChooseSize(uint32 width, uint32 height) const
+{
+	for (int32 i = 0; i < fSizeCount; i++) {
+		if (fSizes[i].width == width && fSizes[i].height == height)
+			return i;
+	}
+	int32 chosen = 0;
+	for (int32 i = 0; i < fSizeCount; i++) {
+		if (fSizes[i].width <= 1280 && fSizes[i].height <= 720)
+			chosen = i;
+	}
+	return chosen;
+}
+
+
+void
+CameraController::_Failed(const char* text, status_t status)
+{
+	fprintf(stderr, "NeoCam: %s (%s)\n", text, strerror(status));
+	BMessage message(kMsgCameraFailed);
+	message.AddString("text", text);
+	fWindow.SendMessage(&message);
+}
