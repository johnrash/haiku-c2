+static void
+mark_item_with(BMenu* menu, const char* field, int32 value)
+{
+	for (int32 i = 0; BMenuItem* item = menu->ItemAt(i); i++) {
+		if (item->Message() != NULL
+			&& item->Message()->GetInt32(field, -1) == value) {
+			item->SetMarked(true);
+			return;
+		}
+	}
+}
