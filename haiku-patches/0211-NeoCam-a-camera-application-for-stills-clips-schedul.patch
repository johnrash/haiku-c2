+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef PREVIEW_VIEW_H
+#define PREVIEW_VIEW_H
+
+
+#include <String.h>
+#include <View.h>
+
+#include "MotionDetector.h"
+
+
+class BBitmap;
+
+
+/*!	The camera's picture, scaled to fit with its proportions kept, with
+	what NeoCam is doing drawn over it. The camera node calls DrawFrame()
+	with the window locked; without frames a message is shown.
+*/
+class PreviewView : public BView {
+public:
+								PreviewView();
+
+	virtual	void				Draw(BRect updateRect);
+	virtual	void				FrameResized(float width, float height);
+
+			void				DrawFrame(BBitmap* bitmap);
+			void				SetMessage(const char* message);
+			void				SetRecording(bool recording,
+									bigtime_t started = 0);
+			void				SetMotion(const MotionDetector* detector,
+									bool motion, bool showCells);
+									// cells are copied from a detector,
+									// kept without
+			void				ClearFrame();
+
+private:
+			BRect				_PictureRect(BBitmap* bitmap) const;
+			void				_DrawPicture();
+			void				_DrawOverlays(BRect picture);
+
+			BBitmap*			fBitmap;
+				// the frame drawn last, in one of the node's buffers
+			BString				fMessage;
+			bool				fRecording;
+			bigtime_t			fRecordingStarted;
+			bool				fMotion;
+			bool				fShowCells;
+			bool				fCells[MotionDetector::kRows
+									* MotionDetector::kColumns];
+			bool				fClearBackground;
+};
+
+
+#endif	// PREVIEW_VIEW_H
