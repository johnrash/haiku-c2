@@ -0,0 +1,497 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "CameraConsumer.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include <Autolock.h>
+#include <Bitmap.h>
+#include <Buffer.h>
+#include <BufferGroup.h>
+#include <Message.h>
+#include <TimeSource.h>
+#include <Window.h>
+
+#include "NeoCam.h"
+#include "PreviewView.h"
+#include "VideoRecorder.h"
+
+
+// motion detection at most this often
+static const bigtime_t kAnalysisInterval = 100000;
+// a frame this late isn't shown (it is still recorded)
+static const bigtime_t kMaxShowLateness = 100000;
+
+
+CameraConsumer::CameraConsumer(PreviewView* view, const BMessenger& window,
+	const BMessenger& captureManager)
+	:
+	BMediaNode("NeoCam"),
+	BMediaEventLooper(),
+	BBufferConsumer(B_MEDIA_RAW_VIDEO),
+	fView(view),
+	fWindow(view->Window()),
+	fWindowMessenger(window),
+	fCaptureManager(captureManager),
+	fConnected(false),
+	fBuffers(NULL),
+	fLock("camera consumer"),
+	fRecorder(NULL),
+	fMotionEnabled(false),
+	fShowMotion(false),
+	fMotion(false),
+	fLastAnalysis(0),
+	fStatsStart(0),
+	fStatsFrames(0)
+{
+	AddNodeKind(B_PHYSICAL_OUTPUT);
+	SetEventLatency(0);
+	SetPriority(B_DISPLAY_PRIORITY);
+
+	for (int32 i = 0; i < kBufferCount; i++) {
+		fBitmaps[i] = NULL;
+		fBufferMap[i] = NULL;
+	}
+}
+
+
+CameraConsumer::~CameraConsumer()
+{
+	Quit();
+
+	// a recording ends with the node: its file is finished
+	VideoRecorder* recorder = DetachRecorder();
+	if (recorder != NULL) {
+		recorder->Stop();
+		delete recorder;
+	}
+
+	_DeleteBuffers();
+}
+
+
+void
+CameraConsumer::TakeStill(const char* trigger)
+{
+	BAutolock _(fLock);
+	fStillTriggers.Add(trigger);
+}
+
+
+status_t
+CameraConsumer::StartRecording(const char* path, float frameRate)
+{
+	BAutolock _(fLock);
+	if (fRecorder != NULL)
+		return EALREADY;
+	if (!fConnected || fBitmaps[0] == NULL)
+		return B_NO_INIT;
+
+	VideoRecorder* recorder = new VideoRecorder();
+	status_t status = recorder->Start(path, Width(), Height(),
+		fBitmaps[0]->BytesPerRow(), frameRate);
+	if (status != B_OK) {
+		delete recorder;
+		return status;
+	}
+	fRecorder = recorder;
+	return B_OK;
+}
+
+
+VideoRecorder*
+CameraConsumer::DetachRecorder()
+{
+	BAutolock _(fLock);
+	VideoRecorder* recorder = fRecorder;
+	fRecorder = NULL;
+	return recorder;
+}
+
+
+bool
+CameraConsumer::IsRecording()
+{
+	BAutolock _(fLock);
+	return fRecorder != NULL;
+}
+
+
+void
+CameraConsumer::SetMotionDetection(bool enabled, int32 sensitivity,
+	bool showCells)
+{
+	BAutolock _(fLock);
+	if (enabled && !fMotionEnabled) {
+		fDetector.Reset();
+		fMotion = false;
+	}
+	fMotionEnabled = enabled;
+	fShowMotion = enabled && showCells;
+	fDetector.SetSensitivity(sensitivity);
+}
+
+
+uint32
+CameraConsumer::Width() const
+{
+	return fInput.format.u.raw_video.display.line_width;
+}
+
+
+uint32
+CameraConsumer::Height() const
+{
+	return fInput.format.u.raw_video.display.line_count;
+}
+
+
+BMediaAddOn*
+CameraConsumer::AddOn(int32* _internalID) const
+{
+	if (_internalID != NULL)
+		*_internalID = 0;
+	return NULL;
+}
+
+
+void
+CameraConsumer::NodeRegistered()
+{
+	fInput.node = Node();
+	fInput.destination.port = ControlPort();
+	fInput.destination.id = 0;
+	fInput.source = media_source::null;
+	fInput.format.type = B_MEDIA_RAW_VIDEO;
+	fInput.format.u.raw_video = media_raw_video_format::wildcard;
+	fInput.format.u.raw_video.display.format = B_RGB32;
+	strcpy(fInput.name, "NeoCam input");
+
+	Run();
+}
+
+
+status_t
+CameraConsumer::HandleMessage(int32 message, const void* data, size_t size)
+{
+	return B_ERROR;
+}
+
+
+void
+CameraConsumer::HandleEvent(const media_timed_event* event,
+	bigtime_t lateness, bool realTimeEvent)
+{
+	switch (event->type) {
+		case BTimedEventQueue::B_START:
+			fStatsStart = system_time();
+			fStatsFrames = 0;
+			break;
+
+		case BTimedEventQueue::B_STOP:
+			EventQueue()->FlushEvents(event->event_time,
+				BTimedEventQueue::B_ALWAYS, true,
+				BTimedEventQueue::B_HANDLE_BUFFER);
+			break;
+
+		case BTimedEventQueue::B_HANDLE_BUFFER:
+		{
+			BBuffer* buffer = (BBuffer*)event->pointer;
+			if (RunState() == B_STARTED && fConnected)
+				_HandleFrame(buffer, lateness);
+			buffer->Recycle();
+			break;
+		}
+
+		default:
+			break;
+	}
+}
+
+
+void
+CameraConsumer::_HandleFrame(BBuffer* buffer, bigtime_t lateness)
+{
+	// one of our bitmaps, or a copy into the first
+	int32 index = 0;
+	while (index < kBufferCount && buffer != fBufferMap[index])
+		index++;
+	if (index == kBufferCount) {
+		index = 0;
+		size_t size = buffer->SizeUsed();
+		if (size > (size_t)fBitmaps[0]->BitsLength())
+			size = fBitmaps[0]->BitsLength();
+		memcpy(fBitmaps[0]->Bits(), buffer->Data(), size);
+	}
+	BBitmap* bitmap = fBitmaps[index];
+
+	bool analyze = false;
+	bool showMotion = false;
+	bool motion = false;
+	{
+		BAutolock _(fLock);
+
+		// every frame goes into a recording, also one too late to show
+		if (fRecorder != NULL)
+			fRecorder->AddFrame(bitmap->Bits(), buffer->Header()->start_time);
+
+		// a still for each request
+		for (int32 i = 0; i < fStillTriggers.CountStrings(); i++) {
+			BBitmap* still = new BBitmap(bitmap->Bounds(), B_RGB32);
+			if (!still->IsValid()) {
+				delete still;
+				continue;
+			}
+			memcpy(still->Bits(), bitmap->Bits(), still->BitsLength());
+			BMessage message(kMsgSaveStill);
+			message.AddPointer("bitmap", still);
+			message.AddString("trigger", fStillTriggers.StringAt(i));
+			message.AddInt64("time", (int64)real_time_clock());
+			if (fCaptureManager.SendMessage(&message) != B_OK)
+				delete still;
+		}
+		fStillTriggers.MakeEmpty();
+
+		bigtime_t now = system_time();
+		if (fMotionEnabled && now - fLastAnalysis >= kAnalysisInterval) {
+			fLastAnalysis = now;
+			analyze = true;
+			float level = fDetector.Analyze((const uint8*)bitmap->Bits(),
+				Width(), Height(), bitmap->BytesPerRow());
+			fMotion = level >= fDetector.Threshold();
+			BMessage message(kMsgMotionLevel);
+			message.AddFloat("level", level);
+			message.AddFloat("threshold", fDetector.Threshold());
+			message.AddBool("motion", fMotion);
+			fWindowMessenger.SendMessage(&message);
+		}
+		showMotion = fShowMotion;
+		motion = fMotionEnabled && fMotion;
+	}
+
+	if (lateness <= kMaxShowLateness
+		&& fWindow->LockWithTimeout(50000) == B_OK) {
+		{
+			// the changed cells are copied after each analysis
+			BAutolock _(fLock);
+			fView->SetMotion(analyze ? &fDetector : NULL, motion,
+				showMotion);
+		}
+		fView->DrawFrame(bitmap);
+		fWindow->Unlock();
+	}
+
+	// the frame rate, once a second
+	fStatsFrames++;
+	bigtime_t now = system_time();
+	if (now - fStatsStart >= 1000000) {
+		BMessage message(kMsgFrameStats);
+		message.AddFloat("fps", fStatsFrames * 1000000.0f
+			/ (now - fStatsStart));
+		fWindowMessenger.SendMessage(&message);
+		fStatsStart = now;
+		fStatsFrames = 0;
+	}
+}
+
+
+status_t
+CameraConsumer::AcceptFormat(const media_destination& where,
+	media_format* format)
+{
+	if (where != fInput.destination)
+		return B_MEDIA_BAD_DESTINATION;
+
+	if (format->type == B_MEDIA_NO_TYPE)
+		format->type = B_MEDIA_RAW_VIDEO;
+	if (format->type != B_MEDIA_RAW_VIDEO)
+		return B_MEDIA_BAD_FORMAT;
+
+	color_space& colorSpace = format->u.raw_video.display.format;
+	if (colorSpace == media_raw_video_format::wildcard.display.format)
+		colorSpace = B_RGB32;
+	if (colorSpace != B_RGB32)
+		return B_MEDIA_BAD_FORMAT;
+
+	return B_OK;
+}
+
+
+status_t
+CameraConsumer::GetNextInput(int32* cookie, media_input* _input)
+{
+	if (*cookie != 0)
+		return B_BAD_INDEX;
+
+	*_input = fInput;
+	(*cookie)++;
+	return B_OK;
+}
+
+
+void
+CameraConsumer::DisposeInputCookie(int32 cookie)
+{
+}
+
+
+void
+CameraConsumer::BufferReceived(BBuffer* buffer)
+{
+	if (RunState() == B_STOPPED) {
+		buffer->Recycle();
+		return;
+	}
+
+	media_timed_event event(buffer->Header()->start_time,
+		BTimedEventQueue::B_HANDLE_BUFFER, buffer,
+		BTimedEventQueue::B_RECYCLE_BUFFER);
+	EventQueue()->AddEvent(event);
+}
+
+
+void
+CameraConsumer::ProducerDataStatus(const media_destination& forWhom,
+	int32 status, bigtime_t atPerformanceTime)
+{
+}
+
+
+status_t
+CameraConsumer::GetLatencyFor(const media_destination& forWhom,
+	bigtime_t* _latency, media_node_id* _timeSource)
+{
+	if (forWhom != fInput.destination)
+		return B_MEDIA_BAD_DESTINATION;
+
+	*_latency = 20000;
+	*_timeSource = TimeSource()->ID();
+	return B_OK;
+}
+
+
+status_t
+CameraConsumer::Connected(const media_source& producer,
+	const media_destination& where, const media_format& format,
+	media_input* _input)
+{
+	if (where != fInput.destination)
+		return B_MEDIA_BAD_DESTINATION;
+
+	fInput.source = producer;
+	fInput.format = format;
+	*_input = fInput;
+
+	status_t status = _CreateBuffers(format);
+	if (status != B_OK)
+		return status;
+
+	int32 changeTag = 1;
+	SetOutputBuffersFor(producer, fInput.destination, fBuffers, NULL,
+		&changeTag, true);
+
+	fConnected = true;
+	return B_OK;
+}
+
+
+void
+CameraConsumer::Disconnected(const media_source& producer,
+	const media_destination& where)
+{
+	if (where != fInput.destination || producer != fInput.source)
+		return;
+
+	fConnected = false;
+	fInput.source = media_source::null;
+
+	// the preview must not draw a bitmap that is going away
+	if (fWindow->Lock()) {
+		fView->ClearFrame();
+		fWindow->Unlock();
+	}
+}
+
+
+status_t
+CameraConsumer::FormatChanged(const media_source& producer,
+	const media_destination& consumer, int32 changeTag,
+	const media_format& format)
+{
+	if (consumer != fInput.destination)
+		return B_MEDIA_BAD_DESTINATION;
+	if (producer != fInput.source)
+		return B_MEDIA_BAD_SOURCE;
+
+	if (fWindow->Lock()) {
+		fView->ClearFrame();
+		fWindow->Unlock();
+	}
+	fInput.format = format;
+	return _CreateBuffers(format);
+}
+
+
+status_t
+CameraConsumer::_CreateBuffers(const media_format& format)
+{
+	_DeleteBuffers();
+
+	uint32 width = format.u.raw_video.display.line_width;
+	uint32 height = format.u.raw_video.display.line_count;
+	if (width == 0 || height == 0)
+		return B_MEDIA_BAD_FORMAT;
+
+	fBuffers = new BBufferGroup();
+	status_t status = fBuffers->InitCheck();
+	if (status != B_OK)
+		return status;
+
+	for (int32 i = 0; i < kBufferCount; i++) {
+		// in an area of its own, which the producer clones
+		fBitmaps[i] = new BBitmap(BRect(0, 0, width - 1, height - 1),
+			B_BITMAP_IS_AREA, B_RGB32);
+		if (!fBitmaps[i]->IsValid())
+			return B_NO_MEMORY;
+
+		buffer_clone_info info;
+		info.area = area_for(fBitmaps[i]->Bits());
+		if (info.area < 0)
+			return info.area;
+		area_info areaInfo;
+		get_area_info(info.area, &areaInfo);
+		info.offset = (addr_t)fBitmaps[i]->Bits() - (addr_t)areaInfo.address;
+		info.size = fBitmaps[i]->BitsLength();
+		info.flags = i;
+		info.buffer = 0;
+		status = fBuffers->AddBuffer(info);
+		if (status != B_OK)
+			return status;
+	}
+
+	BBuffer* buffers[kBufferCount];
+	status = fBuffers->GetBufferList(kBufferCount, buffers);
+	if (status != B_OK)
+		return status;
+	for (int32 i = 0; i < kBufferCount; i++)
+		fBufferMap[i] = buffers[i];
+	return B_OK;
+}
+
+
+void
+CameraConsumer::_DeleteBuffers()
+{
+	delete fBuffers;
+	fBuffers = NULL;
+	for (int32 i = 0; i < kBufferCount; i++) {
+		delete fBitmaps[i];
+		fBitmaps[i] = NULL;
+		fBufferMap[i] = NULL;
+	}
+}
