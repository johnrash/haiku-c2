+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "CaptureManager.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <Bitmap.h>
+#include <BitmapStream.h>
+#include <Catalog.h>
+#include <Directory.h>
+#include <Entry.h>
+#include <File.h>
+#include <FindDirectory.h>
+#include <NodeInfo.h>
+#include <Path.h>
+#include <TranslatorRoster.h>
+
+#include "NeoCam.h"
+#include "VideoRecorder.h"
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "CaptureManager"
+
+
+CaptureManager::CaptureManager(const BMessenger& window)
+	:
+	BLooper("capture manager"),
+	fWindow(window),
+	fFolder("/boot/home/NeoCam"),
+	fStillType('JPEG'),
+	fStillTranslator(0),
+	fKeepLocal(true)
+{
+	fTarget.kind = UPLOAD_NONE;
+	fTarget.passive = true;
+}
+
+
+void
+CaptureManager::MessageReceived(BMessage* message)
+{
+	switch (message->what) {
+		case kMsgSetDestination:
+			fFolder = message->GetString("folder", fFolder);
+			fStillType = message->GetUInt32("still type", fStillType);
+			fStillTranslator = message->GetInt32("still translator",
+				fStillTranslator);
+			fKeepLocal = message->GetBool("keep local", true);
+			fTarget.kind = (upload_kind)message->GetInt32("upload",
+				UPLOAD_NONE);
+			fTarget.server = message->GetString("server", "");
+			fTarget.user = message->GetString("user", "");
+			fTarget.password = message->GetString("password", "");
+			fTarget.folder = message->GetString("remote folder", "");
+			fTarget.passive = message->GetBool("passive", true);
+			fTarget.askPassProgram = message->GetString("askpass", "");
+			break;
+
+		case kMsgSaveStill:
+		{
+			BBitmap* bitmap;
+			if (message->FindPointer("bitmap", (void**)&bitmap) != B_OK)
+				break;
+			_SaveStill(bitmap, message->GetString("trigger", kTriggerManual),
+				(time_t)message->GetInt64("time", real_time_clock()));
+			break;
+		}
+
+		case kMsgFinishClip:
+			_FinishClip(message);
+			break;
+
+		case kMsgUploadTest:
+		{
+			if (fTarget.kind == UPLOAD_NONE) {
+				_Status(B_TRANSLATE("Choose FTP or SFTP first."), true);
+				break;
+			}
+			BPath path;
+			find_directory(B_SYSTEM_TEMP_DIRECTORY, &path);
+			BString name = CapturePath(path.Path(), "test", "txt",
+				real_time_clock());
+			FILE* file = fopen(name.String(), "w");
+			if (file == NULL) {
+				_Status(B_TRANSLATE("Couldn't write the test file."), true);
+				break;
+			}
+			fprintf(file, "A test upload from NeoCam.\n");
+			fclose(file);
+
+			_Status(B_TRANSLATE("Uploading a test file" B_UTF8_ELLIPSIS),
+				false);
+			BString error;
+			status_t status = upload_file(fTarget, name.String(),
+				BPath(name.String()).Leaf(), error);
+			unlink(name.String());
+			if (status == B_OK) {
+				BString text(B_TRANSLATE("The test file \"%name%\" was "
+					"uploaded."));
+				text.ReplaceFirst("%name%", BPath(name.String()).Leaf());
+				_Status(text, false);
+			} else {
+				BString text(B_TRANSLATE("The test upload failed: %error%"));
+				text.ReplaceFirst("%error%", error);
+				_Status(text, true);
+			}
+			break;
+		}
+
+		default:
+			BLooper::MessageReceived(message);
+	}
+}
+
+
+/*!	"NeoCam 2026-11-01 14-05-00 motion.jpg" in \a folder, with a number
+	after it if that is taken.
+*/
+/*static*/ BString
+CaptureManager::CapturePath(const char* folder, const char* trigger,
+	const char* extension, time_t when)
+{
+	struct tm local;
+	localtime_r(&when, &local);
+	char stamp[64];
+	strftime(stamp, sizeof(stamp), "%Y-%m-%d %H-%M-%S", &local);
+
+	BString path;
+	for (int32 number = 1; ; number++) {
+		path.SetToFormat("%s/NeoCam %s %s", folder, stamp, trigger);
+		if (number > 1)
+			path << " " << number;
+		path << "." << extension;
+		if (!BEntry(path.String()).Exists())
+			return path;
+	}
+}
+
+
+BString
+CaptureManager::_StillExtension() const
+{
+	BString mimeType;
+	const translation_format* formats;
+	int32 count;
+	if (BTranslatorRoster::Default()->GetOutputFormats(fStillTranslator,
+			&formats, &count) == B_OK) {
+		for (int32 i = 0; i < count; i++) {
+			if (formats[i].type == fStillType) {
+				mimeType = formats[i].MIME;
+				break;
+			}
+		}
+	}
+
+	static const struct {
+		const char* type;
+		const char* extension;
+	} kExtensions[] = {
+		{ "image/jpeg", "jpg" },
+		{ "image/png", "png" },
+		{ "image/gif", "gif" },
+		{ "image/tiff", "tif" },
+		{ "image/webp", "webp" },
+		{ "image/bmp", "bmp" },
+		{ "image/x-bmp", "bmp" },
+		{ "image/x-portable-pixmap", "ppm" },
+		{ "image/x-targa", "tga" },
+	};
+	for (size_t i = 0; i < sizeof(kExtensions) / sizeof(kExtensions[0]); i++) {
+		if (mimeType.ICompare(kExtensions[i].type) == 0)
+			return kExtensions[i].extension;
+	}
+	int32 slash = mimeType.FindFirst('/');
+	if (slash < 0)
+		return "image";
+	BString extension;
+	mimeType.CopyInto(extension, slash + 1, mimeType.Length() - slash - 1);
+	if (extension.FindFirst("x-") == 0)
+		extension.Remove(0, 2);
+	return extension;
+}
+
+
+void
+CaptureManager::_SaveStill(BBitmap* bitmap, const char* trigger,
+	time_t when)
+{
+	create_directory(fFolder.String(), 0755);
+	BString path = CapturePath(fFolder.String(), trigger,
+		_StillExtension().String(), when);
+
+	BFile file(path.String(), B_CREATE_FILE | B_ERASE_FILE | B_WRITE_ONLY);
+	status_t status = file.InitCheck();
+	if (status == B_OK) {
+		BBitmapStream stream(bitmap);
+		status = BTranslatorRoster::Default()->Translate(fStillTranslator,
+			&stream, NULL, &file, fStillType);
+		stream.DetachBitmap(&bitmap);
+	}
+	delete bitmap;
+
+	if (status != B_OK) {
+		BString text(B_TRANSLATE("Couldn't save \"%path%\": %error%"));
+		text.ReplaceFirst("%path%", path);
+		text.ReplaceFirst("%error%", strerror(status));
+		_Status(text, true);
+		return;
+	}
+
+	const translation_format* formats;
+	int32 count;
+	if (BTranslatorRoster::Default()->GetOutputFormats(fStillTranslator,
+			&formats, &count) == B_OK) {
+		for (int32 i = 0; i < count; i++) {
+			if (formats[i].type == fStillType) {
+				BNodeInfo(&file).SetType(formats[i].MIME);
+				break;
+			}
+		}
+	}
+	file.Unset();
+	_Deliver(path, trigger);
+}
+
+
+void
+CaptureManager::_FinishClip(BMessage* message)
+{
+	VideoRecorder* recorder;
+	if (message->FindPointer("recorder", (void**)&recorder) != B_OK)
+		return;
+
+	_Status(B_TRANSLATE("Finishing the clip" B_UTF8_ELLIPSIS), false);
+	BString path = recorder->Path();
+	status_t status = recorder->Stop();
+	delete recorder;
+
+	if (status != B_OK) {
+		BString text(B_TRANSLATE("The clip \"%path%\" couldn't be finished: "
+			"%error%"));
+		text.ReplaceFirst("%path%", path);
+		text.ReplaceFirst("%error%", strerror(status));
+		_Status(text, true);
+		return;
+	}
+	_Deliver(path, message->GetString("trigger", kTriggerClip));
+}
+
+
+/*!	A capture is saved: uploaded where that is set up, and then removed
+	unless it is to be kept.
+*/
+void
+CaptureManager::_Deliver(const BString& path, const char* what)
+{
+	BString name(BPath(path.String()).Leaf());
+	if (fTarget.kind == UPLOAD_NONE) {
+		BString text(B_TRANSLATE("Saved \"%name%\"."));
+		text.ReplaceFirst("%name%", name);
+		_Status(text, false);
+		return;
+	}
+
+	BString text(B_TRANSLATE("Uploading \"%name%\"" B_UTF8_ELLIPSIS));
+	text.ReplaceFirst("%name%", name);
+	_Status(text, false);
+
+	BString error;
+	status_t status = upload_file(fTarget, path.String(), name.String(),
+		error);
+	if (status != B_OK) {
+		text = B_TRANSLATE("Saved \"%name%\", but the upload failed: "
+			"%error%");
+		text.ReplaceFirst("%name%", name);
+		text.ReplaceFirst("%error%", error);
+		_Status(text, true);
+		return;
+	}
+
+	if (!fKeepLocal)
+		BEntry(path.String()).Remove();
+	text = fTarget.kind == UPLOAD_FTP
+		? B_TRANSLATE("Uploaded \"%name%\" by FTP.")
+		: B_TRANSLATE("Uploaded \"%name%\" by SFTP.");
+	text.ReplaceFirst("%name%", name);
+	_Status(text, false);
+}
+
+
+void
+CaptureManager::_Status(const char* text, bool error)
+{
+	BMessage message(kMsgCaptureStatus);
+	message.AddString("text", text);
+	message.AddBool("error", error);
+	fWindow.SendMessage(&message);
+}
