@@ -0,0 +1,53 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef MOTION_DETECTOR_H
+#define MOTION_DETECTOR_H
+
+
+#include <SupportDefs.h>
+
+
+/*!	Simple motion detection: the picture as a grid of cells, each the
+	average brightness of a few pixels, compared with a background that
+	follows the picture slowly. A cell whose brightness differs from the
+	background by more than a step (after taking off the change of the whole
+	picture, as when the camera adjusts its exposure) has changed; motion is
+	when more of the picture changed than the sensitivity allows.
+*/
+class MotionDetector {
+public:
+	enum {
+		kColumns = 64,
+		kRows = 48
+	};
+
+								MotionDetector();
+
+			void				Reset();
+			void				SetSensitivity(int32 sensitivity);
+									// 1 (only big changes) to 100
+			int32				Sensitivity() const { return fSensitivity; }
+
+			float				Analyze(const uint8* bits, uint32 width,
+									uint32 height, uint32 bytesPerRow);
+									// B_RGB32; the share of the picture
+									// that changed (0 while warming up)
+			float				Threshold() const;
+									// the share that counts as motion
+			bool				Changed(int32 column, int32 row) const
+									{ return fChanged[row * kColumns
+										+ column]; }
+
+private:
+			int32				fSensitivity;
+			int32				fFrames;
+			int32				fBackground[kRows * kColumns];
+				// brightness * 16
+			uint8				fCurrent[kRows * kColumns];
+			bool				fChanged[kRows * kColumns];
+};
+
+
+#endif	// MOTION_DETECTOR_H
diff --git a/src/apps/neocam/NeoCam.cpp b/src/apps/neocam/NeoCam.cpp
new file mode 100644
index 0000000000..341da2b3ae
--- /dev/null
+++ b/src/apps/neocam/NeoCam.cpp
@@ -0,0 +1,117 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "NeoCam.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+
+#include <Application.h>
+#include <Catalog.h>
+#include <File.h>
+#include <FindDirectory.h>
+#include <Path.h>
+
+#include "CaptureManager.h"
+#include "MainWindow.h"
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "NeoCam"
+
+
+static const char* kSettingsName = "NeoCam settings";
+
+
+status_t
+load_settings(BMessage& settings)
+{
+	BPath path;
+	status_t status = find_directory(B_USER_SETTINGS_DIRECTORY, &path);
+	if (status != B_OK)
+		return status;
+	path.Append(kSettingsName);
+	BFile file(path.Path(), B_READ_ONLY);
+	status = file.InitCheck();
+	if (status != B_OK)
+		return status;
+	return settings.Unflatten(&file);
+}
+
+
+status_t
+save_settings(const BMessage& settings)
+{
+	BPath path;
+	status_t status = find_directory(B_USER_SETTINGS_DIRECTORY, &path);
+	if (status != B_OK)
+		return status;
+	path.Append(kSettingsName);
+	BFile file(path.Path(), B_WRITE_ONLY | B_CREATE_FILE | B_ERASE_FILE);
+	status = file.InitCheck();
+	if (status != B_OK)
+		return status;
+	// the password is in it: for its owner only
+	file.SetPermissions(0600);
+	return settings.Flatten(&file);
+}
+
+
+class NeoCam : public BApplication {
+public:
+	NeoCam()
+		:
+		BApplication(kAppSignature),
+		fCaptureManager(NULL)
+	{
+	}
+
+	virtual void ReadyToRun()
+	{
+		BMessage settings;
+		load_settings(settings);
+
+		// the window gets the capture manager's messages
+		fCaptureManager = new CaptureManager(BMessenger());
+		MainWindow* window = new MainWindow(settings, fCaptureManager);
+		fCaptureManager->SetWindow(BMessenger(window));
+		fCaptureManager->Run();
+		window->Show();
+		window->Start();
+	}
+
+	/*!	What is still being saved or uploaded is finished first. */
+	void FinishCaptures()
+	{
+		if (fCaptureManager == NULL)
+			return;
+		thread_id thread = fCaptureManager->Thread();
+		fCaptureManager->PostMessage(B_QUIT_REQUESTED);
+		status_t result;
+		wait_for_thread(thread, &result);
+		fCaptureManager = NULL;
+	}
+
+private:
+	CaptureManager*		fCaptureManager;
+};
+
+
+int
+main(int argc, char** argv)
+{
+	// started by ssh as its SSH_ASKPASS program (for sftp): the password
+	const char* secret = getenv(kAskPassVariable);
+	if (secret != NULL) {
+		printf("%s\n", secret);
+		return 0;
+	}
+
+	NeoCam app;
+	app.Run();
+	app.FinishCaptures();
+	return 0;
+}
