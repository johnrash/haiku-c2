+
+void
+MainWindow::_CameraReady(BMessage* message)
+{
+	fSizeCount = 0;
+	while (fSizeCount < VIDEO_FRAME_SIZES_MAX) {
+		video_frame_size& size = fSizes[fSizeCount];
+		if (message->FindUInt32("width", fSizeCount, &size.width) != B_OK)
+			break;
+		size.height = message->GetUInt32("height", fSizeCount, 0);
+		size.frame_rate = message->GetFloat("fps", fSizeCount, 0);
+		size.flags = message->GetBool("compressed", fSizeCount, false)
+			? VIDEO_FRAME_SIZE_COMPRESSED : 0;
+		fSizeCount++;
+	}
+	fCurrentSize = message->GetInt32("current", 0);
+
+	fSizeMenu->RemoveItems(0, fSizeMenu->CountItems(), true);
+	for (int32 i = 0; i < fSizeCount; i++) {
+		BString label;
+		if (fSizes[i].width == 0) {
+			label = B_TRANSLATE("The camera's own");
+		} else if (fSizes[i].frame_rate > 0) {
+			label.SetToFormat("%" B_PRIu32 " × %" B_PRIu32 " (%g fps)",
+				fSizes[i].width, fSizes[i].height,
+				roundf(fSizes[i].frame_rate * 10) / 10);
+		} else {
+			label.SetToFormat("%" B_PRIu32 " × %" B_PRIu32,
+				fSizes[i].width, fSizes[i].height);
+		}
+		BMessage* select = new BMessage(kMsgFrameSize);
+		select->AddInt32("index", i);
+		BMenuItem* item = new BMenuItem(label, select);
+		item->SetTarget(this);
+		item->SetMarked(i == fCurrentSize);
+		fSizeMenu->AddItem(item);
+	}
+	if (fCurrentSize >= 0 && fCurrentSize < fSizeCount
+		&& fSizes[fCurrentSize].width != 0) {
+		fWantedWidth = fSizes[fCurrentSize].width;
+		fWantedHeight = fSizes[fCurrentSize].height;
+	}
+
+	fConnected = true;
+	fPreview->SetMessage("");
+	BString text(B_TRANSLATE("Connected to \"%camera%\"."));
+	text.ReplaceFirst("%camera%", message->GetString("name", "?"));
+	_SetStatus(text, false);
+	fInfoView->SetText("");
+	_UpdateClipRateLabel();
+	_UpdateControls();
+}
+
+
+void
+MainWindow::_CameraFailed(BMessage* message)
+{
+	fConnected = false;
+	fRecording = false;
+	fRecordingPending = false;
+	fPreview->SetRecording(false);
+	fPreview->ClearFrame();
+	fPreview->SetMessage(message->GetString("text", ""));
+	fInfoView->SetText("");
+	_UpdateControls();
+}
