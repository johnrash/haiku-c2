+
+BView*
+MainWindow::_CaptureTab()
+{
+	BMessage model(kMsgStillFormat);
+	fStillFormatMenu = new BPopUpMenu(B_TRANSLATE("none"));
+	BTranslationUtils::AddTranslationItems(fStillFormatMenu,
+		B_TRANSLATOR_BITMAP, &model);
+	fStillFormatMenu->SetTargetForItems(this);
+	BMenuField* formatField = new BMenuField("format",
+		B_TRANSLATE("Still format:"), fStillFormatMenu);
+
+	fClipLength = new BSpinner("clip length", B_TRANSLATE("Clip length:"),
+		new BMessage(kMsgSettingChanged));
+	fClipLength->SetRange(1, 3600);
+	fClipLength->SetValue(10);
+	BStringView* seconds = new BStringView("seconds",
