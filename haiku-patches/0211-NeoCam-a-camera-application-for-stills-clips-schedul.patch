diff --git a/src/apps/neocam/MotionDetector.cpp b/src/apps/neocam/MotionDetector.cpp
new file mode 100644
index 0000000000..b5bc56c566
--- /dev/null
+++ b/src/apps/neocam/MotionDetector.cpp
@@ -0,0 +1,121 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "MotionDetector.h"
+
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+// pixels sampled in each cell, across and down
+static const int32 kSamples = 4;
+// the first analyses only build the background
+static const int32 kWarmUpFrames = 10;
+
+
+MotionDetector::MotionDetector()
+	:
+	fSensitivity(50)
+{
+	Reset();
+}
+
+
+void
+MotionDetector::Reset()
+{
+	fFrames = 0;
+	memset(fChanged, 0, sizeof(fChanged));
+}
+
+
+void
+MotionDetector::SetSensitivity(int32 sensitivity)
+{
+	if (sensitivity < 1)
+		sensitivity = 1;
+	if (sensitivity > 100)
+		sensitivity = 100;
+	fSensitivity = sensitivity;
+}
+
+
+/*!	From 30% of the picture at sensitivity 1 to 0.3% at 100. */
+float
+MotionDetector::Threshold() const
+{
+	return 0.30f * powf(0.01f, (fSensitivity - 1) / 99.0f);
+}
+
+
+float
+MotionDetector::Analyze(const uint8* bits, uint32 width, uint32 height,
+	uint32 bytesPerRow)
+{
+	if (width < kColumns || height < kRows)
+		return 0;
+
+	// the cells' brightness
+	int32 total = 0;
+	for (int32 row = 0; row < kRows; row++) {
+		uint32 top = row * height / kRows;
+		uint32 cellHeight = (row + 1) * height / kRows - top;
+		for (int32 column = 0; column < kColumns; column++) {
+			uint32 left = column * width / kColumns;
+			uint32 cellWidth = (column + 1) * width / kColumns - left;
+			uint32 sum = 0;
+			for (int32 sy = 0; sy < kSamples; sy++) {
+				const uint8* line = bits + (size_t)(top
+					+ (2 * sy + 1) * cellHeight / (2 * kSamples)) * bytesPerRow;
+				for (int32 sx = 0; sx < kSamples; sx++) {
+					const uint8* pixel = line + 4 * (left
+						+ (2 * sx + 1) * cellWidth / (2 * kSamples));
+					// B, G, R
+					sum += (29 * pixel[0] + 150 * pixel[1] + 77 * pixel[2])
+						>> 8;
+				}
+			}
+			uint8 brightness = sum / (kSamples * kSamples);
+			fCurrent[row * kColumns + column] = brightness;
+			total += brightness;
+		}
+	}
+
+	const int32 cells = kRows * kColumns;
+	if (fFrames == 0) {
+		for (int32 i = 0; i < cells; i++)
+			fBackground[i] = fCurrent[i] * 16;
+	}
+
+	// the change of the whole picture is not motion
+	int32 backgroundTotal = 0;
+	for (int32 i = 0; i < cells; i++)
+		backgroundTotal += fBackground[i];
+	int32 shift = (total * 16 - backgroundTotal) / cells;
+
+	// a step of 12 brightness levels at sensitivity 100, 52 at 1
+	int32 step = (12 + (100 - fSensitivity) * 40 / 99) * 16;
+	int32 changed = 0;
+	for (int32 i = 0; i < cells; i++) {
+		int32 current = fCurrent[i] * 16;
+		int32 difference = current - fBackground[i] - shift;
+		fChanged[i] = abs(difference) > step;
+		if (fChanged[i])
+			changed++;
+
+		// the background follows: quickly where it is still, slowly where
+		// something moves (something that stays becomes background within
+		// some seconds)
+		fBackground[i] += (current - fBackground[i]) / (fChanged[i] ? 32 : 8);
+	}
+
+	if (++fFrames <= kWarmUpFrames) {
+		memset(fChanged, 0, sizeof(fChanged));
+		return 0;
+	}
+	return (float)changed / cells;
+}
