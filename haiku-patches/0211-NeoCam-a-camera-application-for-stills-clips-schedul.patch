+	settings.AddString("folder", fFolderControl->Text());
+	item = fUploadMenu->FindMarked();
+	settings.AddInt32("upload",
+		item != NULL ? item->Message()->GetInt32("upload", 0) : 0);
+	settings.AddString("server", fServerControl->Text());
+	settings.AddString("user", fUserControl->Text());
+	settings.AddString("password", fPasswordControl->Text());
+	settings.AddString("remote folder", fRemoteFolderControl->Text());
