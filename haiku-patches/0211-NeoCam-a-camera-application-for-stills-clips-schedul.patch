index 0000000000..9a893e2926
--- /dev/null
+++ b/src/apps/neocam/Uploader.cpp
@@ -0,0 +1,647 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "Uploader.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <spawn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <Catalog.h>
+#include <FindDirectory.h>
+#include <Path.h>
+#include <StringList.h>
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "Uploader"
+
+
+extern char** environ;
+
+static const int kTimeout = 15000;
+	// ms, for connecting and for each reply
+
+
+// #pragma mark - FTP
+
+
+namespace {
+
+
+class FtpSession {
+public:
+								FtpSession();
+								~FtpSession();
+
+			status_t			Upload(const UploadTarget& target,
+									const char* localPath,
+									const char* remoteName, BString& error);
+
+private:
+			status_t			_Connect(const char* host, const char* port,
+									int& socketFD, BString& error);
+			bool				_Command(const char* command, int& code,
+									BString* reply = NULL);
+			bool				_Reply(int& code, BString* reply);
+			bool				_ReadLine(BString& line);
+			int					_OpenDataConnection(BString& error);
+			bool				_ChangeFolder(const BString& folder);
+
+			int					fControl;
+			int					fListener;
+			bool				fPassive;
+			char				fBuffer[4096];
+			size_t				fBuffered;
+			BString				fLastReply;
+};
+
+
+FtpSession::FtpSession()
+	:
+	fControl(-1),
+	fListener(-1),
+	fPassive(true),
+	fBuffered(0)
+{
+}
+
+
+FtpSession::~FtpSession()
+{
+	if (fListener >= 0)
+		close(fListener);
+	if (fControl >= 0)
+		close(fControl);
+}
+
+
+status_t
+FtpSession::_Connect(const char* host, const char* port, int& socketFD,
+	BString& error)
+{
+	struct addrinfo hints;
+	memset(&hints, 0, sizeof(hints));
+	hints.ai_family = AF_INET;
+	hints.ai_socktype = SOCK_STREAM;
+	struct addrinfo* addresses;
+	int result = getaddrinfo(host, port, &hints, &addresses);
+	if (result != 0) {
+		error.SetToFormat(B_TRANSLATE("Server %s not found"), host);
+		return B_NAME_NOT_FOUND;
+	}
+
+	status_t status = B_ERROR;
+	for (struct addrinfo* address = addresses; address != NULL;
+			address = address->ai_next) {
+		int fd = socket(address->ai_family, address->ai_socktype,
+			address->ai_protocol);
+		if (fd < 0)
+			continue;
+		// connect without blocking, waiting at most the timeout
+		int flags = fcntl(fd, F_GETFL);
+		fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+		result = connect(fd, address->ai_addr, address->ai_addrlen);
+		if (result < 0 && errno == EINPROGRESS) {
+			struct pollfd poller = { fd, POLLOUT, 0 };
+			if (poll(&poller, 1, kTimeout) == 1) {
+				int socketError = 0;
+				socklen_t length = sizeof(socketError);
+				getsockopt(fd, SOL_SOCKET, SO_ERROR, &socketError, &length);
+				result = socketError == 0 ? 0 : -1;
+				errno = socketError;
+			} else {
+				result = -1;
+				errno = ETIMEDOUT;
+			}
+		}
+		if (result == 0) {
+			fcntl(fd, F_SETFL, flags);
+			socketFD = fd;
+			status = B_OK;
+			break;
+		}
+		status = errno;
+		close(fd);
+	}
+	freeaddrinfo(addresses);
+	if (status != B_OK) {
+		error.SetToFormat(B_TRANSLATE("Couldn't connect to %s: %s"), host,
+			strerror(status));
+	}
+	return status;
+}
+
+
+bool
+FtpSession::_ReadLine(BString& line)
+{
+	line = "";
+	while (true) {
+		for (size_t i = 0; i < fBuffered; i++) {
+			if (fBuffer[i] == '\n') {
+				line.Append(fBuffer, i);
+				line.RemoveAll("\r");
+				memmove(fBuffer, fBuffer + i + 1, fBuffered - i - 1);
+				fBuffered -= i + 1;
+				return true;
+			}
+		}
+		if (fBuffered == sizeof(fBuffer)) {
+			line.Append(fBuffer, fBuffered);
+			fBuffered = 0;
+		}
+		struct pollfd poller = { fControl, POLLIN, 0 };
+		if (poll(&poller, 1, kTimeout) != 1)
+			return false;
+		ssize_t bytes = recv(fControl, fBuffer + fBuffered,
+			sizeof(fBuffer) - fBuffered, 0);
+		if (bytes <= 0)
+			return false;
+		fBuffered += bytes;
+	}
+}
+
+
+/*!	A reply, also one of several lines ("123-..." up to "123 ..."). */
+bool
+FtpSession::_Reply(int& code, BString* reply)
+{
+	BString line;
+	if (!_ReadLine(line) || line.Length() < 3)
+		return false;
+	code = atoi(line.String());
+	if (line.Length() > 3 && line[3] == '-') {
+		BString end;
+		end.SetToFormat("%03d ", code);
+		BString next;
+		do {
+			if (!_ReadLine(next))
+				return false;
+		} while (next.FindFirst(end) != 0);
+		line = next;
+	}
+	fLastReply = line;
+	if (reply != NULL)
+		*reply = line;
+	return true;
+}
+
+
+bool
+FtpSession::_Command(const char* command, int& code, BString* reply)
+{
+	BString line(command);
+	line << "\r\n";
+	if (send(fControl, line.String(), line.Length(), 0) != line.Length())
+		return false;
+	return _Reply(code, reply);
+}
+
+
+/*!	Passive: to the port the server gives, on the address the control
+	connection goes to (the address in the reply can be one behind a
+	router). Active: a port of ours the server connects to.
+*/
+int
+FtpSession::_OpenDataConnection(BString& error)
+{
+	int code;
+	BString reply;
+	if (fPassive) {
+		if (!_Command("PASV", code, &reply) || code != 227) {
+			error.SetToFormat(B_TRANSLATE("The server refused passive mode: "
+				"%s"), fLastReply.String());
+			return -1;
+		}
+		int32 open = reply.FindFirst('(');
+		unsigned int h1, h2, h3, h4, p1, p2;
+		if (open < 0 || sscanf(reply.String() + open + 1, "%u,%u,%u,%u,%u,%u",
+				&h1, &h2, &h3, &h4, &p1, &p2) != 6) {
+			error.SetToFormat(B_TRANSLATE("Unexpected reply: %s"),
+				reply.String());
+			return -1;
+		}
+		// the control connection's server: what the server says may be an
+		// address behind a router
+		struct sockaddr_in server;
+		socklen_t length = sizeof(server);
+		getpeername(fControl, (struct sockaddr*)&server, &length);
+		char host[INET_ADDRSTRLEN];
+		inet_ntop(AF_INET, &server.sin_addr, host, sizeof(host));
+		char port[8];
+		snprintf(port, sizeof(port), "%u", p1 * 256 + p2);
+		int fd;
+		if (_Connect(host, port, fd, error) != B_OK)
+			return -1;
+		return fd;
+	}
+
+	// active: listen where the control connection is ours
+	struct sockaddr_in local;
+	socklen_t length = sizeof(local);
+	getsockname(fControl, (struct sockaddr*)&local, &length);
+	fListener = socket(AF_INET, SOCK_STREAM, 0);
+	local.sin_port = 0;
+	if (fListener < 0
+		|| bind(fListener, (struct sockaddr*)&local, sizeof(local)) != 0
+		|| listen(fListener, 1) != 0) {
+		error = B_TRANSLATE("Couldn't open a port for active FTP");
+		return -1;
+	}
+	length = sizeof(local);
+	getsockname(fListener, (struct sockaddr*)&local, &length);
+	uint32 address = ntohl(local.sin_addr.s_addr);
+	uint16 port = ntohs(local.sin_port);
+	BString command;
+	command.SetToFormat("PORT %u,%u,%u,%u,%u,%u", (address >> 24) & 0xff,
+		(address >> 16) & 0xff, (address >> 8) & 0xff, address & 0xff,
+		port >> 8, port & 0xff);
+	if (!_Command(command, code) || code != 200) {
+		error.SetToFormat(B_TRANSLATE("The server refused active mode: %s"),
+			fLastReply.String());
+		return -1;
+	}
+	return fListener;
+		// accepted once the transfer command is sent
+}
+
+
+/*!	Into the folder, making it (and its parents) where they are missing. */
+bool
+FtpSession::_ChangeFolder(const BString& folder)
+{
+	int code;
+	if (folder.Length() == 0)
+		return true;
+	BString command("CWD ");
+	command << folder;
+	if (_Command(command, code) && code / 100 == 2)
+		return true;
+
+	// one level at a time
+	BString path(folder);
+	if (path[0] == '/') {
+		if (!_Command("CWD /", code) || code / 100 != 2)
+			return false;
+	}
+	int32 start = 0;
+	while (start < path.Length()) {
+		int32 end = path.FindFirst('/', start);
+		if (end < 0)
+			end = path.Length();
+		BString part;
+		path.CopyInto(part, start, end - start);
+		start = end + 1;
+		if (part.Length() == 0)
+			continue;
+		command = "CWD ";
+		command << part;
+		if (_Command(command, code) && code / 100 == 2)
+			continue;
+		command = "MKD ";
+		command << part;
+		_Command(command, code);
+		command = "CWD ";
+		command << part;
+		if (!_Command(command, code) || code / 100 != 2)
+			return false;
+	}
+	return true;
+}
+
+
+status_t
+FtpSession::Upload(const UploadTarget& target, const char* localPath,
+	const char* remoteName, BString& error)
+{
+	fPassive = target.passive;
+
+	BString host(target.server);
+	BString port("21");
+	int32 colon = host.FindLast(':');
+	if (colon > 0) {
+		host.CopyInto(port, colon + 1, host.Length() - colon - 1);
+		host.Truncate(colon);
+	}
+	status_t status = _Connect(host, port, fControl, error);
+	if (status != B_OK)
+		return status;
+
+	int code;
+	if (!_Reply(code, NULL) || code / 100 != 2) {
+		error.SetToFormat(B_TRANSLATE("The server refused the connection: "
+			"%s"), fLastReply.String());
+		return B_ERROR;
+	}
+
+	BString command("USER ");
+	command << (target.user.Length() > 0 ? target.user.String()
+		: "anonymous");
+	if (!_Command(command, code)) {
+		error = B_TRANSLATE("The server closed the connection");
+		return B_ERROR;
+	}
+	if (code == 331) {
+		command = "PASS ";
+		command << target.password;
+		if (!_Command(command, code)) {
+			error = B_TRANSLATE("The server closed the connection");
+			return B_ERROR;
+		}
+	}
+	if (code != 230 && code != 202) {
+		error.SetToFormat(B_TRANSLATE("Login refused: %s"),
+			fLastReply.String());
+		return B_PERMISSION_DENIED;
+	}
+
+	if (!_Command("TYPE I", code) || code / 100 != 2) {
+		error.SetToFormat(B_TRANSLATE("The server refused binary mode: %s"),
+			fLastReply.String());
+		return B_ERROR;
+	}
+	if (!_ChangeFolder(target.folder)) {
+		error.SetToFormat(B_TRANSLATE("Couldn't open or make the folder "
+			"%s: %s"), target.folder.String(), fLastReply.String());
+		return B_ENTRY_NOT_FOUND;
+	}
+
+	int file = open(localPath, O_RDONLY);
+	if (file < 0) {
+		error.SetToFormat(B_TRANSLATE("Couldn't read %s"), localPath);
+		return errno;
+	}
+
+	int data = _OpenDataConnection(error);
+	if (data < 0) {
+		close(file);
+		return B_ERROR;
+	}
+	command = "STOR ";
+	command << remoteName;
+	if (!_Command(command, code) || (code != 150 && code != 125)) {
+		error.SetToFormat(B_TRANSLATE("The server refused the file: %s"),
+			fLastReply.String());
+		close(file);
+		close(data);
+		fListener = -1;
+		return B_ERROR;
+	}
+	if (!fPassive) {
+		struct pollfd poller = { data, POLLIN, 0 };
+		int accepted = -1;
+		if (poll(&poller, 1, kTimeout) == 1)
+			accepted = accept(data, NULL, NULL);
+		close(data);
+		fListener = -1;
+		if (accepted < 0) {
+			error = B_TRANSLATE("The server didn't connect for active FTP");
+			close(file);
+			return B_TIMED_OUT;
+		}
+		data = accepted;
+	}
+
+	status = B_OK;
+	char buffer[65536];
+	ssize_t bytes;
+	while ((bytes = read(file, buffer, sizeof(buffer))) > 0) {
+		ssize_t sent = 0;
+		while (sent < bytes) {
+			ssize_t chunk = send(data, buffer + sent, bytes - sent, 0);
+			if (chunk <= 0) {
+				status = errno;
+				break;
+			}
+			sent += chunk;
+		}
+		if (status != B_OK)
+			break;
+	}
+	close(file);
+	close(data);
+
+	if (status != B_OK) {
+		error.SetToFormat(B_TRANSLATE("The transfer broke off: %s"),
+			strerror(status));
+		return status;
+	}
+	if (!_Reply(code, NULL) || code / 100 != 2) {
+		error.SetToFormat(B_TRANSLATE("The server didn't take the file: %s"),
+			fLastReply.String());
+		return B_ERROR;
+	}
+	_Command("QUIT", code);
+	return B_OK;
+}
+
+
+}	// namespace
+
+
+// #pragma mark - SFTP
+
+
+/*!	A name or path as one argument of an sftp batch command. */
+static BString
+sftp_quote(const char* text)
+{
+	BString quoted(text);
+	quoted.CharacterEscape("\\\"", '\\');
+	quoted.Prepend("\"");
+	quoted.Append("\"");
+	return quoted;
+}
+
+
+static status_t
+sftp_upload(const UploadTarget& target, const char* localPath,
+	const char* remoteName, BString& error)
+{
+	// the commands, in a file of their own
+	BPath batchPath;
+	find_directory(B_SYSTEM_TEMP_DIRECTORY, &batchPath);
+	BString batchName;
+	batchName.SetToFormat("neocam-sftp-%" B_PRId32, find_thread(NULL));
+	batchPath.Append(batchName);
+	FILE* batch = fopen(batchPath.Path(), "w");
+	if (batch == NULL) {
+		error = B_TRANSLATE("Couldn't write the sftp commands");
+		return errno;
+	}
+	if (target.folder.Length() > 0) {
+		// "-": a folder that is there already is no error; then each level
+		BString path(target.folder);
+		BString made;
+		if (path[0] == '/')
+			made = "/";
+		int32 start = 0;
+		while (start < path.Length()) {
+			int32 end = path.FindFirst('/', start);
+			if (end < 0)
+				end = path.Length();
+			BString part;
+			path.CopyInto(part, start, end - start);
+			start = end + 1;
+			if (part.Length() == 0)
+				continue;
+			if (made.Length() > 0 && made[made.Length() - 1] != '/')
+				made << "/";
+			made << part;
+			fprintf(batch, "-mkdir %s\n", sftp_quote(made).String());
+		}
+		fprintf(batch, "cd %s\n", sftp_quote(target.folder).String());
+	}
+	fprintf(batch, "put %s %s\n", sftp_quote(localPath).String(),
+		sftp_quote(remoteName).String());
+	fclose(batch);
+
+	BString host(target.server);
+	BString port;
+	int32 colon = host.FindLast(':');
+	if (colon > 0) {
+		host.CopyInto(port, colon + 1, host.Length() - colon - 1);
+		host.Truncate(colon);
+	}
+	BString destination;
+	if (target.user.Length() > 0)
+		destination << target.user << "@";
+	destination << host;
+
+	// sftp -b turns batch mode on in ssh, which would leave out the password
+	// prompt: the first value of an option counts, so it is turned off first
+	BString portOption("-oPort=");
+	portOption << (port.Length() > 0 ? port.String() : "22");
+	const char* arguments[] = {
+		"sftp",
+		"-oBatchMode=no",
+		"-oStrictHostKeyChecking=accept-new",
+		"-oConnectTimeout=15",
+		"-oNumberOfPasswordPrompts=1",
+		"-oServerAliveInterval=15",
+		portOption.String(),
+		"-b", batchPath.Path(),
+		destination.String(),
+		NULL
+	};
+
+	// the environment: ssh asks NeoCam (as SSH_ASKPASS) for the password
+	BStringList variables;
+	for (char** variable = environ; *variable != NULL; variable++) {
+		if (strncmp(*variable, "SSH_ASKPASS", 11) != 0
+			&& strncmp(*variable, kAskPassVariable "=",
+				strlen(kAskPassVariable) + 1) != 0) {
+			variables.Add(*variable);
+		}
+	}
+	BString variable;
+	variable.SetToFormat("SSH_ASKPASS=%s", target.askPassProgram.String());
+	variables.Add(variable);
+	variables.Add("SSH_ASKPASS_REQUIRE=force");
+	variable.SetToFormat("%s=%s", kAskPassVariable,
+		target.password.String());
+	variables.Add(variable);
+	const char** environment = new const char*[variables.CountStrings() + 1];
+	for (int32 i = 0; i < variables.CountStrings(); i++)
+		environment[i] = variables.StringAt(i).String();
+	environment[variables.CountStrings()] = NULL;
+
+	// what sftp says goes into a pipe, for the error
+	int output[2];
+	if (pipe(output) != 0) {
+		delete[] environment;
+		unlink(batchPath.Path());
+		error = B_TRANSLATE("Couldn't start sftp");
+		return errno;
+	}
+	posix_spawn_file_actions_t actions;
+	posix_spawn_file_actions_init(&actions);
+	posix_spawn_file_actions_addopen(&actions, 0, "/dev/null", O_RDONLY, 0);
+	posix_spawn_file_actions_adddup2(&actions, output[1], 1);
+	posix_spawn_file_actions_adddup2(&actions, output[1], 2);
+	posix_spawn_file_actions_addclose(&actions, output[0]);
+	posix_spawn_file_actions_addclose(&actions, output[1]);
+
+	pid_t child;
+	int result = posix_spawnp(&child, "sftp", &actions, NULL,
+		(char* const*)arguments, (char* const*)environment);
+	posix_spawn_file_actions_destroy(&actions);
+	delete[] environment;
+	close(output[1]);
+	if (result != 0) {
+		close(output[0]);
+		unlink(batchPath.Path());
+		error = B_TRANSLATE("Couldn't start sftp");
+		return result;
+	}
+
+	BString said;
+	char buffer[1024];
+	ssize_t bytes;
+	while ((bytes = read(output[0], buffer, sizeof(buffer))) > 0)
+		said.Append(buffer, bytes);
+	close(output[0]);
+	int childStatus = 0;
+	waitpid(child, &childStatus, 0);
+	unlink(batchPath.Path());
+
+	if (WIFEXITED(childStatus) && WEXITSTATUS(childStatus) == 0)
+		return B_OK;
+
+	// the last line that isn't sftp's echo of a command
+	said.RemoveAll("\r");
+	BString reason;
+	int32 end = said.Length();
+	while (end > 0 && reason.Length() == 0) {
+		int32 start = said.FindLast('\n', end - 1) + 1;
+		BString line;
+		said.CopyInto(line, start, end - start);
+		line.Trim();
+		if (line.Length() > 0 && line.FindFirst("sftp>") != 0)
+			reason = line;
+		end = start - 1;
+	}
+	if (reason.Length() == 0)
+		reason = B_TRANSLATE("sftp failed");
+	error = reason;
+	return B_ERROR;
+}
+
+
+// #pragma mark -
+
+
+status_t
+upload_file(const UploadTarget& target, const char* localPath,
+	const char* remoteName, BString& error)
+{
+	if (target.server.Length() == 0) {
+		error = B_TRANSLATE("No server given");
+		return B_BAD_VALUE;
+	}
+	switch (target.kind) {
+		case UPLOAD_FTP:
+		{
+			FtpSession session;
+			return session.Upload(target, localPath, remoteName, error);
+		}
+		case UPLOAD_SFTP:
+			return sftp_upload(target, localPath, remoteName, error);
+		default:
+			return B_BAD_VALUE;
+	}
+}
