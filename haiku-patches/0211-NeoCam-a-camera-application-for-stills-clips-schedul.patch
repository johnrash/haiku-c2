+	item = fScheduleUnitMenu->FindMarked();
+	settings.AddInt32("schedule unit",
+		item != NULL ? item->Message()->GetInt32("unit", 1) : 1);
+	settings.AddBool("schedule clip", fScheduleClip->Value() == B_CONTROL_ON);
