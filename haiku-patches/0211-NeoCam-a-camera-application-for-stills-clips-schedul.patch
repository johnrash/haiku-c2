+
+bigtime_t
+MainWindow::_ScheduleInterval() const
+{
+	static const bigtime_t kUnits[] = { 1000000, 60000000, 3600000000LL };
+	BMenuItem* item = fScheduleUnitMenu->FindMarked();
+	int32 unit = item != NULL ? item->Message()->GetInt32("unit", 1) : 1;
+	if (unit < 0 || unit > 2)
+		unit = 1;
+	return fScheduleEvery->Value() * kUnits[unit];
+}
+
+
+/*!	The camera's rate as far as the encoder keeps up at this frame size. */
+float
+MainWindow::_AutoClipFrameRate() const
+{
+	float cameraRate = 30;
+	uint32 pixels = 640 * 480;
+	if (fCurrentSize >= 0 && fCurrentSize < fSizeCount) {
+		if (fSizes[fCurrentSize].frame_rate > 0)
+			cameraRate = fSizes[fCurrentSize].frame_rate;
+		if (fSizes[fCurrentSize].width > 0) {
+			pixels = fSizes[fCurrentSize].width
+				* fSizes[fCurrentSize].height;
+		}
+	}
+
+	float budget = kEncodePixelsPerSecond / pixels;
+	for (size_t i = 0; i < sizeof(kClipRates) / sizeof(kClipRates[0]); i++) {
+		if (kClipRates[i] <= budget && kClipRates[i] <= cameraRate + 0.5f)
+			return kClipRates[i];
+	}
+	return 1;
+}
+
+
+float
+MainWindow::_ClipFrameRate() const
+{
+	BMenuItem* item = fClipRateMenu->FindMarked();
+	float chosen = item != NULL ? item->Message()->GetFloat("fps", 0) : 0;
+	if (chosen <= 0)
+		return _AutoClipFrameRate();
+
+	float cameraRate = 30;
+	if (fCurrentSize >= 0 && fCurrentSize < fSizeCount
+		&& fSizes[fCurrentSize].frame_rate > 0) {
+		cameraRate = fSizes[fCurrentSize].frame_rate;
+	}
+	return fminf(chosen, cameraRate);
+}
+
+
+void
+MainWindow::_UpdateClipRateLabel()
+{
+	// what Auto gives depends on the frame size
+	BMenuItem* item = fClipRateMenu->ItemAt(0);
+	BString label(B_TRANSLATE("Auto"));
+	if (fConnected) {
+		label.SetToFormat(B_TRANSLATE("Auto (%g frames a second)"),
+			_AutoClipFrameRate());
+	}
+	item->SetLabel(label);
+	if (item->IsMarked())
+		item->SetMarked(true);
+}
+
+
+void
+MainWindow::_UpdateControls()
+{
+	bool recording = fRecording || fRecordingPending;
+	fSnapshotButton->SetEnabled(fConnected);
+	fRecordButton->SetEnabled(fConnected || recording);
+	fRecordButton->SetLabel(recording ? B_TRANSLATE("Stop recording")
+		: B_TRANSLATE("Record clip"));
+	fSizeField->SetEnabled(fConnected && !recording);
+
+	BMenuItem* item = fUploadMenu->FindMarked();
+	int32 upload = item != NULL ? item->Message()->GetInt32("upload", 0) : 0;
+	fServerControl->SetEnabled(upload != UPLOAD_NONE);
+	fUserControl->SetEnabled(upload != UPLOAD_NONE);
+	fPasswordControl->SetEnabled(upload != UPLOAD_NONE);
+	fRemoteFolderControl->SetEnabled(upload != UPLOAD_NONE);
+	fPassiveBox->SetEnabled(upload == UPLOAD_FTP);
+	fKeepLocalBox->SetEnabled(upload != UPLOAD_NONE);
+	fTestButton->SetEnabled(upload != UPLOAD_NONE);
+
+	bool schedule = fScheduleBox->Value() == B_CONTROL_ON;
+	fScheduleEvery->SetEnabled(schedule);
+	fScheduleStill->SetEnabled(schedule);
+	fScheduleClip->SetEnabled(schedule);
+
+	bool motion = fMotionBox->Value() == B_CONTROL_ON;
+	fSensitivity->SetEnabled(motion);
+	fMotionStill->SetEnabled(motion);
+	fMotionClip->SetEnabled(motion);
+	fMotionWait->SetEnabled(motion);
+	fShowMotionBox->SetEnabled(motion);
+}
+
+
+void
+MainWindow::_SetStatus(const char* text, bool error)
+{
+	fStatusView->SetText(text);
+	if (error)
+		fStatusView->SetHighColor(200, 30, 30);
+	else
+		fStatusView->SetHighUIColor(B_PANEL_TEXT_COLOR);
+	fStatusView->Invalidate();
+}
+
+
+void
+MainWindow::_ShowCameraSettings()
+{
+	if (fController == NULL)
+		return;
+	BMessage reply;
+	if (BMessenger(fController).SendMessage(CameraController::kMsgGetWeb,
+			&reply) != B_OK) {
+		return;
+	}
+	BParameterWeb* web = NULL;
+	reply.FindPointer("web", (void**)&web);
+	if (web == NULL) {
+		_SetStatus(B_TRANSLATE("The camera has no settings to show."), true);
+		return;
+	}
+	(new CameraSettingsWindow(web))->Show();
+}
+
+
+void
+MainWindow::_OpenFolder()
+{
+	BString folder(fFolderControl->Text());
+	create_directory(folder.String(), 0755);
+	entry_ref ref;
+	if (get_ref_for_path(folder.String(), &ref) == B_OK)
+		be_roster->Launch(&ref);
+}
