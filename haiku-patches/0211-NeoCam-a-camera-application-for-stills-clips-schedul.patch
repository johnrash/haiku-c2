new file mode 100644
index 0000000000..6a610504d5
--- /dev/null
+++ b/src/apps/neocam/PreviewView.cpp
@@ -0,0 +1,236 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "PreviewView.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <Bitmap.h>
+#include <Catalog.h>
+#include <OS.h>
+#include <Region.h>
+
+
+#undef B_TRANSLATION_CONTEXT
+#define B_TRANSLATION_CONTEXT "PreviewView"
+
+
+PreviewView::PreviewView()
+	:
+	BView("preview", B_WILL_DRAW | B_FULL_UPDATE_ON_RESIZE
+		| B_FRAME_EVENTS),
+	fBitmap(NULL),
+	fRecording(false),
+	fRecordingStarted(0),
+	fMotion(false),
+	fShowCells(false),
+	fClearBackground(true)
+{
+	SetViewColor(B_TRANSPARENT_COLOR);
+	SetExplicitMinSize(BSize(320, 180));
+	memset(fCells, 0, sizeof(fCells));
+}
+
+
+void
+PreviewView::Draw(BRect updateRect)
+{
+	fClearBackground = true;
+	_DrawPicture();
+}
+
+
+void
+PreviewView::FrameResized(float width, float height)
+{
+	fClearBackground = true;
+	Invalidate();
+}
+
+
+void
+PreviewView::DrawFrame(BBitmap* bitmap)
+{
+	if (bitmap != fBitmap) {
+		if (fBitmap == NULL || bitmap == NULL
+			|| fBitmap->Bounds() != bitmap->Bounds()) {
+			fClearBackground = true;
+		}
+		fBitmap = bitmap;
+	}
+	_DrawPicture();
+	Flush();
+}
+
+
+void
+PreviewView::ClearFrame()
+{
+	fBitmap = NULL;
+	fClearBackground = true;
+	Invalidate();
+}
+
+
+void
+PreviewView::SetMessage(const char* message)
+{
+	fMessage = message;
+	Invalidate();
+}
+
+
+void
+PreviewView::SetRecording(bool recording, bigtime_t started)
+{
+	fRecording = recording;
+	fRecordingStarted = started;
+	if (fBitmap == NULL)
+		Invalidate();
+}
+
+
+void
+PreviewView::SetMotion(const MotionDetector* detector, bool motion,
+	bool showCells)
+{
+	fMotion = motion;
+	fShowCells = showCells;
+	if (!showCells) {
+		memset(fCells, 0, sizeof(fCells));
+		return;
+	}
+	if (detector == NULL)
+		return;
+	for (int32 row = 0; row < MotionDetector::kRows; row++) {
+		for (int32 column = 0; column < MotionDetector::kColumns; column++) {
+			fCells[row * MotionDetector::kColumns + column]
+				= detector->Changed(column, row);
+		}
+	}
+}
+
+
+BRect
+PreviewView::_PictureRect(BBitmap* bitmap) const
+{
+	BRect bounds = Bounds();
+	float width = bounds.Width() + 1;
+	float height = bounds.Height() + 1;
+	float pictureWidth = bitmap->Bounds().Width() + 1;
+	float pictureHeight = bitmap->Bounds().Height() + 1;
+
+	float scale = width / pictureWidth;
+	if (pictureHeight * scale > height)
+		scale = height / pictureHeight;
+	float shownWidth = floorf(pictureWidth * scale);
+	float shownHeight = floorf(pictureHeight * scale);
+	float left = floorf((width - shownWidth) / 2);
+	float top = floorf((height - shownHeight) / 2);
+	return BRect(left, top, left + shownWidth - 1, top + shownHeight - 1);
+}
+
+
+void
+PreviewView::_DrawPicture()
+{
+	BRect bounds = Bounds();
+	if (fBitmap == NULL) {
+		SetHighColor(32, 32, 36);
+		FillRect(bounds);
+		SetHighColor(220, 220, 220);
+		SetLowColor(32, 32, 36);
+		const char* message = fMessage.Length() > 0 ? fMessage.String()
+			: B_TRANSLATE("Connecting to the camera" B_UTF8_ELLIPSIS);
+		font_height fontHeight;
+		GetFontHeight(&fontHeight);
+		float width = StringWidth(message);
+		DrawString(message, BPoint((bounds.Width() - width) / 2,
+			bounds.Height() / 2 + fontHeight.ascent / 2));
+		return;
+	}
+
+	BRect picture = _PictureRect(fBitmap);
+	if (fClearBackground) {
+		// the bars around the picture
+		SetHighColor(0, 0, 0);
+		BRegion bars(bounds);
+		bars.Exclude(picture);
+		FillRegion(&bars);
+		fClearBackground = false;
+	}
+
+	DrawBitmap(fBitmap, fBitmap->Bounds(), picture);
+	_DrawOverlays(picture);
+}
+
+
+void
+PreviewView::_DrawOverlays(BRect picture)
+{
+	if (fShowCells) {
+		SetDrawingMode(B_OP_ALPHA);
+		SetHighColor(255, 40, 40, 90);
+		float cellWidth = picture.Width() / MotionDetector::kColumns;
+		float cellHeight = picture.Height() / MotionDetector::kRows;
+		for (int32 row = 0; row < MotionDetector::kRows; row++) {
+			for (int32 column = 0; column < MotionDetector::kColumns;
+					column++) {
+				if (!fCells[row * MotionDetector::kColumns + column])
+					continue;
+				BRect cell(picture.left + column * cellWidth,
+					picture.top + row * cellHeight,
+					picture.left + (column + 1) * cellWidth - 1,
+					picture.top + (row + 1) * cellHeight - 1);
+				FillRect(cell);
+			}
+		}
+		SetDrawingMode(B_OP_COPY);
+	}
+
+	font_height fontHeight;
+	GetFontHeight(&fontHeight);
+	float lineHeight = ceilf(fontHeight.ascent + fontHeight.descent);
+	float x = picture.left + 8;
+	float y = picture.top + 8;
+
+	if (fRecording) {
+		int32 seconds = (system_time() - fRecordingStarted) / 1000000;
+		char text[32];
+		snprintf(text, sizeof(text), "REC %02" B_PRId32 ":%02" B_PRId32,
+			seconds / 60, seconds % 60);
+		float width = StringWidth(text);
+		SetDrawingMode(B_OP_ALPHA);
+		SetHighColor(0, 0, 0, 140);
+		FillRoundRect(BRect(x, y, x + lineHeight + width + 10,
+			y + lineHeight + 4), 4, 4);
+		SetDrawingMode(B_OP_COPY);
+		SetHighColor(230, 30, 30);
+		float radius = lineHeight / 2 - 2;
+		FillEllipse(BPoint(x + 4 + radius, y + 2 + lineHeight / 2), radius,
+			radius);
+		SetDrawingMode(B_OP_OVER);
+		SetHighColor(255, 255, 255);
+		DrawString(text, BPoint(x + lineHeight + 4,
+			y + 2 + fontHeight.ascent));
+		SetDrawingMode(B_OP_COPY);
+		y += lineHeight + 8;
+	}
+
+	if (fMotion) {
+		const char* text = B_TRANSLATE("Motion");
+		float width = StringWidth(text);
+		SetDrawingMode(B_OP_ALPHA);
+		SetHighColor(200, 120, 0, 200);
+		FillRoundRect(BRect(x, y, x + width + 8, y + lineHeight + 4), 4, 4);
+		SetDrawingMode(B_OP_OVER);
+		SetHighColor(255, 255, 255);
+		DrawString(text, BPoint(x + 4, y + 2 + fontHeight.ascent));
+		SetDrawingMode(B_OP_COPY);
+	}
+}
