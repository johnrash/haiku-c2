+void
+MainWindow::_StartClip(const char* trigger)
+{
+	if (!fConnected || fRecording || fRecordingPending)
+		return;
+
+	BString folder(fFolderControl->Text());
+	create_directory(folder.String(), 0755);
+	BString path = CaptureManager::CapturePath(folder.String(), trigger,
+		"mkv", real_time_clock());
+
+	BMessage start(CameraController::kMsgStartRecording);
+	start.AddString("path", path);
+	start.AddFloat("fps", _ClipFrameRate());
+	start.AddString("trigger", trigger);
+	BMessenger(fController).SendMessage(&start);
+	fRecordingPending = true;
+	fRecordTrigger = trigger;
+	fRecordEnd = system_time() + (bigtime_t)fClipLength->Value() * 1000000;
+	_UpdateControls();
+}
+
+
+void
+MainWindow::_RecordingStarted(BMessage* message)
+{
+	fRecordingPending = false;
+	status_t status = message->GetInt32("status", B_ERROR);
+	if (status != B_OK) {
+		BString text(B_TRANSLATE("The clip couldn't be started: %error%"));
+		text.ReplaceFirst("%error%", strerror(status));
+		_SetStatus(text, true);
+		fRecording = false;
+		_UpdateControls();
+		return;
+	}
+	fRecording = true;
+	fPreview->SetRecording(true, system_time());
+	BString text(B_TRANSLATE("Recording \"%name%\"" B_UTF8_ELLIPSIS));
+	text.ReplaceFirst("%name%", BPath(message->GetString("path", "")).Leaf());
+	_SetStatus(text, false);
+	_UpdateControls();
+}
+
+
+void
+MainWindow::_StopClip()
+{
+	if (!fRecording && !fRecordingPending)
+		return;
+	BMessenger(fController).SendMessage(CameraController::kMsgStopRecording);
+	fRecording = false;
+	fRecordingPending = false;
+	fPreview->SetRecording(false);
+	if (fRecordTrigger == kTriggerMotion) {
+		fNextMotionCapture = system_time()
+			+ (bigtime_t)fMotionWait->Value() * 1000000;
+	}
+	_UpdateControls();
+}
+
+
+void
+MainWindow::_Pulse()
+{
+	bigtime_t now = system_time();
+
+	if (fRecording && fRecordEnd > 0 && now >= fRecordEnd)
+		_StopClip();
+
+	if (fScheduleBox->Value() == B_CONTROL_ON && fConnected) {
+		if (now >= fNextSchedule) {
+			if (fScheduleClip->Value() == B_CONTROL_ON) {
+				if (fRecording || fRecordingPending) {
+					_SetStatus(B_TRANSLATE("A scheduled clip was left out: "
+						"a clip is being recorded."), true);
+				} else
+					_StartClip(kTriggerSchedule);
+			} else
+				_TakeStill(kTriggerSchedule);
+			fNextSchedule += _ScheduleInterval();
+			if (fNextSchedule <= now)
+				fNextSchedule = now + _ScheduleInterval();
+		}
+		time_t next = real_time_clock() + (fNextSchedule - now + 999999)
+			/ 1000000;
+		struct tm local;
+		localtime_r(&next, &local);
+		char clock[32];
+		strftime(clock, sizeof(clock), "%X", &local);
+		BString text(B_TRANSLATE("The next capture is at %time%."));
+		text.ReplaceFirst("%time%", clock);
+		fNextView->SetText(text);
+	} else if (fScheduleBox->Value() == B_CONTROL_ON)
+		fNextView->SetText(B_TRANSLATE("Waiting for the camera."));
+	else
+		fNextView->SetText("");
+
+	// the recording time in the picture, also without frames
+	if (fRecording)
+		fPreview->Invalidate(BRect(0, 0, 200, 60));
+}
+
+
+void
+MainWindow::_Motion(BMessage* message)
+{
+	if (fMotionBox->Value() != B_CONTROL_ON)
+		return;
+	float level = message->GetFloat("level", 0);
+	bool motion = message->GetBool("motion", false);
+	fMeter->SetLevel(level, message->GetFloat("threshold", 0), motion);
+	fMotionNow = motion;
+	if (!motion || !fConnected)
+		return;
+
+	bigtime_t now = system_time();
+	bool clip = fMotionClip->Value() == B_CONTROL_ON;
+	if (clip && fRecording && fRecordTrigger == kTriggerMotion) {
+		// it goes on: so does the clip
+		bigtime_t end = now + (bigtime_t)fClipLength->Value() * 1000000;
+		if (end > fRecordEnd)
+			fRecordEnd = end;
+		return;
+	}
+	if (now < fNextMotionCapture)
+		return;
+
+	if (clip) {
+		if (fRecording || fRecordingPending)
+			return;
+		_StartClip(kTriggerMotion);
+	} else {
+		_TakeStill(kTriggerMotion);
+		fNextMotionCapture = now + (bigtime_t)fMotionWait->Value() * 1000000;
+	}
+}
