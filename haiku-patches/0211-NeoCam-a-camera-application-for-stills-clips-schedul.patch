+// #pragma mark - MotionMeter
+
+
+/*!	How much of the picture changed, as a bar with the share that counts as
+	motion marked; on a square root scale up to half the picture.
+*/
+class MotionMeter : public BView {
+public:
+	MotionMeter()
+		:
+		BView("motion meter", B_WILL_DRAW),
+		fLevel(0),
+		fThreshold(0.03f),
+		fMotion(false)
+	{
+		SetExplicitMinSize(BSize(120, 14));
+		SetExplicitMaxSize(BSize(B_SIZE_UNLIMITED, 14));
+	}
+
+	void SetLevel(float level, float threshold, bool motion)
+	{
+		fLevel = level;
+		fThreshold = threshold;
+		fMotion = motion;
+		Invalidate();
+	}
+
+	virtual void Draw(BRect updateRect)
+	{
+		BRect bounds = Bounds();
+		SetHighColor(tint_color(ui_color(B_PANEL_BACKGROUND_COLOR),
+			B_DARKEN_2_TINT));
+		StrokeRect(bounds);
+		bounds.InsetBy(1, 1);
+		SetHighColor(40, 40, 44);
+		FillRect(bounds);
+
+		float filled = _Position(fLevel, bounds);
+		if (filled > bounds.left) {
+			if (fMotion)
+				SetHighColor(230, 120, 20);
+			else
+				SetHighColor(80, 170, 90);
+			FillRect(BRect(bounds.left, bounds.top, filled, bounds.bottom));
+		}
+		float mark = _Position(fThreshold, bounds);
+		SetHighColor(255, 255, 255);
+		StrokeLine(BPoint(mark, bounds.top), BPoint(mark, bounds.bottom));
+	}
+
+private:
+	float _Position(float share, BRect bounds) const
+	{
+		float scaled = sqrtf(fmaxf(0, fminf(share / 0.5f, 1)));
+		return bounds.left + scaled * bounds.Width();
+	}
+
+	float				fLevel;
+	float				fThreshold;
+	bool				fMotion;
+};
