+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef CAMERA_CONTROLLER_H
+#define CAMERA_CONTROLLER_H
+
+
+#include <Looper.h>
+#include <MediaNode.h>
+#include <Messenger.h>
+#include <String.h>
+
+#include <VideoFrameSizes.h>
+
+
+class BMediaRoster;
+class BParameterWeb;
+class CameraConsumer;
+class PreviewView;
+
+
+/*!	Connects the default video input to NeoCam's node at the frame size
+	asked for, and changes it, in a thread of its own: the media roster's
+	calls wait for the nodes. Tells the window when the camera is ready (with
+	its frame sizes) or why it isn't. With no camera, it connects when one
+	appears.
+*/
+class CameraController : public BLooper {
+public:
+	enum {
+		kMsgConnect			= 'ccon',	// "width", "height"
+		kMsgDisconnect		= 'cdis',	// replied to when done
+		kMsgGetWeb			= 'cweb',	// reply: "web" (pointer, the
+										// caller deletes it), "node"
+		kMsgTakeStill		= 'ctst',	// "trigger"
+		kMsgStartRecording	= 'cstr',	// "path", "fps", "trigger"; the
+										// window hears how it went
+		kMsgStopRecording	= 'cstp',	// the clip goes to the capture
+										// manager
+		kMsgSetMotion		= 'cmot'	// "enabled", "sensitivity", "show"
+	};
+
+								CameraController(PreviewView* view,
+									const BMessenger& window,
+									const BMessenger& captureManager);
+	virtual						~CameraController();
+
+	virtual	void				MessageReceived(BMessage* message);
+
+private:
+			status_t			_Connect(uint32 width, uint32 height);
+			void				_Disconnect(bool releaseConsumer);
+			void				_FinishRecording(const char* trigger);
+			status_t			_QueryFrameSizes();
+			int32				_ChooseSize(uint32 width,
+									uint32 height) const;
+			void				_Failed(const char* text, status_t status);
+
+			PreviewView*		fView;
+			BMessenger			fWindow;
+			BMessenger			fCaptureManager;
+			BMediaRoster*		fRoster;
+			media_node			fTimeSource;
+			media_node			fProducer;
+			bool				fHasProducer;
+			CameraConsumer*		fConsumer;
+			media_output		fOutput;
+			media_input			fInput;
+			bool				fConnected;
+			bool				fWatching;
+			video_frame_size	fSizes[VIDEO_FRAME_SIZES_MAX];
+			int32				fSizeCount;
+			uint32				fWantedWidth;
+			uint32				fWantedHeight;
+			bool				fMotionEnabled;
+			int32				fMotionSensitivity;
+			bool				fShowMotion;
+			BString				fClipTrigger;
+};
+
+
+#endif	// CAMERA_CONTROLLER_H
