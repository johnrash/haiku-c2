+void
+MainWindow::_ApplySettings(const BMessage& settings)
+{
+	BRect frame;
+	if (settings.FindRect("window frame", &frame) == B_OK) {
+		MoveTo(frame.LeftTop());
+		ResizeTo(frame.Width(), frame.Height());
+	}
+	fWantedWidth = settings.GetUInt32("width", 0);
+	fWantedHeight = settings.GetUInt32("height", 0);
+
+	// the still format: JPEG unless another was chosen
+	uint32 type = settings.GetUInt32("still type", 'JPEG');
+	for (int32 i = 0; BMenuItem* item = fStillFormatMenu->ItemAt(i); i++) {
+		if (item->Message() != NULL
+			&& item->Message()->GetUInt32("be:type", 0) == type) {
+			item->SetMarked(true);
+			break;
+		}
+	}
+	if (fStillFormatMenu->FindMarked() == NULL
+		&& fStillFormatMenu->ItemAt(0) != NULL) {
+		fStillFormatMenu->ItemAt(0)->SetMarked(true);
+	}
+
+	fClipLength->SetValue(settings.GetInt32("clip seconds", 10));
+	float rate = settings.GetFloat("clip fps", 0);
+	for (int32 i = 0; BMenuItem* item = fClipRateMenu->ItemAt(i); i++) {
+		if (item->Message()->GetFloat("fps", -1) == rate)
+			item->SetMarked(true);
+	}
+
+	fScheduleBox->SetValue(settings.GetBool("schedule", false));
+	fScheduleEvery->SetValue(settings.GetInt32("schedule every", 5));
+	mark_item_with(fScheduleUnitMenu, "unit",
+		settings.GetInt32("schedule unit", 1));
+	if (settings.GetBool("schedule clip", false))
+		fScheduleClip->SetValue(B_CONTROL_ON);
+
+	fMotionBox->SetValue(settings.GetBool("motion", false));
+	fSensitivity->SetValue(settings.GetInt32("motion sensitivity", 50));
+	if (settings.GetBool("motion clip", false))
+		fMotionClip->SetValue(B_CONTROL_ON);
+	fMotionWait->SetValue(settings.GetInt32("motion wait", 10));
+	fShowMotionBox->SetValue(settings.GetBool("motion show", false));
+
+	fFolderControl->SetText(settings.GetString("folder",
+		"/boot/home/NeoCam"));
+	mark_item_with(fUploadMenu, "upload", settings.GetInt32("upload",
+		UPLOAD_NONE));
+	fServerControl->SetText(settings.GetString("server", ""));
+	fUserControl->SetText(settings.GetString("user", ""));
+	fPasswordControl->SetText(settings.GetString("password", ""));
+	fRemoteFolderControl->SetText(settings.GetString("remote folder", ""));
+	fPassiveBox->SetValue(settings.GetBool("passive", true));
+	fKeepLocalBox->SetValue(settings.GetBool("keep local", true));
+
+	if (fScheduleBox->Value() == B_CONTROL_ON)
+		fNextSchedule = system_time() + _ScheduleInterval();
+}
