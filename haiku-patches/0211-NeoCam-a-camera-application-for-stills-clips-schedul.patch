+bool
+MainWindow::QuitRequested()
+{
+	if (fController != NULL) {
+		// a recording is finished, the camera let go
+		BMessage reply;
+		BMessenger(fController).SendMessage(
+			CameraController::kMsgDisconnect, &reply);
+		if (fController->Lock())
+			fController->Quit();
+		fController = NULL;
+	}
+	BMessage settings;
+	GetSettings(settings);
+	save_settings(settings);
+	return true;
+}
