 .../media/plugins/ffmpeg/AVCodecEncoder.h     |   2 +
 .../media/plugins/ffmpeg/gfx_conv_neon.c      | 116 ++++++++++++++++++
 .../media/plugins/ffmpeg/gfx_conv_neon.h      |   2 +
 4 files changed, 146 insertions(+), 3 deletions(-)

