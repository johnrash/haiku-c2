+/*static*/ int32
+MesonMmc::_InterruptHandler(void* data)
+{
+	MesonMmc* self = (MesonMmc*)data;
+	uint32 status = self->_Read(kStatus) & STATUS_CLEAR_MASK;
+	if (status == 0)
+		return B_UNHANDLED_INTERRUPT;
+
+	// The line is level triggered: clear what we saw, keep it for the
+	// waiting thread.
+	self->_Write(kStatus, status);
+	atomic_or(&self->fIrqStatus, status);
+	self->fCommandDone.NotifyAll();
+	return B_INVOKE_SCHEDULER;
+}
+
+
+uint32
+MesonMmc::_WaitPolled(bigtime_t timeout)
+{
+	bigtime_t deadline = system_time() + timeout;
+	uint32 status;
+	for (int32 round = 0; ; round++) {
+		status = _Read(kStatus);
+		if ((status & STATUS_DONE_MASK) != 0 || system_time() > deadline)
+			break;
+		if (round > 50)
+			snooze(10);
+		else
+			spin(1);
+	}
+
+	if ((status & STATUS_DONE_MASK) != 0
+		&& (status & STATUS_END_OF_CHAIN) == 0) {
+		// An error was flagged first; give the aborted descriptor a moment
+		// to finish before the next command is issued.
+		bigtime_t end = system_time() + 10000;
+		while ((_Read(kStatus) & STATUS_END_OF_CHAIN) == 0
+			&& system_time() < end) {
+			spin(10);
+		}
+	}
+	return status;
+}
+
+
+uint32
+MesonMmc::_WaitInterrupt(ConditionVariableEntry& entry, bigtime_t timeout)
+{
+	entry.Wait(B_RELATIVE_TIMEOUT, timeout);
+	uint32 status = atomic_get(&fIrqStatus);
+
+	if ((status & STATUS_DONE_MASK) != 0
+		&& (status & STATUS_END_OF_CHAIN) == 0) {
+		// error first: wait briefly for the end of the aborted descriptor
+		bigtime_t end = system_time() + 10000;
+		while ((atomic_get(&fIrqStatus) & STATUS_END_OF_CHAIN) == 0
+			&& system_time() < end) {
+			snooze(100);
+		}
+		status = atomic_get(&fIrqStatus);
+	}
+	if ((status & STATUS_DONE_MASK) == 0) {
+		// timed out, or the interrupt was lost: look at the hardware
+		status |= _Read(kStatus);
+	}
+	return status;
+}
+
