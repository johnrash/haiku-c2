diff --git a/src/kits/debugger/arch/arm64/CpuStateARM64.cpp b/src/kits/debugger/arch/arm64/CpuStateARM64.cpp
new file mode 100644
index 0000000000..58c87ebc8d
--- /dev/null
+++ b/src/kits/debugger/arch/arm64/CpuStateARM64.cpp
@@ -0,0 +1,169 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "CpuStateARM64.h"
+
+#include <new>
+
+#include <string.h>
+
+#include "Register.h"
+
+
+CpuStateARM64::CpuStateARM64()
+	:
+	fSetRegisters()
+{
+	memset(fRegisters, 0, sizeof(fRegisters));
+}
+
+
+CpuStateARM64::CpuStateARM64(const arm64_debug_cpu_state& state)
+	:
+	fSetRegisters()
+{
+	for (int32 i = 0; i < 30; i++)
+		SetIntRegister(ARM64_REGISTER_X0 + i, state.x[i]);
+	SetIntRegister(ARM64_REGISTER_LR, state.lr);
+	SetIntRegister(ARM64_REGISTER_SP, state.sp);
+	SetIntRegister(ARM64_REGISTER_PC, state.elr);
+	SetIntRegister(ARM64_REGISTER_CPSR, state.spsr);
+}
+
+
+CpuStateARM64::~CpuStateARM64()
+{
+}
+
+
+status_t
+CpuStateARM64::Clone(CpuState*& _clone) const
+{
+	CpuStateARM64* newState = new(std::nothrow) CpuStateARM64();
+	if (newState == NULL)
+		return B_NO_MEMORY;
+
+	memcpy(newState->fRegisters, fRegisters, sizeof(fRegisters));
+	newState->fSetRegisters = fSetRegisters;
+
+	_clone = newState;
+	return B_OK;
+}
+
+
+status_t
+CpuStateARM64::UpdateDebugState(void* state, size_t size) const
+{
+	if (size != sizeof(arm64_debug_cpu_state))
+		return B_BAD_VALUE;
+
+	arm64_debug_cpu_state* arm64State = (arm64_debug_cpu_state*)state;
+
+	for (int32 i = 0; i < 30; i++)
+		arm64State->x[i] = IntRegisterValue(ARM64_REGISTER_X0 + i);
+	arm64State->lr = IntRegisterValue(ARM64_REGISTER_LR);
+	arm64State->sp = IntRegisterValue(ARM64_REGISTER_SP);
+	arm64State->elr = IntRegisterValue(ARM64_REGISTER_PC);
+	arm64State->spsr = IntRegisterValue(ARM64_REGISTER_CPSR);
+
+	return B_OK;
+}
+
+
+target_addr_t
+CpuStateARM64::InstructionPointer() const
+{
+	if (IsRegisterSet(ARM64_REGISTER_PC))
+		return IntRegisterValue(ARM64_REGISTER_PC);
+
+	// A state unwound with DWARF call frame information: the return address
+	// column is the link register, and the caller continues there.
+	return IntRegisterValue(ARM64_REGISTER_LR);
+}
+
+
+void
+CpuStateARM64::SetInstructionPointer(target_addr_t address)
+{
+	SetIntRegister(ARM64_REGISTER_PC, address);
+}
+
+
+target_addr_t
+CpuStateARM64::StackFramePointer() const
+{
+	return IntRegisterValue(ARM64_REGISTER_FP);
+}
+
+
+target_addr_t
+CpuStateARM64::StackPointer() const
+{
+	return IntRegisterValue(ARM64_REGISTER_SP);
+}
+
+
+bool
+CpuStateARM64::GetRegisterValue(const Register* reg, BVariant& _value) const
+{
+	int32 index = reg->Index();
+	if (index == ARM64_REGISTER_PC) {
+		target_addr_t address = InstructionPointer();
+		if (address == 0)
+			return false;
+		_value.SetTo((uint64)address);
+		return true;
+	}
+
+	if (!IsRegisterSet(index))
+		return false;
+
+	if (reg->BitSize() == 32)
+		_value.SetTo((uint32)fRegisters[index]);
+	else
+		_value.SetTo(fRegisters[index]);
+	return true;
+}
+
+
+bool
+CpuStateARM64::SetRegisterValue(const Register* reg, const BVariant& value)
+{
+	int32 index = reg->Index();
+	if (index < 0 || index >= ARM64_REGISTER_COUNT)
+		return false;
+
+	SetIntRegister(index, value.ToUInt64());
+	return true;
+}
+
+
+bool
+CpuStateARM64::IsRegisterSet(int32 index) const
+{
+	return index >= 0 && index < ARM64_REGISTER_COUNT && fSetRegisters[index];
+}
+
+
+uint64
+CpuStateARM64::IntRegisterValue(int32 index) const
+{
+	if (!IsRegisterSet(index))
+		return 0;
+
+	return fRegisters[index];
+}
+
+
+void
+CpuStateARM64::SetIntRegister(int32 index, uint64 value)
+{
+	if (index < 0 || index >= ARM64_REGISTER_COUNT)
+		return;
+
+	fRegisters[index] = value;
+	fSetRegisters[index] = 1;
+}
diff --git a/src/kits/debugger/arch/arm64/CpuStateARM64.h b/src/kits/debugger/arch/arm64/CpuStateARM64.h
new file mode 100644
index 0000000000..2ae3ca0340
--- /dev/null
+++ b/src/kits/debugger/arch/arm64/CpuStateARM64.h
@@ -0,0 +1,65 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef CPU_STATE_ARM64_H
+#define CPU_STATE_ARM64_H
+
+#include <bitset>
+
+#include <debugger.h>
+
+#include "CpuState.h"
+
+
+// The register indices are the DWARF register numbers for x0 to sp.
+enum {
+	ARM64_REGISTER_X0 = 0,
+	ARM64_REGISTER_X28 = 28,
+	ARM64_REGISTER_FP = 29,		// x29
+	ARM64_REGISTER_LR = 30,		// x30
+	ARM64_REGISTER_SP = 31,
+	ARM64_REGISTER_PC,
+	ARM64_REGISTER_CPSR,
+
+	ARM64_REGISTER_COUNT
+};
+
+
+class CpuStateARM64 : public CpuState {
+public:
+								CpuStateARM64();
+								CpuStateARM64(
+									const arm64_debug_cpu_state& state);
+	virtual						~CpuStateARM64();
+
+	virtual	status_t			Clone(CpuState*& _clone) const;
+
+	virtual	status_t			UpdateDebugState(void* state, size_t size)
+									const;
+
+	virtual	target_addr_t		InstructionPointer() const;
+	virtual	void				SetInstructionPointer(target_addr_t address);
+
+	virtual	target_addr_t		StackFramePointer() const;
+	virtual	target_addr_t		StackPointer() const;
+
+	virtual	bool				GetRegisterValue(const Register* reg,
+									BVariant& _value) const;
+	virtual	bool				SetRegisterValue(const Register* reg,
+									const BVariant& value);
+
+			bool				IsRegisterSet(int32 index) const;
+			uint64				IntRegisterValue(int32 index) const;
+			void				SetIntRegister(int32 index, uint64 value);
+
+private:
+	typedef std::bitset<ARM64_REGISTER_COUNT> RegisterBitSet;
+
+private:
+			uint64				fRegisters[ARM64_REGISTER_COUNT];
+			RegisterBitSet		fSetRegisters;
+};
+
+
+#endif	// CPU_STATE_ARM64_H
diff --git a/src/kits/debugger/arch/arm64/disasm/DisassemblerARM64.cpp b/src/kits/debugger/arch/arm64/disasm/DisassemblerARM64.cpp
new file mode 100644
index 0000000000..004cc27779
--- /dev/null
+++ b/src/kits/debugger/arch/arm64/disasm/DisassemblerARM64.cpp
@@ -0,0 +1,180 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+#include "DisassemblerARM64.h"
+
+#include <new>
+
+#include <string.h>
+
+#include <capstone/capstone.h>
+
+#include "CpuStateARM64.h"
+
+
+struct DisassemblerARM64::CapstoneData {
+	csh			handle;
+	cs_insn*	instruction;
+};
+
+
+DisassemblerARM64::DisassemblerARM64()
+	:
+	fAddress(0),
+	fCode(NULL),
+	fCodeSize(0),
+	fOffset(0),
+	fCapstoneData(NULL)
+{
+}
+
+
+DisassemblerARM64::~DisassemblerARM64()
+{
+	if (fCapstoneData != NULL) {
+		if (fCapstoneData->instruction != NULL)
+			cs_free(fCapstoneData->instruction, 1);
+		cs_close(&fCapstoneData->handle);
+		delete fCapstoneData;
+	}
+}
+
+
+status_t
+DisassemblerARM64::Init(target_addr_t address, const void* code,
+	size_t codeSize)
+{
+	fAddress = address;
+	fCode = (const uint8*)code;
+	fCodeSize = codeSize & ~(size_t)3;
+	fOffset = 0;
+
+	if (fCapstoneData == NULL) {
+		fCapstoneData = new(std::nothrow) CapstoneData;
+		if (fCapstoneData == NULL)
+			return B_NO_MEMORY;
+		if (cs_open(CS_ARCH_ARM64, CS_MODE_ARM, &fCapstoneData->handle)
+				!= CS_ERR_OK) {
+			delete fCapstoneData;
+			fCapstoneData = NULL;
+			return B_ERROR;
+		}
+		fCapstoneData->instruction = cs_malloc(fCapstoneData->handle);
+		if (fCapstoneData->instruction == NULL)
+			return B_NO_MEMORY;
+	}
+
+	return B_OK;
+}
+
+
+status_t
+DisassemblerARM64::GetNextInstruction(BString& line, target_addr_t& _address,
+	target_size_t& _size, bool& _breakpointAllowed)
+{
+	if (fOffset + 4 > fCodeSize)
+		return B_ENTRY_NOT_FOUND;
+
+	uint32 instruction;
+	memcpy(&instruction, fCode + fOffset, 4);
+	target_addr_t address = fAddress + fOffset;
+	fOffset += 4;
+
+	_Format(instruction, address, line);
+	_address = address;
+	_size = 4;
+	_breakpointAllowed = true;
+	return B_OK;
+}
+
+
+status_t
+DisassemblerARM64::GetPreviousInstruction(target_addr_t nextAddress,
+	target_addr_t& _address, target_size_t& _size)
+{
+	if (nextAddress < fAddress + 4 || nextAddress > fAddress + fCodeSize)
+		return B_BAD_VALUE;
+
+	_address = (nextAddress & ~(target_addr_t)3) - 4;
+	_size = 4;
+	return B_OK;
+}
+
+
+status_t
+DisassemblerARM64::GetNextInstructionInfo(InstructionInfo& _info,
+	CpuState* state)
+{
+	if (fOffset + 4 > fCodeSize)
+		return B_ENTRY_NOT_FOUND;
+
+	uint32 instruction;
+	memcpy(&instruction, fCode + fOffset, 4);
+	target_addr_t address = fAddress + fOffset;
+	fOffset += 4;
+
+	target_addr_t target = 0;
+	instruction_type type = DecodeBranch(instruction, address, state, target);
+
+	BString line;
+	_Format(instruction, address, line);
+	if (!_info.SetTo(address, target, 4, type, true, line))
+		return B_NO_MEMORY;
+	return B_OK;
+}
+
+
+/*!	Calls (BL, BLR) and unconditional jumps (B, BR), as the x86 disassemblers
+	classify them; conditional branches and returns are "other". The target
+	of a register branch is only known with a CPU state.
+*/
+/*static*/ instruction_type
+DisassemblerARM64::DecodeBranch(uint32 instruction, target_addr_t address,
+	CpuState* state, target_addr_t& _target)
+{
+	_target = 0;
+
+	// B, BL: imm26, a word offset
+	if ((instruction & 0x7c000000) == 0x14000000) {
+		int64 offset = (int64)((uint64)(instruction & 0x03ffffff) << 38) >> 36;
+		_target = address + offset;
+		return (instruction & 0x80000000) != 0
+			? INSTRUCTION_TYPE_SUBROUTINE_CALL : INSTRUCTION_TYPE_JUMP;
+	}
+
+	// BR, BLR: Rn
+	uint32 opcode = instruction & 0xfffffc1f;
+	if (opcode == 0xd61f0000 || opcode == 0xd63f0000) {
+		CpuStateARM64* arm64State = dynamic_cast<CpuStateARM64*>(state);
+		int32 reg = (instruction >> 5) & 0x1f;
+		if (arm64State != NULL && arm64State->IsRegisterSet(reg))
+			_target = arm64State->IntRegisterValue(reg);
+		return opcode == 0xd63f0000
+			? INSTRUCTION_TYPE_SUBROUTINE_CALL : INSTRUCTION_TYPE_JUMP;
+	}
+
+	return INSTRUCTION_TYPE_OTHER;
+}
+
+
+void
+DisassemblerARM64::_Format(uint32 instruction, target_addr_t address,
+	BString& line)
+{
+	const uint8* code = (const uint8*)&instruction;
+	size_t size = 4;
+	uint64 capstoneAddress = address;
+	cs_insn* decoded = fCapstoneData->instruction;
+	if (cs_disasm_iter(fCapstoneData->handle, &code, &size, &capstoneAddress,
+			decoded)) {
+		line.SetToFormat("0x%016" B_PRIx64 ": %08" B_PRIx32 "  %-7s %s",
+			address, instruction, decoded->mnemonic, decoded->op_str);
+	} else {
+		// data in the code, or something Capstone does not know
+		line.SetToFormat("0x%016" B_PRIx64 ": %08" B_PRIx32 "  .inst   0x%08"
+			B_PRIx32, address, instruction, instruction);
+	}
+}
diff --git a/src/kits/debugger/arch/arm64/disasm/DisassemblerARM64.h b/src/kits/debugger/arch/arm64/disasm/DisassemblerARM64.h
new file mode 100644
index 0000000000..bccc40e06d
--- /dev/null
+++ b/src/kits/debugger/arch/arm64/disasm/DisassemblerARM64.h
@@ -0,0 +1,60 @@
+/*
+ * Copyright 2026, haiku-odroid-c2 port authors.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef DISASSEMBLER_ARM64_H
+#define DISASSEMBLER_ARM64_H
+
+#include <String.h>
+
+#include "InstructionInfo.h"
+#include "Types.h"
+
+
+class CpuState;
+
+
+/*!	AArch64 instructions are four bytes each, so walking the code is trivial;
+	the text comes from Capstone. Branch types and targets are decoded here.
+*/
+class DisassemblerARM64 {
+public:
+								DisassemblerARM64();
+								~DisassemblerARM64();
+
+			status_t			Init(target_addr_t address, const void* code,
+									size_t codeSize);
+
+			status_t			GetNextInstruction(BString& line,
+									target_addr_t& _address,
+									target_size_t& _size,
+									bool& _breakpointAllowed);
+			status_t			GetPreviousInstruction(
+									target_addr_t nextAddress,
+									target_addr_t& _address,
+									target_size_t& _size);
+			status_t			GetNextInstructionInfo(
+									InstructionInfo& _info,
+									CpuState* state);
+
+	static	instruction_type	DecodeBranch(uint32 instruction,
+									target_addr_t address, CpuState* state,
+									target_addr_t& _target);
+
+private:
+			struct CapstoneData;
+
+private:
+			void				_Format(uint32 instruction,
+									target_addr_t address, BString& line);
+
+private:
+			target_addr_t		fAddress;
+			const uint8*		fCode;
+			size_t				fCodeSize;
+			size_t				fOffset;
+			CapstoneData*		fCapstoneData;
+};
+
+
+#endif	// DISASSEMBLER_ARM64_H
diff --git a/src/kits/debugger/arch/arm64/disasm/Jamfile b/src/kits/debugger/arch/arm64/disasm/Jamfile
