@@ -0,0 +1,23 @@
+SubDir HAIKU_TOP src kits debugger arch arm64 disasm ;
+
+if $(TARGET_PACKAGING_ARCH) = arm64 && [ FIsBuildFeatureEnabled capstone ] {
+
+UsePrivateHeaders shared ;
+
+UsePrivateHeaders [ FDirName debugger arch ] ;
+UsePrivateHeaders [ FDirName debugger types ] ;
+
+UseBuildFeatureHeaders capstone ;
+
+SubDirHdrs [ FDirName $(SUBDIR) $(DOTDOT) ] ;
