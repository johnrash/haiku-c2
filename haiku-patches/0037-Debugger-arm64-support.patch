+
+/*!	Follows a PLT entry to the function it calls. GNU ld's AArch64 PLT
+	entries begin with "adrp x16, <GOT page>; ldr x17, [x16, #<offset>]",
+	then branch to x17.
+*/
+status_t
+ArchitectureARM64::ResolvePICFunctionAddress(target_addr_t instructionAddress,
+	CpuState* state, target_addr_t& _targetAddress)
+{
+	uint32 code[2];
+	if (fTeamMemory->ReadMemory(instructionAddress, code, sizeof(code))
+			!= sizeof(code)) {
+		return B_BAD_VALUE;
+	}
+
+	// adrp: 1 immlo:2 10000 immhi:19 Rd:5
+	if ((code[0] & 0x9f000000) != 0x90000000)
+		return B_BAD_VALUE;
+	uint32 adrpRegister = code[0] & 0x1f;
+	int64 pages = (int64)(((uint64)((code[0] >> 5) & 0x7ffff) << 2
+		| ((code[0] >> 29) & 3)) << 43) >> 43;
+	target_addr_t page = (instructionAddress & ~(target_addr_t)0xfff)
+		+ pages * 4096;
+
+	// ldr x<t>, [x<n>, #imm12 * 8]
+	if ((code[1] & 0xffc00000) != 0xf9400000
+		|| ((code[1] >> 5) & 0x1f) != adrpRegister) {
+		return B_BAD_VALUE;
+	}
+	target_addr_t gotEntry = page + ((code[1] >> 10) & 0xfff) * 8;
+
+	target_addr_t function;
+	if (fTeamMemory->ReadMemory(gotEntry, &function, 8) != 8)
+		return B_BAD_VALUE;
+
+	_targetAddress = function;
+	return B_OK;
+}
+
+
+status_t
+ArchitectureARM64::GetWatchpointDebugCapabilities(int32& _maxRegisterCount,
+	int32& _maxBytesPerRegister, uint8& _watchpointCapabilityFlags)
+{
+	// the Cortex-A53's four, each watching up to eight aligned bytes
+	_maxRegisterCount = 4;
+	_maxBytesPerRegister = 8;
+	_watchpointCapabilityFlags = WATCHPOINT_CAPABILITY_FLAG_READ
+		| WATCHPOINT_CAPABILITY_FLAG_WRITE
+		| WATCHPOINT_CAPABILITY_FLAG_READ_WRITE;
+	return B_OK;
+}
+
+
+status_t
+ArchitectureARM64::GetReturnAddressLocation(StackFrame* frame,
+	target_size_t valueSize, ValueLocation*& _location)
+{
+	// AAPCS64: values of up to 16 bytes come back in x0 and x1. Larger ones
+	// go to memory at x8, which the callee need not preserve.
+	if (valueSize > 16)
+		return B_NOT_SUPPORTED;
+
+	ValueLocation* location = new(std::nothrow) ValueLocation(IsBigEndian());
+	if (location == NULL)
+		return B_NO_MEMORY;
+	BReference<ValueLocation> locationReference(location, true);
+
+	ValuePieceLocation piece;
+	piece.SetSize(valueSize > 8 ? 8 : valueSize);
+	piece.SetToRegister(ARM64_REGISTER_X0);
+	if (!location->AddPiece(piece))
+		return B_NO_MEMORY;
+
+	if (valueSize > 8) {
+		ValuePieceLocation secondPiece;
+		secondPiece.SetSize(valueSize - 8);
+		secondPiece.SetToRegister(ARM64_REGISTER_X0 + 1);
+		if (!location->AddPiece(secondPiece))
+			return B_NO_MEMORY;
+	}
+
+	_location = locationReference.Detach();
+	return B_OK;
+}
+
+
+void
+ArchitectureARM64::_AddIntegerRegister(int32 index, const char* name,
+	register_type type, bool calleePreserved)
+{
+	if (!fRegisters.Add(Register(index, name, 64, B_UINT64_TYPE, type,
+			calleePreserved))) {
+		throw std::bad_alloc();
+	}
+}
+
+
+bool
+ArchitectureARM64::_HasFunctionPrologue(FunctionDebugInfo* function) const
+{
+	if (function == NULL || function->Size() < 8)
+		return false;
+
+	uint32 code[2];
+	if (fTeamMemory->ReadMemory(function->Address(), code, sizeof(code))
+			!= sizeof(code)) {
+		return false;
+	}
+
+	return (code[0] & kPushFrameRecordMask) == kPushFrameRecord
+		&& code[1] == kSetFramePointer;
+}
