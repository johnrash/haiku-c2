From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jrash <johnrash@gmail.com>
Date: Thu, 29 Oct 2026 17:29:09 -0400
Subject: [PATCH 066/342] media: BTimeSource converts long time spans instead
 of stopping

PerformanceTimeFor() and RealTimeFor() did their arithmetic in floats and
called debugger() when the span since the time source last published
reached 2^24 us (16.8 s) with a drift other than 1. A time source that
stops publishing, such as a USB audio device's node after an unplug,
thereby brought down the mixer in media_addon_server and a music player (core
file from a second C2: the mixer's control thread in RealTimeFor()).
Doubles keep such spans exact to well below a microsecond.

Played audio and video through it on the ODROID-C2 (MediaPlayer, HDMI
audio); the unplug itself is not retested yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kits/media/TimeSource.cpp | 25 +++++++------------------
 1 file changed, 7 insertions(+), 18 deletions(-)

diff --git a/src/kits/media/TimeSource.cpp b/src/kits/media/TimeSource.cpp
index 592d38bdcc..f5c786a94e 100644
--- a/src/kits/media/TimeSource.cpp
+++ b/src/kits/media/TimeSource.cpp
@@ -169,16 +169,12 @@ BTimeSource::PerformanceTimeFor(bigtime_t real_time)
 	if (GetTime(&last_perf_time, &last_real_time, &last_drift) != B_OK)
 		debugger("BTimeSource::PerformanceTimeFor: GetTime failed");
 
+	// A double keeps differences of up to 2^53 us exact enough; a float's
+	// 2^24 us (16.8 s) were passed whenever a time source stopped
+	// publishing for longer, such as an unplugged audio device.
 	bigtime_t real_time_difference = real_time - last_real_time;
-	if (real_time_difference >= (1 << FLT_MANT_DIG)) {
-		// The difference is too large fit in a float.
-		if (last_drift == 1.0f)
-			return last_perf_time + real_time_difference;
-
-		debugger("BTimeSource::PerformanceTimeFor: real time too large");
-	}
-
-	return last_perf_time + (bigtime_t)(real_time_difference * last_drift);
+	return last_perf_time
+		+ (bigtime_t)((double)real_time_difference * last_drift);
 }
 
 
@@ -198,17 +194,10 @@ BTimeSource::RealTimeFor(bigtime_t performance_time,
 	if (GetTime(&last_perf_time, &last_real_time, &last_drift) != B_OK)
 		debugger("BTimeSource::RealTimeFor: GetTime failed");
 
+	// see PerformanceTimeFor()
 	bigtime_t perf_time_difference = performance_time - last_perf_time;
-	if (perf_time_difference >= (1 << FLT_MANT_DIG)) {
-		// The difference is too large to fit in a float.
-		if (last_drift == 1.0f)
-			return last_real_time - with_latency + perf_time_difference;
-
-		debugger("BTimeSource::RealTimeFor: performance time too large");
-	}
-
 	return last_real_time - with_latency
-		+ (bigtime_t)(perf_time_difference / last_drift);
+		+ (bigtime_t)((double)perf_time_difference / last_drift);
 }
 
 
