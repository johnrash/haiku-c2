+*/
+size_t
+yuy2_to_rgb32_neon(uint32_t* destination, const uint8_t* source, size_t pairs)
+{
+	const int16x8_t kChromaBias = vdupq_n_s16(128);
+	const int16x8_t kLumaBias = vdupq_n_s16(16);
+	const int32x4_t kRound = vdupq_n_s32(128);
+	size_t done = 0;
+	for (; done + 8 <= pairs; done += 8) {
+		// 8 groups of Y0 U Y1 V
+		uint8x8x4_t in = vld4_u8(source);
+		int16x8_t u = vsubq_s16(vreinterpretq_s16_u16(vmovl_u8(in.val[1])),
+			kChromaBias);
+		int16x8_t v = vsubq_s16(vreinterpretq_s16_u16(vmovl_u8(in.val[3])),
+			kChromaBias);
+		int32x4_t redLow = vmlal_n_s16(kRound, vget_low_s16(v), 409);
+		int32x4_t redHigh = vmlal_n_s16(kRound, vget_high_s16(v), 409);
+		int32x4_t greenLow = vmlal_n_s16(vmlal_n_s16(kRound,
+			vget_low_s16(u), -100), vget_low_s16(v), -208);
+		int32x4_t greenHigh = vmlal_n_s16(vmlal_n_s16(kRound,
+			vget_high_s16(u), -100), vget_high_s16(v), -208);
+		int32x4_t blueLow = vmlal_n_s16(kRound, vget_low_s16(u), 516);
+		int32x4_t blueHigh = vmlal_n_s16(kRound, vget_high_s16(u), 516);
+
+		uint8x8_t red[2], green[2], blue[2];
+		for (int k = 0; k < 2; k++) {
+			int16x8_t y = vsubq_s16(vreinterpretq_s16_u16(
+				vmovl_u8(in.val[k * 2])), kLumaBias);
+			int32x4_t yLow = vmull_n_s16(vget_low_s16(y), 298);
+			int32x4_t yHigh = vmull_n_s16(vget_high_s16(y), 298);
+			// (value >> 8) fits 16 bits; then saturated to 0-255
+			red[k] = vqmovun_s16(vcombine_s16(
+				vshrn_n_s32(vaddq_s32(yLow, redLow), 8),
+				vshrn_n_s32(vaddq_s32(yHigh, redHigh), 8)));
+			green[k] = vqmovun_s16(vcombine_s16(
+				vshrn_n_s32(vaddq_s32(yLow, greenLow), 8),
+				vshrn_n_s32(vaddq_s32(yHigh, greenHigh), 8)));
+			blue[k] = vqmovun_s16(vcombine_s16(
+				vshrn_n_s32(vaddq_s32(yLow, blueLow), 8),
+				vshrn_n_s32(vaddq_s32(yHigh, blueHigh), 8)));
+		}
+
+		// even and odd pixels back in order
+		uint8x8x2_t r = vzip_u8(red[0], red[1]);
+		uint8x8x2_t g = vzip_u8(green[0], green[1]);
+		uint8x8x2_t b = vzip_u8(blue[0], blue[1]);
+		uint8x16x4_t out;
+		out.val[0] = vcombine_u8(b.val[0], b.val[1]);
+		out.val[1] = vcombine_u8(g.val[0], g.val[1]);
+		out.val[2] = vcombine_u8(r.val[0], r.val[1]);
+		out.val[3] = vdupq_n_u8(255);
+		vst4q_u8((uint8_t*)destination, out);
+		destination += 16;
+		source += 32;
+	}
+	return done;
+}
