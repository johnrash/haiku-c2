+
 status_t
 WebCamMediaAddOn::CameraAdded(CamDevice* device)
 {
 	PRINT((CH "()" CT));
+	{
+		// a node whose camera was unplugged takes the one that comes (back),
+		// keeping its flavor, so that it stays the default and a connected
+		// application gets pictures again
+		BAutolock locker(fNodeLock);
+		if (fNode != NULL && !fNode->HasCamera()) {
+			device->SetInternalID(fNode->InternalID());
+			fNode->ReplaceCamera(device);
+		}
+	}
 	NotifyFlavorChange();
 	return B_OK;
 }
