-VideoProducer::HandleMessage(int32 /*message*/, const void* /*data*/, size_t /*size*/)
+VideoProducer::HandleMessage(int32 message, const void* data, size_t size)
 {
+	switch (message) {
+		case kMsgConsumerGone:
+			// the consumer's team ended without disconnecting (it was
+			// killed): stop as a disconnection does, so that the camera
+			// doesn't stream on and the output is free again
+			if (fConnected && fConsumerGone)
+				Disconnect(fOutput.source, fOutput.destination);
+			return B_OK;
+
+		case kMsgReplaceCamera:
+			if (size != sizeof(CamDevice*))
+				return B_BAD_VALUE;
+			_ReplaceCamera(*(CamDevice* const*)data);
+			return B_OK;
+	}
 	return B_ERROR;
 }
 
 
+bool
+VideoProducer::HasCamera() const
+{
+	CamDevice* camera = fCamDevice;
+	return camera != NULL && camera->IsPlugged();
+}
+
+
+void
+VideoProducer::ReplaceCamera(CamDevice* camera)
+{
+	// the control thread swaps it, between the node's other work
+	write_port_etc(ControlPort(), kMsgReplaceCamera, &camera, sizeof(camera),
+		B_RELATIVE_TIMEOUT, 1000000);
+}
+
+
+/*!	The camera that was unplugged (and stopped then) gives way to \a camera:
+	it gets the parameter IDs and the frame size the old one had, and a
+	running node streams from it.
+*/
+void
+VideoProducer::_ReplaceCamera(CamDevice* camera)
+{
+	if (camera == fCamDevice || camera == NULL || !camera->IsPlugged())
+		return;
+
+	bool running = fRunning;
+	if (running)
+		HandleStop();
+
+	CamDevice* old = fCamDevice;
+	fCamDevice = camera;
+
+	// the parameter web stays; the new camera numbers its parameters the
+	// same way the old one did in NodeRegistered()
+	BParameterWeb web;
+	BParameterGroup* group = web.MakeGroup(Name());
+	int32 id = P_LAST;
+	camera->AddParameters(group, id);
+	if (camera->Sensor() != NULL)
+		camera->Sensor()->AddParameters(group, id);
+
+	if (fConnected) {
+		uint32 width = fConnectedFormat.display.line_width;
+		uint32 height = fConnectedFormat.display.line_count;
+		BAutolock lock(camera->Locker());
+		camera->AcceptVideoFrame(width, height);
+	}
+
+	if (running)
+		HandleStart(TimeSource()->Now());
+
+	// no thread uses the old one any more: its transfer ended when it was
+	// unplugged, and the roster dropped it
+	delete old;
+}
+
