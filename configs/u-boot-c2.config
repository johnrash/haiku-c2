# ODROID-C2 U-Boot fragment, merged on top of odroid-c2_defconfig.
# The environment is not saved on this board, so the boot command is built in:
# static IP on the crossover link, then fetch and run c2.scr from the host's
# TFTP (development). Without c2.scr (no laptop, no TFTP server, or no file)
# it boots Haiku from the eMMC's EFI partition; short TFTP timeouts keep that
# fallback quick.
CONFIG_BOOTDELAY=3
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="setenv ipaddr 10.42.0.2; setenv netmask 255.255.255.0; setenv serverip 10.42.0.1; setenv netretry no; setenv tftptimeout 1000; setenv tftptimeoutcountmax 3; echo c2: fetching c2.scr from ${serverip}; if tftpboot ${scriptaddr} c2.scr || tftpboot ${scriptaddr} c2.scr; then source ${scriptaddr}; else echo c2: no c2.scr, booting Haiku from the eMMC; mmc dev 1; if load mmc 1:1 ${kernel_addr_r} EFI/BOOT/BOOTAA64.EFI; then echo c2: BOOTEFI; bootefi ${kernel_addr_r} ${fdtcontroladdr}; fi; echo c2: no Haiku on the eMMC, staying at prompt; fi"
# Short ARP retries: with no laptop (a LAN, or no link) nobody answers for
# 10.42.0.1, and the default 5 x 5 s per attempt delayed the eMMC boot by 45 s.
CONFIG_ARP_TIMEOUT=1000
CONFIG_NET_RETRY_COUNT=3
# Hardware watchdog available on demand (c2.scr: wdt dev ...; wdt start <ms>),
# never started automatically.
CONFIG_WDT=y
CONFIG_WDT_MESON_GXBB=y
CONFIG_CMD_WDT=y
# CONFIG_WATCHDOG_AUTOSTART is not set
# Inspection and flashing
CONFIG_CMD_EFIDEBUG=y
CONFIG_CMD_UNZIP=y
