# ODROID-C2 U-Boot fragment for the self-contained microSD image, merged
# on top of odroid-c2_defconfig.
CONFIG_BOOTDELAY=3
CONFIG_USE_BOOTCOMMAND=y
# Self-contained image (tools/c2-sd-image.sh, on a microSD or an eMMC): no
# TFTP; boot the Haiku EFI loader from the device U-Boot itself started
# from ("boot_source", set by U-Boot from the boot ROM's record), else from
# the other one (mmc 0 is the microSD, mmc 1 the eMMC).
CONFIG_BOOTCOMMAND="if test ${boot_source} = emmc; then for dev in 1 0; do if load mmc ${dev}:1 ${kernel_addr_r} EFI/BOOT/BOOTAA64.EFI; then echo c2: BOOTEFI from mmc ${dev}; bootefi ${kernel_addr_r} ${fdtcontroladdr}; fi; done; else for dev in 0 1; do if load mmc ${dev}:1 ${kernel_addr_r} EFI/BOOT/BOOTAA64.EFI; then echo c2: BOOTEFI from mmc ${dev}; bootefi ${kernel_addr_r} ${fdtcontroladdr}; fi; done; fi; echo c2: no Haiku found, staying at prompt"
# Short ARP retries: with no laptop (a LAN, or no link) nobody answers for
# 10.42.0.1, and the default 5 x 5 s per attempt delayed the eMMC boot by 45 s.
CONFIG_ARP_TIMEOUT=1000
CONFIG_NET_RETRY_COUNT=3
# Hardware watchdog available on demand (c2.scr: wdt dev ...; wdt start <ms>),
# never started automatically.
CONFIG_WDT=y
CONFIG_WDT_MESON_GXBB=y
CONFIG_CMD_WDT=y
# CONFIG_WATCHDOG_AUTOSTART is not set
# Inspection and flashing
CONFIG_CMD_EFIDEBUG=y
CONFIG_CMD_UNZIP=y
