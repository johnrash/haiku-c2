name			weatherboard
version			1.2-1
architecture	arm64
summary			"Live readings of Hardkernel's Weather Board 2"
description		"Weather Board shows the readings of Hardkernel's Weather Board 2 on the ODROID-C2's header (I2C B, pins 27 and 28): temperature, humidity and pressure from its BME280, light and UV index from its Si1132, a new reading every second, with the last two minutes of temperature and of light as curves. Drag the panel's handle onto the Desktop (Deskbar: Show replicants) to keep it there. Private build for the ODROID-C2 port; see apps/WeatherBoard in the project."
packager		"haiku-odroid-c2 port"
vendor			"haiku-odroid-c2 port"
copyrights		{
	"2026 haiku-odroid-c2 port authors"
}
licenses		{
	"MIT"
}
provides {
	weatherboard = 1.2
	app:WeatherBoard = 1.2
}
requires {
	haiku >= r1~beta6
	lib:libstdc++
}
